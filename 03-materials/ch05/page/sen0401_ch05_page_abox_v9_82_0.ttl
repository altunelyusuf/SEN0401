    skos:definition "This page teaches chapter 5 of the course book as an interactive surface with 111 sections in a three-level outline, 113 widgets that the browser test exercised, and a quiz of 8 questions."@en .

pg:Q1 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "What does a Bitcoin wallet database contain?"@en ;
    ld:assessesObjective pg:CO2 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "A wallet database is not a chain copy; a full node keeps the chain, and a wallet may use one.",
        "Nothing in a wallet holds coins; outputs live on the blockchain and keys prove control of them." ;
    ld:hasCorrectOption pg:Q1_O1 ;
    ld:hasOption pg:Q1_O0,
        pg:Q1_O1,
        pg:Q1_O2 .

pg:Q2 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "A wallet shows 12 words. How much entropy does that stand for, and how many of the bits are checksum?"@en ;
    ld:assessesObjective pg:CO1 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "A word is 11 bits, but only 4 of the last word's bits are checksum for a 128-bit code.",
        "Twelve words carry 132 bits in all, of which 4 are the checksum of the other 128." ;
    ld:hasCorrectOption pg:Q2_O1 ;
    ld:hasOption pg:Q2_O0,
        pg:Q2_O1,
        pg:Q2_O2 .

pg:Q3 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "In BIP39, what happens if a restoring user types a passphrase that is not the one they used?"@en ;
    ld:assessesObjective pg:CO1 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "The passphrase is part of the salt of the key derivation, so it changes the seed itself.",
        "Three of the four schemes, BIP39 among them, leave the passphrase out of the checksum; only Aezeed authenticates it." ;
    ld:hasCorrectOption pg:Q3_O2 ;
    ld:hasOption pg:Q3_O0,
        pg:Q3_O1,
        pg:Q3_O2 .

pg:Q4 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Why is hardened derivation used for the first levels of a standard path?"@en ;
    ld:assessesObjective pg:CO3 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "Hardened and normal child keys are the same size; only the input to the hash differs.",
        "Speed is not the reason; the hardened step is a firewall against a leak." ;
    ld:hasCorrectOption pg:Q4_O0 ;
    ld:hasOption pg:Q4_O0,
        pg:Q4_O1,
        pg:Q4_O2 .

pg:Q5 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "A web server holds only an account's extended public key. What is the worst an attacker who takes over that server can do with the key itself?"@en ;
    ld:assessesObjective pg:CO3 ;
    ld:cognitiveLevel ld:Analyze ;
    ld:distractorRationale "Brute force against a 256-bit key is not a practical attack; the real loss is privacy.",
        "No private key is reachable from an extended public key, so past funds are safe." ;
    ld:hasCorrectOption pg:Q5_O2 ;
    ld:hasOption pg:Q5_O0,
        pg:Q5_O1,
        pg:Q5_O2 .

pg:Q6 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "A user restores a BIP39 code into a wallet that supports only legacy addresses. The funds were received to native segwit addresses. What do they see?"@en ;
    ld:assessesObjective pg:CO4 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "The code's checksum is independent of the paths, so it validates and the wallet reports no error.",
        "The seed is the same but the path and the script type are not, so the addresses differ." ;
    ld:hasCorrectOption pg:Q6_O1 ;
    ld:hasOption pg:Q6_O0,
        pg:Q6_O1,
        pg:Q6_O2 .

pg:Q7 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Which of these cannot be recovered from a recovery code alone?"@en ;
    ld:assessesObjective pg:CO2 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "Every key of a standard path is derived from the seed, so public keys come back.",
        "Private keys are derived from the seed as well; it is the user's own notes that are lost." ;
    ld:hasCorrectOption pg:Q7_O0 ;
    ld:hasOption pg:Q7_O0,
        pg:Q7_O1,
        pg:Q7_O2 .

pg:Q8 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "The chapter says each parent key can have 2,147,483,647 children and gives 2 to the 31 as that value. What does BIP32 actually say?"@en ;
    ld:assessesObjective pg:CO5 ;
    ld:cognitiveLevel ld:Analyze ;
    ld:distractorRationale "Four billion is the total of normal and hardened children together, 2 to the 32.",
        "The figure printed is the largest normal index, not the count; the count is one more." ;
    ld:hasCorrectOption pg:Q8_O0 ;
    ld:hasOption pg:Q8_O0,
        pg:Q8_O1,
        pg:Q8_O2 .

