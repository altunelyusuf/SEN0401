pg:Card a ipo:Sidebar,
        owl:NamedIndividual ;
    rdfs:label "Detail card"@en ;
    dcterms:source <http://example.org/sen0401/ch05/document> ;
    skos:definition "The detail card at the right opens only when the reader explicitly asks for the details of a concept."@en .

pg:Header a ipo:Header,
        owl:NamedIndividual ;
    rdfs:label "Header with the main menu"@en ;
    dcterms:source <http://example.org/sen0401/ch05/document> ;
    skos:definition "The header at the top holds the main menu, whose items are intro, learn, maps, lab, agents, practice, reference, about."@en .

pg:Layout a ipo:LayoutPattern,
        owl:NamedIndividual ;
    rdfs:label "Explorer, main area and detail card"@en ;
    dcterms:source <http://example.org/sen0401/ch05/document> ;
    skos:definition "The page puts the chapter explorer at the left, the main area in the centre and a detail card at the right that stays closed until the reader asks for a detail."@en .

pg:Main a ipo:MainContent,
        owl:NamedIndividual ;
    rdfs:label "Main area"@en ;
    dcterms:source <http://example.org/sen0401/ch05/document> ;
    skos:definition "The main area shows the chapter content of the selected menu item, with the widgets of its sections inline."@en .

pg:Q1_O0 a ld:AnswerOption ;
    rdfs:label "The bitcoins the user owns, stored as amounts"@en .

pg:Q1_O2 a ld:AnswerOption ;
    rdfs:label "A copy of the blockchain and the user's balance"@en .

pg:Q2_O0 a ld:AnswerOption ;
    rdfs:label "132 bits of entropy and no checksum"@en .

pg:Q2_O2 a ld:AnswerOption ;
    rdfs:label "128 bits of entropy and 11 checksum bits in the last word"@en .

pg:Q3_O0 a ld:AnswerOption ;
    rdfs:label "The wallet reports an error, because the checksum covers the passphrase"@en .

pg:Q3_O1 a ld:AnswerOption ;
    rdfs:label "The same keys are produced, since the passphrase only encrypts the code"@en .

pg:Q4_O1 a ld:AnswerOption ;
    rdfs:label "Because hardened keys are longer and therefore harder to guess"@en .

pg:Q4_O2 a ld:AnswerOption ;
    rdfs:label "Because public derivation is slower above the account level"@en .

pg:Q5_O0 a ld:AnswerOption ;
    rdfs:label "Spend the funds already received to the shop's addresses"@en .

pg:Q5_O1 a ld:AnswerOption ;
    rdfs:label "Derive the account's private keys by brute force"@en .

pg:Q6_O0 a ld:AnswerOption ;
    rdfs:label "The full balance, because the keys are the same"@en .

pg:Q6_O2 a ld:AnswerOption ;
    rdfs:label "An error, because the code is not valid for that wallet"@en .

pg:Q7_O1 a ld:AnswerOption ;
    rdfs:label "The public keys of the user's own branch"@en .

pg:Q7_O2 a ld:AnswerOption ;
    rdfs:label "The private keys for the standard paths"@en .

pg:Q8_O1 a ld:AnswerOption ;
    rdfs:label "2,147,483,647 children in total, of which half are hardened"@en .

pg:Q8_O2 a ld:AnswerOption ;
    rdfs:label "Four billion children, all of them normal"@en .

pg:SectionTree a ipo:TreeNavigation,
        owl:NamedIndividual ;
    rdfs:label "Section tree"@en ;
    dcterms:source <http://example.org/sen0401/ch05/document> ;
    skos:definition "The section tree lists the sections of the chapter by their three levels, and choosing one opens that single section."@en .

pg:Sidebar a ipo:Sidebar,
        owl:NamedIndividual ;
    rdfs:label "Chapter explorer"@en ;
    dcterms:source <http://example.org/sen0401/ch05/document> ;
    skos:definition "The explorer at the left shows the chapter's sections as a tree and keeps pace with the tabs of the main area."@en .

pg:SourceDocument a ipo:SourceDocument,
        owl:NamedIndividual ;
    rdfs:label "Chapter 5 Stage 3 document"@en ;
    ipo:hasLearningObjective pg:CO1,
        pg:CO2,
        pg:CO3,
        pg:CO4,
        pg:CO5 ;
    dcterms:source <http://example.org/sen0401/ch05/document> ;
    skos:definition "The Stage 3 document of chapter 5 is the text this page renders, section for section."@en .

pg:TopMenu a ipo:PrimaryNavigation,
        owl:NamedIndividual ;
    rdfs:label "Main menu"@en ;
    dcterms:source <http://example.org/sen0401/ch05/document> ;
    skos:definition "The main menu is permanently visible at the top and lets the reader reach every top-level area without scrolling or opening anything first."@en .

pg:Q1_O1 a ld:AnswerOption ;
    rdfs:label "Only keys, which are associated with bitcoins recorded on the blockchain"@en .

pg:Q2_O1 a ld:AnswerOption ;
    rdfs:label "128 bits of entropy and 4 checksum bits in the last word"@en .

pg:Q3_O2 a ld:AnswerOption ;
    rdfs:label "A different, valid tree of keys is produced, and the wallet simply shows an empty balance"@en .

pg:Q4_O0 a ld:AnswerOption ;
    rdfs:label "Because a leaked child private key together with the parent chain code would otherwise reveal the parent private key"@en .

pg:Q5_O2 a ld:AnswerOption ;
    rdfs:label "See every address of the branch and so every payment it ever received"@en .

pg:Q6_O1 a ld:AnswerOption ;
    rdfs:label "An empty wallet, because that software never derives the m/84h path"@en .

pg:Q7_O0 a ld:AnswerOption ;
    rdfs:label "The labels the user gave to their addresses and transactions"@en .

pg:Q8_O0 a ld:AnswerOption ;
    rdfs:label "2 to the 31 normal children with indices 0 to 2 to the 31 minus 1, so 2,147,483,648 of them"@en .

pg:S_AccountBranch a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Account branch"@en ;
    sen0401:anchor "#AccountBranch" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_AccountBranch> ;
    skos:definition "The account level is the third level of a BIP44 path, hardened, which splits a wallet into independent subaccounts that never mix coins."@en .

pg:S_AddressIndex a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Address index"@en ;
    sen0401:anchor "#AddressIndex" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_AddressIndex> ;
    skos:definition "The fifth level of a BIP44 path is the address index, counted from zero with normal derivation, and it is the level a wallet advances each time it needs a new address."@en .

pg:S_AddressLabel a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Address label"@en ;
    sen0401:anchor "#AddressLabel" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_AddressLabel> ;
    skos:definition "An address label is a note a user attaches to an address they hand out, so that payments arriving there can be recognised; it exists only in that user's wallet."@en .

pg:S_AezeedCode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Aezeed cipher seed"@en ;
    sen0401:anchor "#AezeedCode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_AezeedCode> ;
    skos:definition "The Aezeed scheme of the lnd wallet enciphers a plaintext of version, timestamp and entropy into a 24-word code, so the passphrase is authenticated and the code can be upgraded or re-enciphered."@en .

pg:S_BackupTesting a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Testing a backup"@en ;
    sen0401:anchor "#BackupTesting" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_BackupTesting> ;
    skos:definition "Testing a backup means carrying out a recovery before it is needed, which is the only way to learn that a code, a path and the non-key data are all sufficient."@en .

pg:S_Bip39Checksum a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "BIP39 checksum"@en ;
    sen0401:anchor "#Bip39Checksum" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Bip39Checksum> ;
    skos:definition "The BIP39 checksum is the first entropy-length over 32 bits of the SHA-256 hash of the entropy, appended to it, so that a mistyped code can be detected but not corrected."@en .

pg:S_Bip39Code a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "BIP39 recovery code"@en ;
    sen0401:anchor "#Bip39Code" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Bip39Code> ;
    skos:definition "A BIP39 recovery code is a sequence of 12 to 24 words that encodes a random number together with a short checksum, from which a 512-bit seed is derived; the standard was published in 2013 and is the most widely used scheme."@en .

pg:S_Bip39Passphrase a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Optional passphrase in BIP39"@en ;
    sen0401:anchor "#Bip39Passphrase" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Bip39Passphrase> ;
    skos:definition "In BIP39 the optional passphrase is appended to the constant salt, so any passphrase yields a different valid seed from the same words and none of them is wrong."@en .

pg:S_Bip39Stack a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The BIP39 stack"@en ;
    sen0401:anchor "#Bip39Stack" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Bip39Stack> ;
    skos:definition "This branch opens the second half of the chapter, in which the book stops surveying the options and works through one stack of technologies in detail."@en .

pg:S_Bip43Purpose a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Purpose level (BIP43)"@en ;
    sen0401:anchor "#Bip43Purpose" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Bip43Purpose> ;
    skos:definition "BIP43 reserves the first hardened level of a BIP32 tree for a purpose number that says which scheme the rest of the tree follows, and recommends using the scheme's own BIP number."@en .

pg:S_Bip44Structure a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "BIP44 structure"@en ;
    sen0401:anchor "#Bip44Structure" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Bip44Structure> ;
    skos:definition "BIP44 defines the five levels purpose, coin type, account, change and address index under purpose 44 hardened, with the first three hardened and the last two normal."@en .

pg:S_BitSegment a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Eleven-bit segment"@en ;
    sen0401:anchor "#BitSegment" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_BitSegment> ;
    skos:definition "The entropy and checksum are read as consecutive groups of 11 bits, each group a number from 0 to 2,047 that selects one word of the list."@en .

pg:S_Brainwallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Brainwallet"@en ;
    sen0401:anchor "#Brainwallet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Brainwallet> ;
    skos:definition "A brainwallet is a wallet whose keys come from a phrase the user chose, which is insecure because people are poor sources of randomness; a recovery code is generated by the wallet instead."@en .

pg:S_ChainCode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Chain code"@en ;
    sen0401:anchor "#ChainCode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ChainCode> ;
    skos:definition "A chain code is the 32 bytes of extra entropy carried beside a key so that derivation depends on more than the key; a key's children cannot be found without it."@en .

pg:S_ChangeBranch a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Change branch"@en ;
    sen0401:anchor "#ChangeBranch" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ChangeBranch> ;
    skos:definition "The fourth level of a BIP44 path is 0 for the external chain, whose addresses are given out, and 1 for the internal chain, which receives change; both use normal derivation."@en .

pg:S_ChildDerivation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Deriving child keys"@en ;
    sen0401:anchor "#ChildDerivation" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ChildDerivation> ;
    skos:definition "This group covers the functions that make a child key from a parent."@en .

pg:S_ChildKeyDerivation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Child key derivation"@en ;
    sen0401:anchor "#ChildKeyDerivation" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ChildKeyDerivation> ;
    skos:definition "A child is derived by hashing the parent key, the parent chain code and an index with HMAC-SHA512 and splitting the 512-bit result: the left half makes the child key, the right half is the child chain code."@en .

pg:S_ChildKeyIndependence a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Using a derived child key"@en ;
    sen0401:anchor "#ChildKeyIndependence" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ChildKeyIndependence> ;
    skos:definition "A child key on its own behaves exactly like a randomly generated key: it can make a public key, an address and signatures, but it cannot find its parent, its siblings or its own children."@en .

pg:S_CodeGeneration a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Generating a recovery code"@en ;
    sen0401:anchor "#CodeGeneration" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_CodeGeneration> ;
    skos:definition "This group follows the first six steps of BIP39. The chapter states them as a list: create a random sequence, that is entropy, of 128 to 256 bits; create a checksum of it by taking the first entropy-length over 32 bits of its SHA-256 hash; add the checksum to the end of the random sequence; split the result into segments 11 bits long; map each 11-bit value to a word from the predefined dictionary of 2,048 words; and the recovery code is the sequence of words (Antonopoulos and Harding, 2023)."@en .

pg:S_CodeLength a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Code length"@en ;
    sen0401:anchor "#CodeLength" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_CodeLength> ;
    skos:definition "Entropy length, checksum length and word count are tied together: the checksum is a thirty-second of the entropy and the total divided by 11 is the number of words, so codes have 12, 15, 18, 21 or 24 words."@en .

pg:S_CodeSchemes a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Recovery code schemes"@en ;
    sen0401:anchor "#CodeSchemes" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_CodeSchemes> ;
    skos:definition "This group describes the recovery code schemes themselves."@en .

pg:S_CodeTradeoffs a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Choices behind a recovery code"@en ;
    sen0401:anchor "#CodeTradeoffs" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_CodeTradeoffs> ;
    skos:definition "This group gathers the decisions that are not settled by choosing a scheme."@en .

pg:S_Codex32Code a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Codex32 recovery code"@en ;
    sen0401:anchor "#Codex32Code" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Codex32Code> ;
    skos:definition "codex32 writes a BIP32 master seed in the bech32 alphabet with an error-correcting checksum that can be verified by hand, and can split the seed into up to 31 shares with a threshold between 2 and 9."@en .

pg:S_ColdStorage a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Cold storage"@en ;
    sen0401:anchor "#ColdStorage" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ColdStorage> ;
    skos:definition "Cold storage means keeping keys offline, created and stored in a secure environment that is not connected to a network, so that an attack on a connected computer cannot reach them."@en .

pg:S_CryptographicPrimitives a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Cryptographic primitives"@en ;
    sen0401:anchor "#CryptographicPrimitives" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_CryptographicPrimitives> ;
    skos:definition "A cryptographic primitive is a basic operation out of which protocols are built: this group covers the four that chapter 5 uses."@en .

pg:S_DataLoss a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Data loss"@en ;
    sen0401:anchor "#DataLoss" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_DataLoss> ;
    skos:definition "Data loss is the loss of the keys or of the information needed to use them, which the chapter names as perhaps the leading cause of lost bitcoins, and which no one can reverse."@en .

pg:S_DescriptorChecksum a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Descriptor checksum"@en ;
    sen0401:anchor "#DescriptorChecksum" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_DescriptorChecksum> ;
    skos:definition "A descriptor carries an eight-character error-detecting checksum after a hash sign, which catches any one or two symbol errors in a descriptor of ordinary length."@en .

pg:S_Descriptors a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Output script descriptors"@en ;
    sen0401:anchor "#Descriptors" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Descriptors> ;
    skos:definition "This group covers the notation in which explicit paths are written."@en .

pg:S_DeterministicKeyGeneration a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Deterministic key generation"@en ;
    sen0401:anchor "#DeterministicKeyGeneration" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_DeterministicKeyGeneration> ;
    skos:definition "Deterministic key generation computes keys from a seed by a fixed rule, such as hashing the seed with a counter, so the same seed always yields the same keys."@en .

pg:S_DigitalSignature a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Digital signature"@en ;
    sen0401:anchor "#DigitalSignature" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_DigitalSignature> ;
    skos:definition "A digital signature is a value computed from a message and a private key that anyone can check against the matching public key, which is how spending a Bitcoin output is authorised."@en .

pg:S_ElectrumV2Code a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Electrum version 2 recovery code"@en ;
    sen0401:anchor "#ElectrumV2Code" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ElectrumV2Code> ;
    skos:definition "The Electrum version 2 scheme derives both the master private key and a version number from a hash of the normalised phrase, so it needs no fixed word list and can tell an old code from a new one."@en .

pg:S_EncryptedWalletBackup a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Encrypted wallet backup"@en ;
    sen0401:anchor "#EncryptedWalletBackup" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_EncryptedWalletBackup> ;
    skos:definition "An encrypted wallet backup is a complete copy of the wallet database, encrypted under a key derived from the seed, which a user can restore from a recovery code alone."@en .

pg:S_Encryption a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Encryption"@en ;
    sen0401:anchor "#Encryption" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Encryption> ;
    skos:definition "Encryption turns data into a form that only a holder of the key can read back; a wallet can therefore store a backup where anyone can see it, as long as the key stays secret."@en .

pg:S_Entropy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Entropy"@en ;
    sen0401:anchor "#Entropy" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Entropy> ;
    skos:definition "Entropy is the unpredictability of a value, measured in bits; a BIP39 code encodes 128 to 256 bits of it, drawn by the wallet from a source of randomness and not chosen by a person."@en .

pg:S_ExplicitPath a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Explicit path"@en ;
    sen0401:anchor "#ExplicitPath" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ExplicitPath> ;
    skos:definition "An explicit path is derivation information backed up alongside the recovery code, which says exactly which keys go with which scripts and can carry extra data such as other people's public keys."@en .

pg:S_ExtendedKey a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Extended key"@en ;
    sen0401:anchor "#ExtendedKey" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ExtendedKey> ;
    skos:definition "An extended key is a key together with its chain code, stored as the two concatenated; it is the root of a branch and is what a derivation function needs."@en .

pg:S_ExtendedKeyEncoding a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Extended key encoding"@en ;
    sen0401:anchor "#ExtendedKeyEncoding" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ExtendedKeyEncoding> ;
    skos:definition "An extended key is written in base58check with four version bytes, which is what produces the recognisable xprv and xpub prefixes and a fixed length of 111 characters."@en .

pg:S_ExtendedKeys a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Extended keys"@en ;
    sen0401:anchor "#ExtendedKeys" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ExtendedKeys> ;
    skos:definition "This group is about the object a wallet actually passes around."@en .

pg:S_ExtendedPrivateKey a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Extended private key"@en ;
    sen0401:anchor "#ExtendedPrivateKey" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ExtendedPrivateKey> ;
    skos:definition "An extended private key is a private key with its chain code; it can derive every descendant key, private and public, and is written with the prefix xprv."@en .

pg:S_ExtendedPublicKey a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Extended public key"@en ;
    sen0401:anchor "#ExtendedPublicKey" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ExtendedPublicKey> ;
    skos:definition "An extended public key is a public key with its chain code: it derives all the normal public keys of its branch and none of the private ones, and is written with the prefix xpub."@en .

pg:S_ExternalSigning a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "External signing"@en ;
    sen0401:anchor "#ExternalSigning" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ExternalSigning> ;
    skos:definition "In external signing the wallet application builds a transaction and another party, a hardware signing device or the other signers of a multisignature scheme, holds the private keys and returns the signature."@en .

pg:S_Foundations a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Foundations the chapter relies on"@en ;
    sen0401:anchor "#Foundations" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Foundations> ;
    skos:definition "This last branch collects the ideas that the rest of the chapter uses as though they were already known."@en .

pg:S_GapLimit a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Gap limit"@en ;
    sen0401:anchor "#GapLimit" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_GapLimit> ;
    skos:definition "The gap limit is the number of unused addresses in a row that a wallet will tolerate before it stops looking for payments; a payment beyond it is not found."@en .

pg:S_HardenedDerivation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hardened child key derivation"@en ;
    sen0401:anchor "#HardenedDerivation" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_HardenedDerivation> ;
    skos:definition "Hardened derivation feeds the parent private key, not the parent public key, into the hash, so the resulting chain code cannot be used with a leaked child key to recover the parent."@en .

pg:S_HardwareSigningDevice a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hardware signing device"@en ;
    sen0401:anchor "#HardwareSigningDevice" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_HardwareSigningDevice> ;
    skos:definition "A hardware signing device stores private keys and produces signatures on request without revealing the keys, so a less secure computer can build transactions it cannot sign."@en .

pg:S_HashFunction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hash function"@en ;
    sen0401:anchor "#HashFunction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_HashFunction> ;
    skos:definition "A hash function maps data of any size to a fixed-size value, always the same for the same input and unpredictable for a changed one, and cannot be run backwards."@en .

pg:S_HdKeyGeneration a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hierarchical deterministic key generation"@en ;
    sen0401:anchor "#HdKeyGeneration" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_HdKeyGeneration> ;
    skos:definition "Hierarchical deterministic (HD) key generation, the standard BIP32, derives a tree of keys from one seed; any key can be the parent of further keys, and public keys can be derived without private keys."@en .

pg:S_HdWallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hierarchical deterministic wallet"@en ;
    sen0401:anchor "#HdWallet" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch05#S_HdWallet> ;
    skos:definition "A hierarchical deterministic wallet, which the chapter and the standards abbreviate to HD wallet, is a wallet whose keys form a tree, every node of which is computed from the seed."@en .

pg:S_HmacSha512 a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "HMAC-SHA512"@en ;
    sen0401:anchor "#HmacSha512" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_HmacSha512> ;
    skos:definition "HMAC-SHA512 is a keyed hash: it combines a key and a message into 64 bytes that cannot be produced without the key, and BIP32 uses it both to make the master keys and to derive every child."@en .

pg:S_ImplicitPath a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Implicit path"@en ;
    sen0401:anchor "#ImplicitPath" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ImplicitPath> ;
    skos:definition "An implicit path is a standardised derivation path that a wallet uses without being told, so that nothing has to be backed up beside the recovery code - at the price of inflexibility."@en .

pg:S_IndependentKeyGeneration a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Independent key generation"@en ;
    sen0401:anchor "#IndependentKeyGeneration" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_IndependentKeyGeneration> ;
    skos:definition "In independent key generation every key is created separately from random data, so every key has to be saved on its own and the backup is out of date after each new key."@en .

pg:S_IndexNumber a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Index number"@en ;
    sen0401:anchor "#IndexNumber" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_IndexNumber> ;
    skos:definition "The index is the 32-bit number that selects which child is derived; indices below 2 to the 31 are normal children and those at or above it are hardened, displayed with an apostrophe or an h."@en .

pg:S_KeyFingerprint a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Key fingerprint"@en ;
    sen0401:anchor "#KeyFingerprint" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_KeyFingerprint> ;
    skos:definition "A key fingerprint is the first four bytes of the hash identifier of an extended key, used as a short, non-unique label for the parent a derivation started from."@en .

pg:S_KeyGenerationMethods a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Key generation methods"@en ;
    sen0401:anchor "#KeyGenerationMethods" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_KeyGenerationMethods> ;
    skos:definition "Key generation methods are the ways a wallet application produces the key pairs that it will later distribute and use."@en .

pg:S_KeyOrigin a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Key origin"@en ;
    sen0401:anchor "#KeyOrigin" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_KeyOrigin> ;
    skos:definition "The key origin of a descriptor records, in brackets, the fingerprint of the master key and the path from it to the key that follows, so that a signing device can find the right key."@en .

pg:S_KeyPath a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Key path"@en ;
    sen0401:anchor "#KeyPath" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_KeyPath> ;
    skos:definition "A key path names a key by the sequence of indices from the root, written with slashes, beginning m for private or M for public keys, with a prime or h for hardened steps."@en .

pg:S_KeyStretchingFunction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Key-stretching function"@en ;
    sen0401:anchor "#KeyStretchingFunction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_KeyStretchingFunction> ;
    skos:definition "A key-stretching function derives a key from a secret deliberately slowly, by repeating a hash many times, so that each guess an attacker makes costs more."@en .

pg:S_KeyTweak a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Key tweak"@en ;
    sen0401:anchor "#KeyTweak" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_KeyTweak> ;
    skos:definition "A key tweak is a value added to a public key, and in the same way to its private key, so that the child public key can be computed by someone who does not know the private key."@en .

pg:S_LabelExportFormat a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Label export format (BIP329)"@en ;
    sen0401:anchor "#LabelExportFormat" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_LabelExportFormat> ;
    skos:definition "BIP329 proposes a line-based JSON format for exporting wallet labels, so that labels can be moved between applications instead of locking a user into one."@en .

pg:S_LightningNetwork a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Lightning Network"@en ;
    sen0401:anchor "#LightningNetwork" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_LightningNetwork> ;
    skos:definition "The Lightning Network is a protocol of payment channels built on Bitcoin, in which funds live in outputs that two parties control jointly, so a wallet must keep state that no seed can reproduce."@en .

pg:S_MasterChainCode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Master chain code"@en ;
    sen0401:anchor "#MasterChainCode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_MasterChainCode> ;
    skos:definition "The master chain code is the right 32 bytes of HMAC-SHA512 over the seed: 256 bits of extra entropy that make every derivation depend on more than the key."@en .

pg:S_MasterKeys a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Master keys from the seed"@en ;
    sen0401:anchor "#MasterKeys" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_MasterKeys> ;
    skos:definition "This group covers the one step that turns a seed into the root of a key tree."@en .

pg:S_MasterPrivateKey a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Master private key"@en ;
    sen0401:anchor "#MasterPrivateKey" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_MasterPrivateKey> ;
    skos:definition "The master private key is the left 32 bytes of HMAC-SHA512 over the seed, read as a 256-bit number; it is the root of the tree and is written m."@en .

pg:S_Memorization a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Memorising a recovery code"@en ;
    sen0401:anchor "#Memorization" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Memorization> ;
    skos:definition "Memorising a code is possible because the code is words, and is dangerous because memory fails, cannot be inherited and can be coerced; the chapter recommends writing the code down as well."@en .

pg:S_Miniscript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Miniscript"@en ;
    sen0401:anchor "#Miniscript" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Miniscript> ;
    skos:definition "Miniscript is a structured language for a subset of Bitcoin scripts, so that spending conditions can be analysed, composed and signed for; descriptors can contain it."@en .

pg:S_MultipathDescriptor a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Multipath descriptor"@en ;
    sen0401:anchor "#MultipathDescriptor" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_MultipathDescriptor> ;
    skos:definition "A multipath descriptor writes a tuple of derivation steps in angle brackets, so that one descriptor stands for the receive and the change descriptor of a wallet."@en .

pg:S_Multisignature a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Multisignature"@en ;
    sen0401:anchor "#Multisignature" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Multisignature> ;
    skos:definition "A multisignature arrangement requires several of a set of keys to sign; its participants cannot restore the arrangement from their own seeds alone, because they also need the others' public keys."@en .

pg:S_MuunCode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Muun recovery code"@en ;
    sen0401:anchor "#MuunCode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_MuunCode> ;
    skos:definition "The Muun recovery code is not words and is not the seed: it is a key that decrypts the private keys held in a document the wallet gives the user, which suits a wallet whose spending needs several signatures."@en .

pg:S_NonkeyBackup a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Backing up data that is not keys"@en ;
    sen0401:anchor "#NonkeyBackup" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch05#S_NonkeyBackup> ;
    skos:definition "This branch is about everything in a wallet that a seed cannot reproduce."@en .

pg:S_OfflineKeys a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Keys kept offline"@en ;
    sen0401:anchor "#OfflineKeys" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_OfflineKeys> ;
    skos:definition "This group covers the other half of every arrangement in the chapter: where the private keys are when they are not in use."@en .

pg:S_OtherProtocolData a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Other data a wallet keeps"@en ;
    sen0401:anchor "#OtherProtocolData" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_OtherProtocolData> ;
    skos:definition "This group covers the data that protocols built on top of Bitcoin add to a wallet, and the one general solution the chapter offers for backing everything up."@en .

pg:S_OutputScript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Output script"@en ;
    sen0401:anchor "#OutputScript" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_OutputScript> ;
    skos:definition "An output script is the program in a transaction output that says what must be presented to spend it; a descriptor is a description of a family of such scripts."@en .

pg:S_OutputScriptDescriptor a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Output script descriptor"@en ;
    sen0401:anchor "#OutputScriptDescriptor" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_OutputScriptDescriptor> ;
    skos:definition "A descriptor is a short expression naming a script type as a function and its keys as arguments, so that it says exactly which scripts and addresses a wallet should produce."@en .

pg:S_PathBackup a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Backing up derivation paths"@en ;
    sen0401:anchor "#PathBackup" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch05#S_PathBackup> ;
    skos:definition "This branch is about the part of a backup that a recovery code does not contain."@en .

pg:S_PathConventions a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Implicit and explicit paths"@en ;
    sen0401:anchor "#PathConventions" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_PathConventions> ;
    skos:definition "This group covers the two ways of knowing which paths a wallet used."@en .

pg:S_PaymentProcessor a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Payment processor"@en ;
    sen0401:anchor "#PaymentProcessor" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_PaymentProcessor> ;
    skos:definition "A payment processor is the program that watches for payments and matches them to orders; a self-hosted one lets a merchant accept bitcoins with the extended public key as its only key material."@en .

pg:S_Pbkdf2 a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "PBKDF2"@en ;
    sen0401:anchor "#Pbkdf2" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Pbkdf2> ;
    skos:definition "PBKDF2 is the standard password-based key derivation function that BIP39 uses: it applies HMAC-SHA512 2,048 times to the words and the salt and returns 64 bytes."@en .

pg:S_PhysicalCoercion a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Coercion and physical risk"@en ;
    sen0401:anchor "#PhysicalCoercion" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_PhysicalCoercion> ;
    skos:definition "Because a recovery code is all that is needed to spend, people who are believed to hold one have been attacked in person; the chapter cites a public list of such cases and the list has grown since."@en .

pg:S_PlausibleDeniability a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Plausible deniability"@en ;
    sen0401:anchor "#PlausibleDeniability" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_PlausibleDeniability> ;
    skos:definition "Plausible deniability is the property that a revealed recovery code or passphrase always looks valid, so a holder cannot be shown to have withheld anything - which protects and endangers them at the same time."@en .

pg:S_PrivateChildDerivation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Private child key derivation"@en ;
    sen0401:anchor "#PrivateChildDerivation" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_PrivateChildDerivation> ;
    skos:definition "A private child is the sum, modulo the order of the curve, of the parent private key and the left half of the derivation hash; the right half is the child's chain code."@en .

pg:S_PublicChildDerivation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Public child key derivation"@en ;
    sen0401:anchor "#PublicChildDerivation" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_PublicChildDerivation> ;
    skos:definition "A public child can be derived from a parent public key and chain code alone, because adding a value to a public key gives the public key of the sum, so a server can make addresses without the power to spend."@en .

pg:S_PublicKeyOnlyWallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Wallet with public keys only"@en ;
    sen0401:anchor "#PublicKeyOnlyWallet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_PublicKeyOnlyWallet> ;
    skos:definition "A wallet database that holds public keys but not the private keys can recognise payments and create receiving addresses but cannot sign a spending transaction."@en .

pg:S_RecoveryCodes a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Recovery codes"@en ;
    sen0401:anchor "#RecoveryCodes" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch05#S_RecoveryCodes> ;
    skos:definition "A recovery code is the short, written form of a wallet's seed: a sequence of words, or in one case a string of letters and digits, from which every key of a deterministic wallet can be computed again."@en .

pg:S_RecoveryPassphrase a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Recovery code passphrase"@en ;
    sen0401:anchor "#RecoveryPassphrase" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_RecoveryPassphrase> ;
    skos:definition "A passphrase is an extra secret that is mixed into the derivation of the seed, so that one recovery code yields a different wallet for every passphrase and the code alone is not enough to spend."@en .

pg:S_RecoveryPractice a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Recovery as a practice"@en ;
    sen0401:anchor "#RecoveryPractice" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_RecoveryPractice> ;
    skos:definition "This last group turns the chapter's technical content into two statements about practice."@en .

pg:S_RootSeed a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Root seed"@en ;
    sen0401:anchor "#RootSeed" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_RootSeed> ;
    skos:definition "The root seed is the value from which every key of a hierarchical deterministic wallet is derived; BIP39 produces one of 512 bits, and BIP32 accepts 128 to 512."@en .

pg:S_Salt a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Salt"@en ;
    sen0401:anchor "#Salt" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Salt> ;
    skos:definition "A salt is the second, non-secret input of a key derivation function; BIP39's salt is the string mnemonic followed by the optional passphrase, which is how the passphrase changes the seed."@en .

pg:S_SecretSharing a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Secret sharing"@en ;
    sen0401:anchor "#SecretSharing" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_SecretSharing> ;
    skos:definition "Secret sharing splits a secret into parts so that any sufficient number of them recovers it and any smaller number reveals nothing; it is the mathematics behind SLIP39 and codex32."@en .

pg:S_SecurityStrength a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Security strength"@en ;
    sen0401:anchor "#SecurityStrength" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_SecurityStrength> ;
    skos:definition "Security strength is the work an attacker needs, measured in bits; extended keys hold 512 bits, private keys 256, and the elliptic curve offers about 128, so more than 128 bits of entropy buys little."@en .

pg:S_Seed a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Seed"@en ;
    sen0401:anchor "#Seed" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Seed> ;
    skos:definition "A seed is the random value from which a deterministic wallet derives all its keys; the same seed, with the same algorithm, always gives the same keys."@en .

pg:S_SeedDerivation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "From the code to the seed"@en ;
    sen0401:anchor "#SeedDerivation" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_SeedDerivation> ;
    skos:definition "This group covers the last three of BIP39's nine steps, the ones that turn words back into the number a wallet actually uses."@en .

pg:S_ShaAlgorithm a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "SHA-256 and SHA-512"@en ;
    sen0401:anchor "#ShaAlgorithm" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_ShaAlgorithm> ;
    skos:definition "SHA-256 and SHA-512 are the two secure hash algorithms this chapter's standards name, producing 32 and 64 bytes; the choice of one or the other fixes the sizes in every scheme."@en .

pg:S_Slip39Code a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "SLIP39 share set"@en ;
    sen0401:anchor "#Slip39Code" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_Slip39Code> ;
    skos:definition "SLIP39 splits one seed into several word codes with a threshold, so that any sufficient subset recovers the seed and any smaller subset reveals nothing about it."@en .

pg:S_StandardPath44 a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "BIP44 path for legacy scripts"@en ;
    sen0401:anchor "#StandardPath44" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_StandardPath44> ;
    skos:definition "BIP44's account path for pay-to-public-key-hash scripts is the first of the standard implicit paths and the one the chapter's table gives for legacy addresses."@en .

pg:S_StandardPath49 a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "BIP49 path for nested segwit"@en ;
    sen0401:anchor "#StandardPath49" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_StandardPath49> ;
    skos:definition "BIP49 gives segregated witness keys wrapped in a script hash their own account path, so that an incompatible wallet finds nothing rather than finding part of the funds."@en .

pg:S_StandardPath84 a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "BIP84 path for native segwit"@en ;
    sen0401:anchor "#StandardPath84" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_StandardPath84> ;
    skos:definition "BIP84 gives native segregated witness keys their own account path, and its test vector's first address is the bech32 address the course can recompute from the key hash."@en .

pg:S_StandardPath86 a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "BIP86 path for single-key taproot"@en ;
    sen0401:anchor "#StandardPath86" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_StandardPath86> ;
    skos:definition "BIP86 gives single-key taproot outputs their own account path and says how the output key is computed from the derived key by a tagged hash."@en .

pg:S_StaticChannelBackup a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Static channel backup"@en ;
    sen0401:anchor "#StaticChannelBackup" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_StaticChannelBackup> ;
    skos:definition "A static channel backup records what is needed to recover a channel's settled funds and is taken once, when the channel is created; it allows recovery of those funds but cannot guarantee the result."@en .

pg:S_TextNormalization a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Text normalisation"@en ;
    sen0401:anchor "#TextNormalization" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_TextNormalization> ;
    skos:definition "Normalisation rewrites text in a single canonical form before it is hashed, so that two spellings a person cannot distinguish produce the same bytes and therefore the same seed."@en .

pg:S_TransactionLabel a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction label"@en ;
    sen0401:anchor "#TransactionLabel" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_TransactionLabel> ;
    skos:definition "A transaction label is a note a user attaches to a payment they made or received, which a seed-based restoration cannot reproduce."@en .

pg:S_TreeNavigation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Navigating the tree"@en ;
    sen0401:anchor "#TreeNavigation" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_TreeNavigation> ;
    skos:definition "This group is about saying which key of the tree is meant."@en .

pg:S_WalletBirthday a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Wallet birthday"@en ;
    sen0401:anchor "#WalletBirthday" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_WalletBirthday> ;
    skos:definition "A wallet birthday is the creation date recorded inside a recovery code, so that a restoration can scan the blockchain from that date instead of from the beginning."@en .

pg:S_WalletContents a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Wallet contents"@en ;
    sen0401:anchor "#WalletContents" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_WalletContents> ;
    skos:definition "Wallet contents is the group of ideas that answer a simple question: what is inside a Bitcoin wallet, and what is not? It collects three concepts."@en .

pg:S_WalletDatabase a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Wallet database"@en ;
    sen0401:anchor "#WalletDatabase" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_WalletDatabase> ;
    skos:definition "The wallet database is the stored collection of keys (and the notes about them) that a wallet application reads and writes; it holds the means to prove control of bitcoins, not the bitcoins themselves."@en .

pg:S_WalletDeployment a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Deploying keys in practice"@en ;
    sen0401:anchor "#WalletDeployment" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch05#S_WalletDeployment> ;
    skos:definition "This branch is the chapter's extended worked example and its practical advice."@en .

pg:S_WalletKeys a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Wallet keys"@en ;
    sen0401:anchor "#WalletKeys" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch05#S_WalletKeys> ;
    skos:definition "This first branch of the chapter asks what a Bitcoin wallet really contains and where its keys come from."@en .

pg:S_WalletNotes a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Labels and notes"@en ;
    sen0401:anchor "#WalletNotes" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_WalletNotes> ;
    skos:definition "This group covers the information a user adds to a wallet by hand."@en .

pg:S_WebStore a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "An extended key on a web store"@en ;
    sen0401:anchor "#WebStore" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch05#S_WebStore> ;
    skos:definition "This group follows the chapter's web store example and the one new idea it needs."@en .

pg:S_WordList a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Word list"@en ;
    sen0401:anchor "#WordList" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_WordList> ;
    skos:definition "The BIP39 word list holds exactly 2,048 words, so that each word stands for 11 bits; the list is sorted, has unique four-letter prefixes and avoids similar pairs."@en .

pg:S_WrittenBackup a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Written backup"@en ;
    sen0401:anchor "#WrittenBackup" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_WrittenBackup> ;
    skos:definition "A written backup is the recovery code on paper, which the chapter recommends even for schemes designed to be memorised, because memory fails and cannot be inherited."@en .

pg:S_XpubDeployment a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Extended public key deployment"@en ;
    sen0401:anchor "#XpubDeployment" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch05#S_XpubDeployment> ;
    skos:definition "Deploying an extended public key means putting the watching half of a wallet on an exposed computer, which can then derive a fresh address for every order and spend nothing."@en .

pg:CO4 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Compare the recovery code schemes and the implicit and explicit path solutions, and justify a choice for a given user"@en ;
    ld:bloomLevel ld:Analyze ;
    dcterms:source <http://example.org/sen0401/ch05/document> ;
    skos:definition "After this chapter the learner can compare the recovery code schemes and the implicit and explicit path solutions, and justify a choice for a given user."@en .

pg:CO5 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Check a chapter's statements against the standards and against independent software, and say which is right"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch05/document> ;
    skos:definition "After this chapter the learner can check a chapter's statements against the standards and against independent software, and say which is right."@en .

pg:CO1 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Generate a BIP39 recovery code from entropy and derive its seed, and say how many words a given amount of entropy gives"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch05/document> ;
    skos:definition "After this chapter the learner can generate a BIP39 recovery code from entropy and derive its seed, and say how many words a given amount of entropy gives."@en .

pg:CO2 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Explain what a wallet database holds, which of its contents a seed can reproduce and which cannot"@en ;
    ld:bloomLevel ld:Understand ;
    dcterms:source <http://example.org/sen0401/ch05/document> ;
    skos:definition "After this chapter the learner can explain what a wallet database holds, which of its contents a seed can reproduce and which cannot."@en .

pg:CO3 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Derive keys along a BIP32 path, read any path, and say what the holder of an extended public key can and cannot do"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch05/document> ;
    skos:definition "After this chapter the learner can derive keys along a BIP32 path, read any path, and say what the holder of an extended public key can and cannot do."@en .

