chx:DataLoss a owl:Class ; rdfs:label "Data loss"@en ; rdfs:subClassOf chx:RecoveryPractice ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:BackupTesting a owl:Class ; rdfs:label "Testing a backup"@en ; rdfs:subClassOf chx:RecoveryPractice ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:WalletKeys owl:disjointWith chx:RecoveryCodes .
chx:WalletKeys owl:disjointWith chx:Bip39Stack .
chx:WalletKeys owl:disjointWith chx:HdWallet .
chx:WalletKeys owl:disjointWith chx:PathBackup .
chx:WalletKeys owl:disjointWith chx:NonkeyBackup .
chx:WalletKeys owl:disjointWith chx:WalletDeployment .
chx:WalletKeys owl:disjointWith chx:Foundations .
chx:RecoveryCodes owl:disjointWith chx:Bip39Stack .
chx:RecoveryCodes owl:disjointWith chx:HdWallet .
chx:RecoveryCodes owl:disjointWith chx:PathBackup .
chx:RecoveryCodes owl:disjointWith chx:NonkeyBackup .
chx:RecoveryCodes owl:disjointWith chx:WalletDeployment .
chx:RecoveryCodes owl:disjointWith chx:Foundations .
chx:Bip39Stack owl:disjointWith chx:HdWallet .
chx:Bip39Stack owl:disjointWith chx:PathBackup .
chx:Bip39Stack owl:disjointWith chx:NonkeyBackup .
chx:Bip39Stack owl:disjointWith chx:WalletDeployment .
chx:Bip39Stack owl:disjointWith chx:Foundations .
chx:HdWallet owl:disjointWith chx:PathBackup .
chx:HdWallet owl:disjointWith chx:NonkeyBackup .
chx:HdWallet owl:disjointWith chx:WalletDeployment .
chx:HdWallet owl:disjointWith chx:Foundations .
chx:PathBackup owl:disjointWith chx:NonkeyBackup .
chx:PathBackup owl:disjointWith chx:WalletDeployment .
chx:PathBackup owl:disjointWith chx:Foundations .
chx:NonkeyBackup owl:disjointWith chx:WalletDeployment .
chx:NonkeyBackup owl:disjointWith chx:Foundations .
chx:WalletDeployment owl:disjointWith chx:Foundations .
chx:hasOwner a owl:ObjectProperty ; rdfs:label "owned by"@en ; rdfs:subPropertyOf rd:hasOwningConcept ;
    rdfs:comment "A concept owned by the concept it belongs to, as the chapter's examples use it between typed things; domain and range are the union of every type the A-Box shows on the two sides (BP-D57 step 3)."@en ;
    rdfs:domain [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> owl:Class ; owl:unionOf ( chx:AccountBranch chx:AddressIndex chx:AddressLabel chx:Bip39Checksum chx:Bip39Passphrase chx:Bip43Purpose chx:BitSegment chx:ChainCode chx:ChangeBranch chx:CodeLength chx:DescriptorChecksum chx:GapLimit chx:HardenedDerivation chx:IndexNumber chx:KeyFingerprint chx:KeyOrigin chx:MasterChainCode chx:MasterPrivateKey chx:MultipathDescriptor chx:Pbkdf2 chx:PrivateChildDerivation chx:PublicChildDerivation chx:Salt chx:StaticChannelBackup chx:TransactionLabel chx:WalletBirthday chx:WordList ) ] ;
    rdfs:range [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> owl:Class ; owl:unionOf ( chx:AezeedCode chx:Bip39Code chx:Bip44Structure chx:ChildKeyDerivation chx:ExtendedKey chx:KeyStretchingFunction chx:LightningNetwork chx:OutputScriptDescriptor chx:Pbkdf2 chx:RootSeed chx:WalletDatabase chx:XpubDeployment ) ] ;
    rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .

#################################################################
# Connectedness repair (discipline v2.19.0, BP-D56 and BP-D57), 2026-10-19.
# The datatype properties the A-Box uses and nothing declared, then the relations
# between the chapter's subject branches that the chapter's own sources state.
#################################################################
chx:input a owl:DatatypeProperty ; rdfs:label "input expression"@en ; rdfs:comment "The expression an input/output example evaluates."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:output a owl:DatatypeProperty ; rdfs:label "output value"@en ; rdfs:comment "The value that evaluating the example expression gives."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:recordsFingerprint a owl:ObjectProperty ; rdfs:label "records"@en ;
    rdfs:comment "A descriptor's key origin records the fingerprint of the master key. Basis: the chapter says of Key origin: 'records, in brackets, the fingerprint of the master key and the path from it to the key'."@en ;
    rdfs:domain chx:KeyOrigin ; rdfs:range chx:KeyFingerprint ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:recordsKeyPath a owl:ObjectProperty ; rdfs:label "records"@en ;
    rdfs:comment "A descriptor's key origin records the path from the master key to the key. Basis: the chapter says of Key origin: 'records, in brackets, the fingerprint of the master key and the path from it to the key'."@en ;
    rdfs:domain chx:KeyOrigin ; rdfs:range chx:KeyPath ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:followsBip44Structure a owl:ObjectProperty ; rdfs:label "follows"@en ;
    rdfs:comment "The BIP44 path for legacy scripts is BIP44's account path. Basis: the chapter says of BIP44 path for legacy scripts: 'BIP44's account path for pay-to-public-key-hash scripts'."@en ;
    rdfs:domain chx:StandardPath44 ; rdfs:range chx:Bip44Structure ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:isBackedUpAlongside a owl:ObjectProperty ; rdfs:label "is backed up alongside"@en ;
    rdfs:comment "An explicit path is derivation information backed up alongside the recovery code. Basis: the chapter says of Explicit path: 'derivation information backed up alongside the recovery code'."@en ;
    rdfs:domain chx:ExplicitPath ; rdfs:range chx:RecoveryCodes ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:includesBip39Checksum a owl:ObjectProperty ; rdfs:label "includes"@en ;
    rdfs:comment "A BIP39 recovery code encodes a random number together with a short checksum. Basis: the chapter says of BIP39 recovery code: 'encodes a random number together with a short checksum'."@en ;
    rdfs:domain chx:Bip39Code ; rdfs:range chx:Bip39Checksum ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:derivesRootSeed a owl:ObjectProperty ; rdfs:label "gives rise to"@en ;
    rdfs:comment "A 512-bit seed is derived from a BIP39 recovery code. Basis: the chapter says of BIP39 recovery code: 'from which a 512-bit seed is derived'."@en ;
    rdfs:domain chx:Bip39Code ; rdfs:range chx:RootSeed ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:mixesIntoSeed a owl:ObjectProperty ; rdfs:label "is mixed into"@en ;
    rdfs:comment "A passphrase is mixed into the derivation of the seed. Basis: the chapter says of Recovery code passphrase: 'mixed into the derivation of the seed'."@en ;
    rdfs:domain chx:RecoveryPassphrase ; rdfs:range chx:Seed ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:splitsSeed a owl:ObjectProperty ; rdfs:label "splits"@en ;
    rdfs:comment "SLIP39 splits one seed into several word codes. Basis: the chapter says of SLIP39 share set: 'SLIP39 splits one seed into several word codes with a threshold'."@en ;
    rdfs:domain chx:Slip39Code ; rdfs:range chx:Seed ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:underpinsSlip39 a owl:ObjectProperty ; rdfs:label "is the mathematics behind"@en ;
    rdfs:comment "Secret sharing is the mathematics behind SLIP39. Basis: the chapter says of Secret sharing: 'the mathematics behind SLIP39'."@en ;
    rdfs:domain chx:SecretSharing ; rdfs:range chx:Slip39Code ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:isTakenFromSha a owl:ObjectProperty ; rdfs:label "is taken from"@en ;
    rdfs:comment "The BIP39 checksum is taken from the SHA-256 hash of the entropy. Basis: the chapter says of BIP39 checksum: 'of the SHA-256 hash of the entropy'."@en ;
    rdfs:domain chx:Bip39Checksum ; rdfs:range chx:ShaAlgorithm ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:appliesHmacSha512 a owl:ObjectProperty ; rdfs:label "applies"@en ;
    rdfs:comment "PBKDF2 as BIP39 uses it applies HMAC-SHA512 2,048 times. Basis: the chapter says of PBKDF2: 'it applies HMAC-SHA512 2,048 times to the words and the salt'."@en ;
    rdfs:domain chx:Pbkdf2 ; rdfs:range chx:HmacSha512 ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:isRootSeedOf a owl:ObjectProperty ; rdfs:label "is the root of"@en ;
    rdfs:comment "The root seed is the value from which every key of a hierarchical deterministic wallet is derived. Basis: the chapter says of Root seed: 'The root seed is the value from which every key of a hierarchical deterministic wallet is derived'."@en ;
    rdfs:domain chx:RootSeed ; rdfs:range chx:HdWallet ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:isDerivedFromRootSeed a owl:ObjectProperty ; rdfs:label "is derived from"@en ;
    rdfs:comment "The master private key is the left 32 bytes of HMAC-SHA512 over the seed. Basis: the chapter says of Master private key: 'the left 32 bytes of HMAC-SHA512 over the seed'."@en ;
    rdfs:domain chx:MasterPrivateKey ; rdfs:range chx:RootSeed ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:explainsPublicDerivation a owl:ObjectProperty ; rdfs:label "explains"@en ;
    rdfs:comment "A key tweak is why a public child can be derived from a parent public key alone. Basis: the chapter says of Key tweak: 'so that the child public key can be computed by someone who does not know the private key'; the chapter says of Public child key derivation: 'adding a value to a public key gives the public key of the sum'."@en ;
    rdfs:domain chx:KeyTweak ; rdfs:range chx:PublicChildDerivation ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:copiesWalletDatabase a owl:ObjectProperty ; rdfs:label "copies"@en ;
    rdfs:comment "An encrypted wallet backup is a complete copy of the wallet database. Basis: the chapter says of Encrypted wallet backup: 'a complete copy of the wallet database'."@en ;
    rdfs:domain chx:EncryptedWalletBackup ; rdfs:range chx:WalletDatabase ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:isEncryptedUnderSeedKey a owl:ObjectProperty ; rdfs:label "is encrypted under a key derived from"@en ;
    rdfs:comment "An encrypted wallet backup is encrypted under a key derived from the seed. Basis: the chapter says of Encrypted wallet backup: 'encrypted under a key derived from the seed'."@en ;
    rdfs:domain chx:EncryptedWalletBackup ; rdfs:range chx:Seed ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:testsRecoveryCode a owl:ObjectProperty ; rdfs:label "tests"@en ;
    rdfs:comment "Testing a backup tests whether a code is sufficient. Basis: the chapter says of Testing a backup: 'learn that a code, a path and the non-key data are all sufficient'."@en ;
    rdfs:domain chx:BackupTesting ; rdfs:range chx:RecoveryCodes ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:testsPathBackup a owl:ObjectProperty ; rdfs:label "tests"@en ;
    rdfs:comment "Testing a backup tests whether a path is sufficient. Basis: the chapter says of Testing a backup: 'learn that a code, a path and the non-key data are all sufficient'."@en ;
    rdfs:domain chx:BackupTesting ; rdfs:range chx:PathBackup ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:testsNonkeyBackup a owl:ObjectProperty ; rdfs:label "tests"@en ;
    rdfs:comment "Testing a backup tests whether the non-key data is sufficient. Basis: the chapter says of Testing a backup: 'learn that a code, a path and the non-key data are all sufficient'."@en ;
    rdfs:domain chx:BackupTesting ; rdfs:range chx:NonkeyBackup ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:usesHardwareSigningDevice a owl:ObjectProperty ; rdfs:label "can use"@en ;
    rdfs:comment "In external signing a hardware signing device holds the private keys. Basis: the chapter says of External signing: 'a hardware signing device or the other signers of a multisignature scheme'."@en ;
    rdfs:domain chx:ExternalSigning ; rdfs:range chx:HardwareSigningDevice ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:writesDownRecoveryCode a owl:ObjectProperty ; rdfs:label "writes down"@en ;
    rdfs:comment "A written backup is the recovery code on paper. Basis: the chapter says of Written backup: 'the recovery code on paper'."@en ;
    rdfs:domain chx:WrittenBackup ; rdfs:range chx:RecoveryCodes ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:deploysExtendedPublicKey a owl:ObjectProperty ; rdfs:label "deploys"@en ;
    rdfs:comment "Deploying an extended public key puts the watching half of a wallet on an exposed computer. Basis: the chapter says of Extended public key deployment: 'Deploying an extended public key means putting the watching half of a wallet on an exposed computer'."@en ;
    rdfs:domain chx:XpubDeployment ; rdfs:range chx:ExtendedPublicKey ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
chx:watchesWithExtendedPublicKey a owl:ObjectProperty ; rdfs:label "watches with"@en ;
    rdfs:comment "A self-hosted payment processor lets a merchant accept bitcoins with the extended public key. Basis: the chapter says of Payment processor: 'with the extended public key'."@en ;
    rdfs:domain chx:PaymentProcessor ; rdfs:range chx:ExtendedPublicKey ; rdfs:isDefinedBy <http://example.org/sen0401/ch05/tbox> .
