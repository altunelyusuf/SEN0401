<http://example.org/sen0401/ch05/abox> a owl:Ontology ;
    rdfs:label "SEN0401 chapter 5 domain ontology - ABox"@en ; owl:versionInfo "1.1.0" ; owl:versionIRI <http://example.org/sen0401/ch05/abox/1.1.0> ; rdfs:comment "1.1.0 keeps every concept of 1.0.0 and changes only text and worked examples, so it is MINOR. All eighteen second-level sections had three paragraphs and each closed on a list of its own children, which the page's breadcrumb row already prints; every one of those closing paragraphs is replaced by a paragraph on how the section's subject works, and all eighteen are brought to five paragraphs. Ten concepts that had no worked example are given one, each executed by the chapter builder: the wallet database, the key tweak, plausible deniability, memorising a code, the implicit and the explicit path, the address label, the digital signature, data loss and the testing of a backup. Nine are left without one on purpose, because what they state is a physical or institutional arrangement rather than a computation, and an expression there would restate the definition instead of teaching anything."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:created "2026-10-04"^^xsd:date ; dcterms:modified "2026-10-05"^^xsd:date ;
    dcterms:identifier "sen0401_ch05_abox_v1_1_0" ; prov:wasRevisionOf <http://example.org/sen0401/ch05/abox/1.0.0> ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/ch05-rdodi-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

chx:X_WalletDatabase a owl:NamedIndividual, chx:WalletDatabase ; rdfs:label "a file of keys, not coins"@en ; skos:definition "The wallet database is the stored collection of keys (and the notes about them) that a wallet application reads and writes; it holds the means to prove control of bitcoins, not the bitcoins themselves."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_WalletDatabase a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda keys, size: (keys * size, round(keys * size / 1024, 1)))(1000, 32) evaluates to (32000, 31.2)"@en ; chx:input "(lambda keys, size: (keys * size, round(keys * size / 1024, 1)))(1000, 32)" ; chx:output "(32000, 31.2)" .
chx:X_WalletDatabase rd:hasIOExample chx:IO_WalletDatabase .
chx:X_PublicKeyOnlyWallet a owl:NamedIndividual, chx:PublicKeyOnlyWallet ; rdfs:label "receiving without the power to spend"@en ; skos:definition "A wallet database that holds public keys but not the private keys can recognise payments and create receiving addresses but cannot sign a spending transaction."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:X_ExternalSigning a owl:NamedIndividual, chx:ExternalSigning ; rdfs:label "the application builds, the device signs"@en ; skos:definition "In external signing the wallet application builds a transaction and another party, a hardware signing device or the other signers of a multisignature scheme, holds the private keys and returns the signature."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:X_IndependentKeyGeneration a owl:NamedIndividual, chx:IndependentKeyGeneration ; rdfs:label "1,000 keys, 32,000 bytes to back up"@en ; skos:definition "In independent key generation every key is created separately from random data, so every key has to be saved on its own and the backup is out of date after each new key."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_IndependentKeyGeneration a owl:NamedIndividual, rd:IOExample ; rdfs:label "32 * 1000 evaluates to 32000"@en ; chx:input "32 * 1000" ; chx:output "32000" .
chx:X_IndependentKeyGeneration rd:hasIOExample chx:IO_IndependentKeyGeneration .
chx:X_Seed a owl:NamedIndividual, chx:Seed ; rdfs:label "a 256-bit random value"@en ; skos:definition "A seed is the random value from which a deterministic wallet derives all its keys; the same seed, with the same algorithm, always gives the same keys."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Seed a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(bytes.fromhex('f1cc3bc03ef51cb43ee7844460fa5049e779e7425a6349c8e89dfbb0fd97bb73')) * 8 evaluates to 256"@en ; chx:input "len(bytes.fromhex('f1cc3bc03ef51cb43ee7844460fa5049e779e7425a6349c8e89dfbb0fd97bb73')) * 8" ; chx:output "256" .
chx:X_Seed rd:hasIOExample chx:IO_Seed .
chx:X_DeterministicKeyGeneration a owl:NamedIndividual, chx:DeterministicKeyGeneration ; rdfs:label "sha256 of seed plus 0, 1, 2"@en ; skos:definition "Deterministic key generation computes keys from a seed by a fixed rule, such as hashing the seed with a counter, so the same seed always yields the same keys."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_DeterministicKeyGeneration a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hashlib').sha256(('f1cc3bc03ef51cb43ee7844460fa5049e779e7425a6349c8e89dfbb0fd97bb73 + 0' + chr(10)).encode()).hexdigest() evaluates to '50b18e0bd9508310b8f699bad425efdf67d668cb2462b909fdb6b9bd2437beb3'"@en ; chx:input "__import__('hashlib').sha256(('f1cc3bc03ef51cb43ee7844460fa5049e779e7425a6349c8e89dfbb0fd97bb73 + 0' + chr(10)).encode()).hexdigest()" ; chx:output "'50b18e0bd9508310b8f699bad425efdf67d668cb2462b909fdb6b9bd2437beb3'" .
chx:X_DeterministicKeyGeneration rd:hasIOExample chx:IO_DeterministicKeyGeneration .
chx:X_KeyTweak a owl:NamedIndividual, chx:KeyTweak ; rdfs:label "K plus 123 times G"@en ; skos:definition "A key tweak is a value added to a public key, and in the same way to its private key, so that the child public key can be computed by someone who does not know the private key."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_KeyTweak a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda p, g, a, t: (((a + t) % p) * g % p, (a * g % p + t * g % p) % p))(17, 5, 9, 3) evaluates to (9, 9)"@en ; chx:input "(lambda p, g, a, t: (((a + t) % p) * g % p, (a * g % p + t * g % p) % p))(17, 5, 9, 3)" ; chx:output "(9, 9)" .
chx:X_KeyTweak rd:hasIOExample chx:IO_KeyTweak .
chx:X_HdKeyGeneration a owl:NamedIndividual, chx:HdKeyGeneration ; rdfs:label "a tree of keys under one seed"@en ; skos:definition "Hierarchical deterministic (HD) key generation, the standard BIP32, derives a tree of keys from one seed; any key can be the parent of further keys, and public keys can be derived without private keys."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_HdKeyGeneration a owl:NamedIndividual, rd:IOExample ; rdfs:label "2**31 + 2**31 evaluates to 4294967296"@en ; chx:input "2**31 + 2**31" ; chx:output "4294967296" .
chx:X_HdKeyGeneration rd:hasIOExample chx:IO_HdKeyGeneration .
chx:X_Bip39Code a owl:NamedIndividual, chx:Bip39Code ; rdfs:label "12 words for 128 bits of entropy"@en ; skos:definition "A BIP39 recovery code is a sequence of 12 to 24 words that encodes a random number together with a short checksum, from which a 512-bit seed is derived; the standard was published in 2013 and is the most widely used scheme."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Bip39Code a owl:NamedIndividual, rd:IOExample ; rdfs:label "(128 + 128 // 32) // 11 evaluates to 12"@en ; chx:input "(128 + 128 // 32) // 11" ; chx:output "12" .
chx:X_Bip39Code rd:hasIOExample chx:IO_Bip39Code .
chx:X_ElectrumV2Code a owl:NamedIndividual, chx:ElectrumV2Code ; rdfs:label "132 bits of entropy in 12 words"@en ; skos:definition "The Electrum version 2 scheme derives both the master private key and a version number from a hash of the normalised phrase, so it needs no fixed word list and can tell an old code from a new one."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_ElectrumV2Code a owl:NamedIndividual, rd:IOExample ; rdfs:label "132 // 11 evaluates to 12"@en ; chx:input "132 // 11" ; chx:output "12" .
chx:X_ElectrumV2Code rd:hasIOExample chx:IO_ElectrumV2Code .
chx:X_AezeedCode a owl:NamedIndividual, chx:AezeedCode ; rdfs:label "19 plaintext bytes before enciphering"@en ; skos:definition "The Aezeed scheme of the lnd wallet enciphers a plaintext of version, timestamp and entropy into a 24-word code, so the passphrase is authenticated and the code can be upgraded or re-enciphered."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_AezeedCode a owl:NamedIndividual, rd:IOExample ; rdfs:label "1 + 2 + 16 evaluates to 19"@en ; chx:input "1 + 2 + 16" ; chx:output "19" .
chx:X_AezeedCode rd:hasIOExample chx:IO_AezeedCode .
chx:X_MuunCode a owl:NamedIndividual, chx:MuunCode ; rdfs:label "a code that decrypts a printed kit"@en ; skos:definition "The Muun recovery code is not words and is not the seed: it is a key that decrypts the private keys held in a document the wallet gives the user, which suits a wallet whose spending needs several signatures."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:X_Slip39Code a owl:NamedIndividual, chx:Slip39Code ; rdfs:label "20 words for a 128-bit master secret"@en ; skos:definition "SLIP39 splits one seed into several word codes with a threshold, so that any sufficient subset recovers the seed and any smaller subset reveals nothing about it."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Slip39Code a owl:NamedIndividual, rd:IOExample ; rdfs:label "200 // 10 evaluates to 20"@en ; chx:input "200 // 10" ; chx:output "20" .
chx:X_Slip39Code rd:hasIOExample chx:IO_Slip39Code .
chx:X_Codex32Code a owl:NamedIndividual, chx:Codex32Code ; rdfs:label "48 characters in the standard's own example"@en ; skos:definition "codex32 writes a BIP32 master seed in the bech32 alphabet with an error-correcting checksum that can be verified by hand, and can split the seed into up to 31 shares with a threshold between 2 and 9."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Codex32Code a owl:NamedIndividual, rd:IOExample ; rdfs:label "len('ms10testsxxxxxxxxxxxxxxxxxxxxxxxxxx4nzvca9cmczlw') evaluates to 48"@en ; chx:input "len('ms10testsxxxxxxxxxxxxxxxxxxxxxxxxxx4nzvca9cmczlw')" ; chx:output "48" .
chx:X_Codex32Code rd:hasIOExample chx:IO_Codex32Code .
chx:X_RecoveryPassphrase a owl:NamedIndividual, chx:RecoveryPassphrase ; rdfs:label "a different seed for every passphrase"@en ; skos:definition "A passphrase is an extra secret that is mixed into the derivation of the seed, so that one recovery code yields a different wallet for every passphrase and the code alone is not enough to spend."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_RecoveryPassphrase a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib, hmac\\ndef seed(words, salt, rounds=2048):\\n    u = hmac.new(words, salt + b'\\\\x00\\\\x00\\\\x00\\\\x01', hashlib.sha512).digest()\\n    out = bytearray(u)\\n    for _ in range(rounds - 1):\\n        u = hmac.new(words, u, hashlib.sha512).digest()\\n        out = bytearray(a ^ b for a, b in zip(out, u))\\n    return bytes(out)\\nresult = seed(b'army van defense carry jealous true garbage claim echo media make crunch', b'mnemonic' + b'typo').hex()[:16]\", g), g['result'])[1])({}) evaluates to '7cb305fd619db8de'"@en ; chx:input "(lambda g: (exec(\"import hashlib, hmac\\ndef seed(words, salt, rounds=2048):\\n    u = hmac.new(words, salt + b'\\\\x00\\\\x00\\\\x00\\\\x01', hashlib.sha512).digest()\\n    out = bytearray(u)\\n    for _ in range(rounds - 1):\\n        u = hmac.new(words, u, hashlib.sha512).digest()\\n        out = bytearray(a ^ b for a, b in zip(out, u))\\n    return bytes(out)\\nresult = seed(b'army van defense carry jealous true garbage claim echo media make crunch', b'mnemonic' + b'typo').hex()[:16]\", g), g['result'])[1])({})" ; chx:output "'7cb305fd619db8de'" .
chx:X_RecoveryPassphrase rd:hasIOExample chx:IO_RecoveryPassphrase .
chx:X_PlausibleDeniability a owl:NamedIndividual, chx:PlausibleDeniability ; rdfs:label "a valid tree under every passphrase"@en ; skos:definition "Plausible deniability is the property that a revealed recovery code or passphrase always looks valid, so a holder cannot be shown to have withheld anything - which protects and endangers them at the same time."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_PlausibleDeniability a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda passphrases: (len(passphrases), len(passphrases) + 1))(['holiday', 'decoy']) evaluates to (2, 3)"@en ; chx:input "(lambda passphrases: (len(passphrases), len(passphrases) + 1))(['holiday', 'decoy'])" ; chx:output "(2, 3)" .
chx:X_PlausibleDeniability rd:hasIOExample chx:IO_PlausibleDeniability .
chx:X_Brainwallet a owl:NamedIndividual, chx:Brainwallet ; rdfs:label "132 bits in twelve random words"@en ; skos:definition "A brainwallet is a wallet whose keys come from a phrase the user chose, which is insecure because people are poor sources of randomness; a recovery code is generated by the wallet instead."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Brainwallet a owl:NamedIndividual, rd:IOExample ; rdfs:label "(2048 ** 12).bit_length() - 1 evaluates to 132"@en ; chx:input "(2048 ** 12).bit_length() - 1" ; chx:output "132" .
chx:X_Brainwallet rd:hasIOExample chx:IO_Brainwallet .
chx:X_Memorization a owl:NamedIndividual, chx:Memorization ; rdfs:label "words instead of hexadecimal"@en ; skos:definition "Memorising a code is possible because the code is words, and is dangerous because memory fails, cannot be inherited and can be coerced; the chapter recommends writing the code down as well."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Memorization a owl:NamedIndividual, rd:IOExample ; rdfs:label "(12 * 11, 24 * 11) evaluates to (132, 264)"@en ; chx:input "(12 * 11, 24 * 11)" ; chx:output "(132, 264)" .
chx:X_Memorization rd:hasIOExample chx:IO_Memorization .
chx:X_PhysicalCoercion a owl:NamedIndividual, chx:PhysicalCoercion ; rdfs:label "a published record of attacks"@en ; skos:definition "Because a recovery code is all that is needed to spend, people who are believed to hold one have been attacked in person; the chapter cites a public list of such cases and the list has grown since."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:X_WalletBirthday a owl:NamedIndividual, chx:WalletBirthday ; rdfs:label "a date in two bytes"@en ; skos:definition "A wallet birthday is the creation date recorded inside a recovery code, so that a restoration can scan the blockchain from that date instead of from the beginning."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_WalletBirthday a owl:NamedIndividual, rd:IOExample ; rdfs:label "2009 + 2 ** 16 // 365 evaluates to 2188"@en ; chx:input "2009 + 2 ** 16 // 365" ; chx:output "2188" .
chx:X_WalletBirthday rd:hasIOExample chx:IO_WalletBirthday .
chx:X_Entropy a owl:NamedIndividual, chx:Entropy ; rdfs:label "128 random bits in sixteen bytes"@en ; skos:definition "Entropy is the unpredictability of a value, measured in bits; a BIP39 code encodes 128 to 256 bits of it, drawn by the wallet from a source of randomness and not chosen by a person."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Entropy a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(bytes.fromhex('0c1e24e5917779d297e14d45f14e1a1a')) * 8 evaluates to 128"@en ; chx:input "len(bytes.fromhex('0c1e24e5917779d297e14d45f14e1a1a')) * 8" ; chx:output "128" .
chx:X_Entropy rd:hasIOExample chx:IO_Entropy .
chx:X_Bip39Checksum a owl:NamedIndividual, chx:Bip39Checksum ; rdfs:label "the first four bits of a SHA-256 hash"@en ; skos:definition "The BIP39 checksum is the first entropy-length over 32 bits of the SHA-256 hash of the entropy, appended to it, so that a mistyped code can be detected but not corrected."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Bip39Checksum a owl:NamedIndividual, rd:IOExample ; rdfs:label "bin(__import__('hashlib').sha256(bytes.fromhex('0c1e24e5917779d297e14d45f14e1a1a')).digest()[0])[2:].zfill(8)[:4] evaluates to '0111'"@en ; chx:input "bin(__import__('hashlib').sha256(bytes.fromhex('0c1e24e5917779d297e14d45f14e1a1a')).digest()[0])[2:].zfill(8)[:4]" ; chx:output "'0111'" .
chx:X_Bip39Checksum rd:hasIOExample chx:IO_Bip39Checksum .
chx:X_WordList a owl:NamedIndividual, chx:WordList ; rdfs:label "2,048 words, eleven bits each"@en ; skos:definition "The BIP39 word list holds exactly 2,048 words, so that each word stands for 11 bits; the list is sorted, has unique four-letter prefixes and avoids similar pairs."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_WordList a owl:NamedIndividual, rd:IOExample ; rdfs:label "2 ** 11 evaluates to 2048"@en ; chx:input "2 ** 11" ; chx:output "2048" .
chx:X_WordList rd:hasIOExample chx:IO_WordList .
chx:X_BitSegment a owl:NamedIndividual, chx:BitSegment ; rdfs:label "the first three segments of the book's code"@en ; skos:definition "The entropy and checksum are read as consecutive groups of 11 bits, each group a number from 0 to 2,047 that selects one word of the list."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_BitSegment a owl:NamedIndividual, rd:IOExample ; rdfs:label "[int(bin(int.from_bytes(bytes.fromhex('0c1e24e5917779d297e14d45f14e1a1a'), 'big'))[2:].zfill(128)[i:i + 11], 2) for i in range(0, 33, 11)] evaluates to [96, 1929, 459]"@en ; chx:input "[int(bin(int.from_bytes(bytes.fromhex('0c1e24e5917779d297e14d45f14e1a1a'), 'big'))[2:].zfill(128)[i:i + 11], 2) for i in range(0, 33, 11)]" ; chx:output "[96, 1929, 459]" .
chx:X_BitSegment rd:hasIOExample chx:IO_BitSegment .
chx:X_CodeLength a owl:NamedIndividual, chx:CodeLength ; rdfs:label "the chapter's entropy and word-length table"@en ; skos:definition "Entropy length, checksum length and word count are tied together: the checksum is a thirty-second of the entropy and the total divided by 11 is the number of words, so codes have 12, 15, 18, 21 or 24 words."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_CodeLength a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(e, e // 32, (e + e // 32) // 11) for e in (128, 160, 192, 224, 256)] evaluates to [(128, 4, 12), (160, 5, 15), (192, 6, 18), (224, 7, 21), (256, 8, 24)]"@en ; chx:input "[(e, e // 32, (e + e // 32) // 11) for e in (128, 160, 192, 224, 256)]" ; chx:output "[(128, 4, 12), (160, 5, 15), (192, 6, 18), (224, 7, 21), (256, 8, 24)]" .
chx:X_CodeLength rd:hasIOExample chx:IO_CodeLength .
chx:X_TextNormalization a owl:NamedIndividual, chx:TextNormalization ; rdfs:label "one character, two code points"@en ; skos:definition "Normalisation rewrites text in a single canonical form before it is hashed, so that two spellings a person cannot distinguish produce the same bytes and therefore the same seed."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_TextNormalization a owl:NamedIndividual, rd:IOExample ; rdfs:label "(len('\\u00e9'), len(__import__('unicodedata').normalize('NFKD', '\\u00e9'))) evaluates to (1, 2)"@en ; chx:input "(len('\\u00e9'), len(__import__('unicodedata').normalize('NFKD', '\\u00e9')))" ; chx:output "(1, 2)" .
chx:X_TextNormalization rd:hasIOExample chx:IO_TextNormalization .
chx:X_KeyStretchingFunction a owl:NamedIndividual, chx:KeyStretchingFunction ; rdfs:label "2,048 rounds against 32,768"@en ; skos:definition "A key-stretching function derives a key from a secret deliberately slowly, by repeating a hash many times, so that each guess an attacker makes costs more."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_KeyStretchingFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "32768 // 2048 evaluates to 16"@en ; chx:input "32768 // 2048" ; chx:output "16" .
chx:X_KeyStretchingFunction rd:hasIOExample chx:IO_KeyStretchingFunction .
chx:X_Pbkdf2 a owl:NamedIndividual, chx:Pbkdf2 ; rdfs:label "the book's first seed, recomputed"@en ; skos:definition "PBKDF2 is the standard password-based key derivation function that BIP39 uses: it applies HMAC-SHA512 2,048 times to the words and the salt and returns 64 bytes."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Pbkdf2 a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib, hmac\\ndef seed(words, salt, rounds=2048):\\n    u = hmac.new(words, salt + b'\\\\x00\\\\x00\\\\x00\\\\x01', hashlib.sha512).digest()\\n    out = bytearray(u)\\n    for _ in range(rounds - 1):\\n        u = hmac.new(words, u, hashlib.sha512).digest()\\n        out = bytearray(a ^ b for a, b in zip(out, u))\\n    return bytes(out)\\nresult = seed(b'army van defense carry jealous true garbage claim echo media make crunch', b'mnemonic').hex()[:16]\", g), g['result'])[1])({}) evaluates to '5b56c417303faa3f'"@en ; chx:input "(lambda g: (exec(\"import hashlib, hmac\\ndef seed(words, salt, rounds=2048):\\n    u = hmac.new(words, salt + b'\\\\x00\\\\x00\\\\x00\\\\x01', hashlib.sha512).digest()\\n    out = bytearray(u)\\n    for _ in range(rounds - 1):\\n        u = hmac.new(words, u, hashlib.sha512).digest()\\n        out = bytearray(a ^ b for a, b in zip(out, u))\\n    return bytes(out)\\nresult = seed(b'army van defense carry jealous true garbage claim echo media make crunch', b'mnemonic').hex()[:16]\", g), g['result'])[1])({})" ; chx:output "'5b56c417303faa3f'" .
chx:X_Pbkdf2 rd:hasIOExample chx:IO_Pbkdf2 .
chx:X_Salt a owl:NamedIndividual, chx:Salt ; rdfs:label "the constant mnemonic, with or without a passphrase"@en ; skos:definition "A salt is the second, non-secret input of a key derivation function; BIP39's salt is the string mnemonic followed by the optional passphrase, which is how the passphrase changes the seed."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Salt a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib, hmac\\ndef seed(words, salt, rounds=2048):\\n    u = hmac.new(words, salt + b'\\\\x00\\\\x00\\\\x00\\\\x01', hashlib.sha512).digest()\\n    out = bytearray(u)\\n    for _ in range(rounds - 1):\\n        u = hmac.new(words, u, hashlib.sha512).digest()\\n        out = bytearray(a ^ b for a, b in zip(out, u))\\n    return bytes(out)\\nresult = seed(b'x', b'mnemonic') == seed(b'x', b'mnemonicSuperDuperSecret')\", g), g['result'])[1])({}) evaluates to False"@en ; chx:input "(lambda g: (exec(\"import hashlib, hmac\\ndef seed(words, salt, rounds=2048):\\n    u = hmac.new(words, salt + b'\\\\x00\\\\x00\\\\x00\\\\x01', hashlib.sha512).digest()\\n    out = bytearray(u)\\n    for _ in range(rounds - 1):\\n        u = hmac.new(words, u, hashlib.sha512).digest()\\n        out = bytearray(a ^ b for a, b in zip(out, u))\\n    return bytes(out)\\nresult = seed(b'x', b'mnemonic') == seed(b'x', b'mnemonicSuperDuperSecret')\", g), g['result'])[1])({})" ; chx:output "False" .
chx:X_Salt rd:hasIOExample chx:IO_Salt .
chx:X_RootSeed a owl:NamedIndividual, chx:RootSeed ; rdfs:label "512 bits, that is 64 bytes"@en ; skos:definition "The root seed is the value from which every key of a hierarchical deterministic wallet is derived; BIP39 produces one of 512 bits, and BIP32 accepts 128 to 512."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_RootSeed a owl:NamedIndividual, rd:IOExample ; rdfs:label "512 // 8 evaluates to 64"@en ; chx:input "512 // 8" ; chx:output "64" .
chx:X_RootSeed rd:hasIOExample chx:IO_RootSeed .
chx:X_Bip39Passphrase a owl:NamedIndividual, chx:Bip39Passphrase ; rdfs:label "the book's second seed, recomputed"@en ; skos:definition "In BIP39 the optional passphrase is appended to the constant salt, so any passphrase yields a different valid seed from the same words and none of them is wrong."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Bip39Passphrase a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib, hmac\\ndef seed(words, salt, rounds=2048):\\n    u = hmac.new(words, salt + b'\\\\x00\\\\x00\\\\x00\\\\x01', hashlib.sha512).digest()\\n    out = bytearray(u)\\n    for _ in range(rounds - 1):\\n        u = hmac.new(words, u, hashlib.sha512).digest()\\n        out = bytearray(a ^ b for a, b in zip(out, u))\\n    return bytes(out)\\nresult = seed(b'army van defense carry jealous true garbage claim echo media make crunch', b'mnemonicSuperDuperSecret').hex()[:16]\", g), g['result'])[1])({}) evaluates to '3b5df16df2157104'"@en ; chx:input "(lambda g: (exec(\"import hashlib, hmac\\ndef seed(words, salt, rounds=2048):\\n    u = hmac.new(words, salt + b'\\\\x00\\\\x00\\\\x00\\\\x01', hashlib.sha512).digest()\\n    out = bytearray(u)\\n    for _ in range(rounds - 1):\\n        u = hmac.new(words, u, hashlib.sha512).digest()\\n        out = bytearray(a ^ b for a, b in zip(out, u))\\n    return bytes(out)\\nresult = seed(b'army van defense carry jealous true garbage claim echo media make crunch', b'mnemonicSuperDuperSecret').hex()[:16]\", g), g['result'])[1])({})" ; chx:output "'3b5df16df2157104'" .
chx:X_Bip39Passphrase rd:hasIOExample chx:IO_Bip39Passphrase .
chx:X_SecurityStrength a owl:NamedIndividual, chx:SecurityStrength ; rdfs:label "512, 256 and 128 bits"@en ; skos:definition "Security strength is the work an attacker needs, measured in bits; extended keys hold 512 bits, private keys 256, and the elliptic curve offers about 128, so more than 128 bits of entropy buys little."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_SecurityStrength a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(2 ** 512).bit_length() - 1, (2 ** 256).bit_length() - 1, (2 ** 128).bit_length() - 1] evaluates to [512, 256, 128]"@en ; chx:input "[(2 ** 512).bit_length() - 1, (2 ** 256).bit_length() - 1, (2 ** 128).bit_length() - 1]" ; chx:output "[512, 256, 128]" .
chx:X_SecurityStrength rd:hasIOExample chx:IO_SecurityStrength .
chx:X_HmacSha512 a owl:NamedIndividual, chx:HmacSha512 ; rdfs:label "the keyed hash of the test vector's seed"@en ; skos:definition "HMAC-SHA512 is a keyed hash: it combines a key and a message into 64 bytes that cannot be produced without the key, and BIP32 uses it both to make the master keys and to derive every child."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_HmacSha512 a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hmac').new(b'Bitcoin seed', bytes.fromhex('000102030405060708090a0b0c0d0e0f'), __import__('hashlib').sha512).hexdigest()[:16] evaluates to 'e8f32e723decf405'"@en ; chx:input "__import__('hmac').new(b'Bitcoin seed', bytes.fromhex('000102030405060708090a0b0c0d0e0f'), __import__('hashlib').sha512).hexdigest()[:16]" ; chx:output "'e8f32e723decf405'" .
chx:X_HmacSha512 rd:hasIOExample chx:IO_HmacSha512 .
chx:X_MasterPrivateKey a owl:NamedIndividual, chx:MasterPrivateKey ; rdfs:label "the left half of the hash, as a number"@en ; skos:definition "The master private key is the left 32 bytes of HMAC-SHA512 over the seed, read as a 256-bit number; it is the root of the tree and is written m."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_MasterPrivateKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hmac').new(b'Bitcoin seed', bytes.fromhex('000102030405060708090a0b0c0d0e0f'), __import__('hashlib').sha512).hexdigest()[:64] evaluates to 'e8f32e723decf4051aefac8e2c93c9c5b214313817cdb01a1494b917c8436b35'"@en ; chx:input "__import__('hmac').new(b'Bitcoin seed', bytes.fromhex('000102030405060708090a0b0c0d0e0f'), __import__('hashlib').sha512).hexdigest()[:64]" ; chx:output "'e8f32e723decf4051aefac8e2c93c9c5b214313817cdb01a1494b917c8436b35'" .
chx:X_MasterPrivateKey rd:hasIOExample chx:IO_MasterPrivateKey .
chx:X_MasterChainCode a owl:NamedIndividual, chx:MasterChainCode ; rdfs:label "the right half of the hash"@en ; skos:definition "The master chain code is the right 32 bytes of HMAC-SHA512 over the seed: 256 bits of extra entropy that make every derivation depend on more than the key."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_MasterChainCode a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hmac').new(b'Bitcoin seed', bytes.fromhex('000102030405060708090a0b0c0d0e0f'), __import__('hashlib').sha512).hexdigest()[64:] evaluates to '873dff81c02f525623fd1fe5167eac3a55a049de3d314bb42ee227ffed37d508'"@en ; chx:input "__import__('hmac').new(b'Bitcoin seed', bytes.fromhex('000102030405060708090a0b0c0d0e0f'), __import__('hashlib').sha512).hexdigest()[64:]" ; chx:output "'873dff81c02f525623fd1fe5167eac3a55a049de3d314bb42ee227ffed37d508'" .
chx:X_MasterChainCode rd:hasIOExample chx:IO_MasterChainCode .
chx:X_ChildKeyDerivation a owl:NamedIndividual, chx:ChildKeyDerivation ; rdfs:label "512 bits split into two halves of 32 bytes"@en ; skos:definition "A child is derived by hashing the parent key, the parent chain code and an index with HMAC-SHA512 and splitting the 512-bit result: the left half makes the child key, the right half is the child chain code."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_ChildKeyDerivation a owl:NamedIndividual, rd:IOExample ; rdfs:label "(512 // 2, 512 // 2 // 8) evaluates to (256, 32)"@en ; chx:input "(512 // 2, 512 // 2 // 8)" ; chx:output "(256, 32)" .
chx:X_ChildKeyDerivation rd:hasIOExample chx:IO_ChildKeyDerivation .
chx:X_ChainCode a owl:NamedIndividual, chx:ChainCode ; rdfs:label "256 bits beside every key"@en ; skos:definition "A chain code is the 32 bytes of extra entropy carried beside a key so that derivation depends on more than the key; a key's children cannot be found without it."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_ChainCode a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(bytes.fromhex('873dff81c02f525623fd1fe5167eac3a55a049de3d314bb42ee227ffed37d508')) * 8 evaluates to 256"@en ; chx:input "len(bytes.fromhex('873dff81c02f525623fd1fe5167eac3a55a049de3d314bb42ee227ffed37d508')) * 8" ; chx:output "256" .
chx:X_ChainCode rd:hasIOExample chx:IO_ChainCode .
chx:X_IndexNumber a owl:NamedIndividual, chx:IndexNumber ; rdfs:label "two ranges in 32 bits"@en ; skos:definition "The index is the 32-bit number that selects which child is derived; indices below 2 to the 31 are normal children and those at or above it are hardened, displayed with an apostrophe or an h."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_IndexNumber a owl:NamedIndividual, rd:IOExample ; rdfs:label "(2 ** 31 - 1, 2 ** 31, 2 ** 32 - 1) evaluates to (2147483647, 2147483648, 4294967295)"@en ; chx:input "(2 ** 31 - 1, 2 ** 31, 2 ** 32 - 1)" ; chx:output "(2147483647, 2147483648, 4294967295)" .
chx:X_IndexNumber rd:hasIOExample chx:IO_IndexNumber .
chx:X_PrivateChildDerivation a owl:NamedIndividual, chx:PrivateChildDerivation ; rdfs:label "the left half added to the parent key"@en ; skos:definition "A private child is the sum, modulo the order of the curve, of the parent private key and the left half of the derivation hash; the right half is the child's chain code."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_PrivateChildDerivation a owl:NamedIndividual, rd:IOExample ; rdfs:label "hex((int('4eb9d78157bae7a24115001621c4d91e3a3110e11e143c5259eaa4e55c5ec4bf', 16) + int('edb2e14f9ee77d26dd93b4ecede8d16ed408ce149b6cd80b0715a2d911a0afea', 16)) % 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141)[:18] evaluates to '0x3c6cb8d0f6a264c9'"@en ; chx:input "hex((int('4eb9d78157bae7a24115001621c4d91e3a3110e11e143c5259eaa4e55c5ec4bf', 16) + int('edb2e14f9ee77d26dd93b4ecede8d16ed408ce149b6cd80b0715a2d911a0afea', 16)) % 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141)[:18]" ; chx:output "'0x3c6cb8d0f6a264c9'" .
chx:X_PrivateChildDerivation rd:hasIOExample chx:IO_PrivateChildDerivation .
chx:X_HardenedDerivation a owl:NamedIndividual, chx:HardenedDerivation ; rdfs:label "the first hardened child of a test vector's master key"@en ; skos:definition "Hardened derivation feeds the parent private key, not the parent public key, into the hash, so the resulting chain code cannot be used with a leaked child key to recover the parent."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_HardenedDerivation a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib, hmac\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nI = hmac.new(b'Bitcoin seed', bytes.fromhex('000102030405060708090a0b0c0d0e0f'), hashlib.sha512).digest()\\nk, c = int.from_bytes(I[:32], 'big'), I[32:]\\nJ = hmac.new(c, b'\\\\x00' + k.to_bytes(32, 'big') + (2 ** 31).to_bytes(4, 'big'), hashlib.sha512).digest()\\nresult = hex((int.from_bytes(J[:32], 'big') + k) % N)[:18]\", g), g['result'])[1])({}) evaluates to '0xedb2e14f9ee77d26'"@en ; chx:input "(lambda g: (exec(\"import hashlib, hmac\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nI = hmac.new(b'Bitcoin seed', bytes.fromhex('000102030405060708090a0b0c0d0e0f'), hashlib.sha512).digest()\\nk, c = int.from_bytes(I[:32], 'big'), I[32:]\\nJ = hmac.new(c, b'\\\\x00' + k.to_bytes(32, 'big') + (2 ** 31).to_bytes(4, 'big'), hashlib.sha512).digest()\\nresult = hex((int.from_bytes(J[:32], 'big') + k) % N)[:18]\", g), g['result'])[1])({})" ; chx:output "'0xedb2e14f9ee77d26'" .
chx:X_HardenedDerivation rd:hasIOExample chx:IO_HardenedDerivation .
chx:X_PublicChildDerivation a owl:NamedIndividual, chx:PublicChildDerivation ; rdfs:label "the tweak added on a small curve"@en ; skos:definition "A public child can be derived from a parent public key and chain code alone, because adding a value to a public key gives the public key of the sum, so a server can make addresses without the power to spend."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_PublicChildDerivation a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('p = 97\\ndef add(P, Q):\\n    if P is None: return Q\\n    if Q is None: return P\\n    if P[0] == Q[0] and (P[1] + Q[1]) % p == 0: return None\\n    m = (3 * P[0] * P[0] * pow(2 * P[1], -1, p) if P == Q else (Q[1] - P[1]) * pow(Q[0] - P[0], -1, p)) % p\\n    x = (m * m - P[0] - Q[0]) % p\\n    return (x, (m * (P[0] - x) - P[1]) % p)\\ndef mul(n, P):\\n    R = None\\n    while n:\\n        if n & 1: R = add(R, P)\\n        P = add(P, P); n >>= 1\\n    return R\\nG = (1, 28)\\nk, t = 7, 13\\nresult = (add(mul(t, G), mul(k, G)) == mul(k + t, G), mul(k, G))', g), g['result'])[1])({}) evaluates to (True, (12, 38))"@en ; chx:input "(lambda g: (exec('p = 97\\ndef add(P, Q):\\n    if P is None: return Q\\n    if Q is None: return P\\n    if P[0] == Q[0] and (P[1] + Q[1]) % p == 0: return None\\n    m = (3 * P[0] * P[0] * pow(2 * P[1], -1, p) if P == Q else (Q[1] - P[1]) * pow(Q[0] - P[0], -1, p)) % p\\n    x = (m * m - P[0] - Q[0]) % p\\n    return (x, (m * (P[0] - x) - P[1]) % p)\\ndef mul(n, P):\\n    R = None\\n    while n:\\n        if n & 1: R = add(R, P)\\n        P = add(P, P); n >>= 1\\n    return R\\nG = (1, 28)\\nk, t = 7, 13\\nresult = (add(mul(t, G), mul(k, G)) == mul(k + t, G), mul(k, G))', g), g['result'])[1])({})" ; chx:output "(True, (12, 38))" .
chx:X_PublicChildDerivation rd:hasIOExample chx:IO_PublicChildDerivation .
chx:X_ChildKeyIndependence a owl:NamedIndividual, chx:ChildKeyIndependence ; rdfs:label "2,147,483,647 siblings it cannot reach"@en ; skos:definition "A child key on its own behaves exactly like a randomly generated key: it can make a public key, an address and signatures, but it cannot find its parent, its siblings or its own children."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_ChildKeyIndependence a owl:NamedIndividual, rd:IOExample ; rdfs:label "2 ** 31 - 1 evaluates to 2147483647"@en ; chx:input "2 ** 31 - 1" ; chx:output "2147483647" .
chx:X_ChildKeyIndependence rd:hasIOExample chx:IO_ChildKeyIndependence .
chx:X_ExtendedKey a owl:NamedIndividual, chx:ExtendedKey ; rdfs:label "78 bytes before encoding"@en ; skos:definition "An extended key is a key together with its chain code, stored as the two concatenated; it is the root of a branch and is what a derivation function needs."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_ExtendedKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "4 + 1 + 4 + 4 + 32 + 33 evaluates to 78"@en ; chx:input "4 + 1 + 4 + 4 + 32 + 33" ; chx:output "78" .
chx:X_ExtendedKey rd:hasIOExample chx:IO_ExtendedKey .
chx:X_ExtendedPrivateKey a owl:NamedIndividual, chx:ExtendedPrivateKey ; rdfs:label "the book's xprv, decoded"@en ; skos:definition "An extended private key is a private key with its chain code; it can derive every descendant key, private and public, and is written with the prefix xprv."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_ExtendedPrivateKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nB58 = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'\\nt = 'xprv9tyUQV64JT5qs3RSTJkXCWKMyUgoQp7F3hA1xzG6ZGu6u6Q9VMNjGr67Lctvy5P8oyaYAL9CAWrUE9i6GoNMKUga5biW6Hx4tws2six3b9c'\\nn = 0\\nfor ch in t: n = n * 58 + B58.index(ch)\\nraw = n.to_bytes(82, 'big')\\nok = hashlib.sha256(hashlib.sha256(raw[:-4]).digest()).digest()[:4] == raw[-4:]\\nresult = (ok, raw[:4].hex(), raw[4], raw[45])\", g), g['result'])[1])({}) evaluates to (True, '0488ade4', 1, 0)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nB58 = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'\\nt = 'xprv9tyUQV64JT5qs3RSTJkXCWKMyUgoQp7F3hA1xzG6ZGu6u6Q9VMNjGr67Lctvy5P8oyaYAL9CAWrUE9i6GoNMKUga5biW6Hx4tws2six3b9c'\\nn = 0\\nfor ch in t: n = n * 58 + B58.index(ch)\\nraw = n.to_bytes(82, 'big')\\nok = hashlib.sha256(hashlib.sha256(raw[:-4]).digest()).digest()[:4] == raw[-4:]\\nresult = (ok, raw[:4].hex(), raw[4], raw[45])\", g), g['result'])[1])({})" ; chx:output "(True, '0488ade4', 1, 0)" .
chx:X_ExtendedPrivateKey rd:hasIOExample chx:IO_ExtendedPrivateKey .
chx:X_ExtendedPublicKey a owl:NamedIndividual, chx:ExtendedPublicKey ; rdfs:label "111 characters of base58check"@en ; skos:definition "An extended public key is a public key with its chain code: it derives all the normal public keys of its branch and none of the private ones, and is written with the prefix xpub."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_ExtendedPublicKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "len('xpub67xpozcx8pe95XVuZLHXZeG6XWXHpGq6Qv5cmNfi7cS5mtjJ2tgypeQbBs2UAR6KECeeMVKZBPLrtJunSDMstweyLXhRgPxdp14sk9tJPW9') evaluates to 111"@en ; chx:input "len('xpub67xpozcx8pe95XVuZLHXZeG6XWXHpGq6Qv5cmNfi7cS5mtjJ2tgypeQbBs2UAR6KECeeMVKZBPLrtJunSDMstweyLXhRgPxdp14sk9tJPW9')" ; chx:output "111" .
chx:X_ExtendedPublicKey rd:hasIOExample chx:IO_ExtendedPublicKey .
chx:X_ExtendedKeyEncoding a owl:NamedIndividual, chx:ExtendedKeyEncoding ; rdfs:label "the book's xpub, decoded"@en ; skos:definition "An extended key is written in base58check with four version bytes, which is what produces the recognisable xprv and xpub prefixes and a fixed length of 111 characters."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_ExtendedKeyEncoding a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nB58 = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'\\nt = 'xpub67xpozcx8pe95XVuZLHXZeG6XWXHpGq6Qv5cmNfi7cS5mtjJ2tgypeQbBs2UAR6KECeeMVKZBPLrtJunSDMstweyLXhRgPxdp14sk9tJPW9'\\nn = 0\\nfor ch in t: n = n * 58 + B58.index(ch)\\nraw = n.to_bytes(82, 'big')\\nok = hashlib.sha256(hashlib.sha256(raw[:-4]).digest()).digest()[:4] == raw[-4:]\\nresult = (ok, raw[:4].hex(), raw[45])\", g), g['result'])[1])({}) evaluates to (True, '0488b21e', 2)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nB58 = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'\\nt = 'xpub67xpozcx8pe95XVuZLHXZeG6XWXHpGq6Qv5cmNfi7cS5mtjJ2tgypeQbBs2UAR6KECeeMVKZBPLrtJunSDMstweyLXhRgPxdp14sk9tJPW9'\\nn = 0\\nfor ch in t: n = n * 58 + B58.index(ch)\\nraw = n.to_bytes(82, 'big')\\nok = hashlib.sha256(hashlib.sha256(raw[:-4]).digest()).digest()[:4] == raw[-4:]\\nresult = (ok, raw[:4].hex(), raw[45])\", g), g['result'])[1])({})" ; chx:output "(True, '0488b21e', 2)" .
chx:X_ExtendedKeyEncoding rd:hasIOExample chx:IO_ExtendedKeyEncoding .
chx:X_KeyFingerprint a owl:NamedIndividual, chx:KeyFingerprint ; rdfs:label "the first 32 bits of an identifier"@en ; skos:definition "A key fingerprint is the first four bytes of the hash identifier of an extended key, used as a short, non-unique label for the parent a derivation started from."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_KeyFingerprint a owl:NamedIndividual, rd:IOExample ; rdfs:label "len('0a2683ed') * 4 evaluates to 32"@en ; chx:input "len('0a2683ed') * 4" ; chx:output "32" .
chx:X_KeyFingerprint rd:hasIOExample chx:IO_KeyFingerprint .
chx:X_KeyPath a owl:NamedIndividual, chx:KeyPath ; rdfs:label "m/84h/0h/0h/0/2 as five indices"@en ; skos:definition "A key path names a key by the sequence of indices from the root, written with slashes, beginning m for private or M for public keys, with a prime or h for hardened steps."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_KeyPath a owl:NamedIndividual, rd:IOExample ; rdfs:label "[int(p.rstrip('h')) + (2 ** 31 if p.endswith('h') else 0) for p in 'm/84h/0h/0h/0/2'.split('/')[1:]] evaluates to [2147483732, 2147483648, 2147483648, 0, 2]"@en ; chx:input "[int(p.rstrip('h')) + (2 ** 31 if p.endswith('h') else 0) for p in 'm/84h/0h/0h/0/2'.split('/')[1:]]" ; chx:output "[2147483732, 2147483648, 2147483648, 0, 2]" .
chx:X_KeyPath rd:hasIOExample chx:IO_KeyPath .
chx:X_Bip43Purpose a owl:NamedIndividual, chx:Bip43Purpose ; rdfs:label "44 hardened is 0x8000002c"@en ; skos:definition "BIP43 reserves the first hardened level of a BIP32 tree for a purpose number that says which scheme the rest of the tree follows, and recommends using the scheme's own BIP number."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Bip43Purpose a owl:NamedIndividual, rd:IOExample ; rdfs:label "hex(2 ** 31 + 44) evaluates to '0x8000002c'"@en ; chx:input "hex(2 ** 31 + 44)" ; chx:output "'0x8000002c'" .
chx:X_Bip43Purpose rd:hasIOExample chx:IO_Bip43Purpose .
chx:X_Bip44Structure a owl:NamedIndividual, chx:Bip44Structure ; rdfs:label "five predefined levels"@en ; skos:definition "BIP44 defines the five levels purpose, coin type, account, change and address index under purpose 44 hardened, with the first three hardened and the last two normal."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Bip44Structure a owl:NamedIndividual, rd:IOExample ; rdfs:label "len('m / purpose / coin_type / account / change / address_index'.split(' / ')) - 1 evaluates to 5"@en ; chx:input "len('m / purpose / coin_type / account / change / address_index'.split(' / ')) - 1" ; chx:output "5" .
chx:X_Bip44Structure rd:hasIOExample chx:IO_Bip44Structure .
chx:X_AccountBranch a owl:NamedIndividual, chx:AccountBranch ; rdfs:label "the second account of a BIP44 wallet"@en ; skos:definition "The account level is the third level of a BIP44 path, hardened, which splits a wallet into independent subaccounts that never mix coins."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_AccountBranch a owl:NamedIndividual, rd:IOExample ; rdfs:label "'m/44h/0h/%dh' % 1 evaluates to 'm/44h/0h/1h'"@en ; chx:input "'m/44h/0h/%dh' % 1" ; chx:output "'m/44h/0h/1h'" .
chx:X_AccountBranch rd:hasIOExample chx:IO_AccountBranch .
chx:X_ChangeBranch a owl:NamedIndividual, chx:ChangeBranch ; rdfs:label "the fifteenth change address of the fourth account"@en ; skos:definition "The fourth level of a BIP44 path is 0 for the external chain, whose addresses are given out, and 1 for the internal chain, which receives change; both use normal derivation."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_ChangeBranch a owl:NamedIndividual, rd:IOExample ; rdfs:label "'M/44h/0h/%dh/%d/%d' % (3, 1, 14) evaluates to 'M/44h/0h/3h/1/14'"@en ; chx:input "'M/44h/0h/%dh/%d/%d' % (3, 1, 14)" ; chx:output "'M/44h/0h/3h/1/14'" .
chx:X_ChangeBranch rd:hasIOExample chx:IO_ChangeBranch .
chx:X_AddressIndex a owl:NamedIndividual, chx:AddressIndex ; rdfs:label "the third receiving address of an account"@en ; skos:definition "The fifth level of a BIP44 path is the address index, counted from zero with normal derivation, and it is the level a wallet advances each time it needs a new address."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_AddressIndex a owl:NamedIndividual, rd:IOExample ; rdfs:label "'M/44h/0h/0h/0/%d' % (3 - 1) evaluates to 'M/44h/0h/0h/0/2'"@en ; chx:input "'M/44h/0h/0h/0/%d' % (3 - 1)" ; chx:output "'M/44h/0h/0h/0/2'" .
chx:X_AddressIndex rd:hasIOExample chx:IO_AddressIndex .
chx:X_ImplicitPath a owl:NamedIndividual, chx:ImplicitPath ; rdfs:label "the path a wallet assumes"@en ; skos:definition "An implicit path is a standardised derivation path that a wallet uses without being told, so that nothing has to be backed up beside the recovery code - at the price of inflexibility."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_ImplicitPath a owl:NamedIndividual, rd:IOExample ; rdfs:label "\"m/84'/0'/0'/0/0\".split('/') evaluates to ['m', \"84'\", \"0'\", \"0'\", '0', '0']"@en ; chx:input "\"m/84'/0'/0'/0/0\".split('/')" ; chx:output "['m', \"84'\", \"0'\", \"0'\", '0', '0']" .
chx:X_ImplicitPath rd:hasIOExample chx:IO_ImplicitPath .
chx:X_ExplicitPath a owl:NamedIndividual, chx:ExplicitPath ; rdfs:label "the path written down with the code"@en ; skos:definition "An explicit path is derivation information backed up alongside the recovery code, which says exactly which keys go with which scripts and can carry extra data such as other people's public keys."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_ExplicitPath a owl:NamedIndividual, rd:IOExample ; rdfs:label "(len('[6d8c4b8f/84h/0h/0h]'), len(\"m/84'/0'/0'\")) evaluates to (20, 11)"@en ; chx:input "(len('[6d8c4b8f/84h/0h/0h]'), len(\"m/84'/0'/0'\"))" ; chx:output "(20, 11)" .
chx:X_ExplicitPath rd:hasIOExample chx:IO_ExplicitPath .
chx:X_StandardPath44 a owl:NamedIndividual, chx:StandardPath44 ; rdfs:label "m/44h/0h/0h"@en ; skos:definition "BIP44's account path for pay-to-public-key-hash scripts is the first of the standard implicit paths and the one the chapter's table gives for legacy addresses."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_StandardPath44 a owl:NamedIndividual, rd:IOExample ; rdfs:label "'m/%dh/0h/0h' % 44 evaluates to 'm/44h/0h/0h'"@en ; chx:input "'m/%dh/0h/0h' % 44" ; chx:output "'m/44h/0h/0h'" .
chx:X_StandardPath44 rd:hasIOExample chx:IO_StandardPath44 .
chx:X_StandardPath49 a owl:NamedIndividual, chx:StandardPath49 ; rdfs:label "49 hardened is 0x80000031"@en ; skos:definition "BIP49 gives segregated witness keys wrapped in a script hash their own account path, so that an incompatible wallet finds nothing rather than finding part of the funds."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_StandardPath49 a owl:NamedIndividual, rd:IOExample ; rdfs:label "hex(2 ** 31 + 49) evaluates to '0x80000031'"@en ; chx:input "hex(2 ** 31 + 49)" ; chx:output "'0x80000031'" .
chx:X_StandardPath49 rd:hasIOExample chx:IO_StandardPath49 .
chx:X_StandardPath84 a owl:NamedIndividual, chx:StandardPath84 ; rdfs:label "the first address of the standard's test vector"@en ; skos:definition "BIP84 gives native segregated witness keys their own account path, and its test vector's first address is the bech32 address the course can recompute from the key hash."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_StandardPath84 a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"CHARSET = 'qpzry9x8gf2tvdw0s3jn54khce6mua7l'\\ndef polymod(values):\\n    gen = (0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3); chk = 1\\n    for v in values:\\n        top = chk >> 25; chk = (chk & 0x1ffffff) << 5 ^ v\\n        for i in range(5): chk ^= gen[i] if (top >> i) & 1 else 0\\n    return chk\\ndef convertbits(data):\\n    acc = bits = 0; out = []\\n    for v in data:\\n        acc = (acc << 8) | v; bits += 8\\n        while bits >= 5: bits -= 5; out.append((acc >> bits) & 31)\\n    return out\\ndata = [0] + convertbits(bytes.fromhex('c0cebcd6c3d3ca8c75dc5ec62ebe55330ef910e2'))\\nvalues = [ord(c) >> 5 for c in 'bc'] + [0] + [ord(c) & 31 for c in 'bc'] + data\\npm = polymod(values + [0] * 6) ^ 1\\nresult = 'bc1' + ''.join(CHARSET[d] for d in data + [(pm >> 5 * (5 - i)) & 31 for i in range(6)])\", g), g['result'])[1])({}) evaluates to 'bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyu'"@en ; chx:input "(lambda g: (exec(\"CHARSET = 'qpzry9x8gf2tvdw0s3jn54khce6mua7l'\\ndef polymod(values):\\n    gen = (0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3); chk = 1\\n    for v in values:\\n        top = chk >> 25; chk = (chk & 0x1ffffff) << 5 ^ v\\n        for i in range(5): chk ^= gen[i] if (top >> i) & 1 else 0\\n    return chk\\ndef convertbits(data):\\n    acc = bits = 0; out = []\\n    for v in data:\\n        acc = (acc << 8) | v; bits += 8\\n        while bits >= 5: bits -= 5; out.append((acc >> bits) & 31)\\n    return out\\ndata = [0] + convertbits(bytes.fromhex('c0cebcd6c3d3ca8c75dc5ec62ebe55330ef910e2'))\\nvalues = [ord(c) >> 5 for c in 'bc'] + [0] + [ord(c) & 31 for c in 'bc'] + data\\npm = polymod(values + [0] * 6) ^ 1\\nresult = 'bc1' + ''.join(CHARSET[d] for d in data + [(pm >> 5 * (5 - i)) & 31 for i in range(6)])\", g), g['result'])[1])({})" ; chx:output "'bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyu'" .
chx:X_StandardPath84 rd:hasIOExample chx:IO_StandardPath84 .
chx:X_StandardPath86 a owl:NamedIndividual, chx:StandardPath86 ; rdfs:label "the tweak of the test vector's internal key"@en ; skos:definition "BIP86 gives single-key taproot outputs their own account path and says how the output key is computed from the derived key by a tagged hash."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_StandardPath86 a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda h: h.sha256(h.sha256(b'TapTweak').digest() + h.sha256(b'TapTweak').digest() + bytes.fromhex('cc8a4bc64d897bddc5fbc2f670f7a8ba0b386779106cf1223c6fc5d7cd6fc115')).hexdigest()[:16])(__import__('hashlib')) evaluates to '2ca01ed85cf6b652'"@en ; chx:input "(lambda h: h.sha256(h.sha256(b'TapTweak').digest() + h.sha256(b'TapTweak').digest() + bytes.fromhex('cc8a4bc64d897bddc5fbc2f670f7a8ba0b386779106cf1223c6fc5d7cd6fc115')).hexdigest()[:16])(__import__('hashlib'))" ; chx:output "'2ca01ed85cf6b652'" .
chx:X_StandardPath86 rd:hasIOExample chx:IO_StandardPath86 .
chx:X_Multisignature a owl:NamedIndividual, chx:Multisignature ; rdfs:label "two of three signatures"@en ; skos:definition "A multisignature arrangement requires several of a set of keys to sign; its participants cannot restore the arrangement from their own seeds alone, because they also need the others' public keys."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Multisignature a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('math').comb(3, 2) evaluates to 3"@en ; chx:input "__import__('math').comb(3, 2)" ; chx:output "3" .
chx:X_Multisignature rd:hasIOExample chx:IO_Multisignature .
chx:X_OutputScript a owl:NamedIndividual, chx:OutputScript ; rdfs:label "twenty-two bytes for a native segwit output"@en ; skos:definition "An output script is the program in a transaction output that says what must be presented to spend it; a descriptor is a description of a family of such scripts."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_OutputScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(bytes.fromhex('0014' + 'c0cebcd6c3d3ca8c75dc5ec62ebe55330ef910e2')) evaluates to 22"@en ; chx:input "len(bytes.fromhex('0014' + 'c0cebcd6c3d3ca8c75dc5ec62ebe55330ef910e2'))" ; chx:output "22" .
chx:X_OutputScript rd:hasIOExample chx:IO_OutputScript .
chx:X_OutputScriptDescriptor a owl:NamedIndividual, chx:OutputScriptDescriptor ; rdfs:label "a descriptor split into function and argument"@en ; skos:definition "A descriptor is a short expression naming a script type as a function and its keys as arguments, so that it says exactly which scripts and addresses a wallet should produce."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_OutputScriptDescriptor a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"d = 'wpkh([6d8c4b8f/84h/0h/0h]xpub6CwyJSJaLE3Kbot3LrjZkkMAfT2fNuzHrn2S4iHAwTctsp23par19x6D2FHkG6ypKdmJPsfcsbbrYqQSVuXrWME6QBFjvyuDod2UvsTRPhB/0/*)'\\nresult = (d[:d.index('(')], d[d.index('['):d.index(']') + 1], d[-5:])\", g), g['result'])[1])({}) evaluates to ('wpkh', '[6d8c4b8f/84h/0h/0h]', '/0/*)')"@en ; chx:input "(lambda g: (exec(\"d = 'wpkh([6d8c4b8f/84h/0h/0h]xpub6CwyJSJaLE3Kbot3LrjZkkMAfT2fNuzHrn2S4iHAwTctsp23par19x6D2FHkG6ypKdmJPsfcsbbrYqQSVuXrWME6QBFjvyuDod2UvsTRPhB/0/*)'\\nresult = (d[:d.index('(')], d[d.index('['):d.index(']') + 1], d[-5:])\", g), g['result'])[1])({})" ; chx:output "('wpkh', '[6d8c4b8f/84h/0h/0h]', '/0/*)')" .
chx:X_OutputScriptDescriptor rd:hasIOExample chx:IO_OutputScriptDescriptor .
chx:X_DescriptorChecksum a owl:NamedIndividual, chx:DescriptorChecksum ; rdfs:label "eight characters after a hash sign"@en ; skos:definition "A descriptor carries an eight-character error-detecting checksum after a hash sign, which catches any one or two symbol errors in a descriptor of ordinary length."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_DescriptorChecksum a owl:NamedIndividual, rd:IOExample ; rdfs:label "len('raw(deadbeef)#89f8spxm'.split('#')[1]) evaluates to 8"@en ; chx:input "len('raw(deadbeef)#89f8spxm'.split('#')[1])" ; chx:output "8" .
chx:X_DescriptorChecksum rd:hasIOExample chx:IO_DescriptorChecksum .
chx:X_KeyOrigin a owl:NamedIndividual, chx:KeyOrigin ; rdfs:label "a fingerprint and three hardened steps"@en ; skos:definition "The key origin of a descriptor records, in brackets, the fingerprint of the master key and the path from it to the key that follows, so that a signing device can find the right key."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_KeyOrigin a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import re\\nd = \\'wpkh([6d8c4b8f/84h/0h/0h]xpub6CwyJSJaLE3Kbot3LrjZkkMAfT2fNuzHrn2S4iHAwTctsp23par19x6D2FHkG6ypKdmJPsfcsbbrYqQSVuXrWME6QBFjvyuDod2UvsTRPhB/0/*)\\'\\nm = re.search(r\"\\\\[([0-9a-f]{8})((?:/\\\\d+[h\\'])*)\\\\]\", d)\\nresult = (m.group(1), [int(p.rstrip(\"h\\'\")) for p in m.group(2).split(\\'/\\')[1:]])', g), g['result'])[1])({}) evaluates to ('6d8c4b8f', [84, 0, 0])"@en ; chx:input "(lambda g: (exec('import re\\nd = \\'wpkh([6d8c4b8f/84h/0h/0h]xpub6CwyJSJaLE3Kbot3LrjZkkMAfT2fNuzHrn2S4iHAwTctsp23par19x6D2FHkG6ypKdmJPsfcsbbrYqQSVuXrWME6QBFjvyuDod2UvsTRPhB/0/*)\\'\\nm = re.search(r\"\\\\[([0-9a-f]{8})((?:/\\\\d+[h\\'])*)\\\\]\", d)\\nresult = (m.group(1), [int(p.rstrip(\"h\\'\")) for p in m.group(2).split(\\'/\\')[1:]])', g), g['result'])[1])({})" ; chx:output "('6d8c4b8f', [84, 0, 0])" .
chx:X_KeyOrigin rd:hasIOExample chx:IO_KeyOrigin .
chx:X_MultipathDescriptor a owl:NamedIndividual, chx:MultipathDescriptor ; rdfs:label "one descriptor expanded into two"@en ; skos:definition "A multipath descriptor writes a tuple of derivation steps in angle brackets, so that one descriptor stands for the receive and the change descriptor of a wallet."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_MultipathDescriptor a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"d = 'wpkh([6d8c4b8f/84h/0h/0h]xpub.../<0;1>/*)'\\nhead, rest = d.split('<')\\nchoices, tail = rest.split('>')\\nresult = [head + c + tail for c in choices.split(';')]\", g), g['result'])[1])({}) evaluates to ['wpkh([6d8c4b8f/84h/0h/0h]xpub.../0/*)', 'wpkh([6d8c4b8f/84h/0h/0h]xpub.../1/*)']"@en ; chx:input "(lambda g: (exec(\"d = 'wpkh([6d8c4b8f/84h/0h/0h]xpub.../<0;1>/*)'\\nhead, rest = d.split('<')\\nchoices, tail = rest.split('>')\\nresult = [head + c + tail for c in choices.split(';')]\", g), g['result'])[1])({})" ; chx:output "['wpkh([6d8c4b8f/84h/0h/0h]xpub.../0/*)', 'wpkh([6d8c4b8f/84h/0h/0h]xpub.../1/*)']" .
chx:X_MultipathDescriptor rd:hasIOExample chx:IO_MultipathDescriptor .
chx:X_Miniscript a owl:NamedIndividual, chx:Miniscript ; rdfs:label "a policy that decays from four of four to one of four"@en ; skos:definition "Miniscript is a structured language for a subset of Bitcoin scripts, so that spending conditions can be analysed, composed and signed for; descriptors can contain it."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Miniscript a owl:NamedIndividual, rd:IOExample ; rdfs:label "[4 - i for i in range(4)] evaluates to [4, 3, 2, 1]"@en ; chx:input "[4 - i for i in range(4)]" ; chx:output "[4, 3, 2, 1]" .
chx:X_Miniscript rd:hasIOExample chx:IO_Miniscript .
chx:X_AddressLabel a owl:NamedIndividual, chx:AddressLabel ; rdfs:label "a name on an address at the time it is created"@en ; skos:definition "An address label is a note a user attaches to an address they hand out, so that payments arriving there can be recognised; it exists only in that user's wallet."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_AddressLabel a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('json').dumps({'type': 'addr', 'ref': 'bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyu', 'label': 'Alice'}) evaluates to '{\"type\": \"addr\", \"ref\": \"bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyu\", \"label\": \"Alice\"}'"@en ; chx:input "__import__('json').dumps({'type': 'addr', 'ref': 'bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyu', 'label': 'Alice'})" ; chx:output "'{\"type\": \"addr\", \"ref\": \"bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyu\", \"label\": \"Alice\"}'" .
chx:X_AddressLabel rd:hasIOExample chx:IO_AddressLabel .
chx:X_TransactionLabel a owl:NamedIndividual, chx:TransactionLabel ; rdfs:label "Alice's two labelled payments"@en ; skos:definition "A transaction label is a note a user attaches to a payment they made or received, which a seed-based restoration cannot reproduce."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_TransactionLabel a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(0.00100 - 0.00075, 5) evaluates to 0.00025"@en ; chx:input "round(0.00100 - 0.00075, 5)" ; chx:output "0.00025" .
chx:X_TransactionLabel rd:hasIOExample chx:IO_TransactionLabel .
chx:X_LabelExportFormat a owl:NamedIndividual, chx:LabelExportFormat ; rdfs:label "one record as a line of JSON"@en ; skos:definition "BIP329 proposes a line-based JSON format for exporting wallet labels, so that labels can be moved between applications instead of locking a user into one."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_LabelExportFormat a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import json\\nr = {'type': 'addr', 'ref': 'bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyu', 'label': 'Paid Bob for podcast'}\\nresult = json.dumps(r, sort_keys=True)\", g), g['result'])[1])({}) evaluates to '{\"label\": \"Paid Bob for podcast\", \"ref\": \"bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyu\", \"type\": \"addr\"}'"@en ; chx:input "(lambda g: (exec(\"import json\\nr = {'type': 'addr', 'ref': 'bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyu', 'label': 'Paid Bob for podcast'}\\nresult = json.dumps(r, sort_keys=True)\", g), g['result'])[1])({})" ; chx:output "'{\"label\": \"Paid Bob for podcast\", \"ref\": \"bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyu\", \"type\": \"addr\"}'" .
chx:X_LabelExportFormat rd:hasIOExample chx:IO_LabelExportFormat .
chx:X_LightningNetwork a owl:NamedIndividual, chx:LightningNetwork ; rdfs:label "a channel as a shared output"@en ; skos:definition "The Lightning Network is a protocol of payment channels built on Bitcoin, in which funds live in outputs that two parties control jointly, so a wallet must keep state that no seed can reproduce."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:X_StaticChannelBackup a owl:NamedIndividual, chx:StaticChannelBackup ; rdfs:label "one backup per channel, not per payment"@en ; skos:definition "A static channel backup records what is needed to recover a channel's settled funds and is taken once, when the channel is created; it allows recovery of those funds but cannot guarantee the result."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:X_Encryption a owl:NamedIndividual, chx:Encryption ; rdfs:label "a note hidden and recovered with a derived key"@en ; skos:definition "Encryption turns data into a form that only a holder of the key can read back; a wallet can therefore store a backup where anyone can see it, as long as the key stays secret."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_Encryption a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nkey = hashlib.sha256(bytes.fromhex('5b56c417303faa3f') + b'backup').digest()\\nnote = b'Paid Bob for podcast'\\nhidden = bytes(a ^ b for a, b in zip(note, key))\\nresult = (hidden.hex()[:16], bytes(a ^ b for a, b in zip(hidden, key)).decode())\", g), g['result'])[1])({}) evaluates to ('ddfb63036eb21eb9', 'Paid Bob for podcast')"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nkey = hashlib.sha256(bytes.fromhex('5b56c417303faa3f') + b'backup').digest()\\nnote = b'Paid Bob for podcast'\\nhidden = bytes(a ^ b for a, b in zip(note, key))\\nresult = (hidden.hex()[:16], bytes(a ^ b for a, b in zip(hidden, key)).decode())\", g), g['result'])[1])({})" ; chx:output "('ddfb63036eb21eb9', 'Paid Bob for podcast')" .
chx:X_Encryption rd:hasIOExample chx:IO_Encryption .
chx:X_EncryptedWalletBackup a owl:NamedIndividual, chx:EncryptedWalletBackup ; rdfs:label "a backup key derived from the seed"@en ; skos:definition "An encrypted wallet backup is a complete copy of the wallet database, encrypted under a key derived from the seed, which a user can restore from a recovery code alone."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_EncryptedWalletBackup a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hashlib').sha256(bytes.fromhex('5b56c417303faa3f') + b'backup').hexdigest()[:8] evaluates to '8d9a0a67'"@en ; chx:input "__import__('hashlib').sha256(bytes.fromhex('5b56c417303faa3f') + b'backup').hexdigest()[:8]" ; chx:output "'8d9a0a67'" .
chx:X_EncryptedWalletBackup rd:hasIOExample chx:IO_EncryptedWalletBackup .
chx:X_XpubDeployment a owl:NamedIndividual, chx:XpubDeployment ; rdfs:label "the first three addresses of a branch"@en ; skos:definition "Deploying an extended public key means putting the watching half of a wallet on an exposed computer, which can then derive a fresh address for every order and spend nothing."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_XpubDeployment a owl:NamedIndividual, rd:IOExample ; rdfs:label "['M/84h/0h/0h/0/%d' % i for i in range(3)] evaluates to ['M/84h/0h/0h/0/0', 'M/84h/0h/0h/0/1', 'M/84h/0h/0h/0/2']"@en ; chx:input "['M/84h/0h/0h/0/%d' % i for i in range(3)]" ; chx:output "['M/84h/0h/0h/0/0', 'M/84h/0h/0h/0/1', 'M/84h/0h/0h/0/2']" .
chx:X_XpubDeployment rd:hasIOExample chx:IO_XpubDeployment .
chx:X_GapLimit a owl:NamedIndividual, chx:GapLimit ; rdfs:label "a payment at index 25 missed by a scan with a gap of 20"@en ; skos:definition "The gap limit is the number of unused addresses in a row that a wallet will tolerate before it stops looking for payments; a payment beyond it is not found."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_GapLimit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('used = {0, 3, 25}\\ngap = 20\\nfound = []; run = 0; i = 0\\nwhile run < gap:\\n    if i in used: found.append(i); run = 0\\n    else: run += 1\\n    i += 1\\nresult = (found, i)', g), g['result'])[1])({}) evaluates to ([0, 3], 24)"@en ; chx:input "(lambda g: (exec('used = {0, 3, 25}\\ngap = 20\\nfound = []; run = 0; i = 0\\nwhile run < gap:\\n    if i in used: found.append(i); run = 0\\n    else: run += 1\\n    i += 1\\nresult = (found, i)', g), g['result'])[1])({})" ; chx:output "([0, 3], 24)" .
chx:X_GapLimit rd:hasIOExample chx:IO_GapLimit .
chx:X_PaymentProcessor a owl:NamedIndividual, chx:PaymentProcessor ; rdfs:label "the software the extended public key is loaded into"@en ; skos:definition "A payment processor is the program that watches for payments and matches them to orders; a self-hosted one lets a merchant accept bitcoins with the extended public key as its only key material."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:X_ColdStorage a owl:NamedIndividual, chx:ColdStorage ; rdfs:label "keys that never touch a connected computer"@en ; skos:definition "Cold storage means keeping keys offline, created and stored in a secure environment that is not connected to a network, so that an attack on a connected computer cannot reach them."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:X_HardwareSigningDevice a owl:NamedIndividual, chx:HardwareSigningDevice ; rdfs:label "a device that signs but does not export"@en ; skos:definition "A hardware signing device stores private keys and produces signatures on request without revealing the keys, so a less secure computer can build transactions it cannot sign."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:X_WrittenBackup a owl:NamedIndividual, chx:WrittenBackup ; rdfs:label "twelve words instead of thirty-two hexadecimal digits"@en ; skos:definition "A written backup is the recovery code on paper, which the chapter recommends even for schemes designed to be memorised, because memory fails and cannot be inherited."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_WrittenBackup a owl:NamedIndividual, rd:IOExample ; rdfs:label "(len('0c1e24e5917779d297e14d45f14e1a1a'), len('army van defense carry jealous true garbage claim echo media make crunch'.split())) evaluates to (32, 12)"@en ; chx:input "(len('0c1e24e5917779d297e14d45f14e1a1a'), len('army van defense carry jealous true garbage claim echo media make crunch'.split()))" ; chx:output "(32, 12)" .
chx:X_WrittenBackup rd:hasIOExample chx:IO_WrittenBackup .
chx:X_HashFunction a owl:NamedIndividual, chx:HashFunction ; rdfs:label "the hash of three letters"@en ; skos:definition "A hash function maps data of any size to a fixed-size value, always the same for the same input and unpredictable for a changed one, and cannot be run backwards."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_HashFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hashlib').sha256(b'abc').hexdigest()[:8] evaluates to 'ba7816bf'"@en ; chx:input "__import__('hashlib').sha256(b'abc').hexdigest()[:8]" ; chx:output "'ba7816bf'" .
chx:X_HashFunction rd:hasIOExample chx:IO_HashFunction .
chx:X_ShaAlgorithm a owl:NamedIndividual, chx:ShaAlgorithm ; rdfs:label "32 bytes and 64 bytes"@en ; skos:definition "SHA-256 and SHA-512 are the two secure hash algorithms this chapter's standards name, producing 32 and 64 bytes; the choice of one or the other fixes the sizes in every scheme."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_ShaAlgorithm a owl:NamedIndividual, rd:IOExample ; rdfs:label "(len(__import__('hashlib').sha256(b'').digest()), len(__import__('hashlib').sha512(b'').digest())) evaluates to (32, 64)"@en ; chx:input "(len(__import__('hashlib').sha256(b'').digest()), len(__import__('hashlib').sha512(b'').digest()))" ; chx:output "(32, 64)" .
chx:X_ShaAlgorithm rd:hasIOExample chx:IO_ShaAlgorithm .
chx:X_DigitalSignature a owl:NamedIndividual, chx:DigitalSignature ; rdfs:label "what a signing device returns"@en ; skos:definition "A digital signature is a value computed from a message and a private key that anyone can check against the matching public key, which is how spending a Bitcoin output is authorised."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_DigitalSignature a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda h, a, b: sum(bin(x ^ y).count('1') for x, y in zip(h(a), h(b))))(lambda m: __import__('hashlib').sha256(m).digest(), b'pay Bob 1 BTC', b'pay Bob 2 BTC') evaluates to 135"@en ; chx:input "(lambda h, a, b: sum(bin(x ^ y).count('1') for x, y in zip(h(a), h(b))))(lambda m: __import__('hashlib').sha256(m).digest(), b'pay Bob 1 BTC', b'pay Bob 2 BTC')" ; chx:output "135" .
chx:X_DigitalSignature rd:hasIOExample chx:IO_DigitalSignature .
chx:X_SecretSharing a owl:NamedIndividual, chx:SecretSharing ; rdfs:label "three of five points recover the secret"@en ; skos:definition "Secret sharing splits a secret into parts so that any sufficient number of them recovers it and any smaller number reveals nothing; it is the mathematics behind SLIP39 and codex32."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_SecretSharing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('prime = 2 ** 127 - 1\\nsecret, coeffs = 123456789, [11, 22]\\nshares = [(x, (secret + coeffs[0] * x + coeffs[1] * x * x) % prime) for x in (1, 2, 3, 4, 5)]\\ndef combine(points):\\n    total = 0\\n    for j, (xj, yj) in enumerate(points):\\n        num = den = 1\\n        for m, (xm, _) in enumerate(points):\\n            if m != j: num = num * (-xm) % prime; den = den * (xj - xm) % prime\\n        total = (total + yj * num * pow(den, -1, prime)) % prime\\n    return total\\nresult = (combine(shares[:3]), combine(shares[2:5]), combine(shares[:2]) == secret)', g), g['result'])[1])({}) evaluates to (123456789, 123456789, False)"@en ; chx:input "(lambda g: (exec('prime = 2 ** 127 - 1\\nsecret, coeffs = 123456789, [11, 22]\\nshares = [(x, (secret + coeffs[0] * x + coeffs[1] * x * x) % prime) for x in (1, 2, 3, 4, 5)]\\ndef combine(points):\\n    total = 0\\n    for j, (xj, yj) in enumerate(points):\\n        num = den = 1\\n        for m, (xm, _) in enumerate(points):\\n            if m != j: num = num * (-xm) % prime; den = den * (xj - xm) % prime\\n        total = (total + yj * num * pow(den, -1, prime)) % prime\\n    return total\\nresult = (combine(shares[:3]), combine(shares[2:5]), combine(shares[:2]) == secret)', g), g['result'])[1])({})" ; chx:output "(123456789, 123456789, False)" .
chx:X_SecretSharing rd:hasIOExample chx:IO_SecretSharing .
chx:X_DataLoss a owl:NamedIndividual, chx:DataLoss ; rdfs:label "the loss the chapter calls the leading cause"@en ; skos:definition "Data loss is the loss of the keys or of the information needed to use them, which the chapter names as perhaps the leading cause of lost bitcoins, and which no one can reverse."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_DataLoss a owl:NamedIndividual, rd:IOExample ; rdfs:label "2 ** 128 evaluates to 340282366920938463463374607431768211456"@en ; chx:input "2 ** 128" ; chx:output "340282366920938463463374607431768211456" .
chx:X_DataLoss rd:hasIOExample chx:IO_DataLoss .
chx:X_BackupTesting a owl:NamedIndividual, chx:BackupTesting ; rdfs:label "the one action the chapter asks for"@en ; skos:definition "Testing a backup means carrying out a recovery before it is needed, which is the only way to learn that a code, a path and the non-key data are all sufficient."@en ; dcterms:source <http://example.org/sen0401/ch05/research> .
chx:IO_BackupTesting a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(['the recovery code', 'the passphrase if one is used', 'the derivation paths or the descriptors', 'the public keys of any other signers', 'the data that is not keys']) evaluates to 5"@en ; chx:input "len(['the recovery code', 'the passphrase if one is used', 'the derivation paths or the descriptors', 'the public keys of any other signers', 'the data that is not keys'])" ; chx:output "5" .
chx:X_BackupTesting rd:hasIOExample chx:IO_BackupTesting .
