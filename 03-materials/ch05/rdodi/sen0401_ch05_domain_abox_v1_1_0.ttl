chx:Err_WordList a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"words = 'abandon ability able about above absent'.split()\\nword = 'notaword'\\nassert word in words, 'the word is not in the list'\\nresult = words.index(word)\", g), g['result'])[1])({}) raises AssertionError: the word is not in the list"@en .
chx:X_WordList rd:hasErrorCondition chx:Err_WordList .
chx:Err_PublicChildDerivation a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"i = 2 ** 31\\nassert i < 2 ** 31, 'no public derivation of a hardened child'\\nresult = i\", g), g['result'])[1])({}) raises AssertionError: no public derivation of a hardened child"@en .
chx:X_PublicChildDerivation rd:hasErrorCondition chx:Err_PublicChildDerivation .
chx:Err_ExtendedKeyEncoding a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"import hashlib\\nB58 = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'\\nt = 'xprv9tyUQV64JT5qs3RSTJkXCWKMyUgoQp7F3hA1xzG6ZGu6u6Q9VMNjGr67Lctvy5P8oyaYAL9CAWrUE9i6GoNMKUga5biW6Hx4tws2six3b9d'\\nn = 0\\nfor ch in t: n = n * 58 + B58.index(ch)\\nraw = n.to_bytes(82, 'big')\\nassert hashlib.sha256(hashlib.sha256(raw[:-4]).digest()).digest()[:4] == raw[-4:], 'checksum does not match'\\nresult = raw[:4].hex()\", g), g['result'])[1])({}) raises AssertionError: checksum does not match"@en .
chx:X_ExtendedKeyEncoding rd:hasErrorCondition chx:Err_ExtendedKeyEncoding .
chx:Err_Pbkdf2 a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"import hashlib, hmac\\ndef seed(words, salt, rounds=2048):\\n    u = hmac.new(words, salt + b'\\\\x00\\\\x00\\\\x00\\\\x01', hashlib.sha512).digest()\\n    out = bytearray(u)\\n    for _ in range(rounds - 1):\\n        u = hmac.new(words, u, hashlib.sha512).digest()\\n        out = bytearray(a ^ b for a, b in zip(out, u))\\n    return bytes(out)\\nresult = seed(b'army van defense', 'mnemonic')\", g), g['result'])[1])({}) raises TypeError: can only concatenate str"@en .
chx:X_Pbkdf2 rd:hasErrorCondition chx:Err_Pbkdf2 .
chx:Err_IndexNumber a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(2 ** 32).to_bytes(4, 'big') raises OverflowError: int too big to convert"@en .
chx:X_IndexNumber rd:hasErrorCondition chx:Err_IndexNumber .
chx:Err_TextNormalization a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('unicodedata').normalize('NFKX', 'e') raises ValueError: invalid normalization form"@en .
chx:X_TextNormalization rd:hasErrorCondition chx:Err_TextNormalization .
chx:Err_BitSegment a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "int('', 2) raises ValueError: invalid literal for int() with base 2"@en .
chx:X_BitSegment rd:hasErrorCondition chx:Err_BitSegment .
chx:Err_HmacSha512 a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('hmac').new('key', b'message', 'sha512') raises TypeError: key: expected bytes or bytearray"@en .
chx:X_HmacSha512 rd:hasErrorCondition chx:Err_HmacSha512 .

chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 5 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch05/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 5 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2, chx:CQ3, chx:CQ4, chx:CQ5, chx:CQ6, chx:CQ7 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What does a Bitcoin wallet actually contain, and which of its contents can be recomputed from a seed and which cannot?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How is a BIP39 recovery code generated from entropy and turned into a seed, and can every number the chapter prints be reproduced?"@en .
chx:CQ3 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How does BIP32 make a tree of keys from one seed, and what can the holder of an extended public key do and not do?"@en .
chx:CQ4 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which recovery code schemes are in use, what does each add over BIP39, and what does each cost its user?"@en .
chx:CQ5 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which derivation paths does a wallet use, how are they recorded implicitly or explicitly, and what does a descriptor say that a seed cannot?"@en .
chx:CQ6 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Where do the chapter's statements differ from the standards and from Bitcoin Core 31.1, and what does each difference change?"@en .
chx:CQ7 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which terms do the explanations of this chapter rely on, and is each one a concept of this chapter or of an earlier chapter?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 5 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 5 through the Stage 1 research record: the chapter's own sections and named terms first, then the standards it cites (BIP32, BIP39, BIP43, BIP44, BIP49, BIP84, BIP86, BIP93, BIP329, BIP379, BIP380, BIP389, SLIP-0039 and SLIP-0044), the documents of the wallets it names (Electrum, lnd's aezeed and recovery notes, Muun's recovery tool, BTCPay Server), the specifications of the functions it uses (RFC 2104, RFC 7914, RFC 8018), Bitcoin Core's documentation and wallet sources at commit 05bc2f5 with the evidence of a run of release 31.1, and the owner's 2021 course notes; the supporting concepts (the hash function, the SHA family, the digital signature, secret sharing, encryption, multisignature, the output script, the Lightning Network, data loss and the testing of a backup) were added because an audit of the explanations found them used without a concept of their own."@en ;
    dcterms:source <http://example.org/sen0401/ch05/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (457 checks listed in sen0401_ch05_corpus_v1_1_0.py), executed under CPython 3.14.4."@en ;
    dcterms:source "The execution run of this ontology's build, 08-tooling/sen0401_chapter_build_v1_0_1.py, over the claims in 08-tooling/sen0401_ch05_corpus_v1_1_0.py" .

