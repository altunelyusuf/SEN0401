chx:X_TaprootVerdicts a owl:NamedIndividual, chx:TaprootVerdicts ; rdfs:label "what the node says about five malformed signatures"@en ; skos:definition "Bitcoin Core 31.1 accepts the 64-byte default and the explicit ALL signature and rejects an explicit zero hash type, a 63-byte signature and two altered signatures, each with its own message."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_TaprootVerdicts a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_taproot_verdicts() evaluates to {'default_64': [True, None], 'explicit_all_65': [True, None], 'explicit_zero_65': [False, 'mempool-script-verify-flag-failed (Invalid Schnorr signature hash type)'], 'short_63': [False, 'mempool-script-verify-flag-failed (Invalid Schnorr signature size)'], 'flipped_bit': [False, 'mempool-script-verify-flag-failed (Invalid Schnorr signature)'], 'hash_type_mismatch': [False, 'mempool-script-verify-flag-failed (Invalid Schnorr signature)']}"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_taproot_verdicts()" ; chx:output "{'default_64': [True, None], 'explicit_all_65': [True, None], 'explicit_zero_65': [False, 'mempool-script-verify-flag-failed (Invalid Schnorr signature hash type)'], 'short_63': [False, 'mempool-script-verify-flag-failed (Invalid Schnorr signature size)'], 'flipped_bit': [False, 'mempool-script-verify-flag-failed (Invalid Schnorr signature)'], 'hash_type_mismatch': [False, 'mempool-script-verify-flag-failed (Invalid Schnorr signature)']}" .
chx:X_TaprootVerdicts rd:hasIOExample chx:IO_TaprootVerdicts .
