chx:IO_ActivationGap a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.activation_gap_days() evaluates to 4698"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.activation_gap_days()" ; chx:output "4698" .
chx:X_ActivationGap rd:hasIOExample chx:IO_ActivationGap .
chx:X_SourcesRecord a owl:NamedIndividual, chx:SourcesRecord ; rdfs:label "66 pages fetched, 214 passages found"@en ; skos:definition "All 66 sources of this package answered with HTTP 200 and each passage the text relies on was found in the saved copy."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_SourcesRecord a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.sources_record() evaluates to [66, 66, 214, 214]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.sources_record()" ; chx:output "[66, 66, 214, 214]" .
chx:X_SourcesRecord rd:hasIOExample chx:IO_SourcesRecord .
chx:X_CoreNodeRun a owl:NamedIndividual, chx:CoreNodeRun ; rdfs:label "Bitcoin Core 31.1.0 on regtest"@en ; skos:definition "The signatures and verdicts of this chapter come from one run of Bitcoin Core 31.1.0 (version number 310100) on a private regtest network."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_CoreNodeRun a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_node_identity() evaluates to [310100, '/Satoshi:31.1.0/', 'regtest']"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_node_identity()" ; chx:output "[310100, '/Satoshi:31.1.0/', 'regtest']" .
chx:X_CoreNodeRun rd:hasIOExample chx:IO_CoreNodeRun .
chx:X_BinaryChecksum a owl:NamedIndividual, chx:BinaryChecksum ; rdfs:label "the SHA-256 of the release archive"@en ; skos:definition "The Linux archive of Bitcoin Core 31.1 used for the run has the SHA-256 digest listed in the project's SHA256SUMS file."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_BinaryChecksum a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_binary_hash() evaluates to [True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_binary_hash()" ; chx:output "[True, True]" .
chx:X_BinaryChecksum rd:hasIOExample chx:IO_BinaryChecksum .
chx:X_ModularRemainder a owl:NamedIndividual, chx:ModularRemainder ; rdfs:label "5 divided by 3 leaves 2"@en ; skos:definition "Reducing a number modulo m keeps only the remainder of its division by m, so 5 modulo 3 is 2, which is the book's own example of what modulus means."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_ModularRemainder a owl:NamedIndividual, rd:IOExample ; rdfs:label "a = 5; m = 3; (a % m, a // m) evaluates to (2, 1)"@en ; chx:input "a = 5; m = 3; (a % m, a // m)" ; chx:output "(2, 1)" .
chx:X_ModularRemainder rd:hasIOExample chx:IO_ModularRemainder .
chx:X_ToyEcdsaCheck a owl:NamedIndividual, chx:ToyEcdsaCheck ; rdfs:label "sign and verify with ECDSA's equations modulo 101"@en ; skos:definition "With a stand-in group of integers modulo 101, the ECDSA equation s = k^-1 (z + r d) gives a signature that the verifier's combination of z/s and r/s accepts."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_ToyEcdsaCheck a owl:NamedIndividual, rd:IOExample ; rdfs:label "n = 101; g = 7; d = 17; k = 29; z = 11; q = d * g % n; r = k * g % n; s = pow(k, -1, n) * (z + r * d) % n; w = pow(s, -1, n); (s, (z * w * g + r * w * q) % n == r) evaluates to (95, True)"@en ; chx:input "n = 101; g = 7; d = 17; k = 29; z = 11; q = d * g % n; r = k * g % n; s = pow(k, -1, n) * (z + r * d) % n; w = pow(s, -1, n); (s, (z * w * g + r * w * q) % n == r)" ; chx:output "(95, True)" .
chx:X_ToyEcdsaCheck rd:hasIOExample chx:IO_ToyEcdsaCheck .
chx:X_OtherValidS a owl:NamedIndividual, chx:OtherValidS ; rdfs:label "s and n - s both verify, only one is low"@en ; skos:definition "If s is a valid ECDSA value then n - s is valid too, and exactly one of the two lies in the lower half of the range that BIP146 asks for."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_OtherValidS a owl:NamedIndividual, rd:IOExample ; rdfs:label "n = 101; s = 30; (n - s, s <= n // 2, n - s <= n // 2) evaluates to (71, True, False)"@en ; chx:input "n = 101; s = 30; (n - s, s <= n // 2, n - s <= n // 2)" ; chx:output "(71, True, False)" .
chx:X_OtherValidS rd:hasIOExample chx:IO_OtherValidS .
chx:X_DerPadding a owl:NamedIndividual, chx:DerPadding ; rdfs:label "a 33-byte R makes a 71-byte DER body"@en ; skos:definition "A DER integer is signed, so an R whose first byte is 0x88 or higher needs a leading zero byte, which makes the book's signature 71 bytes before the hash type byte and 72 with it."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_DerPadding a owl:NamedIndividual, rd:IOExample ; rdfs:label "rtop = 136; rlen = 32; slen = 32; pad = int(rtop >= 128); body = 2 + rlen + pad + 2 + slen; (pad, body + 2, body + 3) evaluates to (1, 71, 72)"@en ; chx:input "rtop = 136; rlen = 32; slen = 32; pad = int(rtop >= 128); body = 2 + rlen + pad + 2 + slen; (pad, body + 2, body + 3)" ; chx:output "(1, 71, 72)" .
chx:X_DerPadding rd:hasIOExample chx:IO_DerPadding .
chx:X_FlagByte a owl:NamedIndividual, chx:FlagByte ; rdfs:label "SINGLE with ANYONECANPAY is the byte 0x83"@en ; skos:definition "The flag byte is the base value 1, 2 or 3 combined by bitwise OR with 0x80 for ANYONECANPAY, so 0x83 means SINGLE together with ANYONECANPAY."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_FlagByte a owl:NamedIndividual, rd:IOExample ; rdfs:label "base = 3; acp = 1; flag = base + 128 * acp; (flag, flag & 3, flag & 128 != 0) evaluates to (131, 3, True)"@en ; chx:input "base = 3; acp = 1; flag = base + 128 * acp; (flag, flag & 3, flag & 128 != 0)" ; chx:output "(131, 3, True)" .
chx:X_FlagByte rd:hasIOExample chx:IO_FlagByte .
chx:X_SingleBugIndexes a owl:NamedIndividual, chx:SingleBugIndexes ; rdfs:label "which inputs of 3 have no output to sign"@en ; skos:definition "With SIGHASH_SINGLE an input whose index is not smaller than the number of outputs has no output to sign, which is the case that the legacy algorithm answers with the number one."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_SingleBugIndexes a owl:NamedIndividual, rd:IOExample ; rdfs:label "inputs = 3; outputs = 2; (inputs > outputs, [i for i in range(inputs) if i >= outputs]) evaluates to (True, [2])"@en ; chx:input "inputs = 3; outputs = 2; (inputs > outputs, [i for i in range(inputs) if i >= outputs])" ; chx:output "(True, [2])" .
chx:X_SingleBugIndexes rd:hasIOExample chx:IO_SingleBugIndexes .
chx:X_HashedBytesGrowth a owl:NamedIndividual, chx:HashedBytesGrowth ; rdfs:label "doubling the inputs roughly quadruples the bytes hashed"@en ; skos:definition "If each of n signatures hashes about the whole transaction, and the transaction grows with n, the bytes hashed grow with n squared: 20 inputs cost about 3.9 times what 10 inputs cost."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_HashedBytesGrowth a owl:NamedIndividual, rd:IOExample ; rdfs:label "n = 10; per = 148; fixed = 100; h = lambda k: k * (k * per + fixed); (h(n), h(2 * n), round(h(2 * n) / h(n), 2)) evaluates to (15800, 61200, 3.87)"@en ; chx:input "n = 10; per = 148; fixed = 100; h = lambda k: k * (k * per + fixed); (h(n), h(2 * n), round(h(2 * n) / h(n), 2))" ; chx:output "(15800, 61200, 3.87)" .
chx:X_HashedBytesGrowth rd:hasIOExample chx:IO_HashedBytesGrowth .
chx:X_SlowSigops a owl:NamedIndividual, chx:SlowSigops ; rdfs:label "25 seconds for 5,569 signature operations"@en ; skos:definition "BIP143 reports that a block of 1 MB takes about 2 seconds to verify but a 1 MB transaction with 5,569 signature operations may take 25 seconds, about 4.5 milliseconds for each operation."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_SlowSigops a owl:NamedIndividual, rd:IOExample ; rdfs:label "sigops = 5569; secs = 25; block = 2; (round(secs / block, 1), round(secs * 1000 / sigops, 1)) evaluates to (12.5, 4.5)"@en ; chx:input "sigops = 5569; secs = 25; block = 2; (round(secs / block, 1), round(secs * 1000 / sigops, 1))" ; chx:output "(12.5, 4.5)" .
chx:X_SlowSigops rd:hasIOExample chx:IO_SlowSigops .
chx:X_SigopCapInputs a owl:NamedIndividual, chx:SigopCapInputs ; rdfs:label "a cap of 2,500 operations, 2 per input"@en ; skos:definition "If every input of a standard transaction executes 2 legacy signature operations, the cap of 2,500 allows at most 1,250 such inputs."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_SigopCapInputs a owl:NamedIndividual, rd:IOExample ; rdfs:label "cap = 2500; per = 2; (cap // per, cap % per) evaluates to (1250, 0)"@en ; chx:input "cap = 2500; per = 2; (cap // per, cap % per)" ; chx:output "(1250, 0)" .
chx:X_SigopCapInputs rd:hasIOExample chx:IO_SigopCapInputs .
chx:X_LowRTries a owl:NamedIndividual, chx:LowRTries ; rdfs:label "the chance to find a low R within 8 attempts"@en ; skos:definition "Because a low R is a first byte below 0x80, each attempt succeeds with a chance of one half, so 8 attempts succeed with a chance of 0.9961 and at most 256 values of the counter need to be considered."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_LowRTries a owl:NamedIndividual, rd:IOExample ; rdfs:label "tries = 8; (round(1 - 0.5 ** tries, 4), 2 ** tries) evaluates to (0.9961, 256)"@en ; chx:input "tries = 8; (round(1 - 0.5 ** tries, 4), 2 ** tries)" ; chx:output "(0.9961, 256)" .
chx:X_LowRTries rd:hasIOExample chx:IO_LowRTries .
chx:X_SchnorrSavings a owl:NamedIndividual, chx:SchnorrSavings ; rdfs:label "9 bytes saved for each input of 3"@en ; skos:definition "A schnorr signature of 64 bytes with a 32-byte key replaces an ECDSA signature of 72 bytes with a 33-byte key, which saves 9 bytes of witness for each input and 27 for 3 inputs."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_SchnorrSavings a owl:NamedIndividual, rd:IOExample ; rdfs:label "inputs = 3; ecdsa = 72; schnorr = 64; per = (ecdsa + 33) - (schnorr + 32); (per, per * inputs, per * inputs / 4) evaluates to (9, 27, 6.75)"@en ; chx:input "inputs = 3; ecdsa = 72; schnorr = 64; per = (ecdsa + 33) - (schnorr + 32); (per, per * inputs, per * inputs / 4)" ; chx:output "(9, 27, 6.75)" .
chx:X_SchnorrSavings rd:hasIOExample chx:IO_SchnorrSavings .
chx:X_FiatShamirIntegers a owl:NamedIndividual, chx:FiatShamirIntegers ; rdfs:label "one round of the identity proof with integers modulo 101"@en ; skos:definition "With the response s = k + e x, the verifier's check s g = r + e X holds, and with a different response it would fail."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_FiatShamirIntegers a owl:NamedIndividual, rd:IOExample ; rdfs:label "n = 101; g = 7; x = 12; k = 6; e = 9; big_x = x * g % n; big_r = k * g % n; s = (k + e * x) % n; (s, s * g % n == (big_r + e * big_x) % n) evaluates to (13, True)"@en ; chx:input "n = 101; g = 7; x = 12; k = 6; e = 9; big_x = x * g % n; big_r = k * g % n; s = (k + e * x) % n; (s, s * g % n == (big_r + e * big_x) % n)" ; chx:output "(13, True)" .
chx:X_FiatShamirIntegers rd:hasIOExample chx:IO_FiatShamirIntegers .
chx:X_KeyCancellationToy a owl:NamedIndividual, chx:KeyCancellationToy ; rdfs:label "Bob's key hides Alice's key and he signs alone"@en ; skos:definition "If Bob announces his key as m g minus Alice's key, the sum of the two keys is m g, a key that Bob alone controls."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_KeyCancellationToy a owl:NamedIndividual, rd:IOExample ; rdfs:label "n = 101; g = 7; a = 12; m = 5; xa = a * g % n; xm = (m * g - xa) % n; agg = (xa + xm) % n; (agg == m * g % n, agg) evaluates to (True, 35)"@en ; chx:input "n = 101; g = 7; a = 12; m = 5; xa = a * g % n; xm = (m * g - xa) % n; agg = (xa + xm) % n; (agg == m * g % n, agg)" ; chx:output "(True, 35)" .
chx:X_KeyCancellationToy rd:hasIOExample chx:IO_KeyCancellationToy .
chx:X_ShamirModulus a owl:NamedIndividual, chx:ShamirModulus ; rdfs:label "secret 7 shared as a line modulo 101, any two shares return it"@en ; skos:definition "A secret of 7 and a slope of 3 give the shares 10, 13 and 16 at x = 1, 2 and 3 modulo 101, and the first and third shares return the secret 7."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_ShamirModulus a owl:NamedIndividual, rd:IOExample ; rdfs:label "p = 101; s = 7; a = 3; y = [(s + a * x) % p for x in (1, 2, 3)]; slope = (y[2] - y[0]) * pow(3 - 1, -1, p) % p; (y, (y[0] - slope) % p) evaluates to ([10, 13, 16], 7)"@en ; chx:input "p = 101; s = 7; a = 3; y = [(s + a * x) % p for x in (1, 2, 3)]; slope = (y[2] - y[0]) * pow(3 - 1, -1, p) % p; (y, (y[0] - slope) % p)" ; chx:output "([10, 13, 16], 7)" .
chx:X_ShamirModulus rd:hasIOExample chx:IO_ShamirModulus .
chx:X_NonceReuseRecovery a owl:NamedIndividual, chx:NonceReuseRecovery ; rdfs:label "two signatures with one nonce reveal the key 17"@en ; skos:definition "Two ECDSA signatures that use the same nonce k give k as the difference of the digests divided by the difference of the signature values, and then the private key."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_NonceReuseRecovery a owl:NamedIndividual, rd:IOExample ; rdfs:label "n = 101; d = 17; k = 29; r = 44; z1 = 11; z2 = 23; s1 = pow(k, -1, n) * (z1 + r * d) % n; s2 = pow(k, -1, n) * (z2 + r * d) % n; kk = (z1 - z2) * pow(s1 - s2, -1, n) % n; (kk, (s1 * kk - z1) * pow(r, -1, n) % n) evaluates to (29, 17)"@en ; chx:input "n = 101; d = 17; k = 29; r = 44; z1 = 11; z2 = 23; s1 = pow(k, -1, n) * (z1 + r * d) % n; s2 = pow(k, -1, n) * (z2 + r * d) % n; kk = (z1 - z2) * pow(s1 - s2, -1, n) % n; (kk, (s1 * kk - z1) * pow(r, -1, n) % n)" ; chx:output "(29, 17)" .
chx:X_NonceReuseRecovery rd:hasIOExample chx:IO_NonceReuseRecovery .
chx:X_PatentTermYears a owl:NamedIndividual, chx:PatentTermYears ; rdfs:label "filed 1990, granted 1991: the term ends in 2010"@en ; skos:definition "A patent filed in 1990 and granted in 1991 ran to the greater of 20 years from filing, 2010, and 17 years from grant, 2008, which is 2010."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_PatentTermYears a owl:NamedIndividual, rd:IOExample ; rdfs:label "filed = 1990; granted = 1991; (max(filed + 20, granted + 17), filed + 20, granted + 17) evaluates to (2010, 2010, 2008)"@en ; chx:input "filed = 1990; granted = 1991; (max(filed + 20, granted + 17), filed + 20, granted + 17)" ; chx:output "(2010, 2010, 2008)" .
chx:X_PatentTermYears rd:hasIOExample chx:IO_PatentTermYears .
chx:X_RetargetBoundary a owl:NamedIndividual, chx:RetargetBoundary ; rdfs:label "taproot's activation height is a multiple of 2016"@en ; skos:definition "Block 709,632 is exactly 352 retarget periods of 2,016 blocks after the genesis block, and the first taproot spend followed it by 3 blocks."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_RetargetBoundary a owl:NamedIndividual, rd:IOExample ; rdfs:label "act = 709632; first = 709635; p = 2016; (act // p, act % p, first - act) evaluates to (352, 0, 3)"@en ; chx:input "act = 709632; first = 709635; p = 2016; (act // p, act % p, first - act)" ; chx:output "(352, 0, 3)" .
chx:X_RetargetBoundary rd:hasIOExample chx:IO_RetargetBoundary .
chx:X_TaggedPrefixBlock a owl:NamedIndividual, chx:TaggedPrefixBlock ; rdfs:label "two hashes of the tag fill one 64-byte hash block"@en ; skos:definition "BIP340 prefixes the data with the hash of the tag twice, which is 64 bytes and exactly one block of SHA-256, so an implementation can precompute it."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_TaggedPrefixBlock a owl:NamedIndividual, rd:IOExample ; rdfs:label "import hashlib; reps = 2; h = hashlib.sha256(b'BIP0340/challenge').digest(); (len(h * reps), len(h * reps) % 64 == 0) evaluates to (64, True)"@en ; chx:input "import hashlib; reps = 2; h = hashlib.sha256(b'BIP0340/challenge').digest(); (len(h * reps), len(h * reps) % 64 == 0)" ; chx:output "(64, True)" .
chx:X_TaggedPrefixBlock rd:hasIOExample chx:IO_TaggedPrefixBlock .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 8 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch08/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 8 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which examples, figures and statements of the chapter can be reproduced by execution, by the standards' own test vectors and by Bitcoin Core, and what does the execution give?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What in the chapter differs from the standards or from Bitcoin Core as it is now, or has changed status since the book went to print, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 8 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from Mastering Bitcoin 3rd edition's chapter 8 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0401/ch08/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.6, installed with uv on 2026-10-21."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_0_0.py" .

