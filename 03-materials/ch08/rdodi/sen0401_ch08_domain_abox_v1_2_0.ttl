chx:IO_DerLayout a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.book_der_sample() evaluates to [72, 69, '30', '45', '21', '20', '01', 9, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.book_der_sample()" ; chx:output "[72, 69, '30', '45', '21', '20', '01', 9, True]" .
chx:X_DerLayout rd:hasIOExample chx:IO_DerLayout .
