chx:X_VerifierInputs a owl:NamedIndividual, chx:VerifierInputs ; rdfs:label "message, public key, signature"@en ; skos:definition "A verifier needs exactly three inputs, the message, the public key and the signature, and the answer is yes only when all three belong together."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_VerifierInputs a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.verifier_inputs() evaluates to [True, False, False, False]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.verifier_inputs()" ; chx:output "[True, False, False, False]" .
chx:X_VerifierInputs rd:hasIOExample chx:IO_VerifierInputs .
chx:X_MessageIntegrity a owl:NamedIndividual, chx:MessageIntegrity ; rdfs:label "one flipped bit in the message"@en ; skos:definition "A signature covers its message, so changing even one bit of the message makes the signature fail."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_MessageIntegrity a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.tampered_message_fails() evaluates to False"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.tampered_message_fails()" ; chx:output "False" .
chx:X_MessageIntegrity rd:hasIOExample chx:IO_MessageIntegrity .
chx:X_KeyBinding a owl:NamedIndividual, chx:KeyBinding ; rdfs:label "a signature checked against a neighbour's key"@en ; skos:definition "A signature verifies only against the public key that matches the private key that made it, which is what ties a spend to the owner of the coins."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_KeyBinding a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.wrong_key_fails() evaluates to False"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.wrong_key_fails()" ; chx:output "False" .
chx:X_KeyBinding rd:hasIOExample chx:IO_KeyBinding .
chx:X_ScalarModulus a owl:NamedIndividual, chx:ScalarModulus ; rdfs:label "the group order n against the field prime p"@en ; skos:definition "The numbers in a signature equation (nonce, challenge, private key, response) are reduced modulo the order n of the curve's group, not modulo the field prime p that the book names."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_ScalarModulus a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.scalar_modulus() evaluates to [True, False, True, True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.scalar_modulus()" ; chx:output "[True, False, True, True, True]" .
chx:X_ScalarModulus rd:hasIOExample chx:IO_ScalarModulus .
chx:X_SignRoundtrip a owl:NamedIndividual, chx:SignRoundtrip ; rdfs:label "sign, then verify"@en ; skos:definition "Signing with a private key and verifying with the public key returns yes, the basic round trip every signature scheme must satisfy."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_SignRoundtrip a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.roundtrip() evaluates to True"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.roundtrip()" ; chx:output "True" .
chx:X_SignRoundtrip rd:hasIOExample chx:IO_SignRoundtrip .
chx:X_InputIndependence a owl:NamedIndividual, chx:InputIndependence ; rdfs:label "two owners, two inputs, one transaction"@en ; skos:definition "Each input of a transaction is signed separately, so owners of different inputs can sign the same transaction one after the other and neither signature can be moved to the other input."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_InputIndependence a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.two_parties_two_inputs() evaluates to [True, True, False, False]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.two_parties_two_inputs()" ; chx:output "[True, True, False, False]" .
chx:X_InputIndependence rd:hasIOExample chx:IO_InputIndependence .
chx:X_DigestCommitment a owl:NamedIndividual, chx:DigestCommitment ; rdfs:label "changing an output changes the signed hash"@en ; skos:definition "What a signature signs is a hash computed from selected fields of the transaction, so changing a committed field changes the hash and breaks the signature."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_DigestCommitment a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.sighash_digest_changes_with_output() evaluates to [True, False]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.sighash_digest_changes_with_output()" ; chx:output "[True, False]" .
chx:X_DigestCommitment rd:hasIOExample chx:IO_DigestCommitment .
chx:X_FlagValues a owl:NamedIndividual, chx:FlagValues ; rdfs:label "ALL = 1, NONE = 2, SINGLE = 3, ANYONECANPAY = 0x80"@en ; skos:definition "The three base flags are the numbers 1, 2 and 3 and ANYONECANPAY adds 0x80, which gives the six combinations 1, 2, 3, 129, 130 and 131."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_FlagValues a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.flag_values() evaluates to [1, 2, 3, 128, 129, 130, 131]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.flag_values()" ; chx:output "[1, 2, 3, 128, 129, 130, 131]" .
chx:X_FlagValues rd:hasIOExample chx:IO_FlagValues .
chx:X_CoreConstants a owl:NamedIndividual, chx:CoreConstants ; rdfs:label "interpreter.h of Bitcoin Core"@en ; skos:definition "Bitcoin Core's header declares SIGHASH_ALL, NONE, SINGLE and ANYONECANPAY as 1, 2, 3 and 0x80 and adds SIGHASH_DEFAULT = 0 for taproot only."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_CoreConstants a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_header_flags() evaluates to [1, 2, 3, 128, 0]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_header_flags()" ; chx:output "[1, 2, 3, 128, 0]" .
chx:X_CoreConstants rd:hasIOExample chx:IO_CoreConstants .
chx:X_TaprootHashTypes a owl:NamedIndividual, chx:TaprootHashTypes ; rdfs:label "the seven valid values"@en ; skos:definition "A taproot signature may use only the hash types 0x00, 0x01, 0x02, 0x03, 0x81, 0x82 and 0x83, and every other byte value makes the signature invalid."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_TaprootHashTypes a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.bip341_valid_hash_types() evaluates to ['0x0', '0x1', '0x2', '0x3', '0x81', '0x82', '0x83']"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.bip341_valid_hash_types()" ; chx:output "['0x0', '0x1', '0x2', '0x3', '0x81', '0x82', '0x83']" .
chx:X_TaprootHashTypes rd:hasIOExample chx:IO_TaprootHashTypes .
chx:X_AnyprevoutValues a owl:NamedIndividual, chx:AnyprevoutValues ; rdfs:label "0x40 and 0xc0 of BIP118"@en ; skos:definition "The proposal BIP118 would add the flags SIGHASH_ANYPREVOUT = 0x40 and SIGHASH_ANYPREVOUTANYSCRIPT = 0xc0 to tapscript, and it is still only a draft."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_AnyprevoutValues a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.anyprevout_values() evaluates to [64, 192]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.anyprevout_values()" ; chx:output "[64, 192]" .
chx:X_AnyprevoutValues rd:hasIOExample chx:IO_AnyprevoutValues .
chx:X_CommitmentMatrix a owl:NamedIndividual, chx:CommitmentMatrix ; rdfs:label "which fields change the hash"@en ; skos:definition "A matrix of five probes shows what each flag commits to: changing a field that the flag covers changes the hash of the signed input, changing one it does not cover leaves it unchanged."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_CommitmentMatrix a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.commitments_table() evaluates to {'0x1': [1, 1, 1, 1, 1], '0x2': [1, 0, 0, 0, 1], '0x3': [1, 0, 1, 0, 1], '0x81': [0, 0, 1, 1, 1], '0x82': [0, 0, 0, 0, 1], '0x83': [0, 0, 1, 0, 1]}"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.commitments_table()" ; chx:output "{'0x1': [1, 1, 1, 1, 1], '0x2': [1, 0, 0, 0, 1], '0x3': [1, 0, 1, 0, 1], '0x81': [0, 0, 1, 1, 1], '0x82': [0, 0, 0, 0, 1], '0x83': [0, 0, 1, 0, 1]}" .
chx:X_CommitmentMatrix rd:hasIOExample chx:IO_CommitmentMatrix .
chx:X_CoreSignatureSurvival a owl:NamedIndividual, chx:CoreSignatureSurvival ; rdfs:label "does Core's own signature survive a change"@en ; skos:definition "Signatures made by Bitcoin Core 31.1 with each flag survive exactly the changes the flag allows: NONE survives any change of outputs and SINGLE only a change of a different output."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_CoreSignatureSurvival a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_signature_survives_changes() evaluates to {'ALL': [False, False], 'NONE': [True, True], 'SINGLE': [False, True], 'ALL|ANYONECANPAY': [False, False], 'NONE|ANYONECANPAY': [True, True], 'SINGLE|ANYONECANPAY': [False, True]}"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_signature_survives_changes()" ; chx:output "{'ALL': [False, False], 'NONE': [True, True], 'SINGLE': [False, True], 'ALL|ANYONECANPAY': [False, False], 'NONE|ANYONECANPAY': [True, True], 'SINGLE|ANYONECANPAY': [False, True]}" .
chx:X_CoreSignatureSurvival rd:hasIOExample chx:IO_CoreSignatureSurvival .
chx:X_AnyoneCanPayEffect a owl:NamedIndividual, chx:AnyoneCanPayEffect ; rdfs:label "other inputs may change"@en ; skos:definition "With ANYONECANPAY a signature stays valid when the other inputs are replaced, which is what lets strangers add inputs to a crowdfunding transaction."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_AnyoneCanPayEffect a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_anyonecanpay_survives_other_input_change() evaluates to {'ALL': False, 'NONE': False, 'SINGLE': False, 'ALL|ANYONECANPAY': True, 'NONE|ANYONECANPAY': True, 'SINGLE|ANYONECANPAY': True}"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_anyonecanpay_survives_other_input_change()" ; chx:output "{'ALL': False, 'NONE': False, 'SINGLE': False, 'ALL|ANYONECANPAY': True, 'NONE|ANYONECANPAY': True, 'SINGLE|ANYONECANPAY': True}" .
chx:X_AnyoneCanPayEffect rd:hasIOExample chx:IO_AnyoneCanPayEffect .
chx:X_CoreFlagBytes a owl:NamedIndividual, chx:CoreFlagBytes ; rdfs:label "the last byte of each signature"@en ; skos:definition "The byte at the end of a signature Core made is the flag that was requested, and a taproot signature made with the default flag has 64 bytes and no flag byte."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_CoreFlagBytes a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_flag_bytes() evaluates to {'ALL': '0x1', 'NONE': '0x2', 'SINGLE': '0x3', 'ALL|ANYONECANPAY': '0x81', 'NONE|ANYONECANPAY': '0x82', 'SINGLE|ANYONECANPAY': '0x83', 'taproot ALL': [65, '0x1'], 'taproot NONE': [65, '0x2'], 'taproot SINGLE': [65, '0x3'], 'taproot ALL|ANYONECANPAY': [65, '0x81'], 'taproot NONE|ANYONECANPAY': [65, '0x82'], 'taproot SINGLE|ANYONECANPAY': [65, '0x83'], 'taproot DEFAULT': [64, None]}"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_flag_bytes()" ; chx:output "{'ALL': '0x1', 'NONE': '0x2', 'SINGLE': '0x3', 'ALL|ANYONECANPAY': '0x81', 'NONE|ANYONECANPAY': '0x82', 'SINGLE|ANYONECANPAY': '0x83', 'taproot ALL': [65, '0x1'], 'taproot NONE': [65, '0x2'], 'taproot SINGLE': [65, '0x3'], 'taproot ALL|ANYONECANPAY': [65, '0x81'], 'taproot NONE|ANYONECANPAY': [65, '0x82'], 'taproot SINGLE|ANYONECANPAY': [65, '0x83'], 'taproot DEFAULT': [64, None]}" .
chx:X_CoreFlagBytes rd:hasIOExample chx:IO_CoreFlagBytes .
chx:X_CoreSignaturesVerify a owl:NamedIndividual, chx:CoreSignaturesVerify ; rdfs:label "75 of 75 signatures"@en ; skos:definition "Every one of the 75 signatures in the 25 transactions that Bitcoin Core 31.1 signed verifies with the chapter's own implementation of all four signature hash algorithms."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_CoreSignaturesVerify a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_flags_all_verify() evaluates to (75, 75)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_flags_all_verify()" ; chx:output "(75, 75)" .
chx:X_CoreSignaturesVerify rd:hasIOExample chx:IO_CoreSignaturesVerify .
chx:X_SingleBug a owl:NamedIndividual, chx:SingleBug ; rdfs:label "a hash equal to the number one"@en ; skos:definition "In the legacy algorithm, SIGHASH_SINGLE on an input that has no output of the same index does not sign a hash of the transaction but the number one."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_SingleBug a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.single_bug_equals_uint256_one() evaluates to True"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.single_bug_equals_uint256_one()" ; chx:output "True" .
chx:X_SingleBug rd:hasIOExample chx:IO_SingleBug .
chx:X_CoreRefusesSingleBug a owl:NamedIndividual, chx:CoreRefusesSingleBug ; rdfs:label "Bitcoin Core will not sign it"@en ; skos:definition "Bitcoin Core 31.1 leaves such an input unsigned instead of creating the signature of the number one."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_CoreRefusesSingleBug a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_refuses_single_bug_signature() evaluates to [False, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_refuses_single_bug_signature()" ; chx:output "[False, True]" .
chx:X_CoreRefusesSingleBug rd:hasIOExample chx:IO_CoreRefusesSingleBug .
chx:X_SighashVectors a owl:NamedIndividual, chx:SighashVectors ; rdfs:label "Bitcoin Core's 500 vectors"@en ; skos:definition "The chapter's legacy signature hash agrees with Bitcoin Core's own test file for all 500 vectors, which cover eight kinds of hash types."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_SighashVectors a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.sighash_json_vectors() evaluates to (500, 500, 8)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.sighash_json_vectors()" ; chx:output "(500, 500, 8)" .
chx:X_SighashVectors rd:hasIOExample chx:IO_SighashVectors .
chx:X_ToyProtocol a owl:NamedIndividual, chx:ToyProtocol ; rdfs:label "x = 3, G = 5, k = 7, e = 11 with plain integers"@en ; skos:definition "With ordinary integers the identification protocol works, s = k + e x satisfies s G = k G + e (x G), but anybody can divide by G, so the private key is exposed."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_ToyProtocol a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.toy() evaluates to [15, 35, 40, 200, 165, True, 3]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.toy()" ; chx:output "[15, 35, 40, 200, 165, True, 3]" .
chx:X_ToyProtocol rd:hasIOExample chx:IO_ToyProtocol .
chx:X_IdentityRound a owl:NamedIndividual, chx:IdentityRound ; rdfs:label "the three-move proof on secp256k1"@en ; skos:definition "On the real curve the same three moves (commitment kG, challenge e, response s) are checked by one equation, sG = kG + eX, and it holds."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_IdentityRound a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.identity_round_secp256k1() evaluates to True"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.identity_round_secp256k1()" ; chx:output "True" .
chx:X_IdentityRound rd:hasIOExample chx:IO_IdentityRound .
chx:X_WrongResponse a owl:NamedIndividual, chx:WrongResponse ; rdfs:label "s plus one"@en ; skos:definition "If the response s is changed by even one unit, the verification equation no longer holds, so a prover without the private key cannot answer."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_WrongResponse a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.identity_wrong_s() evaluates to False"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.identity_wrong_s()" ; chx:output "False" .
chx:X_WrongResponse rd:hasIOExample chx:IO_WrongResponse .
chx:X_ChallengeOrder a owl:NamedIndividual, chx:ChallengeOrder ; rdfs:label "told the challenge in advance"@en ; skos:definition "A prover who learns the challenge before committing can pass without the private key, which is why the commitment must come first."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_ChallengeOrder a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.impersonation_without_x() evaluates to True"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.impersonation_without_x()" ; chx:output "True" .
chx:X_ChallengeOrder rd:hasIOExample chx:IO_ChallengeOrder .
chx:X_FiatShamirSignature a owl:NamedIndividual, chx:FiatShamirSignature ; rdfs:label "a hash in place of the verifier"@en ; skos:definition "The Fiat-Shamir transform replaces the verifier's random challenge by a hash of the commitment, the key and the message, which turns the interactive proof into a signature on that message."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_FiatShamirSignature a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.fiat_shamir_signature() evaluates to [True, False]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.fiat_shamir_signature()" ; chx:output "[True, False]" .
chx:X_FiatShamirSignature rd:hasIOExample chx:IO_FiatShamirSignature .
chx:X_Bip340Vectors a owl:NamedIndividual, chx:Bip340Vectors ; rdfs:label "19 official test vectors"@en ; skos:definition "The chapter's BIP340 implementation matches all 19 vectors of the BIP, verifying 19 and reproducing the signature of each of the 8 vectors that give a secret key."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_Bip340Vectors a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.bip340_vectors() evaluates to [19, 19, 8, 8]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.bip340_vectors()" ; chx:output "[19, 19, 8, 8]" .
chx:X_Bip340Vectors rd:hasIOExample chx:IO_Bip340Vectors .
chx:X_SignatureSizes a owl:NamedIndividual, chx:SignatureSizes ; rdfs:label "64 or 65 bytes"@en ; skos:definition "A BIP340 signature has 64 bytes, the 32-byte x coordinate of the nonce point followed by the 32-byte scalar s, and in taproot one more byte may name a hash type."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_SignatureSizes a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.signature_sizes() evaluates to [(64, True), (65, True)]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.signature_sizes()" ; chx:output "[(64, True), (65, True)]" .
chx:X_SignatureSizes rd:hasIOExample chx:IO_SignatureSizes .
chx:X_XOnlyKey a owl:NamedIndividual, chx:XOnlyKey ; rdfs:label "32-byte keys with an even y"@en ; skos:definition "A BIP340 public key is only the 32-byte x coordinate, and the signer negates the private key when the point's y coordinate is odd so that a key and its negative give the same public key."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_XOnlyKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.xonly_even_y() evaluates to [32, 0, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.xonly_even_y()" ; chx:output "[32, 0, True]" .
chx:X_XOnlyKey rd:hasIOExample chx:IO_XOnlyKey .
chx:X_TaggedHash a owl:NamedIndividual, chx:TaggedHash ; rdfs:label "SHA256(tag) twice as a prefix"@en ; skos:definition "BIP340 hashes with a tag: the hash of the tag is computed once and put twice in front of the data, so that hashes made for different purposes cannot be confused."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_TaggedHash a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.tagged_hash_prefix_len() evaluates to [64, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.tagged_hash_prefix_len()" ; chx:output "[64, True]" .
chx:X_TaggedHash rd:hasIOExample chx:IO_TaggedHash .
chx:X_DefaultNonce a owl:NamedIndividual, chx:DefaultNonce ; rdfs:label "same input, same signature"@en ; skos:definition "The default BIP340 signing function derives its nonce from the key, the message and auxiliary data, so with the same inputs it gives the same signature and with other auxiliary data another one."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_DefaultNonce a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.bip340_default_signing_deterministic() evaluates to [True, True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.bip340_default_signing_deterministic()" ; chx:output "[True, True, True]" .
chx:X_DefaultNonce rd:hasIOExample chx:IO_DefaultNonce .
chx:X_KeyPrefixing a owl:NamedIndividual, chx:KeyPrefixing ; rdfs:label "hash(R, P, m) against hash(R, m)"@en ; skos:definition "Including the public key in the challenge stops an attacker who knows a signature for one key from deriving a signature for a related key such as a BIP32 child key."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_KeyPrefixing a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.related_key_attack() evaluates to [True, False]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.related_key_attack()" ; chx:output "[True, False]" .
chx:X_KeyPrefixing rd:hasIOExample chx:IO_KeyPrefixing .
chx:X_Linearity a owl:NamedIndividual, chx:Linearity ; rdfs:label "f(x + y + z) = f(x) + f(y) + f(z)"@en ; skos:definition "Multiplying the generator by a scalar is additive and homogeneous, which is why signatures and keys of several signers can be added."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_Linearity a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.linearity() evaluates to [True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.linearity()" ; chx:output "[True, True]" .
chx:X_Linearity rd:hasIOExample chx:IO_Linearity .
chx:X_BatchVerification a owl:NamedIndividual, chx:BatchVerification ; rdfs:label "nine signatures, one equation"@en ; skos:definition "Because the equation is linear, many signatures can be verified together as one random combination of their equations, and one bad signature in the batch makes the combined check fail."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_BatchVerification a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.batch_equation() evaluates to [9, True, False]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.batch_equation()" ; chx:output "[9, True, False]" .
chx:X_BatchVerification rd:hasIOExample chx:IO_BatchVerification .
chx:X_NaiveMultisig a owl:NamedIndividual, chx:NaiveMultisig ; rdfs:label "two keys added, two responses added"@en ; skos:definition "Two signers can add their public keys and their signatures into one key and one signature that verifies, which looks like the signature of a single person."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_NaiveMultisig a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.naive_multisig() evaluates to [True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.naive_multisig()" ; chx:output "[True, True]" .
chx:X_NaiveMultisig rd:hasIOExample chx:IO_NaiveMultisig .
chx:X_KeyCancellation a owl:NamedIndividual, chx:KeyCancellation ; rdfs:label "Bob publishes zG minus yG"@en ; skos:definition "In the naive protocol the last signer to publish a key can choose it as their key minus the sum of the others, and then control the aggregate alone."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_KeyCancellation a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.key_cancellation() evaluates to [True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.key_cancellation()" ; chx:output "[True, True]" .
chx:X_KeyCancellation rd:hasIOExample chx:IO_KeyCancellation .
chx:X_MuSigKeyAgg a owl:NamedIndividual, chx:MuSigKeyAgg ; rdfs:label "BIP327's four key aggregation vectors"@en ; skos:definition "The MuSig2 key aggregation of BIP327 weights each key by a coefficient derived from all the keys, and the chapter's implementation reproduces the BIP's test vectors."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_MuSigKeyAgg a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.musig2_keyagg_vectors() evaluates to [4, 4]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.musig2_keyagg_vectors()" ; chx:output "[4, 4]" .
chx:X_MuSigKeyAgg rd:hasIOExample chx:IO_MuSigKeyAgg .
chx:X_MuSigBlocksCancellation a owl:NamedIndividual, chx:MuSigBlocksCancellation ; rdfs:label "the same attack against MuSig2 keys"@en ; skos:definition "With BIP327's coefficients the aggregate of Alice's key and Bob's cancelling key is no longer Bob's key, so Bob cannot sign alone."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_MuSigBlocksCancellation a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.musig2_blocks_cancellation() evaluates to False"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.musig2_blocks_cancellation()" ; chx:output "False" .
chx:X_MuSigBlocksCancellation rd:hasIOExample chx:IO_MuSigBlocksCancellation .
chx:X_ShamirSharing a owl:NamedIndividual, chx:ShamirSharing ; rdfs:label "a 2-of-3 polynomial"@en ; skos:definition "Shamir's secret sharing hides a secret as the constant term of a polynomial and gives each holder one point, so that any two of three points rebuild the secret by interpolation."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_ShamirSharing a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.shamir_threshold() evaluates to [True, True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.shamir_threshold()" ; chx:output "[True, True, True]" .
chx:X_ShamirSharing rd:hasIOExample chx:IO_ShamirSharing .
chx:X_AnyTwoOfThree a owl:NamedIndividual, chx:AnyTwoOfThree ; rdfs:label "all three pairs rebuild 31337"@en ; skos:definition "Any two of the three shares give the same secret, here the number 31337."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_AnyTwoOfThree a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.shamir_any_two_of_three() evaluates to [31337, 31337, 31337]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.shamir_any_two_of_three()" ; chx:output "[31337, 31337, 31337]" .
chx:X_AnyTwoOfThree rd:hasIOExample chx:IO_AnyTwoOfThree .
chx:X_ShareSecrecy a owl:NamedIndividual, chx:ShareSecrecy ; rdfs:label "one share is consistent with every secret"@en ; skos:definition "A single share of a 2-of-3 sharing reveals nothing, because for any other secret there is a line through the same point."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_ShareSecrecy a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.single_share_hides_secret() evaluates to True"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.single_share_hides_secret()" ; chx:output "True" .
chx:X_ShareSecrecy rd:hasIOExample chx:IO_ShareSecrecy .
chx:X_ManipulationAttack a owl:NamedIndividual, chx:ManipulationAttack ; rdfs:label "Bob tells each that the other is away"@en ; skos:definition "In the book's simple threshold protocol a dishonest member can obtain the others' partial keys by claiming in turn that each of the others is unavailable."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_ManipulationAttack a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.shamir_manipulation() evaluates to [True, True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.shamir_manipulation()" ; chx:output "[True, True, True]" .
chx:X_ManipulationAttack rd:hasIOExample chx:IO_ManipulationAttack .
chx:X_EcdsaFormulas a owl:NamedIndividual, chx:EcdsaFormulas ; rdfs:label "s = k^-1 (hash(m) + x R) mod n"@en ; skos:definition "ECDSA signs with a random nonce k, takes R as the x coordinate of kG and computes s = k^-1 (hash + x R) modulo n; the verifier recomputes R from s, the hash and the public key."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_EcdsaFormulas a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.ecdsa_book_formulas() evaluates to [True, False, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.ecdsa_book_formulas()" ; chx:output "[True, False, True]" .
chx:X_EcdsaFormulas rd:hasIOExample chx:IO_EcdsaFormulas .
chx:X_SignatureMalleability a owl:NamedIndividual, chx:SignatureMalleability ; rdfs:label "(R, s) and (R, n - s)"@en ; skos:definition "For every valid ECDSA signature (R, s) the pair (R, n - s) is also valid for the same message, so a third party can change a signature without knowing the key."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_SignatureMalleability a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.malleability() evaluates to [True, True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.malleability()" ; chx:output "[True, True, True]" .
chx:X_SignatureMalleability rd:hasIOExample chx:IO_SignatureMalleability .
chx:X_LowSRule a owl:NamedIndividual, chx:LowSRule ; rdfs:label "always the smaller of s and n - s"@en ; skos:definition "The chapter's signer always returns the low s, so every signature it makes passes the strict DER and low-S rules, with lengths 70 or 71 bytes."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_LowSRule a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.lib_signature_low_s_and_strict() evaluates to [True, True, [70, 71]]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.lib_signature_low_s_and_strict()" ; chx:output "[True, True, [70, 71]]" .
chx:X_LowSRule rd:hasIOExample chx:IO_LowSRule .
