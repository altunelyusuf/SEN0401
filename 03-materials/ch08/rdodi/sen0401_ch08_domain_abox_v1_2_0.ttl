chx:X_TaprootAmounts a owl:NamedIndividual, chx:TaprootAmounts ; rdfs:label "all spent amounts, unless ANYONECANPAY"@en ; skos:definition "A taproot signature commits to the amounts of all inputs being spent, unless ANYONECANPAY is used, when it commits only to its own."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_TaprootAmounts a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.bip341_commits_to_all_spent_amounts() evaluates to [True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.bip341_commits_to_all_spent_amounts()" ; chx:output "[True, True]" .
chx:X_TaprootAmounts rd:hasIOExample chx:IO_TaprootAmounts .
chx:X_FirstTaprootSpend a owl:NamedIndividual, chx:FirstTaprootSpend ; rdfs:label "block 709,635 on 14 November 2021"@en ; skos:definition "The taproot key-path spend recorded as the first on the main chain has a one-element witness holding a 64-byte schnorr signature, which verifies with the chapter's code."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_FirstTaprootSpend a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.first_taproot_spend() evaluates to [709635, 1, 64, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.first_taproot_spend()" ; chx:output "[709635, 1, 64, True]" .
