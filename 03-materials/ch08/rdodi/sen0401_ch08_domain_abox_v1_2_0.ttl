chx:X_PolicyVerdicts a owl:NamedIndividual, chx:PolicyVerdicts ; rdfs:label "what the node's mempool says"@en ; skos:definition "Bitcoin Core 31.1 accepts a normal signature into its mempool and rejects a high-S signature, a non-minimal DER encoding and a signature of another message with a specific error each."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_PolicyVerdicts a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_policy_verdicts() evaluates to {'valid_low_s': [True, None], 'high_s': [False, 'mempool-script-verify-flag-failed (Non-canonical signature: S value is unnecessarily high)'], 'non_minimal_der': [False, 'mempool-script-verify-flag-failed (Non-canonical DER signature)'], 'signed_other_message': [False, 'mempool-script-verify-flag-failed (Signature must be zero for failed CHECK(MULTI)SIG operation)']}"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_policy_verdicts()" ; chx:output "{'valid_low_s': [True, None], 'high_s': [False, 'mempool-script-verify-flag-failed (Non-canonical signature: S value is unnecessarily high)'], 'non_minimal_der': [False, 'mempool-script-verify-flag-failed (Non-canonical DER signature)'], 'signed_other_message': [False, 'mempool-script-verify-flag-failed (Signature must be zero for failed CHECK(MULTI)SIG operation)']}" .
chx:X_PolicyVerdicts rd:hasIOExample chx:IO_PolicyVerdicts .
chx:X_StrictDerConsensus a owl:NamedIndividual, chx:StrictDerConsensus ; rdfs:label "mined in a block or not"@en ; skos:definition "A high-S signature is valid in a block, because low-S is only policy, while a signature that is not strict DER makes the block invalid, because strict DER is a consensus rule."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
