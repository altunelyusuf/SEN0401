chx:X_StrictDerConsensus rd:hasIOExample chx:IO_StrictDerConsensus .
chx:X_PolicyFlags a owl:NamedIndividual, chx:PolicyFlags ; rdfs:label "LOW_S, NULLFAIL, STRICTENC, DERSIG"@en ; skos:definition "Bitcoin Core's standard policy flags include the low-S, null-fail, strict encoding and DER signature checks."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_PolicyFlags a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.verify_flags_in_policy() evaluates to [True, True, True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.verify_flags_in_policy()" ; chx:output "[True, True, True, True]" .
chx:X_PolicyFlags rd:hasIOExample chx:IO_PolicyFlags .
chx:X_LegacySigopsCap a owl:NamedIndividual, chx:LegacySigopsCap ; rdfs:label "2,500 in policy since Core 30"@en ; skos:definition "Bitcoin Core 30.0 allows at most 2,500 potentially executed legacy signature operations in a standard transaction, the limit that BIP54 would make a consensus rule."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_LegacySigopsCap a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.sigops_limit_in_core_and_bip54() evaluates to [2500, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.sigops_limit_in_core_and_bip54()" ; chx:output "[2500, True]" .
chx:X_LegacySigopsCap rd:hasIOExample chx:IO_LegacySigopsCap .
chx:X_NonceReuse a owl:NamedIndividual, chx:NonceReuse ; rdfs:label "two payments, one k"@en ; skos:definition "If two ECDSA signatures from the same key use the same nonce k, anyone can compute k and then the private key from the two signatures."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_NonceReuse a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.nonce_reuse() evaluates to [True, True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.nonce_reuse()" ; chx:output "[True, True, True]" .
chx:X_NonceReuse rd:hasIOExample chx:IO_NonceReuse .
chx:X_DistinctNonces a owl:NamedIndividual, chx:DistinctNonces ; rdfs:label "the same formula with two different nonces"@en ; skos:definition "With two different nonces the same formula returns a number that is not the key, so the attack needs the repetition."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_DistinctNonces a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.nonce_not_reused_is_safe() evaluates to False"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.nonce_not_reused_is_safe()" ; chx:output "False" .
chx:X_DistinctNonces rd:hasIOExample chx:IO_DistinctNonces .
chx:X_Rfc6979Vector a owl:NamedIndividual, chx:Rfc6979Vector ; rdfs:label "the published P-256 test vector"@en ; skos:definition "The chapter's implementation of the nonce derivation of RFC 6979 reproduces the nonce printed in the RFC's appendix for the curve P-256."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_Rfc6979Vector a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.rfc6979_p256_vector() evaluates to [True, '0xa6e3c57d']"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.rfc6979_p256_vector()" ; chx:output "[True, '0xa6e3c57d']" .
chx:X_Rfc6979Vector rd:hasIOExample chx:IO_Rfc6979Vector .
chx:X_DeterministicSigning a owl:NamedIndividual, chx:DeterministicSigning ; rdfs:label "same message, same signature"@en ; skos:definition "The chapter's ECDSA signer is deterministic: the same key and message give the same signature, another message gives another."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_DeterministicSigning a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.rfc6979_deterministic() evaluates to [True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.rfc6979_deterministic()" ; chx:output "[True, True]" .
chx:X_DeterministicSigning rd:hasIOExample chx:IO_DeterministicSigning .
chx:X_LibraryNonceMatches a owl:NamedIndividual, chx:LibraryNonceMatches ; rdfs:label "the same nonce as the standard gives"@en ; skos:definition "The signature the chapter's signer makes is the one obtained from RFC 6979's nonce and the plain ECDSA formulas, normalized to low s."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_LibraryNonceMatches a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.rfc6979_matches_library_nonce() evaluates to True"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.rfc6979_matches_library_nonce()" ; chx:output "True" .
chx:X_LibraryNonceMatches rd:hasIOExample chx:IO_LibraryNonceMatches .
chx:X_CoreDeterminism a owl:NamedIndividual, chx:CoreDeterminism ; rdfs:label "regtest signs twice"@en ; skos:definition "Bitcoin Core 31.1 gives the same signature when it signs the same transaction twice, for ECDSA and for taproot, because it derives the nonce deterministically and uses zero auxiliary data for schnorr."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_CoreDeterminism a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_ecdsa_deterministic_and_schnorr_aux_zero() evaluates to [True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_ecdsa_deterministic_and_schnorr_aux_zero()" ; chx:output "[True, True]" .
chx:X_CoreDeterminism rd:hasIOExample chx:IO_CoreDeterminism .
chx:X_LowRGrinding a owl:NamedIndividual, chx:LowRGrinding ; rdfs:label "300 signatures from one transaction"@en ; skos:definition "Bitcoin Core signs repeatedly until R is small, so all 300 signatures in a transaction with 300 inputs are 70 or 71 bytes with the hash type and none is longer."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_LowRGrinding a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_signature_lengths() evaluates to [300, 71, 70, 300]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_signature_lengths()" ; chx:output "[300, 71, 70, 300]" .
chx:X_LowRGrinding rd:hasIOExample chx:IO_LowRGrinding .
chx:X_LibraryHighR a owl:NamedIndividual, chx:LibraryHighR ; rdfs:label "about half have the top bit set"@en ; skos:definition "A signer that does not grind produces a high R in about half of its signatures: of 400 signatures made by the chapter's library, 197 had the top bit of R set."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_LibraryHighR a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.library_signatures_high_r_share() evaluates to [400, 197, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.library_signatures_high_r_share()" ; chx:output "[400, 197, True]" .
chx:X_LibraryHighR rd:hasIOExample chx:IO_LibraryHighR .
chx:X_GrindingSource a owl:NamedIndividual, chx:GrindingSource ; rdfs:label "the lines of Bitcoin Core"@en ; skos:definition "Bitcoin Core's key.cpp has the low-R grind and the RFC 6979 function, and sign.cpp has the zero auxiliary value and the refusal to produce the SINGLE bug signature."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_GrindingSource a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_grind_and_aux() evaluates to [True, True, True, True]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.core_grind_and_aux()" ; chx:output "[True, True, True, True]" .
chx:X_GrindingSource rd:hasIOExample chx:IO_GrindingSource .
chx:X_QuadraticHashing a owl:NamedIndividual, chx:QuadraticHashing ; rdfs:label "bytes hashed for 1, 10, 100, 1000 inputs"@en ; skos:definition "In the legacy algorithm every signature check hashes nearly the whole transaction, so the bytes hashed grow with the square of the number of inputs; BIP143 hashes each part once."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_QuadraticHashing a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.hashing_bytes() evaluates to [[1, 146, 384], [10, 5150, 2670], [100, 420500, 25530], [1000, 41107000, 254130]]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.hashing_bytes()" ; chx:output "[[1, 146, 384], [10, 5150, 2670], [100, 420500, 25530], [1000, 41107000, 254130]]" .
chx:X_QuadraticHashing rd:hasIOExample chx:IO_QuadraticHashing .
chx:X_HashingGrowth a owl:NamedIndividual, chx:HashingGrowth ; rdfs:label "10 times the inputs"@en ; skos:definition "Going from 100 to 1,000 inputs multiplies the legacy work by 97.8 and the segwit work by 10.0."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_HashingGrowth a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.hashing_growth() evaluates to [97.8, 10.0]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.hashing_growth()" ; chx:output "[97.8, 10.0]" .
chx:X_HashingGrowth rd:hasIOExample chx:IO_HashingGrowth .
chx:X_AmountCommitment a owl:NamedIndividual, chx:AmountCommitment ; rdfs:label "a segwit signature covers the amount"@en ; skos:definition "In BIP143 the signature hash includes the amount of the coin being spent, so a signer cannot be tricked about the amount, which the legacy hash does not offer."@en ; dcterms:source <http://example.org/sen0401/ch08/research> .
chx:IO_AmountCommitment a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.bip143_commits_to_amount() evaluates to True"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch08_claims_v1_0_0 as K; K.bip143_commits_to_amount()" ; chx:output "True" .
