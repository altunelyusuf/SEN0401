pg:Card a ipo:Sidebar,
        owl:NamedIndividual ;
    rdfs:label "Detail card"@en ;
    dcterms:source <http://example.org/sen0401/ch03/document> ;
    skos:definition "The detail card at the right opens only when the reader explicitly asks for the details of a concept."@en .

pg:Header a ipo:Header,
        owl:NamedIndividual ;
    rdfs:label "Header with the main menu"@en ;
    dcterms:source <http://example.org/sen0401/ch03/document> ;
    skos:definition "The header at the top holds the main menu, whose items are intro, learn, maps, lab, agents, practice, reference, about."@en .

pg:Layout a ipo:LayoutPattern,
        owl:NamedIndividual ;
    rdfs:label "Explorer, main area and detail card"@en ;
    dcterms:source <http://example.org/sen0401/ch03/document> ;
    skos:definition "The page puts the chapter explorer at the left, the main area in the centre and a detail card at the right that stays closed until the reader asks for a detail."@en .

pg:Main a ipo:MainContent,
        owl:NamedIndividual ;
    rdfs:label "Main area"@en ;
    dcterms:source <http://example.org/sen0401/ch03/document> ;
    skos:definition "The main area shows the chapter content of the selected menu item, with the widgets of its sections inline."@en .

pg:Q1_O0 a ld:AnswerOption ;
    rdfs:label "A powerful entity designated it as the reference"@en .

pg:Q1_O2 a ld:AnswerOption ;
    rdfs:label "It is downloaded from the Bitcoin Core project's servers"@en .

pg:Q2_O0 a ld:AnswerOption ;
    rdfs:label "It starts and indexes every transaction"@en .

pg:Q2_O1 a ld:AnswerOption ;
    rdfs:label "It starts and ignores prune"@en .

pg:Q3_O1 a ld:AnswerOption ;
    rdfs:label "./autogen.sh, ./configure, make"@en .

pg:Q3_O2 a ld:AnswerOption ;
    rdfs:label "make install, then ./configure"@en .

pg:Q4_O0 a ld:AnswerOption ;
    rdfs:label "194 and 194"@en .

pg:Q4_O1 a ld:AnswerOption ;
    rdfs:label "500 and 125"@en .

pg:Q5_O0 a ld:AnswerOption ;
    rdfs:label "The wtxid, called 'hash' in the decoded result"@en .

pg:Q5_O2 a ld:AnswerOption ;
    rdfs:label "Neither: both hash the same bytes"@en .

pg:Q6_O1 a ld:AnswerOption ;
    rdfs:label "25 bitcoins"@en .

pg:Q6_O2 a ld:AnswerOption ;
    rdfs:label "12.5 bitcoins"@en .

pg:Q7_O0 a ld:AnswerOption ;
    rdfs:label "The subsidy schedule changed after the book printed"@en .

pg:Q7_O1 a ld:AnswerOption ;
    rdfs:label "Block explorers report the reward wrongly"@en .

pg:SectionTree a ipo:TreeNavigation,
        owl:NamedIndividual ;
    rdfs:label "Section tree"@en ;
    dcterms:source <http://example.org/sen0401/ch03/document> ;
    skos:definition "The section tree lists the sections of the chapter by their three levels, and choosing one opens that single section."@en .

pg:Sidebar a ipo:Sidebar,
        owl:NamedIndividual ;
    rdfs:label "Chapter explorer"@en ;
    dcterms:source <http://example.org/sen0401/ch03/document> ;
    skos:definition "The explorer at the left shows the chapter's sections as a tree and keeps pace with the tabs of the main area."@en .

pg:SourceDocument a ipo:SourceDocument,
        owl:NamedIndividual ;
    rdfs:label "Chapter 3 Stage 3 document"@en ;
    ipo:hasLearningObjective pg:CO1,
        pg:CO2,
        pg:CO3,
        pg:CO4 ;
    dcterms:source <http://example.org/sen0401/ch03/document> ;
    skos:definition "The Stage 3 document of chapter 3 is the text this page renders, section for section."@en .

pg:TopMenu a ipo:PrimaryNavigation,
        owl:NamedIndividual ;
    rdfs:label "Main menu"@en ;
    dcterms:source <http://example.org/sen0401/ch03/document> ;
    skos:definition "The main menu is permanently visible at the top and lets the reader reach every top-level area without scrolling or opening anything first."@en .

pg:Q1_O1 a ld:AnswerOption ;
    rdfs:label "Your node independently verified it against every rule"@en .

pg:Q2_O2 a ld:AnswerOption ;
    rdfs:label "It stops with 'Prune mode is incompatible with -txindex'"@en .

pg:Q3_O0 a ld:AnswerOption ;
    rdfs:label "cmake -B build, then cmake --build build"@en .

pg:Q4_O2 a ld:AnswerOption ;
    rdfs:label "569 and 143"@en .

pg:Q5_O1 a ld:AnswerOption ;
    rdfs:label "The txid"@en .

pg:Q6_O0 a ld:AnswerOption ;
    rdfs:label "6.25 bitcoins"@en .

pg:Q7_O2 a ld:AnswerOption ;
    rdfs:label "The printed figure belongs to a different block than the script reads"@en .

pg:S_AlertNotify a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Alert notification (alertnotify)"@en ;
    sen0401:anchor "#AlertNotify" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_AlertNotify> ;
    skos:definition "The alertnotify option runs a command of the owner's choice when the node raises an alert, replacing %s with the message, which the node first cleans and puts in single quotes."@en .

pg:S_AlternativeToolkit a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Alternative toolkit"@en ;
    sen0401:anchor "#AlternativeToolkit" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_AlternativeToolkit> ;
    skos:definition "Libraries, toolkits and full nodes in many languages give native access to Bitcoin, and their upkeep varies, so a listed toolkit's latest release is worth checking."@en .

pg:S_Api a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Application programming interface"@en ;
    sen0401:anchor "#Api" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Api> ;
    skos:definition "An application programming interface is the set of requests that one program offers to other programs; Bitcoin Core's API lets a program ask the node about the chain, the mempool and the wallet."@en .

pg:S_Assurance a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Assurance"@en ;
    sen0401:anchor "#Assurance" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Assurance> ;
    skos:definition "Assurance is the group of concepts that answer the question how do I know."@en .

pg:S_AutotoolsBuild a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Autotools build"@en ;
    sen0401:anchor "#AutotoolsBuild" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_AutotoolsBuild> ;
    skos:definition "The book builds bitcoind with autogen.sh, configure and make, options such as --disable-wallet and --with-gui=no shaping the build; Bitcoin Core replaced this with CMake."@en .

pg:S_Base64 a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Base64"@en ;
    sen0401:anchor "#Base64" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Base64> ;
    skos:definition "Base64 is a way of writing bytes as text with 64 characters, so that binary data can travel in a text header, and it is not encryption."@en .

pg:S_BestChain a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Best chain"@en ;
    sen0401:anchor "#BestChain" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_BestChain> ;
    skos:definition "The best chain is the valid chain with the most cumulative proof of work; it is not necessarily the one with the most blocks."@en .

pg:S_BitShift a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bit shift"@en ;
    sen0401:anchor "#BitShift" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_BitShift> ;
    skos:definition "A bit shift moves the bits of an integer to the left or to the right, which multiplies it by a power of two or divides it by one, dropping what falls off."@en .

pg:S_BitcoinCommand a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The bitcoin command"@en ;
    sen0401:anchor "#BitcoinCommand" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_BitcoinCommand> ;
    skos:definition "The bitcoin command is a front door to the node and tools, and its -m option runs the multiprocess binaries instead of the monolithic ones."@en .

pg:S_Block a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block"@en ;
    sen0401:anchor "#Block" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Block> ;
    skos:definition "The block group collects the concepts about the unit in which transactions are recorded."@en .

pg:S_BlockHash a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block hash"@en ;
    sen0401:anchor "#BlockHash" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_BlockHash> ;
    skos:definition "The block hash is the double SHA-256 hash of the 80-byte block header, written backwards; it identifies a block uniquely and is not stored in the block."@en .

pg:S_BlockHeader a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block header"@en ;
    sen0401:anchor "#BlockHeader" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_BlockHeader> ;
    skos:definition "The block header holds the version, the previous block hash, the Merkle root, the timestamp, the compact target and the nonce, in 80 bytes."@en .

pg:S_BlockHeight a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block height"@en ;
    sen0401:anchor "#BlockHeight" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_BlockHeight> ;
    skos:definition "A block is found by its height, how many blocks precede it, or by its header hash; its confirmations count the blocks built on top, itself included."@en .

pg:S_BlockSubsidy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block subsidy"@en ;
    sen0401:anchor "#BlockSubsidy" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_BlockSubsidy> ;
    skos:definition "The subsidy starts at 50 bitcoins and is shifted right once for every 210,000 blocks, so it is 6.25 bitcoins at height 775072."@en .

pg:S_BlockWeight a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block weight"@en ;
    sen0401:anchor "#BlockWeight" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_BlockWeight> ;
    skos:definition "A block without witness data weighs four times its size in weight units, which the getblock result shows as size, strippedsize and weight."@en .

pg:S_BlockchainInfo a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Blockchain information (getblockchaininfo)"@en ;
    sen0401:anchor "#BlockchainInfo" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_BlockchainInfo> ;
    skos:definition "The getblockchaininfo call reports the chain the node follows: its name, the number of blocks and headers, the best block, its difficulty and chain work, whether the node is still in its initial download and whether it is pruned."@en .

pg:S_BlocksOnlyMode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Blocks-only mode"@en ;
    sen0401:anchor "#BlocksOnlyMode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_BlocksOnlyMode> ;
    skos:definition "In blocks-only mode a node accepts blocks from its peers but not unconfirmed transactions, which saves bandwidth and memory."@en .

pg:S_Build a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Build"@en ;
    sen0401:anchor "#Build" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Build> ;
    skos:definition "The build branch is about turning the text of Bitcoin Core into a program that can run."@en .

pg:S_BuildPrerequisite a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Build prerequisite"@en ;
    sen0401:anchor "#BuildPrerequisite" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_BuildPrerequisite> ;
    skos:definition "The build prerequisites are the libraries and tools that must be present before compiling; a missing one makes configuration fail and can be installed afterwards."@en .

pg:S_Byte a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bit and byte"@en ;
    sen0401:anchor "#Byte" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Byte> ;
    skos:definition "A bit is a binary digit, a byte is eight bits and holds one of 256 values, so it is written with two hexadecimal digits."@en .

pg:S_CMakeBuild a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "CMake build"@en ;
    sen0401:anchor "#CMakeBuild" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_CMakeBuild> ;
    skos:definition "A current build is cmake -B build, cmake --build build and cmake --install build, with options such as -DENABLE_WALLET=OFF and -DBUILD_GUI=ON."@en .

pg:S_ChainState a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Chain state"@en ;
    sen0401:anchor "#ChainState" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_ChainState> ;
    skos:definition "The chain state group collects the concepts that describe the blocks as a whole: which chain is the true one, how much work it represents, how deep a block is in it, and what happens when the node changes its mind."@en .

pg:S_ChainWork a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Chain work"@en ;
    sen0401:anchor "#ChainWork" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_ChainWork> ;
    skos:definition "The work of a block is 2^256 divided by its target plus one, the expected number of hashes needed to find it, and the chain work is the sum of the work of all blocks up to it."@en .

pg:S_Checksum a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Checksum"@en ;
    sen0401:anchor "#Checksum" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Checksum> ;
    skos:definition "A checksum is a short fixed-size value computed from a file by a hash function, so that any change to the file makes the value change."@en .

pg:S_Client a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Client"@en ;
    sen0401:anchor "#Client" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Client> ;
    skos:definition "The client group collects the concepts about the programs that call the interface."@en .

pg:S_CommandLine a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Command line"@en ;
    sen0401:anchor "#CommandLine" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_CommandLine> ;
    skos:definition "The command line is a text interface in which a person types the name of a program followed by arguments and reads the program's text output."@en .

pg:S_CommandLineClient a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Command-line client (bitcoin-cli)"@en ;
    sen0401:anchor "#CommandLineClient" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_CommandLineClient> ;
    skos:definition "The bitcoin-cli helper sends the same calls the API offers, which makes it the way to experiment interactively; its help command lists the available RPC commands."@en .

pg:S_CompactTarget a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Compact target (bits)"@en ;
    sen0401:anchor "#CompactTarget" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_CompactTarget> ;
    skos:definition "The bits field is a four-byte compact form of the target: the first byte is the length in bytes and the next three are the leading digits, so the target is the digits shifted left by the length minus three bytes."@en .

pg:S_Compilation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Compilation"@en ;
    sen0401:anchor "#Compilation" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Compilation> ;
    skos:definition "Compilation translates the source files into executable programs; it takes up to an hour, can be resumed, and is followed by the unit tests."@en .

pg:S_Computing a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Computing foundations"@en ;
    sen0401:anchor "#Computing" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Computing> ;
    skos:definition "The computing foundations branch collects the everyday vocabulary of programs and computers that the other branches use without stopping to explain it: bytes and bit shifts, times and random numbers, files and processes, libraries and databases, protocols and tests."@en .

pg:S_Configuration a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Configuration"@en ;
    sen0401:anchor "#Configuration" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Configuration> ;
    skos:definition "Configuration is the group of concepts that describe how a user tells Bitcoin Core how to behave."@en .

pg:S_ConfigurationFile a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Configuration file"@en ;
    sen0401:anchor "#ConfigurationFile" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_ConfigurationFile> ;
    skos:definition "Bitcoin Core reads bitcoin.conf from its data directory at every start; options can also be given on the command line, and bitcoind -printtoconsole shows where the file is looked for."@en .

pg:S_ConfigurationOption a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Configuration option"@en ;
    sen0401:anchor "#ConfigurationOption" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_ConfigurationOption> ;
    skos:definition "An option has a name and a value and can come from the file, from the dynamic settings file or from the command line; the command line wins."@en .

pg:S_Confirmation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Confirmation"@en ;
    sen0401:anchor "#Confirmation" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Confirmation> ;
    skos:definition "A confirmation counts the blocks from a transaction's block to the tip, itself included; each one makes it harder to reverse the transaction."@en .

pg:S_CookieAuthentication a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Cookie authentication"@en ;
    sen0401:anchor "#CookieAuthentication" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_CookieAuthentication> ;
    skos:definition "By default Bitcoin Core creates a random credential on each start and stores it in the data directory as .cookie, which bitcoin-cli reads; rpcauth.py makes a static credential instead."@en .

pg:S_Daemon a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Daemon"@en ;
    sen0401:anchor "#Daemon" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Daemon> ;
    skos:definition "A daemon is a program that runs in the background; bitcoind -daemon detaches from the terminal, and init scripts such as the systemd unit start it at boot and restart it after a failure."@en .

pg:S_Data a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Data"@en ;
    sen0401:anchor "#Data" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Data> ;
    skos:definition "The data branch is about what a node holds and what the interface shows of it: the transactions that move value, the blocks that gather them into the shared record, and the state of the chain that results."@en .

pg:S_DataDirectory a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Data directory"@en ;
    sen0401:anchor "#DataDirectory" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_DataDirectory> ;
    skos:definition "The data directory is where Bitcoin Core keeps the blocks, the unspent-output database, the logs and the wallets; its default place depends on the system and its contents on the network."@en .

pg:S_Database a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Database"@en ;
    sen0401:anchor "#Database" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Database> ;
    skos:definition "A database stores data so that it can be searched and updated reliably, and Bitcoin Core uses a key-value database for the chain and an SQL database for the wallet."@en .

pg:S_DatabaseCache a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Database cache (dbcache)"@en ;
    sen0401:anchor "#DatabaseCache" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_DatabaseCache> ;
    skos:definition "The dbcache option sizes the cache of the unspent-output set: 450 MiB by default in the book, 1024 MiB by default from Bitcoin Core 31.0 on machines with enough memory."@en .

pg:S_DecodedTransaction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Decoded transaction"@en ;
    sen0401:anchor "#DecodedTransaction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_DecodedTransaction> ;
    skos:definition "Decoding the serialized hexadecimal of Alice's payment shows its one input, two outputs, addresses and script types, exactly as the chain holds them."@en .

pg:S_DescriptorWallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Descriptor wallet"@en ;
    sen0401:anchor "#DescriptorWallet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_DescriptorWallet> ;
    skos:definition "The current default wallet is a descriptor wallet stored in SQLite; legacy BerkeleyDB wallets can no longer be created or loaded and can only be migrated."@en .

pg:S_Difficulty a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Difficulty"@en ;
    sen0401:anchor "#Difficulty" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Difficulty> ;
    skos:definition "A block's difficulty follows from its bits, the compact form of its target, as the ratio of the easiest target to this block's target."@en .

pg:S_Ecosystem a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Ecosystem"@en ;
    sen0401:anchor "#Ecosystem" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Ecosystem> ;
    skos:definition "The ecosystem branch is about the software around the reference implementation and about how a person can trust what they download."@en .

pg:S_Executable a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Executable"@en ;
    sen0401:anchor "#Executable" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Executable> ;
    skos:definition "The build produces several executables: bitcoind is the node, bitcoin-cli the command-line client, bitcoin-tx a transaction tool, and others for the wallet and the graphical interface."@en .

pg:S_FileAndDirectory a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "File and directory"@en ;
    sen0401:anchor "#FileAndDirectory" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_FileAndDirectory> ;
    skos:definition "A file holds data under a name, a directory holds files and other directories, and a path names a place in that hierarchy."@en .

pg:S_Fork a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Fork"@en ;
    sen0401:anchor "#Fork" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Fork> ;
    skos:definition "A fork is a split of the chain into two branches, accidental when two miners find blocks at about the same time, or permanent when rules change incompatibly."@en .

pg:S_FullNode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Full node"@en ;
    sen0401:anchor "#FullNode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_FullNode> ;
    skos:definition "A full verification node checks every confirmed transaction against every rule of the system, so that what it reports is authoritative because it was independently verified."@en .

pg:S_GitRepository a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Git repository"@en ;
    sen0401:anchor "#GitRepository" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_GitRepository> ;
    skos:definition "Git is a distributed version control system; cloning copies the whole repository with its history and a commit is named by a long hash."@en .

pg:S_Hmac a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Keyed hash (HMAC)"@en ;
    sen0401:anchor "#Hmac" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Hmac> ;
    skos:definition "An HMAC is a hash computed with a secret key, so that only someone who knows the key can produce or check the value."@en .

pg:S_HttpRequest a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "HTTP request"@en ;
    sen0401:anchor "#HttpRequest" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_HttpRequest> ;
    skos:definition "HTTP is the request-and-response protocol of the web; Bitcoin Core receives each JSON-RPC call as the body of an HTTP POST request and sends the answer as the body of the HTTP response."@en .

pg:S_ImprovementProposal a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bitcoin Improvement Proposal"@en ;
    sen0401:anchor "#ImprovementProposal" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_ImprovementProposal> ;
    skos:definition "Most major parts of the system since 2011 are documented in Bitcoin Improvement Proposals, referred to by number."@en .

pg:S_InitialDownload a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Initial download"@en ;
    sen0401:anchor "#InitialDownload" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_InitialDownload> ;
    skos:definition "A new node downloads and validates the whole chain before it can process transactions, and a node that was off for ten days downloads about four gigabytes at 400 megabytes a day."@en .

pg:S_Interface a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Interface"@en ;
    sen0401:anchor "#Interface" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Interface> ;
    skos:definition "The interface branch is about how other programs and people talk to a running node."@en .

pg:S_Iri a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "IRI"@en ;
    sen0401:anchor "#Iri" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Iri> ;
    skos:definition "An IRI is an internationalized resource identifier, a global name for a thing or a concept, which linked data uses in place of ambiguous words."@en .

pg:S_JsonFormat a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "JSON data format"@en ;
    sen0401:anchor "#JsonFormat" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_JsonFormat> ;
    skos:definition "JSON is a text format for structured data made of objects, arrays, strings, numbers, booleans and null; every answer of Bitcoin Core's API is written in it."@en .

pg:S_JsonLdContext a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "JSON-LD context"@en ;
    sen0401:anchor "#JsonLdContext" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_JsonLdContext> ;
    skos:definition "A JSON-LD context maps the keys of a JSON text to IRIs, so that the same JSON becomes linked data without changing its shape."@en .

pg:S_JsonRpc a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "JSON-RPC interface"@en ;
    sen0401:anchor "#JsonRpc" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_JsonRpc> ;
    skos:definition "Bitcoin Core's API is JSON-RPC over HTTP, by default to 127.0.0.1 on port 8332, so any program that can make an HTTP request can call it."@en .

pg:S_LegacyWallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Legacy wallet"@en ;
    sen0401:anchor "#LegacyWallet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_LegacyWallet> ;
    skos:definition "The legacy wallet was stored in a Berkeley DB file and described by its keys; since Bitcoin Core 30.0 it can no longer be created or loaded, only migrated."@en .

pg:S_Library a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Software library"@en ;
    sen0401:anchor "#Library" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Library> ;
    skos:definition "A library is a collection of code written to be used by other programs, which saves them from writing it again and which they load or compile in."@en .

pg:S_LinkedData a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Linked data"@en ;
    sen0401:anchor "#LinkedData" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_LinkedData> ;
    skos:definition "Linked data is a way of publishing data so that its parts can be referred to from other data."@en .

pg:S_MedianTimePast a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Median time past"@en ;
    sen0401:anchor "#MedianTimePast" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_MedianTimePast> ;
    skos:definition "The median time past is the middle value of the timestamps of the last 11 blocks, which the consensus rules use as the clock for time limits because a single miner cannot move it."@en .

pg:S_MempoolLimit a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Mempool limit (maxmempool)"@en ;
    sen0401:anchor "#MempoolLimit" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_MempoolLimit> ;
    skos:definition "The maxmempool option limits the memory used for unconfirmed transactions; the default is 300 megabytes, and unused mempool memory is lent to the database cache."@en .

pg:S_MerkleRoot a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Merkle root"@en ;
    sen0401:anchor "#MerkleRoot" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_MerkleRoot> ;
    skos:definition "The Merkle root in a block header commits to every transaction of the block, and hashing the block's transaction identifiers pairwise up to one value reproduces it."@en .

pg:S_NetworkInfo a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Network information (getnetworkinfo)"@en ;
    sen0401:anchor "#NetworkInfo" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_NetworkInfo> ;
    skos:definition "The getnetworkinfo call reports the node's own version, the protocol version, the services it offers, its connections and reachable networks, and the fee rates it uses to accept transactions."@en .

pg:S_NetworkProtocol a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Network protocol"@en ;
    sen0401:anchor "#NetworkProtocol" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_NetworkProtocol> ;
    skos:definition "A network protocol is an agreed format and order of messages between programs, such as HTTP between a client and a server, and a port number names the service on a machine."@en .

pg:S_Node a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Node"@en ;
    sen0401:anchor "#Node" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Node> ;
    skos:definition "A node is a computer that runs Bitcoin software and takes part in the peer-to-peer network, and this first branch of the chapter is about the most complete kind of node, the full verification node."@en .

pg:S_NodeResources a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Node resources"@en ;
    sen0401:anchor "#NodeResources" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_NodeResources> ;
    skos:definition "Node resources are the things that a node consumes in order to do its work: time and bandwidth to download the chain, disk space to store it, memory to keep the data it needs often, and network connections to other nodes."@en .

pg:S_OpenPgpSignature a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "OpenPGP signature"@en ;
    sen0401:anchor "#OpenPgpSignature" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_OpenPgpSignature> ;
    skos:definition "An OpenPGP signature is a digital signature in the format of the OpenPGP standard, made with a person's secret key over a file and checked with the matching public key."@en .

pg:S_OpenSourceSoftware a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Open-source software"@en ;
    sen0401:anchor "#OpenSourceSoftware" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_OpenSourceSoftware> ;
    skos:definition "Open-source software is published with its source code under a license that lets anyone use, change and distribute it; Bitcoin Core uses the MIT license."@en .

pg:S_Operation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Operation"@en ;
    sen0401:anchor "#Operation" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Operation> ;
    skos:definition "Operation is the second large part of the chapter, and it is about what happens after the software has been built or downloaded: how a node is started, how it is configured, how its state is observed, and what kind of wallet comes with it."@en .

pg:S_OutputDescriptor a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Output descriptor"@en ;
    sen0401:anchor "#OutputDescriptor" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_OutputDescriptor> ;
    skos:definition "An output descriptor is a short text that describes a set of output scripts, optionally followed by an 8-character checksum that detects typing and copying errors."@en .

pg:S_OutputType a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Output type"@en ;
    sen0401:anchor "#OutputType" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_OutputType> ;
    skos:definition "An output type is the form of locking an output uses, such as P2PKH, P2SH-P2WPKH, P2WPKH and P2TR, and a descriptor wallet keeps one descriptor for each type it supports."@en .

pg:S_PackageManager a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Package manager"@en ;
    sen0401:anchor "#PackageManager" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_PackageManager> ;
    skos:definition "A package manager installs software and the libraries it depends on from a collection maintained for an operating system or a build."@en .

pg:S_PackageRegistry a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Package registry"@en ;
    sen0401:anchor "#PackageRegistry" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_PackageRegistry> ;
    skos:definition "A package registry is a public index of the software libraries published for a programming language, with each library's versions and release dates."@en .

pg:S_Peer a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Peer and connection"@en ;
    sen0401:anchor "#Peer" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Peer> ;
    skos:definition "A peer is another node with which a node keeps a connection to exchange blocks and transactions; a node limits how many it keeps."@en .

pg:S_Platform a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Platform"@en ;
    sen0401:anchor "#Platform" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Platform> ;
    skos:definition "A platform is the combination of processor family and operating system for which a program is built, and a release has one archive for each."@en .

pg:S_Process a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Process and thread"@en ;
    sen0401:anchor "#Process" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Process> ;
    skos:definition "A process is a running program with its own memory, and a thread is a flow of execution inside a process that shares its memory with the others."@en .

pg:S_ProgrammingLanguage a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Programming language"@en ;
    sen0401:anchor "#ProgrammingLanguage" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_ProgrammingLanguage> ;
    skos:definition "A programming language is a notation for instructing a computer, and the chapter meets C++ for the node, Python for tests, helpers and examples, and the languages of the toolkits."@en .

pg:S_Project a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The Bitcoin Core project"@en ;
    sen0401:anchor "#Project" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Project> ;
    skos:definition "The project group describes where Bitcoin Core comes from and who maintains it."@en .

pg:S_PrunedNode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Pruned node"@en ;
    sen0401:anchor "#PrunedNode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_PrunedNode> ;
    skos:definition "A pruned node deletes old blocks to reduce disk use while still downloading and verifying the whole chain; automatic pruning needs a target of at least 550 MiB."@en .

pg:S_RandomNumber a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Random number"@en ;
    sen0401:anchor "#RandomNumber" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_RandomNumber> ;
    skos:definition "A random number is a value that nobody can predict, which Bitcoin Core draws from the computer's secure sources of randomness for cookies and salts."@en .

pg:S_ReferenceImplementation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Reference implementation"@en ;
    sen0401:anchor "#ReferenceImplementation" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_ReferenceImplementation> ;
    skos:definition "Bitcoin Core is the reference implementation: it provides a reference for how each part of the technology should be implemented."@en .

pg:S_ReleaseCandidate a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Release candidate"@en ;
    sen0401:anchor "#ReleaseCandidate" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_ReleaseCandidate> ;
    skos:definition "Release candidates, intended for testing, carry the suffix rc; stable releases that can run on production systems have no suffix."@en .

pg:S_ReleaseTag a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Release tag"@en ;
    sen0401:anchor "#ReleaseTag" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_ReleaseTag> ;
    skos:definition "A release tag marks a snapshot of the source by version number; release candidates carry the suffix rc and stable releases none."@en .

pg:S_ReleaseVerification a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Release verification"@en ;
    sen0401:anchor "#ReleaseVerification" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_ReleaseVerification> ;
    skos:definition "A downloaded release can be checked against the SHA-256 checksums the project publishes and the signatures on them, which shows that the file matches the published record and not that the signers' keys are trustworthy."@en .

pg:S_Reorganization a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Chain reorganization"@en ;
    sen0401:anchor "#Reorganization" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Reorganization> ;
    skos:definition "A reorganization occurs when a node switches to a different chain with more work: blocks leave the best chain, their transactions return to the mempool unless the new chain includes them, and the set of unspent outputs is updated."@en .

pg:S_Representation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Representation"@en ;
    sen0401:anchor "#Representation" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Representation> ;
    skos:definition "Representation is the group of concepts about how a program writes information down."@en .

pg:S_ReproducibleBuild a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Reproducible build"@en ;
    sen0401:anchor "#ReproducibleBuild" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_ReproducibleBuild> ;
    skos:definition "A reproducible build produces bit-for-bit identical files from the same source, so that several builders can independently attest to the same checksums."@en .

pg:S_RpcAuth a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hashed credentials (rpcauth)"@en ;
    sen0401:anchor "#RpcAuth" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_RpcAuth> ;
    skos:definition "The rpcauth option holds a user name, a random salt and the HMAC-SHA256 of the password under that salt, so the file never contains the password itself."@en .

pg:S_RpcInterface a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "RPC interface"@en ;
    sen0401:anchor "#RpcInterface" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_RpcInterface> ;
    skos:definition "The RPC interface is the group of concepts that describe the programmatic doorway of Bitcoin Core."@en .

pg:S_Running a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Running"@en ;
    sen0401:anchor "#Running" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Running> ;
    skos:definition "Running is the group of concepts that describe a node while it is alive: how it is started so that it keeps going without a person, what it writes while it starts, and how its owner asks two short questions about its state."@en .

pg:S_Salt a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Salt"@en ;
    sen0401:anchor "#Salt" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Salt> ;
    skos:definition "A salt is a random value mixed into the hashing of a password, so that equal passwords give different stored values."@en .

pg:S_SatoshiNakamoto a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Satoshi Nakamoto"@en ;
    sen0401:anchor "#SatoshiNakamoto" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_SatoshiNakamoto> ;
    skos:definition "Satoshi Nakamoto is the name under which Bitcoin was described in 2008 and its first software released; the identity of the person or people behind the name is unknown."@en .

pg:S_SegregatedWitness a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Segregated witness"@en ;
    sen0401:anchor "#SegregatedWitness" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_SegregatedWitness> ;
    skos:definition "Segregated witness moves the signature data of a transaction out of the part that the identifier covers, into a witness that counts less toward the size limit."@en .

pg:S_Semantics a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Semantics"@en ;
    sen0401:anchor "#Semantics" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Semantics> ;
    skos:definition "The semantics branch connects the chapter to the course's wider theme, the meaning of data."@en .

pg:S_SoftFork a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Soft fork"@en ;
    sen0401:anchor "#SoftFork" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_SoftFork> ;
    skos:definition "A soft fork tightens the consensus rules in a backward-compatible way; BIP 9 lets several be deployed in parallel by signalling in the block version."@en .

pg:S_SoftwareTesting a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Software testing"@en ;
    sen0401:anchor "#SoftwareTesting" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_SoftwareTesting> ;
    skos:definition "A software test runs a program on chosen inputs and compares the result with the expected one, and Bitcoin Core requires its tests to pass before a change is merged."@en .

pg:S_Source a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Source"@en ;
    sen0401:anchor "#Source" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Source> ;
    skos:definition "The source group contains the concepts needed to obtain the right text of the program: the source code itself, the Git repository in which the project keeps it, the release tag that names a particular stable version, and the release candidate that precedes it."@en .

pg:S_SourceCode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Source code"@en ;
    sen0401:anchor "#SourceCode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_SourceCode> ;
    skos:definition "Source code is the human-readable text of a program, mainly C++ in Bitcoin Core, from which the executables are built; it can be read and audited by anyone."@en .

pg:S_StartupLog a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Start-up log"@en ;
    sen0401:anchor "#StartupLog" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_StartupLog> ;
    skos:definition "While it starts, the node prints a log of what it is setting up: its version, the settings read, the connection limits, the interface it opens, the wallet database and the cache sizes."@en .

pg:S_Systems a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Systems"@en ;
    sen0401:anchor "#Systems" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Systems> ;
    skos:definition "Systems is the group of concepts about where programs run and how they meet."@en .

pg:S_Toolchain a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Toolchain"@en ;
    sen0401:anchor "#Toolchain" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Toolchain> ;
    skos:definition "The toolchain group gathers the programs and conventions that turn source code into running executables: the build system, which decides how, the compilation, which does the translation, the prerequisites, which must be present, and the executables, which are the result."@en .

pg:S_Transaction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction"@en ;
    sen0401:anchor "#Transaction" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Transaction> ;
    skos:definition "The transaction group collects the concepts about the objects that carry value."@en .

pg:S_TransactionIdentifier a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction identifier (txid and wtxid)"@en ;
    sen0401:anchor "#TransactionIdentifier" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_TransactionIdentifier> ;
    skos:definition "The txid hashes the transaction without its witness and the hash includes it; a txid is not authoritative before confirmation because a transaction can be modified."@en .

pg:S_TransactionIndex a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction index (txindex)"@en ;
    sen0401:anchor "#TransactionIndex" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_TransactionIndex> ;
    skos:definition "The txindex option builds an index of every transaction so that getrawtransaction can find any of them; it cannot be combined with pruning."@en .

pg:S_TransactionMalleability a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction malleability"@en ;
    sen0401:anchor "#TransactionMalleability" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_TransactionMalleability> ;
    skos:definition "Malleability is the possibility that a transaction is modified before confirmation so that its identifier changes while its meaning does not; the witness separation removed it for the txid of witness spends."@en .

pg:S_TransactionSerialization a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction serialization"@en ;
    sen0401:anchor "#TransactionSerialization" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_TransactionSerialization> ;
    skos:definition "Serialization writes a transaction as a sequence of bytes, with a marker and a flag before the inputs when the transaction has witness data, shown in hexadecimal notation."@en .

pg:S_TransactionWeight a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction weight"@en ;
    sen0401:anchor "#TransactionWeight" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_TransactionWeight> ;
    skos:definition "A transaction's weight counts its non-witness bytes four times and its witness bytes once, and its virtual size is the weight divided by four, rounded up."@en .

pg:S_UnixTime a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Unix time"@en ;
    sen0401:anchor "#UnixTime" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_UnixTime> ;
    skos:definition "Unix time counts the seconds since 1 January 1970 at 00:00 UTC, and Bitcoin uses it for the times in block headers."@en .

pg:S_UtxoSet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Set of unspent outputs"@en ;
    sen0401:anchor "#UtxoSet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_UtxoSet> ;
    skos:definition "The set of unspent transaction outputs is the compact record of everything that can still be spent; a node updates it for every block and it is the data that the database cache holds."@en .

pg:S_Verification a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Verification"@en ;
    sen0401:anchor "#Verification" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Verification> ;
    skos:definition "Verification is the second level of the node branch and gathers four ideas: the full node itself, the reference implementation, the Bitcoin Improvement Proposals and the soft fork."@en .

pg:S_VerifiedData a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Verified data"@en ;
    sen0401:anchor "#VerifiedData" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_VerifiedData> ;
    skos:definition "Data from your own node is authoritative because the node verified it itself, which is the kind of fact a provenance record states about any dataset."@en .

pg:S_Wallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Wallet"@en ;
    sen0401:anchor "#Wallet" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch03#S_Wallet> ;
    skos:definition "The wallet group collects the concepts about the wallet that comes with Bitcoin Core."@en .

pg:S_WrapperLibrary a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Wrapper library"@en ;
    sen0401:anchor "#WrapperLibrary" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch03#S_WrapperLibrary> ;
    skos:definition "A wrapper library hides the HTTP call: python-bitcoinlib's RawProxy turns p.getblockchaininfo() into the JSON-RPC request and returns the decoded answer."@en .

pg:CO2 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Explain what a full node verifies and why Bitcoin Core's own answers are authoritative"@en ;
    ld:bloomLevel ld:Understand ;
    dcterms:source <http://example.org/sen0401/ch03/document> ;
    skos:definition "After this chapter the learner can explain what a full node verifies and why Bitcoin Core's own answers are authoritative."@en .

pg:CO1 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Decode a transaction by hand: compute its txid, hash, weight and virtual size from its serialization"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch03/document> ;
    skos:definition "After this chapter the learner can decode a transaction by hand: compute its txid, hash, weight and virtual size from its serialization."@en .

pg:CO3 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Choose and justify Bitcoin Core options, such as prune, txindex and dbcache, for a given machine"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch03/document> ;
    skos:definition "After this chapter the learner can choose and justify Bitcoin Core options, such as prune, txindex and dbcache, for a given machine."@en .

pg:CO4 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Recompute a block's Merkle root and header hash, and check a printed result against the software and the chain"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch03/document> ;
    skos:definition "After this chapter the learner can recompute a block's Merkle root and header hash, and check a printed result against the software and the chain."@en .

