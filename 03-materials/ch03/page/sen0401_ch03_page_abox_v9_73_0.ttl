    skos:definition "This page teaches chapter 3 of the course book as an interactive surface with 115 sections in a three-level outline, 117 widgets that the browser test exercised, and a quiz of 7 questions."@en .

pg:Q1 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Why is data from your own full node authoritative?"@en ;
    ld:assessesObjective pg:CO2 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "Bitcoin Core does not serve data; nodes get it from peers and check it.",
        "The chapter says the opposite: not because a powerful entity designated it." ;
    ld:hasCorrectOption pg:Q1_O1 ;
    ld:hasOption pg:Q1_O0,
        pg:Q1_O1,
        pg:Q1_O2 .

pg:Q2 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "A node is configured with prune=5000 and txindex=1. What does Bitcoin Core 31.1 do?"@en ;
    ld:assessesObjective pg:CO3 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "An index of every transaction needs the old blocks that pruning deletes.",
        "Neither option is silently ignored; the release refuses the combination." ;
    ld:hasCorrectOption pg:Q2_O2 ;
    ld:hasOption pg:Q2_O0,
        pg:Q2_O1,
        pg:Q2_O2 .

pg:Q3 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Which sequence builds Bitcoin Core from source in 29.0 and later?"@en ;
    ld:assessesObjective pg:CO3 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "Install comes after building and configuring, and Autotools is no longer used.",
        "That is the Autotools sequence the book prints; 29.0 replaced it." ;
    ld:hasCorrectOption pg:Q3_O0 ;
    ld:hasOption pg:Q3_O0,
        pg:Q3_O1,
        pg:Q3_O2 .

pg:Q4 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "A serialized segwit transaction is 194 bytes and 125 bytes without its witness. What are its weight and virtual size?"@en ;
    ld:assessesObjective pg:CO1 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "4 x 125 + 69 gives 569, and 500 leaves out the 69 witness-side bytes.",
        "Weight counts non-witness bytes four times and witness bytes once, not 194 for both." ;
    ld:hasCorrectOption pg:Q4_O2 ;
    ld:hasOption pg:Q4_O0,
        pg:Q4_O1,
        pg:Q4_O2 .

pg:Q5 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Which identifier leaves the witness out of what it hashes?"@en ;
    ld:assessesObjective pg:CO1 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "For Alice's transaction they differ: 4662... against f7cd....",
        "The 'hash' field includes the witness, so it differs from the txid for a segwit transaction." ;
    ld:hasCorrectOption pg:Q5_O1 ;
    ld:hasOption pg:Q5_O0,
        pg:Q5_O1,
        pg:Q5_O2 .

pg:Q6 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Block 775072 is at height 775072. What subsidy does Bitcoin Core's schedule give it?"@en ;
    ld:assessesObjective pg:CO4 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "12.5 bitcoins is the subsidy after two halvings, not three.",
        "Shift 50 bitcoins right once per 210,000 blocks: 775072 // 210000 is 3, not 1." ;
    ld:hasCorrectOption pg:Q6_O0 ;
    ld:hasOption pg:Q6_O0,
        pg:Q6_O1,
        pg:Q6_O2 .

pg:Q7 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "The book prints a block total with a 25 BTC reward, but its script reads block 775072. What should a careful reader conclude?"@en ;
    ld:assessesObjective pg:CO4 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "Explorers agree with the node: the coinbase there is the 6.25 subsidy plus fees.",
        "The schedule is fixed by consensus rules and was the same when the book printed." ;
    ld:hasCorrectOption pg:Q7_O2 ;
    ld:hasOption pg:Q7_O0,
        pg:Q7_O1,
        pg:Q7_O2 .

pg:W_AlertNotify a ipo:InstructionalWidget,
