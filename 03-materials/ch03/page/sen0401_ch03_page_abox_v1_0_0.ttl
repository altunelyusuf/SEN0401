pg:Page a ipo:Page, ipo:InteractiveLearningSurface ; rdfs:label "Chapter 3 interactive page"@en ;
    dcterms:source <http://example.org/sen0401/ch03/document> ; ipo:hasSourceDocument pg:SourceDocument ;
    ipo:satisfiesHeuristic ipo:RecognitionRatherThanRecall, ipo:ConsistencyAndStandards, ipo:AestheticAndMinimalistDesign,
        ipo:ShneidermanRule_OfferInformativeFeedback, ipo:ShneidermanRule_PermitEasyReversalOfActions, ipo:HelpAndDocumentation ;
    ipo:hasLayoutPattern pg:Layout ; ipo:hasSemanticRegion pg:Header, pg:Sidebar, pg:Main ;
    ipo:includesNavigationPattern pg:GroupedTopBar, pg:SectionTree ;
    ipo:coversLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 ;
    sen0401:navigationRule "BP-D34: 48 sections falls in 26-50, so a grouped permanent top bar with a sub-section sidebar; the named single flowing anchor-page variation of procedure v1.6.0 section 5.3." ;
    sen0401:pythonUsed "Python 3.14.4" .
pg:Layout a ipo:SplitLayout ; rdfs:label "Sidebar and main content"@en .
pg:Header a ipo:Header ; rdfs:label "Sticky header with grouped section bar"@en .
pg:Sidebar a ipo:Sidebar ; rdfs:label "Section tree"@en .
pg:Main a ipo:MainContent ; rdfs:label "Chapter content with inline widgets"@en .
pg:GroupedTopBar a ipo:PrimaryNavigation ; rdfs:label "Grouped permanent top bar"@en .
pg:SectionTree a ipo:TreeNavigation ; rdfs:label "Sub-section sidebar tree"@en .
pg:SourceDocument a ipo:SourceDocument ; rdfs:label "Chapter 3 Stage 3 document"@en ; dcterms:source <http://example.org/sen0401/ch03/document> ;
    ipo:hasLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 .

pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Decode a transaction by hand: compute its txid, hash, weight and virtual size from its serialization"@en ; ld:bloomLevel ld:Apply  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Explain what a full node verifies and why Bitcoin Core's own answers are authoritative"@en ; ld:bloomLevel ld:Understand  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Choose and justify Bitcoin Core options, such as prune, txindex and dbcache, for a given machine"@en ; ld:bloomLevel ld:Apply  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Recompute a block's Merkle root and header hash, and check a printed result against the software and the chain"@en ; ld:bloomLevel ld:Apply  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Why is data from your own full node authoritative?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "The chapter says the opposite: not because a powerful entity designated it." ; ld:distractorRationale "Bitcoin Core does not serve data; nodes get it from peers and check it." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "A powerful entity designated it as the reference" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "Your node independently verified it against every rule" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "It is downloaded from the Bitcoin Core project's servers" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A node is configured with prune=5000 and txindex=1. What does Bitcoin Core 31.1 do?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O2 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "An index of every transaction needs the old blocks that pruning deletes." ; ld:distractorRationale "Neither option is silently ignored; the release refuses the combination." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "It starts and indexes every transaction" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "It starts and ignores prune" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "It stops with 'Prune mode is incompatible with -txindex'" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Which sequence builds Bitcoin Core from source in 29.0 and later?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "That is the Autotools sequence the book prints; 29.0 replaced it." ; ld:distractorRationale "Install comes after building and configuring, and Autotools is no longer used." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "cmake -B build, then cmake --build build" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "./autogen.sh, ./configure, make" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "make install, then ./configure" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A serialized segwit transaction is 194 bytes and 125 bytes without its witness. What are its weight and virtual size?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O2 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "Weight counts non-witness bytes four times and witness bytes once, not 194 for both." ; ld:distractorRationale "4 x 125 + 69 gives 569, and 500 leaves out the 69 witness-side bytes." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "194 and 194" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "500 and 125" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "569 and 143" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Which identifier leaves the witness out of what it hashes?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "The 'hash' field includes the witness, so it differs from the txid for a segwit transaction." ; ld:distractorRationale "For Alice's transaction they differ: 4662... against f7cd...." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "The wtxid, called 'hash' in the decoded result" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "The txid" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "Neither: both hash the same bytes" .
pg:Q6 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Block 775072 is at height 775072. What subsidy does Bitcoin Core's schedule give it?"@en ; ld:hasOption pg:Q6_O0, pg:Q6_O1, pg:Q6_O2 ; ld:hasCorrectOption pg:Q6_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "Shift 50 bitcoins right once per 210,000 blocks: 775072 // 210000 is 3, not 1." ; ld:distractorRationale "12.5 bitcoins is the subsidy after two halvings, not three." .
pg:Q6_O0 a ld:AnswerOption ; rdfs:label "6.25 bitcoins" .
pg:Q6_O1 a ld:AnswerOption ; rdfs:label "25 bitcoins" .
pg:Q6_O2 a ld:AnswerOption ; rdfs:label "12.5 bitcoins" .
pg:Q7 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "The book prints a block total with a 25 BTC reward, but its script reads block 775072. What should a careful reader conclude?"@en ; ld:hasOption pg:Q7_O0, pg:Q7_O1, pg:Q7_O2 ; ld:hasCorrectOption pg:Q7_O2 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "The schedule is fixed by consensus rules and was the same when the book printed." ; ld:distractorRationale "Explorers agree with the node: the coinbase there is the 6.25 subsidy plus fees." .
pg:Q7_O0 a ld:AnswerOption ; rdfs:label "The subsidy schedule changed after the book printed" .
pg:Q7_O1 a ld:AnswerOption ; rdfs:label "Block explorers report the reward wrongly" .
pg:Q7_O2 a ld:AnswerOption ; rdfs:label "The printed figure belongs to a different block than the script reads" .
