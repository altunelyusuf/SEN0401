chx:Document a doc:ReportSection ; rdfs:label "Bitcoin Core: the reference implementation, run and checked against the book"@en ; skos:definition "This document renews chapter 3 of the 3rd edition of Mastering Bitcoin for SEN0401 (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03/research> ;
    doc:hasSection chx:S_Node, chx:S_Build, chx:S_Operation, chx:S_Interface, chx:S_Data, chx:S_Ecosystem, chx:S_Semantics .
chx:S_Node a doc:TaxonomicSection ; rdfs:label "Node"@en ; doc:sectionTitle "Node" ; doc:hierarchyLevel 1 ; doc:sectionOrder 1 ;
    skos:definition "Bitcoin Core: The Reference Implementation begins from the idea that software on your own computer can verify Bitcoin itself, without a third party (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#Node> .
chx:S_Verification a doc:TaxonomicSection ; rdfs:label "Verification"@en ; doc:sectionTitle "Verification" ; doc:hierarchyLevel 2 ; doc:sectionOrder 2 ;
    doc:hasParentSection chx:S_Node ;
    skos:definition "From Bitcoin to Bitcoin Core explains what a verifying node is and why Bitcoin Core is the reference for it (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#Verification> .
chx:S_FullNode a doc:ConceptSection ; rdfs:label "Full node"@en ; doc:sectionTitle "Full node" ; doc:hierarchyLevel 3 ; doc:sectionOrder 3 ;
    doc:hasParentSection chx:S_Verification ;
    skos:definition "A full verification node verifies every confirmed transaction against every rule, so the data it gives you is authoritative not because a powerful entity designated it so but because your node independently verified it (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#FullNode> .
chx:S_ReferenceImplementation a doc:ConceptSection ; rdfs:label "Reference implementation"@en ; doc:sectionTitle "Reference implementation" ; doc:hierarchyLevel 3 ; doc:sectionOrder 4 ;
    doc:hasParentSection chx:S_Verification ;
    skos:definition "Bitcoin Core grew out of the first Bitcoin software and is the reference implementation: it provides a reference for how each part of the technology should be implemented, and it implements wallets, validation, block construction and the peer-to-peer protocol (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#ReferenceImplementation> .
chx:S_ImprovementProposal a doc:ConceptSection ; rdfs:label "Bitcoin Improvement Proposal"@en ; doc:sectionTitle "Bitcoin Improvement Proposal" ; doc:hierarchyLevel 3 ; doc:sectionOrder 5 ;
    doc:hasParentSection chx:S_Verification ;
    skos:definition "The chapter refers to Bitcoin Improvement Proposals by number, for example BIP9 for the mechanism used for several major upgrades, and Bitcoin Core's documentation lists which BIPs it implements and since which version (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#ImprovementProposal> .
chx:S_NodeResources a doc:TaxonomicSection ; rdfs:label "Node resources"@en ; doc:sectionTitle "Node resources" ; doc:hierarchyLevel 2 ; doc:sectionOrder 6 ;
    doc:hasParentSection chx:S_Node ;
    skos:definition "Running a Bitcoin Core Node states what a node costs in disk, bandwidth and time (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#NodeResources> .
chx:S_InitialDownload a doc:ConceptSection ; rdfs:label "Initial download"@en ; doc:sectionTitle "Initial download" ; doc:hierarchyLevel 3 ; doc:sectionOrder 7 ;
    doc:hasParentSection chx:S_NodeResources ;
    skos:definition "The book puts the first download at over 500 GB and the growth at about 400 MB a day, so ten days offline means about 4 GB to catch up; the download page now says about 600 GB plus 5 to 10 GB a month (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch03#InitialDownload> .
chx:S_PrunedNode a doc:ConceptSection ; rdfs:label "Pruned node"@en ; doc:sectionTitle "Pruned node" ; doc:hierarchyLevel 3 ; doc:sectionOrder 8 ;
    doc:hasParentSection chx:S_NodeResources ;
    skos:definition "Pruning keeps a node within a disk budget by deleting old blocks, and the current help says automatic pruning needs a target of at least 550 MiB and is incompatible with txindex, where the book's constrained example uses 5000 (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch03#PrunedNode> .
chx:S_Build a doc:TaxonomicSection ; rdfs:label "Build"@en ; doc:sectionTitle "Build" ; doc:hierarchyLevel 1 ; doc:sectionOrder 9 ;
    skos:definition "Compiling Bitcoin Core from the Source Code takes a reader from the repository to installed executables (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#Build> .
chx:S_Source a doc:TaxonomicSection ; rdfs:label "Source"@en ; doc:sectionTitle "Source" ; doc:hierarchyLevel 2 ; doc:sectionOrder 10 ;
    doc:hasParentSection chx:S_Build ;
    skos:definition "The reader clones the repository and then selects a release rather than building the newest, possibly unstable, code (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#Source> .
chx:S_ReleaseTag a doc:ConceptSection ; rdfs:label "Release tag"@en ; doc:sectionTitle "Release tag" ; doc:hierarchyLevel 3 ; doc:sectionOrder 11 ;
    doc:hasParentSection chx:S_Source ;
    skos:definition "The book checks out the tag v24.0.1, then the highest release; the releases page now lists 31.1 as the newest (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch03#ReleaseTag> .
chx:S_Toolchain a doc:TaxonomicSection ; rdfs:label "Toolchain"@en ; doc:sectionTitle "Toolchain" ; doc:hierarchyLevel 2 ; doc:sectionOrder 12 ;
    doc:hasParentSection chx:S_Build ;
    skos:definition "Configuring the Bitcoin Core Build and Building the Bitcoin Core Executables give the commands that turn the source into bitcoind (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#Toolchain> .
chx:S_AutotoolsBuild a doc:ConceptSection ; rdfs:label "Autotools build"@en ; doc:sectionTitle "Autotools build" ; doc:hierarchyLevel 3 ; doc:sectionOrder 13 ;
    doc:hasParentSection chx:S_Toolchain ;
    skos:definition "The book generates the build scripts with autogen.sh, runs configure with options such as --disable-wallet, --with-gui=no and --with-incompatible-bdb, and then make, make check and make install (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#AutotoolsBuild> .
chx:S_CMakeBuild a doc:ConceptSection ; rdfs:label "CMake build"@en ; doc:sectionTitle "CMake build" ; doc:hierarchyLevel 3 ; doc:sectionOrder 14 ;
    doc:hasParentSection chx:S_Toolchain ;
    skos:definition "Bitcoin Core 29.0 migrated its build system from Autotools to CMake, so the build is cmake -B build, cmake --build build and cmake --install build, with -DENABLE_WALLET=OFF for no wallet and -DBUILD_GUI=ON for the graphical client (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch03#CMakeBuild> .
chx:S_BitcoinCommand a doc:ConceptSection ; rdfs:label "The bitcoin command"@en ; doc:sectionTitle "The bitcoin command" ; doc:hierarchyLevel 3 ; doc:sectionOrder 15 ;
    doc:hasParentSection chx:S_Toolchain ;
    skos:definition "Since 30.0 a bitcoin command starts the node with bitcoin node, calls RPC with bitcoin rpc and, with -m, runs the multiprocess binaries bitcoin-node and bitcoin-gui instead of bitcoind and bitcoin-qt (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch03#BitcoinCommand> .
chx:S_Operation a doc:TaxonomicSection ; rdfs:label "Operation"@en ; doc:sectionTitle "Operation" ; doc:hierarchyLevel 1 ; doc:sectionOrder 16 ;
    skos:definition "Configuring the Bitcoin Core Node covers the settings that decide how a node behaves and what it stores (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#Operation> .
chx:S_Configuration a doc:TaxonomicSection ; rdfs:label "Configuration"@en ; doc:sectionTitle "Configuration" ; doc:hierarchyLevel 2 ; doc:sectionOrder 17 ;
    doc:hasParentSection chx:S_Operation ;
    skos:definition "The configuration file and its options, of which the book says there are more than 100, shape the node; the 31.1 help lists 139 in its default listing (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch03#Configuration> .
chx:S_ConfigurationFile a doc:ConceptSection ; rdfs:label "Configuration file"@en ; doc:sectionTitle "Configuration file" ; doc:hierarchyLevel 3 ; doc:sectionOrder 18 ;
    doc:hasParentSection chx:S_Configuration ;
    skos:definition "Bitcoin Core looks for bitcoin.conf in its data directory on every start, and running bitcoind -printtoconsole shows the path on its first lines, as the 31.1 startup log does (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch03#ConfigurationFile> .
chx:S_DatabaseCache a doc:ConceptSection ; rdfs:label "Database cache (dbcache)"@en ; doc:sectionTitle "Database cache (dbcache)" ; doc:hierarchyLevel 3 ; doc:sectionOrder 19 ;
    doc:hasParentSection chx:S_Configuration ;
    skos:definition "The book gives the dbcache default as 450 MiB; Bitcoin Core 31.0 raised it to 1024 MiB on systems where at least 4096 MiB of memory is detected, and dbcache=450 restores the old behaviour (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch03#DatabaseCache> .
chx:S_TransactionIndex a doc:ConceptSection ; rdfs:label "Transaction index (txindex)"@en ; doc:sectionTitle "Transaction index (txindex)" ; doc:hierarchyLevel 3 ; doc:sectionOrder 20 ;
    doc:hasParentSection chx:S_Configuration ;
    skos:definition "By default a node indexes only the transactions of its own wallet; setting txindex=1 builds a complete index so that getrawtransaction can find any transaction (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#TransactionIndex> .
chx:S_Wallet a doc:TaxonomicSection ; rdfs:label "Wallet"@en ; doc:sectionTitle "Wallet" ; doc:hierarchyLevel 2 ; doc:sectionOrder 21 ;
    doc:hasParentSection chx:S_Operation ;
    skos:definition "The chapter's startup log shows the wallet database in use, which is where the current release differs (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#Wallet> .
chx:S_DescriptorWallet a doc:ConceptSection ; rdfs:label "Descriptor wallet"@en ; doc:sectionTitle "Descriptor wallet" ; doc:hierarchyLevel 3 ; doc:sectionOrder 22 ;
    doc:hasParentSection chx:S_Wallet ;
    skos:definition "Legacy BerkeleyDB wallets can no longer be created or loaded since Bitcoin Core 30.0 and can be migrated with the migratewallet RPC, and the 31.1 release creates a descriptor wallet whose format is sqlite (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch03#DescriptorWallet> .
chx:S_Interface a doc:TaxonomicSection ; rdfs:label "Interface"@en ; doc:sectionTitle "Interface" ; doc:hierarchyLevel 1 ; doc:sectionOrder 23 ;
    skos:definition "Bitcoin Core API introduces the programmatic interface that the rest of the book uses (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#Interface> .
chx:S_RpcInterface a doc:TaxonomicSection ; rdfs:label "RPC interface"@en ; doc:sectionTitle "RPC interface" ; doc:hierarchyLevel 2 ; doc:sectionOrder 24 ;
    doc:hasParentSection chx:S_Interface ;
    skos:definition "Using Bitcoin Core's Programmatic Interface explains what the API is and how a program reaches it (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#RpcInterface> .
chx:S_JsonRpc a doc:ConceptSection ; rdfs:label "JSON-RPC interface"@en ; doc:sectionTitle "JSON-RPC interface" ; doc:hierarchyLevel 3 ; doc:sectionOrder 25 ;
    doc:hasParentSection chx:S_RpcInterface ;
    skos:definition "The API is JSON-RPC over HTTP: curl posts a jsonrpc request for a method such as getblockchaininfo to 127.0.0.1 on the default port 8332 (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#JsonRpc> .
chx:S_CookieAuthentication a doc:ConceptSection ; rdfs:label "Cookie authentication"@en ; doc:sectionTitle "Cookie authentication" ; doc:hierarchyLevel 3 ; doc:sectionOrder 26 ;
    doc:hasParentSection chx:S_RpcInterface ;
    skos:definition "Bitcoin Core creates a random credential at each start and stores it as .cookie in the data directory, deleted on shutdown, and the rpcauth.py script in the source's share directory makes a static credential (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch03#CookieAuthentication> .
chx:S_Client a doc:TaxonomicSection ; rdfs:label "Client"@en ; doc:sectionTitle "Client" ; doc:hierarchyLevel 2 ; doc:sectionOrder 27 ;
    doc:hasParentSection chx:S_Interface ;
    skos:definition "The bitcoin-cli helper and a wrapper library are the two ways the chapter calls the API (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#Client> .
chx:S_CommandLineClient a doc:ConceptSection ; rdfs:label "Command-line client (bitcoin-cli)"@en ; doc:sectionTitle "Command-line client (bitcoin-cli)" ; doc:hierarchyLevel 3 ; doc:sectionOrder 28 ;
    doc:hasParentSection chx:S_Client ;
    skos:definition "The bitcoin-cli help command lists the RPC commands, and getblockchaininfo, getmempoolinfo, getnetworkinfo and getwalletinfo report the node's status (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#CommandLineClient> .
chx:S_WrapperLibrary a doc:ConceptSection ; rdfs:label "Wrapper library"@en ; doc:sectionTitle "Wrapper library" ; doc:hierarchyLevel 3 ; doc:sectionOrder 29 ;
    doc:hasParentSection chx:S_Client ;
    skos:definition "The book uses python-bitcoinlib, which is not part of Bitcoin Core, to call the API from Python, and its documentation says the RPC interface should work with Bitcoin Core 24.0 or later (Todd, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#WrapperLibrary> .
chx:S_Data a doc:TaxonomicSection ; rdfs:label "Data"@en ; doc:sectionTitle "Data" ; doc:hierarchyLevel 1 ; doc:sectionOrder 30 ;
    skos:definition "Exploring and Decoding Transactions and Exploring Blocks read the chain through the API (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#Data> .
chx:S_Transaction a doc:TaxonomicSection ; rdfs:label "Transaction"@en ; doc:sectionTitle "Transaction" ; doc:hierarchyLevel 2 ; doc:sectionOrder 31 ;
    doc:hasParentSection chx:S_Data ;
    skos:definition "The chapter retrieves Alice's payment from chapter 2 by its transaction ID and decodes it (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#Transaction> .
chx:S_DecodedTransaction a doc:ConceptSection ; rdfs:label "Decoded transaction"@en ; doc:sectionTitle "Decoded transaction" ; doc:hierarchyLevel 3 ; doc:sectionOrder 32 ;
    doc:hasParentSection chx:S_Transaction ;
    skos:definition "The getrawtransaction command returns the serialized transaction in hexadecimal and decoderawtransaction shows its parts: one input and two outputs, the payment to Bob and the change back to Alice (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#DecodedTransaction> .
chx:S_TransactionWeight a doc:ConceptSection ; rdfs:label "Transaction weight"@en ; doc:sectionTitle "Transaction weight" ; doc:hierarchyLevel 3 ; doc:sectionOrder 33 ;
    doc:hasParentSection chx:S_Transaction ;
    skos:definition "The decoded transaction reports size 194, vsize 143 and weight 569, and 143 is 569 divided by four rounded up (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#TransactionWeight> .
chx:S_TransactionIdentifier a doc:ConceptSection ; rdfs:label "Transaction identifier"@en ; doc:sectionTitle "Transaction identifier" ; doc:hierarchyLevel 3 ; doc:sectionOrder 34 ;
    doc:hasParentSection chx:S_Transaction ;
    skos:definition "A tip in the chapter warns that a txid is not authoritative because a transaction can be modified before confirmation, and the decoded result gives both the txid and the hash that includes the witness (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#TransactionIdentifier> .
chx:S_Block a doc:TaxonomicSection ; rdfs:label "Block"@en ; doc:sectionTitle "Block" ; doc:hierarchyLevel 2 ; doc:sectionOrder 35 ;
    doc:hasParentSection chx:S_Data ;
    skos:definition "Exploring Blocks finds a block by its height or its hash and reads its fields (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#Block> .
chx:S_BlockHeight a doc:ConceptSection ; rdfs:label "Block height"@en ; doc:sectionTitle "Block height" ; doc:hierarchyLevel 3 ; doc:sectionOrder 36 ;
    doc:hasParentSection chx:S_Block ;
    skos:definition "getblockhash 123456 returns the header hash of block 123456, and getblock reports 651742 confirmations, the depth of the block and so the difficulty of changing anything in it (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#BlockHeight> .
chx:S_BlockWeight a doc:ConceptSection ; rdfs:label "Block weight"@en ; doc:sectionTitle "Block weight" ; doc:hierarchyLevel 3 ; doc:sectionOrder 37 ;
    doc:hasParentSection chx:S_Block ;
    skos:definition "The getblock result gives a block's stripped size, its size and its weight, which for block 123456 is 4179, 4179 and 16716 (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#BlockWeight> .
chx:S_MerkleRoot a doc:ConceptSection ; rdfs:label "Merkle root"@en ; doc:sectionTitle "Merkle root" ; doc:hierarchyLevel 3 ; doc:sectionOrder 38 ;
    doc:hasParentSection chx:S_Block ;
    skos:definition "The getblock result shows the block's merkle root beside nonce, bits, difficulty and chainwork as the fields used for security and proof of work (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#MerkleRoot> .
chx:S_BlockSubsidy a doc:ConceptSection ; rdfs:label "Block subsidy"@en ; doc:sectionTitle "Block subsidy" ; doc:hierarchyLevel 3 ; doc:sectionOrder 39 ;
    doc:hasParentSection chx:S_Block ;
    skos:definition "The chapter says its block total includes a 25 BTC reward, while its script reads block 775072, where Bitcoin Core's own schedule gives 6.25 bitcoins (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch03#BlockSubsidy> .
chx:S_Difficulty a doc:ConceptSection ; rdfs:label "Difficulty"@en ; doc:sectionTitle "Difficulty" ; doc:hierarchyLevel 3 ; doc:sectionOrder 40 ;
    doc:hasParentSection chx:S_Block ;
    skos:definition "The difficulty of block 123456 is 157416.4018436489, which follows from its bits value 1a6a93b3 (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#Difficulty> .
chx:S_Ecosystem a doc:TaxonomicSection ; rdfs:label "Ecosystem"@en ; doc:sectionTitle "Ecosystem" ; doc:hierarchyLevel 1 ; doc:sectionOrder 41 ;
    skos:definition "Alternative Clients, Libraries, and Toolkits lists other ways to reach Bitcoin, and running the real release shows what has been checked (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#Ecosystem> .
chx:S_Assurance a doc:TaxonomicSection ; rdfs:label "Assurance"@en ; doc:sectionTitle "Assurance" ; doc:hierarchyLevel 2 ; doc:sectionOrder 42 ;
    doc:hasParentSection chx:S_Ecosystem ;
    skos:definition "Trust in a download can be tested before the software is run (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch03#Assurance> .
chx:S_ReleaseVerification a doc:ConceptSection ; rdfs:label "Release verification"@en ; doc:sectionTitle "Release verification" ; doc:hierarchyLevel 3 ; doc:sectionOrder 43 ;
    doc:hasParentSection chx:S_Assurance ;
    skos:definition "The 31.1 Linux tarball's SHA-256 equals the value in the release's SHA256SUMS, and that file carries 11 good signatures from builder keys held in the guix.sigs repository, which does not itself establish trust in those keys (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch03#ReleaseVerification> .
chx:S_AlternativeToolkit a doc:ConceptSection ; rdfs:label "Alternative toolkit"@en ; doc:sectionTitle "Alternative toolkit" ; doc:hierarchyLevel 3 ; doc:sectionOrder 44 ;
    doc:hasParentSection chx:S_Assurance ;
    skos:definition "The book lists toolkits by language, from bcoin, Bitcore and BitcoinJS to btcd, rust-bitcoin, bitcoin-s and NBitcoin, and registry data show that their upkeep varies, with the bcoin package's latest npm release dating from 2018 (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#AlternativeToolkit> .
chx:S_Semantics a doc:TaxonomicSection ; rdfs:label "Semantics"@en ; doc:sectionTitle "Semantics" ; doc:hierarchyLevel 1 ; doc:sectionOrder 45 ;
    skos:definition "The course theme of semantic technologies meets the chapter in the authority of a node's own data and in the format it returns (World Wide Web Consortium, 2020)." ; dcterms:source <http://example.org/sen0401/ch03#Semantics> .
chx:S_LinkedData a doc:TaxonomicSection ; rdfs:label "Linked data"@en ; doc:sectionTitle "Linked data" ; doc:hierarchyLevel 2 ; doc:sectionOrder 46 ;
    doc:hasParentSection chx:S_Semantics ;
    skos:definition "A node's answers are JSON, and the W3C's JSON-LD 1.1 turns JSON into Linked Data (World Wide Web Consortium, 2020)." ; dcterms:source <http://example.org/sen0401/ch03#LinkedData> .
chx:S_VerifiedData a doc:ConceptSection ; rdfs:label "Verified data"@en ; doc:sectionTitle "Verified data" ; doc:hierarchyLevel 3 ; doc:sectionOrder 47 ;
    doc:hasParentSection chx:S_LinkedData ;
    skos:definition "Data that your own node verified is authoritative for a reason that can be stated, which is what a provenance record does for any dataset (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch03#VerifiedData> .
chx:S_JsonLdContext a doc:ConceptSection ; rdfs:label "JSON-LD context"@en ; doc:sectionTitle "JSON-LD context" ; doc:hierarchyLevel 3 ; doc:sectionOrder 48 ;
    doc:hasParentSection chx:S_LinkedData ;
    skos:definition "JSON-LD 1.1 is a JSON-based format to serialize Linked Data whose syntax is designed to integrate into systems that already use JSON, such as the answers of getblock (World Wide Web Consortium, 2020)." ; dcterms:source <http://example.org/sen0401/ch03#JsonLdContext> .
