chx:IO_Process a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('rs = [range(0, 250), range(250, 500), range(500, 750), range(750, 1000)]\\nparts = [sum(r) for r in rs]\\nresult = (parts, sum(parts) == sum(range(1000)))', g), g['result'])[1])({}) evaluates to ([31125, 93625, 156125, 218625], True)"@en ; chx:input "(lambda g: (exec('rs = [range(0, 250), range(250, 500), range(500, 750), range(750, 1000)]\\nparts = [sum(r) for r in rs]\\nresult = (parts, sum(parts) == sum(range(1000)))', g), g['result'])[1])({})" ; chx:output "([31125, 93625, 156125, 218625], True)" .
