chx:X_BlockchainInfo a owl:NamedIndividual, chx:BlockchainInfo ; rdfs:label "bitcoin-cli getblockchaininfo"@en ; skos:definition "The getblockchaininfo call reports the chain the node follows: its name, the number of blocks and headers, the best block, its difficulty and chain work, whether the node is still in its initial download and whether it is pruned."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_BlockchainInfo a owl:NamedIndividual, rd:IOExample ; rdfs:label "(__import__('json').load(__import__('io').StringIO('{\\n  \"chain\": \"main\",\\n  \"blocks\": 0,\\n  \"headers\": 0,\\n  \"bestblockhash\": \"000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f\",\\n  \"bits\": \"1d00ffff\",\\n  \"target\": \"00000000ffff0000000000000000000000000000000000000000000000000000\",\\n  \"difficulty\": 1,\\n  \"time\": 1231006505,\\n  \"mediantime\": 1231006505,\\n  \"verificationprogress\": 7.061365181330129e-10,\\n  \"initialblockdownload\": true,\\n  \"chainwork\": \"0000000000000000000000000000000000000000000000000000000100010001\",\\n  \"size_on_disk\": 293,\\n  \"pruned\": false,\\n  \"warnings\": [\\n  ]\\n}\\n'))['chain'], __import__('json').load(__import__('io').StringIO('{\\n  \"chain\": \"main\",\\n  \"blocks\": 0,\\n  \"headers\": 0,\\n  \"bestblockhash\": \"000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f\",\\n  \"bits\": \"1d00ffff\",\\n  \"target\": \"00000000ffff0000000000000000000000000000000000000000000000000000\",\\n  \"difficulty\": 1,\\n  \"time\": 1231006505,\\n  \"mediantime\": 1231006505,\\n  \"verificationprogress\": 7.061365181330129e-10,\\n  \"initialblockdownload\": true,\\n  \"chainwork\": \"0000000000000000000000000000000000000000000000000000000100010001\",\\n  \"size_on_disk\": 293,\\n  \"pruned\": false,\\n  \"warnings\": [\\n  ]\\n}\\n'))['blocks'], __import__('json').load(__import__('io').StringIO('{\\n  \"chain\": \"main\",\\n  \"blocks\": 0,\\n  \"headers\": 0,\\n  \"bestblockhash\": \"000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f\",\\n  \"bits\": \"1d00ffff\",\\n  \"target\": \"00000000ffff0000000000000000000000000000000000000000000000000000\",\\n  \"difficulty\": 1,\\n  \"time\": 1231006505,\\n  \"mediantime\": 1231006505,\\n  \"verificationprogress\": 7.061365181330129e-10,\\n  \"initialblockdownload\": true,\\n  \"chainwork\": \"00000000000000000000000000000000000000000000000000000