@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

<http://example.org/sen0401/ch03/abox> a owl:Ontology ;
    rdfs:label "SEN0401 chapter 3 domain ontology - ABox"@en ; owl:versionInfo "1.2.0" ; owl:versionIRI <http://example.org/sen0401/ch03/abox/1.2.0> ; rdfs:comment "1.2.0 keeps every concept of 1.1.0 and changes only text and worked examples, so it is MINOR. Seven second-level sections closed on a paragraph that merely listed their own children, which the page's breadcrumb row already prints; each of those closing paragraphs is replaced by one that explains how the section's subject actually works, and all seven sections are brought to five paragraphs, the length the chapter's branches and concepts already have (five of them had three). Five concepts that had no worked example are given one, each executed by the chapter builder: the full node, the Autotools build, the compilation, the build prerequisites and the executables. Three concepts are left without an example on purpose - the reference implementation, open-source software and the source code - because what they state is an institutional fact rather than a computation, and an example there would restate the definition instead of teaching anything."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:created "2026-09-29"^^xsd:date ; dcterms:modified "2026-10-05"^^xsd:date ;
    dcterms:identifier "sen0401_ch03_abox_v1_2_0" ; prov:wasRevisionOf <http://example.org/sen0401/ch03/abox/1.1.0> ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/ch03-rdodi-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

chx:X_FullNode a owl:NamedIndividual, chx:FullNode ; rdfs:label "a node that verifies every rule"@en ; skos:definition "A full verification node checks every confirmed transaction against every rule of the system, so that what it reports is authoritative because it was independently verified."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_FullNode a owl:NamedIndividual, rd:IOExample ; rdfs:label "775197 + 1 evaluates to 775198"@en ; chx:input "775197 + 1" ; chx:output "775198" .
chx:X_FullNode rd:hasIOExample chx:IO_FullNode .
chx:X_ReferenceImplementation a owl:NamedIndividual, chx:ReferenceImplementation ; rdfs:label "Bitcoin Core"@en ; skos:definition "Bitcoin Core is the reference implementation: it provides a reference for how each part of the technology should be implemented."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_ImprovementProposal a owl:NamedIndividual, chx:ImprovementProposal ; rdfs:label "BIP9"@en ; skos:definition "Most major parts of the system since 2011 are documented in Bitcoin Improvement Proposals, referred to by number."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_ImprovementProposal a owl:NamedIndividual, rd:IOExample ; rdfs:label "'bip%d' % 9 evaluates to 'bip9'"@en ; chx:input "'bip%d' % 9" ; chx:output "'bip9'" .
chx:X_ImprovementProposal rd:hasIOExample chx:IO_ImprovementProposal .
chx:X_SoftFork a owl:NamedIndividual, chx:SoftFork ; rdfs:label "version bits in the block header"@en ; skos:definition "A soft fork tightens the consensus rules in a backward-compatible way; BIP 9 lets several be deployed in parallel by signalling in the block version."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_SoftFork a owl:NamedIndividual, rd:IOExample ; rdfs:label "0x20000002 >> 29 evaluates to 1"@en ; chx:input "0x20000002 >> 29" ; chx:output "1" .
chx:X_SoftFork rd:hasIOExample chx:IO_SoftFork .
chx:X_OpenSourceSoftware a owl:NamedIndividual, chx:OpenSourceSoftware ; rdfs:label "the MIT license"@en ; skos:definition "Open-source software is published with its source code under a license that lets anyone use, change and distribute it; Bitcoin Core uses the MIT license."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_SatoshiNakamoto a owl:NamedIndividual, chx:SatoshiNakamoto ; rdfs:label "the author of the whitepaper"@en ; skos:definition "Satoshi Nakamoto is the name under which Bitcoin was described in 2008 and its first software released; the identity of the person or people behind the name is unknown."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_SatoshiNakamoto a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('datetime').datetime.fromtimestamp(1231006505, __import__('datetime').timezone.utc).date().isoformat() evaluates to '2009-01-03'"@en ; chx:input "__import__('datetime').datetime.fromtimestamp(1231006505, __import__('datetime').timezone.utc).date().isoformat()" ; chx:output "'2009-01-03'" .
chx:X_SatoshiNakamoto rd:hasIOExample chx:IO_SatoshiNakamoto .
chx:X_InitialDownload a owl:NamedIndividual, chx:InitialDownload ; rdfs:label "the first synchronization"@en ; skos:definition "A new node downloads and validates the whole chain before it can process transactions, and a node that was off for ten days downloads about four gigabytes at 400 megabytes a day."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_InitialDownload a owl:NamedIndividual, rd:IOExample ; rdfs:label "400 * 10 / 1000 evaluates to 4.0"@en ; chx:input "400 * 10 / 1000" ; chx:output "4.0" .
chx:X_InitialDownload rd:hasIOExample chx:IO_InitialDownload .
chx:X_PrunedNode a owl:NamedIndividual, chx:PrunedNode ; rdfs:label "a node that deletes old blocks"@en ; skos:definition "A pruned node deletes old blocks to reduce disk use while still downloading and verifying the whole chain; automatic pruning needs a target of at least 550 MiB."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_PrunedNode a owl:NamedIndividual, rd:IOExample ; rdfs:label "5000 >= 550 evaluates to True"@en ; chx:input "5000 >= 550" ; chx:output "True" .
chx:X_PrunedNode rd:hasIOExample chx:IO_PrunedNode .
chx:X_Peer a owl:NamedIndividual, chx:Peer ; rdfs:label "a node connected to my node"@en ; skos:definition "A peer is another node with which a node keeps a connection to exchange blocks and transactions; a node limits how many it keeps."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_Peer a owl:NamedIndividual, rd:IOExample ; rdfs:label "8 + 2 evaluates to 10"@en ; chx:input "8 + 2" ; chx:output "10" .
chx:X_Peer rd:hasIOExample chx:IO_Peer .
chx:X_UtxoSet a owl:NamedIndividual, chx:UtxoSet ; rdfs:label "the chainstate database"@en ; skos:definition "The set of unspent transaction outputs is the compact record of everything that can still be spent; a node updates it for every block and it is the data that the database cache holds."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_UtxoSet a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted((set(['4ac5:1', 'x:0']) - {'4ac5:1'}) | {'4662:0', '4662:1'}) evaluates to ['4662:0', '4662:1', 'x:0']"@en ; chx:input "sorted((set(['4ac5:1', 'x:0']) - {'4ac5:1'}) | {'4662:0', '4662:1'})" ; chx:output "['4662:0', '4662:1', 'x:0']" .
chx:X_UtxoSet rd:hasIOExample chx:IO_UtxoSet .
chx:X_ReleaseTag a owl:NamedIndividual, chx:ReleaseTag ; rdfs:label "git checkout v24.0.1"@en ; skos:definition "A release tag marks a snapshot of the source by version number; release candidates carry the suffix rc and stable releases none."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_ReleaseTag a owl:NamedIndividual, rd:IOExample ; rdfs:label "'v24.0.1'.lstrip('v').split('.') evaluates to ['24', '0', '1']"@en ; chx:input "'v24.0.1'.lstrip('v').split('.')" ; chx:output "['24', '0', '1']" .
chx:X_ReleaseTag rd:hasIOExample chx:IO_ReleaseTag .
chx:X_SourceCode a owl:NamedIndividual, chx:SourceCode ; rdfs:label "the Bitcoin Core repository"@en ; skos:definition "Source code is the human-readable text of a program, mainly C++ in Bitcoin Core, from which the executables are built; it can be read and audited by anyone."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_GitRepository a owl:NamedIndividual, chx:GitRepository ; rdfs:label "git clone and git tag"@en ; skos:definition "Git is a distributed version control system; cloning copies the whole repository with its history and a commit is named by a long hash."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_GitRepository a owl:NamedIndividual, rd:IOExample ; rdfs:label "len('05bc2f53ce0cb239c17dbdd6b261bd2db7d2a940') evaluates to 40"@en ; chx:input "len('05bc2f53ce0cb239c17dbdd6b261bd2db7d2a940')" ; chx:output "40" .
chx:X_GitRepository rd:hasIOExample chx:IO_GitRepository .
chx:X_ReleaseCandidate a owl:NamedIndividual, chx:ReleaseCandidate ; rdfs:label "v0.12.0rc1"@en ; skos:definition "Release candidates, intended for testing, carry the suffix rc; stable releases that can run on production systems have no suffix."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_ReleaseCandidate a owl:NamedIndividual, rd:IOExample ; rdfs:label "[t for t in ['v0.11.2', 'v0.11.2rc1', 'v0.12.0rc2'] if 'rc' not in t] evaluates to ['v0.11.2']"@en ; chx:input "[t for t in ['v0.11.2', 'v0.11.2rc1', 'v0.12.0rc2'] if 'rc' not in t]" ; chx:output "['v0.11.2']" .
chx:X_ReleaseCandidate rd:hasIOExample chx:IO_ReleaseCandidate .
chx:X_AutotoolsBuild a owl:NamedIndividual, chx:AutotoolsBuild ; rdfs:label "autogen.sh, configure and make"@en ; skos:definition "The book builds bitcoind with autogen.sh, configure and make, options such as --disable-wallet and --with-gui=no shaping the build; Bitcoin Core replaced this with CMake."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_AutotoolsBuild a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda old, new: (len(old), len(new)))(['./autogen.sh', './configure', 'make'], ['cmake -B build', 'cmake --build build']) evaluates to (3, 2)"@en ; chx:input "(lambda old, new: (len(old), len(new)))(['./autogen.sh', './configure', 'make'], ['cmake -B build', 'cmake --build build'])" ; chx:output "(3, 2)" .
chx:X_AutotoolsBuild rd:hasIOExample chx:IO_AutotoolsBuild .
chx:X_CMakeBuild a owl:NamedIndividual, chx:CMakeBuild ; rdfs:label "cmake -B build"@en ; skos:definition "A current build is cmake -B build, cmake --build build and cmake --install build, with options such as -DENABLE_WALLET=OFF and -DBUILD_GUI=ON."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_CMakeBuild a owl:NamedIndividual, rd:IOExample ; rdfs:label "{'--disable-wallet': '-DENABLE_WALLET=OFF'}['--disable-wallet'] evaluates to '-DENABLE_WALLET=OFF'"@en ; chx:input "{'--disable-wallet': '-DENABLE_WALLET=OFF'}['--disable-wallet']" ; chx:output "'-DENABLE_WALLET=OFF'" .
chx:X_CMakeBuild rd:hasIOExample chx:IO_CMakeBuild .
chx:X_BitcoinCommand a owl:NamedIndividual, chx:BitcoinCommand ; rdfs:label "bitcoin -m node"@en ; skos:definition "The bitcoin command is a front door to the node and tools, and its -m option runs the multiprocess binaries instead of the monolithic ones."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_BitcoinCommand a owl:NamedIndividual, rd:IOExample ; rdfs:label "{'node': 'bitcoind', 'rpc': 'bitcoin-cli -named', 'tx': 'bitcoin-tx'}['rpc'] evaluates to 'bitcoin-cli -named'"@en ; chx:input "{'node': 'bitcoind', 'rpc': 'bitcoin-cli -named', 'tx': 'bitcoin-tx'}['rpc']" ; chx:output "'bitcoin-cli -named'" .
chx:X_BitcoinCommand rd:hasIOExample chx:IO_BitcoinCommand .
chx:X_Compilation a owl:NamedIndividual, chx:Compilation ; rdfs:label "make and the lines that begin with CXX"@en ; skos:definition "Compilation translates the source files into executable programs; it takes up to an hour, can be resumed, and is followed by the unit tests."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_Compilation a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda per_process, jobs: (per_process, jobs, round(per_process * jobs, 1)))(1.5, 4) evaluates to (1.5, 4, 6.0)"@en ; chx:input "(lambda per_process, jobs: (per_process, jobs, round(per_process * jobs, 1)))(1.5, 4)" ; chx:output "(1.5, 4, 6.0)" .
chx:X_Compilation rd:hasIOExample chx:IO_Compilation .
chx:X_BuildPrerequisite a owl:NamedIndividual, chx:BuildPrerequisite ; rdfs:label "libraries installed before the build"@en ; skos:definition "The build prerequisites are the libraries and tools that must be present before compiling; a missing one makes configuration fail and can be installed afterwards."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_BuildPrerequisite a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda req, wallet: (len(req.split()), len(wallet.split()), len((req + ' ' + wallet).split())))('build-essential cmake python3 libboost-dev', 'libsqlite3-dev') evaluates to (4, 1, 5)"@en ; chx:input "(lambda req, wallet: (len(req.split()), len(wallet.split()), len((req + ' ' + wallet).split())))('build-essential cmake python3 libboost-dev', 'libsqlite3-dev')" ; chx:output "(4, 1, 5)" .
chx:X_BuildPrerequisite rd:hasIOExample chx:IO_BuildPrerequisite .
chx:X_Executable a owl:NamedIndividual, chx:Executable ; rdfs:label "bitcoind, bitcoin-cli, bitcoin-tx"@en ; skos:definition "The build produces several executables: bitcoind is the node, bitcoin-cli the command-line client, bitcoin-tx a transaction tool, and others for the wallet and the graphical interface."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_Executable a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda b, l: (len(b), len(l), len(b) + len(l)))(['bitcoin', 'bitcoin-cli', 'bitcoin-qt', 'bitcoin-tx', 'bitcoin-util', 'bitcoin-wallet', 'bitcoind'], ['bitcoin-gui', 'bitcoin-node', 'test_bitcoin']) evaluates to (7, 3, 10)"@en ; chx:input "(lambda b, l: (len(b), len(l), len(b) + len(l)))(['bitcoin', 'bitcoin-cli', 'bitcoin-qt', 'bitcoin-tx', 'bitcoin-util', 'bitcoin-wallet', 'bitcoind'], ['bitcoin-gui', 'bitcoin-node', 'test_bitcoin'])" ; chx:output "(7, 3, 10)" .
chx:X_Executable rd:hasIOExample chx:IO_Executable .
chx:X_ConfigurationFile a owl:NamedIndividual, chx:ConfigurationFile ; rdfs:label "bitcoin.conf in the data directory"@en ; skos:definition "Bitcoin Core reads bitcoin.conf from its data directory at every start; options can also be given on the command line, and bitcoind -printtoconsole shows where the file is looked for."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_ConfigurationFile a owl:NamedIndividual, rd:IOExample ; rdfs:label "dict(l.split('=', 1) for l in 'datadir=/lotsofspace/bitcoin\\ntxindex=1'.splitlines()) evaluates to {'datadir': '/lotsofspace/bitcoin', 'txindex': '1'}"@en ; chx:input "dict(l.split('=', 1) for l in 'datadir=/lotsofspace/bitcoin\\ntxindex=1'.splitlines())" ; chx:output "{'datadir': '/lotsofspace/bitcoin', 'txindex': '1'}" .
chx:X_ConfigurationFile rd:hasIOExample chx:IO_ConfigurationFile .
chx:X_ConfigurationOption a owl:NamedIndividual, chx:ConfigurationOption ; rdfs:label "dbcache on the command line and in the file"@en ; skos:definition "An option has a name and a value and can come from the file, from the dynamic settings file or from the command line; the command line wins."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_ConfigurationOption a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda conf, cli: {**conf, **cli})({'dbcache': '450', 'txindex': '1'}, {'dbcache': '2048'}) evaluates to {'dbcache': '2048', 'txindex': '1'}"@en ; chx:input "(lambda conf, cli: {**conf, **cli})({'dbcache': '450', 'txindex': '1'}, {'dbcache': '2048'})" ; chx:output "{'dbcache': '2048', 'txindex': '1'}" .
chx:X_ConfigurationOption rd:hasIOExample chx:IO_ConfigurationOption .
chx:X_DataDirectory a owl:NamedIndividual, chx:DataDirectory ; rdfs:label "the .bitcoin folder"@en ; skos:definition "The data directory is where Bitcoin Core keeps the blocks, the unspent-output database, the logs and the wallets; its default place depends on the system and its contents on the network."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_DataDirectory a owl:NamedIndividual, rd:IOExample ; rdfs:label "{'main': '', 'test': 'testnet3/', 'testnet4': 'testnet4/', 'signet': 'signet/', 'regtest': 'regtest/'}['regtest'] evaluates to 'regtest/'"@en ; chx:input "{'main': '', 'test': 'testnet3/', 'testnet4': 'testnet4/', 'signet': 'signet/', 'regtest': 'regtest/'}['regtest']" ; chx:output "'regtest/'" .
chx:X_DataDirectory rd:hasIOExample chx:IO_DataDirectory .
chx:X_DatabaseCache a owl:NamedIndividual, chx:DatabaseCache ; rdfs:label "dbcache"@en ; skos:definition "The dbcache option sizes the cache of the unspent-output set: 450 MiB by default in the book, 1024 MiB by default from Bitcoin Core 31.0 on machines with enough memory."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_DatabaseCache a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('M = 2**20\\nt = 1024 * M\\na = min(t // 8, 2 * M)\\nt -= a\\nb = min(t // 2, 8 * M)\\nt -= b\\nresult = (a // M, b // M, t // M)', g), g['result'])[1])({}) evaluates to (2, 8, 1014)"@en ; chx:input "(lambda g: (exec('M = 2**20\\nt = 1024 * M\\na = min(t // 8, 2 * M)\\nt -= a\\nb = min(t // 2, 8 * M)\\nt -= b\\nresult = (a // M, b // M, t // M)', g), g['result'])[1])({})" ; chx:output "(2, 8, 1014)" .
chx:X_DatabaseCache rd:hasIOExample chx:IO_DatabaseCache .
chx:X_TransactionIndex a owl:NamedIndividual, chx:TransactionIndex ; rdfs:label "txindex=1"@en ; skos:definition "The txindex option builds an index of every transaction so that getrawtransaction can find any of them; it cannot be combined with pruning."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_TransactionIndex a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(1024 * 10 / 100, 1) evaluates to 102.4"@en ; chx:input "round(1024 * 10 / 100, 1)" ; chx:output "102.4" .
chx:X_TransactionIndex rd:hasIOExample chx:IO_TransactionIndex .
chx:X_BlocksOnlyMode a owl:NamedIndividual, chx:BlocksOnlyMode ; rdfs:label "blocksonly=1"@en ; skos:definition "In blocks-only mode a node accepts blocks from its peers but not unconfirmed transactions, which saves bandwidth and memory."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_BlocksOnlyMode a owl:NamedIndividual, rd:IOExample ; rdfs:label "300 // 5 evaluates to 60"@en ; chx:input "300 // 5" ; chx:output "60" .
chx:X_BlocksOnlyMode rd:hasIOExample chx:IO_BlocksOnlyMode .
chx:X_MempoolLimit a owl:NamedIndividual, chx:MempoolLimit ; rdfs:label "maxmempool=150"@en ; skos:definition "The maxmempool option limits the memory used for unconfirmed transactions; the default is 300 megabytes, and unused mempool memory is lent to the database cache."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_MempoolLimit a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(300 * 10**6 / 2**20, 1) evaluates to 286.1"@en ; chx:input "round(300 * 10**6 / 2**20, 1)" ; chx:output "286.1" .
chx:X_MempoolLimit rd:hasIOExample chx:IO_MempoolLimit .
chx:X_AlertNotify a owl:NamedIndividual, chx:AlertNotify ; rdfs:label "alertnotify=myemailscript.sh"@en ; skos:definition "The alertnotify option runs a command of the owner's choice when the node raises an alert, replacing %s with the message, which the node first cleans and puts in single quotes."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_AlertNotify a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import string\\nsafe = string.ascii_letters + string.digits + \\' .,;-_/:?@()\\'\\nmsg = \"x\\'; reboot; \\'\"\\ntext = \"\\'\" + \\'\\'.join(c for c in msg if c in safe) + \"\\'\"\\nresult = \\'myemailscript.sh \"Alert: %s\"\\'.replace(\\'%s\\', text)', g), g['result'])[1])({}) evaluates to 'myemailscript.sh \"Alert: \\'x; reboot; \\'\"'"@en ; chx:input "(lambda g: (exec('import string\\nsafe = string.ascii_letters + string.digits + \\' .,;-_/:?@()\\'\\nmsg = \"x\\'; reboot; \\'\"\\ntext = \"\\'\" + \\'\\'.join(c for c in msg if c in safe) + \"\\'\"\\nresult = \\'myemailscript.sh \"Alert: %s\"\\'.replace(\\'%s\\', text)', g), g['result'])[1])({})" ; chx:output "'myemailscript.sh \"Alert: \\'x; reboot; \\'\"'" .
chx:X_AlertNotify rd:hasIOExample chx:IO_AlertNotify .
chx:X_Daemon a owl:NamedIndividual, chx:Daemon ; rdfs:label "bitcoind -daemon"@en ; skos:definition "A daemon is a program that runs in the background; bitcoind -daemon detaches from the terminal, and init scripts such as the systemd unit start it at boot and restart it after a failure."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_Daemon a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('text = \"\\\\nExecStart=/usr/bin/bitcoind -pid=/run/bitcoind/bitcoind.pid \\\\\\\\\\\\n                            -conf=/etc/bitcoin/bitcoin.conf \\\\\\\\\\\\n                            -datadir=/var/lib/bitcoind \\\\\\\\\\\\n                            -startupnotify=\\'systemd-notify --ready\\' \\\\\\\\\\\\n                            -shutdownnotify=\\'systemd-notify --stopping\\'\\\\n\\\\n# Make sure the config directory is readable by the service user\\\\nExecStartPre\"\\nline = text.split(\\'\\\\nExecStart=\\')[1].split(\\'ExecStartPre\\')[0]\\nresult = [w.split(\\'=\\')[0] for w in line.split() if w.startswith(\\'-\\') and not w.startswith(\\'--\\')]', g), g['result'])[1])({}) evaluates to ['-pid', '-conf', '-datadir', '-startupnotify', '-shutdownnotify']"@en ; chx:input "(lambda g: (exec('text = \"\\\\nExecStart=/usr/bin/bitcoind -pid=/run/bitcoind/bitcoind.pid \\\\\\\\\\\\n                            -conf=/etc/bitcoin/bitcoin.conf \\\\\\\\\\\\n                            -datadir=/var/lib/bitcoind \\\\\\\\\\\\n                            -startupnotify=\\'systemd-notify --ready\\' \\\\\\\\\\\\n                            -shutdownnotify=\\'systemd-notify --stopping\\'\\\\n\\\\n# Make sure the config directory is readable by the service user\\\\nExecStartPre\"\\nline = text.split(\\'\\\\nExecStart=\\')[1].split(\\'ExecStartPre\\')[0]\\nresult = [w.split(\\'=\\')[0] for w in line.split() if w.startswith(\\'-\\') and not w.startswith(\\'--\\')]', g), g['result'])[1])({})" ; chx:output "['-pid', '-conf', '-datadir', '-startupnotify', '-shutdownnotify']" .
chx:X_Daemon rd:hasIOExample chx:IO_Daemon .
chx:X_StartupLog a owl:NamedIndividual, chx:StartupLog ; rdfs:label "bitcoind -printtoconsole"@en ; skos:definition "While it starts, the node prints a log of what it is setting up: its version, the settings read, the connection limits, the interface it opens, the wallet database and the cache sizes."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
