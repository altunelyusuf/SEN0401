chx:X_OutputDescriptor a owl:NamedIndividual, chx:OutputDescriptor ; rdfs:label "wpkh(02f9...)#8zl0zxma"@en ; skos:definition "An output descriptor is a short text that describes a set of output scripts, optionally followed by an 8-character checksum that detects typing and copying errors."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_OutputDescriptor a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('\\nINPUT_CHARSET = \"0123456789()[],\\'/*abcdefgh@:$%{}IJKLMNOPQRSTUVWXYZ&+-.;<=>?!^_|~ijklmnopqrstuvwxyzABCDEFGH`#\\\\\"\\\\\\\\ \"\\nCHECKSUM_CHARSET = \"qpzry9x8gf2tvdw0s3jn54khce6mua7l\"\\nGENERATOR = [0xf5dee51989, 0xa9fdca3312, 0x1bab10e32d, 0x3706b1677a, 0x644d626ffd]\\ndef descsum_polymod(symbols):\\n    chk = 1\\n    for value in symbols:\\n        top = chk >> 35\\n        chk = (chk & 0x7ffffffff) << 5 ^ value\\n        for i in range(5):\\n            chk ^= GENERATOR[i] if ((top >> i) & 1) else 0\\n    return chk\\ndef descsum_expand(s):\\n    groups = []\\n    symbols = []\\n    for c in s:\\n        if not c in INPUT_CHARSET:\\n            return None\\n        v = INPUT_CHARSET.find(c)\\n        symbols.append(v & 31)\\n        groups.append(v >> 5)\\n        if len(groups) == 3:\\n            symbols.append(groups[0] * 9 + groups[1] * 3 + groups[2])\\n            groups = []\\n    if len(groups) == 1:\\n        symbols.append(groups[0])\\n    elif len(groups) == 2:\\n        symbols.append(groups[0] * 3 + groups[1])\\n    return symbols\\ndef descsum_check(s):\\n    if s[-9] != \\'#\\':\\n        return False\\n    if not all(x in CHECKSUM_CHARSET for x in s[-8:]):\\n        return False\\n    symbols = descsum_expand(s[:-9]) + [CHECKSUM_CHARSET.find(x) for x in s[-8:]]\\n    return descsum_polymod(symbols) == 1\\ndef descsum_create(s):\\n    symbols = descsum_expand(s) + [0, 0, 0, 0, 0, 0, 0, 0]\\n    checksum = descsum_polymod(symbols) ^ 1\\n    return s + \\'#\\' + \\'\\'.join(CHECKSUM_CHARSET[(checksum >> (5 * (7 - i))) & 31] for i in range(8))\\n\\nresult = descsum_create(\\'wpkh(02f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9)\\')[-9:]', g), g['result'])[1])({}) evaluates to '#8zl0zxma'"@en ; chx:input "(lambda g: (exec('\\nINPUT_CHARSET = \"0123456789()[],\\'/*abcdefgh@:$%{}IJKLMNOPQRSTUVWXYZ&+-.;<=>?!^_|~ijklmnopqrstuvwxyzABCDEFGH`#\\\\\"\\\\\\\\ \"\\nCHECKSUM_CHARSET = \"qpzry9x8gf2tvdw0s3jn54khce6mua7l\"\\nGENERATOR = [0xf5dee51989, 0xa9fdca3312, 0x1bab10e32d, 0x3706b1677a, 0x644d626ffd]\\ndef descsum_polymod(symbols):\\n    chk = 1\\n    for value in symbols:\\n        top = chk >> 35\\n        chk = (chk & 0x7ffffffff) << 5 ^ value\\n        for i in range(5):\\n            chk ^= GENERATOR[i] if ((top >> i) & 1) else 0\\n    return chk\\ndef descsum_expand(s):\\n    groups = []\\n    symbols = []\\n    for c in s:\\n        if not c in INPUT_CHARSET:\\n            return None\\n        v = INPUT_CHARSET.find(c)\\n        symbols.append(v & 31)\\n        groups.append(v >> 5)\\n        if len(groups) == 3:\\n            symbols.append(groups[0] * 9 + groups[1] * 3 + groups[2])\\n            groups = []\\n    if len(groups) == 1:\\n        symbols.append(groups[0])\\n    elif len(groups) == 2:\\n        symbols.append(groups[0] * 3 + groups[1])\\n    return symbols\\ndef descsum_check(s):\\n    if s[-9] != \\'#\\':\\n        return False\\n    if not all(x in CHECKSUM_CHARSET for x in s[-8:]):\\n        return False\\n    symbols = descsum_expand(s[:-9]) + [CHECKSUM_CHARSET.find(x) for x in s[-8:]]\\n    return descsum_polymod(symbols) == 1\\ndef descsum_create(s):\\n    symbols = descsum_expand(s) + [0, 0, 0, 0, 0, 0, 0, 0]\\n    checksum = descsum_polymod(symbols) ^ 1\\n    return s + \\'#\\' + \\'\\'.join(CHECKSUM_CHARSET[(checksum >> (5 * (7 - i))) & 31] for i in range(8))\\n\\nresult = descsum_create(\\'wpkh(02f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9)\\')[-9:]', g), g['result'])[1])({})" ; chx:output "'#8zl0zxma'" .
chx:X_OutputDescriptor rd:hasIOExample chx:IO_OutputDescriptor .
chx:X_Api a owl:NamedIndividual, chx:Api ; rdfs:label "the Bitcoin Core API"@en ; skos:definition "An application programming interface is the set of requests that one program offers to other programs; Bitcoin Core's API lets a program ask the node about the chain, the mempool and the wallet."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_Api a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import json\\nresult = json.loads(\\'{\"result\": 6, \"error\": null, \"id\": 1}\\')[\\'result\\']', g), g['result'])[1])({}) evaluates to 6"@en ; chx:input "(lambda g: (exec('import json\\nresult = json.loads(\\'{\"result\": 6, \"error\": null, \"id\": 1}\\')[\\'result\\']', g), g['result'])[1])({})" ; chx:output "6" .
chx:X_Api rd:hasIOExample chx:IO_Api .
chx:X_JsonRpc a owl:NamedIndividual, chx:JsonRpc ; rdfs:label "a getblockchaininfo call over HTTP"@en ; skos:definition "Bitcoin Core's API is JSON-RPC over HTTP, by default to 127.0.0.1 on port 8332, so any program that can make an HTTP request can call it."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_JsonRpc a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import json\\nbody = json.dumps({'jsonrpc': '1.0', 'id': 'curltest', 'method': 'getblockchaininfo', 'params': []})\\nresult = json.loads(body)['method']\", g), g['result'])[1])({}) evaluates to 'getblockchaininfo'"@en ; chx:input "(lambda g: (exec(\"import json\\nbody = json.dumps({'jsonrpc': '1.0', 'id': 'curltest', 'method': 'getblockchaininfo', 'params': []})\\nresult = json.loads(body)['method']\", g), g['result'])[1])({})" ; chx:output "'getblockchaininfo'" .
chx:X_JsonRpc rd:hasIOExample chx:IO_JsonRpc .
chx:X_JsonFormat a owl:NamedIndividual, chx:JsonFormat ; rdfs:label "the answer of getblockchaininfo"@en ; skos:definition "JSON is a text format for structured data made of objects, arrays, strings, numbers, booleans and null; every answer of Bitcoin Core's API is written in it."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_JsonFormat a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import json\\nt = \\'{\"result\":{\"chain\":\"main\",\"blocks\":799278,\"headers\":799278,\\\\n\"bestblockhash\":\"000000000000000000018387c50988ec705a95d6f765b206b6629971e6978879\",\\\\n\"difficulty\":53911173001054.59,\"time\":1689703111,\"mediantime\":1689701260,\\\\n\"verificationprogress\":0.9999979206082515,\"initialblockdownload\":false,\\\\n\"chainwork\":\"00000000000000000000000000000000000000004f3e111bf32bcb47f9dfad5b\",\\\\n\"size_on_disk\":563894577967,\"pruned\":false,\"warnings\":\"\"},\"error\":null,\\\\n\"id\":\"curltest\"}\\'\\ni = t.index(\\'{\"result\":{\"chain\"\\')\\nj = t.index(\\'\"id\":\"curltest\"}\\', i) + len(\\'\"id\":\"curltest\"}\\')\\nr = json.loads(\\'\\'.join(t[i:j].split()))\\nresult = (r[\\'result\\'][\\'chain\\'], r[\\'result\\'][\\'blocks\\'], r[\\'error\\'], r[\\'id\\'])', g), g['result'])[1])({}) evaluates to ('main', 799278, None, 'curltest')"@en ; chx:input "(lambda g: (exec('import json\\nt = \\'{\"result\":{\"chain\":\"main\",\"blocks\":799278,\"headers\":799278,\\\\n\"bestblockhash\":\"000000000000000000018387c50988ec705a95d6f765b206b6629971e6978879\",\\\\n\"difficulty\":53911173001054.59,\"time\":1689703111,\"mediantime\":1689701260,\\\\n\"verificationprogress\":0.9999979206082515,\"initialblockdownload\":false,\\\\n\"chainwork\":\"00000000000000000000000000000000000000004f3e111bf32bcb47f9dfad5b\",\\\\n\"size_on_disk\":563894577967,\"pruned\":false,\"warnings\":\"\"},\"error\":null,\\\\n\"id\":\"curltest\"}\\'\\ni = t.index(\\'{\"result\":{\"chain\"\\')\\nj = t.index(\\'\"id\":\"curltest\"}\\', i) + len(\\'\"id\":\"curltest\"}\\')\\nr = json.loads(\\'\\'.join(t[i:j].split()))\\nresult = (r[\\'result\\'][\\'chain\\'], r[\\'result\\'][\\'blocks\\'], r[\\'error\\'], r[\\'id\\'])', g), g['result'])[1])({})" ; chx:output "('main', 799278, None, 'curltest')" .
chx:X_JsonFormat rd:hasIOExample chx:IO_JsonFormat .
chx:X_HttpRequest a owl:NamedIndividual, chx:HttpRequest ; rdfs:label "curl with --data-binary"@en ; skos:definition "HTTP is the request-and-response protocol of the web; Bitcoin Core receives each JSON-RPC call as the body of an HTTP POST request and sends the answer as the body of the HTTP response."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_HttpRequest a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import base64\\nresult = 'Basic ' + base64.b64encode(b'alice:secret').decode()\", g), g['result'])[1])({}) evaluates to 'Basic YWxpY2U6c2VjcmV0'"@en ; chx:input "(lambda g: (exec(\"import base64\\nresult = 'Basic ' + base64.b64encode(b'alice:secret').decode()\", g), g['result'])[1])({})" ; chx:output "'Basic YWxpY2U6c2VjcmV0'" .
chx:X_HttpRequest rd:hasIOExample chx:IO_HttpRequest .
chx:X_CookieAuthentication a owl:NamedIndividual, chx:CookieAuthentication ; rdfs:label "the .cookie file"@en ; skos:definition "By default Bitcoin Core creates a random credential on each start and stores it in the data directory as .cookie, which bitcoin-cli reads; rpcauth.py makes a static credential instead."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_CookieAuthentication a owl:NamedIndividual, rd:IOExample ; rdfs:label "(len('17c9b71cef21b893e1a019f4bc071950c7942f49796ed061b274031b17b19cd0'), len(bytes.fromhex('17c9b71cef21b893e1a019f4bc071950c7942f49796ed061b274031b17b19cd0'))) evaluates to (64, 32)"@en ; chx:input "(len('17c9b71cef21b893e1a019f4bc071950c7942f49796ed061b274031b17b19cd0'), len(bytes.fromhex('17c9b71cef21b893e1a019f4bc071950c7942f49796ed061b274031b17b19cd0')))" ; chx:output "(64, 32)" .
chx:X_CookieAuthentication rd:hasIOExample chx:IO_CookieAuthentication .
chx:X_RpcAuth a owl:NamedIndividual, chx:RpcAuth ; rdfs:label "rpcauth=alice:salt$hash"@en ; skos:definition "The rpcauth option holds a user name, a random salt and the HMAC-SHA256 of the password under that salt, so the file never contains the password itself."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_RpcAuth a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hmac\\nsalt = '00112233445566778899aabbccddeeff'\\npw = 'correct horse'\\ndigest = hmac.new(salt.encode('utf-8'), pw.encode('utf-8'), 'SHA256').hexdigest()\\nline = 'alice:' + salt + '$' + digest\\nresult = [len(x) for x in line.replace('$', ':').split(':')]\", g), g['result'])[1])({}) evaluates to [5, 32, 64]"@en ; chx:input "(lambda g: (exec(\"import hmac\\nsalt = '00112233445566778899aabbccddeeff'\\npw = 'correct horse'\\ndigest = hmac.new(salt.encode('utf-8'), pw.encode('utf-8'), 'SHA256').hexdigest()\\nline = 'alice:' + salt + '$' + digest\\nresult = [len(x) for x in line.replace('$', ':').split(':')]\", g), g['result'])[1])({})" ; chx:output "[5, 32, 64]" .
chx:X_RpcAuth rd:hasIOExample chx:IO_RpcAuth .
chx:X_CommandLine a owl:NamedIndividual, chx:CommandLine ; rdfs:label "the terminal and the $ prompt"@en ; skos:definition "The command line is a text interface in which a person types the name of a program followed by arguments and reads the program's text output."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_CommandLine a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import shlex\\nresult = shlex.split('bitcoin-cli getblockhash 1000')\", g), g['result'])[1])({}) evaluates to ['bitcoin-cli', 'getblockhash', '1000']"@en ; chx:input "(lambda g: (exec(\"import shlex\\nresult = shlex.split('bitcoin-cli getblockhash 1000')\", g), g['result'])[1])({})" ; chx:output "['bitcoin-cli', 'getblockhash', '1000']" .
