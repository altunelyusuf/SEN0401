chx:X_CommandLineClient a owl:NamedIndividual, chx:CommandLineClient ; rdfs:label "bitcoin-cli getblockchaininfo"@en ; skos:definition "The bitcoin-cli helper sends the same calls the API offers, which makes it the way to experiment interactively; its help command lists the available RPC commands."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_CommandLineClient a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import json\\nb = json.load(__import__(\\'io\\').StringIO(\\'{\\\\n \"source\": \"https://blockstream.info/api\",\\\\n \"read\": \"2026-10-02\",\\\\n \"id\": \"00000000c937983704a73af28acdec37b049d214adbda81d7e2a3dd146f6ed09\",\\\\n \"height\": 1000,\\\\n \"version\": 1,\\\\n \"timestamp\": 1232346882,\\\\n \"tx_count\": 1,\\\\n \"size\": 216,\\\\n \"weight\": 864,\\\\n \"merkle_root\": \"fe28050b93faea61fa88c4c630f0e1f0a1c24d0082dd0e10d369e13212128f33\",\\\\n \"previousblockhash\": \"0000000008e647742775a230787d66fdf92c46a48c896bfbc85cdc8acc67e87d\",\\\\n \"mediantime\": 1232344831,\\\\n \"nonce\": 2595206198,\\\\n \"bits\": 486604799,\\\\n \"difficulty\": 1.0\\\\n}\\'))\\nresult = b[\\'id\\']', g), g['result'])[1])({}) evaluates to '00000000c937983704a73af28acdec37b049d214adbda81d7e2a3dd146f6ed09'"@en ; chx:input "(lambda g: (exec('import json\\nb = json.load(__import__(\\'io\\').StringIO(\\'{\\\\n \"source\": \"https://blockstream.info/api\",\\\\n \"read\": \"2026-10-02\",\\\\n \"id\": \"00000000c937983704a73af28acdec37b049d214adbda81d7e2a3dd146f6ed09\",\\\\n \"height\": 1000,\\\\n \"version\": 1,\\\\n \"timestamp\": 1232346882,\\\\n \"tx_count\": 1,\\\\n \"size\": 216,\\\\n \"weight\": 864,\\\\n \"merkle_root\": \"fe28050b93faea61fa88c4c630f0e1f0a1c24d0082dd0e10d369e13212128f33\",\\\\n \"previousblockhash\": \"0000000008e647742775a230787d66fdf92c46a48c896bfbc85cdc8acc67e87d\",\\\\n \"mediantime\": 1232344831,\\\\n \"nonce\": 2595206198,\\\\n \"bits\": 486604799,\\\\n \"difficulty\": 1.0\\\\n}\\'))\\nresult = b[\\'id\\']', g), g['result'])[1])({})" ; chx:output "'00000000c937983704a73af28acdec37b049d214adbda81d7e2a3dd146f6ed09'" .
chx:X_CommandLineClient rd:hasIOExample chx:IO_CommandLineClient .
chx:X_WrapperLibrary a owl:NamedIndividual, chx:WrapperLibrary ; rdfs:label "python-bitcoinlib's RawProxy"@en ; skos:definition "A wrapper library hides the HTTP call: python-bitcoinlib's RawProxy turns p.getblockchaininfo() into the JSON-RPC request and returns the decoded answer."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_WrapperLibrary a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import json\\nclass Proxy:\\n    def __getattr__(self, name):\\n        return lambda *args: json.dumps({'version': '1.1', 'method': name, 'params': list(args), 'id': 1})\\nresult = Proxy().getblockhash(1000)\", g), g['result'])[1])({}) evaluates to '{\"version\": \"1.1\", \"method\": \"getblockhash\", \"params\": [1000], \"id\": 1}'"@en ; chx:input "(lambda g: (exec(\"import json\\nclass Proxy:\\n    def __getattr__(self, name):\\n        return lambda *args: json.dumps({'version': '1.1', 'method': name, 'params': list(args), 'id': 1})\\nresult = Proxy().getblockhash(1000)\", g), g['result'])[1])({})" ; chx:output "'{\"version\": \"1.1\", \"method\": \"getblockhash\", \"params\": [1000], \"id\": 1}'" .
chx:X_WrapperLibrary rd:hasIOExample chx:IO_WrapperLibrary .
chx:X_TransactionSerialization a owl:NamedIndividual, chx:TransactionSerialization ; rdfs:label "the hexadecimal string of Alice's transaction"@en ; skos:definition "Serialization writes a transaction as a sequence of bytes, with a marker and a flag before the inputs when the transaction has witness data, shown in hexadecimal notation."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_TransactionSerialization a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nd = lambda b: hashlib.sha256(hashlib.sha256(b).digest()).digest()\\nraw = bytes.fromhex(__import__('io').StringIO('\\\\n').read().strip())\\ndef varint(b, i):\\n    n = b[i]\\n    if n < 0xfd:\\n        return n, i + 1\\n    if n == 0xfd:\\n        return int.from_bytes(b[i + 1:i + 3], 'little'), i + 3\\n    raise ValueError('long')\\nversion = int.from_bytes(raw[0:4], 'little')\\nmarker, flag = raw[4], raw[5]\\ni = 6\\nn_in, i = varint(raw, i)\\nins = []\\nfor _ in range(n_in):\\n    prev = raw[i:i + 32][::-1].hex()\\n    vout = int.from_bytes(raw[i + 32:i + 36], 'little')\\n    i += 36\\n    sl, i = varint(raw, i)\\n    i += sl\\n    seq = int.from_bytes(raw[i:i + 4], 'little')\\n    i += 4\\n    ins.append((prev, vout, sl, seq))\\nn_out, i = varint(raw, i)\\nouts = []\\nfor _ in range(n_out):\\n    val = int.from_bytes(raw[i:i + 8], 'little')\\n    i += 8\\n    sl, i = varint(raw, i)\\n    outs.append((val, raw[i:i + sl].hex()))\\n    i += sl\\nout_end = i\\nwit = []\\nfor _ in range(n_in):\\n    cnt, i = varint(raw, i)\\n    items = []\\n    for _ in range(cnt):\\n        l, i = varint(raw, i)\\n        items.append(raw[i:i + l])\\n        i += l\\n    wit.append(items)\\nwit_end = i\\nlocktime = int.from_bytes(raw[i:i + 4], 'little')\\nstripped = raw[:4] + raw[6:out_end] + raw[wit_end:]\\ntxid = d(stripped)[::-1].hex()\\nwtxid = d(raw)[::-1].hex()\\nresult = (version, marker, flag, n_in, n_out, locktime)\", g), g['result'])[1])({}) evaluates to (1, 0, 1, 1, 2, 0)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nd = lambda b: hashlib.sha256(hashlib.sha256(b).digest()).digest()\\nraw = bytes.fromhex(__import__('io').StringIO('\\\\n').read().strip())\\ndef varint(b, i):\\n    n = b[i]\\n    if n < 0xfd:\\n        return n, i + 1\\n    if n == 0xfd:\\n        return int.from_bytes(b[i + 1:i + 3], 'little'), i + 3\\n    raise ValueError('long')\\nversion = int.from_bytes(raw[0:4], 'little')\\nmarker, flag = raw[4], raw[5]\\ni = 6\\nn_in, i = varint(raw, i)\\nins = []\\nfor _ in range(n_in):\\n    prev = raw[i:i + 32][::-1].hex()\\n    vout = int.from_bytes(raw[i + 32:i + 36], 'little')\\n    i += 36\\n    sl, i = varint(raw, i)\\n    i += sl\\n    seq = int.from_bytes(raw[i:i + 4], 'little')\\n    i += 4\\n    ins.append((prev, vout, sl, seq))\\nn_out, i = varint(raw, i)\\nouts = []\\nfor _ in range(n_out):\\n    val = int.from_bytes(raw[i:i + 8], 'little')\\n    i += 8\\n    sl, i = varint(raw, i)\\n    outs.append((val, raw[i:i + sl].hex()))\\n    i += sl\\nout_end = i\\nwit = []\\nfor _ in range(n_in):\\n    cnt, i = varint(raw, i)\\n    items = []\\n    for _ in range(cnt):\\n        l, i = varint(raw, i)\\n        items.append(raw[i:i + l])\\n        i += l\\n    wit.append(items)\\nwit_end = i\\nlocktime = int.from_bytes(raw[i:i + 4], 'little')\\nstripped = raw[:4] + raw[6:out_end] + raw[wit_end:]\\ntxid = d(stripped)[::-1].hex()\\nwtxid = d(raw)[::-1].hex()\\nresult = (version, marker, flag, n_in, n_out, locktime)\", g), g['result'])[1])({})" ; chx:output "(1, 0, 1, 1, 2, 0)" .
chx:X_TransactionSerialization rd:hasIOExample chx:IO_TransactionSerialization .
chx:X_DecodedTransaction a owl:NamedIndividual, chx:DecodedTransaction ; rdfs:label "decoderawtransaction on Alice's transaction"@en ; skos:definition "Decoding the serialized hexadecimal of Alice's payment shows its one input, two outputs, addresses and script types, exactly as the chain holds them."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_DecodedTransaction a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(o['n'], o['value'], o['scriptPubKey']['type']) for o in __import__('json').load(__import__('io').StringIO('{\\n  \"txid\": \"466200308696215bbc949d5141a49a4138ecdfdfaa2a8029c1f9bcecd1f96177\",\\n  \"hash\": \"f7cdbc7cf8b910d35cc69962e791138624e4eae7901010a6da4c02e7d238cdac\",\\n  \"version\": 1,\\n  \"size\": 194,\\n  \"vsize\": 143,\\n  \"weight\": 569,\\n  \"locktime\": 0,\\n  \"vin\": [\\n    {\\n      \"txid\": \"4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb\",\\n      \"vout\": 1,\\n      \"scriptSig\": {\\n        \"asm\": \"\",\\n        \"hex\": \"\"\\n      },\\n      \"txinwitness\": [\\n        \"cf5efe2d8ef13ed0af21d4f4cb82422d6252d70324f6f4576b727b7d918e521c00b51be739df2f899c49dc267c0ad280aca6dab0d2fa2b42a45182fc83e8171301\"\\n      ],\\n      \"sequence\": 4294967295\\n    }\\n  ],\\n  \"vout\": [\\n    {\\n      \"value\": 0.00020000,\\n      \"n\": 0,\\n      \"scriptPubKey\": {\\n        \"asm\": \"1 3b41daba4c9ace578369740f15e5ec880c28279ee7f51b07dca69c7061e07068\",\\n        \"desc\": \"rawtr(3b41daba4c9ace578369740f15e5ec880c28279ee7f51b07dca69c7061e07068)#38d6v6ev\",\\n        \"hex\": \"51203b41daba4c9ace578369740f15e5ec880c28279ee7f51b07dca69c7061e07068\",\\n        \"address\": \"bc1p8dqa4wjvnt890qmfws83te0v3qxzsfu7ul63kp7u56w8qc0qwp5qv995qn\",\\n        \"type\": \"witness_v1_taproot\"\\n      }\\n    },\\n    {\\n      \"value\": 0.00075000,\\n      \"n\": 1,\\n      \"scriptPubKey\": {\\n        \"asm\": \"0 7752c165ea7be772b2c0acb7f4d6047ae6f4768e\",\\n        \"desc\": \"addr(bc1qwafvze0200nh9vkq4jmlf4sy0tn0ga5w0zpkpg)#qq404gts\",\\n        \"hex\": \"00147752c165ea7be772b2c0acb7f4d6047ae6f4768e\",\\n        \"address\": \"bc1qwafvze0200nh9vkq4jmlf4sy0tn0ga5w0zpkpg\",\\n        \"type\": \"witness_v0_keyhash\"\\n      }\\n    }\\n  ]\\n}\\n'))['vout']] evaluates to [(0, 0.0002, 'witness_v1_taproot'), (1, 0.00075, 'witness_v0_keyhash')]"@en ; chx:input "[(o['n'], o['value'], o['scriptPubKey']['type']) for o in __import__('json').load(__import__('io').StringIO('{\\n  \"txid\": \"466200308696215bbc949d5141a49a4138ecdfdfaa2a8029c1f9bcecd1f96177\",\\n  \"hash\": \"f7cdbc7cf8b910d35cc69962e791138624e4eae7901010a6da4c02e7d238cdac\",\\n  \"version\": 1,\\n  \"size\": 194,\\n  \"vsize\": 143,\\n  \"weight\": 569,\\n  \"locktime\": 0,\\n  \"vin\": [\\n    {\\n      \"txid\": \"4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb\",\\n      \"vout\": 1,\\n      \"scriptSig\": {\\n        \"asm\": \"\",\\n        \"hex\": \"\"\\n      },\\n      \"txinwitness\": [\\n        \"cf5efe2d8ef13ed0af21d4f4cb82422d6252d70324f6f4576b727b7d918e521c00b51be739df2f899c49dc267c0ad280aca6dab0d2fa2b42a45182fc83e8171301\"\\n      ],\\n      \"sequence\": 4294967295\\n    }\\n  ],\\n  \"vout\": [\\n    {\\n      \"value\": 0.00020000,\\n      \"n\": 0,\\n      \"scriptPubKey\": {\\n        \"asm\": \"1 3b41daba4c9ace578369740f15e5ec880c28279ee7f51b07dca69c7061e07068\",\\n        \"desc\": \"rawtr(3b41daba4c9ace578369740f15e5ec880c28279ee7f51b07dca69c7061e07068)#38d6v6ev\",\\n        \"hex\": \"51203b41daba4c9ace578369740f15e5ec880c28279ee7f51b07dca69c7061e07068\",\\n        \"address\": \"bc1p8dqa4wjvnt890qmfws83te0v3qxzsfu7ul63kp7u56w8qc0qwp5qv995qn\",\\n        \"type\": \"witness_v1_taproot\"\\n      }\\n    },\\n    {\\n      \"value\": 0.00075000,\\n      \"n\": 1,\\n      \"scriptPubKey\": {\\n        \"asm\": \"0 7752c165ea7be772b2c0acb7f4d6047ae6f4768e\",\\n        \"desc\": \"addr(bc1qwafvze0200nh9vkq4jmlf4sy0tn0ga5w0zpkpg)#qq404gts\",\\n        \"hex\": \"00147752c165ea7be772b2c0acb7f4d6047ae6f4768e\",\\n        \"address\": \"bc1qwafvze0200nh9vkq4jmlf4sy0tn0ga5w0zpkpg\",\\n        \"type\": \"witness_v0_keyhash\"\\n      }\\n    }\\n  ]\\n}\\n'))['vout']]" ; chx:output "[(0, 0.0002, 'witness_v1_taproot'), (1, 0.00075, 'witness_v0_keyhash')]" .
chx:X_DecodedTransaction rd:hasIOExample chx:IO_DecodedTransaction .
chx:X_SegregatedWitness a owl:NamedIndividual, chx:SegregatedWitness ; rdfs:label "the 65-byte witness of Alice's input"@en ; skos:definition "Segregated witness moves the signature data of a transaction out of the part that the identifier covers, into a witness that counts less toward the size limit."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_SegregatedWitness a owl:NamedIndividual, rd:IOExample ; rdfs:label "(194 - 125, 194 - 125 == 2 + 1 + 1 + 65) evaluates to (69, True)"@en ; chx:input "(194 - 125, 194 - 125 == 2 + 1 + 1 + 65)" ; chx:output "(69, True)" .
chx:X_SegregatedWitness rd:hasIOExample chx:IO_SegregatedWitness .
chx:X_TransactionWeight a owl:NamedIndividual, chx:TransactionWeight ; rdfs:label "569 weight units, 143 virtual bytes"@en ; skos:definition "A transaction's weight counts its non-witness bytes four times and its witness bytes once, and its virtual size is the weight divided by four, rounded up."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_TransactionWeight a owl:NamedIndividual, rd:IOExample ; rdfs:label "-(-(4 * 125 + 194 - 125) // 4) evaluates to 143"@en ; chx:input "-(-(4 * 125 + 194 - 125) // 4)" ; chx:output "143" .
chx:X_TransactionWeight rd:hasIOExample chx:IO_TransactionWeight .
chx:X_TransactionIdentifier a owl:NamedIndividual, chx:TransactionIdentifier ; rdfs:label "txid and hash"@en ; skos:definition "The txid hashes the transaction without its witness and the hash includes it; a txid is not authoritative before confirmation because a transaction can be modified."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_TransactionIdentifier a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nd = lambda b: hashlib.sha256(hashlib.sha256(b).digest()).digest()\\nraw = bytes.fromhex(__import__('io').StringIO('\\\\n').read().strip())\\ndef varint(b, i):\\n    n = b[i]\\n    if n < 0xfd:\\n        return n, i + 1\\n    if n == 0xfd:\\n        return int.from_bytes(b[i + 1:i + 3], 'little'), i + 3\\n    raise ValueError('long')\\nversion = int.from_bytes(raw[0:4], 'little')\\nmarker, flag = raw[4], raw[5]\\ni = 6\\nn_in, i = varint(raw, i)\\nins = []\\nfor _ in range(n_in):\\n    prev = raw[i:i + 32][::-1].hex()\\n    vout = int.from_bytes(raw[i + 32:i + 36], 'little')\\n    i += 36\\n    sl, i = varint(raw, i)\\n    i += sl\\n    seq = int.from_bytes(raw[i:i + 4], 'little')\\n    i += 4\\n    ins.append((prev, vout, sl, seq))\\nn_out, i = varint(raw, i)\\nouts = []\\nfor _ in range(n_out):\\n    val = int.from_bytes(raw[i:i + 8], 'little')\\n    i += 8\\n    sl, i = varint(raw, i)\\n    outs.append((val, raw[i:i + sl].hex()))\\n    i += sl\\nout_end = i\\nwit = []\\nfor _ in range(n_in):\\n    cnt, i = varint(raw, i)\\n    items = []\\n    for _ in range(cnt):\\n        l, i = varint(raw, i)\\n        items.append(raw[i:i + l])\\n        i += l\\n    wit.append(items)\\nwit_end = i\\nlocktime = int.from_bytes(raw[i:i + 4], 'little')\\nstripped = raw[:4] + raw[6:out_end] + raw[wit_end:]\\ntxid = d(stripped)[::-1].hex()\\nwtxid = d(raw)[::-1].hex()\\nresult = (txid[:16], wtxid[:16])\", g), g['result'])[1])({}) evaluates to ('466200308696215b', 'f7cdbc7cf8b910d3')"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nd = lambda b: hashlib.sha256(hashlib.sha256(b).digest()).digest()\\nraw = bytes.fromhex(__import__('io').StringIO('\\\\n').read().strip())\\ndef varint(b, i):\\n    n = b[i]\\n    if n < 0xfd:\\n        return n, i + 1\\n    if n == 0xfd:\\n        return int.from_bytes(b[i + 1:i + 3], 'little'), i + 3\\n    raise ValueError('long')\\nversion = int.from_bytes(raw[0:4], 'little')\\nmarker, flag = raw[4], raw[5]\\ni = 6\\nn_in, i = varint(raw, i)\\nins = []\\nfor _ in range(n_in):\\n    prev = raw[i:i + 32][::-1].hex()\\n    vout = int.from_bytes(raw[i + 32:i + 36], 'little')\\n    i += 36\\n    sl, i = varint(raw, i)\\n    i += sl\\n    seq = int.from_bytes(raw[i:i + 4], 'little')\\n    i += 4\\n    ins.append((prev, vout, sl, seq))\\nn_out, i = varint(raw, i)\\nouts = []\\nfor _ in range(n_out):\\n    val = int.from_bytes(raw[i:i + 8], 'little')\\n    i += 8\\n    sl, i = varint(raw, i)\\n    outs.append((val, raw[i:i + sl].hex()))\\n    i += sl\\nout_end = i\\nwit = []\\nfor _ in range(n_in):\\n    cnt, i = varint(raw, i)\\n    items = []\\n    for _ in range(cnt):\\n        l, i = varint(raw, i)\\n        items.append(raw[i:i + l])\\n        i += l\\n    wit.append(items)\\nwit_end = i\\nlocktime = int.from_bytes(raw[i:i + 4], 'little')\\nstripped = raw[:4] + raw[6:out_end] + raw[wit_end:]\\ntxid = d(stripped)[::-1].hex()\\nwtxid = d(raw)[::-1].hex()\\nresult = (txid[:16], wtxid[:16])\", g), g['result'])[1])({})" ; chx:output "('466200308696215b', 'f7cdbc7cf8b910d3')" .
chx:X_TransactionIdentifier rd:hasIOExample chx:IO_TransactionIdentifier .
chx:X_TransactionMalleability a owl:NamedIndividual, chx:TransactionMalleability ; rdfs:label "changing a signature changes the wtxid but not the txid"@en ; skos:definition "Malleability is the possibility that a transaction is modified before confirmation so that its identifier changes while its meaning does not; the witness separation removed it for the txid of witness spends."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_TransactionMalleability a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nd = lambda b: hashlib.sha256(hashlib.sha256(b).digest()).digest()\\nraw = bytes.fromhex(__import__('io').StringIO('\\\\n').read().strip())\\ndef varint(b, i):\\n    n = b[i]\\n    if n < 0xfd:\\n        return n, i + 1\\n    if n == 0xfd:\\n        return int.from_bytes(b[i + 1:i + 3], 'little'), i + 3\\n    raise ValueError('long')\\nversion = int.from_bytes(raw[0:4], 'little')\\nmarker, flag = raw[4], raw[5]\\ni = 6\\nn_in, i = varint(raw, i)\\nins = []\\nfor _ in range(n_in):\\n    prev = raw[i:i + 32][::-1].hex()\\n    vout = int.from_bytes(raw[i + 32:i + 36], 'little')\\n    i += 36\\n    sl, i = varint(raw, i)\\n    i += sl\\n    seq = int.from_bytes(raw[i:i + 4], 'little')\\n    i += 4\\n    ins.append((prev, vout, sl, seq))\\nn_out, i = varint(raw, i)\\nouts = []\\nfor _ in range(n_out):\\n    val = int.from_bytes(raw[i:i + 8], 'little')\\n    i += 8\\n    sl, i = varint(raw, i)\\n    outs.append((val, raw[i:i + sl].hex()))\\n    i += sl\\nout_end = i\\nwit = []\\nfor _ in range(n_in):\\n    cnt, i = varint(raw, i)\\n    items = []\\n    for _ in range(cnt):\\n        l, i = varint(raw, i)\\n        items.append(raw[i:i + l])\\n        i += l\\n    wit.append(items)\\nwit_end = i\\nlocktime = int.from_bytes(raw[i:i + 4], 'little')\\nstripped = raw[:4] + raw[6:out_end] + raw[wit_end:]\\ntxid = d(stripped)[::-1].hex()\\nwtxid = d(raw)[::-1].hex()\\nws = bytearray(raw)\\nws[-10] ^= 1\\nws = bytes(ws)\\nresult = (d(ws)[::-1].hex() == wtxid, d(raw[:4] + raw[6:out_end] + ws[wit_end:])[::-1].hex() == txid)\", g), g['result'])[1])({}) evaluates to (False, True)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nd = lambda b: hashlib.sha256(hashlib.sha256(b).digest()).digest()\\nraw = bytes.fromhex(__import__('io').StringIO('\\\\n').read().strip())\\ndef varint(b, i):\\n    n = b[i]\\n    if n < 0xfd:\\n        return n, i + 1\\n    if n == 0xfd:\\n        return int.from_bytes(b[i + 1:i + 3], 'little'), i + 3\\n    raise ValueError('long')\\nversion = int.from_bytes(raw[0:4], 'little')\\nmarker, flag = raw[4], raw[5]\\ni = 6\\nn_in, i = varint(raw, i)\\nins = []\\nfor _ in range(n_in):\\n    prev = raw[i:i + 32][::-1].hex()\\n    vout = int.from_bytes(raw[i + 32:i + 36], 'little')\\n    i += 36\\n    sl, i = varint(raw, i)\\n    i += sl\\n    seq = int.from_bytes(raw[i:i + 4], 'little')\\n    i += 4\\n    ins.append((prev, vout, sl, seq))\\nn_out, i = varint(raw, i)\\nouts = []\\nfor _ in range(n_out):\\n    val = int.from_bytes(raw[i:i + 8], 'little')\\n    i += 8\\n    sl, i = varint(raw, i)\\n    outs.append((val, raw[i:i + sl].hex()))\\n    i += sl\\nout_end = i\\nwit = []\\nfor _ in range(n_in):\\n    cnt, i = varint(raw, i)\\n    items = []\\n    for _ in range(cnt):\\n        l, i = varint(raw, i)\\n        items.append(raw[i:i + l])\\n        i += l\\n    wit.append(items)\\nwit_end = i\\nlocktime = int.from_bytes(raw[i:i + 4], 'little')\\nstripped = raw[:4] + raw[6:out_end] + raw[wit_end:]\\ntxid = d(stripped)[::-1].hex()\\nwtxid = d(raw)[::-1].hex()\\nws = bytearray(raw)\\nws[-10] ^= 1\\nws = bytes(ws)\\nresult = (d(ws)[::-1].hex() == wtxid, d(raw[:4] + raw[6:out_end] + ws[wit_end:])[::-1].hex() == txid)\", g), g['result'])[1])({})" ; chx:output "(False, True)" .
chx:X_TransactionMalleability rd:hasIOExample chx:IO_TransactionMalleability .
chx:X_BlockHeight a owl:NamedIndividual, chx:BlockHeight ; rdfs:label "getblockhash 123456"@en ; skos:definition "A block is found by its height, how many blocks precede it, or by its header hash; its confirmations count the blocks built on top, itself included."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_BlockHeight a owl:NamedIndividual, rd:IOExample ; rdfs:label "123456 + 651742 - 1 evaluates to 775197"@en ; chx:input "123456 + 651742 - 1" ; chx:output "775197" .
chx:X_BlockHeight rd:hasIOExample chx:IO_BlockHeight .
chx:X_BlockHash a owl:NamedIndividual, chx:BlockHash ; rdfs:label "the 80-byte header hashed twice"@en ; skos:definition "The block hash is the double SHA-256 hash of the 80-byte block header, written backwards; it identifies a block uniquely and is not stored in the block."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_BlockHash a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import hashlib, json, struct\\nb = json.load(__import__(\\'io\\').StringIO(\\'{\\\\n \"source\": \"https://blockstream.info/api\",\\\\n \"read\": \"2026-09-28\",\\\\n \"id\": \"0000000000002917ed80650c6174aac8dfc46f5fe36480aaef682ff6cd83c3ca\",\\\\n \"height\": 123456,\\\\n \"version\": 1,\\\\n \"timestamp\": 1305200806,\\\\n \"tx_count\": 13,\\\\n \"size\": 4179,\\\\n \"weight\": 16716,\\\\n \"merkle_root\": \"0e60651a9934e8f0decd1c5fde39309e48fca0cd1c84a21ddfde95033762d86c\",\\\\n \"previousblockhash\": \"0000000000000b60bc96a44724fd72daf9b92cf8ad00510b5224c6253ac40095\",\\\\n \"mediantime\": 1305197900,\\\\n \"nonce\": 2436437219,\\\\n \"bits\": 443192243,\\\\n \"difficulty\": 157416.40184364893\\\\n}\\'))\\nh = struct.pack(\\'<I\\', b[\\'version\\']) + bytes.fromhex(b[\\'previousblockhash\\'])[::-1] + bytes.fromhex(b[\\'merkle_root\\'])[::-1] + struct.pack(\\'<III\\', b[\\'timestamp\\'], b[\\'bits\\'], b[\\'nonce\\'])\\nresult = (hashlib.sha256(hashlib.sha256(h).digest()).digest()[::-1].hex() == b[\\'id\\'], len(h), b[\\'id\\'])\\nresult = result[0]', g), g['result'])[1])({}) evaluates to True"@en ; chx:input "(lambda g: (exec('import hashlib, json, struct\\nb = json.load(__import__(\\'io\\').StringIO(\\'{\\\\n \"source\": \"https://blockstream.info/api\",\\\\n \"read\": \"2026-09-28\",\\\\n \"id\": \"0000000000002917ed80650c6174aac8dfc46f5fe36480aaef682ff6cd83c3ca\",\\\\n \"height\": 123456,\\\\n \"version\": 1,\\\\n \"timestamp\": 1305200806,\\\\n \"tx_count\": 13,\\\\n \"size\": 4179,\\\\n \"weight\": 16716,\\\\n \"merkle_root\": \"0e60651a9934e8f0decd1c5fde39309e48fca0cd1c84a21ddfde95033762d86c\",\\\\n \"previousblockhash\": \"0000000000000b60bc96a44724fd72daf9b92cf8ad00510b5224c6253ac40095\",\\\\n \"mediantime\": 1305197900,\\\\n \"nonce\": 2436437219,\\\\n \"bits\": 443192243,\\\\n \"difficulty\": 157416.40184364893\\\\n}\\'))\\nh = struct.pack(\\'<I\\', b[\\'version\\']) + bytes.fromhex(b[\\'previousblockhash\\'])[::-1] + bytes.fromhex(b[\\'merkle_root\\'])[::-1] + struct.pack(\\'<III\\', b[\\'timestamp\\'], b[\\'bits\\'], b[\\'nonce\\'])\\nresult = (hashlib.sha256(hashlib.sha256(h).digest()).digest()[::-1].hex() == b[\\'id\\'], len(h), b[\\'id\\'])\\nresult = result[0]', g), g['result'])[1])({})" ; chx:output "True" .
chx:X_BlockHash rd:hasIOExample chx:IO_BlockHash .
chx:X_BlockHeader a owl:NamedIndividual, chx:BlockHeader ; rdfs:label "six fields in 80 bytes"@en ; skos:definition "The block header holds the version, the previous block hash, the Merkle root, the timestamp, the compact target and the nonce, in 80 bytes."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_BlockHeader a owl:NamedIndividual, rd:IOExample ; rdfs:label "4 + 32 + 32 + 4 + 4 + 4 evaluates to 80"@en ; chx:input "4 + 32 + 32 + 4 + 4 + 4" ; chx:output "80" .
chx:X_BlockHeader rd:hasIOExample chx:IO_BlockHeader .
chx:X_BlockWeight a owl:NamedIndividual, chx:BlockWeight ; rdfs:label "weight 16716 for size 4179"@en ; skos:definition "A block without witness data weighs four times its size in weight units, which the getblock result shows as size, strippedsize and weight."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_BlockWeight a owl:NamedIndividual, rd:IOExample ; rdfs:label "4 * 4179 evaluates to 16716"@en ; chx:input "4 * 4179" ; chx:output "16716" .
chx:X_BlockWeight rd:hasIOExample chx:IO_BlockWeight .
chx:X_MerkleRoot a owl:NamedIndividual, chx:MerkleRoot ; rdfs:label "the Merkle root of the block's transactions"@en ; skos:definition "The Merkle root in a block header commits to every transaction of the block, and hashing the block's transaction identifiers pairwise up to one value reproduces it."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_MerkleRoot a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nd = lambda b: hashlib.sha256(hashlib.sha256(b).digest()).digest()\\nlevel = [bytes.fromhex(t)[::-1] for t in '5b75086dafeede555fc8f9a810d8b10df57c46f9f176ccc3dd8d2fa20edd685b e3d0425ab346dd5b76f44c222a4bb5d16640a4247050ef82462ab17e229c83b4 137d247eca8b99dee58e1e9232014183a5c5a9e338001a0109df32794cdcc92e 5fd167f7b8c417e59106ef5acfe181b09d71b8353a61a55a2f01aa266af5412d 60925f1948b71f429d514ead7ae7391e0edf965bf5a60331398dae24c6964774 d4d5fc1529487527e9873256934dfb1e4cdcb39f4c0509577ca19bfad6c5d28f 7b29d65e5018c56a33652085dbb13f2df39a1a9942bfe1f7e78e97919a6bdea2 0b89e120efd0a4674c127a76ff5f7590ca304e6a064fbc51adffbd7ce3a3deef 603f2044da9656084174cfb5812feaf510f862d3addcf70cacce3dc55dab446e 9a4ed892b43a4df916a7a1213b78e83cd83f5695f635d535c94b2b65ffb144d3 dda726e3dad9504dce5098dfab5064ecd4a7650bfe854bb2606da3152b60e427 e46ea8b4d68719b65ead930f07f1f3804cb3701014f8e6d76c4bdbc390893b94 864a102aeedf53dd9b2baab4eeb898c5083fde6141113e0606b664c41fe15e1f'.split()]\\nwhile len(level) > 1:\\n    if len(level) % 2: level.append(level[-1])\\n    level = [d(level[i] + level[i + 1]) for i in range(0, len(level), 2)]\\nresult = level[0][::-1].hex()\", g), g['result'])[1])({}) evaluates to '0e60651a9934e8f0decd1c5fde39309e48fca0cd1c84a21ddfde95033762d86c'"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nd = lambda b: hashlib.sha256(hashlib.sha256(b).digest()).digest()\\nlevel = [bytes.fromhex(t)[::-1] for t in '5b75086dafeede555fc8f9a810d8b10df57c46f9f176ccc3dd8d2fa20edd685b e3d0425ab346dd5b76f44c222a4bb5d16640a4247050ef82462ab17e229c83b4 137d247eca8b99dee58e1e9232014183a5c5a9e338001a0109df32794cdcc92e 5fd167f7b8c417e59106ef5acfe181b09d71b8353a61a55a2f01aa266af5412d 60925f1948b71f429d514ead7ae7391e0edf965bf5a60331398dae24c6964774 d4d5fc1529487527e9873256934dfb1e4cdcb39f4c0509577ca19bfad6c5d28f 7b29d65e5018c56a33652085dbb13f2df39a1a9942bfe1f7e78e97919a6bdea2 0b89e120efd0a4674c127a76ff5f7590ca304e6a064fbc51adffbd7ce3a3deef 603f2044da9656084174cfb5812feaf510f862d3addcf70cacce3dc55dab446e 9a4ed892b43a4df916a7a1213b78e83cd83f5695f635d535c94b2b65ffb144d3 dda726e3dad9504dce5098dfab5064ecd4a7650bfe854bb2606da3152b60e427 e46ea8b4d68719b65ead930f07f1f3804cb3701014f8e6d76c4bdbc390893b94 864a102aeedf53dd9b2baab4eeb898c5083fde6141113e0606b664c41fe15e1f'.split()]\\nwhile len(level) > 1:\\n    if len(level) % 2: level.append(level[-1])\\n    level = [d(level[i] + level[i + 1]) for i in range(0, len(level), 2)]\\nresult = level[0][::-1].hex()\", g), g['result'])[1])({})" ; chx:output "'0e60651a9934e8f0decd1c5fde39309e48fca0cd1c84a21ddfde95033762d86c'" .
chx:X_MerkleRoot rd:hasIOExample chx:IO_MerkleRoot .
chx:X_BlockSubsidy a owl:NamedIndividual, chx:BlockSubsidy ; rdfs:label "6.25 bitcoins at height 775072"@en ; skos:definition "The subsidy starts at 50 bitcoins and is shifted right once for every 210,000 blocks, so it is 6.25 bitcoins at height 775072."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_BlockSubsidy a owl:NamedIndividual, rd:IOExample ; rdfs:label "50 * 10**8 >> (775072 // 210000) evaluates to 625000000"@en ; chx:input "50 * 10**8 >> (775072 // 210000)" ; chx:output "625000000" .
chx:X_BlockSubsidy rd:hasIOExample chx:IO_BlockSubsidy .
chx:X_CompactTarget a owl:NamedIndividual, chx:CompactTarget ; rdfs:label "bits 1a6a93b3"@en ; skos:definition "The bits field is a four-byte compact form of the target: the first byte is the length in bytes and the next three are the leading digits, so the target is the digits shifted left by the length minus three bytes."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_CompactTarget a owl:NamedIndividual, rd:IOExample ; rdfs:label "'%064x' % (0x6a93b3 << (8 * (0x1a - 3))) evaluates to '0000000000006a93b30000000000000000000000000000000000000000000000'"@en ; chx:input "'%064x' % (0x6a93b3 << (8 * (0x1a - 3)))" ; chx:output "'0000000000006a93b30000000000000000000000000000000000000000000000'" .
chx:X_CompactTarget rd:hasIOExample chx:IO_CompactTarget .
chx:X_Difficulty a owl:NamedIndividual, chx:Difficulty ; rdfs:label "difficulty from bits 1a6a93b3"@en ; skos:definition "A block's difficulty follows from its bits, the compact form of its target, as the ratio of the easiest target to this block's target."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_Difficulty a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(0xffff * 256**(0x1d - 3) / (0x6a93b3 * 256**(0x1a - 3)), 10) evaluates to 157416.4018436489"@en ; chx:input "round(0xffff * 256**(0x1d - 3) / (0x6a93b3 * 256**(0x1a - 3)), 10)" ; chx:output "157416.4018436489" .
chx:X_Difficulty rd:hasIOExample chx:IO_Difficulty .
chx:X_MedianTimePast a owl:NamedIndividual, chx:MedianTimePast ; rdfs:label "the median of 11 block times"@en ; skos:definition "The median time past is the middle value of the timestamps of the last 11 blocks, which the consensus rules use as the clock for time limits because a single miner cannot move it."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_MedianTimePast a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted(__import__('json').load(__import__('io').StringIO('{\"123445\": 1305191152, \"123446\": 1305191688, \"123447\": 1305193319, \"123448\": 1305194571, \"123449\": 1305194986, \"123450\": 1305195947, \"123451\": 1305197900, \"123452\": 1305199436, \"123453\": 1305200301, \"123454\": 1305200460, \"123455\": 1305200584, \"123456\": 1305200806}'))[str(h)] for h in range(123446, 123457))[5] evaluates to 1305197900"@en ; chx:input "sorted(__import__('json').load(__import__('io').StringIO('{\"123445\": 1305191152, \"123446\": 1305191688, \"123447\": 1305193319, \"123448\": 1305194571, \"123449\": 1305194986, \"123450\": 1305195947, \"123451\": 1305197900, \"123452\": 1305199436, \"123453\": 1305200301, \"123454\": 1305200460, \"123455\": 1305200584, \"123456\": 1305200806}'))[str(h)] for h in range(123446, 123457))[5]" ; chx:output "1305197900" .
chx:X_MedianTimePast rd:hasIOExample chx:IO_MedianTimePast .
chx:X_BestChain a owl:NamedIndividual, chx:BestChain ; rdfs:label "the chain with the most work"@en ; skos:definition "The best chain is the valid chain with the most cumulative proof of work; it is not necessarily the one with the most blocks."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_BestChain a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"a_work = 3 * (2**256 // (0xffff * 256**26 + 1))\\nb_work = 2 * (2**256 // ((0xffff * 256**26) // 4 + 1))\\nresult = (a_work < b_work, max([('A', a_work), ('B', b_work)], key=lambda c: c[1])[0])\", g), g['result'])[1])({}) evaluates to (True, 'B')"@en ; chx:input "(lambda g: (exec(\"a_work = 3 * (2**256 // (0xffff * 256**26 + 1))\\nb_work = 2 * (2**256 // ((0xffff * 256**26) // 4 + 1))\\nresult = (a_work < b_work, max([('A', a_work), ('B', b_work)], key=lambda c: c[1])[0])\", g), g['result'])[1])({})" ; chx:output "(True, 'B')" .
chx:X_BestChain rd:hasIOExample chx:IO_BestChain .
chx:X_ChainWork a owl:NamedIndividual, chx:ChainWork ; rdfs:label "chainwork 100010001"@en ; skos:definition "The work of a block is 2^256 divided by its target plus one, the expected number of hashes needed to find it, and the chain work is the sum of the work of all blocks up to it."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_ChainWork a owl:NamedIndividual, rd:IOExample ; rdfs:label "hex(2**256 // (0xffff * 256**26 + 1)) evaluates to '0x100010001'"@en ; chx:input "hex(2**256 // (0xffff * 256**26 + 1))" ; chx:output "'0x100010001'" .
chx:X_ChainWork rd:hasIOExample chx:IO_ChainWork .
chx:X_Confirmation a owl:NamedIndividual, chx:Confirmation ; rdfs:label "651742 confirmations for block 123456"@en ; skos:definition "A confirmation counts the blocks from a transaction's block to the tip, itself included; each one makes it harder to reverse the transaction."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_Confirmation a owl:NamedIndividual, rd:IOExample ; rdfs:label "775197 - 123456 + 1 evaluates to 651742"@en ; chx:input "775197 - 123456 + 1" ; chx:output "651742" .
chx:X_Confirmation rd:hasIOExample chx:IO_Confirmation .
chx:X_Reorganization a owl:NamedIndividual, chx:Reorganization ; rdfs:label "switching to a branch with more work"@en ; skos:definition "A reorganization occurs when a node switches to a different chain with more work: blocks leave the best chain, their transactions return to the mempool unless the new chain includes them, and the set of unspent outputs is updated."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_Reorganization a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"a = {'tx1', 'tx2', 'tx3'}\\nb = {'tx1', 'tx4'}\\nresult = (sorted(a - b), sorted(b - a))\", g), g['result'])[1])({}) evaluates to (['tx2', 'tx3'], ['tx4'])"@en ; chx:input "(lambda g: (exec(\"a = {'tx1', 'tx2', 'tx3'}\\nb = {'tx1', 'tx4'}\\nresult = (sorted(a - b), sorted(b - a))\", g), g['result'])[1])({})" ; chx:output "(['tx2', 'tx3'], ['tx4'])" .
chx:X_Reorganization rd:hasIOExample chx:IO_Reorganization .
chx:X_ReleaseVerification a owl:NamedIndividual, chx:ReleaseVerification ; rdfs:label "SHA256SUMS and its signatures"@en ; skos:definition "A downloaded release can be checked against the SHA-256 checksums the project publishes and the signatures on them, which shows that the file matches the published record and not that the signers' keys are trustworthy."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
