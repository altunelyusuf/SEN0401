chx:X_BlockchainInfo rd:hasIOExample chx:IO_BlockchainInfo .
chx:X_NetworkInfo a owl:NamedIndividual, chx:NetworkInfo ; rdfs:label "bitcoin-cli getnetworkinfo"@en ; skos:definition "The getnetworkinfo call reports the node's own version, the protocol version, the services it offers, its connections and reachable networks, and the fee rates it uses to accept transactions."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_NetworkInfo a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"names = (('NETWORK', 1), ('BLOOM', 4), ('WITNESS', 8), ('NETWORK_LIMITED', 1024), ('P2P_V2', 2048))\\nresult = [n for n, b in names if 0xc09 & b]\", g), g['result'])[1])({}) evaluates to ['NETWORK', 'WITNESS', 'NETWORK_LIMITED', 'P2P_V2']"@en ; chx:input "(lambda g: (exec(\"names = (('NETWORK', 1), ('BLOOM', 4), ('WITNESS', 8), ('NETWORK_LIMITED', 1024), ('P2P_V2', 2048))\\nresult = [n for n, b in names if 0xc09 & b]\", g), g['result'])[1])({})" ; chx:output "['NETWORK', 'WITNESS', 'NETWORK_LIMITED', 'P2P_V2']" .
chx:X_NetworkInfo rd:hasIOExample chx:IO_NetworkInfo .
