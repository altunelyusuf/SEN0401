chx:X_LegacyWallet a owl:NamedIndividual, chx:LegacyWallet ; rdfs:label "the BerkeleyDB wallet"@en ; skos:definition "The legacy wallet was stored in a Berkeley DB file and described by its keys; since Bitcoin Core 30.0 it can no longer be created or loaded, only migrated."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_LegacyWallet a owl:NamedIndividual, rd:IOExample ; rdfs:label "int(__import__('io').StringIO('error code: -4\\nerror message:\\ndescriptors argument must be set to \"true\"; it is no longer possible to create a legacy wallet.\\n').read().split()[2]) evaluates to -4"@en ; chx:input "int(__import__('io').StringIO('error code: -4\\nerror message:\\ndescriptors argument must be set to \"true\"; it is no longer possible to create a legacy wallet.\\n').read().split()[2])" ; chx:output "-4" .
