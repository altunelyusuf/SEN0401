chx:X_VerifiedData a owl:NamedIndividual, chx:VerifiedData ; rdfs:label "a node's own verified answer"@en ; skos:definition "Data from your own node is authoritative because the node verified it itself, which is the kind of fact a provenance record states about any dataset."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_VerifiedData a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import json, hashlib, struct\\nb = json.load(__import__(\\'io\\').StringIO(\\'{\\\\n \"source\": \"https://blockstream.info/api\",\\\\n \"read\": \"2026-09-28\",\\\\n \"id\": \"0000000000002917ed80650c6174aac8dfc46f5fe36480aaef682ff6cd83c3ca\",\\\\n \"height\": 123456,\\\\n \"version\": 1,\\\\n \"timestamp\": 1305200806,\\\\n \"tx_count\": 13,\\\\n \"size\": 4179,\\\\n \"weight\": 16716,\\\\n \"merkle_root\": \"0e60651a9934e8f0decd1c5fde39309e48fca0cd1c84a21ddfde95033762d86c\",\\\\n \"previousblockhash\": \"0000000000000b60bc96a44724fd72daf9b92cf8ad00510b5224c6253ac40095\",\\\\n \"mediantime\": 1305197900,\\\\n \"nonce\": 2436437219,\\\\n \"bits\": 443192243,\\\\n \"difficulty\": 157416.40184364893\\\\n}\\'))\\nh = struct.pack(\\'<I\\', b[\\'version\\']) + bytes.fromhex(b[\\'previousblockhash\\'])[::-1] + bytes.fromhex(b[\\'merkle_root\\'])[::-1] + struct.pack(\\'<III\\', b[\\'timestamp\\'], b[\\'bits\\'], b[\\'nonce\\'])\\nresult = hashlib.sha256(hashlib.sha256(h).digest()).digest()[::-1].hex() == b[\\'id\\']', g), g['result'])[1])({}) evaluates to True"@en ; chx:input "(lambda g: (exec('import json, hashlib, struct\\nb = json.load(__import__(\\'io\\').StringIO(\\'{\\\\n \"source\": \"https://blockstream.info/api\",\\\\n \"read\": \"2026-09-28\",\\\\n \"id\": \"0000000000002917ed80650c6174aac8dfc46f5fe36480aaef682ff6cd83c3ca\",\\\\n \"height\": 123456,\\\\n \"version\": 1,\\\\n \"timestamp\": 1305200806,\\\\n \"tx_count\": 13,\\\\n \"size\": 4179,\\\\n \"weight\": 16716,\\\\n \"merkle_root\": \"0e60651a9934e8f0decd1c5fde39309e48fca0cd1c84a21ddfde95033762d86c\",\\\\n \"previousblockhash\": \"0000000000000b60bc96a44724fd72daf9b92cf8ad00510b5224c6253ac40095\",\\\\n \"mediantime\": 1305197900,\\\\n \"nonce\": 2436437219,\\\\n \"bits\": 443192243,\\\\n \"difficulty\": 157416.40184364893\\\\n}\\'))\\nh = struct.pack(\\'<I\\', b[\\'version\\']) + bytes.fromhex(b[\\'previousblockhash\\'])[::-1] + bytes.fromhex(b[\\'merkle_root\\'])[::-1] + struct.pack(\\'<III\\', b[\\'timestamp\\'], b[\\'bits\\'], b[\\'nonce\\'])\\nresult = hashlib.sha256(hashlib.sha256(h).digest()).digest()[::-1].hex() == b[\\'id\\']', g), g['result'])[1])({})" ; chx:output "True" .
