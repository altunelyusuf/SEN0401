chx:IO_Byte a owl:NamedIndividual, rd:IOExample ; rdfs:label "(len(bytes.fromhex('0a0b')), bytes.fromhex('ff')[0], 16 * 16 == 2 ** 8) evaluates to (2, 255, True)"@en ; chx:input "(len(bytes.fromhex('0a0b')), bytes.fromhex('ff')[0], 16 * 16 == 2 ** 8)" ; chx:output "(2, 255, True)" .
