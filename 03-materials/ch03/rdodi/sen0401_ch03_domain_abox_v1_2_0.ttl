chx:X_Platform rd:hasIOExample chx:IO_Platform .
chx:X_NetworkProtocol a owl:NamedIndividual, chx:NetworkProtocol ; rdfs:label "an address with a port"@en ; skos:definition "A network protocol is an agreed format and order of messages between programs, such as HTTP between a client and a server, and a port number names the service on a machine."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_NetworkProtocol a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import urllib.parse\\nu = urllib.parse.urlsplit('http://127.0.0.1:8332/')\\nresult = (u.scheme, u.hostname, u.port, u.path)\", g), g['result'])[1])({}) evaluates to ('http', '127.0.0.1', 8332, '/')"@en ; chx:input "(lambda g: (exec(\"import urllib.parse\\nu = urllib.parse.urlsplit('http://127.0.0.1:8332/')\\nresult = (u.scheme, u.hostname, u.port, u.path)\", g), g['result'])[1])({})" ; chx:output "('http', '127.0.0.1', 8332, '/')" .
chx:X_NetworkProtocol rd:hasIOExample chx:IO_NetworkProtocol .
chx:X_SoftwareTesting a owl:NamedIndividual, chx:SoftwareTesting ; rdfs:label "subsidy test at the halvings"@en ; skos:definition "A software test runs a program on chosen inputs and compares the result with the expected one, and Bitcoin Core requires its tests to pass before a change is merged."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_SoftwareTesting a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('def subsidy(h):\\n    return 0 if h // 210000 >= 64 else (50 * 10**8) >> (h // 210000)\\nresult = [subsidy(h) for h in (0, 209999, 210000, 630000, 775072)]', g), g['result'])[1])({}) evaluates to [5000000000, 5000000000, 2500000000, 625000000, 625000000]"@en ; chx:input "(lambda g: (exec('def subsidy(h):\\n    return 0 if h // 210000 >= 64 else (50 * 10**8) >> (h // 210000)\\nresult = [subsidy(h) for h in (0, 209999, 210000, 630000, 775072)]', g), g['result'])[1])({})" ; chx:output "[5000000000, 5000000000, 2500000000, 625000000, 625000000]" .
chx:X_SoftwareTesting rd:hasIOExample chx:IO_SoftwareTesting .
chx:X_PackageManager a owl:NamedIndividual, chx:PackageManager ; rdfs:label "four package managers in the build notes"@en ; skos:definition "A package manager installs software and the libraries it depends on from a collection maintained for an operating system or a build."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_PackageManager a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import re\\nt = '| Debian / Ubuntu (`apt`)\\\\n| Fedora (`dnf`)\\\\n| Alpine (`apk`)\\\\n| Arch (`pacman`)'\\nresult = re.findall(r'^\\\\| (.+?) \\\\(`(\\\\w+)`\\\\)', t, flags=re.M)\", g), g['result'])[1])({}) evaluates to [('Debian / Ubuntu', 'apt'), ('Fedora', 'dnf'), ('Alpine', 'apk'), ('Arch', 'pacman')]"@en ; chx:input "(lambda g: (exec(\"import re\\nt = '| Debian / Ubuntu (`apt`)\\\\n| Fedora (`dnf`)\\\\n| Alpine (`apk`)\\\\n| Arch (`pacman`)'\\nresult = re.findall(r'^\\\\| (.+?) \\\\(`(\\\\w+)`\\\\)', t, flags=re.M)\", g), g['result'])[1])({})" ; chx:output "[('Debian / Ubuntu', 'apt'), ('Fedora', 'dnf'), ('Alpine', 'apk'), ('Arch', 'pacman')]" .
chx:X_PackageManager rd:hasIOExample chx:IO_PackageManager .
chx:X_Salt a owl:NamedIndividual, chx:Salt ; rdfs:label "two salts, two hashes"@en ; skos:definition "A salt is a random value mixed into the hashing of a password, so that equal passwords give different stored values."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_Salt a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hmac, hashlib\\na = hmac.new(b'salt1', b'pw', hashlib.sha256).hexdigest()\\nb = hmac.new(b'salt2', b'pw', hashlib.sha256).hexdigest()\\nresult = (a[:8], b[:8], a == hmac.new(b'salt1', b'pw', hashlib.sha256).hexdigest())\", g), g['result'])[1])({}) evaluates to ('e21e60d6', 'd84d1ad6', True)"@en ; chx:input "(lambda g: (exec(\"import hmac, hashlib\\na = hmac.new(b'salt1', b'pw', hashlib.sha256).hexdigest()\\nb = hmac.new(b'salt2', b'pw', hashlib.sha256).hexdigest()\\nresult = (a[:8], b[:8], a == hmac.new(b'salt1', b'pw', hashlib.sha256).hexdigest())\", g), g['result'])[1])({})" ; chx:output "('e21e60d6', 'd84d1ad6', True)" .
chx:X_Salt rd:hasIOExample chx:IO_Salt .
chx:X_Hmac a owl:NamedIndividual, chx:Hmac ; rdfs:label "the RFC test vector"@en ; skos:definition "An HMAC is a hash computed with a secret key, so that only someone who knows the key can produce or check the value."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_Hmac a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hmac, hashlib\\nv = hmac.new(b'Jefe', b'what do ya want for nothing?', hashlib.sha256).hexdigest().upper()\\nresult = (v == '5BDCC146BF60754E6A042426089575C75A003F089D2739839DEC58B964EC3843', len(v))\", g), g['result'])[1])({}) evaluates to (True, 64)"@en ; chx:input "(lambda g: (exec(\"import hmac, hashlib\\nv = hmac.new(b'Jefe', b'what do ya want for nothing?', hashlib.sha256).hexdigest().upper()\\nresult = (v == '5BDCC146BF60754E6A042426089575C75A003F089D2739839DEC58B964EC3843', len(v))\", g), g['result'])[1])({})" ; chx:output "(True, 64)" .
chx:X_Hmac rd:hasIOExample chx:IO_Hmac .
chx:X_Fork a owl:NamedIndividual, chx:Fork ; rdfs:label "two blocks at one height"@en ; skos:definition "A fork is a split of the chain into two branches, accidental when two miners find blocks at about the same time, or permanent when rules change incompatibly."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_Fork a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"blocks = {'G': (None, 0), 'A1': ('G', 1), 'B1': ('G', 1), 'A2': ('A1', 2)}\\ntips = sorted(b for b in blocks if not any(p == b for p, h in blocks.values()))\\nresult = (tips, max(tips, key=lambda b: blocks[b][1]), sorted(b for b, (p, h) in blocks.items() if h == 1))\", g), g['result'])[1])({}) evaluates to (['A2', 'B1'], 'A2', ['A1', 'B1'])"@en ; chx:input "(lambda g: (exec(\"blocks = {'G': (None, 0), 'A1': ('G', 1), 'B1': ('G', 1), 'A2': ('A1', 2)}\\ntips = sorted(b for b in blocks if not any(p == b for p, h in blocks.values()))\\nresult = (tips, max(tips, key=lambda b: blocks[b][1]), sorted(b for b, (p, h) in blocks.items() if h == 1))\", g), g['result'])[1])({})" ; chx:output "(['A2', 'B1'], 'A2', ['A1', 'B1'])" .
chx:X_Fork rd:hasIOExample chx:IO_Fork .
chx:X_OutputType a owl:NamedIndividual, chx:OutputType ; rdfs:label "four descriptor kinds in the demo wallet"@en ; skos:definition "An output type is the form of locking an output uses, such as P2PKH, P2SH-P2WPKH, P2WPKH and P2TR, and a descriptor wallet keeps one descriptor for each type it supports."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
