chx:X_OutputType rd:hasIOExample chx:IO_OutputType .
chx:X_ProgrammingLanguage a owl:NamedIndividual, chx:ProgrammingLanguage ; rdfs:label "one number in three notations"@en ; skos:definition "A programming language is a notation for instructing a computer, and the chapter meets C++ for the node, Python for tests, helpers and examples, and the languages of the toolkits."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_ProgrammingLanguage a owl:NamedIndividual, rd:IOExample ; rdfs:label "(0xff, int('ff', 16), int('11111111', 2), 0b11111111 == 0xff) evaluates to (255, 255, 255, True)"@en ; chx:input "(0xff, int('ff', 16), int('11111111', 2), 0b11111111 == 0xff)" ; chx:output "(255, 255, 255, True)" .
chx:X_ProgrammingLanguage rd:hasIOExample chx:IO_ProgrammingLanguage .
chx:X_MerkleRoot chx:hasOwner chx:X_BlockHeader .
chx:X_CompactTarget chx:hasOwner chx:X_BlockHeader .
chx:X_UnixTime chx:hasOwner chx:X_BlockHeader .
chx:X_Salt chx:hasOwner chx:X_RpcAuth .
chx:X_Hmac chx:hasOwner chx:X_RpcAuth .
chx:X_RandomNumber chx:hasOwner chx:X_CookieAuthentication .
chx:X_Checksum chx:hasOwner chx:X_ReleaseVerification .
chx:X_OpenPgpSignature chx:hasOwner chx:X_ReleaseVerification .
chx:Err_Byte a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "bytes.fromhex('abc') raises ValueError: fromhex() arg must contain an even number of hexadecimal digits"@en .
chx:X_Byte rd:hasErrorCondition chx:Err_Byte .
chx:Err_BitShift a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "1 << -1 raises ValueError: negative shift count"@en .
chx:X_BitShift rd:hasErrorCondition chx:Err_BitShift .
chx:Err_Checksum a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('hashlib').sha256('abc') raises TypeError: Strings must be encoded before hashing"@en .
chx:X_Checksum rd:hasErrorCondition chx:Err_Checksum .
chx:Err_JsonFormat a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('json').loads('{') raises JSONDecodeError: Expecting property name enclosed in double quotes"@en .
chx:X_JsonFormat rd:hasErrorCondition chx:Err_JsonFormat .
chx:Err_Base64 a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('base64').b64decode('abc') raises Error: Incorrect padding"@en .
chx:X_Base64 rd:hasErrorCondition chx:Err_Base64 .
chx:Err_Hmac a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('hmac').new('key', 'message', 'sha256') raises TypeError: key: expected bytes or bytearray"@en .
chx:X_Hmac rd:hasErrorCondition chx:Err_Hmac .
chx:Err_UnixTime a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(2 ** 32).to_bytes(4, 'little') raises OverflowError: int too big to convert"@en .
chx:X_UnixTime rd:hasErrorCondition chx:Err_UnixTime .

chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 3 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch03/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 3 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2, chx:CQ3, chx:CQ4, chx:CQ5, chx:CQ6 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which programs does Bitcoin Core consist of, how is each obtained, built and started, and what does the project's documentation say about each?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which settings and files decide how a node runs, how much it stores and how it protects its interface, and what does each hold in release 31.1?"@en .
chx:CQ3 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which numbers does the node report about a transaction and a block, and how can each be recomputed from the bytes?"@en .
chx:CQ4 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Where do the book's printed outputs differ from the real release 31.1 and the current source, and what does each difference change?"@en .
chx:CQ5 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How can a downloaded release and a chosen library be checked before they are trusted, and what does each check not prove?"@en .
chx:CQ6 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which terms do the explanations of this chapter rely on, and is each one a concept of this chapter or of an earlier chapter?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 3 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 3 through the Stage 1 research record; the explanations were rewritten for version 1.1.0 from the documents and files listed at the head of this module, each read for this version and each quotation or number re-checked by a claim that the builder executes; the supporting computing terms (bytes, bit shifts, time, randomness, Base64, files, processes, libraries, databases, platforms, protocols, tests, package managers, salts, keyed hashes, forks, output types and programming languages) were added because an audit of the explanations found them used without a concept of their own."@en ;
    dcterms:source <http://example.org/sen0401/ch03/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (435 checks listed in sen0401_ch03_corpus_v1_2_0.py), executed under CPython 3.14.4."@en ;
    dcterms:source "The execution run of this ontology's build, 08-tooling/sen0401_chapter_build_v1_0_1.py, over the claims in 08-tooling/sen0401_ch03_corpus_v1_2_0.py" .

