chx:X_FullNode a owl:NamedIndividual, chx:FullNode ; rdfs:label "a node that verifies every rule"@en ; skos:definition "A full verification node checks every confirmed transaction against every rule of the system, so that what it reports is authoritative because it was independently verified."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_ReferenceImplementation a owl:NamedIndividual, chx:ReferenceImplementation ; rdfs:label "Bitcoin Core"@en ; skos:definition "Bitcoin Core is the reference implementation: it provides a reference for how each part of the technology should be implemented."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_ImprovementProposal a owl:NamedIndividual, chx:ImprovementProposal ; rdfs:label "BIP9"@en ; skos:definition "Most major parts of the system since 2011 are documented in Bitcoin Improvement Proposals, referred to by number."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_InitialDownload a owl:NamedIndividual, chx:InitialDownload ; rdfs:label "the first synchronization"@en ; skos:definition "A new node downloads and validates the whole chain before it can process transactions, and a node that was off for ten days downloads about four gigabytes at 400 megabytes a day."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_InitialDownload a owl:NamedIndividual, rd:IOExample ; rdfs:label "400 * 10 / 1000 evaluates to 4.0"@en ; chx:input "400 * 10 / 1000" ; chx:output "4.0" .
chx:X_InitialDownload rd:hasIOExample chx:IO_InitialDownload .
chx:X_PrunedNode a owl:NamedIndividual, chx:PrunedNode ; rdfs:label "a node that deletes old blocks"@en ; skos:definition "A pruned node deletes old blocks to reduce disk use while still downloading and verifying the whole chain; automatic pruning needs a target of at least 550 MiB."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_ReleaseTag a owl:NamedIndividual, chx:ReleaseTag ; rdfs:label "git checkout v24.0.1"@en ; skos:definition "A release tag marks a snapshot of the source by version number; release candidates carry the suffix rc and stable releases none."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_AutotoolsBuild a owl:NamedIndividual, chx:AutotoolsBuild ; rdfs:label "autogen.sh, configure and make"@en ; skos:definition "The book builds bitcoind with autogen.sh, configure and make, options such as --disable-wallet and --with-gui=no shaping the build; Bitcoin Core replaced this with CMake."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_CMakeBuild a owl:NamedIndividual, chx:CMakeBuild ; rdfs:label "cmake -B build"@en ; skos:definition "A current build is cmake -B build, cmake --build build and cmake --install build, with options such as -DENABLE_WALLET=OFF and -DBUILD_GUI=ON."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_BitcoinCommand a owl:NamedIndividual, chx:BitcoinCommand ; rdfs:label "bitcoin -m node"@en ; skos:definition "The bitcoin command is a front door to the node and tools, and its -m option runs the multiprocess binaries instead of the monolithic ones."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_ConfigurationFile a owl:NamedIndividual, chx:ConfigurationFile ; rdfs:label "bitcoin.conf in the data directory"@en ; skos:definition "Bitcoin Core reads bitcoin.conf from its data directory at every start; options can also be given on the command line, and bitcoind -printtoconsole shows where the file is."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_DatabaseCache a owl:NamedIndividual, chx:DatabaseCache ; rdfs:label "dbcache"@en ; skos:definition "The dbcache option sizes the cache of the unspent-output set: 450 MiB by default in the book, 1024 MiB by default from Bitcoin Core 31.0 on machines with enough memory."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_TransactionIndex a owl:NamedIndividual, chx:TransactionIndex ; rdfs:label "txindex=1"@en ; skos:definition "The txindex option builds an index of every transaction so that getrawtransaction can find any of them; it cannot be combined with pruning."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_DescriptorWallet a owl:NamedIndividual, chx:DescriptorWallet ; rdfs:label "the SQLite wallet"@en ; skos:definition "The current default wallet is a descriptor wallet stored in SQLite; legacy BerkeleyDB wallets can no longer be created or loaded and can only be migrated."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_JsonRpc a owl:NamedIndividual, chx:JsonRpc ; rdfs:label "a getblockchaininfo call over HTTP"@en ; skos:definition "Bitcoin Core's API is JSON-RPC over HTTP, by default to 127.0.0.1 on port 8332, so any program that can make an HTTP request can call it."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_CookieAuthentication a owl:NamedIndividual, chx:CookieAuthentication ; rdfs:label "the .cookie file"@en ; skos:definition "By default Bitcoin Core creates a random credential on each start and stores it in the data directory as .cookie, which bitcoin-cli reads; rpcauth.py makes a static credential instead."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_CommandLineClient a owl:NamedIndividual, chx:CommandLineClient ; rdfs:label "bitcoin-cli getblockchaininfo"@en ; skos:definition "The bitcoin-cli helper sends the same calls the API offers, which makes it the way to experiment interactively; its help command lists the available RPC commands."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_WrapperLibrary a owl:NamedIndividual, chx:WrapperLibrary ; rdfs:label "python-bitcoinlib's RawProxy"@en ; skos:definition "A wrapper library hides the HTTP call: python-bitcoinlib's RawProxy turns p.getblockchaininfo() into the JSON-RPC request and returns the decoded answer."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_DecodedTransaction a owl:NamedIndividual, chx:DecodedTransaction ; rdfs:label "decoderawtransaction on Alice's transaction"@en ; skos:definition "Decoding the serialized hexadecimal of Alice's payment shows its one input, two outputs, addresses and script types, exactly as the chain holds them."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_TransactionWeight a owl:NamedIndividual, chx:TransactionWeight ; rdfs:label "569 weight units, 143 virtual bytes"@en ; skos:definition "A transaction's weight counts its non-witness bytes four times and its witness bytes once, and its virtual size is the weight divided by four, rounded up."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_TransactionWeight a owl:NamedIndividual, rd:IOExample ; rdfs:label "-(-(4 * 125 + 194 - 125) // 4) evaluates to 143"@en ; chx:input "-(-(4 * 125 + 194 - 125) // 4)" ; chx:output "143" .
chx:X_TransactionWeight rd:hasIOExample chx:IO_TransactionWeight .
chx:X_TransactionIdentifier a owl:NamedIndividual, chx:TransactionIdentifier ; rdfs:label "txid and hash"@en ; skos:definition "The txid hashes the transaction without its witness and the hash includes it; a txid is not authoritative before confirmation because a transaction can be modified."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_BlockHeight a owl:NamedIndividual, chx:BlockHeight ; rdfs:label "getblockhash 123456"@en ; skos:definition "A block is found by its height, how many blocks precede it, or by its header hash; its confirmations count the blocks built on top, itself included."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_BlockHeight a owl:NamedIndividual, rd:IOExample ; rdfs:label "123456 + 651742 - 1 evaluates to 775197"@en ; chx:input "123456 + 651742 - 1" ; chx:output "775197" .
chx:X_BlockHeight rd:hasIOExample chx:IO_BlockHeight .
chx:X_BlockWeight a owl:NamedIndividual, chx:BlockWeight ; rdfs:label "weight 16716 for size 4179"@en ; skos:definition "A block without witness data weighs four times its size in weight units, which the getblock result shows as size, strippedsize and weight."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_BlockWeight a owl:NamedIndividual, rd:IOExample ; rdfs:label "4 * 4179 evaluates to 16716"@en ; chx:input "4 * 4179" ; chx:output "16716" .
chx:X_BlockWeight rd:hasIOExample chx:IO_BlockWeight .
chx:X_MerkleRoot a owl:NamedIndividual, chx:MerkleRoot ; rdfs:label "the Merkle root of the block's transactions"@en ; skos:definition "The Merkle root in a block header commits to every transaction of the block, and hashing the block's transaction identifiers pairwise up to one value reproduces it."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_BlockSubsidy a owl:NamedIndividual, chx:BlockSubsidy ; rdfs:label "6.25 bitcoins at height 775072"@en ; skos:definition "The subsidy starts at 50 bitcoins and is shifted right once for every 210,000 blocks, so it is 6.25 bitcoins at height 775072."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_BlockSubsidy a owl:NamedIndividual, rd:IOExample ; rdfs:label "50 * 10**8 >> (775072 // 210000) evaluates to 625000000"@en ; chx:input "50 * 10**8 >> (775072 // 210000)" ; chx:output "625000000" .
chx:X_BlockSubsidy rd:hasIOExample chx:IO_BlockSubsidy .
chx:X_Difficulty a owl:NamedIndividual, chx:Difficulty ; rdfs:label "difficulty from bits 1a6a93b3"@en ; skos:definition "A block's difficulty follows from its bits, the compact form of its target, as the ratio of the easiest target to this block's target."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:IO_Difficulty a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(0xffff * 256**(0x1d - 3) / (0x6a93b3 * 256**(0x1a - 3)), 10) evaluates to 157416.4018436489"@en ; chx:input "round(0xffff * 256**(0x1d - 3) / (0x6a93b3 * 256**(0x1a - 3)), 10)" ; chx:output "157416.4018436489" .
chx:X_Difficulty rd:hasIOExample chx:IO_Difficulty .
chx:X_ReleaseVerification a owl:NamedIndividual, chx:ReleaseVerification ; rdfs:label "SHA256SUMS and its signatures"@en ; skos:definition "A downloaded release can be checked against the SHA-256 checksums the project publishes and the signatures on them, which shows the file matches the published record."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_AlternativeToolkit a owl:NamedIndividual, chx:AlternativeToolkit ; rdfs:label "python-bitcoinlib, btcd, bitcoinj"@en ; skos:definition "Libraries, toolkits and full nodes in many languages give native access to Bitcoin, and their upkeep varies, so a listed toolkit's latest release is worth checking."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_VerifiedData a owl:NamedIndividual, chx:VerifiedData ; rdfs:label "a node's own verified answer"@en ; skos:definition "Data from your own node is authoritative because the node verified it, the property a provenance record is meant to describe."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:X_JsonLdContext a owl:NamedIndividual, chx:JsonLdContext ; rdfs:label "a context that maps JSON keys to IRIs"@en ; skos:definition "JSON-LD is a JSON-based format to serialize Linked Data, so the JSON a node returns can be given a meaning as linked data."@en ; dcterms:source <http://example.org/sen0401/ch03/research> .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 3 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch03/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 3 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which commands, figures and printed results of the chapter can be reproduced by execution on the current release, and what does the execution give?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What in the chapter has changed in Bitcoin Core since the book went to print, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 3 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from Mastering Bitcoin 3rd edition's chapter 3 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0401/ch03/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-09-29."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_0_0.py" .

