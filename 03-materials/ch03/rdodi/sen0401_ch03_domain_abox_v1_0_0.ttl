@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

<http://example.org/sen0401/ch03/abox> a owl:Ontology ;
    rdfs:label "SEN0401 chapter 3 domain ontology - ABox"@en ; owl:versionInfo "1.0.0" ; owl:versionIRI <http://example.org/sen0401/ch03/abox/1.0.0> ;
