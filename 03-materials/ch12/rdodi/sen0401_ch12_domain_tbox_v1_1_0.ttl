#################################################################
# Connectedness repair (discipline v2.19.0, BP-D56 and BP-D57), 2026-10-19.
# The datatype properties the A-Box uses and nothing declared, then the relations
# between the chapter's subject branches that the chapter's own sources state.
#################################################################
chx:input a owl:DatatypeProperty ; rdfs:label "input expression"@en ; rdfs:comment "The expression an input/output example evaluates."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:output a owl:DatatypeProperty ; rdfs:label "output value"@en ; rdfs:comment "The value that evaluating the example expression gives."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:carriesBitsOf a owl:ObjectProperty ; rdfs:label "carries the bits of"@en ;
    rdfs:comment "The header of block 277,316 carries the bits 1903a30c, which the compact encoding turns into the target. Basis: the chapter says of Header of block277316: 'bits 1903a30c'; the chapter says of Compact bits: '0x1903a30c is 0x03a30c times 256 to the power 22'."@en ;
    rdfs:domain chx:HeaderOfBlock277316 ; rdfs:range chx:CompactBits ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:hashesBelowTarget a owl:ObjectProperty ; rdfs:label "hashes below the target of"@en ;
    rdfs:comment "The header of block 277,316 hashes to 0000000000000001b6b9a13b..., below its target. Basis: the chapter says of Header of block277316: 'hashes to the block id 0000000000000001b6b9a13b'; the chapter says of Hash below target: 'hash 0000000000000001b6b9a13b'."@en ;
    rdfs:domain chx:HeaderOfBlock277316 ; rdfs:range chx:HashBelowTarget ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:changesWithExtraNonce a owl:ObjectProperty ; rdfs:label "changes with"@en ;
    rdfs:comment "Two coinbases that differed only in extra nonce gave different txids and so different merkle roots. Basis: the chapter says of The extra nonce changes the root: 'two coinbases that differed only in extra nonce gave different txids'; the chapter says of The extra nonce space: 'An 8-byte extra nonce in the coinbase'."@en ;
    rdfs:domain chx:ExtraNonceChangesRoot ; rdfs:range chx:ExtraNonceSpace ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:rollsVersionBits a owl:ObjectProperty ; rdfs:label "rolls bits of"@en ;
    rdfs:comment "In block 840,000 the version bits 0x0a5fe000 carry rolled data. Basis: the chapter says of Version history: 'the bits 0x0a5fe000 carry rolled data'; the chapter says of Version rolling: 'BIP 320 reserves the 16 bits of mask 0x1fffe000 for rolling'."@en ;
    rdfs:domain chx:VersionHistory ; rdfs:range chx:VersionRolling ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:signalsTaproot a owl:ObjectProperty ; rdfs:label "signals"@en ;
    rdfs:comment "The version 0x20200004 of block 709,632 signals bit 2 for taproot. Basis: the chapter says of Version history: '0x20200004 in block 709,632, which signals bit 2 for taproot'; the chapter says of Speedy Trial and taproot: 'block 709,632 was mined by F2Pool'."@en ;
    rdfs:domain chx:VersionHistory ; rdfs:range chx:SpeedyTrialTaproot ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:startsWithBip34 a owl:ObjectProperty ; rdfs:label "follows the rule of"@en ;
    rdfs:comment "Since BIP 34 the coinbase script begins with the block height. Basis: the chapter says of BIP 34 height push: 'Since BIP 34 the coinbase script begins with the block height as a minimally encoded number'; the chapter says of BIP 34 activation: 'BIP 34 activated by counting'."@en ;
    rdfs:domain chx:Bip34HeightPush ; rdfs:range chx:Bip34Activation ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:rejectsMissingHeight a owl:ObjectProperty ; rdfs:label "makes the strict node refuse a block without"@en ;
    rdfs:comment "The strict node answered bad-cb-height to a block with no height in its coinbase. Basis: the chapter says of A soft fork only tightens: 'the lax node accepted a block with no height in its coinbase and the strict node answered bad-cb-height'; the chapter says of BIP 34 height push: 'Since BIP 34 the coinbase script begins with the block height'."@en ;
    rdfs:domain chx:SoftForkOnlyTightens ; rdfs:range chx:Bip34HeightPush ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:mintedByViaBtc a owl:ObjectProperty ; rdfs:label "was mined by the pool tagged in"@en ;
    rdfs:comment "Block 840,000 was mined by ViaBTC, whose tag its coinbase carries. Basis: the chapter says of The fees of block 840,000: 'mined by ViaBTC'; the chapter says of Coinbase data and tags: 'block 840,000 has /ViaBTC/'."@en ;
    rdfs:domain chx:FeesOfBlock840000 ; rdfs:range chx:CoinbaseDataAndTags ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:fillsCoinbaseValue a owl:ObjectProperty ; rdfs:label "fills the coinbase value of"@en ;
    rdfs:comment "A block template gives the coinbase value, which is the most a coinbase may claim. Basis: the chapter says of Template fields: 'the coinbasevalue (5,000,000,000 satoshis at height 1)'; the chapter says of Reward is subsidy plus fees: 'The most a coinbase may claim is the subsidy plus the fees of the block'."@en ;
    rdfs:domain chx:TemplateFields ; rdfs:range chx:RewardIsSubsidyPlusFees ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:sizesNonceAgainstNetwork a owl:ObjectProperty ; rdfs:label "measures the nonce space against"@en ;
    rdfs:comment "The 4-byte nonce is used up at once by a network of 1.029e21 hashes per second. Basis: the chapter says of The nonce space is tiny: 'today's network of 1.029e21 hashes per second'; the chapter says of Hash rate from difficulty: '1.029e21 of mempool.space'."@en ;
    rdfs:domain chx:NonceSpaceIsTiny ; rdfs:range chx:HashrateFromDifficulty ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:setsEasierTarget a owl:ObjectProperty ; rdfs:label "sets an easier target than"@en ;
    rdfs:comment "A pool sets an easier target so that members prove their work with shares. Basis: the chapter says of Pool shares and fees: 'A pool sets an easier target so that members prove their work with shares'; the chapter says of Hash below target: 'Block 277,316 had to hash below a target'."@en ;
    rdfs:domain chx:PoolSharesAndFees ; rdfs:range chx:HashBelowTarget ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:isShownByReorganization a owl:ObjectProperty ; rdfs:label "is carried out in the test by"@en ;
    rdfs:comment "A majority attacker can double-spend his own transactions, which the test shows by a competing block with more work. Basis: the chapter says of The limits of a majority attack: 'a majority attacker can double-spend his own transactions'; the chapter says of Double spend by reorganization: 'a competing block with a refund of the same coins was added with one block more of work'."@en ;
    rdfs:domain chx:MajorityAttackLimits ; rdfs:range chx:DoubleSpendByReorganization ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:addressesTimeWarp a owl:ObjectProperty ; rdfs:label "addresses the time warp attack of"@en ;
    rdfs:comment "BIP 54 proposes to fix the time warp attack that BIP 94 prevents on testnet4. Basis: the chapter says of BIP 54 consensus cleanup: 'proposes to fix the time warp attack'; the chapter says of The BIP 94 branch: 'BIP 94 describes the time warp prevention'."@en ;
    rdfs:domain chx:Bip54ConsensusCleanup ; rdfs:range chx:Bip94Branch ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:checksMedianTime a owl:ObjectProperty ; rdfs:label "checks"@en ;
    rdfs:comment "The block checklist refuses a time not after the median. Basis: the chapter says of Block checklist: 'a time not after the median'; the chapter says of Median time past: 'The time of a block must be greater than the median of the previous 11 blocks'."@en ;
    rdfs:domain chx:BlockChecklist ; rdfs:range chx:MedianTimePast ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:checksFutureTime a owl:ObjectProperty ; rdfs:label "checks"@en ;
    rdfs:comment "The block checklist refuses a time two hours and a second ahead. Basis: the chapter says of Block checklist: 'a time two hours and a second ahead'; the chapter says of Two hour rule: 'A node refuses a block whose time is more than 2 hours'."@en ;
    rdfs:domain chx:BlockChecklist ; rdfs:range chx:TwoHourRule ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:checksRewardLimit a owl:ObjectProperty ; rdfs:label "checks"@en ;
    rdfs:comment "The block checklist refuses a reward one satoshi too high. Basis: the chapter says of Block checklist: 'a reward one satoshi too high'; the chapter says of Greedy coinbase rejected: 'A coinbase that claims one satoshi more than subsidy plus fees makes the block invalid'."@en ;
    rdfs:domain chx:BlockChecklist ; rdfs:range chx:GreedyCoinbaseRejected ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:checksCoinbaseHeight a owl:ObjectProperty ; rdfs:label "checks"@en ;
    rdfs:comment "The block checklist refuses a block with no height in its coinbase. Basis: the chapter says of Block checklist: 'no height'; the chapter says of BIP 34 height push: 'Since BIP 34 the coinbase script begins with the block height'."@en ;
    rdfs:domain chx:BlockChecklist ; rdfs:range chx:Bip34HeightPush ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
chx:usesDifficultyOf a owl:ObjectProperty ; rdfs:label "uses the difficulty from"@en ;
    rdfs:comment "The wait of a terahash miner is computed from the difficulty 1,180,923,195 of block 277,316. Basis: the chapter says of The wait of a terahash miner: 'the difficulty 1,180,923,195 times 2 to the 32 divided by 10 to the 12 gives 58.7 days'; the chapter says of Difficulty from target: 'bits 1903a30c give 1,180,923,195 for block 277,316'."@en ;
    rdfs:domain chx:TerahashMinerWait ; rdfs:range chx:DifficultyFromTarget ; rdfs:isDefinedBy <http://example.org/sen0401/ch12/tbox> .
