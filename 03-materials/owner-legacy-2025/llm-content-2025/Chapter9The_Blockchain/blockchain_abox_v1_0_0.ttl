@prefix : <http://example.org/blockchain#> .
@prefix bc: <http://example.org/blockchain#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#
#    Disjoint Classes
#
#################################################################

[] a owl:AllDisjointClasses ;
    owl:members ( :GenesisBlock :RegularBlock :OrphanBlock :StaleBlock ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :CoinbaseTransaction :StandardTransaction :SegWitTransaction ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :SoftFork :HardFork ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :MainNetwork :TestNetwork :RegtestNetwork :Layer2Network ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :ECDSA :SchnorrSignatures ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :BlockchainStructure :BlockchainProcess :BlockchainProtocol :BlockchainNetwork :BlockchainComponent :BlockchainCharacteristic ) .

#################################################################
#
#    Individuals (Representative Instances)
#
#################################################################

### Bitcoin Genesis Block ###

:BitcoinGenesisBlock a :GenesisBlock ;
    rdfs:label "Bitcoin Genesis Block"@en ;
    rdfs:comment "First block ever created in Bitcoin blockchain on January 3, 2009"@en ;
    :blockHeight "0"^^xsd:nonNegativeInteger ;
    :hasBlockHash [
        a :BlockHash ;
        rdfs:label "000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f"@en
    ] ;
    :hasBlockHeader [
        a :BlockHeader ;
        :timestamp "2009-01-03T18:15:05Z"^^xsd:dateTime
    ] ;
    :sourceEvidence [
        :sourceType "DirectText" ;
        :sourceDocument "Chapter_9_The_Blockchain_txt.txt" ;
        :sourceLine "90" ;
        :sourceQuote "000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f is the block hash of the first bitcoin block ever created" ;
        :confidence "1.0"^^xsd:decimal
    ] .

### Regtest Genesis Block ###

:RegtestGenesisBlock a :GenesisBlock ;
    rdfs:label "Regtest Genesis Block"@en ;
    rdfs:comment "Genesis block for regression test network"@en ;
    :blockHeight "0"^^xsd:nonNegativeInteger ;
    :hasBlockHash [
        a :BlockHash ;
        rdfs:label "0f9188f13cb7b2c71f2a335e3a4fc328bf5beb436012afca590b1a11466e2206"@en
    ] ;
    :sourceEvidence [
        :sourceType "DirectText" ;
        :sourceDocument "Chapter_9_The_Blockchain_txt.txt" ;
        :sourceLine "507" ;
        :sourceQuote "bestblockhash: 0f9188f13cb7b2c71f2a335e3a4fc328bf5beb436012afca590b1a11466e2206" ;
        :confidence "1.0"^^xsd:decimal
    ] .

### Example Regular Block ###

:ExampleBlock446000 a :RegularBlock ;
    rdfs:label "Example Block at Height 446000"@en ;
    rdfs:comment "Representative block from January 1, 2017"@en ;
    :blockHeight "446000"^^xsd:nonNegativeInteger ;
    :transactionCounter "500"^^xsd:nonNegativeInteger .

### Example SegWit Transaction ###

:ExampleSegWitTransaction a :SegWitTransaction ;
    rdfs:label "Example SegWit Transaction"@en ;
    rdfs:comment "Representative Segregated Witness transaction with separated witness data"@en ;
    :introducedIn :SegregatedWitness .

### Example Lightning Payment Channel ###

:ExampleLightningChannel a owl:NamedIndividual ;
    rdfs:label "Example Lightning Payment Channel"@en ;
    rdfs:comment "Bidirectional payment channel on Lightning Network between two parties"@en ;
    rdf:type owl:Thing .

### SegWit Activation Instance ###

:SegWitActivation a owl:NamedIndividual ;
    rdfs:label "SegWit Activation Event"@en ;
    rdfs:comment "Activation of Segregated Witness on Bitcoin mainnet"@en ;
    :activationDate "2017-08-24T01:57:37Z"^^xsd:dateTime ;
    :activationBlockHeight "481824"^^xsd:nonNegativeInteger .

### Taproot Activation Instance ###

:TaprootActivation a owl:NamedIndividual ;
    rdfs:label "Taproot Activation Event"@en ;
    rdfs:comment "Activation of Taproot upgrade on Bitcoin mainnet"@en ;
    :activationDate "2021-11-14T00:00:00Z"^^xsd:dateTime ;
    :activationBlockHeight "709632"^^xsd:nonNegativeInteger .

### SHA256 Algorithm Instance ###

:SHA256Algorithm a :SHA256 ;
    rdfs:label "SHA256 Hash Function"@en ;
    rdfs:comment "Cryptographic hash function used throughout Bitcoin"@en .

### Proof-of-Work Instance ###

:BitcoinProofOfWork a :ProofOfWork ;
    rdfs:label "Bitcoin Proof-of-Work"@en ;
    rdfs:comment "Bitcoin's consensus mechanism based on computational work"@en .

