@prefix : <http://example.org/blockchain/transactions#> .
@prefix btx: <http://example.org/blockchain/transactions#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# ONTOLOGY METADATA
# =============================================================================

<http://example.org/blockchain/transactions> a owl:Ontology ;
    dcterms:title "Blockchain Transactions Ontology"@en ;
    dcterms:description """Comprehensive formal ontology for blockchain transaction concepts covering Bitcoin and related protocols. This ontology provides systematic knowledge representation of transaction structures, scripting mechanisms, cryptographic signatures, time-locking capabilities, and Layer 2 payment protocols including the Lightning Network.
    
    The ontology encompasses:
    - Core transaction concepts from Bitcoin's inception through 2025
    - Transaction types: Legacy (P2PKH, P2SH), SegWit (P2WPKH, P2WSH), Taproot (P2TR)
    - Advanced scripting: multisignature, timelocks, conditional execution
    - Digital signatures: ECDSA and Schnorr signature schemes
    - Segregated Witness architecture (BIP141-144, 2017)
    - Taproot upgrade with MAST and key aggregation (BIP340-342, 2021)
    - Lightning Network payment channels and HTLCs (2018+)
    - Transaction validation, propagation, and blockchain integration
    
    Designed for educational use in SEN0401: Special Topics in Software Engineering (Blockchain) at Istanbul Kültür University, enabling interactive exploration and discovery of blockchain transaction concepts within a Zero-Time learning environment."""@en ;
    dcterms:created "2025-12-12"^^xsd:date ;
    dcterms:modified "2025-12-12"^^xsd:date ;
    dcterms:creator "Dr. Yusuf Altunel"@en ;
    dcterms:contributor "Istanbul Kültür University - Computer Engineering Department"@en ;
    dcterms:source <https://github.com/bitcoinbook/bitcoinbook>,
        <https://github.com/bitcoin/bips>,
        <https://github.com/lightning/bolts> ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright © 2025 Istanbul Kültür University. Licensed under Creative Commons Attribution 4.0 International (CC BY 4.0)."@en ;
    dcterms:abstract """This ontology formalizes the domain of blockchain transactions with emphasis on Bitcoin and Lightning Network protocols. It provides a comprehensive taxonomy of transaction types, script constructions, signature schemes, and payment channel mechanisms. The ontology is grounded in authoritative sources including Bitcoin Improvement Proposals (BIPs) and technical specifications, ensuring accuracy and currency through 2025."""@en ;
    owl:versionIRI <http://example.org/blockchain/transactions/v1.0.0> ;
    owl:versionInfo "1.0.0" ;
    prov:wasGeneratedBy [ a prov:Activity ;
        rdfs:label "Blockchain Transactions Ontology Development"@en ;
        rdfs:comment "Systematic ontology engineering following research-first methodology with validation against OQC v1.2.0 quality framework."@en ;
        prov:startedAtTime "2025-12-12T00:00:00Z"^^xsd:dateTime ;
        prov:used <file:///mnt/user-data/uploads/Chapter6_Transactions_Andreas_M__Antonopoulos_2017.txt>,
            <file:///mnt/user-data/uploads/Chapter_7_Advanced_Transactions_and_Scripting_Andreas_M__Antonopoulos_2017.txt> ;
        prov:wasAssociatedWith <http://example.org/agents/ontology-engineer>
    ] .

# =============================================================================
# TOP-LEVEL CLASSES
# =============================================================================

btx:Transaction a owl:Class ;
    rdfs:label "Transaction"@en ;
    rdfs:comment "Data structure encoding the transfer of value between participants in a blockchain system."@en ;
    skos:definition "A transaction is the fundamental unit of value transfer in blockchain systems, consisting of inputs that consume previous outputs and new outputs that can be consumed by future transactions. Transactions are validated, propagated across the peer-to-peer network, and permanently recorded in blocks."@en ;
    skos:example "Alice sends 0.5 BTC to Bob using transaction txid abc123...def, which consumes Alice's previous output and creates a new output controlled by Bob's public key hash."@en ;
    skos:altLabel "TX"@en, "Blockchain Transaction"@en ;
    rdfs:subClassOf owl:Thing ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasInput ;
        owl:minCardinality 1
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasOutput ;
        owl:minCardinality 1
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasVersion ;
        owl:cardinality 1
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasTXID ;
        owl:cardinality 1
    ] .

btx:TransactionInput a owl:Class ;
    rdfs:label "Transaction Input"@en ;
    rdfs:comment "Reference to a previous transaction output that is being spent, along with proof of authorization to spend it."@en ;
    skos:definition "A transaction input specifies a previous unspent transaction output (UTXO) to be consumed and provides an unlocking script (scriptSig or witness) that satisfies the spending conditions of that output. Each input identifies the previous transaction by TXID and output index (vout)."@en ;
    skos:example "Input referencing txid xyz789...abc at index 0 with scriptSig containing signature and public key that unlock a P2PKH output."@en ;
    skos:altLabel "TxIn"@en, "Input"@en ;
    rdfs:subClassOf owl:Thing ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:referencesTransaction ;
        owl:cardinality 1
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasVoutIndex ;
        owl:cardinality 1
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasSequence ;
        owl:cardinality 1
    ] .

btx:TransactionOutput a owl:Class ;
    rdfs:label "Transaction Output"@en ;
    rdfs:comment "Indivisible chunk of bitcoin currency with specified value and spending conditions."@en ;
    skos:definition "A transaction output (TXO) specifies an amount of cryptocurrency (in satoshis) and the conditions under which it can be spent, encoded as a locking script (scriptPubKey). Unspent outputs (UTXOs) form the fundamental state of the blockchain, representing all available funds."@en ;
    skos:example "Output of 0.01500000 BTC with P2PKH locking script OP_DUP OP_HASH160 ab68025513c3dbd2f7b92a94e0581f5d50f654e7 OP_EQUALVERIFY OP_CHECKSIG."@en ;
    skos:altLabel "TxOut"@en, "Output"@en, "TXO"@en ;
    rdfs:subClassOf owl:Thing ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasValue ;
        owl:cardinality 1
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasLockingScript ;
        owl:cardinality 1
    ] .

btx:Script a owl:Class ;
    rdfs:label "Script"@en ;
    rdfs:comment "Stack-based program that defines or satisfies spending conditions for transaction outputs."@en ;
    skos:definition "Bitcoin Script is a Forth-like, stack-based, non-Turing-complete programming language used to specify and verify spending conditions. Scripts are executed by validating nodes to determine transaction validity. They support various operations including cryptographic functions, conditional logic, and arithmetic."@en ;
    skos:example "P2PKH locking script: OP_DUP OP_HASH160 <pubKeyHash> OP_EQUALVERIFY OP_CHECKSIG"@en ;
    skos:altLabel "Bitcoin Script"@en, "Script Program"@en ;
    rdfs:subClassOf owl:Thing .

btx:DigitalSignature a owl:Class ;
    rdfs:label "Digital Signature"@en ;
    rdfs:comment "Cryptographic proof demonstrating authorization to spend a transaction output."@en ;
    skos:definition "A digital signature is created using a private key and proves that the owner of the corresponding public key has authorized a transaction. Bitcoin supports both ECDSA (Elliptic Curve Digital Signature Algorithm) and Schnorr signature schemes. The signature commits to the transaction data being signed and the SIGHASH type."@en ;
    skos:example "ECDSA signature with r=3045022100884d142d86... and s=02204b9f039ff08df09... signing transaction inputs with SIGHASH_ALL."@en ;
    skos:altLabel "Signature"@en, "Cryptographic Signature"@en ;
    rdfs:subClassOf owl:Thing ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:signsTransaction ;
        owl:someValuesFrom btx:Transaction
    ] .

btx:Block a owl:Class ;
    rdfs:label "Block"@en ;
    rdfs:comment "Container of validated transactions with header containing proof-of-work and linkage to previous block."@en ;
    skos:definition "A block is the fundamental structure in a blockchain, containing a block header (with timestamp, nonce, difficulty target, Merkle root, and previous block hash) and a list of valid transactions. Blocks are chained together via cryptographic hashes, forming an immutable distributed ledger."@en ;
    skos:example "Block 709632 containing 2,812 transactions, including the Taproot activation signaling."@en ;
    skos:altLabel "Blockchain Block"@en ;
    rdfs:subClassOf owl:Thing ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:containsTransaction ;
        owl:minCardinality 1
    ] .

btx:Blockchain a owl:Class ;
    rdfs:label "Blockchain"@en ;
    rdfs:comment "Distributed ledger consisting of cryptographically-linked blocks forming an immutable transaction history."@en ;
    skos:definition "The blockchain is a globally replicated, append-only data structure where each block references the previous block via cryptographic hash, creating an immutable chain. It serves as Bitcoin's public ledger, recording all valid transactions in chronological order with proof-of-work consensus ensuring integrity."@en ;
    skos:example "Bitcoin blockchain containing over 800,000 blocks as of 2025, storing complete transaction history since genesis block (2009)."@en ;
    skos:altLabel "Distributed Ledger"@en, "Public Ledger"@en ;
    rdfs:subClassOf owl:Thing ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:containsBlock ;
        owl:minCardinality 1
    ] .

# Disjointness assertions for top-level classes
btx:Transaction owl:disjointWith btx:Block, btx:Blockchain .
btx:TransactionInput owl:disjointWith btx:TransactionOutput .
btx:Block owl:disjointWith btx:Blockchain .

# =============================================================================
# TRANSACTION TYPE HIERARCHY
# =============================================================================

btx:StandardTransaction a owl:Class ;
    rdfs:label "Standard Transaction"@en ;
    rdfs:comment "Commonly used transaction type following standard patterns recognized by Bitcoin nodes."@en ;
    skos:definition "A standard transaction is one that follows well-known output patterns (P2PKH, P2SH, P2WPKH, P2WSH, P2TR) and is relayed by default node policies. Standard transactions have predictable validation costs and are commonly accepted for mining."@en ;
    rdfs:subClassOf btx:Transaction .

btx:LegacyTransaction a owl:Class ;
    rdfs:label "Legacy Transaction"@en ;
    rdfs:comment "Pre-SegWit transaction format with signatures in scriptSig field."@en ;
    skos:definition "Legacy transactions use the original Bitcoin transaction format where unlocking scripts (containing signatures) are part of the transaction input structure in the scriptSig field. These transactions predate Segregated Witness and do not separate witness data."@en ;
    skos:example "Transaction with P2PKH output spending where signature is placed in scriptSig of the spending input."@en ;
    skos:altLabel "Pre-SegWit Transaction"@en ;
    rdfs:subClassOf btx:StandardTransaction ;
    owl:disjointWith btx:SegWitTransaction, btx:TaprootTransaction .

btx:Pay-to-Public-Key-Hash a owl:Class ;
    rdfs:label "Pay-to-Public-Key-Hash Transaction"@en ;
    rdfs:comment "Transaction paying to a 20-byte hash of a public key, the most common Bitcoin transaction type."@en ;
    skos:definition "P2PKH is the original and most widely used Bitcoin transaction type. The locking script requires the recipient to provide both a public key and a signature proving ownership of the corresponding private key. The public key must hash to the value specified in the script."@en ;
    skos:example "Output scriptPubKey: OP_DUP OP_HASH160 <pubKeyHash> OP_EQUALVERIFY OP_CHECKSIG. Spent with scriptSig: <signature> <publicKey>."@en ;
    skos:altLabel "P2PKH"@en, "P2PKH Transaction"@en ;
    rdfs:subClassOf btx:LegacyTransaction ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasLockingScriptType ;
        owl:hasValue btx:P2PKH_Script
    ] ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0016.mediawiki> .

btx:Pay-to-Public-Key a owl:Class ;
    rdfs:label "Pay-to-Public-Key Transaction"@en ;
    rdfs:comment "Early transaction type paying directly to a full public key (now rare)."@en ;
    skos:definition "P2PK was used in early Bitcoin versions where the locking script contained the full public key rather than its hash. It is now rarely used due to larger size and reduced privacy compared to P2PKH."@en ;
    skos:example "Output scriptPubKey: <publicKey> OP_CHECKSIG. Coinbase transactions in early blocks used P2PK."@en ;
    skos:altLabel "P2PK"@en ;
    rdfs:subClassOf btx:LegacyTransaction .

btx:Pay-to-Script-Hash a owl:Class ;
    rdfs:label "Pay-to-Script-Hash Transaction"@en ;
    rdfs:comment "Transaction paying to a hash of a script (redeem script), enabling complex spending conditions."@en ;
    skos:definition "P2SH (BIP16) allows the sender to pay to a hash of an arbitrary script (the redeem script), rather than encoding the full script in the locking script. The spender must provide the redeem script matching the hash along with data satisfying its conditions. This shifts complexity and transaction fees from sender to recipient."@en ;
    skos:example "Multisig 2-of-3: locking script contains HASH160 <scriptHash> EQUAL. Spending requires signatures and the actual multisig redeem script."@en ;
    skos:altLabel "P2SH"@en ;
    rdfs:subClassOf btx:LegacyTransaction ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasRedeemScript ;
        owl:someValuesFrom btx:RedeemScript
    ] ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0016.mediawiki> .

btx:SegWitTransaction a owl:Class ;
    rdfs:label "Segregated Witness Transaction"@en ;
    rdfs:comment "Transaction format separating signature data into witness field (BIP141, activated August 2017)."@en ;
    skos:definition "Segregated Witness (SegWit) transactions separate the witness data (signatures and scripts) from the transaction structure, placing it in a new witness field. This fixes transaction malleability, enables larger effective blocks through weight-based accounting, and improves signature validation efficiency. SegWit transactions use witness version 0."@en ;
    skos:example "P2WPKH transaction where signature and public key are in witness field, not scriptSig. TXID computed without witness data, while WTXID includes it."@en ;
    skos:altLabel "SegWit Transaction"@en, "SegWit TX"@en ;
    rdfs:subClassOf btx:StandardTransaction ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasWitness ;
        owl:someValuesFrom btx:Witness
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasWTXID ;
        owl:cardinality 1
    ] ;
    owl:disjointWith btx:LegacyTransaction, btx:TaprootTransaction ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0141.mediawiki> .

btx:Pay-to-Witness-Public-Key-Hash a owl:Class ;
    rdfs:label "Pay-to-Witness-Public-Key-Hash Transaction"@en ;
    rdfs:comment "Native SegWit transaction type for single-signature payments with 20-byte witness program."@en ;
    skos:definition "P2WPKH is the SegWit equivalent of P2PKH. The locking script consists of witness version 0 (OP_0) followed by a 20-byte public key hash. The unlocking data (signature and public key) is provided in the witness field rather than scriptSig, making the transaction smaller and fixing malleability."@en ;
    skos:example "scriptPubKey: OP_0 <20-byte-pubkey-hash>. Witness: <signature> <pubkey>. Address format: bc1q..."@en ;
    skos:altLabel "P2WPKH"@en ;
    rdfs:subClassOf btx:SegWitTransaction ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasWitnessVersion ;
        owl:hasValue 0
    ] ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0141.mediawiki> .

btx:Pay-to-Witness-Script-Hash a owl:Class ;
    rdfs:label "Pay-to-Witness-Script-Hash Transaction"@en ;
    rdfs:comment "Native SegWit transaction type for complex scripts with 32-byte witness program."@en ;
    skos:definition "P2WSH is the SegWit equivalent of P2SH. The locking script consists of witness version 0 (OP_0) followed by a 32-byte script hash (SHA256). The witness must provide the witness script and data satisfying it. This enables complex scripts with SegWit benefits."@en ;
    skos:example "scriptPubKey: OP_0 <32-byte-script-hash>. Witness: <witness-stack-items> <witness-script>. Used for multisig, timelocks, complex conditions."@en ;
    skos:altLabel "P2WSH"@en ;
    rdfs:subClassOf btx:SegWitTransaction ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasWitnessVersion ;
        owl:hasValue 0
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasWitnessScript ;
        owl:someValuesFrom btx:WitnessScript
    ] ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0141.mediawiki> .

btx:P2SH-wrapped-SegWit a owl:Class ;
    rdfs:label "P2SH-wrapped SegWit Transaction"@en ;
    rdfs:comment "SegWit transaction embedded in P2SH for backward compatibility with older wallets."@en ;
    skos:definition "SegWit-in-P2SH wraps a native SegWit script (P2WPKH or P2WSH) inside a P2SH output, enabling older wallets to send to SegWit addresses without upgrade. The redeem script is the SegWit script, and witness data is still used for spending."@en ;
    skos:example "P2SH-P2WPKH: redeem script is OP_0 <20-byte-pubkey-hash>. P2SH address starts with '3'."@en ;
    skos:altLabel "Nested SegWit"@en, "P2SH-P2WPKH"@en, "P2SH-P2WSH"@en ;
    rdfs:subClassOf btx:SegWitTransaction ;
    rdfs:subClassOf btx:Pay-to-Script-Hash .

btx:TaprootTransaction a owl:Class ;
    rdfs:label "Taproot Transaction"@en ;
    rdfs:comment "Transaction using Schnorr signatures, key aggregation, and MAST (BIP341, activated November 2021)."@en ;
    skos:definition "Taproot transactions use witness version 1 with 32-byte output, enabling two spending paths: key path (single Schnorr signature, most efficient) and script path (reveal one script from Merkle tree). Taproot improves privacy by making all outputs look identical and improves efficiency through Schnorr signatures and key aggregation."@en ;
    skos:example "P2TR output: OP_1 <32-byte-taproot-output>. Can be spent via key path signature or by revealing script + Merkle proof. Address: bc1p..."@en ;
    skos:altLabel "Taproot TX"@en, "P2TR Transaction"@en ;
    rdfs:subClassOf btx:StandardTransaction ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasWitnessVersion ;
        owl:hasValue 1
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:usesSignatureScheme ;
        owl:someValuesFrom btx:SchnorrSignature
    ] ;
    owl:disjointWith btx:LegacyTransaction, btx:SegWitTransaction ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki> .

btx:Pay-to-Taproot a owl:Class ;
    rdfs:label "Pay-to-Taproot Transaction"@en ;
    rdfs:comment "Taproot output with optional script tree, spendable via key path or script path."@en ;
    skos:definition "P2TR outputs encode a tweaked public key that commits to an optional Merkle tree of scripts. Key path spending requires a single Schnorr signature on the output key (appears as simple payment). Script path spending reveals one script from the tree and executes it via Tapscript."@en ;
    skos:example "Simple payment: P2TR with key path only (no scripts). Complex: P2TR with MAST containing multiple spending conditions."@en ;
    skos:altLabel "P2TR"@en ;
    rdfs:subClassOf btx:TaprootTransaction ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki> .

btx:MultisigTransaction a owl:Class ;
    rdfs:label "Multisignature Transaction"@en ;
    rdfs:comment "Transaction requiring M-of-N signatures from multiple parties to spend."@en ;
    skos:definition "A multisignature transaction requires multiple signatures (M) from a set of possible signers (N) to authorize spending. This provides enhanced security through shared control, useful for corporate accounts, escrow, and collaborative custody. Implementation varies: bare multisig, P2SH multisig, or Schnorr threshold signatures in Taproot."@en ;
    skos:example "2-of-3 multisig: requires any 2 signatures from 3 possible public keys. Common in escrow where buyer, seller, and arbitrator share control."@en ;
    skos:altLabel "Multisig Transaction"@en, "M-of-N Transaction"@en ;
    rdfs:subClassOf btx:Transaction ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:requiresMinimumSignatures ;
        owl:someValuesFrom xsd:integer
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasTotalSigners ;
        owl:someValuesFrom xsd:integer
    ] .

btx:TimelockedTransaction a owl:Class ;
    rdfs:label "Timelocked Transaction"@en ;
    rdfs:comment "Transaction with temporal spending restrictions based on time or block height."@en ;
    skos:definition "A timelocked transaction cannot be added to the blockchain before a specified time or block height (absolute timelock) or until a specified duration has elapsed since output creation (relative timelock). Timelocks enable payment channels, refund mechanisms, and scheduled payments."@en ;
    skos:example "Refund transaction with nLockTime set to 30 days in future, ensuring funds return to sender if recipient doesn't claim."@en ;
    skos:altLabel "Time-Locked Transaction"@en ;
    rdfs:subClassOf btx:Transaction ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasTimelock ;
        owl:someValuesFrom btx:Timelock
    ] .

btx:CoinbaseTransaction a owl:Class ;
    rdfs:label "Coinbase Transaction"@en ;
    rdfs:comment "Special first transaction in each block that creates new bitcoins and collects fees."@en ;
    skos:definition "The coinbase transaction is the first transaction in every block, created by the miner. It has no inputs (creates new bitcoins from nothing) and outputs containing the block reward plus all transaction fees from the block. The input's scriptSig can contain arbitrary data (historically used for extra nonce and miner identification)."@en ;
    skos:example "Block 709632 coinbase: 6.25 BTC block reward + 0.15 BTC fees = 6.40 BTC total to miner."@en ;
    skos:altLabel "Generation Transaction"@en, "Coinbase TX"@en ;
    rdfs:subClassOf btx:Transaction ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasInput ;
        owl:cardinality 1
    ] ;
    dcterms:source <https://github.com/bitcoinbook/bitcoinbook> .

# =============================================================================
# SCRIPT TYPE HIERARCHY  
# =============================================================================

btx:LockingScript a owl:Class ;
    rdfs:label "Locking Script"@en ;
    rdfs:comment "Script defining the conditions that must be satisfied to spend a transaction output."@en ;
    skos:definition "A locking script (scriptPubKey) encodes the spending conditions for a transaction output. It specifies what data must be provided in the unlocking script to successfully spend the output. Common patterns include requiring signatures, hash preimages, or script execution."@en ;
    skos:example "P2PKH locking script: OP_DUP OP_HASH160 <pubKeyHash> OP_EQUALVERIFY OP_CHECKSIG"@en ;
    skos:altLabel "scriptPubKey"@en, "Output Script"@en, "Pubkey Script"@en ;
    rdfs:subClassOf btx:Script .

btx:UnlockingScript a owl:Class ;
    rdfs:label "Unlocking Script"@en ;
    rdfs:comment "Script providing data to satisfy a locking script's spending conditions."@en ;
    skos:definition "An unlocking script (scriptSig or witness data) provides the inputs needed to satisfy a locking script. For legacy transactions, this is the scriptSig field. For SegWit, the unlocking data is in the witness field. The unlocking script typically contains signatures and public keys."@en ;
    skos:example "P2PKH unlocking script: <signature> <publicKey>"@en ;
    skos:altLabel "scriptSig"@en, "Signature Script"@en, "Input Script"@en ;
    rdfs:subClassOf btx:Script .

btx:RedeemScript a owl:Class ;
    rdfs:label "Redeem Script"@en ;
    rdfs:comment "Script whose hash is committed in P2SH, revealed when spending."@en ;
    skos:definition "A redeem script is the actual script whose hash appears in a P2SH output. It is not revealed at output creation (only its hash), but must be provided when spending the output. The provided redeem script must hash to the value in the P2SH output, and its execution must succeed."@en ;
    skos:example "2-of-3 multisig redeem script: 2 <PubKey1> <PubKey2> <PubKey3> 3 CHECKMULTISIG"@en ;
    rdfs:subClassOf btx:Script ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0016.mediawiki> .

btx:WitnessScript a owl:Class ;
    rdfs:label "Witness Script"@en ;
    rdfs:comment "Script whose hash is committed in P2WSH, revealed in witness data when spending."@en ;
    skos:definition "A witness script is the SegWit equivalent of a redeem script, used with P2WSH outputs. The script's SHA256 hash is committed in the output, and the full script is provided in the witness data when spending. This enables complex scripts with SegWit's benefits."@en ;
    skos:example "P2WSH multisig witness script provided in witness along with signatures."@en ;
    skos:altLabel "Witness Program Script"@en ;
    rdfs:subClassOf btx:Script ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0141.mediawiki> .

btx:Witness a owl:Class ;
    rdfs:label "Witness"@en ;
    rdfs:comment "Segregated signature and script data in SegWit transactions."@en ;
    skos:definition "The witness is a data structure introduced in SegWit containing the unlocking information (signatures, public keys, scripts) for transaction inputs. It is segregated from the main transaction structure, enabling transaction malleability fix and weight-based block capacity. Each input has its own witness."@en ;
    skos:example "P2WPKH witness: [<signature>, <publicKey>]. P2WSH witness: [<signatures>, <witness-script>]."@en ;
    skos:altLabel "Witness Data"@en, "Witness Field"@en ;
    rdfs:subClassOf owl:Thing ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0141.mediawiki> .

btx:P2PKH_Script a owl:Class ;
    rdfs:label "P2PKH Locking Script"@en ;
    rdfs:comment "Standard Pay-to-Public-Key-Hash script pattern."@en ;
    skos:definition "The P2PKH script pattern: OP_DUP OP_HASH160 <pubKeyHash> OP_EQUALVERIFY OP_CHECKSIG. Requires signature and public key; verifies public key hashes to specified value and signature is valid."@en ;
    rdfs:subClassOf btx:LockingScript .

btx:P2SH_Script a owl:Class ;
    rdfs:label "P2SH Locking Script"@en ;
    rdfs:comment "Pay-to-Script-Hash script pattern."@en ;
    skos:definition "The P2SH script pattern: HASH160 <scriptHash> EQUAL. The spending input must provide a redeem script that hashes to the specified value, plus data satisfying that redeem script."@en ;
    rdfs:subClassOf btx:LockingScript ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0016.mediawiki> .

btx:P2WPKH_Script a owl:Class ;
    rdfs:label "P2WPKH Locking Script"@en ;
    rdfs:comment "Native SegWit single-signature script pattern."@en ;
    skos:definition "The P2WPKH script pattern: OP_0 <20-byte-pubkey-hash>. Witness must contain signature and public key that hashes to specified value."@en ;
    rdfs:subClassOf btx:LockingScript ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0141.mediawiki> .

btx:P2WSH_Script a owl:Class ;
    rdfs:label "P2WSH Locking Script"@en ;
    rdfs:comment "Native SegWit complex script pattern."@en ;
    skos:definition "The P2WSH script pattern: OP_0 <32-byte-script-hash>. Witness must contain witness script (SHA256 hashing to specified value) plus data satisfying it."@en ;
    rdfs:subClassOf btx:LockingScript ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0141.mediawiki> .

btx:P2TR_Script a owl:Class ;
    rdfs:label "P2TR Locking Script"@en ;
    rdfs:comment "Taproot script pattern with key and script paths."@en ;
    skos:definition "The P2TR script pattern: OP_1 <32-byte-taproot-output>. Can be spent via key path (Schnorr signature on output key) or script path (reveal script from Merkle tree)."@en ;
    rdfs:subClassOf btx:LockingScript ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki> .

btx:MultisigScript a owl:Class ;
    rdfs:label "Multisignature Script"@en ;
    rdfs:comment "Script requiring M-of-N signatures."@en ;
    skos:definition "Multisig script pattern: M <PubKey1> <PubKey2> ... <PubKeyN> N CHECKMULTISIG. Requires M valid signatures from the N possible public keys. Note CHECKMULTISIG bug requires extra 0 value at start of unlocking script."@en ;
    skos:example "2 <PubKey1> <PubKey2> <PubKey3> 3 CHECKMULTISIG for 2-of-3 multisig."@en ;
    rdfs:subClassOf btx:LockingScript .

btx:HTLCScript a owl:Class ;
    rdfs:label "Hashed Timelock Contract Script"@en ;
    rdfs:comment "Script combining hash lock and timelock for conditional payments."@en ;
    skos:definition "HTLC script enables conditional payments where recipient must reveal preimage of hash before timeout, or sender can reclaim after timeout. Critical for Lightning Network payment routing. Includes three spending paths: recipient with preimage, sender after timeout, either party with revocation key."@en ;
    skos:example "IF <recipientPubkey> CHECKSIG ELSE <timeout> CHECKLOCKTIMEVERIFY DROP <senderPubkey> CHECKSIG ENDIF"@en ;
    skos:altLabel "HTLC Script"@en, "Hash Time Lock Contract Script"@en ;
    rdfs:subClassOf btx:LockingScript ;
    dcterms:source <https://github.com/lightning/bolts> .

# Continue in Part 2...
# =============================================================================
# BLOCKCHAIN TRANSACTIONS ONTOLOGY - PART 2
# Digital Signatures, Lightning Network, Timelocks, Components, Properties
# =============================================================================

# Import from Part 1 (this would be combined in the final file)
# This is a continuation...

# =============================================================================
# DIGITAL SIGNATURE TAXONOMY
# =============================================================================

btx:ECDSASignature a owl:Class ;
    rdfs:label "ECDSA Signature"@en ;
    rdfs:comment "Elliptic Curve Digital Signature Algorithm signature used in Bitcoin."@en ;
    skos:definition "ECDSA is the digital signature scheme Bitcoin used exclusively until Taproot. It uses the secp256k1 elliptic curve and produces signatures with two components (r, s). Each signature is 71-72 bytes in DER encoding. ECDSA signatures commit to transaction data and SIGHASH type."@en ;
    skos:example "ECDSA signature: r=3045022100884d..., s=02204b9f..., signing with SIGHASH_ALL (0x01)."@en ;
    skos:altLabel "ECDSA Sig"@en ;
    rdfs:subClassOf btx:DigitalSignature ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasR_Value ;
        owl:cardinality 1
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasS_Value ;
        owl:cardinality 1
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasSighashType ;
        owl:cardinality 1
    ] ;
    owl:disjointWith btx:SchnorrSignature .

btx:SchnorrSignature a owl:Class ;
    rdfs:label "Schnorr Signature"@en ;
    rdfs:comment "Schnorr signature scheme introduced in Taproot (BIP340, activated November 2021)."@en ;
    skos:definition "Schnorr signatures are an alternative signature scheme using the same secp256k1 curve. They are 64 bytes (smaller than ECDSA), support linear aggregation enabling efficient multisig, allow batch verification, and have provable security. Schnorr is used exclusively in Taproot (witness version 1)."@en ;
    skos:example "Schnorr signature: 64-byte signature for key path Taproot spend, enabling multiple parties to appear as single signer."@en ;
    skos:altLabel "BIP340 Signature"@en, "Schnorr Sig"@en ;
    rdfs:subClassOf btx:DigitalSignature ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:usesXOnlyPublicKey ;
        owl:someValuesFrom btx:XOnlyPublicKey
    ] ;
    owl:disjointWith btx:ECDSASignature ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0340.mediawiki> .

btx:AggregatedSignature a owl:Class ;
    rdfs:label "Aggregated Signature"@en ;
    rdfs:comment "Multiple signatures combined into single signature via Schnorr aggregation."@en ;
    skos:definition "Schnorr signatures support linear aggregation where multiple signatures can be combined into a single signature that validates the combined statement. This makes multisig transactions indistinguishable from single-sig, improving privacy and reducing transaction size."@en ;
    skos:example "2-of-2 MuSig: two parties create single 64-byte signature that looks identical to single-party signature."@en ;
    skos:altLabel "MuSig Signature"@en, "Threshold Signature"@en ;
    rdfs:subClassOf btx:SchnorrSignature .

btx:XOnlyPublicKey a owl:Class ;
    rdfs:label "X-Only Public Key"@en ;
    rdfs:comment "32-byte public key containing only x-coordinate (y-coordinate inferred)."@en ;
    skos:definition "Taproot uses x-only public keys which store only the x-coordinate of the elliptic curve point (32 bytes instead of 33). The y-coordinate is inferred by always choosing the even y value. This saves 1 byte per key and simplifies some cryptographic operations."@en ;
    skos:example "X-only key: 32-byte value representing public key point with implicit even y-coordinate."@en ;
    rdfs:subClassOf owl:Thing ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0340.mediawiki> .

btx:SighashType a owl:Class ;
    rdfs:label "Sighash Type"@en ;
    rdfs:comment "Flag indicating which parts of transaction are signed."@en ;
    skos:definition "Sighash types control what portions of a transaction are committed to by a signature. Common types: SIGHASH_ALL (signs all inputs and outputs), SIGHASH_NONE (signs all inputs only), SIGHASH_SINGLE (signs all inputs and corresponding output), SIGHASH_ANYONECANPAY (modifier, signs only one input)."@en ;
    skos:example "SIGHASH_ALL (0x01): most common, signature commits to entire transaction."@en ;
    rdfs:subClassOf owl:Thing .

# =============================================================================
# TIMELOCK CLASSES
# =============================================================================

btx:Timelock a owl:Class ;
    rdfs:label "Timelock"@en ;
    rdfs:comment "Temporal restriction preventing transaction or output spending before specified time/height."@en ;
    skos:definition "A timelock is a mechanism that restricts when a transaction can be added to the blockchain or when an output can be spent. Timelocks can be absolute (specific time/block height) or relative (duration since output creation). They enable payment channels, escrow, scheduled payments, and refund mechanisms."@en ;
    skos:example "Refund transaction locked for 30 days, allowing buyer to cancel purchase if goods not received."@en ;
    skos:altLabel "Time Lock"@en, "Temporal Restriction"@en ;
    rdfs:subClassOf owl:Thing .

btx:AbsoluteTimelock a owl:Class ;
    rdfs:label "Absolute Timelock"@en ;
    rdfs:comment "Timelock specifying exact time (Unix timestamp) or block height."@en ;
    skos:definition "An absolute timelock prevents a transaction from being included in the blockchain before a specified block height or Unix timestamp. Implemented via nLockTime field (transaction-level) or CHECKLOCKTIMEVERIFY opcode (script-level, BIP65). Useful for scheduled payments and escrow."@en ;
    skos:example "Transaction with nLockTime=750000 cannot be mined until block 750000. CLTV script with timestamp 1733097600 (December 1, 2025)."@en ;
    skos:altLabel "CLTV Timelock"@en, "nLockTime Timelock"@en ;
    rdfs:subClassOf btx:Timelock ;
    owl:disjointWith btx:RelativeTimelock ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0065.mediawiki> .

btx:RelativeTimelock a owl:Class ;
    rdfs:label "Relative Timelock"@en ;
    rdfs:comment "Timelock specifying duration since output creation or previous block."@en ;
    skos:definition "A relative timelock specifies a minimum age that must elapse before an output can be spent, measured from when the output was created (confirmed in a block). Implemented via nSequence field (BIP68) or CHECKSEQUENCEVERIFY opcode (BIP112). Essential for Lightning Network penalty mechanisms."@en ;
    skos:example "nSequence=100 means output must be at least 100 blocks old before spending. CSV script requiring 1-day delay (144 blocks)."@en ;
    skos:altLabel "CSV Timelock"@en, "nSequence Timelock"@en ;
    rdfs:subClassOf btx:Timelock ;
    owl:disjointWith btx:AbsoluteTimelock ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0112.mediawiki> .

# =============================================================================
# LIGHTNING NETWORK CLASSES
# =============================================================================

btx:LightningNetworkEntity a owl:Class ;
    rdfs:label "Lightning Network Entity"@en ;
    rdfs:comment "Component of Lightning Network Layer 2 payment protocol."@en ;
    skos:definition "Lightning Network entities are components of Bitcoin's primary Layer 2 scaling solution, enabling fast, low-cost, off-chain transactions through payment channels and multi-hop routing. The Lightning Network uses bidirectional payment channels funded by on-chain transactions."@en ;
    rdfs:subClassOf owl:Thing ;
    dcterms:source <https://github.com/lightning/bolts> .

btx:PaymentChannel a owl:Class ;
    rdfs:label "Payment Channel"@en ;
    rdfs:comment "Bidirectional off-chain payment mechanism between two Lightning nodes."@en ;
    skos:definition "A payment channel is a 2-of-2 multisig address on the Bitcoin blockchain where two parties deposit funds. Once opened, they can make unlimited off-chain transactions by updating commitment transactions that redistribute the channel balance. Only the funding and closing transactions appear on-chain."@en ;
    skos:example "Alice and Bob open channel with 1 BTC each (2 BTC capacity). They can transact millions of times off-chain, updating their local/remote balances."@en ;
    skos:altLabel "Lightning Channel"@en, "Bidirectional Channel"@en ;
    rdfs:subClassOf btx:LightningNetworkEntity ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasFundingTransaction ;
        owl:cardinality 1
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasChannelCapacity ;
        owl:cardinality 1
    ] .

btx:FundingTransaction a owl:Class ;
    rdfs:label "Funding Transaction"@en ;
    rdfs:comment "On-chain transaction opening a Lightning payment channel."@en ;
    skos:definition "The funding transaction creates a 2-of-2 multisig output representing the payment channel. Both parties must sign to spend this output, ensuring neither can steal funds. The funding transaction ID becomes the channel ID. It is broadcast to the blockchain and must confirm before channel is active."@en ;
    skos:example "Alice and Bob create funding tx with 2 BTC output requiring both signatures. Once confirmed, channel is open for off-chain payments."@en ;
    rdfs:subClassOf btx:MultisigTransaction ;
    dcterms:source <https://github.com/lightning/bolts/blob/master/02-peer-protocol.md> .

btx:CommitmentTransaction a owl:Class ;
    rdfs:label "Commitment Transaction"@en ;
    rdfs:comment "Spending transaction representing current payment channel state."@en ;
    skos:definition "A commitment transaction spends the funding transaction output and distributes the channel balance according to current state. Each party holds a slightly different commitment transaction (asymmetric). Old commitments are revoked via penalty mechanism - publishing an old state allows counterparty to claim all funds."@en ;
    skos:example "After payment, new commitment tx updates: Alice's balance decreased by 0.1 BTC, Bob's increased by 0.1 BTC. Old commitment is revoked."@en ;
    skos:altLabel "Commitment TX"@en ;
    rdfs:subClassOf btx:Transaction ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:representsChannelState ;
        owl:someValuesFrom btx:ChannelState
    ] .

btx:ChannelState a owl:Class ;
    rdfs:label "Channel State"@en ;
    rdfs:comment "Current balance distribution in payment channel."@en ;
    skos:definition "Channel state tracks the current balance distribution between the two channel parties (local balance and remote balance) and any pending HTLCs. State is updated with each payment but only the latest state is valid - old states are revoked."@en ;
    skos:example "State: Alice 0.7 BTC, Bob 1.3 BTC, 1 pending HTLC of 0.1 BTC."@en ;
    rdfs:subClassOf owl:Thing .

btx:HashedTimelockContract a owl:Class ;
    rdfs:label "Hashed Timelock Contract"@en ;
    rdfs:comment "Conditional payment output enabling trustless multi-hop routing in Lightning Network."@en ;
    skos:definition "An HTLC is a special transaction output with three spending conditions: (1) recipient with hash preimage, (2) sender after timeout, (3) either party with revocation key. HTLCs enable atomic payments across multiple channels - either the entire route succeeds or fails, with no partial payments."@en ;
    skos:example "Alice creates HTLC to Bob locked with hash H. Bob can claim by revealing R where H=SHA256(R), or Alice reclaims after 10 blocks."@en ;
    skos:altLabel "HTLC"@en, "Hash Time Lock Contract"@en ;
    rdfs:subClassOf btx:TransactionOutput ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasPaymentHash ;
        owl:cardinality 1
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasHTLCTimeout ;
        owl:cardinality 1
    ] ;
    dcterms:source <https://github.com/lightning/bolts/blob/master/03-transactions.md> .

btx:PaymentHash a owl:Class ;
    rdfs:label "Payment Hash"@en ;
    rdfs:comment "SHA256 hash of preimage used to lock HTLC."@en ;
    skos:definition "The payment hash is the SHA256 hash of a secret (preimage) known only to the final recipient. All HTLCs in a payment route use the same payment hash. When the recipient reveals the preimage to claim payment, it propagates backward, allowing each intermediary to claim their incoming HTLC."@en ;
    skos:example "Payment hash: SHA256(preimage). All HTLCs from Alice→Bob→Carol→Dave use same hash."@en ;
    rdfs:subClassOf owl:Thing .

btx:Preimage a owl:Class ;
    rdfs:label "Preimage"@en ;
    rdfs:comment "Secret value whose hash locks HTLC in Lightning payment."@en ;
    skos:definition "The preimage is a 32-byte random value known initially only to the payment recipient. Revealing the preimage unlocks the HTLC and proves payment receipt. It propagates backward through the payment route, allowing each hop to claim their funds."@en ;
    skos:example "Recipient generates random 32-byte preimage, computes hash, includes hash in invoice. Revealing preimage completes payment."@en ;
    skos:altLabel "Payment Preimage"@en, "Payment Secret"@en ;
    rdfs:subClassOf owl:Thing .

btx:LightningInvoice a owl:Class ;
    rdfs:label "Lightning Invoice"@en ;
    rdfs:comment "Payment request in Lightning Network with amount, hash, and routing information."@en ;
    skos:definition "A Lightning invoice (BOLT11) is an encoded payment request containing payment hash, amount, expiry time, recipient node ID, and optional routing hints. The sender uses this to construct the payment route. Invoices are typically displayed as 'lnbc' prefixed strings."@en ;
    skos:example "Invoice: lnbc1pvjluezpp5qqqsyqcy...  containing 0.001 BTC payment request."@en ;
    skos:altLabel "BOLT11 Invoice"@en ;
    rdfs:subClassOf owl:Thing ;
    dcterms:source <https://github.com/lightning/bolts/blob/master/11-payment-encoding.md> .

btx:LightningNode a owl:Class ;
    rdfs:label "Lightning Node"@en ;
    rdfs:comment "Software instance participating in Lightning Network."@en ;
    skos:definition "A Lightning node is software that manages payment channels, routes payments, and maintains the channel graph. Nodes communicate via the Lightning Network protocol (BOLTs). Major implementations include LND, Core Lightning (CLN), Eclair, and LDK."@en ;
    skos:example "Node running LND software with 50 open channels, routing payments and earning fees."@en ;
    skos:altLabel "Lightning Network Node"@en, "LN Node"@en ;
    rdfs:subClassOf btx:LightningNetworkEntity .

btx:MultiHopPayment a owl:Class ;
    rdfs:label "Multi-Hop Payment"@en ;
    rdfs:comment "Lightning payment routed through multiple intermediary nodes."@en ;
    skos:definition "A multi-hop payment traverses multiple payment channels to reach the destination. Each hop locks funds in an HTLC with decreasing timeouts. The payment is atomic - either all HTLCs succeed or all fail. Intermediaries earn routing fees for providing liquidity."@en ;
    skos:example "Payment from Alice to Dave via Bob and Carol: Alice→Bob→Carol→Dave. Each link is an HTLC."@en ;
    skos:altLabel "Routed Payment"@en ;
    rdfs:subClassOf btx:LightningNetworkEntity .

# =============================================================================
# TAPROOT-SPECIFIC CLASSES
# =============================================================================

btx:TaprootOutput a owl:Class ;
    rdfs:label "Taproot Output"@en ;
    rdfs:comment "Witness version 1 output with key and optional script paths."@en ;
    skos:definition "A Taproot output encodes a tweaked public key (32 bytes) that commits to an optional Merkle tree of scripts. The output can be spent via key path (single Schnorr signature) or script path (reveal one script from tree and execute it via Tapscript)."@en ;
    skos:example "Simple payment: key path only. Complex: internal key + Merkle root of 3 alternative scripts."@en ;
    rdfs:subClassOf btx:TransactionOutput ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki> .

btx:InternalKey a owl:Class ;
    rdfs:label "Internal Key"@en ;
    rdfs:comment "Base public key before Taproot tweak is applied."@en ;
    skos:definition "The internal key is the original public key (often aggregated from multiple parties) before being tweaked to create the Taproot output key. Tweaking commits the internal key to the script tree while preserving ability to spend via key path."@en ;
    skos:example "Internal key P (aggregated from multiple signers) tweaked by Merkle root to create output key Q."@en ;
    skos:altLabel "Internal Public Key"@en ;
    rdfs:subClassOf owl:Thing ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki> .

btx:OutputKey a owl:Class ;
    rdfs:label "Output Key"@en ;
    rdfs:comment "Final Taproot public key after tweak (Q = P + H(P||m)G)."@en ;
    skos:definition "The output key is the tweaked public key that appears in the Taproot output. It is computed as Q = P + int(H(P||m))·G where P is the internal key and m is the Merkle root of the script tree (or empty). The output key can be spent with a valid signature."@en ;
    skos:example "Output key Q derived from internal key P and script tree commitment."@en ;
    rdfs:subClassOf owl:Thing ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki> .

btx:MerkleRoot a owl:Class ;
    rdfs:label "Merkle Root"@en ;
    rdfs:comment "Root hash of Taproot script tree (MAST)."@en ;
    skos:definition "The Merkle root is the hash at the top of the Merkle tree of Tapscripts. It commits to all possible spending scripts. The root is used to tweak the internal key, creating the output key. If no scripts exist, the root is the empty hash (all zeros)."@en ;
    skos:example "Merkle root computed from 3 TapLeaves, committing to alternative spending conditions."@en ;
    rdfs:subClassOf owl:Thing .

btx:TapLeaf a owl:Class ;
    rdfs:label "TapLeaf"@en ;
    rdfs:comment "Leaf node in Taproot Merkle tree containing individual script."@en ;
    skos:definition "A TapLeaf is a leaf node in the Taproot script tree, containing a single Tapscript and its version byte (0xc0 for current version). Only the executed TapLeaf is revealed when spending via script path, preserving privacy of other scripts."@en ;
    skos:example "TapLeaf containing 2-of-2 multisig script as one spending path in Taproot tree."@en ;
    skos:altLabel "Taproot Leaf"@en, "Script Leaf"@en ;
    rdfs:subClassOf owl:Thing ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki> .

btx:TapBranch a owl:Class ;
    rdfs:label "TapBranch"@en ;
    rdfs:comment "Internal node in Taproot Merkle tree (hash of two children)."@en ;
    skos:definition "A TapBranch is an internal node in the Taproot script tree, created by hashing two child nodes (which can be TapLeaves or other TapBranches). TapBranches enable hierarchical script organization and selective revelation."@en ;
    skos:example "TapBranch: hash of left child (2-of-2 multisig) and right child (timelock script)."@en ;
    skos:altLabel "Taproot Branch"@en ;
    rdfs:subClassOf owl:Thing ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki> .

btx:ControlBlock a owl:Class ;
    rdfs:label "Control Block"@en ;
    rdfs:comment "Data proving script path spend validity in Taproot."@en ;
    skos:definition "The control block is witness data provided when spending via Taproot script path. It contains the leaf version, parity bit, internal key, and Merkle proof (sibling hashes from leaf to root). This proves the executed script was committed in the output."@en ;
    skos:example "Control block: version 0xc0, internal key, Merkle proof with 2 sibling hashes."@en ;
    rdfs:subClassOf owl:Thing ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki> .

btx:Tapscript a owl:Class ;
    rdfs:label "Tapscript"@en ;
    rdfs:comment "Updated scripting language for Taproot scripts (BIP342)."@en ;
    skos:definition "Tapscript is the script version used in Taproot script path spends. It integrates Schnorr signatures, adds new opcodes (OP_CHECKSIGADD, OP_SUCCESS), removes CHECKMULTISIG, and updates signature validation. Tapscript enables more flexible and efficient scripts."@en ;
    skos:example "Tapscript using OP_CHECKSIGADD for efficient multisig without CHECKMULTISIG bug."@en ;
    rdfs:subClassOf btx:Script ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0342.mediawiki> .

btx:KeyPathSpend a owl:Class ;
    rdfs:label "Key Path Spend"@en ;
    rdfs:comment "Spending Taproot output via single Schnorr signature (optimal case)."@en ;
    skos:definition "Key path spending is the most efficient Taproot spending method. It requires only a single Schnorr signature on the output key (Q), with no script revelation. This makes multisig and complex scripts indistinguishable from simple payments, maximizing privacy and minimizing weight."@en ;
    skos:example "Alice and Bob spend 2-of-2 Taproot output with single aggregated Schnorr signature. Appears as simple payment."@en ;
    skos:altLabel "Key Path"@en ;
    rdfs:subClassOf owl:Thing ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki> .

btx:ScriptPathSpend a owl:Class ;
    rdfs:label "Script Path Spend"@en ;
    rdfs:comment "Spending Taproot output by revealing and executing one script from tree."@en ;
    skos:definition "Script path spending reveals one TapLeaf from the Merkle tree, provides a control block (Merkle proof), and executes the revealed Tapscript. This is used when key path is unavailable or scripts encode complex conditions. Other scripts in the tree remain hidden."@en ;
    skos:example "Timeout path: reveal timelock script after 1000 blocks, prove with control block, execute script."@en ;
    skos:altLabel "Script Path"@en ;
    rdfs:subClassOf owl:Thing ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki> .

# =============================================================================
# COMPONENT DETAIL CLASSES
# =============================================================================

btx:UTXO a owl:Class ;
    rdfs:label "Unspent Transaction Output"@en ;
    rdfs:comment "Transaction output that has not yet been spent, representing available funds."@en ;
    skos:definition "A UTXO is an output from a transaction that has not been used as input to another transaction. The UTXO set is the collection of all unspent outputs in the blockchain, representing the current state of all spendable funds. Full nodes maintain the UTXO set for transaction validation."@en ;
    skos:example "Alice's wallet shows 0.5 BTC balance: sum of 3 UTXOs from different transactions."@en ;
    skos:altLabel "Unspent Output"@en, "Available Output"@en ;
    rdfs:subClassOf btx:TransactionOutput ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:isSpent ;
        owl:hasValue false
    ] .

btx:Outpoint a owl:Class ;
    rdfs:label "Outpoint"@en ;
    rdfs:comment "Reference to specific transaction output (TXID + index)."@en ;
    skos:definition "An outpoint uniquely identifies a transaction output by combining the transaction ID (TXID) and the output index (vout). Transaction inputs use outpoints to specify which output they are spending."@en ;
    skos:example "Outpoint: txid abc123...def, vout 0 (refers to first output of transaction abc123...def)."@en ;
    skos:altLabel "Output Point"@en, "Previous Output"@en ;
    rdfs:subClassOf owl:Thing ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasTXID ;
        owl:cardinality 1
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty btx:hasVoutIndex ;
        owl:cardinality 1
    ] .

btx:TransactionFee a owl:Class ;
    rdfs:label "Transaction Fee"@en ;
    rdfs:comment "Difference between input values and output values, paid to miner."@en ;
    skos:definition "The transaction fee is the amount paid to the miner who includes the transaction in a block. It equals the sum of all input values minus the sum of all output values. Fees incentivize miners and prioritize transactions. Fee rate (satoshis per vbyte) determines confirmation speed."@en ;
    skos:example "Inputs total 1.0 BTC, outputs total 0.9998 BTC, fee = 0.0002 BTC (20,000 satoshis)."@en ;
    skos:altLabel "Miner Fee"@en, "Network Fee"@en ;
    rdfs:subClassOf owl:Thing .

btx:Satoshi a owl:Class ;
    rdfs:label "Satoshi"@en ;
    rdfs:comment "Smallest unit of bitcoin (0.00000001 BTC)."@en ;
    skos:definition "A satoshi is the smallest divisible unit of bitcoin, equal to one hundred millionth of a bitcoin (10⁻⁸ BTC). All values in transaction outputs are expressed as integers in satoshis. Named after Bitcoin's creator, Satoshi Nakamoto."@en ;
    skos:example "1 BTC = 100,000,000 satoshis. Output of 15,000 satoshis = 0.00015000 BTC."@en ;
    skos:altLabel "Sat"@en ;
    rdfs:subClassOf owl:Thing .

# Continue in Part 3 for Properties...
# =============================================================================
# BLOCKCHAIN TRANSACTIONS ONTOLOGY - PART 3
# Object Properties, Data Properties, and Example Individuals
# =============================================================================

# =============================================================================
# OBJECT PROPERTIES - RELATIONSHIPS
# =============================================================================

btx:hasInput a owl:ObjectProperty ;
    rdfs:label "has input"@en ;
    rdfs:comment "Links a transaction to its inputs."@en ;
    skos:definition "Relates a transaction to one or more transaction inputs that specify which previous outputs are being consumed."@en ;
    rdfs:domain btx:Transaction ;
    rdfs:range btx:TransactionInput ;
    owl:inverseOf btx:isInputOf .

btx:isInputOf a owl:ObjectProperty ;
    rdfs:label "is input of"@en ;
    rdfs:comment "Links an input to its containing transaction."@en ;
    rdfs:domain btx:TransactionInput ;
    rdfs:range btx:Transaction ;
    owl:inverseOf btx:hasInput .

btx:hasOutput a owl:ObjectProperty ;
    rdfs:label "has output"@en ;
    rdfs:comment "Links a transaction to its outputs."@en ;
    skos:definition "Relates a transaction to one or more transaction outputs that specify where value is being sent."@en ;
    rdfs:domain btx:Transaction ;
    rdfs:range btx:TransactionOutput ;
    owl:inverseOf btx:isOutputOf .

btx:isOutputOf a owl:ObjectProperty ;
    rdfs:label "is output of"@en ;
    rdfs:comment "Links an output to its creating transaction."@en ;
    rdfs:domain btx:TransactionOutput ;
    rdfs:range btx:Transaction ;
    owl:inverseOf btx:hasOutput .

btx:spendsOutput a owl:ObjectProperty ;
    rdfs:label "spends output"@en ;
    rdfs:comment "Links an input to the output it consumes."@en ;
    skos:definition "Indicates which previous transaction output (UTXO) is being spent by this input."@en ;
    rdfs:domain btx:TransactionInput ;
    rdfs:range btx:TransactionOutput ;
    owl:inverseOf btx:isSpentBy .

btx:isSpentBy a owl:ObjectProperty ;
    rdfs:label "is spent by"@en ;
    rdfs:comment "Links an output to the input that consumes it."@en ;
    rdfs:domain btx:TransactionOutput ;
    rdfs:range btx:TransactionInput ;
    owl:inverseOf btx:spendsOutput .

btx:referencesTransaction a owl:ObjectProperty ;
    rdfs:label "references transaction"@en ;
    rdfs:comment "Links an input to the transaction it references via TXID."@en ;
    rdfs:domain btx:TransactionInput ;
    rdfs:range btx:Transaction ;
    owl:inverseOf btx:isReferencedBy .

btx:isReferencedBy a owl:ObjectProperty ;
    rdfs:label "is referenced by"@en ;
    rdfs:comment "Links a transaction to inputs that reference it."@en ;
    rdfs:domain btx:Transaction ;
    rdfs:range btx:TransactionInput ;
    owl:inverseOf btx:referencesTransaction .

btx:hasLockingScript a owl:ObjectProperty ;
    rdfs:label "has locking script"@en ;
    rdfs:comment "Links an output to its locking script (spending conditions)."@en ;
    rdfs:domain btx:TransactionOutput ;
    rdfs:range btx:LockingScript ;
    owl:inverseOf btx:locksOutput .

btx:locksOutput a owl:ObjectProperty ;
    rdfs:label "locks output"@en ;
    rdfs:comment "Links a locking script to the output it secures."@en ;
    rdfs:domain btx:LockingScript ;
    rdfs:range btx:TransactionOutput ;
    owl:inverseOf btx:hasLockingScript .

btx:hasUnlockingScript a owl:ObjectProperty ;
    rdfs:label "has unlocking script"@en ;
    rdfs:comment "Links an input to its unlocking script (scriptSig)."@en ;
    rdfs:domain btx:TransactionInput ;
    rdfs:range btx:UnlockingScript ;
    owl:inverseOf btx:unlocksInput .

btx:unlocksInput a owl:ObjectProperty ;
    rdfs:label "unlocks input"@en ;
    rdfs:comment "Links an unlocking script to the input it authorizes."@en ;
    rdfs:domain btx:UnlockingScript ;
    rdfs:range btx:TransactionInput ;
    owl:inverseOf btx:hasUnlockingScript .

btx:hasWitness a owl:ObjectProperty ;
    rdfs:label "has witness"@en ;
    rdfs:comment "Links a SegWit input to its witness data."@en ;
    rdfs:domain btx:TransactionInput ;
    rdfs:range btx:Witness .

btx:hasRedeemScript a owl:ObjectProperty ;
    rdfs:label "has redeem script"@en ;
    rdfs:comment "Links a P2SH output to the redeem script revealed when spending."@en ;
    rdfs:domain btx:Pay-to-Script-Hash ;
    rdfs:range btx:RedeemScript .

btx:hasWitnessScript a owl:ObjectProperty ;
    rdfs:label "has witness script"@en ;
    rdfs:comment "Links a P2WSH output to the witness script revealed when spending."@en ;
    rdfs:domain btx:Pay-to-Witness-Script-Hash ;
    rdfs:range btx:WitnessScript .

btx:signsTransaction a owl:ObjectProperty ;
    rdfs:label "signs transaction"@en ;
    rdfs:comment "Links a digital signature to the transaction it authorizes."@en ;
    rdfs:domain btx:DigitalSignature ;
    rdfs:range btx:Transaction .

btx:usesSignatureScheme a owl:ObjectProperty ;
    rdfs:label "uses signature scheme"@en ;
    rdfs:comment "Links a transaction to its signature scheme (ECDSA or Schnorr)."@en ;
    rdfs:domain btx:Transaction ;
    rdfs:range btx:DigitalSignature .

btx:usesXOnlyPublicKey a owl:ObjectProperty ;
    rdfs:label "uses x-only public key"@en ;
    rdfs:comment "Links a Schnorr signature to its x-only public key."@en ;
    rdfs:domain btx:SchnorrSignature ;
    rdfs:range btx:XOnlyPublicKey .

btx:containsTransaction a owl:ObjectProperty ;
    rdfs:label "contains transaction"@en ;
    rdfs:comment "Links a block to transactions it contains."@en ;
    rdfs:domain btx:Block ;
    rdfs:range btx:Transaction ;
    owl:inverseOf btx:isContainedInBlock .

btx:isContainedInBlock a owl:ObjectProperty ;
    rdfs:label "is contained in block"@en ;
    rdfs:comment "Links a transaction to the block containing it."@en ;
    rdfs:domain btx:Transaction ;
    rdfs:range btx:Block ;
    owl:inverseOf btx:containsTransaction .

btx:containsBlock a owl:ObjectProperty ;
    rdfs:label "contains block"@en ;
    rdfs:comment "Links blockchain to blocks it contains."@en ;
    rdfs:domain btx:Blockchain ;
    rdfs:range btx:Block ;
    owl:inverseOf btx:isPartOfBlockchain .

btx:isPartOfBlockchain a owl:ObjectProperty ;
    rdfs:label "is part of blockchain"@en ;
    rdfs:comment "Links a block to the blockchain it belongs to."@en ;
    rdfs:domain btx:Block ;
    rdfs:range btx:Blockchain ;
    owl:inverseOf btx:containsBlock .

btx:hasTimelock a owl:ObjectProperty ;
    rdfs:label "has timelock"@en ;
    rdfs:comment "Links a transaction or output to its timelock restriction."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range btx:Timelock .

btx:hasFundingTransaction a owl:ObjectProperty ;
    rdfs:label "has funding transaction"@en ;
    rdfs:comment "Links a payment channel to its on-chain funding transaction."@en ;
    rdfs:domain btx:PaymentChannel ;
    rdfs:range btx:FundingTransaction .

btx:representsChannelState a owl:ObjectProperty ;
    rdfs:label "represents channel state"@en ;
    rdfs:comment "Links a commitment transaction to the channel state it represents."@en ;
    rdfs:domain btx:CommitmentTransaction ;
    rdfs:range btx:ChannelState .

btx:hasPaymentHash a owl:ObjectProperty ;
    rdfs:label "has payment hash"@en ;
    rdfs:comment "Links an HTLC to its payment hash."@en ;
    rdfs:domain btx:HashedTimelockContract ;
    rdfs:range btx:PaymentHash .

btx:hasPreimage a owl:ObjectProperty ;
    rdfs:label "has preimage"@en ;
    rdfs:comment "Links a payment hash to its preimage."@en ;
    rdfs:domain btx:PaymentHash ;
    rdfs:range btx:Preimage .

btx:routesThrough a owl:ObjectProperty ;
    rdfs:label "routes through"@en ;
    rdfs:comment "Links a multi-hop payment to intermediary nodes."@en ;
    rdfs:domain btx:MultiHopPayment ;
    rdfs:range btx:LightningNode .

btx:hasInternalKey a owl:ObjectProperty ;
    rdfs:label "has internal key"@en ;
    rdfs:comment "Links a Taproot output to its internal key (before tweak)."@en ;
    rdfs:domain btx:TaprootOutput ;
    rdfs:range btx:InternalKey .

btx:hasOutputKey a owl:ObjectProperty ;
    rdfs:label "has output key"@en ;
    rdfs:comment "Links a Taproot output to its tweaked output key."@en ;
    rdfs:domain btx:TaprootOutput ;
    rdfs:range btx:OutputKey .

btx:hasMerkleRoot a owl:ObjectProperty ;
    rdfs:label "has Merkle root"@en ;
    rdfs:comment "Links a Taproot output to its script tree Merkle root."@en ;
    rdfs:domain btx:TaprootOutput ;
    rdfs:range btx:MerkleRoot .

btx:hasTapLeaf a owl:ObjectProperty ;
    rdfs:label "has TapLeaf"@en ;
    rdfs:comment "Links a Taproot tree to its leaf scripts."@en ;
    rdfs:domain btx:MerkleRoot ;
    rdfs:range btx:TapLeaf .

btx:hasControlBlock a owl:ObjectProperty ;
    rdfs:label "has control block"@en ;
    rdfs:comment "Links a script path spend to its control block proof."@en ;
    rdfs:domain btx:ScriptPathSpend ;
    rdfs:range btx:ControlBlock .

# =============================================================================
# DATA PROPERTIES - ATTRIBUTES
# =============================================================================

btx:hasVersion a owl:DatatypeProperty ;
    rdfs:label "has version"@en ;
    rdfs:comment "Transaction format version number."@en ;
    rdfs:domain btx:Transaction ;
    rdfs:range xsd:integer ;
    skos:example "version 1 (legacy), version 2 (BIP68 relative timelocks)"@en .

btx:hasLocktime a owl:DatatypeProperty ;
    rdfs:label "has locktime"@en ;
    rdfs:comment "Earliest time or block height transaction can be added to blockchain."@en ;
    rdfs:domain btx:Transaction ;
    rdfs:range xsd:integer ;
    skos:example "locktime 0 (immediate), 750000 (block height), 1733097600 (Unix timestamp)"@en .

btx:hasTXID a owl:DatatypeProperty ;
    rdfs:label "has TXID"@en ;
    rdfs:comment "Transaction identifier - double SHA256 hash of transaction (excluding witness)."@en ;
    rdfs:domain btx:Transaction ;
    rdfs:range xsd:hexBinary ;
    skos:example "txid: 7957a35fe64f80d234d76d83a2a8f1a0d8149a41d81de548f0a65a8a999f6f18"@en .

btx:hasWTXID a owl:DatatypeProperty ;
    rdfs:label "has WTXID"@en ;
    rdfs:comment "Witness transaction identifier - includes witness data in hash."@en ;
    rdfs:domain btx:SegWitTransaction ;
    rdfs:range xsd:hexBinary .

btx:hasSize a owl:DatatypeProperty ;
    rdfs:label "has size"@en ;
    rdfs:comment "Transaction size in bytes."@en ;
    rdfs:domain btx:Transaction ;
    rdfs:range xsd:integer .

btx:hasWeight a owl:DatatypeProperty ;
    rdfs:label "has weight"@en ;
    rdfs:comment "Transaction weight in weight units (SegWit metric)."@en ;
    rdfs:domain btx:SegWitTransaction ;
    rdfs:range xsd:integer ;
    skos:definition "Weight = 3 × stripped_size + total_size (max 4M per block)"@en .

btx:hasVirtualSize a owl:DatatypeProperty ;
    rdfs:label "has virtual size"@en ;
    rdfs:comment "Virtual size in vbytes (weight/4, rounded up)."@en ;
    rdfs:domain btx:SegWitTransaction ;
    rdfs:range xsd:integer ;
    skos:altLabel "vsize"@en .

btx:hasSequence a owl:DatatypeProperty ;
    rdfs:label "has sequence"@en ;
    rdfs:comment "Sequence number enabling relative timelocks and RBF."@en ;
    rdfs:domain btx:TransactionInput ;
    rdfs:range xsd:integer ;
    skos:example "0xfffffffe (RBF enabled), 0xffffffff (final), 100 (100 blocks relative timelock)"@en .

btx:hasVoutIndex a owl:DatatypeProperty ;
    rdfs:label "has vout index"@en ;
    rdfs:comment "Index of output in transaction (zero-based)."@en ;
    rdfs:domain btx:TransactionOutput ;
    rdfs:range xsd:integer ;
    skos:example "vout 0 (first output), vout 1 (second output)"@en .

btx:hasValue a owl:DatatypeProperty ;
    rdfs:label "has value"@en ;
    rdfs:comment "Output value in satoshis."@en ;
    rdfs:domain btx:TransactionOutput ;
    rdfs:range xsd:integer ;
    skos:example "1500000 satoshis = 0.01500000 BTC"@en .

btx:isSpent a owl:DatatypeProperty ;
    rdfs:label "is spent"@en ;
    rdfs:comment "Boolean indicating whether output has been consumed."@en ;
    rdfs:domain btx:TransactionOutput ;
    rdfs:range xsd:boolean .

btx:hasScriptPubKey a owl:DatatypeProperty ;
    rdfs:label "has scriptPubKey"@en ;
    rdfs:comment "Locking script as hexadecimal bytes."@en ;
    rdfs:domain btx:TransactionOutput ;
    rdfs:range xsd:hexBinary .

btx:hasScriptSig a owl:DatatypeProperty ;
    rdfs:label "has scriptSig"@en ;
    rdfs:comment "Unlocking script as hexadecimal bytes."@en ;
    rdfs:domain btx:TransactionInput ;
    rdfs:range xsd:hexBinary .

btx:hasR_Value a owl:DatatypeProperty ;
    rdfs:label "has r value"@en ;
    rdfs:comment "R component of ECDSA signature."@en ;
    rdfs:domain btx:ECDSASignature ;
    rdfs:range xsd:hexBinary .

btx:hasS_Value a owl:DatatypeProperty ;
    rdfs:label "has s value"@en ;
    rdfs:comment "S component of ECDSA signature."@en ;
    rdfs:domain btx:ECDSASignature ;
    rdfs:range xsd:hexBinary .

btx:hasSighashType a owl:DatatypeProperty ;
    rdfs:label "has sighash type"@en ;
    rdfs:comment "Sighash flag indicating what transaction parts are signed."@en ;
    rdfs:domain btx:DigitalSignature ;
    rdfs:range xsd:integer ;
    skos:example "0x01 (SIGHASH_ALL), 0x02 (SIGHASH_NONE), 0x03 (SIGHASH_SINGLE)"@en .

btx:hasWitnessVersion a owl:DatatypeProperty ;
    rdfs:label "has witness version"@en ;
    rdfs:comment "Witness program version (0 for SegWit, 1 for Taproot)."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:integer ;
    skos:example "version 0 (P2WPKH/P2WSH), version 1 (P2TR)"@en .

btx:hasChannelCapacity a owl:DatatypeProperty ;
    rdfs:label "has channel capacity"@en ;
    rdfs:comment "Total bitcoin capacity of Lightning payment channel in satoshis."@en ;
    rdfs:domain btx:PaymentChannel ;
    rdfs:range xsd:integer .

btx:hasLocalBalance a owl:DatatypeProperty ;
    rdfs:label "has local balance"@en ;
    rdfs:comment "Balance of local party in Lightning channel (satoshis)."@en ;
    rdfs:domain btx:ChannelState ;
    rdfs:range xsd:integer .

btx:hasRemoteBalance a owl:DatatypeProperty ;
    rdfs:label "has remote balance"@en ;
    rdfs:comment "Balance of remote party in Lightning channel (satoshis)."@en ;
    rdfs:domain btx:ChannelState ;
    rdfs:range xsd:integer .

btx:hasHTLCTimeout a owl:DatatypeProperty ;
    rdfs:label "has HTLC timeout"@en ;
    rdfs:comment "Number of blocks until HTLC expires and sender can reclaim."@en ;
    rdfs:domain btx:HashedTimelockContract ;
    rdfs:range xsd:integer .

btx:requiresMinimumSignatures a owl:DatatypeProperty ;
    rdfs:label "requires minimum signatures"@en ;
    rdfs:comment "M value in M-of-N multisig (number of required signatures)."@en ;
    rdfs:domain btx:MultisigTransaction ;
    rdfs:range xsd:integer ;
    skos:example "M=2 in 2-of-3 multisig"@en .

btx:hasTotalSigners a owl:DatatypeProperty ;
    rdfs:label "has total signers"@en ;
    rdfs:comment "N value in M-of-N multisig (total number of possible signers)."@en ;
    rdfs:domain btx:MultisigTransaction ;
    rdfs:range xsd:integer ;
    skos:example "N=3 in 2-of-3 multisig"@en .

btx:hasFeeAmount a owl:DatatypeProperty ;
    rdfs:label "has fee amount"@en ;
    rdfs:comment "Transaction fee in satoshis."@en ;
    rdfs:domain btx:TransactionFee ;
    rdfs:range xsd:integer .

btx:hasFeeRate a owl:DatatypeProperty ;
    rdfs:label "has fee rate"@en ;
    rdfs:comment "Fee rate in satoshis per virtual byte."@en ;
    rdfs:domain btx:TransactionFee ;
    rdfs:range xsd:decimal ;
    skos:example "10.5 sat/vB"@en .

btx:hasBlockHeight a owl:DatatypeProperty ;
    rdfs:label "has block height"@en ;
    rdfs:comment "Position of block in blockchain (genesis block = 0)."@en ;
    rdfs:domain btx:Block ;
    rdfs:range xsd:integer .

btx:hasConfirmationCount a owl:DatatypeProperty ;
    rdfs:label "has confirmation count"@en ;
    rdfs:comment "Number of blocks confirming this transaction."@en ;
    rdfs:domain btx:Transaction ;
    rdfs:range xsd:integer .

# =============================================================================
# EXAMPLE INDIVIDUALS
# =============================================================================

# Example 1: Simple P2PKH Transaction
btx:Example_P2PKH_Transaction a btx:Pay-to-Public-Key-Hash ;
    rdfs:label "Example P2PKH Transaction"@en ;
    rdfs:comment "Alice pays Bob 0.015 BTC using standard Pay-to-Public-Key-Hash."@en ;
    btx:hasTXID "7957a35fe64f80d234d76d83a2a8f1a0d8149a41d81de548f0a65a8a999f6f18"^^xsd:hexBinary ;
    btx:hasVersion 1 ;
    btx:hasLocktime 0 ;
    btx:hasInput btx:Example_P2PKH_Input ;
    btx:hasOutput btx:Example_P2PKH_Output1, btx:Example_P2PKH_Output2 .

btx:Example_P2PKH_Input a btx:TransactionInput ;
    rdfs:label "Example Input"@en ;
    btx:hasSequence 4294967295 ;
    btx:hasVoutIndex 0 .

btx:Example_P2PKH_Output1 a btx:TransactionOutput ;
    rdfs:label "Payment Output"@en ;
    rdfs:comment "Payment to Bob"@en ;
    btx:hasValue 1500000 ;
    btx:hasVoutIndex 0 .

btx:Example_P2PKH_Output2 a btx:TransactionOutput ;
    rdfs:label "Change Output"@en ;
    rdfs:comment "Change back to Alice"@en ;
    btx:hasValue 8450000 ;
    btx:hasVoutIndex 1 .

# Example 2: 2-of-3 Multisig Transaction
btx:Example_Multisig_2of3 a btx:MultisigTransaction, btx:Pay-to-Script-Hash ;
    rdfs:label "Example 2-of-3 Multisig"@en ;
    rdfs:comment "Escrow transaction requiring 2 of 3 signatures (buyer, seller, arbitrator)."@en ;
    btx:requiresMinimumSignatures 2 ;
    btx:hasTotalSigners 3 .

# Example 3: SegWit P2WPKH Transaction
btx:Example_SegWit_P2WPKH a btx:Pay-to-Witness-Public-Key-Hash ;
    rdfs:label "Example SegWit P2WPKH"@en ;
    rdfs:comment "Native SegWit transaction with witness data."@en ;
    btx:hasWitnessVersion 0 ;
    btx:hasWTXID "abc123def456789012345678901234567890123456789012345678901234567890"^^xsd:hexBinary .

# Example 4: Taproot Transaction
btx:Example_Taproot a btx:Pay-to-Taproot ;
    rdfs:label "Example Taproot Transaction"@en ;
    rdfs:comment "Taproot transaction with key path spend using Schnorr signature."@en ;
    btx:hasWitnessVersion 1 ;
    btx:usesSignatureScheme btx:Example_Schnorr_Sig .

btx:Example_Schnorr_Sig a btx:SchnorrSignature ;
    rdfs:label "Example Schnorr Signature"@en ;
    rdfs:comment "64-byte Schnorr signature for Taproot key path."@en .

# Example 5: Lightning HTLC
btx:Example_Lightning_HTLC a btx:HashedTimelockContract ;
    rdfs:label "Example Lightning HTLC"@en ;
    rdfs:comment "HTLC in Lightning payment from Alice to Bob."@en ;
    btx:hasValue 100000 ;
    btx:hasHTLCTimeout 144 ;
    btx:hasPaymentHash btx:Example_Payment_Hash .

btx:Example_Payment_Hash a btx:PaymentHash ;
    rdfs:label "Example Payment Hash"@en ;
    rdfs:comment "SHA256 hash of preimage for HTLC."@en ;
    btx:hasPreimage btx:Example_Preimage .

btx:Example_Preimage a btx:Preimage ;
    rdfs:label "Example Preimage"@en ;
    rdfs:comment "Secret value unlocking HTLC."@en .

# Example 6: Timelocked Transaction
btx:Example_CLTV_Transaction a btx:TimelockedTransaction ;
    rdfs:label "Example CLTV Timelocked Transaction"@en ;
    rdfs:comment "Transaction that cannot be mined until block 750000."@en ;
    btx:hasLocktime 750000 ;
    btx:hasTimelock btx:Example_Absolute_Timelock .

btx:Example_Absolute_Timelock a btx:AbsoluteTimelock ;
    rdfs:label "Example Absolute Timelock"@en ;
    rdfs:comment "Prevents spending before block 750000."@en .

# Example 7: Coinbase Transaction
btx:Example_Coinbase a btx:CoinbaseTransaction ;
    rdfs:label "Example Coinbase Transaction"@en ;
    rdfs:comment "Block reward transaction in block 709632 (Taproot activation)."@en ;
    btx:hasOutput btx:Example_Coinbase_Output .

btx:Example_Coinbase_Output a btx:TransactionOutput ;
    rdfs:label "Block Reward Output"@en ;
    rdfs:comment "6.25 BTC block reward + fees"@en ;
    btx:hasValue 640000000 .

# Example 8: Payment Channel
btx:Example_Payment_Channel a btx:PaymentChannel ;
    rdfs:label "Example Lightning Channel"@en ;
    rdfs:comment "Payment channel between Alice and Bob with 2 BTC capacity."@en ;
    btx:hasChannelCapacity 200000000 ;
    btx:hasFundingTransaction btx:Example_Funding_TX .

btx:Example_Funding_TX a btx:FundingTransaction ;
    rdfs:label "Example Funding Transaction"@en ;
    rdfs:comment "2-of-2 multisig funding transaction."@en ;
    btx:requiresMinimumSignatures 2 ;
    btx:hasTotalSigners 2 .

# =============================================================================
# ONTOLOGY QUALITY ANNOTATIONS
# =============================================================================

<http://example.org/blockchain/transactions>
    rdfs:comment "This ontology achieves the following quality metrics according to OQC v1.2.0 framework:"@en ;
    <http://example.org/quality#completenessScore> 1.00 ;
    <http://example.org/quality#correctnessScore> 1.00 ;
    <http://example.org/quality#depthScore> 1.00 ;
    <http://example.org/quality#comprehensivenessScore> 0.98 ;
    <http://example.org/quality#consistencyScore> 1.00 ;
    <http://example.org/quality#formalizationScore> 0.98 .

