      {
        "@language": "en",
        "@value": "has s value"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#hexBinary"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Transaction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Data structure encoding the transfer of value between participants in a blockchain system."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b2"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b3"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b4"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b5"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "http://example.org/blockchain/transactions#Block"
      },
      {
        "@id": "http://example.org/blockchain/transactions#Blockchain"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "TX"
      },
      {
        "@language": "en",
        "@value": "Blockchain Transaction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A transaction is the fundamental unit of value transfer in blockchain systems, consisting of inputs that consume previous outputs and new outputs that can be consumed by future transactions. Transactions are validated, propagated across the peer-to-peer network, and permanently recorded in blocks."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Alice sends 0.5 BTC to Bob using transaction txid abc123...def, which consumes Alice's previous output and creates a new output controlled by Bob's public key hash."
      }
    ]
  },
  {
