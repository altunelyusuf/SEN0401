      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#SighashType",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Flag indicating which parts of transaction are signed."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Sighash Type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Sighash types control what portions of a transaction are committed to by a signature. Common types: SIGHASH_ALL (signs all inputs and outputs), SIGHASH_NONE (signs all inputs only), SIGHASH_SINGLE (signs all inputs and corresponding output), SIGHASH_ANYONECANPAY (modifier, signs only one input)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "SIGHASH_ALL (0x01): most common, signature commits to entire transaction."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasS_Value",
    "@type": [
