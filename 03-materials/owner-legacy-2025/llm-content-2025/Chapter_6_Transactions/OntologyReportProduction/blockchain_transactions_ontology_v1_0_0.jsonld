  {
    "@id": "http://example.org/blockchain/transactions#OutputKey",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Final Taproot public key after tweak (Q = P + H(P||m)G)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Output Key"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The output key is the tweaked public key that appears in the Taproot output. It is computed as Q = P + int(H(P||m))·G where P is the internal key and m is the Merkle root of the script tree (or empty). The output key can be spent with a valid signature."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Output key Q derived from internal key P and script tree commitment."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#CoinbaseTransaction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoinbook/bitcoinbook"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Special first transaction in each block that creates new bitcoins and collects fees."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Coinbase Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#Transaction"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b26"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Generation Transaction"
      },
      {
        "@language": "en",
        "@value": "Coinbase TX"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The coinbase transaction is the first transaction in every block, created by the miner. It has no inputs (creates new bitcoins from nothing) and outputs containing the block reward plus all transaction fees from the block. The input's scriptSig can contain arbitrary data (historically used for extra nonce and miner identification)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Block 709632 coinbase: 6.25 BTC block reward + 0.15 BTC fees = 6.40 BTC total to miner."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b26",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#cardinality": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#hasInput"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Example_Payment_Hash",
    "@type": [
      "http://example.org/blockchain/transactions#PaymentHash"
    ],
