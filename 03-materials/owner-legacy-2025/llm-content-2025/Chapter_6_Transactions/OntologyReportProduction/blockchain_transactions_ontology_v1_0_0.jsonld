      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#SchnorrSignature"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "uses x-only public key"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://example.org/blockchain/transactions#XOnlyPublicKey"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasFundingTransaction",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a payment channel to its on-chain funding transaction."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#PaymentChannel"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has funding transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://example.org/blockchain/transactions#FundingTransaction"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#XOnlyPublicKey",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0340.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "32-byte public key containing only x-coordinate (y-coordinate inferred)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "X-Only Public Key"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Taproot uses x-only public keys which store only the x-coordinate of the elliptic curve point (32 bytes instead of 33). The y-coordinate is inferred by always choosing the even y value. This saves 1 byte per key and simplifies some cryptographic operations."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "X-only key: 32-byte value representing public key point with implicit even y-coordinate."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#ChannelState",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Current balance distribution in payment channel."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Channel State"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Channel state tracks the current balance distribution between the two channel parties (local balance and remote balance) and any pending HTLCs. State is updated with each payment but only the latest state is valid - old states are revoked."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "State: Alice 0.7 BTC, Bob 1.3 BTC, 1 pending HTLC of 0.1 BTC."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#DigitalSignature",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Cryptographic proof demonstrating authorization to spend a transaction output."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Digital Signature"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b11"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Signature"
      },
      {
        "@language": "en",
        "@value": "Cryptographic Signature"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A digital signature is created using a private key and proves that the owner of the corresponding public key has authorized a transaction. Bitcoin supports both ECDSA (Elliptic Curve Digital Signature Algorithm) and Schnorr signature schemes. The signature commits to the transaction data being signed and the SIGHASH type."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "ECDSA signature with r=3045022100884d142d86... and s=02204b9f039ff08df09... signing transaction inputs with SIGHASH_ALL."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b11",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#signsTransaction"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "http://example.org/blockchain/transactions#Transaction"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasControlBlock",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a script path spend to its control block proof."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#ScriptPathSpend"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has control block"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://example.org/blockchain/transactions#ControlBlock"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#SchnorrSignature",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0340.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Schnorr signature scheme introduced in Taproot (BIP340, activated November 2021)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Schnorr Signature"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#DigitalSignature"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b30"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "http://example.org/blockchain/transactions#ECDSASignature"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "BIP340 Signature"
      },
      {
        "@language": "en",
        "@value": "Schnorr Sig"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Schnorr signatures are an alternative signature scheme using the same secp256k1 curve. They are 64 bytes (smaller than ECDSA), support linear aggregation enabling efficient multisig, allow batch verification, and have provable security. Schnorr is used exclusively in Taproot (witness version 1)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Schnorr signature: 64-byte signature for key path Taproot spend, enabling multiple parties to appear as single signer."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b30",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#usesXOnlyPublicKey"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "http://example.org/blockchain/transactions#XOnlyPublicKey"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Pay-to-Public-Key",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Early transaction type paying directly to a full public key (now rare)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Pay-to-Public-Key Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#LegacyTransaction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "P2PK"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "P2PK was used in early Bitcoin versions where the locking script contained the full public key rather than its hash. It is now rarely used due to larger size and reduced privacy compared to P2PKH."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Output scriptPubKey: <publicKey> OP_CHECKSIG. Coinbase transactions in early blocks used P2PK."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Example_P2PKH_Output2",
    "@type": [
      "http://example.org/blockchain/transactions#TransactionOutput"
    ],
    "http://example.org/blockchain/transactions#hasValue": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 8450000
      }
    ],
    "http://example.org/blockchain/transactions#hasVoutIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Change back to Alice"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Change Output"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasChannelCapacity",
