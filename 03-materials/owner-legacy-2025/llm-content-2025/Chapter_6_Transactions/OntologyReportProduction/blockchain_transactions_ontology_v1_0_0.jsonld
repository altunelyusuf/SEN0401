      {
        "@language": "en",
        "@value": "contains transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://example.org/blockchain/transactions#Transaction"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "http://example.org/blockchain/transactions#isContainedInBlock"
      }
    ]
  }
