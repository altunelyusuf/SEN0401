  {
    "@id": "http://example.org/blockchain/transactions#TimelockedTransaction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Transaction with temporal spending restrictions based on time or block height."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Timelocked Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#Transaction"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b25"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Time-Locked Transaction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A timelocked transaction cannot be added to the blockchain before a specified time or block height (absolute timelock) or until a specified duration has elapsed since output creation (relative timelock). Timelocks enable payment channels, refund mechanisms, and scheduled payments."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Refund transaction with nLockTime set to 30 days in future, ensuring funds return to sender if recipient doesn't claim."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b25",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#hasTimelock"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "http://example.org/blockchain/transactions#Timelock"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#LegacyTransaction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Pre-SegWit transaction format with signatures in scriptSig field."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Legacy Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#StandardTransaction"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "http://example.org/blockchain/transactions#SegWitTransaction"
      },
      {
        "@id": "http://example.org/blockchain/transactions#TaprootTransaction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Pre-SegWit Transaction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Legacy transactions use the original Bitcoin transaction format where unlocking scripts (containing signatures) are part of the transaction input structure in the scriptSig field. These transactions predate Segregated Witness and do not separate witness data."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Transaction with P2PKH output spending where signature is placed in scriptSig of the spending input."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#AggregatedSignature",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Multiple signatures combined into single signature via Schnorr aggregation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Aggregated Signature"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#SchnorrSignature"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "MuSig Signature"
      },
      {
        "@language": "en",
        "@value": "Threshold Signature"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Schnorr signatures support linear aggregation where multiple signatures can be combined into a single signature that validates the combined statement. This makes multisig transactions indistinguishable from single-sig, improving privacy and reducing transaction size."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "2-of-2 MuSig: two parties create single 64-byte signature that looks identical to single-party signature."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasSize",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Transaction size in bytes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has size"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Example_Schnorr_Sig",
