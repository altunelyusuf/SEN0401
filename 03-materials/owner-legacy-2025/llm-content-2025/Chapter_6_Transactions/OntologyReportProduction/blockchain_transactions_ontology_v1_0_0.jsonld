  {
    "@id": "http://example.org/blockchain/transactions#ScriptPathSpend",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Spending Taproot output by revealing and executing one script from tree."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Script Path Spend"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Script Path"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Script path spending reveals one TapLeaf from the Merkle tree, provides a control block (Merkle proof), and executes the revealed Tapscript. This is used when key path is unavailable or scripts encode complex conditions. Other scripts in the tree remain hidden."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Timeout path: reveal timelock script after 1000 blocks, prove with control block, execute script."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasInput",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a transaction to its inputs."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has input"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://example.org/blockchain/transactions#TransactionInput"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "http://example.org/blockchain/transactions#isInputOf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates a transaction to one or more transaction inputs that specify which previous outputs are being consumed."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Example_SegWit_P2WPKH",
    "@type": [
      "http://example.org/blockchain/transactions#Pay-to-Witness-Public-Key-Hash"
    ],
