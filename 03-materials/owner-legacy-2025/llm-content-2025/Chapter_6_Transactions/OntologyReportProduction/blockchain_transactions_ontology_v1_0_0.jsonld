        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "2-of-2 multisig funding transaction."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Example Funding Transaction"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#requiresMinimumSignatures",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "M value in M-of-N multisig (number of required signatures)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#MultisigTransaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "requires minimum signatures"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "M=2 in 2-of-3 multisig"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#MerkleRoot",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Root hash of Taproot script tree (MAST)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Merkle Root"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The Merkle root is the hash at the top of the Merkle tree of Tapscripts. It commits to all possible spending scripts. The root is used to tweak the internal key, creating the output key. If no scripts exist, the root is the empty hash (all zeros)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Merkle root computed from 3 TapLeaves, committing to alternative spending conditions."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Example_CLTV_Transaction",
    "@type": [
      "http://example.org/blockchain/transactions#TimelockedTransaction"
    ],
    "http://example.org/blockchain/transactions#hasLocktime": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 750000
      }
    ],
    "http://example.org/blockchain/transactions#hasTimelock": [
      {
        "@id": "http://example.org/blockchain/transactions#Example_Absolute_Timelock"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Transaction that cannot be mined until block 750000."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Example CLTV Timelocked Transaction"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Block",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Container of validated transactions with header containing proof-of-work and linkage to previous block."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Block"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b12"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "http://example.org/blockchain/transactions#Blockchain"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Blockchain Block"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A block is the fundamental structure in a blockchain, containing a block header (with timestamp, nonce, difficulty target, Merkle root, and previous block hash) and a list of valid transactions. Blocks are chained together via cryptographic hashes, forming an immutable distributed ledger."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Block 709632 containing 2,812 transactions, including the Taproot activation signaling."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b12",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
