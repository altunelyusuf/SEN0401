      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#SegWitTransaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has WTXID"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#hexBinary"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Example_Multisig_2of3",
    "@type": [
      "http://example.org/blockchain/transactions#MultisigTransaction",
      "http://example.org/blockchain/transactions#Pay-to-Script-Hash"
    ],
    "http://example.org/blockchain/transactions#hasTotalSigners": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 3
      }
    ],
    "http://example.org/blockchain/transactions#requiresMinimumSignatures": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Escrow transaction requiring 2 of 3 signatures (buyer, seller, arbitrator)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Example 2-of-3 Multisig"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#ECDSASignature",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Elliptic Curve Digital Signature Algorithm signature used in Bitcoin."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "ECDSA Signature"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#DigitalSignature"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b27"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b28"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b29"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "http://example.org/blockchain/transactions#SchnorrSignature"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "ECDSA Sig"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "ECDSA is the digital signature scheme Bitcoin used exclusively until Taproot. It uses the secp256k1 elliptic curve and produces signatures with two components (r, s). Each signature is 71-72 bytes in DER encoding. ECDSA signatures commit to transaction data and SIGHASH type."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "ECDSA signature: r=3045022100884d..., s=02204b9f..., signing with SIGHASH_ALL (0x01)."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b27",
    "@type": [
