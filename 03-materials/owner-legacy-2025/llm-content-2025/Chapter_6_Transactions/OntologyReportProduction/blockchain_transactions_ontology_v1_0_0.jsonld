      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b37"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b38"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Output Point"
      },
      {
        "@language": "en",
        "@value": "Previous Output"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An outpoint uniquely identifies a transaction output by combining the transaction ID (TXID) and the output index (vout). Transaction inputs use outpoints to specify which output they are spending."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Outpoint: txid abc123...def, vout 0 (refers to first output of transaction abc123...def)."
      }
    ]
  },
  {
