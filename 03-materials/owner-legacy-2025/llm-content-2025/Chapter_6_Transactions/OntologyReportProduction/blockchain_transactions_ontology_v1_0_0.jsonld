  {
    "@id": "http://example.org/blockchain/transactions#KeyPathSpend",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Spending Taproot output via single Schnorr signature (optimal case)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Key Path Spend"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Key Path"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Key path spending is the most efficient Taproot spending method. It requires only a single Schnorr signature on the output key (Q), with no script revelation. This makes multisig and complex scripts indistinguishable from simple payments, maximizing privacy and minimizing weight."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Alice and Bob spend 2-of-2 Taproot output with single aggregated Schnorr signature. Appears as simple payment."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasRemoteBalance",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Balance of remote party in Lightning channel (satoshis)."
      }
    ],
