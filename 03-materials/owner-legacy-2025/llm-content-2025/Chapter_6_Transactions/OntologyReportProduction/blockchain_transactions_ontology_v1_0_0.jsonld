  {
    "@id": "http://example.org/blockchain/transactions#P2WSH_Script",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0141.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Native SegWit complex script pattern."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "P2WSH Locking Script"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#LockingScript"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The P2WSH script pattern: OP_0 <32-byte-script-hash>. Witness must contain witness script (SHA256 hashing to specified value) plus data satisfying it."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasPaymentHash",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links an HTLC to its payment hash."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#HashedTimelockContract"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has payment hash"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://example.org/blockchain/transactions#PaymentHash"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#MultisigScript",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Script requiring M-of-N signatures."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Multisignature Script"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#LockingScript"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Multisig script pattern: M <PubKey1> <PubKey2> ... <PubKeyN> N CHECKMULTISIG. Requires M valid signatures from the N possible public keys. Note CHECKMULTISIG bug requires extra 0 value at start of unlocking script."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "2 <PubKey1> <PubKey2> <PubKey3> 3 CHECKMULTISIG for 2-of-3 multisig."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#StandardTransaction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Commonly used transaction type following standard patterns recognized by Bitcoin nodes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Standard Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#Transaction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A standard transaction is one that follows well-known output patterns (P2PKH, P2SH, P2WPKH, P2WSH, P2TR) and is relayed by default node policies. Standard transactions have predictable validation costs and are commonly accepted for mining."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Timelock",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Temporal restriction preventing transaction or output spending before specified time/height."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Timelock"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Time Lock"
      },
      {
        "@language": "en",
        "@value": "Temporal Restriction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A timelock is a mechanism that restricts when a transaction can be added to the blockchain or when an output can be spent. Timelocks can be absolute (specific time/block height) or relative (duration since output creation). They enable payment channels, escrow, scheduled payments, and refund mechanisms."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Refund transaction locked for 30 days, allowing buyer to cancel purchase if goods not received."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#TransactionInput",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reference to a previous transaction output that is being spent, along with proof of authorization to spend it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Transaction Input"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b6"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b7"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b8"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "http://example.org/blockchain/transactions#TransactionOutput"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "TxIn"
      },
      {
        "@language": "en",
        "@value": "Input"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A transaction input specifies a previous unspent transaction output (UTXO) to be consumed and provides an unlocking script (scriptSig or witness) that satisfies the spending conditions of that output. Each input identifies the previous transaction by TXID and output index (vout)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Input referencing txid xyz789...abc at index 0 with scriptSig containing signature and public key that unlock a P2PKH output."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b6",
