      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Blockchain",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Distributed ledger consisting of cryptographically-linked blocks forming an immutable transaction history."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Blockchain"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b13"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Distributed Ledger"
      },
      {
        "@language": "en",
        "@value": "Public Ledger"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The blockchain is a globally replicated, append-only data structure where each block references the previous block via cryptographic hash, creating an immutable chain. It serves as Bitcoin's public ledger, recording all valid transactions in chronological order with proof-of-work consensus ensuring integrity."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Bitcoin blockchain containing over 800,000 blocks as of 2025, storing complete transaction history since genesis block (2009)."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b13",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#minCardinality": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#containsBlock"
      }
    ]
  },
