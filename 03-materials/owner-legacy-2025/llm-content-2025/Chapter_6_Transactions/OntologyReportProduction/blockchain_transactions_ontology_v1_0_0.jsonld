        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "0.98"
      }
    ],
    "http://example.org/quality#consistencyScore": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "1.00"
      }
    ],
    "http://example.org/quality#correctnessScore": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "1.00"
      }
    ],
    "http://example.org/quality#depthScore": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "1.00"
      }
    ],
    "http://example.org/quality#formalizationScore": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "0.98"
      }
    ],
    "http://purl.org/dc/terms/abstract": [
      {
        "@language": "en",
        "@value": "This ontology formalizes the domain of blockchain transactions with emphasis on Bitcoin and Lightning Network protocols. It provides a comprehensive taxonomy of transaction types, script constructions, signature schemes, and payment channel mechanisms. The ontology is grounded in authoritative sources including Bitcoin Improvement Proposals (BIPs) and technical specifications, ensuring accuracy and currency through 2025."
      }
    ],
    "http://purl.org/dc/terms/contributor": [
      {
        "@language": "en",
        "@value": "Istanbul Kültür University - Computer Engineering Department"
      }
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2025-12-12"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@language": "en",
        "@value": "Dr. Yusuf Altunel"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Comprehensive formal ontology for blockchain transaction concepts covering Bitcoin and related protocols. This ontology provides systematic knowledge representation of transaction structures, scripting mechanisms, cryptographic signatures, time-locking capabilities, and Layer 2 payment protocols including the Lightning Network.\n    \n    The ontology encompasses:\n    - Core transaction concepts from Bitcoin's inception through 2025\n    - Transaction types: Legacy (P2PKH, P2SH), SegWit (P2WPKH, P2WSH), Taproot (P2TR)\n    - Advanced scripting: multisignature, timelocks, conditional execution\n    - Digital signatures: ECDSA and Schnorr signature schemes\n    - Segregated Witness architecture (BIP141-144, 2017)\n    - Taproot upgrade with MAST and key aggregation (BIP340-342, 2021)\n    - Lightning Network payment channels and HTLCs (2018+)\n    - Transaction validation, propagation, and blockchain integration\n    \n    Designed for educational use in SEN0401: Special Topics in Software Engineering (Blockchain) at Istanbul Kültür University, enabling interactive exploration and discovery of blockchain transaction concepts within a Zero-Time learning environment."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "http://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2025-12-12"
      }
    ],
    "http://purl.org/dc/terms/rights": [
      {
        "@language": "en",
        "@value": "Copyright © 2025 Istanbul Kültür University. Licensed under Creative Commons Attribution 4.0 International (CC BY 4.0)."
      }
    ],
