      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#containsTransaction"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#LightningNetworkEntity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/lightning/bolts"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Component of Lightning Network Layer 2 payment protocol."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Lightning Network Entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Lightning Network entities are components of Bitcoin's primary Layer 2 scaling solution, enabling fast, low-cost, off-chain transactions through payment channels and multi-hop routing. The Lightning Network uses bidirectional payment channels funded by on-chain transactions."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasBlockHeight",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Position of block in blockchain (genesis block = 0)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#Block"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has block height"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Witness",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0141.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Segregated signature and script data in SegWit transactions."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Witness"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Witness Data"
      },
      {
        "@language": "en",
        "@value": "Witness Field"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The witness is a data structure introduced in SegWit containing the unlocking information (signatures, public keys, scripts) for transaction inputs. It is segregated from the main transaction structure, enabling transaction malleability fix and weight-based block capacity. Each input has its own witness."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "P2WPKH witness: [<signature>, <publicKey>]. P2WSH witness: [<signatures>, <witness-script>]."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasConfirmationCount",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
