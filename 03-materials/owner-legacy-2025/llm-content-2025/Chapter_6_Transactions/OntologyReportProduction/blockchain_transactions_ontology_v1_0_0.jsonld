      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://example.org/blockchain/transactions#TransactionOutput"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "http://example.org/blockchain/transactions#isOutputOf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates a transaction to one or more transaction outputs that specify where value is being sent."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasOutputKey",
