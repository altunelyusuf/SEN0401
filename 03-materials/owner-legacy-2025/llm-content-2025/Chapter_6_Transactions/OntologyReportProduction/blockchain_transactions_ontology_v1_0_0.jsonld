        "@id": "http://example.org/blockchain/transactions#hasWitness"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "http://example.org/blockchain/transactions#Witness"
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b17",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#cardinality": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#hasWTXID"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#FundingTransaction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/lightning/bolts/blob/master/02-peer-protocol.md"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "On-chain transaction opening a Lightning payment channel."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Funding Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#MultisigTransaction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The funding transaction creates a 2-of-2 multisig output representing the payment channel. Both parties must sign to spend this output, ensuring neither can steal funds. The funding transaction ID becomes the channel ID. It is broadcast to the blockchain and must confirm before channel is active."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Alice and Bob create funding tx with 2 BTC output requiring both signatures. Once confirmed, channel is open for off-chain payments."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Example_Payment_Channel",
    "@type": [
      "http://example.org/blockchain/transactions#PaymentChannel"
    ],
    "http://example.org/blockchain/transactions#hasChannelCapacity": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 200000000
      }
    ],
    "http://example.org/blockchain/transactions#hasFundingTransaction": [
      {
        "@id": "http://example.org/blockchain/transactions#Example_Funding_TX"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Payment channel between Alice and Bob with 2 BTC capacity."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Example Lightning Channel"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasLockingScript",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links an output to its locking script (spending conditions)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#TransactionOutput"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has locking script"
      }
