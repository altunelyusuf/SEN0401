      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasVoutIndex",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Index of output in transaction (zero-based)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#TransactionOutput"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
