        "@value": "Example SegWit P2WPKH"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#PaymentChannel",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Bidirectional off-chain payment mechanism between two Lightning nodes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Payment Channel"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#LightningNetworkEntity"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b31"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b32"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Lightning Channel"
      },
      {
        "@language": "en",
        "@value": "Bidirectional Channel"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A payment channel is a 2-of-2 multisig address on the Bitcoin blockchain where two parties deposit funds. Once opened, they can make unlimited off-chain transactions by updating commitment transactions that redistribute the channel balance. Only the funding and closing transactions appear on-chain."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Alice and Bob open channel with 1 BTC each (2 BTC capacity). They can transact millions of times off-chain, updating their local/remote balances."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b31",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#cardinality": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
