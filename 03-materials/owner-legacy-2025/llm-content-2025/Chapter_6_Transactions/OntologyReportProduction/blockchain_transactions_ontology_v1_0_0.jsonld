    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b35",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#cardinality": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#hasHTLCTimeout"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasWitnessScript",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a P2WSH output to the witness script revealed when spending."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#Pay-to-Witness-Script-Hash"
      }
    ],
