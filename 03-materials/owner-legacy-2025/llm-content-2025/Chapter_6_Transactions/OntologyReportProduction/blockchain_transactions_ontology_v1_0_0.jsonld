        "@value": "has remote balance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#TaprootTransaction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Transaction using Schnorr signatures, key aggregation, and MAST (BIP341, activated November 2021)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Taproot Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#StandardTransaction"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b21"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b22"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "http://example.org/blockchain/transactions#LegacyTransaction"
      },
      {
        "@id": "http://example.org/blockchain/transactions#SegWitTransaction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Taproot TX"
      },
      {
        "@language": "en",
        "@value": "P2TR Transaction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Taproot transactions use witness version 1 with 32-byte output, enabling two spending paths: key path (single Schnorr signature, most efficient) and script path (reveal one script from Merkle tree). Taproot improves privacy by making all outputs look identical and improves efficiency through Schnorr signatures and key aggregation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "P2TR output: OP_1 <32-byte-taproot-output>. Can be spent via key path signature or by revealing script + Merkle proof. Address: bc1p..."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b21",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#hasValue": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#hasWitnessVersion"
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b22",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#usesSignatureScheme"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "http://example.org/blockchain/transactions#SchnorrSignature"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#CommitmentTransaction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Spending transaction representing current payment channel state."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Commitment Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#Transaction"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b33"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Commitment TX"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A commitment transaction spends the funding transaction output and distributes the channel balance according to current state. Each party holds a slightly different commitment transaction (asymmetric). Old commitments are revoked via penalty mechanism - publishing an old state allows counterparty to claim all funds."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "After payment, new commitment tx updates: Alice's balance decreased by 0.1 BTC, Bob's increased by 0.1 BTC. Old commitment is revoked."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b33",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#representsChannelState"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "http://example.org/blockchain/transactions#ChannelState"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#LightningNode",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Software instance participating in Lightning Network."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Lightning Node"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#LightningNetworkEntity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Lightning Network Node"
      },
      {
        "@language": "en",
        "@value": "LN Node"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A Lightning node is software that manages payment channels, routes payments, and maintains the channel graph. Nodes communicate via the Lightning Network protocol (BOLTs). Major implementations include LND, Core Lightning (CLN), Eclair, and LDK."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Node running LND software with 50 open channels, routing payments and earning fees."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasOutput",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
