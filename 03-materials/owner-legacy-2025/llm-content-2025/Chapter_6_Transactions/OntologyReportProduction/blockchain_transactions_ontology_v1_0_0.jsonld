      {
        "@language": "en",
        "@value": "locktime 0 (immediate), 750000 (block height), 1733097600 (Unix timestamp)"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#ControlBlock",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Data proving script path spend validity in Taproot."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Control Block"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The control block is witness data provided when spending via Taproot script path. It contains the leaf version, parity bit, internal key, and Merkle proof (sibling hashes from leaf to root). This proves the executed script was committed in the output."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Control block: version 0xc0, internal key, Merkle proof with 2 sibling hashes."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Example_Preimage",
    "@type": [
      "http://example.org/blockchain/transactions#Preimage"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Secret value unlocking HTLC."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Example Preimage"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#TapLeaf",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Leaf node in Taproot Merkle tree containing individual script."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "TapLeaf"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Taproot Leaf"
      },
      {
        "@language": "en",
        "@value": "Script Leaf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A TapLeaf is a leaf node in the Taproot script tree, containing a single Tapscript and its version byte (0xc0 for current version). Only the executed TapLeaf is revealed when spending via script path, preserving privacy of other scripts."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "TapLeaf containing 2-of-2 multisig script as one spending path in Taproot tree."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#unlocksInput",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links an unlocking script to the input it authorizes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#UnlockingScript"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "unlocks input"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://example.org/blockchain/transactions#TransactionInput"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "http://example.org/blockchain/transactions#hasUnlockingScript"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#PaymentHash",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "SHA256 hash of preimage used to lock HTLC."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Payment Hash"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The payment hash is the SHA256 hash of a secret (preimage) known only to the final recipient. All HTLCs in a payment route use the same payment hash. When the recipient reveals the preimage to claim payment, it propagates backward, allowing each intermediary to claim their incoming HTLC."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Payment hash: SHA256(preimage). All HTLCs from Alice→Bob→Carol→Dave use same hash."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasHTLCTimeout",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Number of blocks until HTLC expires and sender can reclaim."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#HashedTimelockContract"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has HTLC timeout"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#TaprootOutput",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Witness version 1 output with key and optional script paths."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Taproot Output"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#TransactionOutput"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A Taproot output encodes a tweaked public key (32 bytes) that commits to an optional Merkle tree of scripts. The output can be spent via key path (single Schnorr signature) or script path (reveal one script from tree and execute it via Tapscript)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Simple payment: key path only. Complex: internal key + Merkle root of 3 alternative scripts."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasFeeRate",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Fee rate in satoshis per virtual byte."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#TransactionFee"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has fee rate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "10.5 sat/vB"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#usesSignatureScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a transaction to its signature scheme (ECDSA or Schnorr)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "uses signature scheme"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://example.org/blockchain/transactions#DigitalSignature"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Tapscript",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0342.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Updated scripting language for Taproot scripts (BIP342)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Tapscript"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#Script"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Tapscript is the script version used in Taproot script path spends. It integrates Schnorr signatures, adds new opcodes (OP_CHECKSIGADD, OP_SUCCESS), removes CHECKMULTISIG, and updates signature validation. Tapscript enables more flexible and efficient scripts."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Tapscript using OP_CHECKSIGADD for efficient multisig without CHECKMULTISIG bug."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://example.org/quality#completenessScore": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "1.00"
      }
    ],
