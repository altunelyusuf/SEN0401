  {
    "@id": "http://example.org/blockchain/transactions#Pay-to-Taproot",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Taproot output with optional script tree, spendable via key path or script path."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Pay-to-Taproot Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#TaprootTransaction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "P2TR"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "P2TR outputs encode a tweaked public key that commits to an optional Merkle tree of scripts. Key path spending requires a single Schnorr signature on the output key (appears as simple payment). Script path spending reveals one script from the tree and executes it via Tapscript."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Simple payment: P2TR with key path only (no scripts). Complex: P2TR with MAST containing multiple spending conditions."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#UTXO",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Transaction output that has not yet been spent, representing available funds."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Unspent Transaction Output"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#TransactionOutput"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b36"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Unspent Output"
      },
      {
        "@language": "en",
        "@value": "Available Output"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A UTXO is an output from a transaction that has not been used as input to another transaction. The UTXO set is the collection of all unspent outputs in the blockchain, representing the current state of all spendable funds. Full nodes maintain the UTXO set for transaction validation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Alice's wallet shows 0.5 BTC balance: sum of 3 UTXOs from different transactions."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b36",
