  {
    "@id": "http://example.org/blockchain/transactions#RelativeTimelock",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0112.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Timelock specifying duration since output creation or previous block."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Relative Timelock"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#Timelock"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "http://example.org/blockchain/transactions#AbsoluteTimelock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "CSV Timelock"
      },
      {
        "@language": "en",
        "@value": "nSequence Timelock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A relative timelock specifies a minimum age that must elapse before an output can be spent, measured from when the output was created (confirmed in a block). Implemented via nSequence field (BIP68) or CHECKSEQUENCEVERIFY opcode (BIP112). Essential for Lightning Network penalty mechanisms."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "nSequence=100 means output must be at least 100 blocks old before spending. CSV script requiring 1-day delay (144 blocks)."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasSequence",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Sequence number enabling relative timelocks and RBF."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#TransactionInput"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has sequence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "0xfffffffe (RBF enabled), 0xffffffff (final), 100 (100 blocks relative timelock)"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#routesThrough",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
