  {
    "@id": "http://example.org/blockchain/transactions#P2SH-wrapped-SegWit",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "SegWit transaction embedded in P2SH for backward compatibility with older wallets."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "P2SH-wrapped SegWit Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#SegWitTransaction"
      },
      {
        "@id": "http://example.org/blockchain/transactions#Pay-to-Script-Hash"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Nested SegWit"
      },
      {
        "@language": "en",
        "@value": "P2SH-P2WPKH"
      },
      {
        "@language": "en",
        "@value": "P2SH-P2WSH"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "SegWit-in-P2SH wraps a native SegWit script (P2WPKH or P2WSH) inside a P2SH output, enabling older wallets to send to SegWit addresses without upgrade. The redeem script is the SegWit script, and witness data is still used for spending."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "P2SH-P2WPKH: redeem script is OP_0 <20-byte-pubkey-hash>. P2SH address starts with '3'."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#representsChannelState",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
