      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#HTLCScript",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/lightning/bolts"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Script combining hash lock and timelock for conditional payments."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Hashed Timelock Contract Script"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#LockingScript"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "HTLC Script"
      },
      {
        "@language": "en",
        "@value": "Hash Time Lock Contract Script"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "HTLC script enables conditional payments where recipient must reveal preimage of hash before timeout, or sender can reclaim after timeout. Critical for Lightning Network payment routing. Includes three spending paths: recipient with preimage, sender after timeout, either party with revocation key."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "IF <recipientPubkey> CHECKSIG ELSE <timeout> CHECKLOCKTIMEVERIFY DROP <senderPubkey> CHECKSIG ENDIF"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#P2PKH_Script",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Standard Pay-to-Public-Key-Hash script pattern."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "P2PKH Locking Script"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#LockingScript"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The P2PKH script pattern: OP_DUP OP_HASH160 <pubKeyHash> OP_EQUALVERIFY OP_CHECKSIG. Requires signature and public key; verifies public key hashes to specified value and signature is valid."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#InternalKey",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Base public key before Taproot tweak is applied."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Internal Key"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Internal Public Key"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The internal key is the original public key (often aggregated from multiple parties) before being tweaked to create the Taproot output key. Tweaking commits the internal key to the script tree while preserving ability to spend via key path."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Internal key P (aggregated from multiple signers) tweaked by Merkle root to create output key Q."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#RedeemScript",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0016.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Script whose hash is committed in P2SH, revealed when spending."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Redeem Script"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#Script"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A redeem script is the actual script whose hash appears in a P2SH output. It is not revealed at output creation (only its hash), but must be provided when spending the output. The provided redeem script must hash to the value in the P2SH output, and its execution must succeed."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "2-of-3 multisig redeem script: 2 <PubKey1> <PubKey2> <PubKey3> 3 CHECKMULTISIG"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Pay-to-Witness-Public-Key-Hash",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0141.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Native SegWit transaction type for single-signature payments with 20-byte witness program."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Pay-to-Witness-Public-Key-Hash Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#SegWitTransaction"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b18"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "P2WPKH"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "P2WPKH is the SegWit equivalent of P2PKH. The locking script consists of witness version 0 (OP_0) followed by a 20-byte public key hash. The unlocking data (signature and public key) is provided in the witness field rather than scriptSig, making the transaction smaller and fixing malleability."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "scriptPubKey: OP_0 <20-byte-pubkey-hash>. Witness: <signature> <pubkey>. Address format: bc1q..."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b18",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#hasValue": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 0
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#hasWitnessVersion"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#MultiHopPayment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Lightning payment routed through multiple intermediary nodes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Multi-Hop Payment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#LightningNetworkEntity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Routed Payment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A multi-hop payment traverses multiple payment channels to reach the destination. Each hop locks funds in an HTLC with decreasing timeouts. The payment is atomic - either all HTLCs succeed or all fail. Intermediaries earn routing fees for providing liquidity."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Payment from Alice to Dave via Bob and Carol: Alice→Bob→Carol→Dave. Each link is an HTLC."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#HashedTimelockContract",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/lightning/bolts/blob/master/03-transactions.md"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Conditional payment output enabling trustless multi-hop routing in Lightning Network."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Hashed Timelock Contract"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#TransactionOutput"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b34"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b35"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "HTLC"
      },
      {
        "@language": "en",
        "@value": "Hash Time Lock Contract"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An HTLC is a special transaction output with three spending conditions: (1) recipient with hash preimage, (2) sender after timeout, (3) either party with revocation key. HTLCs enable atomic payments across multiple channels - either the entire route succeeds or fails, with no partial payments."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Alice creates HTLC to Bob locked with hash H. Bob can claim by revealing R where H=SHA256(R), or Alice reclaims after 10 blocks."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b34",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
