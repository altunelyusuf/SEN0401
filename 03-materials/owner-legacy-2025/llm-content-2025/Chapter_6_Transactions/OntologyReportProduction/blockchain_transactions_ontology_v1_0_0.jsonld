        "@value": "Example Absolute Timelock"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#P2WPKH_Script",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0141.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Native SegWit single-signature script pattern."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "P2WPKH Locking Script"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#LockingScript"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The P2WPKH script pattern: OP_0 <20-byte-pubkey-hash>. Witness must contain signature and public key that hashes to specified value."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#TapBranch",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Internal node in Taproot Merkle tree (hash of two children)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "TapBranch"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Taproot Branch"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A TapBranch is an internal node in the Taproot script tree, created by hashing two child nodes (which can be TapLeaves or other TapBranches). TapBranches enable hierarchical script organization and selective revelation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "TapBranch: hash of left child (2-of-2 multisig) and right child (timelock script)."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Example_Coinbase",
    "@type": [
      "http://example.org/blockchain/transactions#CoinbaseTransaction"
    ],
