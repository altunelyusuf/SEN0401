      {
        "@language": "en",
        "@value": "txid: 7957a35fe64f80d234d76d83a2a8f1a0d8149a41d81de548f0a65a8a999f6f18"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#P2TR_Script",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0341.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Taproot script pattern with key and script paths."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "P2TR Locking Script"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#LockingScript"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The P2TR script pattern: OP_1 <32-byte-taproot-output>. Can be spent via key path (Schnorr signature on output key) or script path (reveal script from Merkle tree)."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Pay-to-Witness-Script-Hash",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0141.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Native SegWit transaction type for complex scripts with 32-byte witness program."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Pay-to-Witness-Script-Hash Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#SegWitTransaction"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b19"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b20"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "P2WSH"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "P2WSH is the SegWit equivalent of P2SH. The locking script consists of witness version 0 (OP_0) followed by a 32-byte script hash (SHA256). The witness must provide the witness script and data satisfying it. This enables complex scripts with SegWit benefits."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "scriptPubKey: OP_0 <32-byte-script-hash>. Witness: <witness-stack-items> <witness-script>. Used for multisig, timelocks, complex conditions."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b19",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#hasValue": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 0
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#hasWitnessVersion"
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b20",
