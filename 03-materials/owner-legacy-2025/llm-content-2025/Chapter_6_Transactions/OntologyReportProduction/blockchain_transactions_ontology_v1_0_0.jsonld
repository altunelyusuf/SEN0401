  {
    "@id": "http://example.org/blockchain/transactions#Satoshi",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Smallest unit of bitcoin (0.00000001 BTC)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Satoshi"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Sat"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A satoshi is the smallest divisible unit of bitcoin, equal to one hundred millionth of a bitcoin (10⁻⁸ BTC). All values in transaction outputs are expressed as integers in satoshis. Named after Bitcoin's creator, Satoshi Nakamoto."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "1 BTC = 100,000,000 satoshis. Output of 15,000 satoshis = 0.00015000 BTC."
      }
    ]
  },
  {
