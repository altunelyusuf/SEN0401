      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#SegWitTransaction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0141.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Transaction format separating signature data into witness field (BIP141, activated August 2017)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Segregated Witness Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#StandardTransaction"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b16"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b17"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "http://example.org/blockchain/transactions#LegacyTransaction"
      },
      {
        "@id": "http://example.org/blockchain/transactions#TaprootTransaction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "SegWit Transaction"
      },
      {
        "@language": "en",
        "@value": "SegWit TX"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Segregated Witness (SegWit) transactions separate the witness data (signatures and scripts) from the transaction structure, placing it in a new witness field. This fixes transaction malleability, enables larger effective blocks through weight-based accounting, and improves signature validation efficiency. SegWit transactions use witness version 0."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "P2WPKH transaction where signature and public key are in witness field, not scriptSig. TXID computed without witness data, while WTXID includes it."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b16",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
