  {
    "@id": "http://example.org/blockchain/transactions#WitnessScript",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0141.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Script whose hash is committed in P2WSH, revealed in witness data when spending."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Witness Script"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#Script"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Witness Program Script"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A witness script is the SegWit equivalent of a redeem script, used with P2WSH outputs. The script's SHA256 hash is committed in the output, and the full script is provided in the witness data when spending. This enables complex scripts with SegWit's benefits."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "P2WSH multisig witness script provided in witness along with signatures."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#P2SH_Script",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0016.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Pay-to-Script-Hash script pattern."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "P2SH Locking Script"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#LockingScript"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The P2SH script pattern: HASH160 <scriptHash> EQUAL. The spending input must provide a redeem script that hashes to the specified value, plus data satisfying that redeem script."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#UnlockingScript",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Script providing data to satisfy a locking script's spending conditions."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Unlocking Script"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#Script"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "scriptSig"
      },
      {
        "@language": "en",
        "@value": "Signature Script"
      },
      {
        "@language": "en",
        "@value": "Input Script"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An unlocking script (scriptSig or witness data) provides the inputs needed to satisfy a locking script. For legacy transactions, this is the scriptSig field. For SegWit, the unlocking data is in the witness field. The unlocking script typically contains signatures and public keys."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "P2PKH unlocking script: <signature> <publicKey>"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasR_Value",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "R component of ECDSA signature."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#ECDSASignature"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has r value"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#hexBinary"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#hasUnlockingScript",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links an input to its unlocking script (scriptSig)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#TransactionInput"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has unlocking script"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://example.org/blockchain/transactions#UnlockingScript"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "http://example.org/blockchain/transactions#unlocksInput"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Outpoint",
