      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "http://example.org/blockchain/transactions#WitnessScript"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#isReferencedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a transaction to inputs that reference it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://example.org/blockchain/transactions#Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "is referenced by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://example.org/blockchain/transactions#TransactionInput"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "http://example.org/blockchain/transactions#referencesTransaction"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#LightningInvoice",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/lightning/bolts/blob/master/11-payment-encoding.md"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Payment request in Lightning Network with amount, hash, and routing information."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Lightning Invoice"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "BOLT11 Invoice"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A Lightning invoice (BOLT11) is an encoded payment request containing payment hash, amount, expiry time, recipient node ID, and optional routing hints. The sender uses this to construct the payment route. Invoices are typically displayed as 'lnbc' prefixed strings."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Invoice: lnbc1pvjluezpp5qqqsyqcy...  containing 0.001 BTC payment request."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#AbsoluteTimelock",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0065.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Timelock specifying exact time (Unix timestamp) or block height."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Absolute Timelock"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#Timelock"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "http://example.org/blockchain/transactions#RelativeTimelock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "CLTV Timelock"
      },
      {
        "@language": "en",
        "@value": "nLockTime Timelock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An absolute timelock prevents a transaction from being included in the blockchain before a specified block height or Unix timestamp. Implemented via nLockTime field (transaction-level) or CHECKLOCKTIMEVERIFY opcode (script-level, BIP65). Useful for scheduled payments and escrow."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Transaction with nLockTime=750000 cannot be mined until block 750000. CLTV script with timestamp 1733097600 (December 1, 2025)."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#TransactionFee",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Difference between input values and output values, paid to miner."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Transaction Fee"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Miner Fee"
      },
      {
        "@language": "en",
        "@value": "Network Fee"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The transaction fee is the amount paid to the miner who includes the transaction in a block. It equals the sum of all input values minus the sum of all output values. Fees incentivize miners and prioritize transactions. Fee rate (satoshis per vbyte) determines confirmation speed."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Inputs total 1.0 BTC, outputs total 0.9998 BTC, fee = 0.0002 BTC (20,000 satoshis)."
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Example_Funding_TX",
    "@type": [
      "http://example.org/blockchain/transactions#FundingTransaction"
    ],
    "http://example.org/blockchain/transactions#hasTotalSigners": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "http://example.org/blockchain/transactions#requiresMinimumSignatures": [
