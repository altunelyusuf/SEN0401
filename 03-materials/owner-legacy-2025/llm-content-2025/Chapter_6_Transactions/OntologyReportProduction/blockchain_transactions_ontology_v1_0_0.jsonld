      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Script",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Stack-based program that defines or satisfies spending conditions for transaction outputs."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Script"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Bitcoin Script"
      },
      {
        "@language": "en",
        "@value": "Script Program"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Bitcoin Script is a Forth-like, stack-based, non-Turing-complete programming language used to specify and verify spending conditions. Scripts are executed by validating nodes to determine transaction validity. They support various operations including cryptographic functions, conditional logic, and arithmetic."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "P2PKH locking script: OP_DUP OP_HASH160 <pubKeyHash> OP_EQUALVERIFY OP_CHECKSIG"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#Pay-to-Script-Hash",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/bitcoin/bips/blob/master/bip-0016.mediawiki"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Transaction paying to a hash of a script (redeem script), enabling complex spending conditions."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Pay-to-Script-Hash Transaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://example.org/blockchain/transactions#LegacyTransaction"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b15"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "P2SH"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "P2SH (BIP16) allows the sender to pay to a hash of an arbitrary script (the redeem script), rather than encoding the full script in the locking script. The spender must provide the redeem script matching the hash along with data satisfying its conditions. This shifts complexity and transaction fees from sender to recipient."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Multisig 2-of-3: locking script contains HASH160 <scriptHash> EQUAL. Spending requires signatures and the actual multisig redeem script."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b15",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#hasRedeemScript"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "http://example.org/blockchain/transactions#RedeemScript"
      }
    ]
  },
  {
    "@id": "http://example.org/blockchain/transactions#TransactionOutput",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Indivisible chunk of bitcoin currency with specified value and spending conditions."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Transaction Output"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b9"
      },
      {
        "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b10"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "TxOut"
      },
      {
        "@language": "en",
        "@value": "Output"
      },
      {
        "@language": "en",
        "@value": "TXO"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A transaction output (TXO) specifies an amount of cryptocurrency (in satoshis) and the conditions under which it can be spent, encoded as a locking script (scriptPubKey). Unspent outputs (UTXOs) form the fundamental state of the blockchain, representing all available funds."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Output of 0.01500000 BTC with P2PKH locking script OP_DUP OP_HASH160 ab68025513c3dbd2f7b92a94e0581f5d50f654e7 OP_EQUALVERIFY OP_CHECKSIG."
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b9",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#cardinality": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#hasValue"
      }
    ]
  },
  {
    "@id": "_:nd09b3c79bb7045469f4b26f1ec4eeb56b10",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#cardinality": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "http://example.org/blockchain/transactions#hasLockingScript"
      }
    ]
  },
