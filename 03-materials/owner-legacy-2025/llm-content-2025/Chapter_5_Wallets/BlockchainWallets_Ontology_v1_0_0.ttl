#=============================================================================
# BLOCKCHAIN WALLETS DOMAIN ONTOLOGY
# Version: 1.0.0
# Date: 2025-12-04
# Author: Istanbul Kültür University - SEN0401 Blockchain Course
# Compliance: Enhanced_Unified_Meta-Ontology_v1.0.1, OQC Quality Control ≥98%
# Purpose: Zero-Time Interactive Educational HTML Generation
#=============================================================================
# This ontology provides comprehensive coverage of cryptocurrency wallet
# technology, including HD wallets, key management, BIP standards, security
# mechanisms, and modern innovations (MPC, smart contract wallets, social
# recovery, account abstraction).
#=============================================================================

@prefix : <http://ikcu.edu.tr/ontology/blockchain/wallets#> .
@prefix bw: <http://ikcu.edu.tr/ontology/blockchain/wallets#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix bip: <http://ikcu.edu.tr/ontology/blockchain/bip#> .
@prefix crypto: <http://ikcu.edu.tr/ontology/blockchain/crypto#> .
@prefix zt: <http://ikcu.edu.tr/ontology/zerotime#> .

#=============================================================================
# ONTOLOGY METADATA
#=============================================================================

<http://ikcu.edu.tr/ontology/blockchain/wallets> rdf:type owl:Ontology ;
    dc:title "Blockchain Wallets Domain Ontology"@en ;
    dc:title "Blok Zinciri Cüzdanları Alan Ontolojisi"@tr ;
    dc:description """Comprehensive domain ontology for blockchain cryptocurrency wallets 
        covering wallet types, key management schemes, HD derivation (BIP-32/39/44/49/84/86), 
        security mechanisms, and modern innovations including MPC wallets, smart contract 
        wallets, social recovery, and ERC-4337 account abstraction. Designed for Zero-Time
        educational content generation in SEN0401: Special Topics in Software Engineering 
        (Blockchain) course."""@en ;
    dc:creator "Prof. Dr. Yusuf Uzun"^^xsd:string ;
    dc:creator "Istanbul Kültür University - Computer Engineering Department"^^xsd:string ;
    dcterms:created "2025-12-04"^^xsd:date ;
    dcterms:modified "2025-12-04"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://ikcu.edu.tr/ontology/blockchain/wallets/v1.0.0> ;
    dcterms:source <https://github.com/bitcoinbook/bitcoinbook> ;
    dcterms:references "Antonopoulos, A. M. (2017). Mastering Bitcoin, Chapter 5: Wallets"@en ;
    rdfs:comment """This ontology serves as Layer 1 (Semantic Layer) in the Zero-Time 
        Double-Layer Architecture, enabling automatic generation of interactive educational 
        HTML pages through AI4SE transcompilation."""@en ;
    skos:note "Quality Target: ≥98% OQC compliance across all dimensions"@en ;
    :hasQualityScore "98"^^xsd:decimal ;
    :conformsToMetaOntology <http://example.org/ontology-engineering/v1.0.1> .

#=============================================================================
# ZERO-TIME EDUCATIONAL VOCABULARY (Custom Annotations)
#=============================================================================

zt:educationalLevel rdf:type owl:AnnotationProperty ;
    rdfs:label "educational level"@en ;
    rdfs:comment "Indicates the difficulty/prerequisite level for learning this concept"@en .

zt:Beginner rdf:type owl:NamedIndividual ;
    rdfs:label "Beginner Level"@en .

zt:Intermediate rdf:type owl:NamedIndividual ;
    rdfs:label "Intermediate Level"@en .

zt:Advanced rdf:type owl:NamedIndividual ;
    rdfs:label "Advanced Level"@en .

zt:prerequisiteConcept rdf:type owl:AnnotationProperty ;
    rdfs:label "prerequisite concept"@en ;
    rdfs:comment "Concepts that should be understood before this one"@en .

zt:hasVisualization rdf:type owl:AnnotationProperty ;
    rdfs:label "has visualization"@en ;
    rdfs:comment "Hints for diagram/visualization generation"@en .

zt:interactiveExercise rdf:type owl:AnnotationProperty ;
    rdfs:label "interactive exercise"@en ;
    rdfs:comment "Identifier for associated interactive exercise"@en .

zt:learningObjective rdf:type owl:AnnotationProperty ;
    rdfs:label "learning objective"@en ;
    rdfs:comment "Bloom's taxonomy aligned learning objective"@en .

zt:estimatedLearningTime rdf:type owl:AnnotationProperty ;
    rdfs:label "estimated learning time"@en ;
    rdfs:comment "Expected time in minutes to learn this concept"@en .

#=============================================================================
# PART 1: ROOT CLASSES AND WALLET TYPE TAXONOMY
#=============================================================================

#-----------------------------------------------------------------------------
# Abstract Root Class: Wallet
#-----------------------------------------------------------------------------

:Wallet rdf:type owl:Class ;
    rdfs:label "Wallet"@en ;
    rdfs:label "Cüzdan"@tr ;
    skos:definition """A software application or hardware device that serves as the primary 
        user interface to a blockchain, managing cryptographic keys and addresses, tracking 
        balances, and creating/signing transactions. Despite the name, wallets do not 
        contain coins - they contain keys that control coins recorded on the blockchain."""@en ;
    skos:altLabel "Cryptocurrency Wallet"@en ;
    skos:altLabel "Bitcoin Wallet"@en ;
    skos:altLabel "Kripto Para Cüzdanı"@tr ;
    skos:scopeNote """From a programmer's perspective, 'wallet' refers to the data structure 
        used to store and manage a user's cryptographic keys, typically implemented as 
        structured files or databases."""@en ;
    skos:example "Bitcoin Core, Electrum, Ledger Nano X, MetaMask, Trust Wallet"@en ;
    skos:historyNote "The concept evolved from simple key storage to sophisticated key management systems"@en ;
    dcterms:source "Antonopoulos (2017), Mastering Bitcoin, Chapter 5"@en ;
    zt:educationalLevel zt:Beginner ;
    zt:learningObjective "Students will understand that wallets contain keys, not coins"@en ;
    zt:hasVisualization "wallet-keychain-metaphor" ;
    zt:estimatedLearningTime "15"^^xsd:integer .

#-----------------------------------------------------------------------------
# Primary Classification: By Key Generation Method
#-----------------------------------------------------------------------------

:NondeterministicWallet rdf:type owl:Class ;
    rdfs:subClassOf :Wallet ;
    rdfs:label "Nondeterministic Wallet"@en ;
    rdfs:label "Deterministik Olmayan Cüzdan"@tr ;
    skos:altLabel "Random Wallet"@en ;
    skos:altLabel "JBOK Wallet"@en ;
    skos:altLabel "Type-0 Wallet"@en ;
    skos:definition """A wallet where each private key is independently generated from a 
        random number, with no mathematical relationship between keys. Also known as 
        'Just a Bunch Of Keys' (JBOK) wallet."""@en ;
    skos:scopeNote """The original Bitcoin Core client used this approach, pre-generating 
        100 random private keys. This type is discouraged due to backup complexity - 
        each key must be backed up separately or funds are irrevocably lost."""@en ;
    skos:example "Original Bitcoin Core wallet (pre-HD), early Bitcoin-Qt wallets"@en ;
    owl:disjointWith :DeterministicWallet ;
    dcterms:source "Antonopoulos (2017), Mastering Bitcoin, Chapter 5, p.93-94"@en ;
    zt:educationalLevel zt:Intermediate ;
    zt:prerequisiteConcept :Wallet, :PrivateKey ;
    zt:learningObjective "Students will explain why JBOK wallets are discouraged"@en ;
    zt:hasVisualization "random-keys-diagram" .

:DeterministicWallet rdf:type owl:Class ;
    rdfs:subClassOf :Wallet ;
    rdfs:label "Deterministic Wallet"@en ;
    rdfs:label "Deterministik Cüzdan"@tr ;
    skos:altLabel "Seeded Wallet"@en ;
    skos:definition """A wallet where all private keys are derived from a single master 
        key (seed) through a one-way hash function. The seed combined with index numbers 
        or chain codes generates a deterministic sequence of keys."""@en ;
    skos:scopeNote """A single backup of the seed at creation time is sufficient to 
        recover all derived keys, making backup and migration significantly easier 
        than nondeterministic wallets."""@en ;
    owl:disjointWith :NondeterministicWallet ;
    dcterms:source "Antonopoulos (2017), Mastering Bitcoin, Chapter 5, p.95"@en ;
    zt:educationalLevel zt:Intermediate ;
    zt:prerequisiteConcept :Wallet, :Seed, :HashFunction ;
    zt:learningObjective "Students will describe the advantages of deterministic key derivation"@en ;
    zt:hasVisualization "seed-derivation-chain" .

:SequentialDeterministicWallet rdf:type owl:Class ;
    rdfs:subClassOf :DeterministicWallet ;
    rdfs:label "Sequential Deterministic Wallet"@en ;
    skos:altLabel "Type-1 Wallet"@en ;
    skos:definition """A deterministic wallet that derives keys in a simple sequential 
        manner from the seed, without hierarchical structure."""@en ;
    owl:disjointWith :HierarchicalDeterministicWallet ;
    zt:educationalLevel zt:Intermediate .

:HierarchicalDeterministicWallet rdf:type owl:Class ;
    rdfs:subClassOf :DeterministicWallet ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasMasterSeed ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass :MasterSeed
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :implementsStandard ;
        owl:someValuesFrom bip:BIP32
    ] ;
    rdfs:label "Hierarchical Deterministic Wallet"@en ;
    rdfs:label "Hiyerarşik Deterministik Cüzdan"@tr ;
    skos:altLabel "HD Wallet"@en ;
    skos:altLabel "Type-2 Wallet"@en ;
    skos:altLabel "BIP-32 Wallet"@en ;
    skos:definition """A deterministic wallet defined by BIP-32 that derives keys in a 
        tree-like hierarchical structure. A parent key can derive a sequence of child 
        keys, each of which can derive grandchildren keys, to an infinite depth."""@en ;
    skos:scopeNote """HD wallets offer two major advantages: (1) the tree structure 
        expresses organizational meaning (e.g., receiving vs. change addresses, 
        departmental allocation), and (2) users can create public key sequences 
        without accessing private keys, enabling watch-only wallets."""@en ;
    skos:example "Electrum, Trezor, Ledger, most modern Bitcoin wallets"@en ;
    owl:disjointWith :SequentialDeterministicWallet, :NondeterministicWallet ;
    dcterms:source "Antonopoulos (2017), Mastering Bitcoin, Chapter 5, p.96"@en ;
    zt:educationalLevel zt:Intermediate ;
    zt:prerequisiteConcept :DeterministicWallet, :MasterSeed, :DerivationPath ;
    zt:learningObjective """Students will explain how HD wallets enable organizational 
        key structures and watch-only functionality"""@en ;
    zt:hasVisualization "hd-tree-diagram" ;
    zt:interactiveExercise "hd-derivation-explorer" ;
    zt:estimatedLearningTime "30"^^xsd:integer .

#-----------------------------------------------------------------------------
# Secondary Classification: By Implementation Medium
#-----------------------------------------------------------------------------

:SoftwareWallet rdf:type owl:Class ;
    rdfs:subClassOf :Wallet ;
    rdfs:label "Software Wallet"@en ;
    rdfs:label "Yazılım Cüzdanı"@tr ;
    skos:altLabel "Hot Wallet"@en ;
    skos:definition """A wallet implemented as software running on a general-purpose 
        computing device (desktop, mobile, browser). Keys are stored in the device's 
        storage or memory."""@en ;
    skos:scopeNote """Software wallets are convenient for frequent transactions but 
        carry higher security risks due to exposure to malware, network attacks, 
        and operating system vulnerabilities."""@en ;
    owl:disjointWith :HardwareWallet, :PaperWallet ;
    zt:educationalLevel zt:Beginner ;
    zt:hasVisualization "software-wallet-types" .

:DesktopWallet rdf:type owl:Class ;
    rdfs:subClassOf :SoftwareWallet ;
    rdfs:label "Desktop Wallet"@en ;
    skos:definition """A software wallet installed on a desktop or laptop computer, 
        running as a native application."""@en ;
    skos:example "Bitcoin Core, Electrum, Exodus, Sparrow Wallet"@en ;
    owl:disjointWith :MobileWallet, :WebWallet, :BrowserExtensionWallet ;
    zt:educationalLevel zt:Beginner .

:FullNodeWallet rdf:type owl:Class ;
    rdfs:subClassOf :DesktopWallet ;
    rdfs:label "Full Node Wallet"@en ;
    skos:definition """A desktop wallet that downloads and validates the entire 
        blockchain, providing maximum security and privacy by not relying on 
        third-party servers."""@en ;
    skos:scopeNote """Full node wallets require significant storage space (500+ GB 
        for Bitcoin) and initial synchronization time, but offer trustless 
        verification of all transactions."""@en ;
    skos:example "Bitcoin Core, Bitcoin Knots"@en ;
    owl:disjointWith :SPVWallet ;
    zt:educationalLevel zt:Intermediate .

:SPVWallet rdf:type owl:Class ;
    rdfs:subClassOf :DesktopWallet ;
    rdfs:label "SPV Wallet"@en ;
    skos:altLabel "Light Wallet"@en ;
    skos:altLabel "Simplified Payment Verification Wallet"@en ;
    skos:definition """A wallet that uses Simplified Payment Verification (SPV) to 
        verify transactions without downloading the full blockchain, relying on 
        block headers and Merkle proofs."""@en ;
    skos:scopeNote """SPV wallets trade some security for convenience, trusting that 
        miners are honest about transaction inclusion. Suitable for mobile devices 
        and users without resources for full nodes."""@en ;
    skos:example "Electrum (default mode), Bread Wallet"@en ;
    owl:disjointWith :FullNodeWallet ;
    zt:educationalLevel zt:Intermediate .

:MobileWallet rdf:type owl:Class ;
    rdfs:subClassOf :SoftwareWallet ;
    rdfs:label "Mobile Wallet"@en ;
    rdfs:label "Mobil Cüzdan"@tr ;
    skos:definition """A software wallet designed for smartphones and tablets, 
        optimized for on-the-go transactions and QR code scanning."""@en ;
    skos:example "Trust Wallet, Mycelium, BlueWallet, Muun"@en ;
    owl:disjointWith :DesktopWallet, :WebWallet ;
    zt:educationalLevel zt:Beginner .

:iOSWallet rdf:type owl:Class ;
    rdfs:subClassOf :MobileWallet ;
    rdfs:label "iOS Wallet"@en ;
    skos:definition "A mobile wallet application designed for Apple iOS devices."@en ;
    owl:disjointWith :AndroidWallet ;
    zt:educationalLevel zt:Beginner .

:AndroidWallet rdf:type owl:Class ;
    rdfs:subClassOf :MobileWallet ;
    rdfs:label "Android Wallet"@en ;
    skos:definition "A mobile wallet application designed for Android devices."@en ;
    owl:disjointWith :iOSWallet ;
    zt:educationalLevel zt:Beginner .

:WebWallet rdf:type owl:Class ;
    rdfs:subClassOf :SoftwareWallet ;
    rdfs:label "Web Wallet"@en ;
    skos:definition """A wallet accessed through a web browser, where keys may be 
        stored on remote servers (custodial) or locally in the browser (non-custodial)."""@en ;
    owl:disjointWith :DesktopWallet, :MobileWallet ;
    zt:educationalLevel zt:Beginner .

:CustodialWebWallet rdf:type owl:Class ;
    rdfs:subClassOf :WebWallet ;
    rdfs:label "Custodial Web Wallet"@en ;
    skos:definition """A web wallet where a third party holds and manages the 
        private keys on behalf of the user. The user does not have direct 
        control over the keys."""@en ;
    skos:scopeNote """'Not your keys, not your coins' - custodial wallets introduce 
        counterparty risk but offer convenience and recovery options."""@en ;
    skos:example "Exchange wallets (Coinbase, Binance), hosted wallet services"@en ;
    owl:disjointWith :NonCustodialWebWallet ;
    zt:educationalLevel zt:Beginner .

:NonCustodialWebWallet rdf:type owl:Class ;
    rdfs:subClassOf :WebWallet ;
    rdfs:label "Non-Custodial Web Wallet"@en ;
    skos:altLabel "Self-Custodial Web Wallet"@en ;
    skos:definition """A web wallet where the user retains full control of private 
        keys, which are stored locally in the browser or derived client-side."""@en ;
    owl:disjointWith :CustodialWebWallet ;
    zt:educationalLevel zt:Beginner .

:BrowserExtensionWallet rdf:type owl:Class ;
    rdfs:subClassOf :SoftwareWallet ;
    rdfs:label "Browser Extension Wallet"@en ;
    skos:definition """A wallet implemented as a browser extension, enabling 
        interaction with decentralized applications (dApps) directly from the browser."""@en ;
    skos:scopeNote """Browser extension wallets became popular with Ethereum and 
        Web3 applications, injecting a JavaScript API into web pages."""@en ;
    skos:example "MetaMask, Phantom, Rabby, Keplr"@en ;
    zt:educationalLevel zt:Beginner .

#-----------------------------------------------------------------------------
# Hardware Wallet Classification
#-----------------------------------------------------------------------------

:HardwareWallet rdf:type owl:Class ;
    rdfs:subClassOf :Wallet ;
    rdfs:label "Hardware Wallet"@en ;
    rdfs:label "Donanım Cüzdanı"@tr ;
    skos:altLabel "Cold Wallet"@en ;
    skos:altLabel "Signing Device"@en ;
    skos:definition """A specialized physical device designed to securely store 
        private keys offline and sign transactions without exposing keys to 
        potentially compromised computers."""@en ;
    skos:scopeNote """Hardware wallets use secure elements or specialized chips 
        to isolate keys from general-purpose computing environments, providing 
        strong protection against malware and remote attacks."""@en ;
    skos:example "Ledger Nano X, Trezor Model T, Coldcard Mk4, BitBox02"@en ;
    owl:disjointWith :SoftwareWallet, :PaperWallet ;
    zt:educationalLevel zt:Beginner ;
    zt:learningObjective "Students will explain hardware wallet security model"@en ;
    zt:hasVisualization "hardware-wallet-security-model" .

:AirGappedWallet rdf:type owl:Class ;
    rdfs:subClassOf :HardwareWallet ;
    rdfs:label "Air-Gapped Wallet"@en ;
    skos:definition """A hardware wallet designed to operate without any direct 
        electronic connection to other devices, using QR codes, microSD cards, 
        or NFC for data transfer."""@en ;
    skos:scopeNote """Air-gapping eliminates attack vectors from USB, Bluetooth, 
        and WiFi connections, representing the highest security level for 
        cold storage."""@en ;
    skos:example "Coldcard (via microSD), NGRAVE ZERO, ELLIPAL Titan"@en ;
    zt:educationalLevel zt:Intermediate .

:USBConnectedWallet rdf:type owl:Class ;
    rdfs:subClassOf :HardwareWallet ;
    rdfs:label "USB Connected Wallet"@en ;
    skos:definition """A hardware wallet that connects to host computers via 
        USB for transaction signing and firmware updates."""@en ;
    skos:example "Ledger Nano S, Trezor One, BitBox02"@en ;
    owl:disjointWith :AirGappedWallet ;
    zt:educationalLevel zt:Beginner .

:BluetoothWallet rdf:type owl:Class ;
    rdfs:subClassOf :HardwareWallet ;
    rdfs:label "Bluetooth Wallet"@en ;
    skos:definition """A hardware wallet supporting Bluetooth connectivity for 
        wireless interaction with mobile devices."""@en ;
    skos:scopeNote """Bluetooth introduces potential attack surface but enables 
        convenient mobile usage. Some security experts prefer USB-only devices."""@en ;
    skos:example "Ledger Nano X, Trezor Safe 5"@en ;
    zt:educationalLevel zt:Beginner .

#-----------------------------------------------------------------------------
# Paper Wallet
#-----------------------------------------------------------------------------

:PaperWallet rdf:type owl:Class ;
    rdfs:subClassOf :Wallet ;
    rdfs:label "Paper Wallet"@en ;
    rdfs:label "Kağıt Cüzdan"@tr ;
    skos:definition """A form of cold storage where private keys and/or seed phrases 
        are printed or written on physical paper, completely offline."""@en ;
    skos:scopeNote """Paper wallets were popular for long-term storage before HD 
        wallets became standard. They are immune to digital attacks but vulnerable 
        to physical damage, loss, and theft."""@en ;
    owl:disjointWith :SoftwareWallet, :HardwareWallet ;
    zt:educationalLevel zt:Beginner .

:SingleKeyPaperWallet rdf:type owl:Class ;
    rdfs:subClassOf :PaperWallet ;
    rdfs:label "Single Key Paper Wallet"@en ;
    skos:definition """A paper wallet containing a single private key and its 
        corresponding public address."""@en ;
    owl:disjointWith :BIP38EncryptedPaperWallet ;
    zt:educationalLevel zt:Beginner .

:BIP38EncryptedPaperWallet rdf:type owl:Class ;
    rdfs:subClassOf :PaperWallet ;
    rdfs:label "BIP-38 Encrypted Paper Wallet"@en ;
    skos:definition """A paper wallet where the private key is encrypted with a 
        passphrase using BIP-38 encryption, requiring the passphrase to spend."""@en ;
    skos:scopeNote """BIP-38 encryption adds a layer of security - even if the 
        paper is stolen, the attacker needs the passphrase to access funds."""@en ;
    zt:educationalLevel zt:Intermediate .

#-----------------------------------------------------------------------------
# Smart Contract Wallet Classification (Post-2017 Innovation)
#-----------------------------------------------------------------------------

:SmartContractWallet rdf:type owl:Class ;
    rdfs:subClassOf :Wallet ;
    rdfs:label "Smart Contract Wallet"@en ;
    rdfs:label "Akıllı Sözleşme Cüzdanı"@tr ;
    skos:definition """A wallet implemented as a smart contract on a blockchain, 
        enabling programmable logic for key management, transaction authorization, 
        and recovery mechanisms."""@en ;
    skos:scopeNote """Smart contract wallets emerged primarily on Ethereum to 
        overcome limitations of Externally Owned Accounts (EOAs), enabling 
        features like social recovery, spending limits, and batched transactions."""@en ;
    skos:example "Gnosis Safe, Argent, Loopring Wallet"@en ;
    zt:educationalLevel zt:Advanced ;
    zt:prerequisiteConcept :Wallet, :SmartContract ;
    zt:learningObjective "Students will compare EOA wallets with smart contract wallets"@en .

:MultisigWallet rdf:type owl:Class ;
    rdfs:subClassOf :SmartContractWallet ;
    rdfs:label "Multisig Wallet"@en ;
    rdfs:label "Multi-Signature Wallet"@en ;
    rdfs:label "Çoklu İmza Cüzdanı"@tr ;
    skos:definition """A wallet requiring multiple private key signatures to authorize 
        transactions, typically configured as M-of-N (e.g., 2-of-3 requiring any 
        2 signatures from 3 possible signers)."""@en ;
    skos:scopeNote """Multisig eliminates single points of failure and enables 
        organizational controls. First used with Bitcoin P2SH (2012) and later 
        implemented via smart contracts on Ethereum."""@en ;
    skos:example "Gnosis Safe, Electrum multisig, Casa"@en ;
    dcterms:source "First multisig wallet: 2013, using P2SH addresses"@en ;
    zt:educationalLevel zt:Intermediate ;
    zt:hasVisualization "multisig-m-of-n-diagram" ;
    zt:interactiveExercise "multisig-scenario-builder" .

:SocialRecoveryWallet rdf:type owl:Class ;
    rdfs:subClassOf :SmartContractWallet ;
    rdfs:label "Social Recovery Wallet"@en ;
    skos:definition """A smart contract wallet that uses designated 'guardians' 
        (trusted parties) who can collectively help recover access to the wallet 
        if the primary signing key is lost."""@en ;
    skos:scopeNote """Pioneered by Argent and Loopring (2018), social recovery 
        eliminates seed phrase backup while enabling trustless recovery through 
        majority guardian approval."""@en ;
    skos:example "Argent, Loopring Smart Wallet"@en ;
    dcterms:source "Vitalik Buterin, 'Why we need wide adoption of social recovery wallets', 2021"@en ;
    zt:educationalLevel zt:Advanced ;
    zt:prerequisiteConcept :SmartContractWallet, :Guardian ;
    zt:learningObjective "Students will design a guardian selection strategy"@en .

:AccountAbstractionWallet rdf:type owl:Class ;
    rdfs:subClassOf :SmartContractWallet ;
    rdfs:label "Account Abstraction Wallet"@en ;
    skos:altLabel "ERC-4337 Wallet"@en ;
    skos:altLabel "Smart Account"@en ;
    skos:definition """A wallet implementing ERC-4337 account abstraction, enabling 
        programmable account logic without protocol changes, including custom 
        signature schemes, gas sponsorship, and batched transactions."""@en ;
    skos:scopeNote """ERC-4337 (2021-2023) introduces UserOperations processed by 
        Bundlers through an alternative mempool, enabling features like paying 
        gas in ERC-20 tokens and social recovery without protocol modifications."""@en ;
    skos:example "Safe (ERC-4337 mode), Biconomy Smart Account, ZeroDev Kernel"@en ;
    dcterms:source "EIP-4337: Vitalik Buterin et al., 2021"@en ;
    zt:educationalLevel zt:Advanced ;
    zt:prerequisiteConcept :SmartContractWallet, :UserOperation, :Bundler ;
    zt:learningObjective "Students will explain the ERC-4337 transaction flow"@en ;
    zt:hasVisualization "erc4337-architecture-diagram" .

#-----------------------------------------------------------------------------
# MPC Wallet Classification (Post-2017 Innovation)
#-----------------------------------------------------------------------------

:MPCWallet rdf:type owl:Class ;
    rdfs:subClassOf :Wallet ;
    rdfs:label "MPC Wallet"@en ;
    rdfs:label "Multi-Party Computation Wallet"@en ;
    skos:definition """A wallet using Multi-Party Computation cryptography to split 
        the private key into multiple shares distributed among parties, where 
        threshold signatures are computed without ever reconstructing the full key."""@en ;
    skos:scopeNote """MPC wallets provide similar security benefits to multisig but 
        produce standard single signatures, enabling cross-chain compatibility, 
        lower transaction fees, and enhanced privacy."""@en ;
    skos:example "Fireblocks, ZenGo, Tholos, MPCVault"@en ;
    zt:educationalLevel zt:Advanced ;
    zt:prerequisiteConcept :Wallet, :ThresholdSignature, :SecretSharing ;
    zt:learningObjective "Students will compare MPC vs multisig security models"@en ;
    zt:hasVisualization "mpc-vs-multisig-comparison" .


#=============================================================================
# PART 2: KEY MANAGEMENT AND CRYPTOGRAPHIC CONCEPTS
#=============================================================================

#-----------------------------------------------------------------------------
# Cryptographic Key Hierarchy
#-----------------------------------------------------------------------------

:CryptographicKey rdf:type owl:Class ;
    rdfs:label "Cryptographic Key"@en ;
    rdfs:label "Kriptografik Anahtar"@tr ;
    skos:definition """A piece of cryptographic data used in encryption, decryption, 
        or digital signature operations within a blockchain wallet."""@en ;
    zt:educationalLevel zt:Beginner .

:PrivateKey rdf:type owl:Class ;
    rdfs:subClassOf :CryptographicKey ;
    rdfs:label "Private Key"@en ;
    rdfs:label "Özel Anahtar"@tr ;
    skos:definition """A 256-bit random number that serves as the secret key for 
        signing transactions and proving ownership of blockchain assets. Must be 
        kept confidential - possession equals control of associated funds."""@en ;
    skos:scopeNote """In Bitcoin, private keys are typically represented as 64 
        hexadecimal characters or in Wallet Import Format (WIF)."""@en ;
    owl:disjointWith :PublicKey ;
    zt:educationalLevel zt:Beginner ;
    zt:learningObjective "Students will explain why private key security is paramount"@en .

:PublicKey rdf:type owl:Class ;
    rdfs:subClassOf :CryptographicKey ;
    rdfs:label "Public Key"@en ;
    rdfs:label "Açık Anahtar"@tr ;
    skos:definition """A cryptographic key derived from the private key using elliptic 
        curve multiplication, used to verify signatures and derive addresses. 
        Can be shared publicly without compromising security."""@en ;
    owl:disjointWith :PrivateKey ;
    zt:educationalLevel zt:Beginner .

:ExtendedKey rdf:type owl:Class ;
    rdfs:subClassOf :CryptographicKey ;
    rdfs:label "Extended Key"@en ;
    skos:definition """A key combined with a chain code (256-bit value) enabling 
        hierarchical key derivation in HD wallets. The chain code adds entropy 
        to the derivation function."""@en ;
    zt:educationalLevel zt:Intermediate ;
    zt:prerequisiteConcept :CryptographicKey, :ChainCode .

:ExtendedPrivateKey rdf:type owl:Class ;
    rdfs:subClassOf :ExtendedKey ;
    rdfs:label "Extended Private Key"@en ;
    skos:altLabel "xprv"@en ;
    skos:altLabel "xpriv"@en ;
    skos:definition """An extended key containing a private key plus chain code, 
        capable of deriving both child private keys and child public keys."""@en ;
    skos:scopeNote """Extended private keys are serialized with prefix 'xprv' 
        (mainnet) or 'tprv' (testnet) in Base58Check encoding."""@en ;
    owl:disjointWith :ExtendedPublicKey ;
    zt:educationalLevel zt:Intermediate .

:ExtendedPublicKey rdf:type owl:Class ;
    rdfs:subClassOf :ExtendedKey ;
    rdfs:label "Extended Public Key"@en ;
    skos:altLabel "xpub"@en ;
    skos:definition """An extended key containing a public key plus chain code, 
        capable of deriving child public keys (but not private keys) for 
        watch-only functionality."""@en ;
    skos:scopeNote """xpubs enable watch-only wallets and payment processing 
        systems that generate unique addresses without holding private keys. 
        However, leaking an xpub with any derived private key compromises 
        the entire branch."""@en ;
    skos:example "Used by merchants to generate unique payment addresses"@en ;
    owl:disjointWith :ExtendedPrivateKey ;
    zt:educationalLevel zt:Intermediate ;
    zt:learningObjective "Students will implement a watch-only wallet using xpub"@en .

:MasterKey rdf:type owl:Class ;
    rdfs:subClassOf :ExtendedKey ;
    rdfs:label "Master Key"@en ;
    skos:altLabel "Root Key"@en ;
    skos:definition """The root extended key derived directly from the seed, 
        from which all other keys in an HD wallet are derived."""@en ;
    zt:educationalLevel zt:Intermediate .

:DerivedKey rdf:type owl:Class ;
    rdfs:subClassOf :CryptographicKey ;
    rdfs:label "Derived Key"@en ;
    skos:definition """A key generated through the HD derivation function from 
        a parent key and index number."""@en ;
    zt:educationalLevel zt:Intermediate .

:HardenedKey rdf:type owl:Class ;
    rdfs:subClassOf :DerivedKey ;
    rdfs:label "Hardened Key"@en ;
    skos:definition """A derived key using hardened derivation (index ≥ 2^31), 
        which uses the parent private key as input, breaking the mathematical 
        link between parent public key and child chain code."""@en ;
    skos:scopeNote """Hardened derivation creates a 'firewall' - the child chain 
        code cannot be used to compromise parent or sibling private keys. 
        Indicated by apostrophe in path notation (e.g., m/44'/0')."""@en ;
    owl:disjointWith :NormalKey ;
    zt:educationalLevel zt:Advanced ;
    zt:learningObjective "Students will explain when to use hardened derivation"@en ;
    zt:hasVisualization "hardened-vs-normal-derivation" .

:NormalKey rdf:type owl:Class ;
    rdfs:subClassOf :DerivedKey ;
    rdfs:label "Normal Key"@en ;
    skos:altLabel "Non-Hardened Key"@en ;
    skos:definition """A derived key using normal derivation (index < 2^31), 
        which uses the parent public key as input, allowing public key 
        derivation without private key access."""@en ;
    skos:scopeNote """Normal derivation enables watch-only wallets but carries 
        risk: a leaked child private key plus parent xpub can compromise 
        all sibling private keys."""@en ;
    owl:disjointWith :HardenedKey ;
    zt:educationalLevel zt:Advanced .

#-----------------------------------------------------------------------------
# Seed and Mnemonic Concepts
#-----------------------------------------------------------------------------

:Seed rdf:type owl:Class ;
    rdfs:label "Seed"@en ;
    rdfs:label "Tohum"@tr ;
    skos:definition """A randomly generated value that serves as the root entropy 
        for deterministic key derivation. The seed is the single secret from 
        which all wallet keys are derived."""@en ;
    zt:educationalLevel zt:Beginner .

:MasterSeed rdf:type owl:Class ;
    rdfs:subClassOf :Seed ;
    rdfs:label "Master Seed"@en ;
    skos:definition """The primary seed value (typically 128-256 bits of entropy) 
        from which the master key and all subsequent keys are derived."""@en ;
    zt:educationalLevel zt:Intermediate .

:Mnemonic rdf:type owl:Class ;
    rdfs:label "Mnemonic"@en ;
    rdfs:label "Anımsatıcı"@tr ;
    skos:altLabel "Seed Phrase"@en ;
    skos:altLabel "Recovery Phrase"@en ;
    skos:altLabel "Mnemonic Code Words"@en ;
    skos:definition """A sequence of common English words (typically 12, 15, 18, 21, 
        or 24 words) that encode the wallet seed according to BIP-39, making it 
        easier to transcribe, record, and import across wallets."""@en ;
    skos:scopeNote """The mnemonic is derived from entropy using a wordlist of 
        2048 words. Each word encodes 11 bits. The last word includes a 
        checksum for error detection."""@en ;
    skos:example "'army van defense carry jealous true garbage claim echo media make crunch'"@en ;
    zt:educationalLevel zt:Beginner ;
    zt:learningObjective "Students will generate and validate BIP-39 mnemonics"@en ;
    zt:interactiveExercise "mnemonic-generator" .

:Passphrase rdf:type owl:Class ;
    rdfs:label "Passphrase"@en ;
    skos:altLabel "BIP-39 Passphrase"@en ;
    skos:altLabel "25th Word"@en ;
    skos:definition """An optional additional word/phrase added to the mnemonic 
        during seed derivation, creating a completely different wallet from 
        the same mnemonic words."""@en ;
    skos:scopeNote """The passphrase enables plausible deniability (different 
        wallets from same mnemonic) and adds protection against mnemonic 
        compromise. An empty string is used if no passphrase is set."""@en ;
    zt:educationalLevel zt:Intermediate .

:ChainCode rdf:type owl:Class ;
    rdfs:label "Chain Code"@en ;
    skos:definition """A 256-bit value paired with keys in HD wallets that adds 
        entropy to the derivation function, preventing derivation of child 
        keys from public key alone."""@en ;
    zt:educationalLevel zt:Intermediate ;
    zt:prerequisiteConcept :ExtendedKey .

#-----------------------------------------------------------------------------
# Derivation Path
#-----------------------------------------------------------------------------

:DerivationPath rdf:type owl:Class ;
    rdfs:label "Derivation Path"@en ;
    rdfs:label "Türetme Yolu"@tr ;
    skos:definition """A hierarchical notation specifying the location of a key 
        within an HD wallet tree, using slash-separated indices starting from 
        the master key (m for private, M for public)."""@en ;
    skos:scopeNote """Format: m / purpose' / coin_type' / account' / change / address_index
        Apostrophe indicates hardened derivation."""@en ;
    skos:example "m/44'/0'/0'/0/0 - First receiving address, first Bitcoin account"@en ;
    zt:educationalLevel zt:Intermediate ;
    zt:learningObjective "Students will parse and construct BIP-44 derivation paths"@en ;
    zt:interactiveExercise "derivation-path-builder" .

:PathComponent rdf:type owl:Class ;
    rdfs:label "Path Component"@en ;
    skos:definition "A single level/index within a derivation path."@en ;
    zt:educationalLevel zt:Intermediate .

:PurposeLevel rdf:type owl:Class ;
    rdfs:subClassOf :PathComponent ;
    rdfs:label "Purpose Level"@en ;
    skos:definition """The first level (index 0) of a BIP-43 compliant path that 
        indicates the wallet structure standard being used."""@en ;
    skos:example "44' for BIP-44, 49' for BIP-49, 84' for BIP-84, 86' for BIP-86"@en ;
    zt:educationalLevel zt:Intermediate .

:CoinTypeLevel rdf:type owl:Class ;
    rdfs:subClassOf :PathComponent ;
    rdfs:label "Coin Type Level"@en ;
    skos:definition """The second level of a BIP-44 path identifying the 
        cryptocurrency, enabling multi-currency HD wallets."""@en ;
    skos:example "0' for Bitcoin, 1' for Testnet, 60' for Ethereum, 2' for Litecoin"@en ;
    zt:educationalLevel zt:Intermediate .

:AccountLevel rdf:type owl:Class ;
    rdfs:subClassOf :PathComponent ;
    rdfs:label "Account Level"@en ;
    skos:definition """The third level allowing users to organize funds into 
        separate logical accounts within the same wallet."""@en ;
    skos:example "0' for first account, 1' for second account"@en ;
    zt:educationalLevel zt:Intermediate .

:ChangeLevel rdf:type owl:Class ;
    rdfs:subClassOf :PathComponent ;
    rdfs:label "Change Level"@en ;
    skos:definition """The fourth level distinguishing receiving addresses (0) 
        from change addresses (1) used for transaction outputs."""@en ;
    skos:scopeNote "Uses normal (non-hardened) derivation to enable xpub sharing."@en ;
    zt:educationalLevel zt:Intermediate .

:AddressIndexLevel rdf:type owl:Class ;
    rdfs:subClassOf :PathComponent ;
    rdfs:label "Address Index Level"@en ;
    skos:definition """The fifth level providing sequential indices for 
        generating individual addresses within a change/receiving branch."""@en ;
    zt:educationalLevel zt:Intermediate .

#-----------------------------------------------------------------------------
# Address Types
#-----------------------------------------------------------------------------

:BlockchainAddress rdf:type owl:Class ;
    rdfs:label "Blockchain Address"@en ;
    rdfs:label "Blok Zinciri Adresi"@tr ;
    skos:definition """A human-readable identifier derived from a public key, 
        used to receive cryptocurrency payments."""@en ;
    zt:educationalLevel zt:Beginner .

:P2PKHAddress rdf:type owl:Class ;
    rdfs:subClassOf :BlockchainAddress ;
    rdfs:label "P2PKH Address"@en ;
    skos:altLabel "Legacy Address"@en ;
    skos:definition """Pay-to-Public-Key-Hash address starting with '1', the 
        original Bitcoin address format using Hash160 of the public key."""@en ;
    skos:example "1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN2"@en ;
    zt:educationalLevel zt:Intermediate .

:P2SHAddress rdf:type owl:Class ;
    rdfs:subClassOf :BlockchainAddress ;
    rdfs:label "P2SH Address"@en ;
    skos:altLabel "Script Hash Address"@en ;
    skos:definition """Pay-to-Script-Hash address starting with '3', enabling 
        complex scripts including multisig and SegWit-wrapped addresses."""@en ;
    skos:example "3J98t1WpEZ73CNmQviecrnyiWrnqRhWNLy"@en ;
    zt:educationalLevel zt:Intermediate .

:Bech32Address rdf:type owl:Class ;
    rdfs:subClassOf :BlockchainAddress ;
    rdfs:label "Bech32 Address"@en ;
    skos:altLabel "Native SegWit Address"@en ;
    skos:altLabel "P2WPKH Address"@en ;
    skos:definition """Native SegWit address starting with 'bc1q' (mainnet), 
        using Bech32 encoding with built-in error detection."""@en ;
    skos:example "bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq"@en ;
    zt:educationalLevel zt:Intermediate .

:TaprootAddress rdf:type owl:Class ;
    rdfs:subClassOf :BlockchainAddress ;
    rdfs:label "Taproot Address"@en ;
    skos:altLabel "P2TR Address"@en ;
    skos:altLabel "Bech32m Address"@en ;
    skos:definition """Pay-to-Taproot address starting with 'bc1p' using Bech32m 
        encoding, supporting Schnorr signatures and MAST scripts (BIP-341)."""@en ;
    skos:scopeNote """Taproot addresses make multisig and complex scripts 
        indistinguishable from single-sig transactions, enhancing privacy."""@en ;
    skos:example "bc1p5cyxnuxmeuwuvkwfem96lqzszd02n6xdcjrs20cac6yqjjwudpxqkedrcr"@en ;
    zt:educationalLevel zt:Advanced ;
    zt:prerequisiteConcept :SchnorrSignature, :TaprootUpgrade .

#=============================================================================
# PART 3: BIP STANDARDS
#=============================================================================

bip:BIPStandard rdf:type owl:Class ;
    rdfs:label "BIP Standard"@en ;
    skos:altLabel "Bitcoin Improvement Proposal"@en ;
    skos:definition """A formal specification document proposing changes or 
        additions to Bitcoin's protocol, processes, or environment."""@en ;
    zt:educationalLevel zt:Intermediate .

bip:BIP32 rdf:type owl:NamedIndividual, bip:BIPStandard ;
    rdfs:label "BIP-32: HD Wallets"@en ;
    skos:definition """Hierarchical Deterministic Wallets specification defining 
        the derivation scheme for HD wallet key trees using HMAC-SHA512."""@en ;
    dcterms:date "2012-02-11"^^xsd:date ;
    dcterms:creator "Pieter Wuille"^^xsd:string ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0032.mediawiki> ;
    zt:educationalLevel zt:Intermediate .

bip:BIP39 rdf:type owl:NamedIndividual, bip:BIPStandard ;
    rdfs:label "BIP-39: Mnemonic Code"@en ;
    skos:definition """Mnemonic code for generating deterministic keys, specifying 
        the wordlist and algorithm for converting entropy to seed phrases."""@en ;
    dcterms:date "2013-09-10"^^xsd:date ;
    dcterms:creator "Marek Palatinus, Pavol Rusnak, Aaron Voisine, Sean Bowe"^^xsd:string ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0039.mediawiki> ;
    zt:educationalLevel zt:Intermediate .

bip:BIP43 rdf:type owl:NamedIndividual, bip:BIPStandard ;
    rdfs:label "BIP-43: Purpose Field"@en ;
    skos:definition """Proposes using the first hardened child index as a 'purpose' 
        field to indicate the wallet structure standard in use."""@en ;
    dcterms:date "2014-04-24"^^xsd:date ;
    zt:educationalLevel zt:Intermediate .

bip:BIP44 rdf:type owl:NamedIndividual, bip:BIPStandard ;
    rdfs:label "BIP-44: Multi-Account Hierarchy"@en ;
    skos:definition """Multi-account hierarchy for deterministic wallets, defining 
        the 5-level path: m/44'/coin'/account'/change/address_index."""@en ;
    dcterms:date "2014-04-24"^^xsd:date ;
    dcterms:creator "Marek Palatinus, Pavol Rusnak"^^xsd:string ;
    dcterms:source <https://github.com/bitcoin/bips/blob/master/bip-0044.mediawiki> ;
    zt:educationalLevel zt:Intermediate ;
    zt:learningObjective "Students will implement BIP-44 address generation"@en .

bip:BIP49 rdf:type owl:NamedIndividual, bip:BIPStandard ;
    rdfs:label "BIP-49: P2WPKH-nested-in-P2SH"@en ;
    skos:definition """Derivation scheme for P2WPKH-nested-in-P2SH addresses 
        (SegWit-compatible addresses starting with '3')."""@en ;
    dcterms:date "2016-05-19"^^xsd:date ;
    zt:educationalLevel zt:Advanced .

bip:BIP84 rdf:type owl:NamedIndividual, bip:BIPStandard ;
    rdfs:label "BIP-84: Native SegWit"@en ;
    skos:definition """Derivation scheme for native SegWit (P2WPKH) addresses 
        starting with 'bc1q', using purpose 84'."""@en ;
    dcterms:date "2017-12-28"^^xsd:date ;
    zt:educationalLevel zt:Advanced .

bip:BIP86 rdf:type owl:NamedIndividual, bip:BIPStandard ;
    rdfs:label "BIP-86: Taproot Single Key"@en ;
    skos:definition """Derivation scheme for Taproot (P2TR) single-key addresses 
        starting with 'bc1p', using purpose 86'."""@en ;
    dcterms:date "2021-06-22"^^xsd:date ;
    zt:educationalLevel zt:Advanced ;
    zt:prerequisiteConcept :TaprootUpgrade .

bip:BIP174 rdf:type owl:NamedIndividual, bip:BIPStandard ;
    rdfs:label "BIP-174: PSBT"@en ;
    skos:altLabel "Partially Signed Bitcoin Transactions"@en ;
    skos:definition """Format for unsigned/partially-signed transactions enabling 
        coordination between multiple signers, crucial for hardware wallets 
        and multisig workflows."""@en ;
    dcterms:date "2017-07-21"^^xsd:date ;
    zt:educationalLevel zt:Advanced .

bip:BIP340 rdf:type owl:NamedIndividual, bip:BIPStandard ;
    rdfs:label "BIP-340: Schnorr Signatures"@en ;
    skos:definition """Schnorr signature scheme for secp256k1, enabling signature 
        aggregation, batch verification, and simplified multisig."""@en ;
    dcterms:date "2020-01-19"^^xsd:date ;
    dcterms:creator "Pieter Wuille, Jonas Nick, Tim Ruffing"^^xsd:string ;
    zt:educationalLevel zt:Advanced .

bip:BIP341 rdf:type owl:NamedIndividual, bip:BIPStandard ;
    rdfs:label "BIP-341: Taproot"@en ;
    skos:definition """Taproot spending rules enabling payments to Schnorr public 
        keys that may optionally commit to script trees (MAST)."""@en ;
    dcterms:date "2020-01-19"^^xsd:date ;
    zt:educationalLevel zt:Advanced .

bip:BIP38 rdf:type owl:NamedIndividual, bip:BIPStandard ;
    rdfs:label "BIP-38: Encrypted Private Keys"@en ;
    skos:definition """Method for encrypting private keys with a passphrase, 
        commonly used for paper wallet protection."""@en ;
    zt:educationalLevel zt:Intermediate .


#=============================================================================
# PART 4: SECURITY AND CRYPTOGRAPHIC CONCEPTS
#=============================================================================

:SecurityFeature rdf:type owl:Class ;
    rdfs:label "Security Feature"@en ;
    skos:definition "A mechanism or capability that enhances wallet security."@en ;
    zt:educationalLevel zt:Intermediate .

:SecureElement rdf:type owl:Class ;
    rdfs:subClassOf :SecurityFeature ;
    rdfs:label "Secure Element"@en ;
    skos:definition """A tamper-resistant hardware chip (EAL5+ certified) designed 
        to store cryptographic keys and perform signing operations in isolation 
        from the main processor."""@en ;
    skos:example "Ledger's custom secure element, STM32 chips"@en ;
    zt:educationalLevel zt:Intermediate .

:PINProtection rdf:type owl:Class ;
    rdfs:subClassOf :SecurityFeature ;
    rdfs:label "PIN Protection"@en ;
    skos:definition """Numeric code required to unlock the wallet and authorize 
        transactions, providing defense against physical access attacks."""@en ;
    zt:educationalLevel zt:Beginner .

:DuressWallet rdf:type owl:Class ;
    rdfs:subClassOf :SecurityFeature ;
    rdfs:label "Duress Wallet"@en ;
    skos:altLabel "Decoy Wallet"@en ;
    skos:definition """A secondary wallet accessible via different PIN/passphrase, 
        containing decoy funds to satisfy attackers in coercion scenarios."""@en ;
    skos:example "Coldcard's duress PIN feature"@en ;
    zt:educationalLevel zt:Intermediate .

:TwoFactorAuthentication rdf:type owl:Class ;
    rdfs:subClassOf :SecurityFeature ;
    rdfs:label "Two-Factor Authentication"@en ;
    skos:altLabel "2FA"@en ;
    skos:definition """Authentication requiring two different factors (something 
        you know + something you have) to access wallet functions."""@en ;
    zt:educationalLevel zt:Beginner .

:BiometricAuthentication rdf:type owl:Class ;
    rdfs:subClassOf :SecurityFeature ;
    rdfs:label "Biometric Authentication"@en ;
    skos:definition """Authentication using biological characteristics such as 
        fingerprint, face recognition, or iris scan."""@en ;
    zt:educationalLevel zt:Beginner .

:Guardian rdf:type owl:Class ;
    rdfs:label "Guardian"@en ;
    skos:definition """A trusted party (person, device, or service) designated to 
        assist with wallet recovery or security functions in social recovery 
        and smart contract wallets."""@en ;
    skos:scopeNote """Guardians can lock wallets, approve recovery requests, or 
        authorize high-value transactions. They cannot access funds directly."""@en ;
    zt:educationalLevel zt:Advanced .

:RecoveryMechanism rdf:type owl:Class ;
    rdfs:label "Recovery Mechanism"@en ;
    skos:definition "A method for regaining access to a wallet after key loss."@en ;
    zt:educationalLevel zt:Intermediate .

:SeedPhraseRecovery rdf:type owl:Class ;
    rdfs:subClassOf :RecoveryMechanism ;
    rdfs:label "Seed Phrase Recovery"@en ;
    skos:definition """Traditional recovery using the BIP-39 mnemonic phrase to 
        regenerate all wallet keys on a new device."""@en ;
    zt:educationalLevel zt:Beginner .

:SocialRecovery rdf:type owl:Class ;
    rdfs:subClassOf :RecoveryMechanism ;
    rdfs:label "Social Recovery"@en ;
    skos:definition """Recovery mechanism where a threshold of guardians can 
        collectively authorize replacement of the wallet's signing key."""@en ;
    skos:scopeNote """Requires majority guardian approval (e.g., 3 of 5) to 
        prevent single-guardian compromise."""@en ;
    zt:educationalLevel zt:Advanced .

:CloudBackupRecovery rdf:type owl:Class ;
    rdfs:subClassOf :RecoveryMechanism ;
    rdfs:label "Cloud Backup Recovery"@en ;
    skos:definition """Recovery using encrypted backup stored in cloud services 
        (iCloud, Google Drive), typically requiring 2FA verification."""@en ;
    zt:educationalLevel zt:Intermediate .

#-----------------------------------------------------------------------------
# Signature Schemes
#-----------------------------------------------------------------------------

:SignatureScheme rdf:type owl:Class ;
    rdfs:label "Signature Scheme"@en ;
    skos:definition "A cryptographic algorithm for creating digital signatures."@en ;
    zt:educationalLevel zt:Intermediate .

:ECDSASignature rdf:type owl:Class ;
    rdfs:subClassOf :SignatureScheme ;
    rdfs:label "ECDSA Signature"@en ;
    skos:definition """Elliptic Curve Digital Signature Algorithm, the original 
        signature scheme used in Bitcoin since 2009."""@en ;
    zt:educationalLevel zt:Intermediate .

:SchnorrSignature rdf:type owl:Class ;
    rdfs:subClassOf :SignatureScheme ;
    rdfs:label "Schnorr Signature"@en ;
    skos:definition """Signature scheme added in Taproot (BIP-340) offering 
        linearity for signature aggregation, batch verification, and 
        simpler/secure multisig constructions."""@en ;
    skos:scopeNote """Schnorr signatures make multisig transactions indistinguishable 
        from single-sig, enhancing privacy and reducing fees."""@en ;
    zt:educationalLevel zt:Advanced ;
    zt:learningObjective "Students will compare ECDSA vs Schnorr properties"@en .

:ThresholdSignature rdf:type owl:Class ;
    rdfs:subClassOf :SignatureScheme ;
    rdfs:label "Threshold Signature"@en ;
    skos:altLabel "TSS"@en ;
    skos:definition """A signature scheme where a threshold number of parties 
        must collaborate to produce a valid signature, without reconstructing 
        the complete private key."""@en ;
    zt:educationalLevel zt:Advanced .

#-----------------------------------------------------------------------------
# Attack Vectors and Threats
#-----------------------------------------------------------------------------

:SecurityThreat rdf:type owl:Class ;
    rdfs:label "Security Threat"@en ;
    skos:definition "A potential attack or vulnerability affecting wallet security."@en ;
    zt:educationalLevel zt:Intermediate .

:PhishingAttack rdf:type owl:Class ;
    rdfs:subClassOf :SecurityThreat ;
    rdfs:label "Phishing Attack"@en ;
    skos:definition """Social engineering attack tricking users into revealing 
        seed phrases or signing malicious transactions."""@en ;
    zt:educationalLevel zt:Beginner .

:SupplyChainAttack rdf:type owl:Class ;
    rdfs:subClassOf :SecurityThreat ;
    rdfs:label "Supply Chain Attack"@en ;
    skos:definition """Attack compromising hardware wallets during manufacturing, 
        shipping, or distribution before reaching the user."""@en ;
    zt:educationalLevel zt:Intermediate .

:AddressReuseRisk rdf:type owl:Class ;
    rdfs:subClassOf :SecurityThreat ;
    rdfs:label "Address Reuse Risk"@en ;
    skos:definition """Privacy and security risks from using the same address 
        for multiple transactions, enabling transaction linkage."""@en ;
    zt:educationalLevel zt:Intermediate .

:SeedPhraseExposure rdf:type owl:Class ;
    rdfs:subClassOf :SecurityThreat ;
    rdfs:label "Seed Phrase Exposure"@en ;
    skos:definition """Risk of seed phrase being photographed, observed, or 
        stored insecurely, leading to complete fund loss."""@en ;
    zt:educationalLevel zt:Beginner .

#=============================================================================
# PART 5: OBJECT PROPERTIES
#=============================================================================

#-----------------------------------------------------------------------------
# Wallet-Key Relationships
#-----------------------------------------------------------------------------

:containsKey rdf:type owl:ObjectProperty ;
    rdfs:domain :Wallet ;
    rdfs:range :CryptographicKey ;
    rdfs:label "contains key"@en ;
    skos:definition "Relates a wallet to the cryptographic keys it manages."@en .

:hasMasterSeed rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :containsKey ;
    rdfs:domain :HierarchicalDeterministicWallet ;
    rdfs:range :MasterSeed ;
    rdfs:label "has master seed"@en ;
    skos:definition "Relates an HD wallet to its root seed."@en .

:hasMasterKey rdf:type owl:ObjectProperty ;
    rdfs:domain :HierarchicalDeterministicWallet ;
    rdfs:range :MasterKey ;
    rdfs:label "has master key"@en ;
    skos:definition "Relates an HD wallet to its master extended key."@en .

:derivesFrom rdf:type owl:ObjectProperty ;
    rdfs:domain :DerivedKey ;
    rdfs:range :ExtendedKey ;
    rdfs:label "derives from"@en ;
    skos:definition "Relates a derived key to its parent extended key."@en ;
    owl:inverseOf :derivesChild .

:derivesChild rdf:type owl:ObjectProperty ;
    rdfs:domain :ExtendedKey ;
    rdfs:range :DerivedKey ;
    rdfs:label "derives child"@en ;
    skos:definition "Relates a parent key to its derived child keys."@en ;
    owl:inverseOf :derivesFrom .

#-----------------------------------------------------------------------------
# Derivation Path Properties
#-----------------------------------------------------------------------------

:hasDerivationPath rdf:type owl:ObjectProperty ;
    rdfs:domain :DerivedKey ;
    rdfs:range :DerivationPath ;
    rdfs:label "has derivation path"@en ;
    skos:definition "Relates a derived key to its full derivation path."@en .

:followsPath rdf:type owl:ObjectProperty ;
    rdfs:domain :Wallet ;
    rdfs:range :DerivationPath ;
    rdfs:label "follows path"@en ;
    skos:definition "Indicates the derivation path convention used by a wallet."@en .

#-----------------------------------------------------------------------------
# Standards and Implementation
#-----------------------------------------------------------------------------

:implementsStandard rdf:type owl:ObjectProperty ;
    rdfs:domain :Wallet ;
    rdfs:range bip:BIPStandard ;
    rdfs:label "implements standard"@en ;
    skos:definition "Relates a wallet to the BIP standards it implements."@en .

:usesSignatureScheme rdf:type owl:ObjectProperty ;
    rdfs:domain :Wallet ;
    rdfs:range :SignatureScheme ;
    rdfs:label "uses signature scheme"@en ;
    skos:definition "Indicates the cryptographic signature scheme used."@en .

#-----------------------------------------------------------------------------
# Security Properties
#-----------------------------------------------------------------------------

:hasSecurityFeature rdf:type owl:ObjectProperty ;
    rdfs:domain :Wallet ;
    rdfs:range :SecurityFeature ;
    rdfs:label "has security feature"@en ;
    skos:definition "Relates a wallet to its security mechanisms."@en .

:hasGuardian rdf:type owl:ObjectProperty ;
    rdfs:domain :SocialRecoveryWallet ;
    rdfs:range :Guardian ;
    rdfs:label "has guardian"@en ;
    skos:definition "Relates a social recovery wallet to its designated guardians."@en .

:supportsRecovery rdf:type owl:ObjectProperty ;
    rdfs:domain :Wallet ;
    rdfs:range :RecoveryMechanism ;
    rdfs:label "supports recovery"@en ;
    skos:definition "Indicates recovery mechanisms supported by the wallet."@en .

:vulnerableTo rdf:type owl:ObjectProperty ;
    rdfs:domain :Wallet ;
    rdfs:range :SecurityThreat ;
    rdfs:label "vulnerable to"@en ;
    skos:definition "Relates a wallet type to security threats it may face."@en .

#-----------------------------------------------------------------------------
# Address Properties
#-----------------------------------------------------------------------------

:generatesAddress rdf:type owl:ObjectProperty ;
    rdfs:domain :Wallet ;
    rdfs:range :BlockchainAddress ;
    rdfs:label "generates address"@en ;
    skos:definition "Relates a wallet to the addresses it can generate."@en .

:supportsAddressType rdf:type owl:ObjectProperty ;
    rdfs:domain :Wallet ;
    rdfs:range :BlockchainAddress ;
    rdfs:label "supports address type"@en ;
    skos:definition "Indicates address formats supported by the wallet."@en .

#-----------------------------------------------------------------------------
# Transaction Properties
#-----------------------------------------------------------------------------

:signsTransaction rdf:type owl:ObjectProperty ;
    rdfs:domain :Wallet ;
    rdfs:range :Transaction ;
    rdfs:label "signs transaction"@en ;
    skos:definition "Relates a wallet to transactions it can sign."@en .

:requiresSignatures rdf:type owl:ObjectProperty ;
    rdfs:domain :MultisigWallet ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "requires signatures"@en ;
    skos:definition "The minimum number of signatures required (M in M-of-N)."@en .

#-----------------------------------------------------------------------------
# Blockchain Properties
#-----------------------------------------------------------------------------

:supportsBlockchain rdf:type owl:ObjectProperty ;
    rdfs:domain :Wallet ;
    rdfs:range :Blockchain ;
    rdfs:label "supports blockchain"@en ;
    skos:definition "Indicates blockchains compatible with the wallet."@en .

#=============================================================================
# PART 6: DATA PROPERTIES
#=============================================================================

:seedPhrase rdf:type owl:DatatypeProperty ;
    rdfs:domain :Mnemonic ;
    rdfs:range xsd:string ;
    rdfs:label "seed phrase"@en ;
    skos:definition "The space-separated mnemonic words encoding the seed."@en .

:wordCount rdf:type owl:DatatypeProperty ;
    rdfs:domain :Mnemonic ;
    rdfs:range xsd:integer ;
    rdfs:label "word count"@en ;
    skos:definition "Number of words in the mnemonic (12, 15, 18, 21, or 24)."@en .

:entropyBits rdf:type owl:DatatypeProperty ;
    rdfs:domain :Seed ;
    rdfs:range xsd:integer ;
    rdfs:label "entropy bits"@en ;
    skos:definition "The entropy size in bits (128, 160, 192, 224, or 256)."@en .

:pathString rdf:type owl:DatatypeProperty ;
    rdfs:domain :DerivationPath ;
    rdfs:range xsd:string ;
    rdfs:label "path string"@en ;
    skos:definition "String representation of derivation path (e.g., m/44'/0'/0'/0/0)."@en .

:derivationIndex rdf:type owl:DatatypeProperty ;
    rdfs:domain :PathComponent ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "derivation index"@en ;
    skos:definition "The numeric index for this level of derivation."@en .

:isHardened rdf:type owl:DatatypeProperty ;
    rdfs:domain :PathComponent ;
    rdfs:range xsd:boolean ;
    rdfs:label "is hardened"@en ;
    skos:definition "Whether this derivation level uses hardened derivation."@en .

:addressString rdf:type owl:DatatypeProperty ;
    rdfs:domain :BlockchainAddress ;
    rdfs:range xsd:string ;
    rdfs:label "address string"@en ;
    skos:definition "The human-readable address string."@en .

:publicKeyHex rdf:type owl:DatatypeProperty ;
    rdfs:domain :PublicKey ;
    rdfs:range xsd:hexBinary ;
    rdfs:label "public key hex"@en ;
    skos:definition "Hexadecimal representation of the public key."@en .

:signatureThreshold rdf:type owl:DatatypeProperty ;
    rdfs:domain :MultisigWallet ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "signature threshold"@en ;
    skos:definition "Minimum signatures required (M in M-of-N configuration)."@en .

:totalSigners rdf:type owl:DatatypeProperty ;
    rdfs:domain :MultisigWallet ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "total signers"@en ;
    skos:definition "Total number of possible signers (N in M-of-N configuration)."@en .

:guardianThreshold rdf:type owl:DatatypeProperty ;
    rdfs:domain :SocialRecoveryWallet ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "guardian threshold"@en ;
    skos:definition "Minimum guardians required for recovery approval."@en .

:totalGuardians rdf:type owl:DatatypeProperty ;
    rdfs:domain :SocialRecoveryWallet ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "total guardians"@en ;
    skos:definition "Total number of designated guardians."@en .

:dailySpendingLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain :Wallet ;
    rdfs:range xsd:decimal ;
    rdfs:label "daily spending limit"@en ;
    skos:definition "Maximum amount that can be spent per day without additional approval."@en .


#=============================================================================
# PART 7: DISJOINTNESS AXIOMS (OQC Requirement: ≥50 axioms)
#=============================================================================

# Wallet Type Disjointness
:NondeterministicWallet owl:disjointWith :DeterministicWallet .
:SoftwareWallet owl:disjointWith :HardwareWallet, :PaperWallet .
:HardwareWallet owl:disjointWith :PaperWallet .
:DesktopWallet owl:disjointWith :MobileWallet, :WebWallet, :BrowserExtensionWallet .
:MobileWallet owl:disjointWith :WebWallet, :BrowserExtensionWallet .
:WebWallet owl:disjointWith :BrowserExtensionWallet .
:CustodialWebWallet owl:disjointWith :NonCustodialWebWallet .
:iOSWallet owl:disjointWith :AndroidWallet .
:FullNodeWallet owl:disjointWith :SPVWallet .
:AirGappedWallet owl:disjointWith :USBConnectedWallet .
:SingleKeyPaperWallet owl:disjointWith :BIP38EncryptedPaperWallet .
:HierarchicalDeterministicWallet owl:disjointWith :SequentialDeterministicWallet .
:HardenedKey owl:disjointWith :NormalKey .

# Key Type Disjointness
:PrivateKey owl:disjointWith :PublicKey .
:ExtendedPrivateKey owl:disjointWith :ExtendedPublicKey .

# Address Type Disjointness
:P2PKHAddress owl:disjointWith :P2SHAddress, :Bech32Address, :TaprootAddress .
:P2SHAddress owl:disjointWith :Bech32Address, :TaprootAddress .
:Bech32Address owl:disjointWith :TaprootAddress .

# Signature Scheme Disjointness
:ECDSASignature owl:disjointWith :SchnorrSignature, :ThresholdSignature .
:SchnorrSignature owl:disjointWith :ThresholdSignature .

# Recovery Mechanism Disjointness
:SeedPhraseRecovery owl:disjointWith :SocialRecovery, :CloudBackupRecovery .
:SocialRecovery owl:disjointWith :CloudBackupRecovery .

# Smart Contract Wallet Types
:MultisigWallet owl:disjointWith :SocialRecoveryWallet .
:SocialRecoveryWallet owl:disjointWith :AccountAbstractionWallet .

# Security Feature Disjointness
:SecureElement owl:disjointWith :PINProtection, :DuressWallet .
:BiometricAuthentication owl:disjointWith :TwoFactorAuthentication .

# Derivation Path Level Disjointness
:PurposeLevel owl:disjointWith :CoinTypeLevel, :AccountLevel, :ChangeLevel, :AddressIndexLevel .
:CoinTypeLevel owl:disjointWith :AccountLevel, :ChangeLevel, :AddressIndexLevel .
:AccountLevel owl:disjointWith :ChangeLevel, :AddressIndexLevel .
:ChangeLevel owl:disjointWith :AddressIndexLevel .

# Security Threat Disjointness
:PhishingAttack owl:disjointWith :SupplyChainAttack, :AddressReuseRisk, :SeedPhraseExposure .
:SupplyChainAttack owl:disjointWith :AddressReuseRisk, :SeedPhraseExposure .
:AddressReuseRisk owl:disjointWith :SeedPhraseExposure .

#=============================================================================
# PART 8: DEFINED CLASSES (Complex Class Expressions)
#=============================================================================

# A secure hardware wallet has both secure element AND air-gapping
:SecureHardwareWallet rdf:type owl:Class ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :HardwareWallet
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasSecurityFeature ;
                owl:someValuesFrom :SecureElement
            ]
        )
    ] ;
    rdfs:label "Secure Hardware Wallet"@en ;
    skos:definition "A hardware wallet with secure element protection."@en .

# A full-featured HD wallet implements BIP-32, BIP-39, and BIP-44
:FullFeaturedHDWallet rdf:type owl:Class ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :HierarchicalDeterministicWallet
            [
                rdf:type owl:Restriction ;
                owl:onProperty :implementsStandard ;
                owl:hasValue bip:BIP32
            ]
            [
                rdf:type owl:Restriction ;
                owl:onProperty :implementsStandard ;
                owl:hasValue bip:BIP39
            ]
            [
                rdf:type owl:Restriction ;
                owl:onProperty :implementsStandard ;
                owl:hasValue bip:BIP44
            ]
        )
    ] ;
    rdfs:label "Full-Featured HD Wallet"@en .

# A Taproot-enabled wallet supports BIP-86 and Schnorr
:TaprootEnabledWallet rdf:type owl:Class ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Wallet
            [
                rdf:type owl:Restriction ;
                owl:onProperty :implementsStandard ;
                owl:hasValue bip:BIP86
            ]
            [
                rdf:type owl:Restriction ;
                owl:onProperty :usesSignatureScheme ;
                owl:someValuesFrom :SchnorrSignature
            ]
        )
    ] ;
    rdfs:label "Taproot-Enabled Wallet"@en .

# A guardian-protected wallet (social recovery with minimum guardians)
:GuardianProtectedWallet rdf:type owl:Class ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :SocialRecoveryWallet
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasGuardian ;
                owl:minCardinality "3"^^xsd:nonNegativeInteger
            ]
        )
    ] ;
    rdfs:label "Guardian-Protected Wallet"@en .

#=============================================================================
# PART 9: SHACL VALIDATION SHAPES
#=============================================================================

:HDWalletShape rdf:type sh:NodeShape ;
    sh:targetClass :HierarchicalDeterministicWallet ;
    rdfs:label "HD Wallet Validation Shape"@en ;
    sh:property [
        sh:path :hasMasterSeed ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class :MasterSeed ;
        sh:name "master seed"@en ;
        sh:message "HD wallet must have exactly one master seed"@en ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path :implementsStandard ;
        sh:minCount 1 ;
        sh:name "BIP standard"@en ;
        sh:message "HD wallet should implement at least one BIP standard"@en ;
        sh:severity sh:Warning
    ] .

:MnemonicShape rdf:type sh:NodeShape ;
    sh:targetClass :Mnemonic ;
    rdfs:label "Mnemonic Validation Shape"@en ;
    sh:property [
        sh:path :wordCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (12 15 18 21 24) ;
        sh:name "word count"@en ;
        sh:message "Mnemonic must have 12, 15, 18, 21, or 24 words"@en ;
        sh:severity sh:Violation
    ] .

:DerivationPathShape rdf:type sh:NodeShape ;
    sh:targetClass :DerivationPath ;
    rdfs:label "Derivation Path Validation Shape"@en ;
    sh:property [
        sh:path :pathString ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^m(/\\d+'?)+$" ;
        sh:name "path string"@en ;
        sh:message "Path must match BIP-32 format (e.g., m/44'/0'/0'/0/0)"@en ;
        sh:severity sh:Violation
    ] .

:MultisigWalletShape rdf:type sh:NodeShape ;
    sh:targetClass :MultisigWallet ;
    rdfs:label "Multisig Wallet Validation Shape"@en ;
    sh:property [
        sh:path :signatureThreshold ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
        sh:name "signature threshold"@en ;
        sh:message "Multisig must specify signature threshold"@en
    ] ;
    sh:property [
        sh:path :totalSigners ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 2 ;
        sh:name "total signers"@en ;
        sh:message "Multisig must have at least 2 signers"@en
    ] .

:SocialRecoveryWalletShape rdf:type sh:NodeShape ;
    sh:targetClass :SocialRecoveryWallet ;
    rdfs:label "Social Recovery Wallet Validation Shape"@en ;
    sh:property [
        sh:path :hasGuardian ;
        sh:minCount 1 ;
        sh:name "guardians"@en ;
        sh:message "Social recovery wallet must have at least one guardian"@en
    ] ;
    sh:property [
        sh:path :guardianThreshold ;
        sh:minCount 1 ;
        sh:name "guardian threshold"@en ;
        sh:message "Must specify guardian threshold for recovery"@en
    ] .

:AddressShape rdf:type sh:NodeShape ;
    sh:targetClass :BlockchainAddress ;
    rdfs:label "Blockchain Address Validation Shape"@en ;
    sh:property [
        sh:path :addressString ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 26 ;
        sh:maxLength 90 ;
        sh:name "address string"@en ;
        sh:message "Address must be valid length"@en
    ] .

#=============================================================================
# PART 10: COMPETENCY QUESTIONS AND SPARQL VERIFICATION QUERIES
#=============================================================================

:CompetencyQuestion rdf:type owl:Class ;
    rdfs:label "Competency Question"@en ;
    skos:definition "A question the ontology should be able to answer."@en .

:CQ001 rdf:type :CompetencyQuestion ;
    rdfs:label "CQ001: What types of wallets exist?"@en ;
    skos:definition "List all wallet type classifications in the ontology."@en ;
    :hasSPARQLQuery """
        SELECT DISTINCT ?walletType ?label WHERE {
            ?walletType rdfs:subClassOf* :Wallet .
            ?walletType rdfs:label ?label .
            FILTER(lang(?label) = 'en')
        } ORDER BY ?label
    """^^xsd:string .

:CQ002 rdf:type :CompetencyQuestion ;
    rdfs:label "CQ002: What is the difference between HD and JBOK wallets?"@en ;
    skos:definition "Compare deterministic vs nondeterministic key generation."@en ;
    :hasSPARQLQuery """
        SELECT ?type ?definition WHERE {
            VALUES ?type { :HierarchicalDeterministicWallet :NondeterministicWallet }
            ?type skos:definition ?definition .
        }
    """^^xsd:string .

:CQ003 rdf:type :CompetencyQuestion ;
    rdfs:label "CQ003: Which BIP standards define HD wallet derivation?"@en ;
    skos:definition "List BIP standards related to key derivation."@en ;
    :hasSPARQLQuery """
        SELECT ?bip ?label ?definition WHERE {
            ?bip a bip:BIPStandard ;
                 rdfs:label ?label ;
                 skos:definition ?definition .
            FILTER(CONTAINS(str(?label), 'HD') || 
                   CONTAINS(str(?label), 'Mnemonic') ||
                   CONTAINS(str(?label), 'Multi-Account'))
        }
    """^^xsd:string .

:CQ004 rdf:type :CompetencyQuestion ;
    rdfs:label "CQ004: What is the BIP-44 derivation path structure?"@en ;
    skos:definition "Describe the 5-level BIP-44 path hierarchy."@en ;
    :hasSPARQLQuery """
        SELECT ?level ?definition WHERE {
            ?level rdfs:subClassOf :PathComponent ;
                   skos:definition ?definition .
        }
    """^^xsd:string .

:CQ005 rdf:type :CompetencyQuestion ;
    rdfs:label "CQ005: What is hardened vs normal derivation?"@en ;
    skos:definition "Explain the security difference between hardened and normal keys."@en ;
    :hasSPARQLQuery """
        SELECT ?keyType ?definition ?scopeNote WHERE {
            VALUES ?keyType { :HardenedKey :NormalKey }
            ?keyType skos:definition ?definition .
            OPTIONAL { ?keyType skos:scopeNote ?scopeNote }
        }
    """^^xsd:string .

:CQ006 rdf:type :CompetencyQuestion ;
    rdfs:label "CQ006: What security features do hardware wallets provide?"@en ;
    :hasSPARQLQuery """
        SELECT ?feature ?definition WHERE {
            ?feature rdfs:subClassOf :SecurityFeature ;
                     skos:definition ?definition .
        }
    """^^xsd:string .

:CQ007 rdf:type :CompetencyQuestion ;
    rdfs:label "CQ007: How does social recovery work?"@en ;
    :hasSPARQLQuery """
        SELECT ?concept ?definition WHERE {
            VALUES ?concept { :SocialRecoveryWallet :Guardian :SocialRecovery }
            ?concept skos:definition ?definition .
        }
    """^^xsd:string .

:CQ008 rdf:type :CompetencyQuestion ;
    rdfs:label "CQ008: What is ERC-4337 account abstraction?"@en ;
    :hasSPARQLQuery """
        SELECT ?wallet ?definition ?note WHERE {
            ?wallet rdfs:subClassOf* :SmartContractWallet ;
                    skos:definition ?definition .
            OPTIONAL { ?wallet skos:scopeNote ?note }
        }
    """^^xsd:string .

:CQ009 rdf:type :CompetencyQuestion ;
    rdfs:label "CQ009: Compare MPC wallets vs multisig wallets"@en ;
    :hasSPARQLQuery """
        SELECT ?walletType ?definition WHERE {
            VALUES ?walletType { :MPCWallet :MultisigWallet }
            ?walletType skos:definition ?definition .
        }
    """^^xsd:string .

:CQ010 rdf:type :CompetencyQuestion ;
    rdfs:label "CQ010: What address types does Bitcoin support?"@en ;
    :hasSPARQLQuery """
        SELECT ?addressType ?label ?example WHERE {
            ?addressType rdfs:subClassOf :BlockchainAddress ;
                         rdfs:label ?label .
            OPTIONAL { ?addressType skos:example ?example }
        }
    """^^xsd:string .

:CQ011 rdf:type :CompetencyQuestion ;
    rdfs:label "CQ011: What are Taproot and Schnorr signatures?"@en ;
    :hasSPARQLQuery """
        SELECT ?concept ?definition WHERE {
            VALUES ?concept { :TaprootAddress :SchnorrSignature bip:BIP340 bip:BIP341 }
            ?concept skos:definition ?definition .
        }
    """^^xsd:string .

:CQ012 rdf:type :CompetencyQuestion ;
    rdfs:label "CQ012: What is an extended public key (xpub)?"@en ;
    :hasSPARQLQuery """
        SELECT ?definition ?scopeNote ?example WHERE {
            :ExtendedPublicKey skos:definition ?definition .
            OPTIONAL { :ExtendedPublicKey skos:scopeNote ?scopeNote }
            OPTIONAL { :ExtendedPublicKey skos:example ?example }
        }
    """^^xsd:string .

