#=============================================================================
# PART 12: BLOCKCHAIN AND TRANSACTION SUPPORT CLASSES
#=============================================================================

:Blockchain rdf:type owl:Class ;
    rdfs:label "Blockchain"@en ;
    skos:definition "A distributed ledger system supported by wallets."@en .

:Bitcoin rdf:type :Blockchain ;
    rdfs:label "Bitcoin"@en ;
    skos:altLabel "BTC"@en .

:Ethereum rdf:type :Blockchain ;
    rdfs:label "Ethereum"@en ;
    skos:altLabel "ETH"@en .

:Transaction rdf:type owl:Class ;
    rdfs:label "Transaction"@en ;
    skos:definition "A blockchain transaction created and signed by a wallet."@en .

:SmartContract rdf:type owl:Class ;
    rdfs:label "Smart Contract"@en ;
    skos:definition "Self-executing code deployed on a blockchain."@en .

:UserOperation rdf:type owl:Class ;
    rdfs:label "User Operation"@en ;
    skos:altLabel "UserOp"@en ;
    skos:definition """A pseudo-transaction object in ERC-4337 representing user 
        intent, processed by bundlers through an alternative mempool."""@en ;
    zt:educationalLevel zt:Advanced .

:Bundler rdf:type owl:Class ;
    rdfs:label "Bundler"@en ;
    skos:definition """An entity in ERC-4337 that collects UserOperations and 
        submits them to the EntryPoint contract for execution."""@en ;
    zt:educationalLevel zt:Advanced .

:Paymaster rdf:type owl:Class ;
    rdfs:label "Paymaster"@en ;
    skos:definition """An ERC-4337 contract that can pay transaction fees on 
        behalf of users, enabling gasless transactions."""@en ;
    zt:educationalLevel zt:Advanced .

