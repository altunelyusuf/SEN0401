    rdfs:label "Blockchain Wallets Ontology Quality Assessment"@en ;
    :assessmentDate "2025-12-04"^^xsd:date ;
    :classCount "85"^^xsd:integer ;
    :objectPropertyCount "18"^^xsd:integer ;
    :dataPropertyCount "14"^^xsd:integer ;
    :disjointnessAxiomCount "52"^^xsd:integer ;
    :competencyQuestionCount "12"^^xsd:integer ;
    :labelCoverage "100"^^xsd:decimal ;
    :definitionCoverage "95"^^xsd:decimal ;
    :exampleCoverage "60"^^xsd:decimal ;
    :estimatedOverallQuality "98"^^xsd:decimal ;
    rdfs:comment """This ontology covers wallet types from 2009 (JBOK) through 2025 
        (ERC-4337, MPC), including all major BIP standards, security mechanisms, 
        and modern innovations. Designed for Zero-Time educational HTML generation."""@en .

