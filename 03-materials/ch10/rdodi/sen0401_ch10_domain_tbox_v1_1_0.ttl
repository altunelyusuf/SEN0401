chx:signalledByServiceBit a owl:ObjectProperty ; rdfs:label "signalled by service bit"@en ; rdfs:domain chx:NodeKinds ; rdfs:range chx:ServiceBitsOfNetwork ; kb:hasRelationshipCategory kb:RelationshipCategory_Characterization ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "A kind of node tells which history it keeps by a bit of the services field that every node sends in its version message."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:countedInCensus a owl:ObjectProperty ; rdfs:label "counted in the census"@en ; rdfs:domain chx:AnonymityNetworks ; rdfs:range chx:ReachableNodesToday ; kb:hasRelationshipCategory kb:RelationshipCategory_ContainmentMembership ; rdfs:subPropertyOf <http://purl.org/dc/terms/isPartOf> ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The nodes that are reached through an overlay network are among the nodes counted by the Bitnodes census."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:precedesFeefilter a owl:ObjectProperty ; rdfs:label "comes before the feefilter of"@en ; rdfs:domain chx:HandshakeMessageOrder ; rdfs:range chx:FeefilterHonoured ; kb:hasRelationshipCategory kb:RelationshipCategory_SuccessionTransformation ; rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000063> ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "In the order of messages of a new connection the feefilter message comes after the verack that ends the handshake."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:precedesWtxidAnnouncement a owl:ObjectProperty ; rdfs:label "comes before the announcement by wtxid of"@en ; rdfs:domain chx:HandshakeMessageOrder ; rdfs:range chx:TxAnnouncementByWtxid ; kb:hasRelationshipCategory kb:RelationshipCategory_SuccessionTransformation ; rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000063> ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The wtxidrelay message must be sent before verack, and only after both sides sent it are transactions announced by their wtxid."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:precedesCompactBlockMode a owl:ObjectProperty ; rdfs:label "comes before the choice of compact block mode of"@en ; rdfs:domain chx:HandshakeMessageOrder ; rdfs:range chx:HighAndLowBandwidthModes ; kb:hasRelationshipCategory kb:RelationshipCategory_SuccessionTransformation ; rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000063> ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The sendcmpct message, with which a peer picks high or low bandwidth mode, follows the verack of the handshake."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:precedesHeadersRequest a owl:ObjectProperty ; rdfs:label "comes before the request for headers of"@en ; rdfs:domain chx:HandshakeMessageOrder ; rdfs:range chx:HeadersBatchOf2000 ; kb:hasRelationshipCategory kb:RelationshipCategory_SuccessionTransformation ; rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000063> ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The getheaders message, with which a new node asks for the chain, follows the verack of the handshake."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:relayNetworkPrecedesCompactBlocks a owl:ObjectProperty ; rdfs:label "came before the compact blocks of"@en ; rdfs:domain chx:RelayNetworkHistory ; rdfs:range chx:CompactBlocksYear ; kb:hasRelationshipCategory kb:RelationshipCategory_SuccessionTransformation ; rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000063> ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The private relay network of miners was in use in 2015, before compact blocks were assigned their BIP in 2016."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:requiresProtocolVersion a owl:ObjectProperty ; rdfs:label "needs the protocol version of"@en ; rdfs:domain chx:Addrv2Networks ; rdfs:range chx:ProtocolVersionNumber ; kb:hasRelationshipCategory kb:RelationshipCategory_Requirement ; rdfs:subPropertyOf <http://purl.org/dc/terms/requires> ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The addrv2 message of BIP 155 builds on the protocol version 70016 that the version message carries."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:buildsOnCompactBlocks a owl:ObjectProperty ; rdfs:label "builds on the compact blocks of"@en ; rdfs:domain chx:ForwardErrorCorrectionDemo ; rdfs:range chx:ShortIdsAreSixBytes ; kb:hasRelationshipCategory kb:RelationshipCategory_Requirement ; rdfs:subPropertyOf <http://purl.org/dc/terms/requires> ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The relay system FIBRE sends compact blocks over UDP with forward error correction, so it needs compact blocks."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:buildsOnMerklePath a owl:ObjectProperty ; rdfs:label "builds on the Merkle path of"@en ; rdfs:domain chx:MerkleblockForOneMatch ; rdfs:range chx:MerklePathProof ; kb:hasRelationshipCategory kb:RelationshipCategory_Requirement ; rdfs:subPropertyOf <http://purl.org/dc/terms/requires> ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The merkleblock message that answers a loaded filter carries the partial Merkle tree whose path the light client checks against the root in the header."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:buildsOnHeaderChain a owl:ObjectProperty ; rdfs:label "builds on the header chain checks of"@en ; rdfs:domain chx:HeaderChainSize ; rdfs:range chx:HeaderChainLinks ; kb:hasRelationshipCategory kb:RelationshipCategory_Requirement ; rdfs:subPropertyOf <http://purl.org/dc/terms/requires> ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "A light client that keeps only the headers relies on the checks that a chain of headers can be verified without any block."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:usesWtxidAnnouncement a owl:ObjectProperty ; rdfs:label "takes part in the announcement by wtxid of"@en ; rdfs:domain chx:OrphanWaitsForParent ; rdfs:range chx:TxAnnouncementByWtxid ; kb:hasRelationshipCategory kb:RelationshipCategory_Participation ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "A node that meets an orphan asks for it by the wtxid in an inv entry of type 5, which is the announcement that BIP 339 introduced."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:requiresAddressExchange a owl:ObjectProperty ; rdfs:label "needs the address exchange of"@en ; rdfs:domain chx:ConnectionTypes ; rdfs:range chx:AddrGossipFormat ; kb:hasRelationshipCategory kb:RelationshipCategory_Requirement ; rdfs:subPropertyOf <http://purl.org/dc/terms/requires> ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "An addr-fetch connection exists only to ask for addresses with getaddr and to leave, so it needs the address exchange."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:plaintextFramedBy a owl:ObjectProperty ; rdfs:label "is framed as described in"@en ; rdfs:domain chx:PlaintextV1 ; rdfs:range chx:MessageFraming ; kb:hasRelationshipCategory kb:RelationshipCategory_Requirement ; rdfs:subPropertyOf <http://purl.org/dc/terms/requires> ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The plain transport sends every message with the frame of magic bytes, command, length and checksum that the old transport defines."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:shortensBlockRace a owl:ObjectProperty ; rdfs:label "is a means to shorten the race of"@en ; rdfs:domain chx:CompactBlocks ; rdfs:range chx:BlockFindingRaceProbability ; kb:hasRelationshipCategory kb:RelationshipCategory_Intentional ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "Faster relay of blocks, which compact blocks achieve, lowers the chance that a rival block is found while a block travels."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:replacesBloomFilter a owl:ObjectProperty ; rdfs:label "replaces the Bloom filter of"@en ; rdfs:domain chx:BasicFilterParameters ; rdfs:range chx:BloomFilterWireFormat ; kb:hasRelationshipCategory kb:RelationshipCategory_Versioning ; rdfs:subPropertyOf <http://purl.org/dc/terms/replaces> ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The basic block filter of BIP 158 replaced the Bloom filter of BIP 37 as the way for a light client to find its transactions."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:contrastsWithBloomPrivacy a owl:ObjectProperty ; rdfs:label "differs in privacy from"@en ; rdfs:domain chx:FilterFalsePositiveRate ; rdfs:range chx:BloomDisabledByDefault ; kb:hasRelationshipCategory kb:RelationshipCategory_Comparative ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "A false positive of a block filter costs only the download of a block and reveals no address, whereas a Bloom filter gave the node a view of the addresses of the wallet."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:sharesSipHashWith a owl:ObjectProperty ; rdfs:label "shares its hash function with"@en ; rdfs:domain chx:BasicFilterParameters ; rdfs:range chx:ShortIdsAreSixBytes ; kb:hasRelationshipCategory kb:RelationshipCategory_Comparative ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The basic filter and the short ids of a compact block are both computed with SipHash-2-4, and one reference value of its paper checks both."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:guardsMemoryLike a owl:ObjectProperty ; rdfs:label "guards the memory in the way of"@en ; rdfs:domain chx:HeadersPresync ; rdfs:range chx:OrphanageLimits ; kb:hasRelationshipCategory kb:RelationshipCategory_Comparative ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "Both protect the memory of a node against an attacker who floods it with data that never becomes valid."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:withholdsTransactionsLike a owl:ObjectProperty ; rdfs:label "withholds transactions in the way of"@en ; rdfs:domain chx:FeefilterHonoured ; rdfs:range chx:RelayFlagSilencesTransactions ; kb:hasRelationshipCategory kb:RelationshipCategory_Comparative ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "Both are ways in which a peer limits which transactions it is told about, and one run tested them together on three peers."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:isLocalViewLike a owl:ObjectProperty ; rdfs:label "is a local view in the way of"@en ; rdfs:domain chx:MempoolIsLocalUtxoIsShared ; rdfs:range chx:OrphanWaitsForParent ; kb:hasRelationshipCategory kb:RelationshipCategory_Comparative ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The mempool and the orphan pool are both a local view of one node and may differ from node to node."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:motivatesAddrv2 a owl:ObjectProperty ; rdfs:label "is the reason for"@en ; rdfs:domain chx:FiveNetworks ; rdfs:range chx:Addrv2Networks ; kb:hasRelationshipCategory kb:RelationshipCategory_Causal ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "Each of the five networks has its own address format, which is why addrv2 was invented."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:mitigatesRoutingAttack a owl:ObjectProperty ; rdfs:label "helps to defend against the routing attack"@en ; rdfs:domain chx:FiveNetworks ; rdfs:range chx:RoutingAttack ; kb:hasRelationshipCategory kb:RelationshipCategory_Causal ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "Encryption does not help against a route that is dropped, whereas peers from different networks, such as Tor, do."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:mitigatesEclipseAttack a owl:ObjectProperty ; rdfs:label "helps to defend against the eclipse attack"@en ; rdfs:domain chx:ConnectionTypes ; rdfs:range chx:EclipseAttack ; kb:hasRelationshipCategory kb:RelationshipCategory_Causal ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The two block-relay-only connections are part of the answer to the eclipse attack, since transaction gossip does not show them."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:isBaseOfConnectionType a owl:ObjectProperty ; rdfs:label "is the base of the connection types of"@en ; rdfs:domain chx:RelayFlagSilencesTransactions ; rdfs:range chx:ConnectionTypes ; kb:hasRelationshipCategory kb:RelationshipCategory_Causal ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The relay flag set to false is the base of the block-relay-only connections of Bitcoin Core."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:ranOverTransport a owl:ObjectProperty ; rdfs:label "ran over the transport of"@en ; rdfs:domain chx:ConnectionTypes ; rdfs:range chx:PlaintextV1 ; kb:hasRelationshipCategory kb:RelationshipCategory_Characterization ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "In the run the block-relay-only connection spoke the old plaintext transport."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
