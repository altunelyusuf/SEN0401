#################################################################
# Connectedness repair (discipline v2.19.0, BP-D56 and BP-D57), 2026-10-19.
# The datatype properties the A-Box uses and nothing declared, then the relations
# between the chapter's subject branches that the chapter's own sources state.
#################################################################
chx:input a owl:DatatypeProperty ; rdfs:label "input expression"@en ; rdfs:comment "The expression an input/output example evaluates."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:output a owl:DatatypeProperty ; rdfs:label "output value"@en ; rdfs:comment "The value that evaluating the example expression gives."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:countsBloomNodes a owl:ObjectProperty ; rdfs:label "counts the nodes of"@en ;
    rdfs:comment "The census counts 4,308 nodes that advertise the BLOOM bit. Basis: the chapter says of Service bits of network: '4,308 with BLOOM'; the chapter says of Bloom disabled by default: 'only 4,308 of 25,361 nodes of the census advertise the bit'."@en ;
    rdfs:domain chx:ServiceBitsOfNetwork ; rdfs:range chx:BloomDisabledByDefault ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:countsCompactFilterNodes a owl:ObjectProperty ; rdfs:label "counts the nodes of"@en ;
    rdfs:comment "The census counts 7,905 nodes that advertise COMPACT_FILTERS. Basis: the chapter says of Service bits of network: '7,905 with COMPACT_FILTERS'; the chapter says of Block filters over the peer-to-peer network: '7,905 nodes of the census advertise the bit'."@en ;
    rdfs:domain chx:ServiceBitsOfNetwork ; rdfs:range chx:FiltersOverP2P ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:countsV2Nodes a owl:ObjectProperty ; rdfs:label "counts the nodes of"@en ;
    rdfs:comment "The census counts 21,768 nodes that advertise P2P_V2, 85.8 percent of all nodes. Basis: the chapter says of Service bits of network: '21,768 with P2P_V2'; the chapter says of Default history of the v2 transport: '85.8 percent of the nodes of the census advertise P2P_V2'."@en ;
    rdfs:domain chx:ServiceBitsOfNetwork ; rdfs:range chx:V2DefaultHistory ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:sizesHeaders a owl:ObjectProperty ; rdfs:label "is the total size of"@en ;
    rdfs:comment "The header chain total counts the 80-byte headers that each point at their predecessor. Basis: the chapter says of Header chain size: 'the 80-byte headers total 77.7 megabytes'; the chapter says of Header chain links: 'each header is 80 bytes'."@en ;
    rdfs:domain chx:HeaderChainSize ; rdfs:range chx:HeaderChainLinks ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:prefillsBecauseNotInMempool a owl:ObjectProperty ; rdfs:label "is prefilled because of"@en ;
    rdfs:comment "The coinbase is prefilled in a compact block because no peer can have it in its mempool, and a mempool is local to its node. Basis: the chapter says of Coinbase is prefilled: 'because no peer can have it in its mempool'; the chapter says of The mempool is local, the UTXO set is shared: 'Two connected nodes held 6 and 0 transactions in their mempools'."@en ;
    rdfs:domain chx:CoinbaseIsPrefilled ; rdfs:range chx:MempoolIsLocalUtxoIsShared ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:needsVersion70016 a owl:ObjectProperty ; rdfs:label "is needed for"@en ;
    rdfs:comment "Wtxid relay needs protocol version 70016. Basis: the chapter says of Protocol version number: 'wtxid relay needs 70016 too'; the chapter says of Transaction announcement by wtxid: 'With wtxid relay the transactions were announced with inv entries of type 5'."@en ;
    rdfs:domain chx:ProtocolVersionNumber ; rdfs:range chx:TxAnnouncementByWtxid ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:negotiatesWtxidRelay a owl:ObjectProperty ; rdfs:label "negotiates"@en ;
    rdfs:comment "The handshake has the node send the wtxidrelay feature message. Basis: the chapter says of Handshake message order: 'the feature messages wtxidrelay and sendaddrv2'; the chapter says of Transaction announcement by wtxid: 'With wtxid relay the transactions were announced with inv entries of type 5'."@en ;
    rdfs:domain chx:HandshakeMessageOrder ; rdfs:range chx:TxAnnouncementByWtxid ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:sendsFeefilter a owl:ObjectProperty ; rdfs:label "sends"@en ;
    rdfs:comment "After verack the node sends a feefilter message. Basis: the chapter says of Handshake message order: 'after verack it sends sendcmpct, ping, getheaders, inv and feefilter'; the chapter says of Feefilter honoured: 'A peer that sent feefilter for 5,000 satoshis per kilovirtual byte'."@en ;
    rdfs:domain chx:HandshakeMessageOrder ; rdfs:range chx:FeefilterHonoured ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:hidesMagicOf a owl:ObjectProperty ; rdfs:label "hides the magic of"@en ;
    rdfs:comment "On the v2 transport neither the magic nor the word version appears in the stream. Basis: the chapter says of Encrypted v2 transport (BIP 324): 'neither the magic nor the word version appears in the stream'; the chapter says of Message framing: 'Every message starts with a 24-byte header of magic, command, length and checksum'."@en ;
    rdfs:domain chx:EncryptedV2 ; rdfs:range chx:MessageFraming ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:addsNetworks a owl:ObjectProperty ; rdfs:label "adds the networks of"@en ;
    rdfs:comment "BIP 155 adds TORV3, I2P and CJDNS entries to address messages. Basis: the chapter says of Addrv2 networks (BIP 155): 'BIP 155 adds TORV3, I2P and CJDNS entries'; the chapter says of I2P and CJDNS: 'Support for I2P came in release 22.0 and for CJDNS in 23.0'."@en ;
    rdfs:domain chx:Addrv2Networks ; rdfs:range chx:I2pAndCjdns ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:countsOnionNodes a owl:ObjectProperty ; rdfs:label "is counted in"@en ;
    rdfs:comment "12,488 nodes of the census are onion addresses. Basis: the chapter says of Tor hidden service: '12,488 nodes of the census are onion addresses'; the chapter says of Reachable nodes today: '12,488 are onion services'."@en ;
    rdfs:domain chx:TorHiddenService ; rdfs:range chx:ReachableNodesToday ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:countsI2pNodes a owl:ObjectProperty ; rdfs:label "is counted in"@en ;
    rdfs:comment "The census holds 4,208 I2P nodes and one CJDNS node. Basis: the chapter says of I2P and CJDNS: 'the census holds 4,208 I2P nodes and one CJDNS node'; the chapter says of Reachable nodes today: '4,208 I2P'."@en ;
    rdfs:domain chx:I2pAndCjdns ; rdfs:range chx:ReachableNodesToday ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:introducesAsSatoshi a owl:ObjectProperty ; rdfs:label "introduces itself in"@en ;
    rdfs:comment "The node answered an equal peer with its version message carrying the user agent /Satoshi:31.1.0/. Basis: the chapter says of Peers are equal: 'the node answered with its version message as /Satoshi:31.1.0/'; the chapter says of Version message fields: 'the user agent /Satoshi:31.1.0/'."@en ;
    rdfs:domain chx:PeersAreEqual ; rdfs:range chx:VersionMessageFields ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:advertisesServicesInVersion a owl:ObjectProperty ; rdfs:label "advertises services in"@en ;
    rdfs:comment "A full archival node advertises the services value 3081, which the version message of the test node carries. Basis: the chapter says of Archival node services: 'advertises the services value 3081'; the chapter says of Version message fields: 'services 3081'."@en ;
    rdfs:domain chx:ArchivalNodeServices ; rdfs:range chx:VersionMessageFields ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
chx:advertisesPrunedServicesInVersion a owl:ObjectProperty ; rdfs:label "advertises services in"@en ;
    rdfs:comment "A pruned node advertises its services in both its networkinfo and its version message. Basis: the chapter says of Pruned node services: 'in both its networkinfo and its version message'."@en ;
    rdfs:domain chx:PrunedNodeServices ; rdfs:range chx:VersionMessageFields ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> .
