chx:input a owl:DatatypeProperty ; rdfs:label "input"@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The Python expression of an input-output example, as text that the checks execute."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:output a owl:DatatypeProperty ; rdfs:label "output"@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch10/tbox> ; skos:definition "The value that the input of an input-output example evaluates to, as text."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
