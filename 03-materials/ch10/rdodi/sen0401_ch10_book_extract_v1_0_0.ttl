mbb:Concept_syncing_blockchain a mbb:Concept ; rdfs:label "syncing blockchain"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_007 ; mbb:indexSubentry "sync-blockchain" .
mbb:Concept_syncing_blockchain mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_syncing_blockchain .
mbb:Passage_ch10_syncing_blockchain a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes syncing blockchain"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "The first thing a full node will do once it connects to peers is try to construct a complete chain of block headers." ; mbb:sourceLine 446 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_bloom_filters a mbb:Concept ; rdfs:label "bloom filters"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_009 ; mbb:indexedIn mbb:Sec_ch10_010 ; mbb:indexedIn mbb:Sec_ch10_011 ; mbb:indexSubentry "lightweight clients and" ; mbb:indexSubentry "operational overview" .
mbb:Concept_bloom_filters mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_bloom_filters .
mbb:Passage_ch10_bloom_filters a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes bloom filters"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "A bloom filter is a probabilistic search filter, a way to describe a desired pattern without specifying it exactly." ; mbb:sourceLine 605 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_compact_block_filters a mbb:Concept ; rdfs:label "compact block filters"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_012 ; mbb:indexedIn mbb:Sec_ch10_013 ; mbb:indexedIn mbb:Sec_ch10_014 ; mbb:indexedIn mbb:Sec_ch10_015 ; mbb:indexedIn mbb:Sec_ch10_016 ; mbb:indexedIn mbb:Sec_ch10_017 ; mbb:indexSubentry "GCS (Golomb-Rice coded sets)" ; mbb:indexSubentry "compact-block-filter" ; mbb:indexSubentry "downloading multiple" ; mbb:indexSubentry "lossy encoding" ; mbb:indexSubentry "what to include" .
mbb:Concept_compact_block_filters mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_compact_block_filters .
mbb:Passage_ch10_compact_block_filters a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes compact block filters"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "An idea was posted to the Bitcoin-Dev mailing list by an anonymous developer in 2016 of reversing the bloom filter process." ; mbb:sourceLine 812 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_GCS_Golomb_Rice_coded_sets a mbb:Concept ; rdfs:label "GCS (Golomb-Rice coded sets)"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_013 ; mbb:indexSubentry "gcs-filter" .
mbb:Concept_GCS_Golomb_Rice_coded_sets mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_GCS_Golomb_Rice_coded_sets .
mbb:Passage_ch10_GCS_Golomb_Rice_coded_sets a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes GCS (Golomb-Rice coded sets)"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "Suppose that Alice wants to send a list of numbers to Bob." ; mbb:sourceLine 849 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_lossless_encoding a mbb:Concept ; rdfs:label "lossless encoding"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_013 .
mbb:Concept_lossless_encoding mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_lossless_encoding .
mbb:Passage_ch10_lossless_encoding a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes lossless encoding"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "That means we save space without losing any information, which is called lossless encoding." ; mbb:sourceLine 887 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
