mbb:Concept_compact_block_relay a mbb:Concept ; rdfs:label "compact block relay"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_003 ; mbb:indexSubentry "compact-block-relay" .
mbb:Concept_compact_block_relay mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_compact_block_relay .
mbb:Passage_ch10_compact_block_relay a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes compact block relay"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "When a miner finds a new block, they announce it to the Bitcoin network (which includes other miners)." ; mbb:sourceLine 88 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_mining a mbb:Concept ; rdfs:label "mining"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_003 ; mbb:indexedIn mbb:Sec_ch10_004 ; mbb:indexSubentry "blocks" .
mbb:Concept_block_finding_races a mbb:Concept ; rdfs:label "block-finding races"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_003 .
mbb:Concept_block_finding_races mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_block_finding_races .
mbb:Passage_ch10_block_finding_races a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes block-finding races"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "Whichever block has a second block built on top of it first wins (unless there's another near-tie), which is called a block-finding race and is illustrated in [mining_race]." ; mbb:sourceLine 100 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_low_bandwidth_mode_compact_block_relay a mbb:Concept ; rdfs:label "low-bandwidth mode (compact block relay)"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_003 .
mbb:Concept_low_bandwidth_mode_compact_block_relay mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_low_bandwidth_mode_compact_block_relay .
mbb:Passage_ch10_low_bandwidth_mode_compact_block_relay a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes low-bandwidth mode (compact block relay)"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "Low-bandwidth mode:: When your node requests that a peer use low-bandwidth mode (the default), that peer will tell your node the 32-byte identifier (header hash) of a new block but will not send your node any details about it." ; mbb:sourceLine 152 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_high_bandwidth_mode_compact_block_relay a mbb:Concept ; rdfs:label "high-bandwidth mode (compact block relay)"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_003 .
mbb:Concept_high_bandwidth_mode_compact_block_relay mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_high_bandwidth_mode_compact_block_relay .
mbb:Passage_ch10_high_bandwidth_mode_compact_block_relay a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes high-bandwidth mode (compact block relay)"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "High-bandwidth mode:: When your node requests that a peer use high-bandwidth mode, that peer will send your node a compact block for a new block even before it has fully verified that the block is valid." ; mbb:sourceLine 161 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_private_block_relay a mbb:Concept ; rdfs:label "private block relay"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_004 ; mbb:indexSubentry "private-block-relay" .
mbb:Concept_private_block_relay mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_private_block_relay .
mbb:Passage_ch10_private_block_relay a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes private block relay"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "Although compact blocks go a long way toward minimizing the time it takes for blocks to propagate across the network, it's possible to minimize latency further." ; mbb:sourceLine 191 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_FEC_Forward_Error_Correction a mbb:Concept ; rdfs:label "FEC (Forward Error Correction)"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_004 .
mbb:Concept_FEC_Forward_Error_Correction mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_FEC_Forward_Error_Correction .
mbb:Passage_ch10_FEC_Forward_Error_Correction a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes FEC (Forward Error Correction)"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "Another, more complex technique, is Forward Error Correction (FEC)." ; mbb:sourceLine 205 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_Forward_Error_Correction_FEC a mbb:Concept ; rdfs:label "Forward Error Correction (FEC)"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_004 .
