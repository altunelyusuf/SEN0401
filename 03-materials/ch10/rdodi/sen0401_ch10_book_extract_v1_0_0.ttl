mbb:Concept_Fast_Internet_Bitcoin_Relay_Engine_FIBRE mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_Fast_Internet_Bitcoin_Relay_Engine_FIBRE .
mbb:Passage_ch10_Fast_Internet_Bitcoin_Relay_Engine_FIBRE a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes Fast Internet Bitcoin Relay Engine (FIBRE)"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "The original Bitcoin Relay Network was replaced in 2016 with the introduction of the Fast Internet Bitcoin Relay Engine or FIBRE, also created by developer Matt Corallo." ; mbb:sourceLine 247 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_network_discovery a mbb:Concept ; rdfs:label "network discovery"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_005 ; mbb:indexSubentry "network-discovery" .
mbb:Concept_network_discovery mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_network_discovery .
mbb:Passage_ch10_network_discovery a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes network discovery"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "When a new node boots up, it must discover other Bitcoin nodes on the network in order to participate." ; mbb:sourceLine 256 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
