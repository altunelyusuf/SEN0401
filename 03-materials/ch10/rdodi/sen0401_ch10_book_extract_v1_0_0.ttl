mbb:Passage_ch10_Forward_Error_Correction_FEC a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes Forward Error Correction (FEC)"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "Another, more complex technique, is Forward Error Correction (FEC)." ; mbb:sourceLine 205 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_Bitcoin_Relay_Network a mbb:Concept ; rdfs:label "Bitcoin Relay Network"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_004 .
mbb:Concept_Bitcoin_Relay_Network mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_Bitcoin_Relay_Network .
mbb:Passage_ch10_Bitcoin_Relay_Network a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes Bitcoin Relay Network"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "The original Bitcoin Relay Network was created by developer Matt Corallo in 2015 to enable fast synchronization of blocks between miners with very low latency." ; mbb:sourceLine 239 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_FIBRE_Fast_Internet_Bitcoin_Relay_Engine a mbb:Concept ; rdfs:label "FIBRE (Fast Internet Bitcoin Relay Engine)"@en ; mbb:mentionedInPart mbb:Chapter_10 ; mbb:indexedIn mbb:Sec_ch10_004 .
mbb:Concept_FIBRE_Fast_Internet_Bitcoin_Relay_Engine mbb:introducedIn mbb:Chapter_10 ; mbb:introducedBy mbb:Passage_ch10_FIBRE_Fast_Internet_Bitcoin_Relay_Engine .
mbb:Passage_ch10_FIBRE_Fast_Internet_Bitcoin_Relay_Engine a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes FIBRE (Fast Internet Bitcoin Relay Engine)"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "The original Bitcoin Relay Network was replaced in 2016 with the introduction of the Fast Internet Bitcoin Relay Engine or FIBRE, also created by developer Matt Corallo." ; mbb:sourceLine 247 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
