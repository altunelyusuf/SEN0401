mbb:Passage_ch10_lossy_encoding a mbb:Passage ; rdfs:label "Where The Bitcoin Network first indexes lossy encoding"@en ; mbb:inPart mbb:Chapter_10 ; mbb:text "The data about the transactions in a block that we want to communicate is an output script." ; mbb:sourceLine 1079 ; mbb:sourceFile "ch10_network.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
