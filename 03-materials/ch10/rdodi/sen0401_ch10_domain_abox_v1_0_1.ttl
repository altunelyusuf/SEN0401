chx:X_PeersAreEqual a owl:NamedIndividual, chx:PeersAreEqual ; rdfs:label "a regtest node and a script that speak the same handshake"@en ; skos:definition "A script that knows nothing of Bitcoin Core except the wire format introduced itself to a Bitcoin Core 31.1 node as an equal: the node answered with its version message as /Satoshi:31.1.0/, then wtxidrelay, sendaddrv2 and verack, all framed with the magic bytes fabfb5da of the private test chain."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_PeersAreEqual a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); e = R['e1_handshake']; (e['node_version']['user_agent'], [c for t, c, n in e['sequence']][:4], e['magic']) evaluates to ('/Satoshi:31.1.0/', ['version', 'wtxidrelay', 'sendaddrv2', 'verack'], 'fabfb5da')"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); e = R['e1_handshake']; (e['node_version']['user_agent'], [c for t, c, n in e['sequence']][:4], e['magic'])" ; chx:output "('/Satoshi:31.1.0/', ['version', 'wtxidrelay', 'sendaddrv2', 'verack'], 'fabfb5da')" .
chx:X_PeersAreEqual rd:hasIOExample chx:IO_PeersAreEqual .
chx:X_ReachableNodesToday a owl:NamedIndividual, chx:ReachableNodesToday ; rdfs:label "the Bitnodes snapshot of 2026-10-15"@en ; skos:definition "The Bitnodes snapshot of 2026-10-15 lists 25,361 reachable nodes, of which 12,488 are onion services, 7,473 IPv4, 4,208 I2P, 1,191 IPv6 and 1 CJDNS, so 8,664 are reachable on the clearnet, while the book still speaks of about 10,000 listening nodes."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_ReachableNodesToday a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); b = L.bitnodes(); (b['total'], sorted(b['nets'].items()), b['nets']['ipv4'] + b['nets']['ipv6'], L.has('book_ch10_network.adoc', 'about 10,000', 'listening nodes')) evaluates to (25361, [('cjdns', 1), ('i2p', 4208), ('ipv4', 7473), ('ipv6', 1191), ('onion', 12488)], 8664, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); b = L.bitnodes(); (b['total'], sorted(b['nets'].items()), b['nets']['ipv4'] + b['nets']['ipv6'], L.has('book_ch10_network.adoc', 'about 10,000', 'listening nodes'))" ; chx:output "(25361, [('cjdns', 1), ('i2p', 4208), ('ipv4', 7473), ('ipv6', 1191), ('onion', 12488)], 8664, True)" .
chx:X_ReachableNodesToday rd:hasIOExample chx:IO_ReachableNodesToday .
chx:X_SoftwareShare a owl:NamedIndividual, chx:SoftwareShare ; rdfs:label "how many nodes run Bitcoin Core or Knots"@en ; skos:definition "Of the 25,361 reachable nodes, 25,278 (99.67 percent) report a /Satoshi: user agent, 4,083 of them Bitcoin Knots and 21,195 (83.57 percent of all) plain Bitcoin Core, the most common single agent being /Satoshi:31.1.0/ with 7,442 nodes; the book's remark that more than 95 percent of full nodes run Bitcoin Core is still true if Knots is counted as its fork."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_SoftwareShare a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); b = L.bitnodes(); (b['satoshi_prefix'], b['knots'], b['core_plain'], round(100 * b['satoshi_prefix'] / b['total'], 2), round(100 * b['core_plain'] / b['total'], 2), b['top_agent'], L.has('book_ch10_network.adoc', 'More than 95% of full nodes')) evaluates to (25278, 4083, 21195, 99.67, 83.57, ('/Satoshi:31.1.0/', 7442), True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); b = L.bitnodes(); (b['satoshi_prefix'], b['knots'], b['core_plain'], round(100 * b['satoshi_prefix'] / b['total'], 2), round(100 * b['core_plain'] / b['total'], 2), b['top_agent'], L.has('book_ch10_network.adoc', 'More than 95% of full nodes'))" ; chx:output "(25278, 4083, 21195, 99.67, 83.57, ('/Satoshi:31.1.0/', 7442), True)" .
chx:X_SoftwareShare rd:hasIOExample chx:IO_SoftwareShare .
chx:X_ServiceBitsOfNetwork a owl:NamedIndividual, chx:ServiceBitsOfNetwork ; rdfs:label "what the nodes of the census advertise"@en ; skos:definition "The service bits of the census count 22,402 nodes with NETWORK, 24,582 with WITNESS, 25,322 with NETWORK_LIMITED, 7,905 with COMPACT_FILTERS, 4,308 with BLOOM and 21,768 with P2P_V2, which is 85.8 percent of all nodes."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_ServiceBitsOfNetwork a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); b = L.bitnodes(); (sorted(b['services'].items()), round(100 * b['services']['P2P_V2'] / b['total'], 1)) evaluates to ([('BLOOM', 4308), ('COMPACT_FILTERS', 7905), ('NETWORK', 22402), ('NETWORK_LIMITED', 25322), ('P2P_V2', 21768), ('WITNESS', 24582)], 85.8)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); b = L.bitnodes(); (sorted(b['services'].items()), round(100 * b['services']['P2P_V2'] / b['total'], 1))" ; chx:output "([('BLOOM', 4308), ('COMPACT_FILTERS', 7905), ('NETWORK', 22402), ('NETWORK_LIMITED', 25322), ('P2P_V2', 21768), ('WITNESS', 24582)], 85.8)" .
chx:X_ServiceBitsOfNetwork rd:hasIOExample chx:IO_ServiceBitsOfNetwork .
chx:X_ArchivalNodeServices a owl:NamedIndividual, chx:ArchivalNodeServices ; rdfs:label "services 3081 of a full node"@en ; skos:definition "A full archival node of the test network advertises the services value 3081 (hexadecimal c09), which decodes to NETWORK, WITNESS, NETWORK_LIMITED and P2P_V2; the book's description of archival full nodes matches the first of these."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_ArchivalNodeServices a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (int(R['networkinfo_A']['localservices'], 16), R['networkinfo_A']['localservicesnames'], L.has('book_ch10_network.adoc', 'archival full nodes')) evaluates to (3081, ['NETWORK', 'WITNESS', 'NETWORK_LIMITED', 'P2P_V2'], True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (int(R['networkinfo_A']['localservices'], 16), R['networkinfo_A']['localservicesnames'], L.has('book_ch10_network.adoc', 'archival full nodes'))" ; chx:output "(3081, ['NETWORK', 'WITNESS', 'NETWORK_LIMITED', 'P2P_V2'], True)" .
chx:X_ArchivalNodeServices rd:hasIOExample chx:IO_ArchivalNodeServices .
chx:X_PrunedNodeServices a owl:NamedIndividual, chx:PrunedNodeServices ; rdfs:label "a node pruned to the minimum"@en ; skos:definition "A pruned node of the test network drops the NETWORK bit and advertises only WITNESS, NETWORK_LIMITED and P2P_V2, in both its networkinfo and its version message, which tells peers it can serve only the most recent 288 blocks as BIP 159 defines."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_PrunedNodeServices a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (R['e10_pruned']['services'], R['e10_pruned']['version_services'], R['e10_pruned']['prune_info']['pruned'], L.has('bip-0159.mediawiki', 'at least the last 288 blocks')) evaluates to (['WITNESS', 'NETWORK_LIMITED', 'P2P_V2'], ['WITNESS', 'NETWORK_LIMITED', 'P2P_V2'], True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (R['e10_pruned']['services'], R['e10_pruned']['version_services'], R['e10_pruned']['prune_info']['pruned'], L.has('bip-0159.mediawiki', 'at least the last 288 blocks'))" ; chx:output "(['WITNESS', 'NETWORK_LIMITED', 'P2P_V2'], ['WITNESS', 'NETWORK_LIMITED', 'P2P_V2'], True, True)" .
chx:X_PrunedNodeServices rd:hasIOExample chx:IO_PrunedNodeServices .
chx:X_MessageFraming a owl:NamedIndividual, chx:MessageFraming ; rdfs:label "a verack message is 24 bytes"@en ; skos:definition "Every message starts with a 24-byte header of magic, command, length and checksum, so the empty verack message is the 24 bytes fabfb5da76657261636b000000000000000000005df6e0e2 with the magic of the test chain, whereas the main chain uses f9beb4d9, the four bytes that chainparams.cpp sets."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_MessageFraming a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (P.frame('verack', b'').hex(), len(P.frame('verack', b'')), P.MAGIC['main'].hex(), L.has('core_src_kernel_chainparams.cpp', 'pchMessageStart[0] = 0xf9;', 'pchMessageStart[1] = 0xbe;', 'pchMessageStart[2] = 0xb4;', 'pchMessageStart[3] = 0xd9;')) evaluates to ('fabfb5da76657261636b000000000000000000005df6e0e2', 24, 'f9beb4d9', True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (P.frame('verack', b'').hex(), len(P.frame('verack', b'')), P.MAGIC['main'].hex(), L.has('core_src_kernel_chainparams.cpp', 'pchMessageStart[0] = 0xf9;', 'pchMessageStart[1] = 0xbe;', 'pchMessageStart[2] = 0xb4;', 'pchMessageStart[3] = 0xd9;'))" ; chx:output "('fabfb5da76657261636b000000000000000000005df6e0e2', 24, 'f9beb4d9', True)" .
chx:X_MessageFraming rd:hasIOExample chx:IO_MessageFraming .
chx:X_VersionMessageFields a owl:NamedIndividual, chx:VersionMessageFields ; rdfs:label "the 102-byte version message of the node"@en ; skos:definition "The version message of the test node is 102 bytes and carries protocol version 70016, services 3081, the user agent /Satoshi:31.1.0/, the start height 2099 of its chain and the relay flag true, in the eleven fields the script parsed."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_VersionMessageFields a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); v = R['e1_handshake']['node_version']; (v['version'], v['services'], v['user_agent'], v['start_height'], v['relay'], v['payload_bytes'], sorted(v)) evaluates to (70016, 3081, '/Satoshi:31.1.0/', 2099, True, 102, ['addr_from', 'addr_recv', 'nonce', 'payload_bytes', 'relay', 'services', 'services_names', 'start_height', 'timestamp', 'user_agent', 'version'])"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); v = R['e1_handshake']['node_version']; (v['version'], v['services'], v['user_agent'], v['start_height'], v['relay'], v['payload_bytes'], sorted(v))" ; chx:output "(70016, 3081, '/Satoshi:31.1.0/', 2099, True, 102, ['addr_from', 'addr_recv', 'nonce', 'payload_bytes', 'relay', 'services', 'services_names', 'start_height', 'timestamp', 'user_agent', 'version'])" .
chx:X_VersionMessageFields rd:hasIOExample chx:IO_VersionMessageFields .
chx:X_ProtocolVersionNumber a owl:NamedIndividual, chx:ProtocolVersionNumber ; rdfs:label "70016 instead of the book's 70002"@en ; skos:definition "The protocol version of Bitcoin Core 31.1 is 70016, both in the source constant PROTOCOL_VERSION and in the version message, and wtxid relay needs 70016 too, whereas the book still shows the example version 70002 of 2013."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_ProtocolVersionNumber a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.const('core_src_node_protocol_version.h', 'PROTOCOL_VERSION'), R['e1_handshake']['node_version']['version'], L.has('book_ch10_network.adoc', '(e.g., 70002)'), L.const('core_src_node_protocol_version.h', 'WTXID_RELAY_VERSION')) evaluates to ('70016', 70016, True, '70016')"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.const('core_src_node_protocol_version.h', 'PROTOCOL_VERSION'), R['e1_handshake']['node_version']['version'], L.has('book_ch10_network.adoc', '(e.g., 70002)'), L.const('core_src_node_protocol_version.h', 'WTXID_RELAY_VERSION'))" ; chx:output "('70016', 70016, True, '70016')" .
chx:X_ProtocolVersionNumber rd:hasIOExample chx:IO_ProtocolVersionNumber .
chx:X_HandshakeMessageOrder a owl:NamedIndividual, chx:HandshakeMessageOrder ; rdfs:label "what a node says after it connects"@en ; skos:definition "A node that accepts a connection says version first, then the feature messages wtxidrelay and sendaddrv2, then verack, and after verack it sends sendcmpct, ping, getheaders, inv and feefilter."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_HandshakeMessageOrder a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); [c for t, c, n in R['e1_handshake']['sequence']] evaluates to ['version', 'wtxidrelay', 'sendaddrv2', 'verack', 'sendcmpct', 'ping', 'getheaders', 'inv', 'feefilter']"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); [c for t, c, n in R['e1_handshake']['sequence']]" ; chx:output "['version', 'wtxidrelay', 'sendaddrv2', 'verack', 'sendcmpct', 'ping', 'getheaders', 'inv', 'feefilter']" .
chx:X_HandshakeMessageOrder rd:hasIOExample chx:IO_HandshakeMessageOrder .
chx:X_RelayFlagSilencesTransactions a owl:NamedIndividual, chx:RelayFlagSilencesTransactions ; rdfs:label "fRelay set to false"@en ; skos:definition "A peer that connects with the relay flag false receives no transaction announcements at all: of two transactions the node announced two to the normal peer, none to the relay-false peer and one to the peer whose feefilter was 5 satoshis per virtual byte."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_RelayFlagSilencesTransactions a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); v = R['e5_relay']['invs']; (len(v['normal_wtxidrelay']), len(v['relay_false']), len(v['feefilter_5sat']), L.has('book_ch10_network.adoc', 'fRelay')) evaluates to (2, 0, 1, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); v = R['e5_relay']['invs']; (len(v['normal_wtxidrelay']), len(v['relay_false']), len(v['feefilter_5sat']), L.has('book_ch10_network.adoc', 'fRelay'))" ; chx:output "(2, 0, 1, True)" .
chx:X_RelayFlagSilencesTransactions rd:hasIOExample chx:IO_RelayFlagSilencesTransactions .
chx:X_DnsSeedList a owl:NamedIndividual, chx:DnsSeedList ; rdfs:label "8 seeds, 182 addresses"@en ; skos:definition "Bitcoin Core 31.1 names 8 DNS seeds in chainparams.cpp and resolving them gave 182 distinct IPv4 addresses, from 20 to 29 per seed, for the default port 8333; the sandbox could not open a raw TCP connection to any of them, so no mainnet peer was contacted."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_DnsSeedList a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); d = R['e11_dns_seeds']; (len(d['seeds_in_chainparams']), d['distinct_ipv4'], min(len(v['ipv4']) for v in d['answers'].values()), max(len(v['ipv4']) for v in d['answers'].values()), L.const('core_src_kernel_chainparams.cpp', 'nDefaultPort'), d['tcp_probe']['connected'], L.has('bitcoind_help_31.1.txt', 'Query for peer addresses via DNS lookup, if low on addresses (default: 1 unless -connect used or -maxconnections=0)')) evaluates to (8, 182, 20, 29, '8333', False, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); d = R['e11_dns_seeds']; (len(d['seeds_in_chainparams']), d['distinct_ipv4'], min(len(v['ipv4']) for v in d['answers'].values()), max(len(v['ipv4']) for v in d['answers'].values()), L.const('core_src_kernel_chainparams.cpp', 'nDefaultPort'), d['tcp_probe']['connected'], L.has('bitcoind_help_31.1.txt', 'Query for peer addresses via DNS lookup, if low on addresses (default: 1 unless -connect used or -maxconnections=0)'))" ; chx:output "(8, 182, 20, 29, '8333', False, True)" .
chx:X_DnsSeedList rd:hasIOExample chx:IO_DnsSeedList .
chx:X_AddrGossipFormat a owl:NamedIndividual, chx:AddrGossipFormat ; rdfs:label "23 percent of the address book"@en ; skos:definition "In answer to getaddr the node returned 23 addresses, the same number in the old addr message and in the addrv2 message, which is 23 percent of the 103 addresses of its address manager as MAX_PCT_ADDR_TO_SEND says."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_AddrGossipFormat a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); a = R['e9_addr']; (a['without']['addr']['count'], a['with_sendaddrv2']['addrv2']['count'], L.const('core_src_net_processing.cpp', 'MAX_PCT_ADDR_TO_SEND'), R['e9_addrman']['getnodeaddresses_count'] * 23 // 100) evaluates to (23, 23, '23', 23)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); a = R['e9_addr']; (a['without']['addr']['count'], a['with_sendaddrv2']['addrv2']['count'], L.const('core_src_net_processing.cpp', 'MAX_PCT_ADDR_TO_SEND'), R['e9_addrman']['getnodeaddresses_count'] * 23 // 100)" ; chx:output "(23, 23, '23', 23)" .
chx:X_AddrGossipFormat rd:hasIOExample chx:IO_AddrGossipFormat .
chx:X_Addrv2Networks a owl:NamedIndividual, chx:Addrv2Networks ; rdfs:label "BIP 155 carries Tor v3, I2P and CJDNS"@en ; skos:definition "Once a peer sent sendaddrv2 the node answered with addrv2 messages whose entries belong to networks 1 and 2 (IPv4 and IPv6) with address lengths 4 and 16 bytes, and BIP 155 adds TORV3, I2P and CJDNS entries that the old 16-byte addr message could not hold."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_Addrv2Networks a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); a = R['e9_addr']['with_sendaddrv2']['addrv2']; (a['networks'], a['addr_len'], L.has('bip-0155.mediawiki', 'TORV3', 'I2P', 'CJDNS'), R['e9_addrman']['addrman_info']['ok']['all_networks']['total']) evaluates to ([1, 2], [4, 16], True, 103)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); a = R['e9_addr']['with_sendaddrv2']['addrv2']; (a['networks'], a['addr_len'], L.has('bip-0155.mediawiki', 'TORV3', 'I2P', 'CJDNS'), R['e9_addrman']['addrman_info']['ok']['all_networks']['total'])" ; chx:output "([1, 2], [4, 16], True, 103)" .
chx:X_Addrv2Networks rd:hasIOExample chx:IO_Addrv2Networks .
chx:X_ConnectionTypes a owl:NamedIndividual, chx:ConnectionTypes ; rdfs:label "8 full relay, 2 block-relay-only, 125 in all"@en ; skos:definition "The peer listing of the node shows the connection types outbound-full-relay and addr-fetch, which relay transactions and addresses (relaytxes true), and block-relay-only, which relays neither and was on the v1 transport in the run, while the source sets 8 full-relay outbound slots, 2 block-relay-only slots and 125 connections in all."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_ConnectionTypes a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (R['e8_types'], L.const('core_src_net.h', 'MAX_OUTBOUND_FULL_RELAY_CONNECTIONS'), L.const('core_src_net.h', 'MAX_BLOCK_RELAY_ONLY_CONNECTIONS'), L.const('core_src_net.h', 'DEFAULT_MAX_PEER_CONNECTIONS')) evaluates to ([['addr-fetch', True, True, 'v2'], ['block-relay-only', False, False, 'v1'], ['outbound-full-relay', True, True, 'v2']], '8', '2', '125')"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (R['e8_types'], L.const('core_src_net.h', 'MAX_OUTBOUND_FULL_RELAY_CONNECTIONS'), L.const('core_src_net.h', 'MAX_BLOCK_RELAY_ONLY_CONNECTIONS'), L.const('core_src_net.h', 'DEFAULT_MAX_PEER_CONNECTIONS'))" ; chx:output "([['addr-fetch', True, True, 'v2'], ['block-relay-only', False, False, 'v1'], ['outbound-full-relay', True, True, 'v2']], '8', '2', '125')" .
chx:X_ConnectionTypes rd:hasIOExample chx:IO_ConnectionTypes .
chx:X_BlockFindingRaceProbability a owl:NamedIndividual, chx:BlockFindingRaceProbability ; rdfs:label "rival blocks while a block travels"@en ; skos:definition "While a block is travelling a rival block can be found: with blocks as a Poisson process of one per 600 seconds the chance is 0.33 percent for a 2-second delay, 1.65 percent for 10 seconds and 6.45 percent for 40 seconds."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_BlockFindingRaceProbability a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); [round(L.rival_block_probability(d), 4) for d in (2, 10, 40)] evaluates to [0.0033, 0.0165, 0.0645]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); [round(L.rival_block_probability(d), 4) for d in (2, 10, 40)]" ; chx:output "[0.0033, 0.0165, 0.0645]" .
chx:X_BlockFindingRaceProbability rd:hasIOExample chx:IO_BlockFindingRaceProbability .
chx:X_SendheadersAnnouncement a owl:NamedIndividual, chx:SendheadersAnnouncement ; rdfs:label "inv before, headers after sendheaders"@en ; skos:definition "A new block is announced with an inv message to a peer that did not send sendheaders and with a headers message to a peer that did, as BIP 130 defines."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_SendheadersAnnouncement a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (R['e2_announce'], L.has('bip-0130.mediawiki', 'sendheaders')) evaluates to ({'without_sendheaders': ['inv'], 'with_sendheaders': ['headers']}, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (R['e2_announce'], L.has('bip-0130.mediawiki', 'sendheaders'))" ; chx:output "({'without_sendheaders': ['inv'], 'with_sendheaders': ['headers']}, True)" .
chx:X_SendheadersAnnouncement rd:hasIOExample chx:IO_SendheadersAnnouncement .
chx:X_ShortIdsAreSixBytes a owl:NamedIndividual, chx:ShortIdsAreSixBytes ; rdfs:label "332 bytes instead of 3,062"@en ; skos:definition "A block of 13 transactions was relayed as a compact block of 332 bytes instead of 3,062 (10.84 percent), with 12 short ids of 6 bytes each, equal to the ones the script computed with SipHash-2-4 (the reference vector a129ca6149be45e5)."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_ShortIdsAreSixBytes a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); c = R['e3_compact']; (c['short_id_count'], c['tx_count'] - 1, c['short_ids_match'], c['short_id_bytes'], L.const('core_src_blockencodings.h', 'SHORTTXIDS_LENGTH'), c['shortid_siphash_vector'], c['cmpctblock_bytes'], c['full_block_bytes'], round(c['cmpctblock_bytes'] / c['full_block_bytes'], 4)) evaluates to (12, 12, True, 6, '6', 'a129ca6149be45e5', 332, 3062, 0.1084)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); c = R['e3_compact']; (c['short_id_count'], c['tx_count'] - 1, c['short_ids_match'], c['short_id_bytes'], L.const('core_src_blockencodings.h', 'SHORTTXIDS_LENGTH'), c['shortid_siphash_vector'], c['cmpctblock_bytes'], c['full_block_bytes'], round(c['cmpctblock_bytes'] / c['full_block_bytes'], 4))" ; chx:output "(12, 12, True, 6, '6', 'a129ca6149be45e5', 332, 3062, 0.1084)" .
chx:X_ShortIdsAreSixBytes rd:hasIOExample chx:IO_ShortIdsAreSixBytes .
chx:X_CoinbaseIsPrefilled a owl:NamedIndividual, chx:CoinbaseIsPrefilled ; rdfs:label "index 0 comes with the block"@en ; skos:definition "The compact block of the run listed exactly one prefilled transaction, at index 0, and it was the coinbase transaction, because no peer can have it in its mempool."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_CoinbaseIsPrefilled a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); c = R['e3_compact']; (c['prefilled_indexes'], c['prefilled_txids'] == [c['coinbase_txid']], L.has('book_ch10_network.adoc', 'Bitcoin Core always sends a block')) evaluates to ([0], True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); c = R['e3_compact']; (c['prefilled_indexes'], c['prefilled_txids'] == [c['coinbase_txid']], L.has('book_ch10_network.adoc', 'Bitcoin Core always sends a block'))" ; chx:output "([0], True, True)" .
chx:X_CoinbaseIsPrefilled rd:hasIOExample chx:IO_CoinbaseIsPrefilled .
chx:X_MissingTransactionsRequest a owl:NamedIndividual, chx:MissingTransactionsRequest ; rdfs:label "getblocktxn and blocktxn"@en ; skos:definition "When the receiver lacked two transactions it asked for them with getblocktxn and the node answered with blocktxn holding exactly those two transactions, so the block could be completed."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_MissingTransactionsRequest a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); c = R['e3_compact']; (c['blocktxn_txids'] == c['expected_txids'], len(c['blocktxn_txids'])) evaluates to (True, 2)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); c = R['e3_compact']; (c['blocktxn_txids'] == c['expected_txids'], len(c['blocktxn_txids']))" ; chx:output "(True, 2)" .
chx:X_MissingTransactionsRequest rd:hasIOExample chx:IO_MissingTransactionsRequest .
chx:X_HighAndLowBandwidthModes a owl:NamedIndividual, chx:HighAndLowBandwidthModes ; rdfs:label "a peer that announces by cmpctblock"@en ; skos:definition "The node counted the script as a high-bandwidth peer (bip152_hb_to true, bip152_hb_from false in its peer listing) and sent it the compact block unasked; in low-bandwidth mode it announced nothing by cmpctblock, the script's request for the compact block was answered, and that answer equalled the unasked one; the source limits the high-bandwidth peers to 3."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_HighAndLowBandwidthModes a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); l = R['e3_low_bandwidth']; (R['e3_compact']['peerinfo_hb_from'], l['announced_by'], l['cmpctblock_requested_ok'], l['compact_equal_to_hb'], L.has('core_src_net_processing.cpp', 'lNodesAnnouncingHeaderAndIDs.size() >= 3')) evaluates to ([True, False], [], True, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); l = R['e3_low_bandwidth']; (R['e3_compact']['peerinfo_hb_from'], l['announced_by'], l['cmpctblock_requested_ok'], l['compact_equal_to_hb'], L.has('core_src_net_processing.cpp', 'lNodesAnnouncingHeaderAndIDs.size() >= 3'))" ; chx:output "([True, False], [], True, True, True)" .
chx:X_HighAndLowBandwidthModes rd:hasIOExample chx:IO_HighAndLowBandwidthModes .
chx:X_CompactBlockDepthLimit a owl:NamedIndividual, chx:CompactBlockDepthLimit ; rdfs:label "5 blocks deep and no more"@en ; skos:definition "A compact block is answered only for a block at most 5 blocks deep (MAX_CMPCTBLOCK_DEPTH), so a request for a block 20 deep was answered with the full block."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_CompactBlockDepthLimit a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (R['e3_low_bandwidth']['answer_for_old_block'], R['e3_low_bandwidth']['depth_asked'], L.const('core_src_net_processing.cpp', 'MAX_CMPCTBLOCK_DEPTH')) evaluates to (['block'], 20, '5')"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (R['e3_low_bandwidth']['answer_for_old_block'], R['e3_low_bandwidth']['depth_asked'], L.const('core_src_net_processing.cpp', 'MAX_CMPCTBLOCK_DEPTH'))" ; chx:output "(['block'], 20, '5')" .
chx:X_CompactBlockDepthLimit rd:hasIOExample chx:IO_CompactBlockDepthLimit .
chx:X_CompactBlocksYear a owl:NamedIndividual, chx:CompactBlocksYear ; rdfs:label "2016 and not 2015"@en ; skos:definition "The book dates the compact blocks to a new Bitcoin Core release of 2015, while the BIP 152 text was assigned on 2016-04-27 and Bitcoin Core documents the BIP as implemented since v0.13.0, so the year in the book is an error."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_CompactBlocksYear a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('book_ch10_network.adoc', 'In 2015, a new version of Bitcoin Core added a feature called'), L.has('bip-0152.mediawiki', 'Assigned: 2016-04-27'), L.has('core_doc_bips.md', 'are used as of **v0.13.0**')) evaluates to (True, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('book_ch10_network.adoc', 'In 2015, a new version of Bitcoin Core added a feature called'), L.has('bip-0152.mediawiki', 'Assigned: 2016-04-27'), L.has('core_doc_bips.md', 'are used as of **v0.13.0**'))" ; chx:output "(True, True, True)" .
chx:X_CompactBlocksYear rd:hasIOExample chx:IO_CompactBlocksYear .
chx:X_ForwardErrorCorrectionDemo a owl:NamedIndividual, chx:ForwardErrorCorrectionDemo ; rdfs:label "one spare part rebuilds one lost part"@en ; skos:definition "A message of 24 bytes cut into four parts of 6 bytes and one parity part of 6 bytes (the XOR of the four) was restored completely after one part was lost, which is the simplest form of the forward error correction that FIBRE applies to UDP packets."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_ForwardErrorCorrectionDemo a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); m = b'compact block message!!!'; parts = [m[i:i + 6] for i in range(0, 24, 6)]; par = L.parity_code(parts); got = L.rebuild([parts[0], None, parts[2], parts[3]], par); (b''.join(got) == m, len(par), len(parts), 3 * 1 == 3) evaluates to (True, 6, 4, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); m = b'compact block message!!!'; parts = [m[i:i + 6] for i in range(0, 24, 6)]; par = L.parity_code(parts); got = L.rebuild([parts[0], None, parts[2], parts[3]], par); (b''.join(got) == m, len(par), len(parts), 3 * 1 == 3)" ; chx:output "(True, 6, 4, True)" .
chx:X_ForwardErrorCorrectionDemo rd:hasIOExample chx:IO_ForwardErrorCorrectionDemo .
chx:X_RelayNetworkHistory a owl:NamedIndividual, chx:RelayNetworkHistory ; rdfs:label "Corallo's relay network in 2015, FIBRE in 2016"@en ; skos:definition "The book names the relay network of Matt Corallo created in 2015 and replaced in 2016, and the FIBRE site describes the successor as a UDP transport with forward error correction and compact blocks; neither could be run in the sandbox."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_RelayNetworkHistory a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('book_ch10_network.adoc', 'created by developer Matt Corallo in 2015', 'replaced in 2016'), L.has('bitcoinfibre_org.html', 'UDP transport, Forward Error Correction (FEC), and Compact Blocks')) evaluates to (True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('book_ch10_network.adoc', 'created by developer Matt Corallo in 2015', 'replaced in 2016'), L.has('bitcoinfibre_org.html', 'UDP transport, Forward Error Correction (FEC), and Compact Blocks'))" ; chx:output "(True, True)" .
chx:X_RelayNetworkHistory rd:hasIOExample chx:IO_RelayNetworkHistory .
chx:X_HeadersBatchOf2000 a owl:NamedIndividual, chx:HeadersBatchOf2000 ; rdfs:label "2,000 headers per message"@en ; skos:definition "A node with a chain of 2,101 blocks served the headers in a first message of 2,000 headers and a second of 101, each header taking 81 bytes (80 and a zero transaction count), and the constant MAX_HEADERS_RESULTS is 2000."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_HeadersBatchOf2000 a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); h = R['e2_headers']; (h['first_count'], h['second_count'], h['first_bytes'] == 3 + 2000 * 81, h['second_bytes'] == 1 + h['second_count'] * 81, h['first_count'] + h['second_count'] == h['height'], L.const('core_src_net_processing.h', 'MAX_HEADERS_RESULTS')) evaluates to (2000, 101, True, True, True, '2000')"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); h = R['e2_headers']; (h['first_count'], h['second_count'], h['first_bytes'] == 3 + 2000 * 81, h['second_bytes'] == 1 + h['second_count'] * 81, h['first_count'] + h['second_count'] == h['height'], L.const('core_src_net_processing.h', 'MAX_HEADERS_RESULTS'))" ; chx:output "(2000, 101, True, True, True, '2000')" .
chx:X_HeadersBatchOf2000 rd:hasIOExample chx:IO_HeadersBatchOf2000 .
chx:X_HeaderChainLinks a owl:NamedIndividual, chx:HeaderChainLinks ; rdfs:label "each header holds the hash of the one before"@en ; skos:definition "Walking the 2,101 downloaded headers, each one pointed at the hash of its predecessor and the last one hashed to the tip of the node; each header is 80 bytes."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_HeaderChainLinks a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); h = R['e2_headers']; (h['chain_links_ok'], h['tip_from_headers'] == h['tip_from_node'], h['header_size']) evaluates to (True, True, 80)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); h = R['e2_headers']; (h['chain_links_ok'], h['tip_from_headers'] == h['tip_from_node'], h['header_size'])" ; chx:output "(True, True, 80)" .
chx:X_HeaderChainLinks rd:hasIOExample chx:IO_HeaderChainLinks .
chx:X_DownloadWindow a owl:NamedIndividual, chx:DownloadWindow ; rdfs:label "1,024 blocks ahead, 16 per peer"@en ; skos:definition "A new node downloads blocks inside a window of 1,024 blocks (BLOCK_DOWNLOAD_WINDOW) with at most 16 in transit from one peer; a fresh node synchronised a chain of 2,105 blocks from one peer in about 2.5 seconds, and its getheaders request was 69 bytes."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_DownloadWindow a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); i = R['e10_ibd']; (L.const('core_src_net_processing.cpp', 'BLOCK_DOWNLOAD_WINDOW'), L.const('core_src_net_processing.cpp', 'MAX_BLOCKS_IN_TRANSIT_PER_PEER'), i['height'], i['chain_equal'], i['seconds'] < 30, any('sending getheaders (69 bytes)' in l for l in i['log_getheaders_lines']), len(P.getheaders_payload([bytes(32)]))) evaluates to ('1024', '16', 2105, True, True, True, 69)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); i = R['e10_ibd']; (L.const('core_src_net_processing.cpp', 'BLOCK_DOWNLOAD_WINDOW'), L.const('core_src_net_processing.cpp', 'MAX_BLOCKS_IN_TRANSIT_PER_PEER'), i['height'], i['chain_equal'], i['seconds'] < 30, any('sending getheaders (69 bytes)' in l for l in i['log_getheaders_lines']), len(P.getheaders_payload([bytes(32)])))" ; chx:output "('1024', '16', 2105, True, True, True, 69)" .
chx:X_DownloadWindow rd:hasIOExample chx:IO_DownloadWindow .
chx:X_HeadersPresync a owl:NamedIndividual, chx:HeadersPresync ; rdfs:label "protection against low-work header floods"@en ; skos:definition "Bitcoin Core 31.1 puts a peer that sends headers in a PRESYNC phase until the chain is shown to have enough work, and it reports presynced_headers in getpeerinfo, a field that the book's listing already shows."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_HeadersPresync a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('core_src_headerssync.h', 'PRESYNC means the peer has not yet demonstrated their chain has'), 'presynced_headers' in R['e8_peerinfo_A'][0], L.has('book_ch10_network.adoc', 'presynced_headers')) evaluates to (True, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('core_src_headerssync.h', 'PRESYNC means the peer has not yet demonstrated their chain has'), 'presynced_headers' in R['e8_peerinfo_A'][0], L.has('book_ch10_network.adoc', 'presynced_headers'))" ; chx:output "(True, True, True)" .
chx:X_HeadersPresync rd:hasIOExample chx:IO_HeadersPresync .
chx:X_HeaderChainSize a owl:NamedIndividual, chx:HeaderChainSize ; rdfs:label "9,975 times smaller"@en ; skos:definition "At the height 971,499 of the chain the 80-byte headers total 77.7 megabytes against about 775,272 megabytes for the whole chain, 9,975 times less, so the book's remark that the headers are about 10,000 times smaller is correct to three digits."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_HeaderChainSize a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); c = L.chain_size_ratio(); (c['ratio'], c['tip_height'], c['headers_mb'], c['chain_mb'], L.has('book_ch10_network.adoc', 'about 10,000 times smaller')) evaluates to (9975, 971499, 77.7, 775272, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); c = L.chain_size_ratio(); (c['ratio'], c['tip_height'], c['headers_mb'], c['chain_mb'], L.has('book_ch10_network.adoc', 'about 10,000 times smaller'))" ; chx:output "(9975, 971499, 77.7, 775272, True)" .
chx:X_HeaderChainSize rd:hasIOExample chx:IO_HeaderChainSize .
chx:X_MerklePathProof a owl:NamedIndividual, chx:MerklePathProof ; rdfs:label "3 hashes prove 1 of 5"@en ; skos:definition "A block of 5 transactions was proven for one of them by 3 hashes whose root equals the Merkle root of the header; the proof took 215 bytes against 4,448 for the block, and the node's verifytxoutproof returned the transaction."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_MerklePathProof a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); s = R['e6_spv']; (s['path_len'], s['root_from_path'] == s['header_root'], s['block_tx_count'], s['proof_bytes'], R['e6_bloom_enabled']['full_block_bytes'], s['verifytxoutproof'] == [s['txid']]) evaluates to (3, True, 5, 215, 4448, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); s = R['e6_spv']; (s['path_len'], s['root_from_path'] == s['header_root'], s['block_tx_count'], s['proof_bytes'], R['e6_bloom_enabled']['full_block_bytes'], s['verifytxoutproof'] == [s['txid']])" ; chx:output "(3, True, 5, 215, 4448, True)" .
chx:X_MerklePathProof rd:hasIOExample chx:IO_MerklePathProof .
chx:X_SixConfirmationsOdds a owl:NamedIndividual, chx:SixConfirmationsOdds ; rdfs:label "the number in the paper"@en ; skos:definition "Nakamoto's calculation gives an attacker with 10 percent of the hash rate a chance of 0.0002428 to catch up from 6 blocks behind, and one with 30 percent a chance of 0.1321; a header chain for 6 blocks per hour of a year is 80 x 6 x 24 x 365 = 4,204,800 bytes."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_SixConfirmationsOdds a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (round(L.double_spend_probability(0.1, 6), 7), round(L.double_spend_probability(0.3, 6), 4), L.has('nakamoto_2008_bitcoin.pdf', 'z=6 P=0.0002428'), 80 * 6 * 24 * 365) evaluates to (0.0002428, 0.1321, True, 4204800)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (round(L.double_spend_probability(0.1, 6), 7), round(L.double_spend_probability(0.3, 6), 4), L.has('nakamoto_2008_bitcoin.pdf', 'z=6 P=0.0002428'), 80 * 6 * 24 * 365)" ; chx:output "(0.0002428, 0.1321, True, 4204800)" .
chx:X_SixConfirmationsOdds rd:hasIOExample chx:IO_SixConfirmationsOdds .
chx:X_ToyBloomFilter a owl:NamedIndividual, chx:ToyBloomFilter ; rdfs:label "A and B in 16 bits"@en ; skos:definition "A toy filter of 16 bits and 3 hash functions with two patterns added has 6 bits set, answers yes for both patterns, and for random patterns it falsely said maybe 5.3 percent of the time (the formula gives 3.1 percent), while it can say a definite no."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_ToyBloomFilter a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); r = L.toy_bloom_experiment(); (r['inserted_ok'], r['bits_set'], r['fp_measured'], r['fp_formula'], r['maybe_exists'], r['nope_exists']) evaluates to (True, 6, 0.053, 0.031, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); r = L.toy_bloom_experiment(); (r['inserted_ok'], r['bits_set'], r['fp_measured'], r['fp_formula'], r['maybe_exists'], r['nope_exists'])" ; chx:output "(True, 6, 0.053, 0.031, True, True)" .
chx:X_ToyBloomFilter rd:hasIOExample chx:IO_ToyBloomFilter .
chx:X_BloomFilterWireFormat a owl:NamedIndividual, chx:BloomFilterWireFormat ; rdfs:label "a 36,000-byte filter at most"@en ; skos:definition "The filterload message of three elements and false-positive rate 0.01 is 03614e9b050000000000000001 in the unit test of Bitcoin Core and in the independent implementation, and a filter may be at most 36,000 bytes with at most 50 hash functions."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_BloomFilterWireFormat a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.bloom_bip37_vector(), L.has('core_src_test_bloom_tests.cpp', '03614e9b050000000000000001'), L.const('core_src_common_bloom.h', 'MAX_BLOOM_FILTER_SIZE'), L.const('core_src_common_bloom.h', 'MAX_HASH_FUNCS')) evaluates to ('03614e9b050000000000000001', True, '36000', '50')"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.bloom_bip37_vector(), L.has('core_src_test_bloom_tests.cpp', '03614e9b050000000000000001'), L.const('core_src_common_bloom.h', 'MAX_BLOOM_FILTER_SIZE'), L.const('core_src_common_bloom.h', 'MAX_HASH_FUNCS'))" ; chx:output "('03614e9b050000000000000001', True, '36000', '50')" .
chx:X_BloomFilterWireFormat rd:hasIOExample chx:IO_BloomFilterWireFormat .
chx:X_MerkleblockForOneMatch a owl:NamedIndividual, chx:MerkleblockForOneMatch ; rdfs:label "a merkleblock of 215 bytes"@en ; skos:definition "With a filter loaded the node sent one merkleblock of 215 bytes for the block of 5 transactions (4,448 bytes) and then the one matching transaction, and the partial Merkle tree led to the root of the header."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_MerkleblockForOneMatch a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); e = R['e6_bloom_enabled']; (len(e['matched_txids']), e['matched_txids'] == e['wallet_tx'], e['tx_messages'] == e['wallet_tx'], e['tree_root'] == e['header_root'], e['merkleblock_bytes'], e['full_block_bytes'], e['block_txs'], e['filter_bytes'], e['hash_functions']) evaluates to (1, True, True, True, 215, 4448, 5, 7, 12)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); e = R['e6_bloom_enabled']; (len(e['matched_txids']), e['matched_txids'] == e['wallet_tx'], e['tx_messages'] == e['wallet_tx'], e['tree_root'] == e['header_root'], e['merkleblock_bytes'], e['full_block_bytes'], e['block_txs'], e['filter_bytes'], e['hash_functions'])" ; chx:output "(1, True, True, True, 215, 4448, 5, 7, 12)" .
chx:X_MerkleblockForOneMatch rd:hasIOExample chx:IO_MerkleblockForOneMatch .
chx:X_BloomDisabledByDefault a owl:NamedIndividual, chx:BloomDisabledByDefault ; rdfs:label "BIP 37 off since 0.19"@en ; skos:definition "A node started with default options does not set the BLOOM bit and disconnects a peer that sends filterload; the option -peerbloomfilters defaults to 0 since v0.19.0, and only 4,308 of 25,361 nodes of the census advertise the bit."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_BloomDisabledByDefault a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); d = R['e6_bloom_default']; (d['has_bloom_bit'], d['disconnected_after_filterload'], L.has('bitcoind_help_31.1.txt', 'bloom filters (default: 0)'), L.bitnodes()['services']['BLOOM'], L.has('core_doc_bips.md', 'Disabled by default since **v0.19.0**')) evaluates to (False, True, True, 4308, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); d = R['e6_bloom_default']; (d['has_bloom_bit'], d['disconnected_after_filterload'], L.has('bitcoind_help_31.1.txt', 'bloom filters (default: 0)'), L.bitnodes()['services']['BLOOM'], L.has('core_doc_bips.md', 'Disabled by default since **v0.19.0**'))" ; chx:output "(False, True, True, 4308, True)" .
chx:X_BloomDisabledByDefault rd:hasIOExample chx:IO_BloomDisabledByDefault .
chx:X_GolombWorkedExample a owl:NamedIndividual, chx:GolombWorkedExample ; rdfs:label "849 653 476 900 379"@en ; skos:definition "Sorting the five numbers of the book's example gives 379 476 653 849 900, whose differences 379 97 177 196 51 need at most 8 bits where the originals need 10, and the book's table of the differences of two dice (6, 10, 8, 6, 4, 2 out of 36) is right."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_GolombWorkedExample a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); g = L.gcs_book_example(); (g['sorted'], g['deltas'], g['equal'], g['max_bits_original'], g['max_bits_deltas'], L.dice_table()) evaluates to ([379, 476, 653, 849, 900], [379, 97, 177, 196, 51], True, 10, 8, [6, 10, 8, 6, 4, 2])"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); g = L.gcs_book_example(); (g['sorted'], g['deltas'], g['equal'], g['max_bits_original'], g['max_bits_deltas'], L.dice_table())" ; chx:output "([379, 476, 653, 849, 900], [379, 97, 177, 196, 51], True, 10, 8, [6, 10, 8, 6, 4, 2])" .
chx:X_GolombWorkedExample rd:hasIOExample chx:IO_GolombWorkedExample .
chx:X_GolombRiceRoundTrip a owl:NamedIndividual, chx:GolombRiceRoundTrip ; rdfs:label "44 bits against 50"@en ; skos:definition "Golomb-Rice coding of the five numbers with parameter 7 takes 44 bits (6 bytes), against 50 bits of a fixed length of 10 bits, and decodes back to the same numbers."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_GolombRiceRoundTrip a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); r = L.rice_roundtrip([379, 476, 653, 849, 900], 7); (r['decoded'] == [379, 476, 653, 849, 900], r['bits'], r['fixed_bits'], r['bytes']) evaluates to (True, 44, 50, 6)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); r = L.rice_roundtrip([379, 476, 653, 849, 900], 7); (r['decoded'] == [379, 476, 653, 849, 900], r['bits'], r['fixed_bits'], r['bytes'])" ; chx:output "(True, 44, 50, 6)" .
chx:X_GolombRiceRoundTrip rd:hasIOExample chx:IO_GolombRiceRoundTrip .
chx:X_BasicFilterParameters a owl:NamedIndividual, chx:BasicFilterParameters ; rdfs:label "P = 19 and M = 784931"@en ; skos:definition "BIP 158 sets P = 19 and M = 784931 for the basic filter, the constants of the independent implementation, which reproduced all 10 test vectors of the BIP (filters and filter headers) and the SipHash reference value a129ca6149be45e5."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_BasicFilterParameters a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('bip-0158.mediawiki', '<code>M = 784931</code>', '<code>P = 19</code>'), P.GCS_P, P.GCS_M, L.bip158_vectors(), P.siphash_test_vector()) evaluates to (True, 19, 784931, (10, 10), 'a129ca6149be45e5')"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('bip-0158.mediawiki', '<code>M = 784931</code>', '<code>P = 19</code>'), P.GCS_P, P.GCS_M, L.bip158_vectors(), P.siphash_test_vector())" ; chx:output "(True, 19, 784931, (10, 10), 'a129ca6149be45e5')" .
chx:X_BasicFilterParameters rd:hasIOExample chx:IO_BasicFilterParameters .
chx:X_FilterEqualsNodeFilter a owl:NamedIndividual, chx:FilterEqualsNodeFilter ; rdfs:label "the same 104 bytes"@en ; skos:definition "The independent implementation built the filter of a block of 9 transactions, 104 elements in 275 bytes, and got the same 275 bytes and the same filter header as the node's getblockfilter."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_FilterEqualsNodeFilter a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); f = R['e7_filter']; (f['my_filter_equal'], f['my_header_equal'], f['n_elements'], f['filter_bytes'], f['tx_count']) evaluates to (True, True, 104, 275, 9)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); f = R['e7_filter']; (f['my_filter_equal'], f['my_header_equal'], f['n_elements'], f['filter_bytes'], f['tx_count'])" ; chx:output "(True, True, 104, 275, 9)" .
chx:X_FilterEqualsNodeFilter rd:hasIOExample chx:IO_FilterEqualsNodeFilter .
chx:X_FilterBitsPerElement a owl:NamedIndividual, chx:FilterBitsPerElement ; rdfs:label "21 bits per element, not 64"@en ; skos:definition "The filter of the run took 275 x 8 / 104 = 21.15 bits per element, where the book speaks of a filter that fits down to just 64 bits per element."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_FilterBitsPerElement a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); f = R['e7_filter']; (f['bits_per_element'], round(f['filter_bytes'] * 8 / f['n_elements'], 2), L.has('book_ch10_network.adoc', 'down to just 64 bits')) evaluates to (21.15, 21.15, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); f = R['e7_filter']; (f['bits_per_element'], round(f['filter_bytes'] * 8 / f['n_elements'], 2), L.has('book_ch10_network.adoc', 'down to just 64 bits'))" ; chx:output "(21.15, 21.15, True)" .
chx:X_FilterBitsPerElement rd:hasIOExample chx:IO_FilterBitsPerElement .
chx:X_FilterSkipsOpReturn a owl:NamedIndividual, chx:FilterSkipsOpReturn ; rdfs:label "OP_RETURN scripts are not in the filter"@en ; skos:definition "The block of the run had 2 OP_RETURN outputs, none of them is in the filter, and its 144 scripts gave 104 elements after the OP_RETURN scripts and the duplicates were left out."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_FilterSkipsOpReturn a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); f = R['e7_filter']; (f['op_return_outputs'], f['any_op_return_in_filter'], f['scripts_total'], f['n_elements'], L.has('bip-0158.mediawiki', 'aside from all <code>OP_RETURN</code> output scripts')) evaluates to (2, False, 144, 104, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); f = R['e7_filter']; (f['op_return_outputs'], f['any_op_return_in_filter'], f['scripts_total'], f['n_elements'], L.has('bip-0158.mediawiki', 'aside from all <code>OP_RETURN</code> output scripts'))" ; chx:output "(2, False, 144, 104, True)" .
chx:X_FilterSkipsOpReturn rd:hasIOExample chx:IO_FilterSkipsOpReturn .
chx:X_FilterFalsePositiveRate a owl:NamedIndividual, chx:FilterFalsePositiveRate ; rdfs:label "1 in 784,931"@en ; skos:definition "A filter with M = 784931 is expected to match a random script once in 784,931 trials; in 400,000 trials of the run it matched once, where 0.51 matches are expected, and every script of the block matched."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_FilterFalsePositiveRate a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); p = R['e7_filter']['random_probe']; (p['m'], p['trials'], p['hits'], round(p['trials'] / p['m'], 2), R['e7_filter']['own_scripts_all_match']) evaluates to (784931, 400000, 1, 0.51, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); p = R['e7_filter']['random_probe']; (p['m'], p['trials'], p['hits'], round(p['trials'] / p['m'], 2), R['e7_filter']['own_scripts_all_match'])" ; chx:output "(784931, 400000, 1, 0.51, True)" .
chx:X_FilterFalsePositiveRate rd:hasIOExample chx:IO_FilterFalsePositiveRate .
chx:X_FiltersOverP2P a owl:NamedIndividual, chx:FiltersOverP2P ; rdfs:label "cfilter, cfheaders, cfcheckpt"@en ; skos:definition "A node started with -peerblockfilters=1 advertises COMPACT_FILTERS, answers getcfilters with 3 filters equal to the block's filter, and a node without the option disconnects the asking peer; 7,905 nodes of the census advertise the bit."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_FiltersOverP2P a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); w = R['e7_wire']; (w['has_compact_filters_bit'], w['cfilter_count'], w['cfilter_for_block_equal'], w['node_without_option'], L.bitnodes()['services']['COMPACT_FILTERS']) evaluates to (True, 3, [True], {'has_compact_filters_bit': False, 'disconnected': True, 'cfilters_returned': 0}, 7905)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); w = R['e7_wire']; (w['has_compact_filters_bit'], w['cfilter_count'], w['cfilter_for_block_equal'], w['node_without_option'], L.bitnodes()['services']['COMPACT_FILTERS'])" ; chx:output "(True, 3, [True], {'has_compact_filters_bit': False, 'disconnected': True, 'cfilters_returned': 0}, 7905)" .
chx:X_FiltersOverP2P rd:hasIOExample chx:IO_FiltersOverP2P .
chx:X_FilterIdeaPost2016 a owl:NamedIndividual, chx:FilterIdeaPost2016 ; rdfs:label "an anonymous post of May 2016"@en ; skos:definition "The idea of a filter that the client downloads and tests locally came from an anonymous post to the bitcoin-dev list on 2016-05-09 and was written up as BIP 157 and 158 by Olaoluwa Osuntokun and Alex Akselrod, as the book says."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_FilterIdeaPost2016 a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('ml_bfd_2016-05_committed_bloom.html', 'From: bfd@cock•lu', 'Date: Mon, 09 May 2016'), L.has('bip-0157.mediawiki', 'Osuntokun'), L.has('book_ch10_network.adoc', 'anonymous developer in 2016')) evaluates to (True, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('ml_bfd_2016-05_committed_bloom.html', 'From: bfd@cock•lu', 'Date: Mon, 09 May 2016'), L.has('bip-0157.mediawiki', 'Osuntokun'), L.has('book_ch10_network.adoc', 'anonymous developer in 2016'))" ; chx:output "(True, True, True)" .
chx:X_FilterIdeaPost2016 rd:hasIOExample chx:IO_FilterIdeaPost2016 .
chx:X_PlaintextV1 a owl:NamedIndividual, chx:PlaintextV1 ; rdfs:label "the old transport reads like a postcard"@en ; skos:definition "On the old v1 transport the first bytes sent were the magic fabfb5da, the word version is visible in the stream, and the session identifier of the connection is empty."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_PlaintextV1 a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); t = R['e8_transport']['v1']; (t['contains_magic'], t['contains_version_command'], t['first_bytes_a_to_b'][:8], t['transport_a'], t['session_id_a']) evaluates to (True, True, 'fabfb5da', 'v1', '')"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); t = R['e8_transport']['v1']; (t['contains_magic'], t['contains_version_command'], t['first_bytes_a_to_b'][:8], t['transport_a'], t['session_id_a'])" ; chx:output "(True, True, 'fabfb5da', 'v1', '')" .
chx:X_PlaintextV1 rd:hasIOExample chx:IO_PlaintextV1 .
chx:X_EncryptedV2 a owl:NamedIndividual, chx:EncryptedV2 ; rdfs:label "random-looking bytes"@en ; skos:definition "On the v2 transport of BIP 324 neither the magic nor the word version appears in the stream, the first 4,096 bytes have 7.953 bits of entropy per byte (of at most 8), and both sides hold the same 64-character session identifier."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_EncryptedV2 a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); t = R['e8_transport']['v2']; (t['contains_magic'], t['contains_version_command'], t['entropy_first_4096'], t['transport_a'], t['session_id_a'] == t['session_id_n'], len(t['session_id_a'])) evaluates to (False, False, 7.953, 'v2', True, 64)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); t = R['e8_transport']['v2']; (t['contains_magic'], t['contains_version_command'], t['entropy_first_4096'], t['transport_a'], t['session_id_a'] == t['session_id_n'], len(t['session_id_a']))" ; chx:output "(False, False, 7.953, 'v2', True, 64)" .
chx:X_EncryptedV2 rd:hasIOExample chx:IO_EncryptedV2 .
chx:X_V2DefaultHistory a owl:NamedIndividual, chx:V2DefaultHistory ; rdfs:label "off in 26, on in 27"@en ; skos:definition "Bitcoin Core 26.0 added the v2 transport off by default and 27.0 turned it on, DEFAULT_V2_TRANSPORT is true in the source, and 85.8 percent of the nodes of the census advertise P2P_V2, whereas the book says that the traffic is in the clear."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_V2DefaultHistory a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('core_relnotes_26.0.md', 'It is off by default'), L.has('core_relnotes_27.0.md', 'BIP324 v2 transport is now enabled by default'), L.const('core_src_net.h', 'DEFAULT_V2_TRANSPORT'), round(100 * L.bitnodes()['services']['P2P_V2'] / L.bitnodes()['total'], 1), L.has('book_ch10_network.adoc', 'communicates\\nentirely in the clear'.replace('\\n', ' '))) evaluates to (True, True, 'true', 85.8, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('core_relnotes_26.0.md', 'It is off by default'), L.has('core_relnotes_27.0.md', 'BIP324 v2 transport is now enabled by default'), L.const('core_src_net.h', 'DEFAULT_V2_TRANSPORT'), round(100 * L.bitnodes()['services']['P2P_V2'] / L.bitnodes()['total'], 1), L.has('book_ch10_network.adoc', 'communicates\\nentirely in the clear'.replace('\\n', ' ')))" ; chx:output "(True, True, 'true', 85.8, True)" .
chx:X_V2DefaultHistory rd:hasIOExample chx:IO_V2DefaultHistory .
chx:X_UnauthenticatedTransport a owl:NamedIndividual, chx:UnauthenticatedTransport ; rdfs:label "encryption without identity"@en ; skos:definition "BIP 324 encrypts the connection but does not authenticate the peer, so a man in the middle remains possible and only passive eavesdropping is stopped; its predecessor BIP 151 is closed."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_UnauthenticatedTransport a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('bip-0324.mediawiki', 'unencrypted and unauthenticated'), L.has('bip-0151.mediawiki', 'Status: Closed'), L.has('bip-0324.mediawiki', 'man-in-the-middle'), L.has('book_ch10_network.adoc', 'Encrypted and Authenticated Connections')) evaluates to (True, True, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('bip-0324.mediawiki', 'unencrypted and unauthenticated'), L.has('bip-0151.mediawiki', 'Status: Closed'), L.has('bip-0324.mediawiki', 'man-in-the-middle'), L.has('book_ch10_network.adoc', 'Encrypted and Authenticated Connections'))" ; chx:output "(True, True, True, True)" .
chx:X_UnauthenticatedTransport rd:hasIOExample chx:IO_UnauthenticatedTransport .
chx:X_FiveNetworks a owl:NamedIndividual, chx:FiveNetworks ; rdfs:label "IPv4, IPv6, Tor, I2P, CJDNS"@en ; skos:definition "The node lists five networks, ipv4 and ipv6 reachable and onion, i2p and cjdns not reachable without a proxy; a node started with a proxy reported onion as reachable at 127.0.0.1:9."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_FiveNetworks a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); n = R['networkinfo_A']['networks']; ([(x['name'], x['reachable']) for x in n], [x for x in R['e8_onion_node']['networks'] if x[1]]) evaluates to ([('ipv4', True), ('ipv6', True), ('onion', False), ('i2p', False), ('cjdns', False)], [['onion', True, '127.0.0.1:9']])"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); n = R['networkinfo_A']['networks']; ([(x['name'], x['reachable']) for x in n], [x for x in R['e8_onion_node']['networks'] if x[1]])" ; chx:output "([('ipv4', True), ('ipv6', True), ('onion', False), ('i2p', False), ('cjdns', False)], [['onion', True, '127.0.0.1:9']])" .
chx:X_FiveNetworks rd:hasIOExample chx:IO_FiveNetworks .
chx:X_TorHiddenService a owl:NamedIndividual, chx:TorHiddenService ; rdfs:label "-listenonion"@en ; skos:definition "A node creates a Tor onion service by itself when Tor's control port is there (the option -listenonion defaults to 1), 12,488 nodes of the census are onion addresses, and the book's log line tor: ADD_ONION successful is still the message."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_TorHiddenService a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('core_doc_tor.md', '-listenonion=0'), L.has('bitcoind_help_31.1.txt', 'Automatically create Tor onion service (default: 1)'), L.has('core_relnotes_28.0.md', '127.0.0.1:8334'), L.has('book_ch10_network.adoc', 'tor: ADD_ONION successful'), L.bitnodes()['nets']['onion']) evaluates to (True, True, True, True, 12488)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('core_doc_tor.md', '-listenonion=0'), L.has('bitcoind_help_31.1.txt', 'Automatically create Tor onion service (default: 1)'), L.has('core_relnotes_28.0.md', '127.0.0.1:8334'), L.has('book_ch10_network.adoc', 'tor: ADD_ONION successful'), L.bitnodes()['nets']['onion'])" ; chx:output "(True, True, True, True, 12488)" .
chx:X_TorHiddenService rd:hasIOExample chx:IO_TorHiddenService .
chx:X_I2pAndCjdns a owl:NamedIndividual, chx:I2pAndCjdns ; rdfs:label "4,208 I2P nodes, 1 CJDNS"@en ; skos:definition "Support for I2P came in release 22.0 and for CJDNS in 23.0, neither of which the book names, and the census holds 4,208 I2P nodes and one CJDNS node."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_I2pAndCjdns a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('core_relnotes_22.0.md', 'I2P (Invisible Internet Project)'), L.has('core_relnotes_23.0.md', 'Full support has been added for the CJDNS network'), L.bitnodes()['nets']['i2p'], L.bitnodes()['nets']['cjdns']) evaluates to (True, True, 4208, 1)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('core_relnotes_22.0.md', 'I2P (Invisible Internet Project)'), L.has('core_relnotes_23.0.md', 'Full support has been added for the CJDNS network'), L.bitnodes()['nets']['i2p'], L.bitnodes()['nets']['cjdns'])" ; chx:output "(True, True, 4208, 1)" .
chx:X_I2pAndCjdns rd:hasIOExample chx:IO_I2pAndCjdns .
chx:X_EclipseAttack a owl:NamedIndividual, chx:EclipseAttack ; rdfs:label "Heilman et al., 2015"@en ; skos:definition "The eclipse attack of Heilman and colleagues surrounds a victim with the attacker's addresses; the paper's title and the anchor-connection defence both stand in the saved copies."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_EclipseAttack a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('heilman_2015_eclipse.pdf', 'Eclipse Attacks on Bitcoin’s Peer-to-Peer Network'), L.has('optech_topic_eclipse_attacks.html', 'anchor connections')) evaluates to (True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('heilman_2015_eclipse.pdf', 'Eclipse Attacks on Bitcoin’s Peer-to-Peer Network'), L.has('optech_topic_eclipse_attacks.html', 'anchor connections'))" ; chx:output "(True, True)" .
chx:X_EclipseAttack rd:hasIOExample chx:IO_EclipseAttack .
chx:X_RoutingAttack a owl:NamedIndividual, chx:RoutingAttack ; rdfs:label "Apostolaki et al., 2017"@en ; skos:definition "The routing attack of Apostolaki and colleagues needs control of network routes and not of nodes, and the paper states that it can isolate about 50 percent of the mining power."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_RoutingAttack a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('apostolaki_2017_hijacking.pdf', 'isolate ∼50% of the mining power'),) evaluates to (True,)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.has('apostolaki_2017_hijacking.pdf', 'isolate ∼50% of the mining power'),)" ; chx:output "(True,)" .
chx:X_RoutingAttack rd:hasIOExample chx:IO_RoutingAttack .
chx:X_TxAnnouncementByWtxid a owl:NamedIndividual, chx:TxAnnouncementByWtxid ; rdfs:label "MSG_WTX"@en ; skos:definition "With wtxid relay the transactions were announced with inv entries of type 5 (MSG_WTX) to the normal peer and to the feefilter peer, and the transaction the script received had the txid of the one with the high fee rate."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_TxAnnouncementByWtxid a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); r = R['e5_relay']; ([i[1] for i in r['invs']['normal_wtxidrelay']], [i[1] for i in r['invs']['feefilter_5sat']], r['tx_received_txid'] == r['txid_high'], L.has('bip-0339.mediawiki', 'MSG_WTX (0x00000005)')) evaluates to ([5, 5], [1], True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); r = R['e5_relay']; ([i[1] for i in r['invs']['normal_wtxidrelay']], [i[1] for i in r['invs']['feefilter_5sat']], r['tx_received_txid'] == r['txid_high'], L.has('bip-0339.mediawiki', 'MSG_WTX (0x00000005)'))" ; chx:output "([5, 5], [1], True, True)" .
chx:X_TxAnnouncementByWtxid rd:hasIOExample chx:IO_TxAnnouncementByWtxid .
chx:X_FeefilterHonoured a owl:NamedIndividual, chx:FeefilterHonoured ; rdfs:label "feefilter 5 sat/vB"@en ; skos:definition "A peer that sent feefilter for 5,000 satoshis per kilovirtual byte (5 per virtual byte) was announced only the transaction of 20.0 satoshis per virtual byte and not the one of 2.0, and the node's own feefilter to its peer was 100 satoshis per kilovirtual byte, 0.1 per virtual byte."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_FeefilterHonoured a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); r = R['e5_relay']; (round(r['feerate_low'], 1), round(r['feerate_high'], 1), r['peer_feefilter_sat_per_kvb'], [i[2] for i in r['invs']['feefilter_5sat']] == [r['txid_high']], R['e1_handshake']['feefilter']) evaluates to (2.0, 20.0, 5000, True, [100])"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); r = R['e5_relay']; (round(r['feerate_low'], 1), round(r['feerate_high'], 1), r['peer_feefilter_sat_per_kvb'], [i[2] for i in r['invs']['feefilter_5sat']] == [r['txid_high']], R['e1_handshake']['feefilter'])" ; chx:output "(2.0, 20.0, 5000, True, [100])" .
chx:X_FeefilterHonoured rd:hasIOExample chx:IO_FeefilterHonoured .
chx:X_MempoolIsLocalUtxoIsShared a owl:NamedIndividual, chx:MempoolIsLocalUtxoIsShared ; rdfs:label "two mempools, one UTXO set"@en ; skos:definition "Two connected nodes held 6 and 0 transactions in their mempools before a block (the second was started blocks-only and told the first not to send it transactions), and after the block both had the same UTXO set (107 outputs, the same hash), so the mempool is local and the UTXO set is shared."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_MempoolIsLocalUtxoIsShared a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); m = R['e10_mempool_vs_utxo']; (m['before_block']['F_mempool'], m['before_block']['G_mempool'], m['utxo_hash_F'] == m['utxo_hash_G'], m['utxo_count_F'], m['before_block']['F_view_of_G_relaytxes']) evaluates to (6, 0, True, 107, False)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); m = R['e10_mempool_vs_utxo']; (m['before_block']['F_mempool'], m['before_block']['G_mempool'], m['utxo_hash_F'] == m['utxo_hash_G'], m['utxo_count_F'], m['before_block']['F_view_of_G_relaytxes'])" ; chx:output "(6, 0, True, 107, False)" .
chx:X_MempoolIsLocalUtxoIsShared rd:hasIOExample chx:IO_MempoolIsLocalUtxoIsShared .
chx:X_MempoolDefaults a owl:NamedIndividual, chx:MempoolDefaults ; rdfs:label "300 MB, 336 hours, 64 transactions"@en ; skos:definition "The mempool of Bitcoin Core 31.1 holds at most 300,000,000 bytes, expires transactions after 336 hours, takes replacements of any transaction (fullrbf true) and limits a cluster to 64 transactions."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_MempoolDefaults a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); i = R['e10_mempool_vs_utxo']['mempoolinfo_F']; (i['maxmempool'], i['fullrbf'], i['limitclustercount'], i['loaded'], L.has('bitcoind_help_31.1.txt', '(default: 336)')) evaluates to (300000000, True, 64, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); i = R['e10_mempool_vs_utxo']['mempoolinfo_F']; (i['maxmempool'], i['fullrbf'], i['limitclustercount'], i['loaded'], L.has('bitcoind_help_31.1.txt', '(default: 336)'))" ; chx:output "(300000000, True, 64, True, True)" .
chx:X_MempoolDefaults rd:hasIOExample chx:IO_MempoolDefaults .
chx:X_OrphanWaitsForParent a owl:NamedIndividual, chx:OrphanWaitsForParent ; rdfs:label "a child without its parent"@en ; skos:definition "A child whose parent was not known was asked for by wtxid (inv type 5), did not enter the mempool and was kept in the orphanage, where one entry of 191 bytes was listed."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_OrphanWaitsForParent a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); o = R['e4_orphan']; (o['node_asked_for_child'][0][0], o['child_in_mempool_after_child'], len(o['orphanage_after_child']['ok']), o['orphanage_after_child']['ok'][0]['txid'] == o['child']) evaluates to (5, False, 1, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); o = R['e4_orphan']; (o['node_asked_for_child'][0][0], o['child_in_mempool_after_child'], len(o['orphanage_after_child']['ok']), o['orphanage_after_child']['ok'][0]['txid'] == o['child'])" ; chx:output "(5, False, 1, True)" .
chx:X_OrphanWaitsForParent rd:hasIOExample chx:IO_OrphanWaitsForParent .
chx:X_NodeRequestsMissingParent a owl:NamedIndividual, chx:NodeRequestsMissingParent ; rdfs:label "getdata for the parent"@en ; skos:definition "After the orphan the node asked the announcing peer for the parent with getdata type 0x40000001 (MSG_WITNESS_TX), and since release 29.0 it asks all the peers that announced the orphan."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_NodeRequestsMissingParent a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); o = R['e4_orphan']; (hex(o['node_asked_for_parent'][0][0]), o['node_asked_for_parent'][0][1] == o['parent'], L.has('bip-0144.mediawiki', 'MSG_WITNESS_TX (0x40000001'), L.has('core_relnotes_29.0.md', 'download missing parents from all peers who announced the orphan')) evaluates to ('0x40000001', True, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); o = R['e4_orphan']; (hex(o['node_asked_for_parent'][0][0]), o['node_asked_for_parent'][0][1] == o['parent'], L.has('bip-0144.mediawiki', 'MSG_WITNESS_TX (0x40000001'), L.has('core_relnotes_29.0.md', 'download missing parents from all peers who announced the orphan'))" ; chx:output "('0x40000001', True, True, True)" .
chx:X_NodeRequestsMissingParent rd:hasIOExample chx:IO_NodeRequestsMissingParent .
chx:X_ParentReleasesOrphan a owl:NamedIndividual, chx:ParentReleasesOrphan ; rdfs:label "the orphan joins the mempool"@en ; skos:definition "When the parent arrived both parent and child were in the mempool and the orphanage was empty again."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_ParentReleasesOrphan a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); o = R['e4_orphan']; (o['parent_in_mempool_after'], o['child_in_mempool_after'], o['orphanage_after_parent']) evaluates to (True, True, {'ok': []})"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); o = R['e4_orphan']; (o['parent_in_mempool_after'], o['child_in_mempool_after'], o['orphanage_after_parent'])" ; chx:output "(True, True, {'ok': []})" .
chx:X_ParentReleasesOrphan rd:hasIOExample chx:IO_ParentReleasesOrphan .
chx:X_OrphanageLimits a owl:NamedIndividual, chx:OrphanageLimits ; rdfs:label "404,000 weight per peer"@en ; skos:definition "Release 30.0 limits the orphanage by entries plus a tenth of their inputs (at most 3,000) and by a total of 404,000 weight units times the number of peers, and release 31.0 removed the option -maxorphantx that the old limit of 100 orphans used."@en ; dcterms:source <http://example.org/sen0401/ch10/research> .
chx:IO_OrphanageLimits a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.const('core_src_node_txorphanage.h', 'DEFAULT_RESERVED_ORPHAN_WEIGHT_PER_PEER').replace(chr(39), chr(8217)), L.has('core_relnotes_30.0.md', 'must not exceed 3,000', '404,000'), L.has('core_relnotes_31.0.txt', 'The -maxorphantx startup option has been removed')) evaluates to ('404’000', True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch10_lib_v1_0_0 as L; import sen0401_ch10_p2p_v1_0_0 as P; R = L.run(); (L.const('core_src_node_txorphanage.h', 'DEFAULT_RESERVED_ORPHAN_WEIGHT_PER_PEER').replace(chr(39), chr(8217)), L.has('core_relnotes_30.0.md', 'must not exceed 3,000', '404,000'), L.has('core_relnotes_31.0.txt', 'The -maxorphantx startup option has been removed'))" ; chx:output "('404’000', True, True)" .
chx:X_OrphanageLimits rd:hasIOExample chx:IO_OrphanageLimits .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 10 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch10/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 10 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which claims of the chapter can be checked by computation, and what does the computation give?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What in the chapter has changed since the book went to print, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 10 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from Mastering Bitcoin 3rd edition's chapter 10 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0401/ch10/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.6, installed with uv on 2026-10-15."@en ;
