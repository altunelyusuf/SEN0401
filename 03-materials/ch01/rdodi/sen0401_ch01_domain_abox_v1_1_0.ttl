chx:X_BitcoinUnit a owl:NamedIndividual, chx:BitcoinUnit ; rdfs:label "bitcoin with a small b, Bitcoin with a capital B"@en ; skos:definition "The unit of currency is bitcoin with a small b; the system is Bitcoin with a capital B."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_SupplyCap a owl:NamedIndividual, chx:SupplyCap ; rdfs:label "the sum of every block subsidy"@en ; skos:definition "New bitcoin is created on a schedule that halves the subsidy every 210000 blocks, so the total supply stays just below 21 million."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_SupplyCap a owl:NamedIndividual, rd:IOExample ; rdfs:label "sum((50 * 10**8 >> era) * 210000 for era in range(33)) / 10**8 evaluates to 20999999.9769"@en ; chx:input "sum((50 * 10**8 >> era) * 210000 for era in range(33)) / 10**8" ; chx:output "20999999.9769" .
chx:X_SupplyCap rd:hasIOExample chx:IO_SupplyCap .
chx:X_Halving a owl:NamedIndividual, chx:Halving ; rdfs:label "the subsidy after four halvings"@en ; skos:definition "The block subsidy halves every 210000 blocks; after the halving at block 840000 on 2024-04-20 it is 3.125 bitcoin."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Halving a owl:NamedIndividual, rd:IOExample ; rdfs:label "(50 * 10**8 >> 4) / 10**8 evaluates to 3.125"@en ; chx:input "(50 * 10**8 >> 4) / 10**8" ; chx:output "3.125" .
chx:X_Halving rd:hasIOExample chx:IO_Halving .
chx:X_FloatingExchangeRate a owl:NamedIndividual, chx:FloatingExchangeRate ; rdfs:label "the BTC/USD rate"@en ; skos:definition "The price of bitcoin is set by markets: a floating exchange rate that moves with supply and demand."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_ProofOfWork a owl:NamedIndividual, chx:ProofOfWork ; rdfs:label "a toy search for a hash starting with 0000"@en ; skos:definition "Proof of work makes adding a block costly and easy to check; a toy version searches for a number whose SHA-256 hash starts with zeros."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_ProofOfWork a owl:NamedIndividual, rd:IOExample ; rdfs:label "next(n for n in range(10**6) if __import__('hashlib').sha256(f'SEN0401-{n}'.encode()).hexdigest().startswith('0000')) evaluates to 15083"@en ; chx:input "next(n for n in range(10**6) if __import__('hashlib').sha256(f'SEN0401-{n}'.encode()).hexdigest().startswith('0000'))" ; chx:output "15083" .
chx:X_ProofOfWork rd:hasIOExample chx:IO_ProofOfWork .
chx:X_DoubleSpend a owl:NamedIndividual, chx:DoubleSpend ; rdfs:label "spending the same coin twice"@en ; skos:definition "The double-spend problem - spending one unit twice - which Bitcoin's consensus solves without a central clearinghouse."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Whitepaper a owl:NamedIndividual, chx:Whitepaper ; rdfs:label "Bitcoin: A Peer-to-Peer Electronic Cash System"@en ; skos:definition "The 2008 paper by Satoshi Nakamoto that first described Bitcoin."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_ReferenceImplementation a owl:NamedIndividual, chx:ReferenceImplementation ; rdfs:label "Bitcoin Core"@en ; skos:definition "The software Nakamoto published in 2009, since revised by many programmers; Bitcoin Core's newest listed release is 31.1."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_DesktopWallet a owl:NamedIndividual, chx:DesktopWallet ; rdfs:label "a desktop wallet"@en ; skos:definition "The first type of Bitcoin wallet, run on a general-purpose operating system."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_MobileWallet a owl:NamedIndividual, chx:MobileWallet ; rdfs:label "a mobile wallet"@en ; skos:definition "The most common type of Bitcoin wallet, run on a smartphone."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_WebWallet a owl:NamedIndividual, chx:WebWallet ; rdfs:label "a web wallet"@en ; skos:definition "A wallet used through a web browser."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_FullNode a owl:NamedIndividual, chx:FullNode ; rdfs:label "a full node"@en ; skos:definition "A program that validates the entire history of Bitcoin transactions itself."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_LightweightClient a owl:NamedIndividual, chx:LightweightClient ; rdfs:label "a lightweight client"@en ; skos:definition "A client that relies on others for validation instead of checking every transaction itself."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_NoncustodialWallet a owl:NamedIndividual, chx:NoncustodialWallet ; rdfs:label "a noncustodial wallet"@en ; skos:definition "A wallet where only the user holds the keys - who controls the keys controls the bitcoin."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_RecoveryCode a owl:NamedIndividual, chx:RecoveryCode ; rdfs:label "a list of twelve words"@en ; skos:definition "A recovery code of words, numbers or letters chosen by the wallet from which its keys are generated; the book's samples follow BIP 39."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_BitcoinAddress a owl:NamedIndividual, chx:BitcoinAddress ; rdfs:label "an address shown as a QR code"@en ; skos:definition "A number derived from the private key that others use to pay you; a new one per invoice protects privacy."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_SendingAndReceiving a owl:NamedIndividual, chx:SendingAndReceiving ; rdfs:label "Alice paying Joe"@en ; skos:definition "Receiving shows an address or invoice; sending signs a transaction that spends to someone else's address."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_DecentralizedIdentity a owl:NamedIndividual, chx:DecentralizedIdentity ; rdfs:label "a DID controlled by its holder"@en ; skos:definition "W3C Decentralized Identifiers apply the same principle to identity: control by whoever holds the keys, with no central registry."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Virtual a owl:NamedIndividual, chx:Virtual ; rdfs:label "coins implied in transactions"@en ; skos:definition "There are no physical coins, not even individual digital coins; coins are implied in transactions."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Borderless a owl:NamedIndividual, chx:Borderless ; rdfs:label "money for the internet"@en ; skos:definition "Fast, secure and borderless - arguably the perfect form of money for the internet."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Decentralized a owl:NamedIndividual, chx:Decentralized ; rdfs:label "no single point of control"@en ; skos:definition "Free of any central authority or point of control that can be attacked or corrupted."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Robust a owl:NamedIndividual, chx:Robust ; rdfs:label "resisting intervention"@en ; skos:definition "Built to withstand intervention by antagonists, whether legitimate governments or criminal elements."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_PeerToPeerProtocol a owl:NamedIndividual, chx:PeerToPeerProtocol ; rdfs:label "a decentralized peer-to-peer network"@en ; skos:definition "The Bitcoin protocol: a decentralized peer-to-peer network."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_PublicJournal a owl:NamedIndividual, chx:PublicJournal ; rdfs:label "the blockchain"@en ; skos:definition "A public transaction journal: the blockchain."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_ConsensusRuleSet a owl:NamedIndividual, chx:ConsensusRuleSet ; rdfs:label "rules for validation and issuance"@en ; skos:definition "A set of rules for independent transaction validation and currency issuance."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_CentralBankReplacement a owl:NamedIndividual, chx:CentralBankReplacement ; rdfs:label "mining as minting and clearing"@en ; skos:definition "Mining decentralizes the currency-issuance and clearing functions of a central bank."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Deflation a owl:NamedIndividual, chx:Deflation ; rdfs:label "issuance ending around 2140"@en ; skos:definition "Issuance diminishes, so the currency is deflationary; after about 6.93 million blocks, around 2140, no new bitcoin is issued."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Deflation a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(2009 + 6_930_000 * 10 / (60 * 24 * 365.25), 1) evaluates to 2140.8"@en ; chx:input "round(2009 + 6_930_000 * 10 / (60 * 24 * 365.25), 1)" ; chx:output "2140.8" .
chx:X_Deflation rd:hasIOExample chx:IO_Deflation .
chx:X_BuyFromFriend a owl:NamedIndividual, chx:BuyFromFriend ; rdfs:label "a friend who has bitcoin"@en ; skos:definition "The least complicated way to get a first bitcoin: buy directly from someone who has some."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_EarnBitcoin a owl:NamedIndividual, chx:EarnBitcoin ; rdfs:label "payment for a product or service"@en ; skos:definition "Earn bitcoin by selling a product or service for it."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_BitcoinATM a owl:NamedIndividual, chx:BitcoinATM ; rdfs:label "a machine taking cash"@en ; skos:definition "A machine that accepts cash and sends bitcoin to a smartphone wallet."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_CurrencyExchange a owl:NamedIndividual, chx:CurrencyExchange ; rdfs:label "an exchange linked to a bank account"@en ; skos:definition "A currency exchange that swaps bitcoin with local currency."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 1 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch01/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 1 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which claims of the chapter can be checked by computation, and what does the computation give?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which concepts reach beyond the book into the current state of Bitcoin and the course theme, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 1 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from Mastering Bitcoin 3rd edition's chapter 1 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0401/ch01/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-09-24."@en ;
