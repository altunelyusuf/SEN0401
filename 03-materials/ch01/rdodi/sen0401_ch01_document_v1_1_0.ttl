chx:Document a doc:ReportSection ; rdfs:label "Bitcoin from first principles: chapter 1 of Mastering Bitcoin, 3rd edition, and Bitcoin today"@en ; skos:definition "This document renews chapter 1 of the 3rd edition of Mastering Bitcoin for SEN0401 (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01/research> ;
    doc:hasSection chx:S_Money, chx:S_Network, chx:S_Wallet, chx:S_Usage, chx:S_Nature .
chx:S_Money a doc:TaxonomicSection ; rdfs:label "Money"@en ; doc:sectionTitle "Money" ; doc:hierarchyLevel 1 ; doc:sectionOrder 1 ;
    skos:definition "Bitcoin is first of all money: a unit of account that is stored and transmitted among participants in the Bitcoin network (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Money> .
chx:S_Unit a doc:TaxonomicSection ; rdfs:label "Unit"@en ; doc:sectionTitle "Unit" ; doc:hierarchyLevel 2 ; doc:sectionOrder 2 ;
    doc:hasParentSection chx:S_Money ;
    skos:definition "The chapter's Introduction fixes the vocabulary before anything else, and the capital letter matters (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Unit> .
chx:S_BitcoinUnit a doc:ConceptSection ; rdfs:label "Bitcoin unit"@en ; doc:sectionTitle "Bitcoin unit" ; doc:hierarchyLevel 3 ; doc:sectionOrder 3 ;
    doc:hasParentSection chx:S_Unit ;
    skos:definition "The unit of currency is bitcoin with a small b, and the system is Bitcoin with a capital B, so a student who writes about both must keep the two apart (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#BitcoinUnit> .
chx:S_Supply a doc:TaxonomicSection ; rdfs:label "Supply"@en ; doc:sectionTitle "Supply" ; doc:hierarchyLevel 2 ; doc:sectionOrder 4 ;
    doc:hasParentSection chx:S_Money ;
    skos:definition "Bitcoin's supply follows a schedule written into the software rather than a decision by any authority (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Supply> .
chx:S_SupplyCap a doc:ConceptSection ; rdfs:label "Supply cap"@en ; doc:sectionTitle "Supply cap" ; doc:hierarchyLevel 3 ; doc:sectionOrder 5 ;
    doc:hasParentSection chx:S_Supply ;
    skos:definition "The schedule creates bitcoin in eras of 210000 blocks, halving each time, so the sum of every subsidy is 20999999.9769 bitcoin - just below 21 million, as the chapter says (Bitcoin Wiki, 2026)." ; dcterms:source <http://example.org/sen0401/ch01#SupplyCap> .
chx:S_Halving a doc:ConceptSection ; rdfs:label "Halving"@en ; doc:sectionTitle "Halving" ; doc:hierarchyLevel 3 ; doc:sectionOrder 6 ;
    doc:hasParentSection chx:S_Supply ;
    skos:definition "The subsidy halved at block 840000 on 2024-04-20, after the book was published, to 3.125 bitcoin per block (Bitcoin Wiki, 2026)." ; dcterms:source <http://example.org/sen0401/ch01#Halving> .
chx:S_Price a doc:TaxonomicSection ; rdfs:label "Price"@en ; doc:sectionTitle "Price" ; doc:hierarchyLevel 2 ; doc:sectionOrder 7 ;
    doc:hasParentSection chx:S_Money ;
    skos:definition "The section Finding the Current Price of Bitcoin answers who sets the price: nobody does, markets do (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Price> .
chx:S_FloatingExchangeRate a doc:ConceptSection ; rdfs:label "Floating exchange rate"@en ; doc:sectionTitle "Floating exchange rate" ; doc:hierarchyLevel 3 ; doc:sectionOrder 8 ;
    doc:hasParentSection chx:S_Price ;
    skos:definition "Bitcoin has a floating exchange rate: its value moves with supply and demand in the markets where it is traded, and pricing services average those markets (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#FloatingExchangeRate> .
chx:S_Issuance a doc:TaxonomicSection ; rdfs:label "Issuance"@en ; doc:sectionTitle "Issuance" ; doc:hierarchyLevel 2 ; doc:sectionOrder 9 ;
    doc:hasParentSection chx:S_Money ;
    skos:definition "The chapter explains who creates money in Bitcoin - no one, in the sense a central bank does (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Issuance> .
chx:S_CentralBankReplacement a doc:ConceptSection ; rdfs:label "Central bank replacement"@en ; doc:sectionTitle "Central bank replacement" ; doc:hierarchyLevel 3 ; doc:sectionOrder 10 ;
    doc:hasParentSection chx:S_Issuance ;
    skos:definition "Bitcoin mining decentralizes the currency-issuance and clearing functions of a central bank and replaces the need for any central bank (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#CentralBankReplacement> .
chx:S_Deflation a doc:ConceptSection ; rdfs:label "Deflation"@en ; doc:sectionTitle "Deflation" ; doc:hierarchyLevel 3 ; doc:sectionOrder 11 ;
    doc:hasParentSection chx:S_Issuance ;
    skos:definition "With diminishing issuance the currency is deflationary over the long term, and after about 6.93 million blocks, around 2140, no new bitcoin is issued; at ten minutes a block that reaches about 2140.8 (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Deflation> .
chx:S_Network a doc:TaxonomicSection ; rdfs:label "Network"@en ; doc:sectionTitle "Network" ; doc:hierarchyLevel 1 ; doc:sectionOrder 12 ;
    skos:definition "Bitcoin is also a network of participants that agree on transactions without a central authority (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Network> .
chx:S_Consensus a doc:TaxonomicSection ; rdfs:label "Consensus"@en ; doc:sectionTitle "Consensus" ; doc:hierarchyLevel 2 ; doc:sectionOrder 13 ;
    doc:hasParentSection chx:S_Network ;
    skos:definition "Consensus is the network's agreement about the state of transactions, reached without a trusted party (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Consensus> .
chx:S_ProofOfWork a doc:ConceptSection ; rdfs:label "Proof of work"@en ; doc:sectionTitle "Proof of work" ; doc:hierarchyLevel 3 ; doc:sectionOrder 14 ;
    doc:hasParentSection chx:S_Consensus ;
    skos:definition "Proof of work runs a global lottery every 10 minutes on average that lets the decentralized network reach consensus; it descends from Hashcash, which used costly computation to throttle abuse (Back, 2002)." ; dcterms:source <http://example.org/sen0401/ch01#ProofOfWork> .
chx:S_DoubleSpend a doc:ConceptSection ; rdfs:label "Double-spend"@en ; doc:sectionTitle "Double-spend" ; doc:hierarchyLevel 3 ; doc:sectionOrder 15 ;
    doc:hasParentSection chx:S_Consensus ;
    skos:definition "Proof of work solves the double-spend, the weakness of earlier digital currencies that had been handled only by clearing every transaction through a central clearinghouse (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#DoubleSpend> .
chx:S_History a doc:TaxonomicSection ; rdfs:label "History"@en ; doc:sectionTitle "History" ; doc:hierarchyLevel 2 ; doc:sectionOrder 16 ;
    doc:hasParentSection chx:S_Network ;
    skos:definition "The History of Bitcoin section traces the system from a paper to a running network (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#History> .
chx:S_Whitepaper a doc:ConceptSection ; rdfs:label "Whitepaper"@en ; doc:sectionTitle "Whitepaper" ; doc:hierarchyLevel 3 ; doc:sectionOrder 17 ;
    doc:hasParentSection chx:S_History ;
    skos:definition "Bitcoin was first described in 2008 in Bitcoin: A Peer-to-Peer Electronic Cash System, a paper written under the name Satoshi Nakamoto that proposes a purely peer-to-peer version of electronic cash (Nakamoto, 2008)." ; dcterms:source <http://example.org/sen0401/ch01#Whitepaper> .
chx:S_ReferenceImplementation a doc:ConceptSection ; rdfs:label "Reference implementation"@en ; doc:sectionTitle "Reference implementation" ; doc:hierarchyLevel 3 ; doc:sectionOrder 18 ;
    doc:hasParentSection chx:S_History ;
    skos:definition "The network started in 2009 from a reference implementation published by Nakamoto and revised since by many programmers; Bitcoin Core's releases page now lists 31.1 as its newest release (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch01#ReferenceImplementation> .
chx:S_Wallet a doc:TaxonomicSection ; rdfs:label "Wallet"@en ; doc:sectionTitle "Wallet" ; doc:hierarchyLevel 1 ; doc:sectionOrder 19 ;
    skos:definition "Getting Started turns to the wallet, the software through which people actually use Bitcoin, and Choosing a Bitcoin Wallet warns that the choice depends on use and expertise rather than any single brand (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Wallet> .
chx:S_WalletPlatform a doc:TaxonomicSection ; rdfs:label "Wallet platform"@en ; doc:sectionTitle "Wallet platform" ; doc:hierarchyLevel 2 ; doc:sectionOrder 20 ;
    doc:hasParentSection chx:S_Wallet ;
    skos:definition "The section Types of Bitcoin wallets sorts wallets first by the platform they run on (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#WalletPlatform> .
chx:S_DesktopWallet a doc:ConceptSection ; rdfs:label "Desktop wallet"@en ; doc:sectionTitle "Desktop wallet" ; doc:hierarchyLevel 3 ; doc:sectionOrder 21 ;
    doc:hasParentSection chx:S_WalletPlatform ;
    skos:definition "A desktop wallet was the first type of Bitcoin wallet, created as a reference implementation, and runs on general-purpose operating systems whose security is often weak (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#DesktopWallet> .
chx:S_MobileWallet a doc:ConceptSection ; rdfs:label "Mobile wallet"@en ; doc:sectionTitle "Mobile wallet" ; doc:hierarchyLevel 3 ; doc:sectionOrder 22 ;
    doc:hasParentSection chx:S_WalletPlatform ;
    skos:definition "A mobile wallet is the most common type of Bitcoin wallet, running on smartphone operating systems such as iOS and Android (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#MobileWallet> .
chx:S_WebWallet a doc:ConceptSection ; rdfs:label "Web wallet"@en ; doc:sectionTitle "Web wallet" ; doc:hierarchyLevel 3 ; doc:sectionOrder 23 ;
    doc:hasParentSection chx:S_WalletPlatform ;
    skos:definition "Web wallets are accessed through a web browser, which makes them convenient and places trust in whoever runs the service (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#WebWallet> .
chx:S_NodeType a doc:TaxonomicSection ; rdfs:label "Node type"@en ; doc:sectionTitle "Node type" ; doc:hierarchyLevel 2 ; doc:sectionOrder 24 ;
    doc:hasParentSection chx:S_Wallet ;
    skos:definition "The section Full node versus Lightweight sorts wallets by how much of the network's work they do themselves (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#NodeType> .
chx:S_FullNode a doc:ConceptSection ; rdfs:label "Full node"@en ; doc:sectionTitle "Full node" ; doc:hierarchyLevel 3 ; doc:sectionOrder 25 ;
    doc:hasParentSection chx:S_NodeType ;
    skos:definition "A full node validates the entire history of Bitcoin transactions itself, so it depends on nobody else for the truth of the ledger (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#FullNode> .
chx:S_LightweightClient a doc:ConceptSection ; rdfs:label "Lightweight client"@en ; doc:sectionTitle "Lightweight client" ; doc:hierarchyLevel 3 ; doc:sectionOrder 26 ;
    doc:hasParentSection chx:S_NodeType ;
    skos:definition "A lightweight client relies on other nodes for validation, trading some independence for convenience (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#LightweightClient> .
chx:S_KeyControl a doc:TaxonomicSection ; rdfs:label "Key control"@en ; doc:sectionTitle "Key control" ; doc:hierarchyLevel 2 ; doc:sectionOrder 27 ;
    doc:hasParentSection chx:S_Wallet ;
    skos:definition "The section Who controls the keys asks the question that decides who really owns the bitcoin (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#KeyControl> .
chx:S_NoncustodialWallet a doc:ConceptSection ; rdfs:label "Noncustodial wallet"@en ; doc:sectionTitle "Noncustodial wallet" ; doc:hierarchyLevel 3 ; doc:sectionOrder 28 ;
    doc:hasParentSection chx:S_KeyControl ;
    skos:definition "In a noncustodial wallet only the user holds the keys, so only the user can spend - and only the user can lose access (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#NoncustodialWallet> .
chx:S_Backup a doc:TaxonomicSection ; rdfs:label "Backup"@en ; doc:sectionTitle "Backup" ; doc:hierarchyLevel 2 ; doc:sectionOrder 29 ;
    doc:hasParentSection chx:S_Wallet ;
    skos:definition "Because the user holds the keys, the user must also be able to restore them, which is what the section Recovery Codes is about (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Backup> .
chx:S_RecoveryCode a doc:ConceptSection ; rdfs:label "Recovery code"@en ; doc:sectionTitle "Recovery code" ; doc:hierarchyLevel 3 ; doc:sectionOrder 30 ;
    doc:hasParentSection chx:S_Backup ;
    skos:definition "A recovery code is a list of words, numbers or letters chosen randomly by the wallet and used as the basis for its keys; the book's samples follow BIP 39, whose initial entropy is 128 to 256 bits (Palatinus et al., 2013)." ; dcterms:source <http://example.org/sen0401/ch01#RecoveryCode> .
chx:S_Usage a doc:TaxonomicSection ; rdfs:label "Usage"@en ; doc:sectionTitle "Usage" ; doc:hierarchyLevel 1 ; doc:sectionOrder 31 ;
    skos:definition "The rest of the chapter follows Alice through Quick Start, Getting Your First Bitcoin, and Sending and Receiving Bitcoin (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Usage> .
chx:S_Address a doc:TaxonomicSection ; rdfs:label "Address"@en ; doc:sectionTitle "Address" ; doc:hierarchyLevel 2 ; doc:sectionOrder 32 ;
    doc:hasParentSection chx:S_Usage ;
    skos:definition "The section Bitcoin Addresses explains what a user gives others in order to be paid (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Address> .
chx:S_BitcoinAddress a doc:ConceptSection ; rdfs:label "Bitcoin address"@en ; doc:sectionTitle "Bitcoin address" ; doc:hierarchyLevel 3 ; doc:sectionOrder 33 ;
    doc:hasParentSection chx:S_Address ;
    skos:definition "A Bitcoin address is derived from the user's private key and registered nowhere; sharing it lets others pay but never withdraw, and a new address for each invoice protects privacy (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#BitcoinAddress> .
chx:S_Transfer a doc:TaxonomicSection ; rdfs:label "Transfer"@en ; doc:sectionTitle "Transfer" ; doc:hierarchyLevel 2 ; doc:sectionOrder 34 ;
    doc:hasParentSection chx:S_Usage ;
    skos:definition "Receiving Bitcoin and Sending and Receiving Bitcoin show the two directions of a payment (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Transfer> .
chx:S_SendingAndReceiving a doc:ConceptSection ; rdfs:label "Sending and receiving"@en ; doc:sectionTitle "Sending and receiving" ; doc:hierarchyLevel 3 ; doc:sectionOrder 35 ;
    doc:hasParentSection chx:S_Transfer ;
    skos:definition "To receive, a wallet shows an address or invoice, often as a QR code; to send, the wallet signs a transaction spending to the recipient's address (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#SendingAndReceiving> .
chx:S_SemanticBridge a doc:TaxonomicSection ; rdfs:label "Semantic bridge"@en ; doc:sectionTitle "Semantic bridge" ; doc:hierarchyLevel 2 ; doc:sectionOrder 36 ;
    doc:hasParentSection chx:S_Usage ;
    skos:definition "The course theme of semantic technologies meets the chapter at its central idea: control by whoever holds the keys, without a central registry (World Wide Web Consortium, 2022)." ; dcterms:source <http://example.org/sen0401/ch01#SemanticBridge> .
chx:S_DecentralizedIdentity a doc:ConceptSection ; rdfs:label "Decentralized identity"@en ; doc:sectionTitle "Decentralized identity" ; doc:hierarchyLevel 3 ; doc:sectionOrder 37 ;
    doc:hasParentSection chx:S_SemanticBridge ;
    skos:definition "W3C's Decentralized Identifiers apply that idea to identity, and Verifiable Credentials build signed claims on top of it, so a project can carry the chapter's key principle into semantic web standards (World Wide Web Consortium, 2025)." ; dcterms:source <http://example.org/sen0401/ch01#DecentralizedIdentity> .
chx:S_Acquisition a doc:TaxonomicSection ; rdfs:label "Acquisition"@en ; doc:sectionTitle "Acquisition" ; doc:hierarchyLevel 2 ; doc:sectionOrder 38 ;
    doc:hasParentSection chx:S_Usage ;
    skos:definition "Getting Your First Bitcoin warns that bitcoin transactions are irreversible, so sellers accepting reversible card payments verify buyers first (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Acquisition> .
chx:S_BuyFromFriend a doc:ConceptSection ; rdfs:label "Buy from friend"@en ; doc:sectionTitle "Buy from friend" ; doc:hierarchyLevel 3 ; doc:sectionOrder 39 ;
    doc:hasParentSection chx:S_Acquisition ;
    skos:definition "Finding a friend who has bitcoin and buying directly is the least complicated way to start (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#BuyFromFriend> .
chx:S_EarnBitcoin a doc:ConceptSection ; rdfs:label "Earn bitcoin"@en ; doc:sectionTitle "Earn bitcoin" ; doc:hierarchyLevel 3 ; doc:sectionOrder 40 ;
    doc:hasParentSection chx:S_Acquisition ;
    skos:definition "A programmer can sell programming skills and a hairdresser can cut hair for bitcoin (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#EarnBitcoin> .
chx:S_BitcoinATM a doc:ConceptSection ; rdfs:label "Bitcoin ATM"@en ; doc:sectionTitle "Bitcoin ATM" ; doc:hierarchyLevel 3 ; doc:sectionOrder 41 ;
    doc:hasParentSection chx:S_Acquisition ;
    skos:definition "A Bitcoin ATM accepts cash and sends bitcoin to a smartphone wallet (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#BitcoinATM> .
chx:S_CurrencyExchange a doc:ConceptSection ; rdfs:label "Currency exchange"@en ; doc:sectionTitle "Currency exchange" ; doc:hierarchyLevel 3 ; doc:sectionOrder 42 ;
    doc:hasParentSection chx:S_Acquisition ;
    skos:definition "Many countries have currency exchanges linked to bank accounts that swap bitcoin with local currency (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#CurrencyExchange> .
chx:S_Nature a doc:TaxonomicSection ; rdfs:label "Nature"@en ; doc:sectionTitle "Nature" ; doc:hierarchyLevel 1 ; doc:sectionOrder 43 ;
    skos:definition "Before the history, the chapter says what kind of thing Bitcoin is; the owner's course notes gather this into characteristics and architecture (Altunel, 2021)." ; dcterms:source <http://example.org/sen0401/ch01#Nature> .
chx:S_Characteristic a doc:TaxonomicSection ; rdfs:label "Characteristic"@en ; doc:sectionTitle "Characteristic" ; doc:hierarchyLevel 2 ; doc:sectionOrder 44 ;
    doc:hasParentSection chx:S_Nature ;
    skos:definition "The chapter's opening pages describe Bitcoin by four characteristics, drawn together as a set in the owner's course notes (Altunel, 2021)." ; dcterms:source <http://example.org/sen0401/ch01#Characteristic> .
chx:S_Virtual a doc:ConceptSection ; rdfs:label "Virtual"@en ; doc:sectionTitle "Virtual" ; doc:hierarchyLevel 3 ; doc:sectionOrder 45 ;
    doc:hasParentSection chx:S_Characteristic ;
    skos:definition "Bitcoin is entirely virtual: there are no physical coins, not even individual digital coins, because the coins are implied in transactions (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Virtual> .
chx:S_Borderless a doc:ConceptSection ; rdfs:label "Borderless"@en ; doc:sectionTitle "Borderless" ; doc:hierarchyLevel 3 ; doc:sectionOrder 46 ;
    doc:hasParentSection chx:S_Characteristic ;
    skos:definition "Bitcoin is fast, secure and borderless, which makes it arguably the perfect form of money for the internet (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Borderless> .
chx:S_Decentralized a doc:ConceptSection ; rdfs:label "Decentralized"@en ; doc:sectionTitle "Decentralized" ; doc:hierarchyLevel 3 ; doc:sectionOrder 47 ;
    doc:hasParentSection chx:S_Characteristic ;
    skos:definition "Bitcoin is decentralized by design, free of any central authority or point of control that can be attacked or corrupted (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Decentralized> .
chx:S_Robust a doc:ConceptSection ; rdfs:label "Robust"@en ; doc:sectionTitle "Robust" ; doc:hierarchyLevel 3 ; doc:sectionOrder 48 ;
    doc:hasParentSection chx:S_Characteristic ;
    skos:definition "A decentralized currency was needed to be robust against intervention by antagonists, whether legitimate governments or criminal elements (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Robust> .
chx:S_Architecture a doc:TaxonomicSection ; rdfs:label "Architecture"@en ; doc:sectionTitle "Architecture" ; doc:hierarchyLevel 2 ; doc:sectionOrder 49 ;
    doc:hasParentSection chx:S_Nature ;
    skos:definition "Behind the scenes, the chapter lists four parts Bitcoin consists of, one of which - proof of work - appears under consensus (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#Architecture> .
chx:S_PeerToPeerProtocol a doc:ConceptSection ; rdfs:label "Peer-to-peer protocol"@en ; doc:sectionTitle "Peer-to-peer protocol" ; doc:hierarchyLevel 3 ; doc:sectionOrder 50 ;
    doc:hasParentSection chx:S_Architecture ;
    skos:definition "The Bitcoin protocol is a decentralized peer-to-peer network, so no server sits at the centre (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#PeerToPeerProtocol> .
chx:S_PublicJournal a doc:ConceptSection ; rdfs:label "Public journal"@en ; doc:sectionTitle "Public journal" ; doc:hierarchyLevel 3 ; doc:sectionOrder 51 ;
    doc:hasParentSection chx:S_Architecture ;
    skos:definition "The blockchain is a public transaction journal that anyone can read and verify (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#PublicJournal> .
chx:S_ConsensusRuleSet a doc:ConceptSection ; rdfs:label "Consensus rule set"@en ; doc:sectionTitle "Consensus rule set" ; doc:hierarchyLevel 3 ; doc:sectionOrder 52 ;
    doc:hasParentSection chx:S_Architecture ;
    skos:definition "The consensus rules are a set of rules for independent transaction validation and currency issuance (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch01#ConsensusRuleSet> .
