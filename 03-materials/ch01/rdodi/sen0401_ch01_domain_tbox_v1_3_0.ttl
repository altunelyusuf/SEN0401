chx:Money owl:disjointWith chx:Network .
chx:Money owl:disjointWith chx:Wallet .
chx:Money owl:disjointWith chx:Usage .
chx:Money owl:disjointWith chx:Foundations .
chx:Money owl:disjointWith chx:Nature .
chx:Network owl:disjointWith chx:Wallet .
chx:Network owl:disjointWith chx:Usage .
chx:Network owl:disjointWith chx:Foundations .
chx:Network owl:disjointWith chx:Nature .
chx:Wallet owl:disjointWith chx:Usage .
chx:Wallet owl:disjointWith chx:Foundations .
chx:Wallet owl:disjointWith chx:Nature .
chx:Usage owl:disjointWith chx:Foundations .
chx:Usage owl:disjointWith chx:Nature .
chx:Foundations owl:disjointWith chx:Nature .
chx:hasOwner a owl:ObjectProperty ; rdfs:label "owned by"@en ; rdfs:subPropertyOf rd:hasOwningConcept ;
    rdfs:comment "A concept owned by the concept it belongs to, as the chapter's examples use it between typed things; domain and range are the union of every type the A-Box shows on the two sides (BP-D57 step 3)."@en ;
    rdfs:domain [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> owl:Class ; owl:unionOf ( chx:Block chx:BlockSubsidy chx:Checksum chx:DifficultyAdjustment chx:DigitalSignature chx:Entropy chx:Halving chx:HashFunction chx:IdentityVerification chx:InputsAndOutputs chx:KeyStretching chx:KeyedHash chx:LightningNetwork chx:Malware chx:PaymentChannel chx:Phishing chx:PrivateKey chx:ProofOfWork chx:QrCode chx:SatoshiUnit chx:Timestamp chx:TransactionFee chx:Uri chx:VolumeWeightedAverage ) ] ;
    rdfs:range [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> owl:Class ; owl:unionOf ( chx:BitcoinAddress chx:BitcoinUnit chx:Block chx:Blockchain chx:Confirmation chx:CurrencyExchange chx:FloatingExchangeRate chx:Halving chx:Invoice chx:KeyStretching chx:Mining chx:OffchainPayment chx:PaymentChannel chx:RecoveryCode chx:SupplyCap chx:Transaction ) ] ;
    rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .

#################################################################
# Connectedness repair (discipline v2.19.0, BP-D56 and BP-D57), 2026-10-19.
# The datatype properties the A-Box uses and nothing declared, then the relations
# between the chapter's subject branches that the chapter's own sources state.
#################################################################
chx:input a owl:DatatypeProperty ; rdfs:label "input expression"@en ; rdfs:comment "The expression an input/output example evaluates."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:output a owl:DatatypeProperty ; rdfs:label "output value"@en ; rdfs:comment "The value that evaluating the example expression gives."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:canBeReadBy a owl:ObjectProperty ; rdfs:label "can be read by"@en ;
    rdfs:comment "An invoice can be read by a wallet. Basis: the chapter defines Invoice as 'a payment request that a wallet can read'."@en ;
    rdfs:domain chx:Invoice ; rdfs:range chx:Wallet ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:isDerivedFromKey a owl:ObjectProperty ; rdfs:label "is derived from"@en ;
    rdfs:comment "A Bitcoin address is derived from a private key. Basis: the chapter defines Bitcoin address as 'a number derived from the private key that others use to pay you'."@en ;
    rdfs:domain chx:BitcoinAddress ; rdfs:range chx:PrivateKey ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:holdsKeys a owl:ObjectProperty ; rdfs:label "holds the keys as"@en ;
    rdfs:comment "Key control says who holds the private keys: the user in a noncustodial wallet, a third-party custodian in a custodial one. Basis: the chapter defines Custodial wallet ('a third party, the custodian, holds the keys') and Noncustodial wallet ('only the user holds the keys')."@en ;
    rdfs:domain chx:KeyControl ; rdfs:range chx:PrivateKey ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:generatesKeys a owl:ObjectProperty ; rdfs:label "generates keys"@en ;
    rdfs:comment "A recovery code is the source from which a wallet's keys are generated. Basis: the chapter defines Recovery code as one 'from which all its keys are generated and from which the wallet can be restored'."@en ;
    rdfs:domain chx:RecoveryCode ; rdfs:range chx:PrivateKey ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:carriesChecksum a owl:ObjectProperty ; rdfs:label "carries a checksum"@en ;
    rdfs:comment "A BIP 39 recovery code carries a checksum. Basis: the chapter defines Checksum with 'a BIP 39 recovery code carries ENT/32 bits taken from a SHA-256 hash'."@en ;
    rdfs:domain chx:RecoveryCode ; rdfs:range chx:Checksum ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:specifiesRecoveryCode a owl:ObjectProperty ; rdfs:label "specifies the recovery code"@en ;
    rdfs:comment "A Bitcoin Improvement Proposal can specify the recovery code a wallet uses. Basis: the chapter defines BIP with 'BIP 39 describes the mnemonic code behind recovery codes'."@en ;
    rdfs:domain chx:BitcoinImprovementProposal ; rdfs:range chx:RecoveryCode ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:specifiesUriScheme a owl:ObjectProperty ; rdfs:label "specifies the URI scheme"@en ;
    rdfs:comment "A Bitcoin Improvement Proposal can specify how payment requests are written as a URI. Basis: the chapter defines URI with 'the bitcoin: scheme of BIP 21 writes an address, an amount and a label as a URI'."@en ;
    rdfs:domain chx:BitcoinImprovementProposal ; rdfs:range chx:Uri ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:includesWallet a owl:ObjectProperty ; rdfs:label "includes a wallet"@en ;
    rdfs:comment "The reference implementation's descendant includes a wallet. Basis: the chapter defines Reference implementation: 'Bitcoin Core is its descendant and includes a wallet'."@en ;
    rdfs:domain chx:ReferenceImplementation ; rdfs:range chx:Wallet ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:isPeerIn a owl:ObjectProperty ; rdfs:label "is a peer in"@en ;
    rdfs:comment "Every full node is a peer of the peer-to-peer network that the protocol defines. Basis: the chapter defines Peer-to-peer protocol: 'a decentralized peer-to-peer network in which every full node is a peer'."@en ;
    rdfs:domain chx:FullNode ; rdfs:range chx:PeerToPeerProtocol ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:isRecordedIn a owl:ObjectProperty ; rdfs:label "is recorded in"@en ;
    rdfs:comment "A transaction is made permanent on the blockchain. Basis: the chapter defines Transaction: 'broadcast over the network, collected into a block, and made permanent on the blockchain'."@en ;
    rdfs:domain chx:Transaction ; rdfs:range chx:Blockchain ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:recordsTransactions a owl:ObjectProperty ; rdfs:label "records transactions"@en ;
    rdfs:comment "The public journal records every confirmed transaction. Basis: the chapter defines Public journal: 'a public transaction journal, the blockchain, in which every confirmed transaction is recorded'."@en ;
    rdfs:domain chx:PublicJournal ; rdfs:range chx:Transaction ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:isSignedWith a owl:ObjectProperty ; rdfs:label "is signed with"@en ;
    rdfs:comment "A transaction is a signed data structure, and the signature is a digital signature made with a private key. Basis: the chapter defines Transaction as 'a signed data structure' and Digital signature as 'computed from data and a private key'."@en ;
    rdfs:domain chx:Transaction ; rdfs:range chx:DigitalSignature ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:earnedByMining a owl:ObjectProperty ; rdfs:label "is earned by"@en ;
    rdfs:comment "A transaction fee is the amount a sender adds for the miner who includes the transaction. Basis: the chapter defines Transaction fee as 'the amount a sender adds for the miner who includes the transaction in a block'."@en ;
    rdfs:domain chx:TransactionFee ; rdfs:range chx:Mining ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:earnsSubsidy a owl:ObjectProperty ; rdfs:label "earns the subsidy"@en ;
    rdfs:comment "Mining is the computation by which a participant tries to add a block and earn the reward, and the block subsidy is the new bitcoin a block may create for its miner. Basis: the chapter defines Mining ('add a block and earn the reward') and Block subsidy ('new bitcoin that a block may create for its miner')."@en ;
    rdfs:domain chx:Mining ; rdfs:range chx:BlockSubsidy ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:takesOverFunctionsOf a owl:ObjectProperty ; rdfs:label "takes over the functions of"@en ;
    rdfs:comment "Mining carries out the currency-issuance and clearing functions that a central bank carries out. Basis: the chapter defines Central bank replacement: 'Mining decentralizes the currency-issuance and clearing functions of a central bank'."@en ;
    rdfs:domain chx:Mining ; rdfs:range chx:CentralBank ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:setsPriceThrough a owl:ObjectProperty ; rdfs:label "sets the price through"@en ;
    rdfs:comment "Buyers and sellers swap bitcoin and local currency in a currency exchange, and the market sets the price as a floating exchange rate. Basis: the chapter defines Currency exchange ('a market where buyers and sellers swap bitcoin and local currency') and Floating exchange rate ('set by markets')."@en ;
    rdfs:domain chx:CurrencyExchange ; rdfs:range chx:FloatingExchangeRate ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:solvesProblem a owl:ObjectProperty ; rdfs:label "is a practical solution to"@en ;
    rdfs:comment "Bitcoin's proof of work is a practical solution of the Byzantine Generals' Problem. Basis: the chapter defines Byzantine Generals' Problem: 'Bitcoin's proof of work is a practical solution'."@en ;
    rdfs:domain chx:ProofOfWork ; rdfs:range chx:ByzantineGeneralsProblem ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:descendsFrom a owl:ObjectProperty ; rdfs:label "descends from"@en ;
    rdfs:comment "Bitcoin's proof of work descends from Hashcash. Basis: the chapter defines Hashcash: 'Bitcoin's proof of work descends from it'."@en ;
    rdfs:domain chx:ProofOfWork ; rdfs:range chx:Hashcash ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:preventsDoubleSpend a owl:ObjectProperty ; rdfs:label "prevents"@en ;
    rdfs:comment "Bitcoin's consensus prevents double-spending without a central clearing house. Basis: the chapter defines Double-spend: 'Bitcoin's consensus prevents it without a central clearinghouse'."@en ;
    rdfs:domain chx:Consensus ; rdfs:range chx:DoubleSpend ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:isAuthoredBy a owl:ObjectProperty ; rdfs:label "is authored by"@en ;
    rdfs:comment "The whitepaper is the 2008 paper by Satoshi Nakamoto. Basis: the chapter defines Whitepaper as 'the 2008 paper by Satoshi Nakamoto'."@en ;
    rdfs:domain chx:Whitepaper ; rdfs:range chx:SatoshiNakamoto ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:wasPublishedBy a owl:ObjectProperty ; rdfs:label "was published by"@en ;
    rdfs:comment "The reference implementation is the software that Nakamoto published in 2009. Basis: the chapter defines Reference implementation: 'the software that Nakamoto published in 2009'."@en ;
    rdfs:domain chx:ReferenceImplementation ; rdfs:range chx:SatoshiNakamoto ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
chx:reliesOn a owl:ObjectProperty ; rdfs:label "relies on"@en ;
    rdfs:comment "A lightweight client relies on a full node for most of its data. Basis: the chapter defines Lightweight client: 'relies on a full node or server for most data and validates only partly'."@en ;
    rdfs:domain chx:LightweightClient ; rdfs:range chx:FullNode ; rdfs:isDefinedBy <http://example.org/sen0401/ch01/tbox> .
