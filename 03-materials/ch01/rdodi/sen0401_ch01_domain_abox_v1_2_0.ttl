@prefix rd:      <http://example.org/rdodi/domain-ontology#> .
@prefix doc:     <http://example.org/rdodi/document-ontology#> .
@prefix sen0401: <http://example.org/sen0401#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

<http://example.org/sen0401/ch01/abox> a owl:Ontology ;
    rdfs:label "SEN0401 chapter 1 domain ontology - ABox"@en ; owl:versionInfo "1.2.0" ; owl:versionIRI <http://example.org/sen0401/ch01/abox/1.2.0> ; rdfs:comment "1.2.0 rewrites every explanation as four to six paragraphs of continuous prose, keeps every concept identifier of 1.1.0 with its parent, and adds the concepts the explanations needed (the two new subject branches Foundations and Standards among them, with the cryptographic primitives, the parts of the chain, the everyday computing terms, the threats, the objects of a payment, the newer offchain payment techniques and the standards bodies), found by an audit of the terms used; it also replaces the figures of 1.1.0 with values recomputed from the saved sources, so MAJOR in the text and MINOR in the structure; numbered MINOR because no identifier was removed."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:created "2026-09-24"^^xsd:date ; dcterms:modified "2026-10-04"^^xsd:date ;
    dcterms:identifier "sen0401_ch01_abox_v1_2_0" ; prov:wasRevisionOf <http://example.org/sen0401/ch01/abox/1.1.0> ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/ch01-rdodi-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

chx:X_BitcoinUnit a owl:NamedIndividual, chx:BitcoinUnit ; rdfs:label "bitcoin with a small b, Bitcoin with a capital B"@en ; skos:definition "The unit of currency is bitcoin with a small b, abbreviated BTC; the system is Bitcoin with a capital B."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_SatoshiUnit a owl:NamedIndividual, chx:SatoshiUnit ; rdfs:label "0.001 BTC equals 100000 satoshis"@en ; skos:definition "The satoshi is the smallest unit of bitcoin that can be recorded, one hundred-millionth of a bitcoin; amounts are counted in whole satoshis."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_SatoshiUnit a owl:NamedIndividual, rd:IOExample ; rdfs:label "int(__import__('decimal').Decimal('0.001') * 10**8) evaluates to 100000"@en ; chx:input "int(__import__('decimal').Decimal('0.001') * 10**8)" ; chx:output "100000" .
chx:X_SatoshiUnit rd:hasIOExample chx:IO_SatoshiUnit .
chx:X_SupplyCap a owl:NamedIndividual, chx:SupplyCap ; rdfs:label "the sum of every block subsidy"@en ; skos:definition "New bitcoin is created on a schedule that halves the subsidy every 210000 blocks, so the total supply stays just below 21 million."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_SupplyCap a owl:NamedIndividual, rd:IOExample ; rdfs:label "sum((50 * 10**8 >> era) * 210000 for era in range(33)) / 10**8 evaluates to 20999999.9769"@en ; chx:input "sum((50 * 10**8 >> era) * 210000 for era in range(33)) / 10**8" ; chx:output "20999999.9769" .
chx:X_SupplyCap rd:hasIOExample chx:IO_SupplyCap .
chx:X_Halving a owl:NamedIndividual, chx:Halving ; rdfs:label "the subsidy at block 840000"@en ; skos:definition "The block subsidy halves every 210000 blocks; at block 840000, on 2024-04-20, it fell to 3.125 bitcoin."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Halving a owl:NamedIndividual, rd:IOExample ; rdfs:label "(50 * 10**8 >> 840000 // 210000) / 10**8 evaluates to 3.125"@en ; chx:input "(50 * 10**8 >> 840000 // 210000) / 10**8" ; chx:output "3.125" .
chx:X_Halving rd:hasIOExample chx:IO_Halving .
chx:X_BlockSubsidy a owl:NamedIndividual, chx:BlockSubsidy ; rdfs:label "the subsidy of five eras"@en ; skos:definition "The block subsidy is the amount of new bitcoin that a block may create for its miner; it starts at 50 bitcoin and halves every 210000 blocks."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_BlockSubsidy a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(50 * 10**8 >> h // 210000) / 10**8 for h in (0, 210000, 420000, 630000, 840000)] evaluates to [50.0, 25.0, 12.5, 6.25, 3.125]"@en ; chx:input "[(50 * 10**8 >> h // 210000) / 10**8 for h in (0, 210000, 420000, 630000, 840000)]" ; chx:output "[50.0, 25.0, 12.5, 6.25, 3.125]" .
chx:X_BlockSubsidy rd:hasIOExample chx:IO_BlockSubsidy .
chx:X_FloatingExchangeRate a owl:NamedIndividual, chx:FloatingExchangeRate ; rdfs:label "the BTC/USD rate"@en ; skos:definition "The price of bitcoin is set by markets: a floating exchange rate that moves with supply and demand."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_FloatingExchangeRate a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(0.001 * 60000, 2) evaluates to 60.0"@en ; chx:input "round(0.001 * 60000, 2)" ; chx:output "60.0" .
chx:X_FloatingExchangeRate rd:hasIOExample chx:IO_FloatingExchangeRate .
chx:X_VolumeWeightedAverage a owl:NamedIndividual, chx:VolumeWeightedAverage ; rdfs:label "two trades, 3 units at 100 and 1 unit at 104"@en ; skos:definition "A volume-weighted average prices a currency pair by weighting each trade's price by its volume, so larger trades count for more."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_VolumeWeightedAverage a owl:NamedIndividual, rd:IOExample ; rdfs:label "sum(p * v for p, v in [(100, 3), (104, 1)]) / sum(v for p, v in [(100, 3), (104, 1)]) evaluates to 101.0"@en ; chx:input "sum(p * v for p, v in [(100, 3), (104, 1)]) / sum(v for p, v in [(100, 3), (104, 1)])" ; chx:output "101.0" .
chx:X_VolumeWeightedAverage rd:hasIOExample chx:IO_VolumeWeightedAverage .
chx:X_CentralBank a owl:NamedIndividual, chx:CentralBank ; rdfs:label "a bank that issues the national currency"@en ; skos:definition "A central bank is the institution that controls the creation of a national currency; Bitcoin has none, and its issuance is set by rules."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_ClearingHouse a owl:NamedIndividual, chx:ClearingHouse ; rdfs:label "a central clearinghouse settling all transactions"@en ; skos:definition "A clearing house is a central party that records and settles transactions; traditional digital money relied on one, and the term clearing means the confirmation of a payment."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_CentralBankReplacement a owl:NamedIndividual, chx:CentralBankReplacement ; rdfs:label "mining as minting and clearing"@en ; skos:definition "Mining decentralizes the currency-issuance and clearing functions of a central bank and replaces the need for any central bank."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Deflation a owl:NamedIndividual, chx:Deflation ; rdfs:label "the date when the subsidy reaches zero"@en ; skos:definition "Because issuance diminishes and ends, the currency is deflationary over the long term; the last non-zero subsidy falls in the year 2140 at the target pace."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Deflation a owl:NamedIndividual, rd:IOExample ; rdfs:label "str((__import__('datetime').datetime(2009, 1, 3, 18, 15, 5) + __import__('datetime').timedelta(seconds=6_930_000 * 600)).date()) evaluates to '2140-10-08'"@en ; chx:input "str((__import__('datetime').datetime(2009, 1, 3, 18, 15, 5) + __import__('datetime').timedelta(seconds=6_930_000 * 600)).date())" ; chx:output "'2140-10-08'" .
chx:X_Deflation rd:hasIOExample chx:IO_Deflation .
chx:X_ProofOfWork a owl:NamedIndividual, chx:ProofOfWork ; rdfs:label "a toy search for a hash starting with 0000"@en ; skos:definition "Proof of work makes adding a block costly and easy to check; a toy version searches for a number whose SHA-256 hash starts with zeros."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_ProofOfWork a owl:NamedIndividual, rd:IOExample ; rdfs:label "next(n for n in range(10**6) if __import__('hashlib').sha256(f'SEN0401-{n}'.encode()).hexdigest().startswith('0000')) evaluates to 15083"@en ; chx:input "next(n for n in range(10**6) if __import__('hashlib').sha256(f'SEN0401-{n}'.encode()).hexdigest().startswith('0000'))" ; chx:output "15083" .
chx:X_ProofOfWork rd:hasIOExample chx:IO_ProofOfWork .
chx:X_DoubleSpend a owl:NamedIndividual, chx:DoubleSpend ; rdfs:label "spending the same coin twice"@en ; skos:definition "The double-spend problem is the possibility of spending one unit of digital money twice; Bitcoin's consensus prevents it without a central clearinghouse."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_DoubleSpend a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(c not in s) and not s.add(c) for s in [set()] for c in ('coin7', 'coin7')] evaluates to [True, False]"@en ; chx:input "[(c not in s) and not s.add(c) for s in [set()] for c in ('coin7', 'coin7')]" ; chx:output "[True, False]" .
chx:X_DoubleSpend rd:hasIOExample chx:IO_DoubleSpend .
chx:X_Mining a owl:NamedIndividual, chx:Mining ; rdfs:label "one new block every 10 minutes"@en ; skos:definition "Mining is the repeated computation, referring to a list of recent transactions, by which a participant tries to add a block and earn the reward."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Mining a owl:NamedIndividual, rd:IOExample ; rdfs:label "24 * 60 // 10 evaluates to 144"@en ; chx:input "24 * 60 // 10" ; chx:output "144" .
chx:X_Mining rd:hasIOExample chx:IO_Mining .
chx:X_DifficultyAdjustment a owl:NamedIndividual, chx:DifficultyAdjustment ; rdfs:label "2016 blocks in two weeks at 10 minutes each"@en ; skos:definition "The difficulty of the work is adjusted every 2016 blocks so that, on average, one block is found every 10 minutes whatever the total computing power."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_DifficultyAdjustment a owl:NamedIndividual, rd:IOExample ; rdfs:label "14 * 24 * 60 * 60 // (10 * 60) evaluates to 2016"@en ; chx:input "14 * 24 * 60 * 60 // (10 * 60)" ; chx:output "2016" .
chx:X_DifficultyAdjustment rd:hasIOExample chx:IO_DifficultyAdjustment .
chx:X_ByzantineGeneralsProblem a owl:NamedIndividual, chx:ByzantineGeneralsProblem ; rdfs:label "generals agreeing to attack by messenger"@en ; skos:definition "The Byzantine Generals' Problem asks how participants without a leader can agree on a course of action over an unreliable network; Bitcoin's proof of work is a practical solution."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Whitepaper a owl:NamedIndividual, chx:Whitepaper ; rdfs:label "Bitcoin: A Peer-to-Peer Electronic Cash System"@en ; skos:definition "The 2008 paper by Satoshi Nakamoto that first described Bitcoin as a purely peer-to-peer version of electronic cash."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_ReferenceImplementation a owl:NamedIndividual, chx:ReferenceImplementation ; rdfs:label "Bitcoin Core"@en ; skos:definition "The software that Nakamoto published in 2009 and many programmers have revised since; Bitcoin Core is its descendant and includes a wallet."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_SatoshiNakamoto a owl:NamedIndividual, chx:SatoshiNakamoto ; rdfs:label "the author of the whitepaper"@en ; skos:definition "Satoshi Nakamoto is the alias of the person or people who designed Bitcoin; their identity is unknown and they withdrew from the public in April 2011."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Hashcash a owl:NamedIndividual, chx:Hashcash ; rdfs:label "a hash with leading zero bits"@en ; skos:definition "Hashcash is a proof-of-work scheme proposed by Adam Back in 1997 to throttle abuse of un-metered resources such as email; Bitcoin's proof of work descends from it."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Hashcash a owl:NamedIndividual, rd:IOExample ; rdfs:label "format(int(__import__('hashlib').sha256(b'SEN0401-15083').hexdigest(), 16), '0256b').index('1') evaluates to 16"@en ; chx:input "format(int(__import__('hashlib').sha256(b'SEN0401-15083').hexdigest(), 16), '0256b').index('1')" ; chx:output "16" .
chx:X_Hashcash rd:hasIOExample chx:IO_Hashcash .
chx:X_PriorDigitalCurrency a owl:NamedIndividual, chx:PriorDigitalCurrency ; rdfs:label "early digital currencies of the 1980s"@en ; skos:definition "Digital currencies before Bitcoin used cryptography but were centralized and therefore easy to attack, which is the problem Bitcoin was designed to avoid."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_BitcoinImprovementProposal a owl:NamedIndividual, chx:BitcoinImprovementProposal ; rdfs:label "BIP 39"@en ; skos:definition "A Bitcoin Improvement Proposal (BIP) is a numbered design document that specifies a change or a convention; BIP 39 describes the mnemonic code behind recovery codes."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_BitcoinImprovementProposal a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(ent, ent // 32, (ent + ent // 32) // 11) for ent in (128, 256)] evaluates to [(128, 4, 12), (256, 8, 24)]"@en ; chx:input "[(ent, ent // 32, (ent + ent // 32) // 11) for ent in (128, 256)]" ; chx:output "[(128, 4, 12), (256, 8, 24)]" .
chx:X_BitcoinImprovementProposal rd:hasIOExample chx:IO_BitcoinImprovementProposal .
chx:X_OpenSourceSoftware a owl:NamedIndividual, chx:OpenSourceSoftware ; rdfs:label "Bitcoin Core published under a licence"@en ; skos:definition "Open source software is distributed with its source code under terms that allow free redistribution, modification and derived works."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_DesktopWallet a owl:NamedIndividual, chx:DesktopWallet ; rdfs:label "a desktop wallet"@en ; skos:definition "The first type of Bitcoin wallet, run on a general-purpose operating system such as Windows or macOS."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_MobileWallet a owl:NamedIndividual, chx:MobileWallet ; rdfs:label "a mobile wallet"@en ; skos:definition "The most common type of Bitcoin wallet, run on a smartphone operating system such as iOS or Android."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_WebWallet a owl:NamedIndividual, chx:WebWallet ; rdfs:label "a web wallet"@en ; skos:definition "A wallet used through a web browser, whose data usually lives on a server owned by a third party."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_HardwareSigningDevice a owl:NamedIndividual, chx:HardwareSigningDevice ; rdfs:label "a device that stores keys and signs"@en ; skos:definition "A hardware signing device stores keys and signs transactions with special-purpose hardware; it must be paired with a full-featured wallet to send and receive."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_FullNode a owl:NamedIndividual, chx:FullNode ; rdfs:label "a full node"@en ; skos:definition "A program that validates the entire history of Bitcoin transactions itself and may serve data to other programs."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_LightweightClient a owl:NamedIndividual, chx:LightweightClient ; rdfs:label "a lightweight client"@en ; skos:definition "A client that keeps the wallet locally but relies on a full node or server for most data and validates only partly."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_ThirdPartyApiClient a owl:NamedIndividual, chx:ThirdPartyApiClient ; rdfs:label "a client of a remote service"@en ; skos:definition "A third-party API client uses a remote system's programming interface instead of the Bitcoin network and trusts it for correct information and privacy."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_PeerAndClient a owl:NamedIndividual, chx:PeerAndClient ; rdfs:label "full nodes as peers, wallets as clients"@en ; skos:definition "In the peer-to-peer network, full nodes are the peers and lightweight wallets are clients that depend on one or more peers for valid data."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_NoncustodialWallet a owl:NamedIndividual, chx:NoncustodialWallet ; rdfs:label "a noncustodial wallet"@en ; skos:definition "A wallet where only the user holds the keys, so only the user controls and can lose the bitcoin."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_CustodialWallet a owl:NamedIndividual, chx:CustodialWallet ; rdfs:label "an account with a custodian"@en ; skos:definition "A custodial wallet or account is one where a third party, the custodian, holds the keys and manages the funds for the user."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_RecoveryCode a owl:NamedIndividual, chx:RecoveryCode ; rdfs:label "a list of twelve words"@en ; skos:definition "A recovery code of words, numbers or letters chosen at random by the wallet, from which all its keys are generated and from which the wallet can be restored."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_RecoveryCode a owl:NamedIndividual, rd:IOExample ; rdfs:label "len('nephew dog crane clever quantum crazy purse traffic repeat fruit old clutch'.split()) evaluates to 12"@en ; chx:input "len('nephew dog crane clever quantum crazy purse traffic repeat fruit old clutch'.split())" ; chx:output "12" .
chx:X_RecoveryCode rd:hasIOExample chx:IO_RecoveryCode .
chx:X_WalletMetadata a owl:NamedIndividual, chx:WalletMetadata ; rdfs:label "labels attached to addresses and transactions"@en ; skos:definition "Wallet metadata is the data a user adds to a wallet, such as labels on addresses and transactions; a recovery code does not restore it."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_BitcoinAddress a owl:NamedIndividual, chx:BitcoinAddress ; rdfs:label "an address shown as a QR code"@en ; skos:definition "A number derived from the private key that others use to pay you; it is registered nowhere, and a new one per invoice protects privacy."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Invoice a owl:NamedIndividual, chx:Invoice ; rdfs:label "a QR code with an address and an amount"@en ; skos:definition "An invoice is a payment request that a wallet can read, carrying a destination address and often an amount and a description."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Invoice a owl:NamedIndividual, rd:IOExample ; rdfs:label "int(__import__('decimal').Decimal(__import__('urllib.parse', fromlist=['parse_qs']).parse_qs('amount=0.01577764&label=Bob%27s%20Store')['amount'][0]) * 10**8) evaluates to 1577764"@en ; chx:input "int(__import__('decimal').Decimal(__import__('urllib.parse', fromlist=['parse_qs']).parse_qs('amount=0.01577764&label=Bob%27s%20Store')['amount'][0]) * 10**8)" ; chx:output "1577764" .
chx:X_Invoice rd:hasIOExample chx:IO_Invoice .
chx:X_AddressReuse a owl:NamedIndividual, chx:AddressReuse ; rdfs:label "one address given to two payers"@en ; skos:definition "Using the same address for several payments lets others link and total them; a new address for each payment protects privacy."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_SendingAndReceiving a owl:NamedIndividual, chx:SendingAndReceiving ; rdfs:label "Alice paying Joe"@en ; skos:definition "Receiving shows an address or invoice; sending signs a transaction that spends to someone else's address."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_SendingAndReceiving a owl:NamedIndividual, rd:IOExample ; rdfs:label "(0.001 * 10**3, round(0.001 * 10**8)) evaluates to (1.0, 100000)"@en ; chx:input "(0.001 * 10**3, round(0.001 * 10**8))" ; chx:output "(1.0, 100000)" .
chx:X_SendingAndReceiving rd:hasIOExample chx:IO_SendingAndReceiving .
chx:X_Transaction a owl:NamedIndividual, chx:Transaction ; rdfs:label "Joe's signed payment to Alice"@en ; skos:definition "A transaction is a signed data structure that expresses a transfer of value; it is broadcast over the network, collected into a block, and made permanent on the blockchain."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Transaction a owl:NamedIndividual, rd:IOExample ; rdfs:label "{'to': 'Alice', 'amount_sat': 100000}['amount_sat'] / 10**8 evaluates to 0.001"@en ; chx:input "{'to': 'Alice', 'amount_sat': 100000}['amount_sat'] / 10**8" ; chx:output "0.001" .
chx:X_Transaction rd:hasIOExample chx:IO_Transaction .
chx:X_InputsAndOutputs a owl:NamedIndividual, chx:InputsAndOutputs ; rdfs:label "a transaction with one input and two outputs"@en ; skos:definition "A transaction's inputs identify the funds it spends and its outputs assign amounts to new owners; any difference between the totals is the fee."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_InputsAndOutputs a owl:NamedIndividual, rd:IOExample ; rdfs:label "(sum([110000]), sum([100000, 5000])) evaluates to (110000, 105000)"@en ; chx:input "(sum([110000]), sum([100000, 5000]))" ; chx:output "(110000, 105000)" .
chx:X_InputsAndOutputs rd:hasIOExample chx:IO_InputsAndOutputs .
chx:X_TransactionFee a owl:NamedIndividual, chx:TransactionFee ; rdfs:label "a fee of 10000 satoshis"@en ; skos:definition "A transaction fee is the amount a sender adds for the miner who includes the transaction in a block; a higher fee gives faster confirmation."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_TransactionFee a owl:NamedIndividual, rd:IOExample ; rdfs:label "110_000 - 100_000 evaluates to 10000"@en ; chx:input "110_000 - 100_000" ; chx:output "10000" .
chx:X_TransactionFee rd:hasIOExample chx:IO_TransactionFee .
chx:X_Confirmation a owl:NamedIndividual, chx:Confirmation ; rdfs:label "a transaction that has six confirmations"@en ; skos:definition "A confirmation counts the blocks that contain a transaction or follow it; each one makes reversal less likely, and the inclusion in a block is the clearing of the payment."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Confirmation a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda m, q, z: (lambda p: (lambda l: round(1 - sum(m.exp(-l) * l**k / m.factorial(k) * (1 - (q / p)**(z - k)) for k in range(z + 1)), 7))(z * q / p))(1 - q))(__import__('math'), 0.1, 6) evaluates to 0.0002428"@en ; chx:input "(lambda m, q, z: (lambda p: (lambda l: round(1 - sum(m.exp(-l) * l**k / m.factorial(k) * (1 - (q / p)**(z - k)) for k in range(z + 1)), 7))(z * q / p))(1 - q))(__import__('math'), 0.1, 6)" ; chx:output "0.0002428" .
chx:X_Confirmation rd:hasIOExample chx:IO_Confirmation .
chx:X_Irreversibility a owl:NamedIndividual, chx:Irreversibility ; rdfs:label "a confirmed payment that cannot be recalled"@en ; skos:definition "Bitcoin transactions are irreversible, unlike card payments, bank transfers and other electronic payments, which can be reversed."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_OffchainPayment a owl:NamedIndividual, chx:OffchainPayment ; rdfs:label "a payment that is not stored in the public blockchain"@en ; skos:definition "An offchain payment moves value without recording every payment in the public blockchain, which lowers cost and improves privacy but changes what a backup must cover."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_DecentralizedIdentity a owl:NamedIndividual, chx:DecentralizedIdentity ; rdfs:label "a DID controlled by its holder"@en ; skos:definition "A W3C Decentralized Identifier is an identifier that its controller can prove control over without a central registry, applying the principle of control by keys to identity."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_VerifiableCredential a owl:NamedIndividual, chx:VerifiableCredential ; rdfs:label "a signed education certificate"@en ; skos:definition "A verifiable credential expresses claims made by an issuer, such as a driver's licence or education certificate, in a form protected by digital signatures that a holder can present to a verifier."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_BuyFromFriend a owl:NamedIndividual, chx:BuyFromFriend ; rdfs:label "a friend who has bitcoin"@en ; skos:definition "The least complicated way to get a first bitcoin: buy directly from someone who has some."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_EarnBitcoin a owl:NamedIndividual, chx:EarnBitcoin ; rdfs:label "payment for a product or service"@en ; skos:definition "Earning bitcoin means selling a product or service and being paid in it."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_BitcoinATM a owl:NamedIndividual, chx:BitcoinATM ; rdfs:label "a machine taking cash"@en ; skos:definition "A Bitcoin ATM is a machine that accepts cash and sends bitcoin to a smartphone wallet."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_CurrencyExchange a owl:NamedIndividual, chx:CurrencyExchange ; rdfs:label "an exchange linked to a bank account"@en ; skos:definition "A currency exchange is a market where buyers and sellers swap bitcoin and local currency, usually through a linked bank account."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_IdentityVerification a owl:NamedIndividual, chx:IdentityVerification ; rdfs:label "proof of identity at an exchange"@en ; skos:definition "Identity verification is the check of a customer's identity and credit-worthiness that companies converting traditional payments into bitcoin usually require."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_HashFunction a owl:NamedIndividual, chx:HashFunction ; rdfs:label "the SHA-256 hash of abc"@en ; skos:definition "A hash function maps data of any length to a fixed-length fingerprint; SHA-256 produces 256 bits, and any change to the input gives a different result."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_HashFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hashlib').sha256(b'abc').hexdigest() evaluates to 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad'"@en ; chx:input "__import__('hashlib').sha256(b'abc').hexdigest()" ; chx:output "'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad'" .
chx:X_HashFunction rd:hasIOExample chx:IO_HashFunction .
chx:X_DigitalSignature a owl:NamedIndividual, chx:DigitalSignature ; rdfs:label "a toy signature with tiny numbers"@en ; skos:definition "A digital signature is a value computed from data and a private key that anyone holding the matching public key can use to verify the origin and integrity of the data."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_DigitalSignature a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda n, e, d, m: (pow(m, d, n), pow(pow(m, d, n), e, n) == m, pow(pow(m, d, n), e, n) == 66))(3233, 17, 2753, 65) evaluates to (588, True, False)"@en ; chx:input "(lambda n, e, d, m: (pow(m, d, n), pow(pow(m, d, n), e, n) == m, pow(pow(m, d, n), e, n) == 66))(3233, 17, 2753, 65)" ; chx:output "(588, True, False)" .
chx:X_DigitalSignature rd:hasIOExample chx:IO_DigitalSignature .
chx:X_PublicKeyCryptography a owl:NamedIndividual, chx:PublicKeyCryptography ; rdfs:label "a key pair with tiny numbers"@en ; skos:definition "Public-key cryptography uses a pair of mathematically related keys, one public and one private, so that what one key does only the other can undo."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_PublicKeyCryptography a owl:NamedIndividual, rd:IOExample ; rdfs:label "pow(pow(65, 17, 3233), 2753, 3233) evaluates to 65"@en ; chx:input "pow(pow(65, 17, 3233), 2753, 3233)" ; chx:output "65" .
chx:X_PublicKeyCryptography rd:hasIOExample chx:IO_PublicKeyCryptography .
chx:X_PrivateKey a owl:NamedIndividual, chx:PrivateKey ; rdfs:label "a 256-bit secret number"@en ; skos:definition "A private key is the secret half of a key pair; in Bitcoin it is a very large number whose holder alone can sign transactions that spend the corresponding bitcoin."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_PrivateKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(str(2**256)) evaluates to 78"@en ; chx:input "len(str(2**256))" ; chx:output "78" .
chx:X_PrivateKey rd:hasIOExample chx:IO_PrivateKey .
chx:X_Entropy a owl:NamedIndividual, chx:Entropy ; rdfs:label "128 bits chosen at random"@en ; skos:definition "Entropy is a measure of unpredictability, counted in bits; a wallet needs enough of it that nobody can guess the key or recovery code."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Entropy a owl:NamedIndividual, rd:IOExample ; rdfs:label "(2048 .bit_length() - 1, 12 * 11, 128 + 128 // 32) evaluates to (11, 132, 132)"@en ; chx:input "(2048 .bit_length() - 1, 12 * 11, 128 + 128 // 32)" ; chx:output "(11, 132, 132)" .
chx:X_Entropy rd:hasIOExample chx:IO_Entropy .
chx:X_Checksum a owl:NamedIndividual, chx:Checksum ; rdfs:label "the first 4 bits of a SHA-256 hash"@en ; skos:definition "A checksum is a short value computed from data and stored with it so that changes can be detected; a BIP 39 recovery code carries ENT/32 bits taken from a SHA-256 hash."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Checksum a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hashlib').sha256(bytes(16)).digest()[0] >> 4 evaluates to 3"@en ; chx:input "__import__('hashlib').sha256(bytes(16)).digest()[0] >> 4" ; chx:output "3" .
chx:X_Checksum rd:hasIOExample chx:IO_Checksum .
chx:X_KeyedHash a owl:NamedIndividual, chx:KeyedHash ; rdfs:label "HMAC-SHA512 of a short message"@en ; skos:definition "A keyed hash, or message authentication code, mixes a secret key into a hash so that only a holder of the key can produce or confirm the result; HMAC is the standard construction."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_KeyedHash a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(__import__('hmac').new(b'key', b'message', 'sha512').digest()) evaluates to 64"@en ; chx:input "len(__import__('hmac').new(b'key', b'message', 'sha512').digest())" ; chx:output "64" .
chx:X_KeyedHash rd:hasIOExample chx:IO_KeyedHash .
chx:X_KeyStretching a owl:NamedIndividual, chx:KeyStretching ; rdfs:label "a 64-byte seed from PBKDF2"@en ; skos:definition "Key stretching derives a key from a secret by repeating a function many times, so that every guess of an attacker costs as much work as the honest computation."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_KeyStretching a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hmac\\npassword, salt, iters = b'abandon', b'mnemonic', 2048\\nu = hmac.new(password, salt + bytes([0, 0, 0, 1]), 'sha512').digest()\\nseed = u\\nfor _ in range(iters - 1):\\n    u = hmac.new(password, u, 'sha512').digest()\\n    seed = bytes(a ^ b for a, b in zip(seed, u))\\nresult = (len(seed), seed.hex()[:8])\", g), g['result'])[1])({}) evaluates to (64, 'd96147bf')"@en ; chx:input "(lambda g: (exec(\"import hmac\\npassword, salt, iters = b'abandon', b'mnemonic', 2048\\nu = hmac.new(password, salt + bytes([0, 0, 0, 1]), 'sha512').digest()\\nseed = u\\nfor _ in range(iters - 1):\\n    u = hmac.new(password, u, 'sha512').digest()\\n    seed = bytes(a ^ b for a, b in zip(seed, u))\\nresult = (len(seed), seed.hex()[:8])\", g), g['result'])[1])({})" ; chx:output "(64, 'd96147bf')" .
chx:X_KeyStretching rd:hasIOExample chx:IO_KeyStretching .
chx:X_Block a owl:NamedIndividual, chx:Block ; rdfs:label "the transactions of block 840000"@en ; skos:definition "A block is a group of transactions, marked with a time and committing to the previous block, that is added to the blockchain once it carries a valid proof of work."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Block a owl:NamedIndividual, rd:IOExample ; rdfs:label "(__import__('json').loads('{\"id\":\"0000000000000000000320283a032748cef8227873ff4872689bf23f1cda83a5\",\"height\":840000,\"version\":710926336,\"timestamp\":1713571767,\"tx_count\":3050,\"size\":2325617,\"weight\":3993281,\"merkle_root\":\"031b417c3a1828ddf3d6527fc210daafcc9218e81f98257f88d4d43bd7a5894f\",\"previousblockhash\":\"0000000000000000000172014ba58d66455762add0512355ad651207918494ab\",\"mediantime\":1713570208,\"nonce\":3932395645,\"bits\":386089497,\"difficulty\":86388558925171.02}')['tx_count'], __import__('json').loads('{\"id\":\"000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f\",\"height\":0,\"version\":1,\"timestamp\":1231006505,\"tx_count\":1,\"size\":285,\"weight\":1140,\"merkle_root\":\"4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b\",\"previousblockhash\":null,\"mediantime\":1231006505,\"nonce\":2083236893,\"bits\":486604799,\"difficulty\":1.0}')['tx_count']) evaluates to (3050, 1)"@en ; chx:input "(__import__('json').loads('{\"id\":\"0000000000000000000320283a032748cef8227873ff4872689bf23f1cda83a5\",\"height\":840000,\"version\":710926336,\"timestamp\":1713571767,\"tx_count\":3050,\"size\":2325617,\"weight\":3993281,\"merkle_root\":\"031b417c3a1828ddf3d6527fc210daafcc9218e81f98257f88d4d43bd7a5894f\",\"previousblockhash\":\"0000000000000000000172014ba58d66455762add0512355ad651207918494ab\",\"mediantime\":1713570208,\"nonce\":3932395645,\"bits\":386089497,\"difficulty\":86388558925171.02}')['tx_count'], __import__('json').loads('{\"id\":\"000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f\",\"height\":0,\"version\":1,\"timestamp\":1231006505,\"tx_count\":1,\"size\":285,\"weight\":1140,\"merkle_root\":\"4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b\",\"previousblockhash\":null,\"mediantime\":1231006505,\"nonce\":2083236893,\"bits\":486604799,\"difficulty\":1.0}')['tx_count'])" ; chx:output "(3050, 1)" .
chx:X_Block rd:hasIOExample chx:IO_Block .
chx:X_Blockchain a owl:NamedIndividual, chx:Blockchain ; rdfs:label "a chain of three linked blocks"@en ; skos:definition "The blockchain is the list of validated blocks, each linking to its predecessor all the way back to the first block; changing an old block breaks every later link."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Blockchain a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\ndef link(prev, data): return hashlib.sha256((prev + data).encode()).hexdigest()\\ndata = ['Joe pays Alice 1', 'Alice pays Eve 2', 'Eve pays Joe 3']\\ndef build(items):\\n    hs, prev = [], 'genesis'\\n    for d in items:\\n        prev = link(prev, d); hs.append(prev)\\n    return hs\\nstored = build(data)\\ntampered = ['Joe pays Alice 100'] + data[1:]\\nresult = (build(data) == stored, build(tampered) == stored)\", g), g['result'])[1])({}) evaluates to (True, False)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\ndef link(prev, data): return hashlib.sha256((prev + data).encode()).hexdigest()\\ndata = ['Joe pays Alice 1', 'Alice pays Eve 2', 'Eve pays Joe 3']\\ndef build(items):\\n    hs, prev = [], 'genesis'\\n    for d in items:\\n        prev = link(prev, d); hs.append(prev)\\n    return hs\\nstored = build(data)\\ntampered = ['Joe pays Alice 100'] + data[1:]\\nresult = (build(data) == stored, build(tampered) == stored)\", g), g['result'])[1])({})" ; chx:output "(True, False)" .
chx:X_Blockchain rd:hasIOExample chx:IO_Blockchain .
chx:X_Timestamp a owl:NamedIndividual, chx:Timestamp ; rdfs:label "the time of the first block"@en ; skos:definition "A timestamp is a recorded time attached to data; each block carries one, and together they place the transactions in an agreed order."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Timestamp a owl:NamedIndividual, rd:IOExample ; rdfs:label "str(__import__('datetime').datetime.fromtimestamp(1231006505, __import__('datetime').timezone.utc)) evaluates to '2009-01-03 18:15:05+00:00'"@en ; chx:input "str(__import__('datetime').datetime.fromtimestamp(1231006505, __import__('datetime').timezone.utc))" ; chx:output "'2009-01-03 18:15:05+00:00'" .
chx:X_Timestamp rd:hasIOExample chx:IO_Timestamp .
chx:X_Node a owl:NamedIndividual, chx:Node ; rdfs:label "a computer on the network"@en ; skos:definition "A node is a computer that takes part in the Bitcoin network and runs software that speaks its protocol; full nodes validate blocks and may also route, mine or serve wallets."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Internet a owl:NamedIndividual, chx:Internet ; rdfs:label "the network of networks"@en ; skos:definition "The Internet is a worldwide network of networks that uses the Internet protocol suite; Bitcoin users communicate over it primarily, although other transport networks can be used."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Protocol a owl:NamedIndividual, chx:Protocol ; rdfs:label "a shared set of rules"@en ; skos:definition "A protocol is a set of rules, formats and procedures that computers follow to exchange data; the Bitcoin protocol is the rules that nodes follow to talk to each other."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Http a owl:NamedIndividual, chx:Http ; rdfs:label "a request line of the web protocol"@en ; skos:definition "HTTP, the HyperText Transfer Protocol, is the network protocol by which browsers and servers exchange web pages; its requests are plain text."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Http a owl:NamedIndividual, rd:IOExample ; rdfs:label "'GET /index.html HTTP/1.1'.split(' ') evaluates to ['GET', '/index.html', 'HTTP/1.1']"@en ; chx:input "'GET /index.html HTTP/1.1'.split(' ')" ; chx:output "['GET', '/index.html', 'HTTP/1.1']" .
chx:X_Http rd:hasIOExample chx:IO_Http .
chx:X_WebBrowser a owl:NamedIndividual, chx:WebBrowser ; rdfs:label "the browsers Chrome, Safari and Firefox"@en ; skos:definition "A web browser is a program that retrieves and displays pages from the web and lets users reach further pages through links."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Server a owl:NamedIndividual, chx:Server ; rdfs:label "a computer that serves clients"@en ; skos:definition "A server is software or hardware that offers a service to clients over a network; Bitcoin's peer-to-peer design has no central server."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Api a owl:NamedIndividual, chx:Api ; rdfs:label "the interface a program offers to other programs"@en ; skos:definition "An API is a set of features and rules by which software interacts with other software; a third-party API client uses a remote system's API instead of the Bitcoin network."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Api a owl:NamedIndividual, rd:IOExample ; rdfs:label "'sha256' in __import__('hashlib').algorithms_guaranteed evaluates to True"@en ; chx:input "'sha256' in __import__('hashlib').algorithms_guaranteed" ; chx:output "True" .
chx:X_Api rd:hasIOExample chx:IO_Api .
chx:X_Uri a owl:NamedIndividual, chx:Uri ; rdfs:label "a bitcoin: payment link"@en ; skos:definition "A URI, a Uniform Resource Identifier, is a string that refers to a resource; the bitcoin: scheme of BIP 21 writes an address, an amount and a label as a URI."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Uri a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda u: (u.scheme, u.path, u.query))(__import__('urllib.parse', fromlist=['parse']).urlsplit('bitcoin:175tWpb8K1S7NmH4Zx6rewF9WQrcZv245W?amount=20.3&label=Luke-Jr')) evaluates to ('bitcoin', '175tWpb8K1S7NmH4Zx6rewF9WQrcZv245W', 'amount=20.3&label=Luke-Jr')"@en ; chx:input "(lambda u: (u.scheme, u.path, u.query))(__import__('urllib.parse', fromlist=['parse']).urlsplit('bitcoin:175tWpb8K1S7NmH4Zx6rewF9WQrcZv245W?amount=20.3&label=Luke-Jr'))" ; chx:output "('bitcoin', '175tWpb8K1S7NmH4Zx6rewF9WQrcZv245W', 'amount=20.3&label=Luke-Jr')" .
chx:X_Uri rd:hasIOExample chx:IO_Uri .
chx:X_QrCode a owl:NamedIndividual, chx:QrCode ; rdfs:label "the square of black and white dots"@en ; skos:definition "A QR code is a two-dimensional matrix barcode that a camera can read; wallets use it to hand over addresses and payment requests without typing."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_QrCode a owl:NamedIndividual, rd:IOExample ; rdfs:label "[21 + 4 * (v - 1) for v in (1, 40)] evaluates to [21, 177]"@en ; chx:input "[21 + 4 * (v - 1) for v in (1, 40)]" ; chx:output "[21, 177]" .
chx:X_QrCode rd:hasIOExample chx:IO_QrCode .
chx:X_Database a owl:NamedIndividual, chx:Database ; rdfs:label "the wallet's own store of labels"@en ; skos:definition "A database is a storage system that collects organized data so that it is easier to search, structure and extend; a wallet keeps its labels and history in one."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Database a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"rows = [{'address': 'addr1', 'label': 'Alice'}, {'address': 'addr2', 'label': 'Joe'}]\\nindex = {r['address']: r for r in rows}\\nresult = (index['addr1']['label'], [r['label'] for r in rows if r['address'] == 'addr2'], 'addr3' in index)\", g), g['result'])[1])({}) evaluates to ('Alice', ['Joe'], False)"@en ; chx:input "(lambda g: (exec(\"rows = [{'address': 'addr1', 'label': 'Alice'}, {'address': 'addr2', 'label': 'Joe'}]\\nindex = {r['address']: r for r in rows}\\nresult = (index['addr1']['label'], [r['label'] for r in rows if r['address'] == 'addr2'], 'addr3' in index)\", g), g['result'])[1])({})" ; chx:output "('Alice', ['Joe'], False)" .
chx:X_Database rd:hasIOExample chx:IO_Database .
chx:X_OperatingSystem a owl:NamedIndividual, chx:OperatingSystem ; rdfs:label "the systems Windows, macOS, iOS and Android"@en ; skos:definition "An operating system is system software that manages a computer's hardware and software resources and provides common services to programs; wallets run on top of one."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_DistributedSystem a owl:NamedIndividual, chx:DistributedSystem ; rdfs:label "many computers acting as one"@en ; skos:definition "A distributed system is a set of computers that communicate over a network and work together; Bitcoin is a distributed system with no central server."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_BitsAndBytes a owl:NamedIndividual, chx:BitsAndBytes ; rdfs:label "32 bytes written as 64 hexadecimal digits"@en ; skos:definition "A bit is a binary digit, a byte is eight bits, and a hexadecimal digit stands for four bits; a 256-bit hash is 32 bytes or 64 hexadecimal digits."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_BitsAndBytes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(len(__import__('hashlib').sha256(b'').digest()), len(__import__('hashlib').sha256(b'').hexdigest())) evaluates to (32, 64)"@en ; chx:input "(len(__import__('hashlib').sha256(b'').digest()), len(__import__('hashlib').sha256(b'').hexdigest()))" ; chx:output "(32, 64)" .
chx:X_BitsAndBytes rd:hasIOExample chx:IO_BitsAndBytes .
chx:X_Malware a owl:NamedIndividual, chx:Malware ; rdfs:label "an application that imitates a wallet"@en ; skos:definition "Malware is software intentionally designed to cause harm, to leak information or to gain unauthorised access; fake wallet applications are the chapter's example."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Phishing a owl:NamedIndividual, chx:Phishing ; rdfs:label "a page that asks for the recovery code"@en ; skos:definition "Phishing is a scam in which attackers deceive people into revealing sensitive information or installing malware; a wallet that asks for the recovery code at an unexpected time is a warning sign."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Virtual a owl:NamedIndividual, chx:Virtual ; rdfs:label "balances computed from transactions"@en ; skos:definition "The bitcoin currency is entirely virtual: there are no physical coins or even individual digital coins, only transactions that imply the coins."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_Virtual a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"txs = [('Joe', 'Alice', 100_000), ('Alice', 'Eve', 30_000), ('Joe', 'Eve', 5_000)]\\ndef balance(who): return sum(a for f, t, a in txs if t == who) - sum(a for f, t, a in txs if f == who)\\nresult = (balance('Alice'), balance('Eve'))\", g), g['result'])[1])({}) evaluates to (70000, 35000)"@en ; chx:input "(lambda g: (exec(\"txs = [('Joe', 'Alice', 100_000), ('Alice', 'Eve', 30_000), ('Joe', 'Eve', 5_000)]\\ndef balance(who): return sum(a for f, t, a in txs if t == who) - sum(a for f, t, a in txs if f == who)\\nresult = (balance('Alice'), balance('Eve'))\", g), g['result'])[1])({})" ; chx:output "(70000, 35000)" .
chx:X_Virtual rd:hasIOExample chx:IO_Virtual .
chx:X_Borderless a owl:NamedIndividual, chx:Borderless ; rdfs:label "money for the internet"@en ; skos:definition "Bitcoin is fast, secure and borderless, which the chapter gives as the reason that it is arguably the perfect form of money for the internet."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Decentralized a owl:NamedIndividual, chx:Decentralized ; rdfs:label "no single point of control"@en ; skos:definition "Bitcoin is decentralized by design and free of any central authority or point of control that can be attacked or corrupted."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Robust a owl:NamedIndividual, chx:Robust ; rdfs:label "resisting intervention"@en ; skos:definition "A robust digital currency is built to withstand intervention by antagonists, whether legitimate governments or criminal elements, which a decentralized design makes possible."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_PeerToPeerProtocol a owl:NamedIndividual, chx:PeerToPeerProtocol ; rdfs:label "a decentralized peer-to-peer network"@en ; skos:definition "The Bitcoin protocol defines a decentralized peer-to-peer network in which every full node is a peer that both provides and consumes services."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_PeerToPeerProtocol a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"links = {'A': ['B', 'C'], 'B': ['A', 'D'], 'C': ['A', 'E'], 'D': ['B', 'F'], 'E': ['C', 'F'], 'F': ['D', 'E', 'G'], 'G': ['F']}\\nseen, frontier, rounds = {'A'}, {'A'}, 0\\nwhile len(seen) < len(links):\\n    frontier = {n for f in frontier for n in links[f]} - seen\\n    seen |= frontier; rounds += 1\\nresult = rounds\", g), g['result'])[1])({}) evaluates to 4"@en ; chx:input "(lambda g: (exec(\"links = {'A': ['B', 'C'], 'B': ['A', 'D'], 'C': ['A', 'E'], 'D': ['B', 'F'], 'E': ['C', 'F'], 'F': ['D', 'E', 'G'], 'G': ['F']}\\nseen, frontier, rounds = {'A'}, {'A'}, 0\\nwhile len(seen) < len(links):\\n    frontier = {n for f in frontier for n in links[f]} - seen\\n    seen |= frontier; rounds += 1\\nresult = rounds\", g), g['result'])[1])({})" ; chx:output "4" .
chx:X_PeerToPeerProtocol rd:hasIOExample chx:IO_PeerToPeerProtocol .
chx:X_PublicJournal a owl:NamedIndividual, chx:PublicJournal ; rdfs:label "the blockchain as a public transaction journal"@en ; skos:definition "The second part of Bitcoin is a public transaction journal, the blockchain, in which every confirmed transaction is recorded for anyone to read."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_ConsensusRuleSet a owl:NamedIndividual, chx:ConsensusRuleSet ; rdfs:label "the rules every node applies"@en ; skos:definition "The consensus rules are the set of rules for independent transaction validation and currency issuance that every participant applies in the same way."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_ConsensusRuleSet a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('def accept(claim, height, fees):\\n    subsidy = (50 * 10**8) >> (height // 210000)\\n    return claim <= subsidy + fees\\nresult = [accept(312_500_000, 840000, 0), accept(312_500_001, 840000, 0), accept(325_000_000, 840000, 12_500_000)]', g), g['result'])[1])({}) evaluates to [True, False, True]"@en ; chx:input "(lambda g: (exec('def accept(claim, height, fees):\\n    subsidy = (50 * 10**8) >> (height // 210000)\\n    return claim <= subsidy + fees\\nresult = [accept(312_500_000, 840000, 0), accept(312_500_001, 840000, 0), accept(325_000_000, 840000, 12_500_000)]', g), g['result'])[1])({})" ; chx:output "[True, False, True]" .
chx:X_ConsensusRuleSet rd:hasIOExample chx:IO_ConsensusRuleSet .
chx:X_PaymentChannel a owl:NamedIndividual, chx:PaymentChannel ; rdfs:label "many payments with two transactions on the chain"@en ; skos:definition "A payment channel is a class of techniques that lets users make many Bitcoin transactions without committing all of them to the blockchain; typically only two transactions are recorded."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_PaymentChannel a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('onchain, a, b = 2, 60_000, 40_000\\nfor _ in range(100):\\n    a, b = a - 10, b + 10\\nresult = (a, b, a + b, onchain)', g), g['result'])[1])({}) evaluates to (59000, 41000, 100000, 2)"@en ; chx:input "(lambda g: (exec('onchain, a, b = 2, 60_000, 40_000\\nfor _ in range(100):\\n    a, b = a - 10, b + 10\\nresult = (a, b, a + b, onchain)', g), g['result'])[1])({})" ; chx:output "(59000, 41000, 100000, 2)" .
chx:X_PaymentChannel rd:hasIOExample chx:IO_PaymentChannel .
chx:X_LightningNetwork a owl:NamedIndividual, chx:LightningNetwork ; rdfs:label "a route through several channels"@en ; skos:definition "The Lightning Network connects payment channels so that a payment can be routed through several of them, and any peer can pay any other even without a direct channel."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:IO_LightningNetwork a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"channels = {('Alice', 'Bob'), ('Bob', 'Carol'), ('Carol', 'Dave')}\\nnbr = {}\\nfor x, y in channels: nbr.setdefault(x, []).append(y); nbr.setdefault(y, []).append(x)\\npath, frontier = {'Alice': ['Alice']}, ['Alice']\\nwhile 'Dave' not in path:\\n    nxt = []\\n    for x in frontier:\\n        for y in nbr[x]:\\n            if y not in path: path[y] = path[x] + [y]; nxt.append(y)\\n    frontier = nxt\\nresult = (path['Dave'], len(path['Dave']) - 1, ('Alice', 'Dave') in channels)\", g), g['result'])[1])({}) evaluates to (['Alice', 'Bob', 'Carol', 'Dave'], 3, False)"@en ; chx:input "(lambda g: (exec(\"channels = {('Alice', 'Bob'), ('Bob', 'Carol'), ('Carol', 'Dave')}\\nnbr = {}\\nfor x, y in channels: nbr.setdefault(x, []).append(y); nbr.setdefault(y, []).append(x)\\npath, frontier = {'Alice': ['Alice']}, ['Alice']\\nwhile 'Dave' not in path:\\n    nxt = []\\n    for x in frontier:\\n        for y in nbr[x]:\\n            if y not in path: path[y] = path[x] + [y]; nxt.append(y)\\n    frontier = nxt\\nresult = (path['Dave'], len(path['Dave']) - 1, ('Alice', 'Dave') in channels)\", g), g['result'])[1])({})" ; chx:output "(['Alice', 'Bob', 'Carol', 'Dave'], 3, False)" .
chx:X_LightningNetwork rd:hasIOExample chx:IO_LightningNetwork .
chx:X_ElectronicPayment a owl:NamedIndividual, chx:ElectronicPayment ; rdfs:label "cards, PayPal and bank transfers"@en ; skos:definition "An electronic payment is a payment made over an electronic network; credit cards, debit cards, PayPal and bank transfers are reversible, unlike Bitcoin transactions."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_Privacy a owl:NamedIndividual, chx:Privacy ; rdfs:label "addresses without names"@en ; skos:definition "Privacy in Bitcoin is pseudonymous: payments are public and attached to addresses, not names, until an address is linked to an identity."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_W3cStandard a owl:NamedIndividual, chx:W3cStandard ; rdfs:label "a W3C Recommendation"@en ; skos:definition "The World Wide Web Consortium (W3C) is an international organization that develops web standards; its finished standards are called Recommendations."@en ; dcterms:source <http://example.org/sen0401/ch01/research> .
chx:X_SatoshiUnit chx:hasOwner chx:X_BitcoinUnit .
chx:X_Halving chx:hasOwner chx:X_SupplyCap .
chx:X_BlockSubsidy chx:hasOwner chx:X_Halving .
