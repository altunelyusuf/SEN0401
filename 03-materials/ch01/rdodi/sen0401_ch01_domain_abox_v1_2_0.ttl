chx:Err_BitsAndBytes a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "bytes.fromhex('abc') raises ValueError: fromhex() arg must contain an even number of hexadecimal digits"@en .
chx:X_BitsAndBytes rd:hasErrorCondition chx:Err_BitsAndBytes .
chx:Err_HashFunction a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('hashlib').sha256('abc') raises TypeError: Strings must be encoded before hashing"@en .
chx:X_HashFunction rd:hasErrorCondition chx:Err_HashFunction .
chx:Err_SatoshiUnit a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "int('21,000,000') raises ValueError: invalid literal for int() with base 10"@en .
chx:X_SatoshiUnit rd:hasErrorCondition chx:Err_SatoshiUnit .
chx:Err_Halving a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(50 * 10**8) >> -1 raises ValueError: negative shift count"@en .
chx:X_Halving rd:hasErrorCondition chx:Err_Halving .
chx:Err_RecoveryCode a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "'nephew dog crane'.split()[11] raises IndexError: list index out of range"@en .
chx:X_RecoveryCode rd:hasErrorCondition chx:Err_RecoveryCode .
chx:Err_KeyStretching a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('hashlib').pbkdf2_hmac('sha512', 'abandon', b'mnemonic', 2048) raises TypeError: a bytes-like object is required"@en .
chx:X_KeyStretching rd:hasErrorCondition chx:Err_KeyStretching .
chx:Err_Timestamp a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(2 ** 32).to_bytes(4, 'little') raises OverflowError: int too big to convert"@en .
chx:X_Timestamp rd:hasErrorCondition chx:Err_Timestamp .
chx:Err_Database a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "{'addr1': 'Alice'}['addr3'] raises KeyError: 'addr3'"@en .
chx:X_Database rd:hasErrorCondition chx:Err_Database .

chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 1 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch01/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 1 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2, chx:CQ3, chx:CQ4, chx:CQ5, chx:CQ6, chx:CQ7 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What is the unit of Bitcoin's currency, how far can it be divided, how much of it will ever exist, and which rule produces that total?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Who creates new bitcoin, on what schedule, and in what sense does the arrangement replace the functions of a central bank?"@en .
chx:CQ3 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which problem of earlier digital money does Bitcoin solve, and which of its four parts answers which part of that problem?"@en .
chx:CQ4 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How can a wallet be classified by platform, by autonomy and by the control of keys, and what does each choice cost its user?"@en .
chx:CQ5 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What happens, step by step and object by object, between the moment Joe presses Send and the moment Alice's payment is confirmed?"@en .
chx:CQ6 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which technical terms does the chapter use without defining them, and what is the smallest correct explanation of each?"@en .
chx:CQ7 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which figures of the chapter are rules of the protocol and which are values at a date, and how can each be recomputed?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 1 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 1 through the Stage 1 research record; the explanations were rewritten for version 1.2.0 from the documents and files listed at the head of this module, each read for this version, with every quotation re-read from its saved copy and every number recomputed by a claim that the builder executes; the supporting concepts (the cryptographic primitives, the parts of the chain, the everyday computing terms, the two threats, the objects of a payment and the standards bodies) were added because an audit of the terms used in the explanations found them used without a concept of their own."@en ;
    dcterms:source <http://example.org/sen0401/ch01/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (351 checks listed in sen0401_ch01_corpus_v1_2_0.py), executed under CPython 3.14.4."@en ;
    dcterms:source "The execution run of this ontology's build, 08-tooling/sen0401_chapter_build_v1_0_0.py, over the claims in 08-tooling/sen0401_ch01_corpus_v1_2_0.py" .

