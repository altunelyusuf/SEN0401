pg:w_SupplyCap a ipo:InstructionalWidget, ipo:CoupledVariableDemonstrator ; rdfs:label "predict widget for SupplyCap"@en ; ipo:demonstratesSubject <http://example.org/sen0401/ch01#SupplyCap> ;
    ipo:enforcesDomainConstraint <http://example.org/sen0401/ch01#SupplyCap> ;
    mp:numericModelStatus mp:Validated ; mp:hasValidationDerivation "Every value the widget reveals was produced by executing the expression under Python 3.14.4 at build time, not typed" ; mp:hasConformanceTest "The browser design test requires the revealed value to equal the executed one" ;
