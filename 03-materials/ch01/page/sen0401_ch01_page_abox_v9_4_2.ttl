pg:SectionTree a ipo:TreeNavigation ; rdfs:label "Sub-section sidebar tree"@en .
pg:SourceDocument a ipo:SourceDocument ; rdfs:label "Chapter 1 Stage 3 document"@en ; dcterms:source <http://example.org/sen0401/ch01/document> ;
    ipo:hasLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 .

pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Explain how proof of work lets a decentralized network agree on transactions without a central authority"@en ; ld:bloomLevel ld:Understand  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Compute Bitcoin's supply schedule and explain why the total stays just below 21 million"@en ; ld:bloomLevel ld:Apply  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Compare wallet types by platform, node type and key control, and choose one for a stated use"@en ; ld:bloomLevel ld:Analyze  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Relate the chapter's principle of key-holder control to W3C Decentralized Identifiers"@en ; ld:bloomLevel ld:Understand  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What problem does proof of work solve without a central clearinghouse?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "Network speed is not what consensus addresses; the book is about agreeing on which transactions happened." ; ld:distractorRationale "Wallet choice is a user decision the book deliberately leaves open." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "The double-spend: spending the same coin twice" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "Slow internet connections" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "Choosing a wallet brand" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Why does the total supply of bitcoin stay just below 21 million?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "There is no central authority issuing bitcoin; the schedule is in the software." ; ld:distractorRationale "No annual vote exists; the schedule is fixed by the protocol's halving rule." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "The block subsidy halves every 210000 blocks, so the sum converges" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "A central bank caps it" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "Miners vote on it each year" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What was the block subsidy after the halving at block 840000 in April 2024?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "6.25 was the subsidy before that halving, not after it." ; ld:distractorRationale "50 was the original subsidy in 2009, four halvings earlier." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "3.125 bitcoin" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "6.25 bitcoin" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "50 bitcoin" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "In a noncustodial wallet, who can spend the bitcoin?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O0 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "A company holding the keys would make the wallet custodial." ; ld:distractorRationale "An address lets others pay you; it never lets them withdraw." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "Only the user, who alone holds the keys" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "The wallet company" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "Anyone who knows the address" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Which W3C standard applies Bitcoin's key-holder control to identity?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "HTML5 describes web documents, not identity or keys." ; ld:distractorRationale "CSS Grid is a layout system with no bearing on identity." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "Decentralized Identifiers (DIDs)" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "HTML5" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "CSS Grid" .
