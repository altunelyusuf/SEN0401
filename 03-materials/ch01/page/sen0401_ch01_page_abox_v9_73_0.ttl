    skos:definition "The Stage 3 document of chapter 1 is the text this page renders, section for section."@en .

pg:TopMenu a ipo:PrimaryNavigation,
        owl:NamedIndividual ;
    rdfs:label "Main menu"@en ;
    dcterms:source <http://example.org/sen0401/ch01/document> ;
    skos:definition "The main menu is permanently visible at the top and lets the reader reach every top-level area without scrolling or opening anything first."@en .

pg:Q1_O0 a ld:AnswerOption ;
    rdfs:label "The double-spend: spending the same coin twice"@en .

pg:Q2_O0 a ld:AnswerOption ;
    rdfs:label "The block subsidy halves every 210000 blocks, so the sum converges"@en .

pg:Q3_O0 a ld:AnswerOption ;
    rdfs:label "3.125 bitcoin"@en .

pg:Q4_O0 a ld:AnswerOption ;
    rdfs:label "Only the user, who alone holds the keys"@en .

pg:Q5_O0 a ld:AnswerOption ;
    rdfs:label "Decentralized Identifiers (DIDs)"@en .

pg:S_Acquisition a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Acquisition"@en ;
    sen0401:anchor "#Acquisition" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Acquisition> ;
    skos:definition "The Acquisition section lists the ways in which a newcomer obtains a first bitcoin, which is the practical problem a reader faces as soon as the wallet is installed."@en .

pg:S_Address a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Address"@en ;
    sen0401:anchor "#Address" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Address> ;
    skos:definition "The Address section explains the destination of a payment."@en .

pg:S_AddressReuse a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Address reuse and privacy"@en ;
    sen0401:anchor "#AddressReuse" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_AddressReuse> ;
    skos:definition "Using the same address for several payments lets others link and total them; a new address for each payment protects privacy."@en .

pg:S_Api a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "API"@en ;
    sen0401:anchor "#Api" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Api> ;
    skos:definition "An API is a set of features and rules by which software interacts with other software; a third-party API client uses a remote system's API instead of the Bitcoin network."@en .

pg:S_Architecture a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Architecture"@en ;
    sen0401:anchor "#Architecture" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Architecture> ;
    skos:definition "The Architecture section describes how the Bitcoin system is put together."@en .

pg:S_Backup a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Backup"@en ;
    sen0401:anchor "#Backup" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Backup> ;
    skos:definition "The Backup section is about getting a wallet back after something goes wrong."@en .

pg:S_BitcoinATM a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bitcoin ATM"@en ;
    sen0401:anchor "#BitcoinATM" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_BitcoinATM> ;
    skos:definition "A Bitcoin ATM is a machine that accepts cash and sends bitcoin to a smartphone wallet."@en .

pg:S_BitcoinAddress a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bitcoin address"@en ;
    sen0401:anchor "#BitcoinAddress" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_BitcoinAddress> ;
    skos:definition "A number derived from the private key that others use to pay you; it is registered nowhere, and a new one per invoice protects privacy."@en .

pg:S_BitcoinImprovementProposal a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bitcoin Improvement Proposal (BIP)"@en ;
    sen0401:anchor "#BitcoinImprovementProposal" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_BitcoinImprovementProposal> ;
    skos:definition "A Bitcoin Improvement Proposal (BIP) is a numbered design document that specifies a change or a convention; BIP 39 describes the mnemonic code behind recovery codes."@en .

pg:S_BitcoinUnit a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bitcoin unit"@en ;
    sen0401:anchor "#BitcoinUnit" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_BitcoinUnit> ;
    skos:definition "The unit of currency is bitcoin with a small b, abbreviated BTC; the system is Bitcoin with a capital B."@en .

pg:S_BitsAndBytes a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bits and bytes"@en ;
    sen0401:anchor "#BitsAndBytes" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_BitsAndBytes> ;
    skos:definition "A bit is a binary digit, a byte is eight bits, and a hexadecimal digit stands for four bits; a 256-bit hash is 32 bytes or 64 hexadecimal digits."@en .

pg:S_Block a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block"@en ;
    sen0401:anchor "#Block" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Block> ;
    skos:definition "A block is a group of transactions, marked with a time and committing to the previous block, that is added to the blockchain once it carries a valid proof of work."@en .

pg:S_BlockSubsidy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block subsidy"@en ;
    sen0401:anchor "#BlockSubsidy" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_BlockSubsidy> ;
    skos:definition "The block subsidy is the amount of new bitcoin that a block may create for its miner; it starts at 50 bitcoin and halves every 210000 blocks."@en .

pg:S_Blockchain a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Blockchain"@en ;
    sen0401:anchor "#Blockchain" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Blockchain> ;
    skos:definition "The blockchain is the list of validated blocks, each linking to its predecessor all the way back to the first block; changing an old block breaks every later link."@en .

pg:S_Borderless a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Borderless"@en ;
    sen0401:anchor "#Borderless" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Borderless> ;
    skos:definition "Bitcoin is fast, secure and borderless, which the chapter gives as the reason that it is arguably the perfect form of money for the internet."@en .

pg:S_BuyFromFriend a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Buy from friend"@en ;
    sen0401:anchor "#BuyFromFriend" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_BuyFromFriend> ;
    skos:definition "The least complicated way to get a first bitcoin: buy directly from someone who has some."@en .

pg:S_ByzantineGeneralsProblem a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Byzantine Generals' Problem"@en ;
    sen0401:anchor "#ByzantineGeneralsProblem" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_ByzantineGeneralsProblem> ;
    skos:definition "The Byzantine Generals' Problem asks how participants without a leader can agree on a course of action over an unreliable network; Bitcoin's proof of work is a practical solution."@en .

pg:S_CentralBank a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Central bank"@en ;
    sen0401:anchor "#CentralBank" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_CentralBank> ;
    skos:definition "A central bank is the institution that controls the creation of a national currency; Bitcoin has none, and its issuance is set by rules."@en .

pg:S_CentralBankReplacement a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Central bank replacement"@en ;
    sen0401:anchor "#CentralBankReplacement" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_CentralBankReplacement> ;
    skos:definition "Mining decentralizes the currency-issuance and clearing functions of a central bank and replaces the need for any central bank."@en .

pg:S_Chain a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Chain"@en ;
    sen0401:anchor "#Chain" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Chain> ;
    skos:definition "The Chain section explains the data structure at the centre of Bitcoin and the computers that maintain it."@en .

pg:S_Characteristic a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Characteristic"@en ;
    sen0401:anchor "#Characteristic" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Characteristic> ;
    skos:definition "The Characteristic section collects four properties that the chapter attributes to the bitcoin currency: it is virtual, it is borderless, it is decentralized, and it is robust."@en .

pg:S_Checksum a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Checksum"@en ;
    sen0401:anchor "#Checksum" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Checksum> ;
    skos:definition "A checksum is a short value computed from data and stored with it so that changes can be detected; a BIP 39 recovery code carries ENT/32 bits taken from a SHA-256 hash."@en .

pg:S_ClearingHouse a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Clearing house"@en ;
    sen0401:anchor "#ClearingHouse" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_ClearingHouse> ;
    skos:definition "A clearing house is a central party that records and settles transactions; traditional digital money relied on one, and the term clearing means the confirmation of a payment."@en .

pg:S_Computing a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Computing"@en ;
    sen0401:anchor "#Computing" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Computing> ;
    skos:definition "The Computing section explains the ordinary technology on which Bitcoin software runs and by which people reach it."@en .

pg:S_Confirmation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Confirmation"@en ;
    sen0401:anchor "#Confirmation" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Confirmation> ;
    skos:definition "A confirmation counts the blocks that contain a transaction or follow it; each one makes reversal less likely, and the inclusion in a block is the clearing of the payment."@en .

pg:S_Consensus a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Consensus"@en ;
    sen0401:anchor "#Consensus" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Consensus> ;
    skos:definition "Consensus is the state in which the participants of the network agree on the same record of transactions."@en .

pg:S_ConsensusRuleSet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Consensus rule set"@en ;
    sen0401:anchor "#ConsensusRuleSet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_ConsensusRuleSet> ;
    skos:definition "The consensus rules are the set of rules for independent transaction validation and currency issuance that every participant applies in the same way."@en .

pg:S_Cryptography a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Cryptography"@en ;
    sen0401:anchor "#Cryptography" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Cryptography> ;
    skos:definition "Cryptography is the science of transforming data so that its meaning is hidden, so that undetected alteration is prevented, or so that unauthorised use is prevented."@en .

pg:S_CurrencyExchange a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Currency exchange"@en ;
    sen0401:anchor "#CurrencyExchange" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_CurrencyExchange> ;
    skos:definition "A currency exchange is a market where buyers and sellers swap bitcoin and local currency, usually through a linked bank account."@en .

pg:S_CustodialWallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Custodial wallet"@en ;
    sen0401:anchor "#CustodialWallet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_CustodialWallet> ;
    skos:definition "A custodial wallet or account is one where a third party, the custodian, holds the keys and manages the funds for the user."@en .

pg:S_Database a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Database"@en ;
    sen0401:anchor "#Database" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Database> ;
    skos:definition "A database is a storage system that collects organized data so that it is easier to search, structure and extend; a wallet keeps its labels and history in one."@en .

pg:S_Decentralized a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Decentralized"@en ;
    sen0401:anchor "#Decentralized" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Decentralized> ;
    skos:definition "Bitcoin is decentralized by design and free of any central authority or point of control that can be attacked or corrupted."@en .

pg:S_DecentralizedIdentity a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Decentralized identifier"@en ;
    sen0401:anchor "#DecentralizedIdentity" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_DecentralizedIdentity> ;
    skos:definition "A W3C Decentralized Identifier is an identifier that its controller can prove control over without a central registry, applying the principle of control by keys to identity."@en .

pg:S_Deflation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Deflation"@en ;
    sen0401:anchor "#Deflation" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Deflation> ;
    skos:definition "Because issuance diminishes and ends, the currency is deflationary over the long term; the last non-zero subsidy falls in the year 2140 at the target pace."@en .

pg:S_DesktopWallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Desktop wallet"@en ;
    sen0401:anchor "#DesktopWallet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_DesktopWallet> ;
    skos:definition "The first type of Bitcoin wallet, run on a general-purpose operating system such as Windows or macOS."@en .

pg:S_DifficultyAdjustment a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Difficulty adjustment"@en ;
    sen0401:anchor "#DifficultyAdjustment" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_DifficultyAdjustment> ;
    skos:definition "The difficulty of the work is adjusted every 2016 blocks so that, on average, one block is found every 10 minutes whatever the total computing power."@en .

pg:S_DigitalSignature a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Digital signature"@en ;
    sen0401:anchor "#DigitalSignature" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_DigitalSignature> ;
    skos:definition "A digital signature is a value computed from data and a private key that anyone holding the matching public key can use to verify the origin and integrity of the data."@en .

pg:S_DistributedSystem a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Distributed system"@en ;
    sen0401:anchor "#DistributedSystem" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_DistributedSystem> ;
    skos:definition "A distributed system is a set of computers that communicate over a network and work together; Bitcoin is a distributed system with no central server."@en .

pg:S_DoubleSpend a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Double-spend"@en ;
    sen0401:anchor "#DoubleSpend" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_DoubleSpend> ;
    skos:definition "The double-spend problem is the possibility of spending one unit of digital money twice; Bitcoin's consensus prevents it without a central clearinghouse."@en .

pg:S_EarnBitcoin a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Earn bitcoin"@en ;
    sen0401:anchor "#EarnBitcoin" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_EarnBitcoin> ;
    skos:definition "Earning bitcoin means selling a product or service and being paid in it."@en .

pg:S_ElectronicPayment a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Electronic payment"@en ;
    sen0401:anchor "#ElectronicPayment" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_ElectronicPayment> ;
    skos:definition "An electronic payment is a payment made over an electronic network; credit cards, debit cards, PayPal and bank transfers are reversible, unlike Bitcoin transactions."@en .

pg:S_Entropy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Entropy"@en ;
    sen0401:anchor "#Entropy" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Entropy> ;
    skos:definition "Entropy is a measure of unpredictability, counted in bits; a wallet needs enough of it that nobody can guess the key or recovery code."@en .

pg:S_FloatingExchangeRate a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Floating exchange rate"@en ;
    sen0401:anchor "#FloatingExchangeRate" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_FloatingExchangeRate> ;
    skos:definition "The price of bitcoin is set by markets: a floating exchange rate that moves with supply and demand."@en .

pg:S_Foundations a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Foundations"@en ;
    sen0401:anchor "#Foundations" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Foundations> ;
    skos:definition "The Foundations branch collects the general technical ideas that the rest of the chapter takes for granted."@en .

pg:S_FullNode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Full node"@en ;
    sen0401:anchor "#FullNode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_FullNode> ;
    skos:definition "A program that validates the entire history of Bitcoin transactions itself and may serve data to other programs."@en .

pg:S_Halving a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Halving"@en ;
    sen0401:anchor "#Halving" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Halving> ;
    skos:definition "The block subsidy halves every 210000 blocks; at block 840000, on 2024-04-20, it fell to 3.125 bitcoin."@en .

pg:S_HardwareSigningDevice a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hardware signing device"@en ;
    sen0401:anchor "#HardwareSigningDevice" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_HardwareSigningDevice> ;
    skos:definition "A hardware signing device stores keys and signs transactions with special-purpose hardware; it must be paired with a full-featured wallet to send and receive."@en .

pg:S_HashFunction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hash function"@en ;
    sen0401:anchor "#HashFunction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_HashFunction> ;
    skos:definition "A hash function maps data of any length to a fixed-length fingerprint; SHA-256 produces 256 bits, and any change to the input gives a different result."@en .

pg:S_Hashcash a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hashcash"@en ;
    sen0401:anchor "#Hashcash" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Hashcash> ;
    skos:definition "Hashcash is a proof-of-work scheme proposed by Adam Back in 1997 to throttle abuse of un-metered resources such as email; Bitcoin's proof of work descends from it."@en .

pg:S_History a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "History"@en ;
    sen0401:anchor "#History" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_History> ;
    skos:definition "The History section tells where Bitcoin came from."@en .

pg:S_Http a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "HTTP"@en ;
    sen0401:anchor "#Http" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Http> ;
    skos:definition "HTTP, the HyperText Transfer Protocol, is the network protocol by which browsers and servers exchange web pages; its requests are plain text."@en .

pg:S_IdentityVerification a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Identity verification"@en ;
    sen0401:anchor "#IdentityVerification" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_IdentityVerification> ;
    skos:definition "Identity verification is the check of a customer's identity and credit-worthiness that companies converting traditional payments into bitcoin usually require."@en .

pg:S_InputsAndOutputs a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Inputs and outputs"@en ;
    sen0401:anchor "#InputsAndOutputs" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_InputsAndOutputs> ;
    skos:definition "A transaction's inputs identify the funds it spends and its outputs assign amounts to new owners; any difference between the totals is the fee."@en .

pg:S_Internet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Internet"@en ;
    sen0401:anchor "#Internet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Internet> ;
    skos:definition "The Internet is a worldwide network of networks that uses the Internet protocol suite; Bitcoin users communicate over it primarily, although other transport networks can be used."@en .

pg:S_Invoice a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Invoice"@en ;
    sen0401:anchor "#Invoice" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Invoice> ;
    skos:definition "An invoice is a payment request that a wallet can read, carrying a destination address and often an amount and a description."@en .

pg:S_Irreversibility a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Irreversibility"@en ;
    sen0401:anchor "#Irreversibility" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Irreversibility> ;
    skos:definition "Bitcoin transactions are irreversible, unlike card payments, bank transfers and other electronic payments, which can be reversed."@en .

pg:S_Issuance a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Issuance"@en ;
    sen0401:anchor "#Issuance" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Issuance> ;
    skos:definition "The Issuance section is about who creates money and by what rule."@en .

pg:S_KeyControl a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Key control"@en ;
    sen0401:anchor "#KeyControl" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_KeyControl> ;
    skos:definition "Key control is the question of who holds the private keys that unlock a wallet's funds."@en .

pg:S_KeyStretching a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Key stretching"@en ;
    sen0401:anchor "#KeyStretching" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_KeyStretching> ;
    skos:definition "Key stretching derives a key from a secret by repeating a function many times, so that every guess of an attacker costs as much work as the honest computation."@en .

pg:S_KeyedHash a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Keyed hash"@en ;
    sen0401:anchor "#KeyedHash" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_KeyedHash> ;
    skos:definition "A keyed hash, or message authentication code, mixes a secret key into a hash so that only a holder of the key can produce or confirm the result; HMAC is the standard construction."@en .

pg:S_LightningNetwork a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Lightning Network"@en ;
    sen0401:anchor "#LightningNetwork" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_LightningNetwork> ;
    skos:definition "The Lightning Network connects payment channels so that a payment can be routed through several of them, and any peer can pay any other even without a direct channel."@en .

pg:S_LightweightClient a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Lightweight client"@en ;
    sen0401:anchor "#LightweightClient" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_LightweightClient> ;
    skos:definition "A client that keeps the wallet locally but relies on a full node or server for most data and validates only partly."@en .

pg:S_Malware a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Malware"@en ;
    sen0401:anchor "#Malware" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Malware> ;
    skos:definition "Malware is software intentionally designed to cause harm, to leak information or to gain unauthorised access; fake wallet applications are the chapter's example."@en .

pg:S_Mining a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Mining"@en ;
    sen0401:anchor "#Mining" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Mining> ;
    skos:definition "Mining is the repeated computation, referring to a list of recent transactions, by which a participant tries to add a block and earn the reward."@en .

pg:S_MobileWallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Mobile wallet"@en ;
    sen0401:anchor "#MobileWallet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_MobileWallet> ;
    skos:definition "The most common type of Bitcoin wallet, run on a smartphone operating system such as iOS or Android."@en .

pg:S_Money a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Money"@en ;
    sen0401:anchor "#Money" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Money> ;
    skos:definition "Chapter 1 begins by saying that Bitcoin is a collection of concepts and technologies that form the basis of a digital money ecosystem, and that units of currency called bitcoin are used to store and transmit value among the participants of the Bitcoin network (Antonopoulos and Harding, 2023)."@en .

pg:S_Nature a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Nature"@en ;
    sen0401:anchor "#Nature" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Nature> ;
    skos:definition "The Nature branch answers a question that precedes all the others: what kind of thing is Bitcoin? Chapter 1 gives two complementary answers."@en .

pg:S_Network a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Network"@en ;
    sen0401:anchor "#Network" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Network> ;
    skos:definition "The Network branch is about the community of computers that runs Bitcoin and the way it agrees on a single history without a leader."@en .

pg:S_Node a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Node"@en ;
    sen0401:anchor "#Node" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Node> ;
    skos:definition "A node is a computer that takes part in the Bitcoin network and runs software that speaks its protocol; full nodes validate blocks and may also route, mine or serve wallets."@en .

pg:S_NodeType a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Node type"@en ;
    sen0401:anchor "#NodeType" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_NodeType> ;
    skos:definition "The node type of a wallet describes how much of the network's work the wallet does for itself."@en .

pg:S_NoncustodialWallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Noncustodial wallet"@en ;
    sen0401:anchor "#NoncustodialWallet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_NoncustodialWallet> ;
    skos:definition "A wallet where only the user holds the keys, so only the user controls and can lose the bitcoin."@en .

pg:S_OffchainPayment a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Offchain payment"@en ;
    sen0401:anchor "#OffchainPayment" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_OffchainPayment> ;
    skos:definition "An offchain payment moves value without recording every payment in the public blockchain, which lowers cost and improves privacy but changes what a backup must cover."@en .

pg:S_OpenSourceSoftware a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Open source software"@en ;
    sen0401:anchor "#OpenSourceSoftware" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_OpenSourceSoftware> ;
    skos:definition "Open source software is distributed with its source code under terms that allow free redistribution, modification and derived works."@en .

pg:S_OperatingSystem a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Operating system"@en ;
    sen0401:anchor "#OperatingSystem" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_OperatingSystem> ;
    skos:definition "An operating system is system software that manages a computer's hardware and software resources and provides common services to programs; wallets run on top of one."@en .

pg:S_PaymentChannel a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Payment channel"@en ;
    sen0401:anchor "#PaymentChannel" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_PaymentChannel> ;
    skos:definition "A payment channel is a class of techniques that lets users make many Bitcoin transactions without committing all of them to the blockchain; typically only two transactions are recorded."@en .

pg:S_PeerAndClient a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Peer and client"@en ;
    sen0401:anchor "#PeerAndClient" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_PeerAndClient> ;
    skos:definition "In the peer-to-peer network, full nodes are the peers and lightweight wallets are clients that depend on one or more peers for valid data."@en .

pg:S_PeerToPeerProtocol a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Peer-to-peer protocol"@en ;
    sen0401:anchor "#PeerToPeerProtocol" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_PeerToPeerProtocol> ;
    skos:definition "The Bitcoin protocol defines a decentralized peer-to-peer network in which every full node is a peer that both provides and consumes services."@en .

pg:S_Phishing a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Phishing"@en ;
    sen0401:anchor "#Phishing" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Phishing> ;
    skos:definition "Phishing is a scam in which attackers deceive people into revealing sensitive information or installing malware; a wallet that asks for the recovery code at an unexpected time is a warning sign."@en .

pg:S_Price a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Price"@en ;
    sen0401:anchor "#Price" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Price> ;
    skos:definition "The Price section addresses a question that every newcomer asks, namely who sets the price of bitcoin."@en .

pg:S_PriorDigitalCurrency a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Digital currencies before Bitcoin"@en ;
    sen0401:anchor "#PriorDigitalCurrency" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_PriorDigitalCurrency> ;
    skos:definition "Digital currencies before Bitcoin used cryptography but were centralized and therefore easy to attack, which is the problem Bitcoin was designed to avoid."@en .

pg:S_Privacy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Privacy"@en ;
    sen0401:anchor "#Privacy" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Privacy> ;
    skos:definition "Privacy in Bitcoin is pseudonymous: payments are public and attached to addresses, not names, until an address is linked to an identity."@en .

pg:S_PrivateKey a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Private key"@en ;
    sen0401:anchor "#PrivateKey" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_PrivateKey> ;
    skos:definition "A private key is the secret half of a key pair; in Bitcoin it is a very large number whose holder alone can sign transactions that spend the corresponding bitcoin."@en .

pg:S_ProofOfWork a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Proof of work"@en ;
    sen0401:anchor "#ProofOfWork" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_ProofOfWork> ;
    skos:definition "Proof of work makes adding a block costly and easy to check; a toy version searches for a number whose SHA-256 hash starts with zeros."@en .

pg:S_Protocol a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Protocol"@en ;
    sen0401:anchor "#Protocol" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Protocol> ;
    skos:definition "A protocol is a set of rules, formats and procedures that computers follow to exchange data; the Bitcoin protocol is the rules that nodes follow to talk to each other."@en .

pg:S_PublicJournal a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Public journal"@en ;
    sen0401:anchor "#PublicJournal" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_PublicJournal> ;
    skos:definition "The second part of Bitcoin is a public transaction journal, the blockchain, in which every confirmed transaction is recorded for anyone to read."@en .

pg:S_PublicKeyCryptography a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Public-key cryptography"@en ;
    sen0401:anchor "#PublicKeyCryptography" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_PublicKeyCryptography> ;
    skos:definition "Public-key cryptography uses a pair of mathematically related keys, one public and one private, so that what one key does only the other can undo."@en .

pg:S_QrCode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "QR code"@en ;
    sen0401:anchor "#QrCode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_QrCode> ;
    skos:definition "A QR code is a two-dimensional matrix barcode that a camera can read; wallets use it to hand over addresses and payment requests without typing."@en .

pg:S_RecoveryCode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Recovery code"@en ;
    sen0401:anchor "#RecoveryCode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_RecoveryCode> ;
    skos:definition "A recovery code of words, numbers or letters chosen at random by the wallet, from which all its keys are generated and from which the wallet can be restored."@en .

pg:S_ReferenceImplementation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Reference implementation"@en ;
    sen0401:anchor "#ReferenceImplementation" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_ReferenceImplementation> ;
    skos:definition "The software that Nakamoto published in 2009 and many programmers have revised since; Bitcoin Core is its descendant and includes a wallet."@en .

pg:S_Robust a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Robust"@en ;
    sen0401:anchor "#Robust" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Robust> ;
    skos:definition "A robust digital currency is built to withstand intervention by antagonists, whether legitimate governments or criminal elements, which a decentralized design makes possible."@en .

pg:S_SatoshiNakamoto a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Satoshi Nakamoto"@en ;
    sen0401:anchor "#SatoshiNakamoto" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_SatoshiNakamoto> ;
    skos:definition "Satoshi Nakamoto is the alias of the person or people who designed Bitcoin; their identity is unknown and they withdrew from the public in April 2011."@en .

pg:S_SatoshiUnit a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Satoshi (unit)"@en ;
    sen0401:anchor "#SatoshiUnit" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_SatoshiUnit> ;
    skos:definition "The satoshi is the smallest unit of bitcoin that can be recorded, one hundred-millionth of a bitcoin; amounts are counted in whole satoshis."@en .

pg:S_SemanticBridge a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Semantic bridge"@en ;
    sen0401:anchor "#SemanticBridge" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_SemanticBridge> ;
    skos:definition "The semantic bridge connects the chapter's central idea with the theme of this course, semantic technologies."@en .

pg:S_SendingAndReceiving a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Sending and receiving"@en ;
    sen0401:anchor "#SendingAndReceiving" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_SendingAndReceiving> ;
    skos:definition "Receiving shows an address or invoice; sending signs a transaction that spends to someone else's address."@en .

pg:S_Server a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Server"@en ;
    sen0401:anchor "#Server" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Server> ;
    skos:definition "A server is software or hardware that offers a service to clients over a network; Bitcoin's peer-to-peer design has no central server."@en .

pg:S_Standards a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Standards and openness"@en ;
    sen0401:anchor "#Standards" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Standards> ;
    skos:definition "The Standards section collects the two social mechanisms through which Bitcoin is documented and developed: the numbered improvement proposals through which changes are discussed, and the open source licence under which the software is shared."@en .

pg:S_Supply a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Supply"@en ;
    sen0401:anchor "#Supply" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Supply> ;
    skos:definition "The Supply section is about how much bitcoin exists and how the amount grows."@en .

pg:S_SupplyCap a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Supply cap"@en ;
    sen0401:anchor "#SupplyCap" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_SupplyCap> ;
    skos:definition "New bitcoin is created on a schedule that halves the subsidy every 210000 blocks, so the total supply stays just below 21 million."@en .

pg:S_ThirdPartyApiClient a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Third-party API client"@en ;
    sen0401:anchor "#ThirdPartyApiClient" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_ThirdPartyApiClient> ;
    skos:definition "A third-party API client uses a remote system's programming interface instead of the Bitcoin network and trusts it for correct information and privacy."@en .

pg:S_Threats a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Threats"@en ;
    sen0401:anchor "#Threats" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Threats> ;
    skos:definition "The Threats section explains two attacks that chapter 1 warns about by name or by description: malicious software that steals or destroys, and phishing, which tricks a person into handing over a secret."@en .

pg:S_Timestamp a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Timestamp"@en ;
    sen0401:anchor "#Timestamp" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Timestamp> ;
    skos:definition "A timestamp is a recorded time attached to data; each block carries one, and together they place the transactions in an agreed order."@en .

pg:S_Transaction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction"@en ;
    sen0401:anchor "#Transaction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Transaction> ;
    skos:definition "A transaction is a signed data structure that expresses a transfer of value; it is broadcast over the network, collected into a block, and made permanent on the blockchain."@en .

pg:S_TransactionFee a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction fee"@en ;
    sen0401:anchor "#TransactionFee" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_TransactionFee> ;
    skos:definition "A transaction fee is the amount a sender adds for the miner who includes the transaction in a block; a higher fee gives faster confirmation."@en .

pg:S_Transfer a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transfer"@en ;
    sen0401:anchor "#Transfer" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Transfer> ;
    skos:definition "The Transfer section explains what happens when Joe sends bitcoin to Alice."@en .

pg:S_Unit a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Unit"@en ;
    sen0401:anchor "#Unit" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Unit> ;
    skos:definition "The Unit section answers the first question that any money raises, namely what the money is called and in what pieces it is counted."@en .

pg:S_Uri a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "URI"@en ;
    sen0401:anchor "#Uri" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Uri> ;
    skos:definition "A URI, a Uniform Resource Identifier, is a string that refers to a resource; the bitcoin: scheme of BIP 21 writes an address, an amount and a label as a URI."@en .

pg:S_Usage a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Usage"@en ;
    sen0401:anchor "#Usage" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Usage> ;
    skos:definition "The Usage branch follows the chapter's story of Alice and Joe: how Alice receives her first address, how she acquires her first bitcoin, and how Joe sends it."@en .

pg:S_VerifiableCredential a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Verifiable credential"@en ;
    sen0401:anchor "#VerifiableCredential" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_VerifiableCredential> ;
    skos:definition "A verifiable credential expresses claims made by an issuer, such as a driver's licence or education certificate, in a form protected by digital signatures that a holder can present to a verifier."@en .

pg:S_Virtual a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Virtual"@en ;
    sen0401:anchor "#Virtual" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Virtual> ;
    skos:definition "The bitcoin currency is entirely virtual: there are no physical coins or even individual digital coins, only transactions that imply the coins."@en .

pg:S_VolumeWeightedAverage a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Volume-weighted average"@en ;
    sen0401:anchor "#VolumeWeightedAverage" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_VolumeWeightedAverage> ;
    skos:definition "A volume-weighted average prices a currency pair by weighting each trade's price by its volume, so larger trades count for more."@en .

pg:S_W3cStandard a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "W3C standard"@en ;
    sen0401:anchor "#W3cStandard" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_W3cStandard> ;
    skos:definition "The World Wide Web Consortium (W3C) is an international organization that develops web standards; its finished standards are called Recommendations."@en .

pg:S_Wallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Wallet"@en ;
    sen0401:anchor "#Wallet" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Wallet> ;
    skos:definition "A wallet is the software through which a person uses Bitcoin."@en .

pg:S_WalletMetadata a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Wallet metadata"@en ;
    sen0401:anchor "#WalletMetadata" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_WalletMetadata> ;
    skos:definition "Wallet metadata is the data a user adds to a wallet, such as labels on addresses and transactions; a recovery code does not restore it."@en .

pg:S_WalletPlatform a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Wallet platform"@en ;
    sen0401:anchor "#WalletPlatform" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch01#S_WalletPlatform> ;
    skos:definition "The platform of a wallet is the kind of device and software environment on which it runs."@en .

pg:S_WebBrowser a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Web browser"@en ;
    sen0401:anchor "#WebBrowser" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_WebBrowser> ;
    skos:definition "A web browser is a program that retrieves and displays pages from the web and lets users reach further pages through links."@en .

pg:S_WebWallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Web wallet"@en ;
    sen0401:anchor "#WebWallet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_WebWallet> ;
    skos:definition "A wallet used through a web browser, whose data usually lives on a server owned by a third party."@en .

pg:S_Whitepaper a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Whitepaper"@en ;
    sen0401:anchor "#Whitepaper" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch01#S_Whitepaper> ;
    skos:definition "The 2008 paper by Satoshi Nakamoto that first described Bitcoin as a purely peer-to-peer version of electronic cash."@en .

pg:CO1 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Explain how proof of work lets a decentralized network agree on transactions without a central authority"@en ;
    ld:bloomLevel ld:Understand ;
    dcterms:source <http://example.org/sen0401/ch01/document> ;
    skos:definition "After this chapter the learner can explain how proof of work lets a decentralized network agree on transactions without a central authority."@en .

pg:CO3 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Compare wallet types by platform, node type and key control, and choose one for a stated use"@en ;
    ld:bloomLevel ld:Analyze ;
    dcterms:source <http://example.org/sen0401/ch01/document> ;
    skos:definition "After this chapter the learner can compare wallet types by platform, node type and key control, and choose one for a stated use."@en .

pg:CO4 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Relate the chapter's principle of key-holder control to W3C Decentralized Identifiers"@en ;
    ld:bloomLevel ld:Understand ;
    dcterms:source <http://example.org/sen0401/ch01/document> ;
    skos:definition "After this chapter the learner can relate the chapter's principle of key-holder control to W3C Decentralized Identifiers."@en .

pg:CO2 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Compute Bitcoin's supply schedule and explain why the total stays just below 21 million"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch01/document> ;
    skos:definition "After this chapter the learner can compute Bitcoin's supply schedule and explain why the total stays just below 21 million."@en .

