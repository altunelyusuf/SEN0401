pg:Q1 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "What problem does proof of work solve without a central clearinghouse?"@en ;
    ld:assessesObjective pg:CO1 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "Network speed is not what consensus addresses; the book is about agreeing on which transactions happened.",
        "Wallet choice is a user decision the book deliberately leaves open." ;
    ld:hasCorrectOption pg:Q1_O0 ;
    ld:hasOption pg:Q1_O0,
        pg:Q1_O1,
        pg:Q1_O2 .

pg:Q2 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Why does the total supply of bitcoin stay just below 21 million?"@en ;
    ld:assessesObjective pg:CO2 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "No annual vote exists; the schedule is fixed by the protocol's halving rule.",
        "There is no central authority issuing bitcoin; the schedule is in the software." ;
    ld:hasCorrectOption pg:Q2_O0 ;
    ld:hasOption pg:Q2_O0,
        pg:Q2_O1,
        pg:Q2_O2 .

pg:Q3 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "What was the block subsidy after the halving at block 840000 in April 2024?"@en ;
    ld:assessesObjective pg:CO2 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "50 was the original subsidy in 2009, four halvings earlier.",
        "6.25 was the subsidy before that halving, not after it." ;
    ld:hasCorrectOption pg:Q3_O0 ;
    ld:hasOption pg:Q3_O0,
        pg:Q3_O1,
        pg:Q3_O2 .

pg:Q4 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "In a noncustodial wallet, who can spend the bitcoin?"@en ;
    ld:assessesObjective pg:CO3 ;
    ld:cognitiveLevel ld:Analyze ;
    ld:distractorRationale "A company holding the keys would make the wallet custodial.",
        "An address lets others pay you; it never lets them withdraw." ;
    ld:hasCorrectOption pg:Q4_O0 ;
    ld:hasOption pg:Q4_O0,
        pg:Q4_O1,
        pg:Q4_O2 .

pg:Q5 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Which W3C standard applies Bitcoin's key-holder control to identity?"@en ;
    ld:assessesObjective pg:CO4 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "CSS Grid is a layout system with no bearing on identity.",
        "HTML5 describes web documents, not identity or keys." ;
    ld:hasCorrectOption pg:Q5_O0 ;
    ld:hasOption pg:Q5_O0,
        pg:Q5_O1,
        pg:Q5_O2 .

