    rdfs:label "SEN0401: teaching materials"@en ;
    owl:versionInfo "1.3.5" ;
    owl:versionIRI <http://example.org/sen0401/materials/1.3.0> ;
    prov:wasRevisionOf <http://example.org/sen0401/materials/1.2.0> ;
    dcterms:identifier "sen0401_materials_v1_3_5" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0. The owner's 2025 materials registered below carry the licence recorded in 03-materials/owner-legacy-2025/ATTRIBUTION_v1_0.md, which is CC BY-SA 4.0 as far as they contain the book's text."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:created "2026-10-04"^^xsd:date ;
    dcterms:modified "2026-10-05"^^xsd:date ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/cme-course-parts-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> ;
    rdfs:comment "First release of SEN0401's material register: the repository had no 03-materials register ontology before this file, only the materials themselves. Measured on 2026-10-04: four renewed decks, six RDODI documents, six chapter ontology packages, six interactive pages with five page ABoxes, twelve legacy decks of 2025 and the legacy content collection of 144 inventoried files."@en .

#################################################################
#  Renewed decks for the third edition, chapters 1 to 4
#################################################################

sen0401:Deck_Ch01_3e a schema:LearningResource ;
    dcterms:title "Chapter 1: Introduction - the classroom redesign of the third-edition deck" ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation" ;
    cme:fileInPart "03-materials/ch01/SEN0401_Ch01_Introduction_3e_v2_4_0.pptx" ;
    cme:renewalStatus "Redesigned for the classroom on 2026-10-06 by the owner's ruling, revised four times the same day under his three-role method - academician prepares, expert faculty specialist reviews, undergraduate reads (the cycle recorded in 08-tooling/ch01-deck/REVIEW_v2_4_0.md): 38 numbered slides carrying short bullets and visualizations (concept trees, the issuance chart, network and flow diagrams, stat tiles), every code block labelled and accompanied by explanation bullets, a one-line takeaway clue on each content slide, and one continuous warm-ivory theme with no dark-light background switches, chosen after a short survey of projection guidance. Six dated, sourced stories from the chapter's story companion (08-tooling/sen0401_ch01_stories_v1_1_0.py) carry the history - the genesis headline, the first payment, the cypherpunk lineage, Yap's stone money, Pizza Day and Mt. Gox - and every program slide shows its executed result as a visualization (balance bars, a routed payment, refused claims, a tampered chain, a stretching funnel) whose values are asserted against the executed outputs. Twelve visuals are embedded from 03-materials/ch01/assets: seven from the owner's 2025 decks, three licensed photographs fetched from Wikimedia Commons with their CC BY-SA attributions carried on-slide (the Yap rai stone, a pizza margherita, Lydian electrum coins), and two wallet-screen figures from the course textbook's own CC BY-SA repository; licences and credits in ASSETS_PROVENANCE_v1_1_0.md. Slides carry full short sentences under a 20-word gate with one-sentence ledes where a visual needs reading help, a final resources slide links the whitepaper, the free textbook, developer documentation, Bitcoin Core, two explorers, market data, two communities, two seminal papers and a video as live hyperlinks; the genesis story shows block 0's real 285 bytes fetched from the live chain and hash-re-verified in the build, rendered as a hex dump whose highlighted bytes spell the Times headline; the Pizza Day coins are repriced on a log chart from documented milestones with the current value fetched live from two agreeing APIs; and the Money section opens with a five-thousand-year history timeline and the traditional-digital-cryptocurrency comparison table, both from the story companion v1.1.0. Speaker notes are cues, not prose; the full text stays on the course page. Every console example and program the deck shows was re-executed off the finished file by 08-tooling/ch01-deck/deck_check_v1_1_0.py (12 examples, 0 mismatches) and the layout check found no overflowing frame and no slide without notes. Built by 08-tooling/ch01-deck/deck_build_v2_4_0.py and deck_v2_4_0.js from the chapter corpus and examples_out_v1_1_0.json; the earlier third-edition deck versions are in git history." ;
    dcterms:replaces sen0401:LegacyDeck_01 ;
    cme:servesOutcome sen0401:LO1 ;
    dcterms:source "08-tooling/sen0401_ch01_corpus_v1_2_0.py and 08-tooling/ch01-deck/examples_out_v1_1_0.json, through deck_plan_v2_0_0.json. Slide count read from the file on 2026-10-06." .

sen0401:Deck_Ch02_3e a schema:LearningResource ;
    dcterms:title "Chapter 2: How Bitcoin Works - renewed for the third edition" ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation" ;
    cme:fileInPart "03-materials/ch02/SEN0401_Ch02_HowBitcoinWorks_3e_v1_2_0.pptx" ;
    cme:renewalStatus "Renewed: 20 slides built from the third edition's chapter 2 and its RDODI research. The deck lineage records that 08-tooling/ch02-deck re-ran the six computations the deck shows under Python 3.14.4 - satoshi units, the toy fee, change, and the whitepaper's attacker-success procedure - with no mismatches, that a stale fixture showing 0.0024 for six confirmations was refused by slide number, and that the PROV-O terms shown were checked against the W3C Recommendation before use." ;
    dcterms:replaces sen0401:LegacyDeck_02 ;
    cme:servesOutcome sen0401:LO2 ;
    dcterms:source "03-materials/ch02/rdodi/sen0401_ch02_research_v1_2_0.ttl; verification quoted from 07-lineage/sen0401_slides_lineage_v0_21_0.ttl. Slide count read from the file on 2026-10-04." .

sen0401:Deck_Ch03_3e a schema:LearningResource ;
    dcterms:title "Chapter 3: Bitcoin Core, the reference implementation - renewed for the third edition" ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation" ;
    cme:fileInPart "03-materials/ch03/SEN0401_Ch03_BitcoinCore_3e_v1_1_0.pptx" ;
    cme:renewalStatus "Renewed: 27 slides built from the third edition's chapter 3 and its RDODI research. The deck lineage records that 08-tooling/ch03-deck/deck_check_v1_0_0.py re-ran the 19 examples the deck shows under Python 3.14.4 with no mismatches and required the Merkle function shown to equal the one run, that a fixture with the difficulty result edited was refused by slide number, and that every slide was rendered to an image and inspected, four layout defects being fixed before the deck was built." ;
    dcterms:replaces sen0401:LegacyDeck_03 ;
    cme:servesOutcome sen0401:LO3 ;
    dcterms:source "03-materials/ch03/rdodi/sen0401_ch03_research_v1_1_0.ttl; verification quoted from 07-lineage/sen0401_slides_lineage_v0_21_0.ttl. Slide count read from the file on 2026-10-04." .

sen0401:Deck_Ch04_3e a schema:LearningResource ;
    dcterms:title "Chapter 4: Keys and Addresses - renewed for the third edition" ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation" ;
    cme:fileInPart "03-materials/ch04/SEN0401_Ch04_KeysAndAddresses_3e_v2_0_0.pptx" ;
    cme:renewalStatus "Renewed: 26 slides built from the third edition's chapter 4 and its RDODI research. The deck lineage records that 08-tooling/ch04-deck/deck_check_v1_0_0.py re-ran the 35 examples the deck shows under Python 3.14.4 with no mismatches and required the elliptic-curve functions shown to equal the ones run, that a fixture with the compressed public key edited was refused by slide number, and that every slide was rendered and inspected, a table that misread SEC 2's legend being corrected before the deck was built." ;
    dcterms:replaces sen0401:LegacyDeck_04 ;
    cme:servesOutcome sen0401:LO4 ;
    dcterms:source "03-materials/ch04/rdodi/sen0401_ch04_research_v1_1_0.ttl; verification quoted from 07-lineage/sen0401_slides_lineage_v0_21_0.ttl. Slide count read from the file on 2026-10-04." .

sen0401:Gap_Deck_Ch05 a schema:LearningResource ;
    dcterms:title "Chapter 5 has no deck" ;
    cme:renewalStatus "NOT PRESENT. Chapter 5, Wallet Recovery, has its research, ontology, document and interactive page at 1.0.0 but no slide deck: 03-materials/ch05 holds only the page and rdodi folders, measured 2026-10-04. Registered as an absence so the register does not read as if five chapters had decks." ;
    cme:servesOutcome sen0401:LO5 .

