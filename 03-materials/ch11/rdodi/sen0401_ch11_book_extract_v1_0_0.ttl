mbb:Passage_ch11_custom_signets a mbb:Passage ; rdfs:label "Where The Blockchain first indexes custom signets"@en ; mbb:inPart mbb:Chapter_11 ; mbb:text "Bitcoin Core supports a default signet, which we believe to be the most widely used signet at the time of writing." ; mbb:sourceLine 703 ; mbb:sourceFile "ch11_blockchain.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
