mbb:Passage_ch11_signet a mbb:Passage ; rdfs:label "Where The Blockchain first indexes signet"@en ; mbb:inPart mbb:Chapter_11 ; mbb:text "There's no known way for a system dependent on permissionless PoW to provide a highly usable blockchain without introducing economic incentives, so Bitcoin protocol developers began considering alternatives." ; mbb:sourceLine 677 ; mbb:sourceFile "ch11_blockchain.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_default_signet a mbb:Concept ; rdfs:label "default signet"@en ; mbb:mentionedInPart mbb:Chapter_11 ; mbb:indexedIn mbb:Sec_ch11_013 .
mbb:Concept_default_signet mbb:introducedIn mbb:Chapter_11 ; mbb:introducedBy mbb:Passage_ch11_default_signet .
mbb:Passage_ch11_default_signet a mbb:Passage ; rdfs:label "Where The Blockchain first indexes default signet"@en ; mbb:inPart mbb:Chapter_11 ; mbb:text "Bitcoin Core supports a default signet, which we believe to be the most widely used signet at the time of writing." ; mbb:sourceLine 703 ; mbb:sourceFile "ch11_blockchain.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
