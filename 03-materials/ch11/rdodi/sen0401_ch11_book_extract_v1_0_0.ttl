mbb:Concept_binary_hash_trees a mbb:Concept ; rdfs:label "binary hash trees"@en ; mbb:mentionedInPart mbb:Chapter_11 ; mbb:indexedIn mbb:Sec_ch11_006 .
mbb:Concept_binary_hash_trees mbb:introducedIn mbb:Chapter_11 ; mbb:introducedBy mbb:Passage_ch11_binary_hash_trees .
mbb:Passage_ch11_binary_hash_trees a mbb:Passage ; rdfs:label "Where The Blockchain first indexes binary hash trees"@en ; mbb:inPart mbb:Chapter_11 ; mbb:text "A merkle tree, also known as a binary hash tree, is a data structure used for efficiently summarizing and verifying the integrity of large sets of data." ; mbb:sourceLine 366 ; mbb:sourceFile "ch11_blockchain.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_balanced_merkle_trees a mbb:Concept ; rdfs:label "balanced merkle trees"@en ; mbb:mentionedInPart mbb:Chapter_11 ; mbb:indexedIn mbb:Sec_ch11_006 .
mbb:Concept_balanced_merkle_trees mbb:introducedIn mbb:Chapter_11 ; mbb:introducedBy mbb:Passage_ch11_balanced_merkle_trees .
mbb:Passage_ch11_balanced_merkle_trees a mbb:Passage ; rdfs:label "Where The Blockchain first indexes balanced merkle trees"@en ; mbb:inPart mbb:Chapter_11 ; mbb:text "If there are an odd number of transactions to summarize, the last transaction hash will be duplicated to create an even number of leaf nodes, also known as a balanced tree." ; mbb:sourceLine 425 ; mbb:sourceFile "ch11_blockchain.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_authentication_path a mbb:Concept ; rdfs:label "authentication path"@en ; mbb:mentionedInPart mbb:Chapter_11 ; mbb:indexedIn mbb:Sec_ch11_006 .
mbb:Concept_authentication_path mbb:introducedIn mbb:Chapter_11 ; mbb:introducedBy mbb:Passage_ch11_authentication_path .
mbb:Passage_ch11_authentication_path a mbb:Passage ; rdfs:label "Where The Blockchain first indexes authentication path"@en ; mbb:inPart mbb:Chapter_11 ; mbb:text "To prove that a specific transaction is included in a block, a node only needs to produce approximately log~2~(N) 32-byte hashes, constituting an authentication path or merkle path connecting the specific transaction to the root of the tree." ; mbb:sourceLine 495 ; mbb:sourceFile "ch11_blockchain.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_merkle_path a mbb:Concept ; rdfs:label "merkle path"@en ; mbb:mentionedInPart mbb:Chapter_11 ; mbb:indexedIn mbb:Sec_ch11_006 .
mbb:Concept_merkle_path mbb:introducedIn mbb:Chapter_11 ; mbb:introducedBy mbb:Passage_ch11_merkle_path .
mbb:Passage_ch11_merkle_path a mbb:Passage ; rdfs:label "Where The Blockchain first indexes merkle path"@en ; mbb:inPart mbb:Chapter_11 ; mbb:text "To prove that a specific transaction is included in a block, a node only needs to produce approximately log~2~(N) 32-byte hashes, constituting an authentication path or merkle path connecting the specific transaction to the root of the tree." ; mbb:sourceLine 495 ; mbb:sourceFile "ch11_blockchain.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
