mbb:Passage_ch11_test_blockchains a mbb:Passage ; rdfs:label "Where The Blockchain first indexes test blockchains"@en ; mbb:inPart mbb:Chapter_11 ; mbb:text "Testnet is the name of the test blockchain, network, and currency that is used for testing purposes." ; mbb:sourceLine 571 ; mbb:sourceFile "ch11_blockchain.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
