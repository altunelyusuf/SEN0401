mbb:Passage_ch11_child_blocks a mbb:Passage ; rdfs:label "Where The Blockchain first indexes child blocks"@en ; mbb:inPart mbb:Chapter_11 ; mbb:text "Although a block has just one parent, it can have multiple children." ; mbb:sourceLine 31 ; mbb:sourceFile "ch11_blockchain.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
