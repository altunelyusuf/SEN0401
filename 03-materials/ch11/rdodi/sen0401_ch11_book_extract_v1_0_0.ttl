mbb:Passage_ch11_mainnet a mbb:Passage ; rdfs:label "Where The Blockchain first indexes mainnet"@en ; mbb:inPart mbb:Chapter_11 ; mbb:text "The \"main\" Bitcoin blockchain, the one created by Satoshi Nakamoto on January 3rd, 2009, the one with the genesis block we studied in this chapter, is called mainnet." ; mbb:sourceLine 562 ; mbb:sourceFile "ch11_blockchain.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
mbb:Concept_test_blockchains a mbb:Concept ; rdfs:label "test blockchains"@en ; mbb:mentionedInPart mbb:Chapter_11 ; mbb:indexedIn mbb:Sec_ch11_009 ; mbb:indexedIn mbb:Sec_ch11_011 ; mbb:indexedIn mbb:Sec_ch11_012 ; mbb:indexedIn mbb:Sec_ch11_013 ; mbb:indexedIn mbb:Sec_ch11_014 ; mbb:indexedIn mbb:Sec_ch11_015 ; mbb:indexSubentry "development usage" ; mbb:indexSubentry "regtest" ; mbb:indexSubentry "signet" ; mbb:indexSubentry "testnet" .
