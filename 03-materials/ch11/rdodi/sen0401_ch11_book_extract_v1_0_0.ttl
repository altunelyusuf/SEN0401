mbb:Passage_ch11_block_header a mbb:Passage ; rdfs:label "Where The Blockchain first indexes block header"@en ; mbb:inPart mbb:Chapter_11 ; mbb:text "The block header consists of block metadata as shown in [block_header_structure_ch09]." ; mbb:sourceLine 119 ; mbb:sourceFile "ch11_blockchain.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
