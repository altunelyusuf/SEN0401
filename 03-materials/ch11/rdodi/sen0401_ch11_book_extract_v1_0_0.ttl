mbb:Passage_ch11_regtest a mbb:Passage ; rdfs:label "Where The Blockchain first indexes regtest"@en ; mbb:inPart mbb:Chapter_11 ; mbb:text "Regtest, which stands for \"Regression Testing,\" is a Bitcoin Core feature that allows you to create a local blockchain for testing purposes." ; mbb:sourceLine 755 ; mbb:sourceFile "ch11_blockchain.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
