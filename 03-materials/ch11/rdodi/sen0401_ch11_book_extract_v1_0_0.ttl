mbb:Passage_ch11_linking_blocks_in_blockchain a mbb:Passage ; rdfs:label "Where The Blockchain first indexes linking blocks in blockchain"@en ; mbb:inPart mbb:Chapter_11 ; mbb:text "Bitcoin full nodes validate every block in the blockchain after the genesis block." ; mbb:sourceLine 307 ; mbb:sourceFile "ch11_blockchain.adoc" ; mbb:pinnedCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ; dcterms:source mbb:Work ; dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ; dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .
