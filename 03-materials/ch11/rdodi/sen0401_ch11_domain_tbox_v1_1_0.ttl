#################################################################
# Connectedness repair (discipline v2.19.0, BP-D56 and BP-D57), 2026-10-19.
# The datatype properties the A-Box uses and nothing declared, then the relations
# between the chapter's subject branches that the chapter's own sources state.
#################################################################
chx:input a owl:DatatypeProperty ; rdfs:label "input expression"@en ; rdfs:comment "The expression an input/output example evaluates."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch11/tbox> .
chx:output a owl:DatatypeProperty ; rdfs:label "output value"@en ; rdfs:comment "The value that evaluating the example expression gives."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch11/tbox> .
chx:givesRootOfBlock a owl:ObjectProperty ; rdfs:label "gives the merkle root of"@en ;
    rdfs:comment "The merkle root in the header of block 277,315 is the root that the code reproduces from its 40 transaction ids. Basis: the chapter says of Links of block 277,315: 'merkle root 5e049f40...'; the chapter says of Real block root: 'the code reproduces the merkle root 5e049f40...'."@en ;
    rdfs:domain chx:Block277315Links ; rdfs:range chx:RealBlockRoot ; rdfs:isDefinedBy <http://example.org/sen0401/ch11/tbox> .
chx:holdsReversedHashOfParent a owl:ObjectProperty ; rdfs:label "holds the hash that links to"@en ;
    rdfs:comment "A block does not hold its own hash, but the header of the next block holds the reversed hash of it. Basis: the chapter says of Hash not stored in block: 'the header of block 481 holds the reversed hash of block 480'; the chapter says of Previous hash points to parent: 'every header's previous-hash field equalled the recomputed hash of the header before'."@en ;
    rdfs:domain chx:HashNotStoredInBlock ; rdfs:range chx:PreviousHashPointsToParent ; rdfs:isDefinedBy <http://example.org/sen0401/ch11/tbox> .
chx:explainsTwoChildren a owl:ObjectProperty ; rdfs:label "is shown by"@en ;
    rdfs:comment "Height does not name one block: two children of the same parent were both at height 511. Basis: the chapter says of Height is not unique: 'two children of the same parent were both at height 511'; the chapter says of Two children one parent: 'two different blocks with the same parent hash and the same height 511'."@en ;
    rdfs:domain chx:HeightIsNotUnique ; rdfs:range chx:TwoChildrenOneParent ; rdfs:isDefinedBy <http://example.org/sen0401/ch11/tbox> .
chx:hashesTheHeader a owl:ObjectProperty ; rdfs:label "is the hash of"@en ;
    rdfs:comment "The block hash is the SHA-256 of the SHA-256 of the 80-byte header. Basis: the chapter says of Block hash is double sha256: 'The block hash is the SHA-256 of the SHA-256 of the 80-byte header'; the chapter says of The header is 80 bytes: 'Every header'."@en ;
    rdfs:domain chx:BlockHashIsDoubleSha256 ; rdfs:range chx:HeaderIs80Bytes ; rdfs:isDefinedBy <http://example.org/sen0401/ch11/tbox> .
chx:constrainsTimestamp a owl:ObjectProperty ; rdfs:label "constrains"@en ;
    rdfs:comment "BIP 94 limits how much earlier than its parent the first block of a retarget period may be stamped. Basis: the chapter says of BIP 94 rules: 'the first block of a period may be no more than 600 seconds earlier than its parent'; the chapter says of Timestamp field: 'The timestamp is a 4-byte count of seconds since 1970-01-01'."@en ;
    rdfs:domain chx:Bip94Rules ; rdfs:range chx:TimestampField ; rdfs:isDefinedBy <http://example.org/sen0401/ch11/tbox> .
chx:reportsMedianTime a owl:ObjectProperty ; rdfs:label "reports"@en ;
    rdfs:comment "A fresh regtest node reports a median time of 1296688602. Basis: the chapter says of Regtest start state: 'median time 1296688602'; the chapter says of Median time past: 'A block's timestamp must be later than the median of the previous 11 timestamps'."@en ;
    rdfs:domain chx:RegtestStartState ; rdfs:range chx:MedianTimePast ; rdfs:isDefinedBy <http://example.org/sen0401/ch11/tbox> .
chx:usesDoubleHashOfChallenge a owl:ObjectProperty ; rdfs:label "uses the same double SHA-256 as"@en ;
    rdfs:comment "The message start of a signet is taken from the double SHA-256 of its challenge, the construction that also gives the block hash. Basis: the chapter says of Signet message start from the challenge: 'the first four bytes of the double SHA-256 of its challenge'; the chapter says of Block hash is double sha256: 'The block hash is the SHA-256 of the SHA-256 of the 80-byte header'."@en ;
    rdfs:domain chx:SignetMagicFromChallenge ; rdfs:range chx:BlockHashIsDoubleSha256 ; rdfs:isDefinedBy <http://example.org/sen0401/ch11/tbox> .
chx:differsInGenesisFrom a owl:ObjectProperty ; rdfs:label "differs in genesis from"@en ;
    rdfs:comment "Testnet4 has its own genesis coinbase while the other chains share one. Basis: the chapter says of Shared genesis transaction: 'testnet4 has its own coinbase of 180'; the chapter says of Testnet4 replaces testnet3: 'Testnet4 begins with a genesis block that quotes the Bitcoin block hash of 3 May 2024'."@en ;
    rdfs:domain chx:SharedGenesisTransaction ; rdfs:range chx:Testnet4Replaces ; rdfs:isDefinedBy <http://example.org/sen0401/ch11/tbox> .
chx:rebuildsFromBits a owl:ObjectProperty ; rdfs:label "is rebuilt from the bits of"@en ;
    rdfs:comment "The genesis block is rebuilt from the bits 0x1d00ffff, the compact target of difficulty 1. Basis: the chapter says of Genesis hash recomputed: 'the bits 0x1d00ffff'; the chapter says of Target compact encoding: '0x1d00ffff is the target 0xffff followed by 26 zero bytes'."@en ;
    rdfs:domain chx:GenesisHashRecomputed ; rdfs:range chx:TargetCompactEncoding ; rdfs:isDefinedBy <http://example.org/sen0401/ch11/tbox> .
chx:hasHeaderAndCount a owl:ObjectProperty ; rdfs:label "has the header and count of"@en ;
    rdfs:comment "A merkleblock holds the header, the transaction count and a few hashes instead of all the transactions. Basis: the chapter says of Merkleblock for light clients: 'header, count 16, 5 hashes, flags'; the chapter says of Block is header plus transactions: 'A block is the 80-byte header, then a counter of the transactions'."@en ;
    rdfs:domain chx:MerkleblockForLightClients ; rdfs:range chx:BlockIsHeaderPlusTransactions ; rdfs:isDefinedBy <http://example.org/sen0401/ch11/tbox> .
