chx:X_OutputScript a owl:NamedIndividual, chx:OutputScript ; rdfs:label "OP_DUP OP_HASH160 <hash> OP_EQUALVERIFY OP_CHECKSIG"@en ; skos:definition "An output script, called scriptPubKey in the code, states the conditions that must be met to spend the output in the future, such as who is authorized to spend it and how they will be authenticated."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_OutputScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"script = bytes.fromhex('76a914ab68025513c3dbd2f7b92a94e0581f5d50f654e788ac')\\nresult = (len(script), script[0], script[-1])\", g), g['result'])[1])({}) evaluates to (25, 118, 172)"@en ; chx:input "(lambda g: (exec(\"script = bytes.fromhex('76a914ab68025513c3dbd2f7b92a94e0581f5d50f654e788ac')\\nresult = (len(script), script[0], script[-1])\", g), g['result'])[1])({})" ; chx:output "(25, 118, 172)" .
chx:X_OutputScript rd:hasIOExample chx:IO_OutputScript .
chx:X_InputScript a owl:NamedIndividual, chx:InputScript ; rdfs:label "<signature> <public key>"@en ; skos:definition "An input script, called scriptSig in the code, is a script that satisfies the conditions placed in an output script and so allows the output to be spent; in legacy transactions it usually holds a signature and a public key."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_InputScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"ss = bytes.fromhex('493046022100bc57dc26f46fecc1da03272cb2298d8a08b22d865541f5b3a3e862cc87da4b47022100ce1fc72771d164d608b15065832542a0e9040cfdf28862c5175c81fcb0e0b65501410434417dd8d89deaf0f6481c2c160d6de0921624ef7b956f38eef9ed4a64e36877be84b77cdee5a8d92b7d93694f89c3011bf1cbdf4fd7d8ca13b58a7bb4ab0804')\\npushes, i = [], 0\\nwhile i < len(ss):\\n    pushes.append(ss[i]); i += 1 + ss[i]       # each item is a length byte followed by that many bytes\\nresult = pushes\", g), g['result'])[1])({}) evaluates to [73, 65]"@en ; chx:input "(lambda g: (exec(\"ss = bytes.fromhex('493046022100bc57dc26f46fecc1da03272cb2298d8a08b22d865541f5b3a3e862cc87da4b47022100ce1fc72771d164d608b15065832542a0e9040cfdf28862c5175c81fcb0e0b65501410434417dd8d89deaf0f6481c2c160d6de0921624ef7b956f38eef9ed4a64e36877be84b77cdee5a8d92b7d93694f89c3011bf1cbdf4fd7d8ca13b58a7bb4ab0804')\\npushes, i = [], 0\\nwhile i < len(ss):\\n    pushes.append(ss[i]); i += 1 + ss[i]       # each item is a length byte followed by that many bytes\\nresult = pushes\", g), g['result'])[1])({})" ; chx:output "[73, 65]" .
chx:X_InputScript rd:hasIOExample chx:IO_InputScript .
chx:X_ScriptTruth a owl:NamedIndividual, chx:ScriptTruth ; rdfs:label "the top item is true: any non-zero value"@en ; skos:definition "A script succeeds when it runs without error and leaves a non-zero value on top of the stack; zero, negative zero, an empty item and an empty stack are false."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_ScriptTruth a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\nresult = [(b.hex() or 'empty', true(b)) for b in (b'', b'\\\\x00', b'\\\\x80', b'\\\\x01', b'\\\\x00\\\\x01')]\", g), g['result'])[1])({}) evaluates to [('empty', False), ('00', False), ('80', False), ('01', True), ('0001', True)]"@en ; chx:input "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\nresult = [(b.hex() or 'empty', true(b)) for b in (b'', b'\\\\x00', b'\\\\x80', b'\\\\x01', b'\\\\x00\\\\x01')]\", g), g['result'])[1])({})" ; chx:output "[('empty', False), ('00', False), ('80', False), ('01', True), ('0001', True)]" .
chx:X_ScriptTruth rd:hasIOExample chx:IO_ScriptTruth .
chx:X_SeparateExecution a owl:NamedIndividual, chx:SeparateExecution ; rdfs:label "the input script runs first; its stack is passed to the output script"@en ; skos:definition "Since 2010 the input script and the output script are executed one after the other, with the stack that the first leaves transferred to the second, instead of being joined into a single script."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_SeparateExecution a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\njoined = run('2 3 ADD 5 EQUAL')\\nafter_input = run('2')\\nseparate = run('3 ADD 5 EQUAL', after_input)\\nresult = (separate == joined, [dec(x) for x in after_input])\", g), g['result'])[1])({}) evaluates to (True, [2])"@en ; chx:input "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\njoined = run('2 3 ADD 5 EQUAL')\\nafter_input = run('2')\\nseparate = run('3 ADD 5 EQUAL', after_input)\\nresult = (separate == joined, [dec(x) for x in after_input])\", g), g['result'])[1])({})" ; chx:output "(True, [2])" .
chx:X_SeparateExecution rd:hasIOExample chx:IO_SeparateExecution .
chx:X_OpReturnBug a owl:NamedIndividual, chx:OpReturnBug ; rdfs:label "CVE-2010-5141: an input script of 1 OP_RETURN spent any output"@en ; skos:definition "In the first release the two scripts were joined and OP_RETURN jumped to the end of the joined script, so an input script that began with a true value and then executed OP_RETURN made any output spendable by anyone."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_OpReturnBug a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\nlock = 'SHA256 0x' + hashlib.sha256(b'secret').hexdigest() + ' EQUAL'\\nthief, owner = '1 RETURN', '0x' + b'secret'.hex()\\ndef old(sig):                               # joined scripts: OP_RETURN jumps to the end of everything\\n    words = (sig + ' ' + lock).split()\\n    if 'RETURN' in words: words = words[:words.index('RETURN')]\\n    return true(run(' '.join(words))[-1])\\ndef new(sig):                               # one after the other: the input script, then the output script on its stack\\n    st = run(sig)\\n    out = [] if isinstance(st, str) else run(lock, st)\\n    return not isinstance(out, str) and bool(out) and true(out[-1])\\nresult = (old(thief), new(thief), new(owner))\", g), g['result'])[1])({}) evaluates to (True, False, True)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\nlock = 'SHA256 0x' + hashlib.sha256(b'secret').hexdigest() + ' EQUAL'\\nthief, owner = '1 RETURN', '0x' + b'secret'.hex()\\ndef old(sig):                               # joined scripts: OP_RETURN jumps to the end of everything\\n    words = (sig + ' ' + lock).split()\\n    if 'RETURN' in words: words = words[:words.index('RETURN')]\\n    return true(run(' '.join(words))[-1])\\ndef new(sig):                               # one after the other: the input script, then the output script on its stack\\n    st = run(sig)\\n    out = [] if isinstance(st, str) else run(lock, st)\\n    return not isinstance(out, str) and bool(out) and true(out[-1])\\nresult = (old(thief), new(thief), new(owner))\", g), g['result'])[1])({})" ; chx:output "(True, False, True)" .
chx:X_OpReturnBug rd:hasIOExample chx:IO_OpReturnBug .
chx:X_PayToPublicKey a owl:NamedIndividual, chx:PayToPublicKey ; rdfs:label "<public key> OP_CHECKSIG"@en ; skos:definition "A pay to public key output holds the public key itself followed by the signature operator, so that it is spent by a signature that the key can verify; it is the form in which Bitcoin was first described and used."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_PayToPublicKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"spk = bytes.fromhex('410411db93e1dcdb8a016b49840f8c53bc1eb68a382e97b1482ecad7b148a6909a5cb2e0eaddfb84ccf9744464f82e160bfa9b8b64f9d4c03f999b8643f656b412a3ac')\\nresult = (len(spk), spk[0], spk[-1])\", g), g['result'])[1])({}) evaluates to (67, 65, 172)"@en ; chx:input "(lambda g: (exec(\"spk = bytes.fromhex('410411db93e1dcdb8a016b49840f8c53bc1eb68a382e97b1482ecad7b148a6909a5cb2e0eaddfb84ccf9744464f82e160bfa9b8b64f9d4c03f999b8643f656b412a3ac')\\nresult = (len(spk), spk[0], spk[-1])\", g), g['result'])[1])({})" ; chx:output "(67, 65, 172)" .
chx:X_PayToPublicKey rd:hasIOExample chx:IO_PayToPublicKey .
chx:X_PublicKeyHash a owl:NamedIndividual, chx:PublicKeyHash ; rdfs:label "HASH160 of the public key: RIPEMD-160(SHA-256(key))"@en ; skos:definition "A public key hash is the 20-byte digest obtained by applying SHA-256 and then RIPEMD-160 to a public key; the legacy address that begins with a 1 is its Base58Check encoding."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_PublicKeyHash a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nA = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'\\ndef b58check(version, payload):              # Base58Check: version byte + payload + 4 checksum bytes, written in base 58\\n    d = bytes([version]) + payload\\n    d += hashlib.sha256(hashlib.sha256(d).digest()).digest()[:4]\\n    n, s = int.from_bytes(d, 'big'), ''\\n    while n: n, r = divmod(n, 58); s = A[r] + s\\n    return '1' * (len(d) - len(d.lstrip(b'\\\\0'))) + s\\nh = bytes.fromhex('751e76e8199196d454941c45d1b3a323f1433bd6')       # HASH160 of the compressed generator point\\nresult = b58check(0, h)\", g), g['result'])[1])({}) evaluates to '1BgGZ9tcN4rm9KBzDn7KprQz87SZ26SAMH'"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nA = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'\\ndef b58check(version, payload):              # Base58Check: version byte + payload + 4 checksum bytes, written in base 58\\n    d = bytes([version]) + payload\\n    d += hashlib.sha256(hashlib.sha256(d).digest()).digest()[:4]\\n    n, s = int.from_bytes(d, 'big'), ''\\n    while n: n, r = divmod(n, 58); s = A[r] + s\\n    return '1' * (len(d) - len(d.lstrip(b'\\\\0'))) + s\\nh = bytes.fromhex('751e76e8199196d454941c45d1b3a323f1433bd6')       # HASH160 of the compressed generator point\\nresult = b58check(0, h)\", g), g['result'])[1])({})" ; chx:output "'1BgGZ9tcN4rm9KBzDn7KprQz87SZ26SAMH'" .
chx:X_PublicKeyHash rd:hasIOExample chx:IO_PublicKeyHash .
chx:X_PayToPublicKeyHash a owl:NamedIndividual, chx:PayToPublicKeyHash ; rdfs:label "OP_DUP OP_HASH160 <key hash> OP_EQUALVERIFY OP_CHECKSIG"@en ; skos:definition "A pay to public key hash output script contains a hash that commits to a public key, and it is spent by presenting a public key that matches the hash together with a signature made by the corresponding private key."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_PayToPublicKeyHash a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"script = bytes.fromhex('76a914ab68025513c3dbd2f7b92a94e0581f5d50f654e788ac')\\nnames = {0x76: 'DUP', 0xa9: 'HASH160', 0x88: 'EQUALVERIFY', 0xac: 'CHECKSIG'}\\nresult = [names.get(script[0]), names.get(script[1]), 'PUSH %d' % script[2], names.get(script[23]), names.get(script[24])]\", g), g['result'])[1])({}) evaluates to ['DUP', 'HASH160', 'PUSH 20', 'EQUALVERIFY', 'CHECKSIG']"@en ; chx:input "(lambda g: (exec(\"script = bytes.fromhex('76a914ab68025513c3dbd2f7b92a94e0581f5d50f654e788ac')\\nnames = {0x76: 'DUP', 0xa9: 'HASH160', 0x88: 'EQUALVERIFY', 0xac: 'CHECKSIG'}\\nresult = [names.get(script[0]), names.get(script[1]), 'PUSH %d' % script[2], names.get(script[23]), names.get(script[24])]\", g), g['result'])[1])({})" ; chx:output "['DUP', 'HASH160', 'PUSH 20', 'EQUALVERIFY', 'CHECKSIG']" .
chx:X_PayToPublicKeyHash rd:hasIOExample chx:IO_PayToPublicKeyHash .
chx:X_OpChecksig a owl:NamedIndividual, chx:OpChecksig ; rdfs:label "<signature> <public key> OP_CHECKSIG"@en ; skos:definition "OP_CHECKSIG pops a public key and a signature, checks the signature against a hash of the spending transaction, and pushes true if it is valid and false otherwise."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_OpChecksig a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nP = 2**256 - 2**32 - 977\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nG = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\\ndef add(a, b):                               # point addition on y^2 = x^3 + 7 (None is the point at infinity)\\n    if a is None or b is None: return a or b\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return x, (m * (a[0] - x) - a[1]) % P\\ndef mul(k, p):\\n    r = None\\n    while k:\\n        if k & 1: r = add(r, p)\\n        p, k = add(p, p), k >> 1\\n    return r\\ndef pubkey(sec):                             # a 33- or 65-byte public key as a point\\n    x = int.from_bytes(sec[1:33], 'big')\\n    if sec[0] == 4: return x, int.from_bytes(sec[33:65], 'big')\\n    y = pow(x**3 + 7, (P + 1) // 4, P)\\n    return x, y if y % 2 == sec[0] % 2 else P - y\\ndef verify(sec, z, r, s):                    # ECDSA: R = (z/s)G + (r/s)Q must have x = r (mod n)\\n    w = pow(s, -1, N)\\n    R = add(mul(z * w % N, G), mul(r * w % N, pubkey(sec)))\\n    return R is not None and R[0] % N == r\\ntx = bytes.fromhex('')\\nspk = bytes.fromhex('410411db93e1dcdb8a016b49840f8c53bc1eb68a382e97b1482ecad7b148a6909a5cb2e0eaddfb84ccf9744464f82e160bfa9b8b64f9d4c03f999b8643f656b412a3ac')\\nn = tx[41]; sig = tx[42:42 + n][1:-1]                     # the input script is one push: the DER signature and one hash-type byte\\nrl = sig[3]; r = int.from_bytes(sig[4:4 + rl], 'big'); sl = sig[5 + rl]; s = int.from_bytes(sig[6 + rl:6 + rl + sl], 'big')\\npreimage = tx[:41] + bytes([len(spk)]) + spk + tx[42 + n:] + (1).to_bytes(4, 'little')    # the transaction with the locking script in place of the input script, then SIGHASH_ALL\\nz = int.from_bytes(hashlib.sha256(hashlib.sha256(preimage).digest()).digest(), 'big')\\nresult = (verify(spk[1:66], z, r, s), verify(spk[1:66], z + 1, r, s))\", g), g['result'])[1])({}) evaluates to (True, False)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nP = 2**256 - 2**32 - 977\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nG = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\\ndef add(a, b):                               # point addition on y^2 = x^3 + 7 (None is the point at infinity)\\n    if a is None or b is None: return a or b\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return x, (m * (a[0] - x) - a[1]) % P\\ndef mul(k, p):\\n    r = None\\n    while k:\\n        if k & 1: r = add(r, p)\\n        p, k = add(p, p), k >> 1\\n    return r\\ndef pubkey(sec):                             # a 33- or 65-byte public key as a point\\n    x = int.from_bytes(sec[1:33], 'big')\\n    if sec[0] == 4: return x, int.from_bytes(sec[33:65], 'big')\\n    y = pow(x**3 + 7, (P + 1) // 4, P)\\n    return x, y if y % 2 == sec[0] % 2 else P - y\\ndef verify(sec, z, r, s):                    # ECDSA: R = (z/s)G + (r/s)Q must have x = r (mod n)\\n    w = pow(s, -1, N)\\n    R = add(mul(z * w % N, G), mul(r * w % N, pubkey(sec)))\\n    return R is not None and R[0] % N == r\\ntx = bytes.fromhex('')\\nspk = bytes.fromhex('410411db93e1dcdb8a016b49840f8c53bc1eb68a382e97b1482ecad7b148a6909a5cb2e0eaddfb84ccf9744464f82e160bfa9b8b64f9d4c03f999b8643f656b412a3ac')\\nn = tx[41]; sig = tx[42:42 + n][1:-1]                     # the input script is one push: the DER signature and one hash-type byte\\nrl = sig[3]; r = int.from_bytes(sig[4:4 + rl], 'big'); sl = sig[5 + rl]; s = int.from_bytes(sig[6 + rl:6 + rl + sl], 'big')\\npreimage = tx[:41] + bytes([len(spk)]) + spk + tx[42 + n:] + (1).to_bytes(4, 'little')    # the transaction with the locking script in place of the input script, then SIGHASH_ALL\\nz = int.from_bytes(hashlib.sha256(hashlib.sha256(preimage).digest()).digest(), 'big')\\nresult = (verify(spk[1:66], z, r, s), verify(spk[1:66], z + 1, r, s))\", g), g['result'])[1])({})" ; chx:output "(True, False)" .
chx:X_OpChecksig rd:hasIOExample chx:IO_OpChecksig .
chx:X_SignatureHash a owl:NamedIndividual, chx:SignatureHash ; rdfs:label "SIGHASH_ALL = 0x01 commits to all inputs and all outputs"@en ; skos:definition "The signature hash, or commitment hash, is the digest of a modified copy of the transaction plus the hash type, and the hash type, one byte appended to the signature, says which parts of the transaction the signature commits to."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_SignatureHash a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"types = {'ALL': 1, 'NONE': 2, 'SINGLE': 3}\\nANYONECANPAY = 0x80\\nresult = [(name + ('|ANYONECANPAY' if flag else ''), hex(v | flag)) for flag in (0, ANYONECANPAY) for name, v in types.items()]\", g), g['result'])[1])({}) evaluates to [('ALL', '0x1'), ('NONE', '0x2'), ('SINGLE', '0x3'), ('ALL|ANYONECANPAY', '0x81'), ('NONE|ANYONECANPAY', '0x82'), ('SINGLE|ANYONECANPAY', '0x83')]"@en ; chx:input "(lambda g: (exec(\"types = {'ALL': 1, 'NONE': 2, 'SINGLE': 3}\\nANYONECANPAY = 0x80\\nresult = [(name + ('|ANYONECANPAY' if flag else ''), hex(v | flag)) for flag in (0, ANYONECANPAY) for name, v in types.items()]\", g), g['result'])[1])({})" ; chx:output "[('ALL', '0x1'), ('NONE', '0x2'), ('SINGLE', '0x3'), ('ALL|ANYONECANPAY', '0x81'), ('NONE|ANYONECANPAY', '0x82'), ('SINGLE|ANYONECANPAY', '0x83')]" .
chx:X_SignatureHash rd:hasIOExample chx:IO_SignatureHash .
chx:X_SignatureEncoding a owl:NamedIndividual, chx:SignatureEncoding ; rdfs:label "30 <len> 02 <len r> r 02 <len s> s <hash type>"@en ; skos:definition "An ECDSA signature is the pair of integers r and s written in DER, the Distinguished Encoding Rules, followed by one hash-type byte; Bitcoin requires the strict form of DER and policy requires the lower of the two possible values of s."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_SignatureEncoding a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"tx = bytes.fromhex('')\\nn = tx[41]; push = tx[42:42 + n]; sig = push[1:]\\nresult = (hex(sig[0]), sig[1], sig[3], sig[5 + sig[3]], sig[-1])\", g), g['result'])[1])({}) evaluates to ('0x30', 68, 32, 32, 1)"@en ; chx:input "(lambda g: (exec(\"tx = bytes.fromhex('')\\nn = tx[41]; push = tx[42:42 + n]; sig = push[1:]\\nresult = (hex(sig[0]), sig[1], sig[3], sig[5 + sig[3]], sig[-1])\", g), g['result'])[1])({})" ; chx:output "('0x30', 68, 32, 32, 1)" .
chx:X_SignatureEncoding rd:hasIOExample chx:IO_SignatureEncoding .
chx:X_ScriptedMultisignature a owl:NamedIndividual, chx:ScriptedMultisignature ; rdfs:label "2 <sig B> <sig C> ... OP_CHECKMULTISIG"@en ; skos:definition "A scripted multisignature output lists k public keys and requires at least t valid signatures from them, given in the same order as the keys, before it can be spent."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_ScriptedMultisignature a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nP = 2**256 - 2**32 - 977\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nG = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\\ndef add(a, b):                               # point addition on y^2 = x^3 + 7 (None is the point at infinity)\\n    if a is None or b is None: return a or b\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return x, (m * (a[0] - x) - a[1]) % P\\ndef mul(k, p):\\n    r = None\\n    while k:\\n        if k & 1: r = add(r, p)\\n        p, k = add(p, p), k >> 1\\n    return r\\ndef pubkey(sec):                             # a 33- or 65-byte public key as a point\\n    x = int.from_bytes(sec[1:33], 'big')\\n    if sec[0] == 4: return x, int.from_bytes(sec[33:65], 'big')\\n    y = pow(x**3 + 7, (P + 1) // 4, P)\\n    return x, y if y % 2 == sec[0] % 2 else P - y\\ndef verify(sec, z, r, s):                    # ECDSA: R = (z/s)G + (r/s)Q must have x = r (mod n)\\n    w = pow(s, -1, N)\\n    R = add(mul(z * w % N, G), mul(r * w % N, pubkey(sec)))\\n    return R is not None and R[0] % N == r\\n\\ndef checkmultisig(sigs, keys, z):\\n    sigs, keys = list(sigs), list(keys)      # the engine starts from the top of the stack: the last key and the last signature\\n    while sigs:\\n        if verify(keys[-1], z, *sigs[-1]): sigs.pop()\\n        keys.pop()\\n        if len(sigs) > len(keys): return False\\n    return True\\nz = int('3b21c61230fc5b234fef6a894f008ad633c55138a46f415b10d39622858e4560', 16)\\nA, B, C = (bytes.fromhex(k) for k in ('03774ae7f858a9411e5ef4246b70c65aac5649980be5c17891bbec17895da008cb', '03d01115d548e7561b15c38f004d734633687cf4419620095bc5b0f47070afe85a', '03f28773c2d975288bc7d1d205c3748651b075fbc6610e58cddeeddf8f19405aa8'))\\nsB, sC = (0x7e7e66cd29902c4ba2bb06d0c2b8d3dda0e6d0f0329c386225ae3a333ef4796e, 0x6e33926f2dc02a6ad04f28769865fd9fe25caa5c446c247d22517bf1cbd54c2), (0x1f4a142c40ea17b00bbf9abae877025e1e4b4d5151b74dbb74466f7236c7b8a4, 0x2204972b18bc9eb7a25b3e00f5025bbfe620cb1bb67d3a83633f422ee8600fa1)\\nresult = (checkmultisig([sB, sC], [A, B, C], z), checkmultisig([sC, sB], [A, B, C], z))\", g), g['result'])[1])({}) evaluates to (True, False)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nP = 2**256 - 2**32 - 977\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nG = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\\ndef add(a, b):                               # point addition on y^2 = x^3 + 7 (None is the point at infinity)\\n    if a is None or b is None: return a or b\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return x, (m * (a[0] - x) - a[1]) % P\\ndef mul(k, p):\\n    r = None\\n    while k:\\n        if k & 1: r = add(r, p)\\n        p, k = add(p, p), k >> 1\\n    return r\\ndef pubkey(sec):                             # a 33- or 65-byte public key as a point\\n    x = int.from_bytes(sec[1:33], 'big')\\n    if sec[0] == 4: return x, int.from_bytes(sec[33:65], 'big')\\n    y = pow(x**3 + 7, (P + 1) // 4, P)\\n    return x, y if y % 2 == sec[0] % 2 else P - y\\ndef verify(sec, z, r, s):                    # ECDSA: R = (z/s)G + (r/s)Q must have x = r (mod n)\\n    w = pow(s, -1, N)\\n    R = add(mul(z * w % N, G), mul(r * w % N, pubkey(sec)))\\n    return R is not None and R[0] % N == r\\n\\ndef checkmultisig(sigs, keys, z):\\n    sigs, keys = list(sigs), list(keys)      # the engine starts from the top of the stack: the last key and the last signature\\n    while sigs:\\n        if verify(keys[-1], z, *sigs[-1]): sigs.pop()\\n        keys.pop()\\n        if len(sigs) > len(keys): return False\\n    return True\\nz = int('3b21c61230fc5b234fef6a894f008ad633c55138a46f415b10d39622858e4560', 16)\\nA, B, C = (bytes.fromhex(k) for k in ('03774ae7f858a9411e5ef4246b70c65aac5649980be5c17891bbec17895da008cb', '03d01115d548e7561b15c38f004d734633687cf4419620095bc5b0f47070afe85a', '03f28773c2d975288bc7d1d205c3748651b075fbc6610e58cddeeddf8f19405aa8'))\\nsB, sC = (0x7e7e66cd29902c4ba2bb06d0c2b8d3dda0e6d0f0329c386225ae3a333ef4796e, 0x6e33926f2dc02a6ad04f28769865fd9fe25caa5c446c247d22517bf1cbd54c2), (0x1f4a142c40ea17b00bbf9abae877025e1e4b4d5151b74dbb74466f7236c7b8a4, 0x2204972b18bc9eb7a25b3e00f5025bbfe620cb1bb67d3a83633f422ee8600fa1)\\nresult = (checkmultisig([sB, sC], [A, B, C], z), checkmultisig([sC, sB], [A, B, C], z))\", g), g['result'])[1])({})" ; chx:output "(True, False)" .
chx:X_ScriptedMultisignature rd:hasIOExample chx:IO_ScriptedMultisignature .
chx:X_MultisigLimits a owl:NamedIndividual, chx:MultisigLimits ; rdfs:label "15 keys fit a script hash, 20 keys fit a witness script"@en ; skos:definition "The number of keys a multisignature may list is limited in three different ways: three for a bare script by relay policy, fifteen for a script hash because of the 520-byte limit on a script element, and twenty for every script by consensus."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_MultisigLimits a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('def size(k): return 3 + 34 * k          # OP_t, k pushes of 33 bytes plus the length byte, OP_k, OP_CHECKMULTISIG\\nresult = (size(15), size(16), size(15) <= 520, size(16) <= 520)', g), g['result'])[1])({}) evaluates to (513, 547, True, False)"@en ; chx:input "(lambda g: (exec('def size(k): return 3 + 34 * k          # OP_t, k pushes of 33 bytes plus the length byte, OP_k, OP_CHECKMULTISIG\\nresult = (size(15), size(16), size(15) <= 520, size(16) <= 520)', g), g['result'])[1])({})" ; chx:output "(513, 547, True, False)" .
chx:X_MultisigLimits rd:hasIOExample chx:IO_MultisigLimits .
chx:X_CheckmultisigDummy a owl:NamedIndividual, chx:CheckmultisigDummy ; rdfs:label "OP_0 <sig B> <sig C> 2 <A> <B> <C> 3 OP_CHECKMULTISIG"@en ; skos:definition "The dummy element is the extra stack item that OP_CHECKMULTISIG pops after its signatures; its content is ignored by the opcode itself, but since BIP147 it must be an empty byte array."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_CheckmultisigDummy a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"stack = ['', 'sigB', 'sigC', '2', 'pkA', 'pkB', 'pkC', '3']       # the combined script of the book, after all its pushes\\nk = int(stack.pop())\\nkeys = [stack.pop() for _ in range(k)]\\nt = int(stack.pop())\\nsigs = [stack.pop() for _ in range(t)]\\nresult = (t + k + 2, 8 - len(stack))        # the items the opcode should take, the items it took before the dummy\", g), g['result'])[1])({}) evaluates to (7, 7)"@en ; chx:input "(lambda g: (exec(\"stack = ['', 'sigB', 'sigC', '2', 'pkA', 'pkB', 'pkC', '3']       # the combined script of the book, after all its pushes\\nk = int(stack.pop())\\nkeys = [stack.pop() for _ in range(k)]\\nt = int(stack.pop())\\nsigs = [stack.pop() for _ in range(t)]\\nresult = (t + k + 2, 8 - len(stack))        # the items the opcode should take, the items it took before the dummy\", g), g['result'])[1])({})" ; chx:output "(7, 7)" .
chx:X_CheckmultisigDummy rd:hasIOExample chx:IO_CheckmultisigDummy .
chx:X_SignatureCheckCount a owl:NamedIndividual, chx:SignatureCheckCount ; rdfs:label "a 1-of-5 spend by the first key costs five checks"@en ; skos:definition "The opcode compares signatures with keys one by one, and a signature that matches a key that is far from the top of the stack is found only after many failed attempts, so that the number of checks can be as large as the number of keys."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_SignatureCheckCount a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"keys = ['k0', 'k1', 'k2', 'k3', 'k4']\\ndef checks(signer):                           # the engine tries the key on top of the stack first, then the next one\\n    n = 0\\n    for key in reversed(keys):\\n        n += 1\\n        if key == signer: return n\\nresult = (checks('k4'), checks('k0'))\", g), g['result'])[1])({}) evaluates to (1, 5)"@en ; chx:input "(lambda g: (exec(\"keys = ['k0', 'k1', 'k2', 'k3', 'k4']\\ndef checks(signer):                           # the engine tries the key on top of the stack first, then the next one\\n    n = 0\\n    for key in reversed(keys):\\n        n += 1\\n        if key == signer: return n\\nresult = (checks('k4'), checks('k0'))\", g), g['result'])[1])({})" ; chx:output "(1, 5)" .
chx:X_SignatureCheckCount rd:hasIOExample chx:IO_SignatureCheckCount .
chx:X_PayToScriptHashOutput a owl:NamedIndividual, chx:PayToScriptHashOutput ; rdfs:label "OP_HASH160 <20-byte script hash> OP_EQUAL"@en ; skos:definition "A pay to script hash output script holds only the 20-byte HASH160 of a script, so that whoever spends it must present a script that hashes to the same value and then satisfy that script."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_PayToScriptHashOutput a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"h = '54c557e07dde5bb6cb791c7a540e0a4796f5e97e'                  # the hash the book gives for Mohammed's redeem script\\nspk = 'a914' + h + '87'                       # OP_HASH160, push of 20 bytes, the hash, OP_EQUAL\\nresult = (spk, len(spk) // 2)\", g), g['result'])[1])({}) evaluates to ('a91454c557e07dde5bb6cb791c7a540e0a4796f5e97e87', 23)"@en ; chx:input "(lambda g: (exec(\"h = '54c557e07dde5bb6cb791c7a540e0a4796f5e97e'                  # the hash the book gives for Mohammed's redeem script\\nspk = 'a914' + h + '87'                       # OP_HASH160, push of 20 bytes, the hash, OP_EQUAL\\nresult = (spk, len(spk) // 2)\", g), g['result'])[1])({})" ; chx:output "('a91454c557e07dde5bb6cb791c7a540e0a4796f5e97e87', 23)" .
chx:X_PayToScriptHashOutput rd:hasIOExample chx:IO_PayToScriptHashOutput .
chx:X_RedeemScript a owl:NamedIndividual, chx:RedeemScript ; rdfs:label "<sig> ... <redeem script>"@en ; skos:definition "The redeem script is the script whose hash is committed to in a pay to script hash output; it is revealed as the last item of the input script when the output is spent and is then executed with the items that precede it."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_RedeemScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"ss = bytes.fromhex('00483045022100ba4c78ddef0abe9dcf336a60712045f8594c5c474d60639af56e3b992ec35989022045935caa747ea9ffc534e963af0d575a03aa4a8bec37494ad8e792a70929398b0147512103774ae7f858a9411e5ef4246b70c65aac5649980be5c17891bbec17895da008cb2103d01115d548e7561b15c38f004d734633687cf4419620095bc5b0f47070afe85a52ae')\\nitems, pos = [], 0\\nwhile pos < len(ss):\\n    op = ss[pos]; pos += 1\\n    n = op if op < 76 else ss[pos]               # a direct push, or OP_PUSHDATA1 and a length byte\\n    if op == 76: pos += 1\\n    items.append(ss[pos:pos + n]); pos += n\\nresult = ([len(i) for i in items], items[-1][-1])\", g), g['result'])[1])({}) evaluates to ([0, 72, 71], 174)"@en ; chx:input "(lambda g: (exec(\"ss = bytes.fromhex('00483045022100ba4c78ddef0abe9dcf336a60712045f8594c5c474d60639af56e3b992ec35989022045935caa747ea9ffc534e963af0d575a03aa4a8bec37494ad8e792a70929398b0147512103774ae7f858a9411e5ef4246b70c65aac5649980be5c17891bbec17895da008cb2103d01115d548e7561b15c38f004d734633687cf4419620095bc5b0f47070afe85a52ae')\\nitems, pos = [], 0\\nwhile pos < len(ss):\\n    op = ss[pos]; pos += 1\\n    n = op if op < 76 else ss[pos]               # a direct push, or OP_PUSHDATA1 and a length byte\\n    if op == 76: pos += 1\\n    items.append(ss[pos:pos + n]); pos += n\\nresult = ([len(i) for i in items], items[-1][-1])\", g), g['result'])[1])({})" ; chx:output "([0, 72, 71], 174)" .
chx:X_RedeemScript rd:hasIOExample chx:IO_RedeemScript .
chx:X_P2shAddress a owl:NamedIndividual, chx:P2shAddress ; rdfs:label "version byte 5 gives an address that starts with 3"@en ; skos:definition "A P2SH address is the Base58Check encoding of the 20-byte script hash with a version byte of 5, which makes it begin with the character 3."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_P2shAddress a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nA = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'\\ndef b58check(version, payload):              # Base58Check: version byte + payload + 4 checksum bytes, written in base 58\\n    d = bytes([version]) + payload\\n    d += hashlib.sha256(hashlib.sha256(d).digest()).digest()[:4]\\n    n, s = int.from_bytes(d, 'big'), ''\\n    while n: n, r = divmod(n, 58); s = A[r] + s\\n    return '1' * (len(d) - len(d.lstrip(b'\\\\0'))) + s\\nh = bytes.fromhex('54c557e07dde5bb6cb791c7a540e0a4796f5e97e')\\nresult = b58check(5, h)\", g), g['result'])[1])({}) evaluates to '39RF6JqABiHdYHkfChV6USGMe6Nsr66Gzw'"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nA = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'\\ndef b58check(version, payload):              # Base58Check: version byte + payload + 4 checksum bytes, written in base 58\\n    d = bytes([version]) + payload\\n    d += hashlib.sha256(hashlib.sha256(d).digest()).digest()[:4]\\n    n, s = int.from_bytes(d, 'big'), ''\\n    while n: n, r = divmod(n, 58); s = A[r] + s\\n    return '1' * (len(d) - len(d.lstrip(b'\\\\0'))) + s\\nh = bytes.fromhex('54c557e07dde5bb6cb791c7a540e0a4796f5e97e')\\nresult = b58check(5, h)\", g), g['result'])[1])({})" ; chx:output "'39RF6JqABiHdYHkfChV6USGMe6Nsr66Gzw'" .
chx:X_P2shAddress rd:hasIOExample chx:IO_P2shAddress .
chx:X_P2shBenefits a owl:NamedIndividual, chx:P2shBenefits ; rdfs:label "the long script moves from the payer to the spender"@en ; skos:definition "P2SH makes a complex payment as easy as an ordinary one for the payer and shifts the storage and the fee of the long script to the later spender."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_P2shBenefits a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('redeem = 3 + 34 * 5                 # a 2-of-5 script with compressed keys: OP_2, five pushes of 33 bytes, OP_5, OP_CHECKMULTISIG\\nspk = 23                                # the P2SH output script\\nresult = (redeem, spk, redeem - spk)', g), g['result'])[1])({}) evaluates to (173, 23, 150)"@en ; chx:input "(lambda g: (exec('redeem = 3 + 34 * 5                 # a 2-of-5 script with compressed keys: OP_2, five pushes of 33 bytes, OP_5, OP_CHECKMULTISIG\\nspk = 23                                # the P2SH output script\\nresult = (redeem, spk, redeem - spk)', g), g['result'])[1])({})" ; chx:output "(173, 23, 150)" .
chx:X_P2shBenefits rd:hasIOExample chx:IO_P2shBenefits .
chx:X_P2shRules a owl:NamedIndividual, chx:P2shRules ; rdfs:label "push-only input, no recursion, counted signature operations"@en ; skos:definition "The validation rules of P2SH say that the input script may only push data, that the redeem script is run exactly once, with no further P2SH inside, and that the signature checks it hides are counted."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_P2shRules a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"def sigops(words):\\n    n, prev = 0, None\\n    for w in words:\\n        if w in ('CHECKSIG', 'CHECKSIGVERIFY'): n += 1\\n        elif w in ('CHECKMULTISIG', 'CHECKMULTISIGVERIFY'): n += int(prev) if prev in [str(i) for i in range(1, 17)] else 20\\n        prev = w\\n    return n\\nresult = (sigops('2 K1 K2 K3 3 CHECKMULTISIG'.split()), sigops('CHECKSIG IF CHECKSIGVERIFY ELSE CHECKMULTISIGVERIFY ENDIF'.split()))\", g), g['result'])[1])({}) evaluates to (3, 22)"@en ; chx:input "(lambda g: (exec(\"def sigops(words):\\n    n, prev = 0, None\\n    for w in words:\\n        if w in ('CHECKSIG', 'CHECKSIGVERIFY'): n += 1\\n        elif w in ('CHECKMULTISIG', 'CHECKMULTISIGVERIFY'): n += int(prev) if prev in [str(i) for i in range(1, 17)] else 20\\n        prev = w\\n    return n\\nresult = (sigops('2 K1 K2 K3 3 CHECKMULTISIG'.split()), sigops('CHECKSIG IF CHECKSIGVERIFY ELSE CHECKMULTISIGVERIFY ENDIF'.split()))\", g), g['result'])[1])({})" ; chx:output "(3, 22)" .
chx:X_P2shRules rd:hasIOExample chx:IO_P2shRules .
chx:X_OpReturnOutput a owl:NamedIndividual, chx:OpReturnOutput ; rdfs:label "OP_RETURN <data>"@en ; skos:definition "An OP_RETURN output is an output whose script begins with OP_RETURN followed by data; it can never be spent, so nodes need not keep it in the set of unspent outputs."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_OpReturnOutput a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\nimport hashlib\\ndata = b'DOCPROOF' + hashlib.sha256(b'hello').digest()       # the prefix of a notary service and the SHA-256 of a document\\nspk = bytes([0x6a, len(data)]) + data\\nresult = (len(spk), spk[:10].hex(), run('RETURN'))\", g), g['result'])[1])({}) evaluates to (42, '6a28444f4350524f4f46', 'FAIL: RETURN')"@en ; chx:input "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\nimport hashlib\\ndata = b'DOCPROOF' + hashlib.sha256(b'hello').digest()       # the prefix of a notary service and the SHA-256 of a document\\nspk = bytes([0x6a, len(data)]) + data\\nresult = (len(spk), spk[:10].hex(), run('RETURN'))\", g), g['result'])[1])({})" ; chx:output "(42, '6a28444f4350524f4f46', 'FAIL: RETURN')" .
chx:X_OpReturnOutput rd:hasIOExample chx:IO_OpReturnOutput .
chx:X_DataCarrierPolicy a owl:NamedIndividual, chx:DataCarrierPolicy ; rdfs:label "budget 100,000 bytes for all data outputs of one transaction"@en ; skos:definition "The data carrier policy is the relay rule that decides how many bytes of OP_RETURN data a transaction may carry; in Bitcoin Core it accepts data carriers by default and shares one budget of 100,000 vbytes among all the data outputs of a transaction."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_DataCarrierPolicy a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"budget = 400000 // 4                  # MAX_STANDARD_TX_WEIGHT divided by the witness scale factor\\nresult = []\\nfor size in (60000, 50000):                 # two data outputs of a transaction, their script sizes in bytes\\n    if size > budget: result.append('datacarrier'); break\\n    budget -= size; result.append('standard')\", g), g['result'])[1])({}) evaluates to ['standard', 'datacarrier']"@en ; chx:input "(lambda g: (exec(\"budget = 400000 // 4                  # MAX_STANDARD_TX_WEIGHT divided by the witness scale factor\\nresult = []\\nfor size in (60000, 50000):                 # two data outputs of a transaction, their script sizes in bytes\\n    if size > budget: result.append('datacarrier'); break\\n    budget -= size; result.append('standard')\", g), g['result'])[1])({})" ; chx:output "['standard', 'datacarrier']" .
chx:X_DataCarrierPolicy rd:hasIOExample chx:IO_DataCarrierPolicy .
chx:X_LockTimeLimits a owl:NamedIndividual, chx:LockTimeLimits ; rdfs:label "lock time stops a transaction, not a spender"@en ; skos:definition "The lock time of a transaction restricts only when that transaction can be included in a block; it does not stop the signer from spending the same inputs in another transaction without a lock time."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_LockTimeLimits a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('def final(lock_time, height):          # may the transaction be in a block of this height? (all inputs not final, height-type lock time)\\n    return lock_time == 0 or lock_time < height\\nresult = (final(775071, 775072), final(775071, 775071))', g), g['result'])[1])({}) evaluates to (True, False)"@en ; chx:input "(lambda g: (exec('def final(lock_time, height):          # may the transaction be in a block of this height? (all inputs not final, height-type lock time)\\n    return lock_time == 0 or lock_time < height\\nresult = (final(775071, 775072), final(775071, 775071))', g), g['result'])[1])({})" ; chx:output "(True, False)" .
chx:X_LockTimeLimits rd:hasIOExample chx:IO_LockTimeLimits .
chx:X_CheckLockTimeVerify a owl:NamedIndividual, chx:CheckLockTimeVerify ; rdfs:label "<pk> OP_CHECKSIGVERIFY <n> OP_CHECKLOCKTIMEVERIFY"@en ; skos:definition "OP_CHECKLOCKTIMEVERIFY fails a script unless the lock time of the spending transaction is of the same kind as, and at least as large as, the number on top of the stack, and the input is not final."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_CheckLockTimeVerify a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"def cltv(n, lock, seq):                # the failure conditions of BIP65 that do not depend on the stack\\n    if n < 0: return 'fail'\\n    if (n < 500000000) != (lock < 500000000): return 'fail'\\n    if n > lock: return 'fail'\\n    if seq == 0xffffffff: return 'fail'\\n    return 'ok'\\nresult = (cltv(500000, 500000, 0), cltv(500000, 499999, 0), cltv(500000, 500000, 0xffffffff), cltv(500000, 1700000000, 0))\", g), g['result'])[1])({}) evaluates to ('ok', 'fail', 'fail', 'fail')"@en ; chx:input "(lambda g: (exec(\"def cltv(n, lock, seq):                # the failure conditions of BIP65 that do not depend on the stack\\n    if n < 0: return 'fail'\\n    if (n < 500000000) != (lock < 500000000): return 'fail'\\n    if n > lock: return 'fail'\\n    if seq == 0xffffffff: return 'fail'\\n    return 'ok'\\nresult = (cltv(500000, 500000, 0), cltv(500000, 499999, 0), cltv(500000, 500000, 0xffffffff), cltv(500000, 1700000000, 0))\", g), g['result'])[1])({})" ; chx:output "('ok', 'fail', 'fail', 'fail')" .
chx:X_CheckLockTimeVerify rd:hasIOExample chx:IO_CheckLockTimeVerify .
chx:X_RelativeTimelock a owl:NamedIndividual, chx:RelativeTimelock ; rdfs:label "sequence 144 means: not before 144 blocks of age"@en ; skos:definition "A relative timelock is encoded in the sequence field of an input: if bit 31 is clear, the low 16 bits are a number of blocks, or of 512-second units when bit 22 is set, that the spent output must have aged before the input is valid."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_RelativeTimelock a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"def decode(seq):\\n    if seq & (1 << 31): return 'no relative lock'\\n    n = seq & 0xffff\\n    return (n * 512, 'seconds') if seq & (1 << 22) else (n, 'blocks')\\nresult = [decode(s) for s in (144, (1 << 22) | 10, 1 << 31, 0xfffffffd)]\", g), g['result'])[1])({}) evaluates to [(144, 'blocks'), (5120, 'seconds'), 'no relative lock', 'no relative lock']"@en ; chx:input "(lambda g: (exec(\"def decode(seq):\\n    if seq & (1 << 31): return 'no relative lock'\\n    n = seq & 0xffff\\n    return (n * 512, 'seconds') if seq & (1 << 22) else (n, 'blocks')\\nresult = [decode(s) for s in (144, (1 << 22) | 10, 1 << 31, 0xfffffffd)]\", g), g['result'])[1])({})" ; chx:output "[(144, 'blocks'), (5120, 'seconds'), 'no relative lock', 'no relative lock']" .
chx:X_RelativeTimelock rd:hasIOExample chx:IO_RelativeTimelock .
chx:X_CheckSequenceVerify a owl:NamedIndividual, chx:CheckSequenceVerify ; rdfs:label "<pk> OP_CHECKSIGVERIFY <n> OP_CHECKSEQUENCEVERIFY"@en ; skos:definition "OP_CHECKSEQUENCEVERIFY fails a script unless the transaction has version 2 or more and the sequence of the spending input carries a relative lock of the same kind as, and at least as large as, the number on top of the stack."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_CheckSequenceVerify a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"def csv(n, seq, version):              # the failure conditions of BIP112 once the operand has the disable flag clear\\n    if version < 2 or seq & (1 << 31): return 'fail'\\n    if bool(n & (1 << 22)) != bool(seq & (1 << 22)): return 'fail'\\n    return 'ok' if (n & 0x40ffff) <= (seq & 0x40ffff) else 'fail'\\nresult = (csv(144, 144, 2), csv(144, 143, 2), csv(144, 144, 1), csv(144, (1 << 22) | 144, 2))\", g), g['result'])[1])({}) evaluates to ('ok', 'fail', 'fail', 'fail')"@en ; chx:input "(lambda g: (exec(\"def csv(n, seq, version):              # the failure conditions of BIP112 once the operand has the disable flag clear\\n    if version < 2 or seq & (1 << 31): return 'fail'\\n    if bool(n & (1 << 22)) != bool(seq & (1 << 22)): return 'fail'\\n    return 'ok' if (n & 0x40ffff) <= (seq & 0x40ffff) else 'fail'\\nresult = (csv(144, 144, 2), csv(144, 143, 2), csv(144, 144, 1), csv(144, (1 << 22) | 144, 2))\", g), g['result'])[1])({})" ; chx:output "('ok', 'fail', 'fail', 'fail')" .
chx:X_CheckSequenceVerify rd:hasIOExample chx:IO_CheckSequenceVerify .
chx:X_ConditionalClauses a owl:NamedIndividual, chx:ConditionalClauses ; rdfs:label "<condition> OP_IF <A> OP_ELSE <B> OP_ENDIF"@en ; skos:definition "A conditional clause is a group of opcodes between OP_IF or OP_NOTIF and OP_ENDIF, with an optional OP_ELSE, that runs one of two code paths according to the value on top of the stack when the OP_IF is reached."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_ConditionalClauses a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\nscript = 'IF 10 ELSE 20 ENDIF'\\nresult = (dec(run(script, [enc(1)])[-1]), dec(run(script, [enc(0)])[-1]), dec(run('NOTIF 10 ELSE 20 ENDIF', [enc(1)])[-1]))\", g), g['result'])[1])({}) evaluates to (10, 20, 20)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\nscript = 'IF 10 ELSE 20 ENDIF'\\nresult = (dec(run(script, [enc(1)])[-1]), dec(run(script, [enc(0)])[-1]), dec(run('NOTIF 10 ELSE 20 ENDIF', [enc(1)])[-1]))\", g), g['result'])[1])({})" ; chx:output "(10, 20, 20)" .
chx:X_ConditionalClauses rd:hasIOExample chx:IO_ConditionalClauses .
chx:X_VerifyGuard a owl:NamedIndividual, chx:VerifyGuard ; rdfs:label "OP_HASH160 <hash> OP_EQUALVERIFY <pk> OP_CHECKSIG"@en ; skos:definition "An opcode with the suffix VERIFY ends the script with failure unless its result is true, and otherwise continues; it acts as a guard clause that attaches one precondition without offering a second path."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_VerifyGuard a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\nimport hashlib\\nh = hashlib.sha256(b'abc').hexdigest()\\nscript = 'SHA256 0x' + h + ' EQUALVERIFY 1'     # a guard: the secret must hash to h, then the script is true\\nresult = (run(script, [b'abc']), run(script, [b'abd']), len('HASH160 h EQUALVERIFY pk CHECKSIG'.split()), len('HASH160 h EQUAL IF pk CHECKSIG ENDIF'.split()))\", g), g['result'])[1])({}) evaluates to ([b'\\x01'], 'FAIL: EQUALVERIFY', 5, 7)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\nimport hashlib\\nh = hashlib.sha256(b'abc').hexdigest()\\nscript = 'SHA256 0x' + h + ' EQUALVERIFY 1'     # a guard: the secret must hash to h, then the script is true\\nresult = (run(script, [b'abc']), run(script, [b'abd']), len('HASH160 h EQUALVERIFY pk CHECKSIG'.split()), len('HASH160 h EQUAL IF pk CHECKSIG ENDIF'.split()))\", g), g['result'])[1])({})" ; chx:output "([b'\\x01'], 'FAIL: EQUALVERIFY', 5, 7)" .
