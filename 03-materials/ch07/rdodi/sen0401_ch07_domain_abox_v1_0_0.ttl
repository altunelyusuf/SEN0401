chx:X_MultiPathScript a owl:NamedIndividual, chx:MultiPathScript ; rdfs:label "<signature> OP_1 OP_0 selects path B"@en ; skos:definition "A script with several paths nests conditional clauses so that each path is a different way to redeem the output, and the input script selects the path by pushing a true or false value for each clause."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_MultiPathScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\nscript = 'IF 10 ELSE IF 20 ELSE 30 ENDIF ENDIF'     # three paths: A, B and C\\nchoices = {'A': [1], 'B': [1, 0], 'C': [0, 0]}      # the last value pushed is the first IF to read it\\nresult = {k: dec(run(script, [enc(v) for v in c])[-1]) for k, c in choices.items()}\", g), g['result'])[1])({}) evaluates to {'A': 10, 'B': 20, 'C': 30}"@en ; chx:input "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\nscript = 'IF 10 ELSE IF 20 ELSE 30 ENDIF ENDIF'     # three paths: A, B and C\\nchoices = {'A': [1], 'B': [1, 0], 'C': [0, 0]}      # the last value pushed is the first IF to read it\\nresult = {k: dec(run(script, [enc(v) for v in c])[-1]) for k, c in choices.items()}\", g), g['result'])[1])({})" ; chx:output "{'A': 10, 'B': 20, 'C': 30}" .
chx:X_MultiPathScript rd:hasIOExample chx:IO_MultiPathScript .
chx:X_MohammedScript a owl:NamedIndividual, chx:MohammedScript ; rdfs:label "2-of-3 partners, or lawyer plus one after 30 days, or lawyer after 90"@en ; skos:definition "The capital-account script of the book has three execution paths: two of three partners at any time, the lawyer with one partner after 30 days, and the lawyer alone after 90 days, selected by two true or false values in the input script."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_MohammedScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"def spendable(path, age_blocks, signers):    # a model of the three paths with sets of signers; the page's library runs the real script\\n    partners = {'M', 'S', 'Z'}\\n    if path == 1: return len(signers & partners) >= 2\\n    if path == 2: return age_blocks >= 4320 and 'L' in signers and len(signers & partners) >= 1\\n    return age_blocks >= 12960 and 'L' in signers\\nresult = [spendable(1, 0, {'M', 'Z'}), spendable(2, 4319, {'S', 'L'}), spendable(2, 4320, {'S', 'L'}), spendable(3, 12960, {'L'})]\", g), g['result'])[1])({}) evaluates to [True, False, True, True]"@en ; chx:input "(lambda g: (exec(\"def spendable(path, age_blocks, signers):    # a model of the three paths with sets of signers; the page's library runs the real script\\n    partners = {'M', 'S', 'Z'}\\n    if path == 1: return len(signers & partners) >= 2\\n    if path == 2: return age_blocks >= 4320 and 'L' in signers and len(signers & partners) >= 1\\n    return age_blocks >= 12960 and 'L' in signers\\nresult = [spendable(1, 0, {'M', 'Z'}), spendable(2, 4319, {'S', 'L'}), spendable(2, 4320, {'S', 'L'}), spendable(3, 12960, {'L'})]\", g), g['result'])[1])({})" ; chx:output "[True, False, True, True]" .
chx:X_MohammedScript rd:hasIOExample chx:IO_MohammedScript .
chx:X_Miniscript a owl:NamedIndividual, chx:Miniscript ; rdfs:label "or_i(pk(A),and_v(v:pk(B),older(144)))"@en ; skos:definition "Miniscript is a structured way of writing a subset of Bitcoin Script, in which small fragments with known behaviour are composed by rules, so that a program can analyse the result, find the spending conditions and construct witnesses."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_Miniscript a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"def script(m):\\n    k = m[0]\\n    if k == 'pk': return [m[1], 'CHECKSIG']\\n    if k == 'older': return [str(m[1]), 'CHECKSEQUENCEVERIFY']\\n    if k == 'v':\\n        s = script(m[1]); ver = {'CHECKSIG': 'CHECKSIGVERIFY', 'EQUAL': 'EQUALVERIFY'}.get(s[-1])\\n        return s[:-1] + [ver] if ver else s + ['VERIFY']\\n    if k == 'and_v': return script(m[1]) + script(m[2])\\n    if k == 'or_i': return ['IF'] + script(m[1]) + ['ELSE'] + script(m[2]) + ['ENDIF']\\nresult = ' '.join(script(('or_i', ('pk', 'A'), ('and_v', ('v', ('pk', 'B')), ('older', 144)))))\", g), g['result'])[1])({}) evaluates to 'IF A CHECKSIG ELSE B CHECKSIGVERIFY 144 CHECKSEQUENCEVERIFY ENDIF'"@en ; chx:input "(lambda g: (exec(\"def script(m):\\n    k = m[0]\\n    if k == 'pk': return [m[1], 'CHECKSIG']\\n    if k == 'older': return [str(m[1]), 'CHECKSEQUENCEVERIFY']\\n    if k == 'v':\\n        s = script(m[1]); ver = {'CHECKSIG': 'CHECKSIGVERIFY', 'EQUAL': 'EQUALVERIFY'}.get(s[-1])\\n        return s[:-1] + [ver] if ver else s + ['VERIFY']\\n    if k == 'and_v': return script(m[1]) + script(m[2])\\n    if k == 'or_i': return ['IF'] + script(m[1]) + ['ELSE'] + script(m[2]) + ['ENDIF']\\nresult = ' '.join(script(('or_i', ('pk', 'A'), ('and_v', ('v', ('pk', 'B')), ('older', 144)))))\", g), g['result'])[1])({})" ; chx:output "'IF A CHECKSIG ELSE B CHECKSIGVERIFY 144 CHECKSEQUENCEVERIFY ENDIF'" .
chx:X_Miniscript rd:hasIOExample chx:IO_Miniscript .
chx:X_WitnessProgram a owl:NamedIndividual, chx:WitnessProgram ; rdfs:label "OP_0 <20 bytes> or OP_0 <32 bytes>"@en ; skos:definition "A witness program is an output script made of a version byte (OP_0, or OP_1 to OP_16) followed by one push of 2 to 40 bytes; the version and the length of the program decide how the output is spent."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_WitnessProgram a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"def kind(spk):                                 # BIP141: the version, then the length of the program\\n    ver = 0 if spk[0] == 0 else spk[0] - 80\\n    prog = spk[2:]\\n    if ver == 0 and len(prog) == 20: return 'P2WPKH'\\n    if ver == 0 and len(prog) == 32: return 'P2WSH'\\n    if ver == 0: return 'fails'\\n    return 'P2TR' if ver == 1 and len(prog) == 32 else 'future version'\\nresult = [kind(bytes.fromhex(s)) for s in ('0014' + '11' * 20, '0020' + '22' * 32, '0013' + '33' * 19, '5120' + '44' * 32, '6003' + '55' * 3)]\", g), g['result'])[1])({}) evaluates to ['P2WPKH', 'P2WSH', 'fails', 'P2TR', 'future version']"@en ; chx:input "(lambda g: (exec(\"def kind(spk):                                 # BIP141: the version, then the length of the program\\n    ver = 0 if spk[0] == 0 else spk[0] - 80\\n    prog = spk[2:]\\n    if ver == 0 and len(prog) == 20: return 'P2WPKH'\\n    if ver == 0 and len(prog) == 32: return 'P2WSH'\\n    if ver == 0: return 'fails'\\n    return 'P2TR' if ver == 1 and len(prog) == 32 else 'future version'\\nresult = [kind(bytes.fromhex(s)) for s in ('0014' + '11' * 20, '0020' + '22' * 32, '0013' + '33' * 19, '5120' + '44' * 32, '6003' + '55' * 3)]\", g), g['result'])[1])({})" ; chx:output "['P2WPKH', 'P2WSH', 'fails', 'P2TR', 'future version']" .
chx:X_WitnessProgram rd:hasIOExample chx:IO_WitnessProgram .
chx:X_P2wpkh a owl:NamedIndividual, chx:P2wpkh ; rdfs:label "0 <20-byte public key hash>"@en ; skos:definition "A P2WPKH output holds a version 0 and the 20-byte hash of a compressed public key; it is spent by a witness of exactly two items, a signature and the public key, and an empty input script."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_P2wpkh a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"h = '751e76e8199196d454941c45d1b3a323f1433bd6'                          # HASH160 of the compressed public key\\nspk = '0014' + h                              # witness version 0, a push of 20 bytes, the hash\\nscript_code = '1976a914' + h + '88ac'         # the script BIP143 signs: the legacy key hash script with its length byte\\nresult = (spk, len(spk) // 2, len(script_code) // 2 - 1)\", g), g['result'])[1])({}) evaluates to ('0014751e76e8199196d454941c45d1b3a323f1433bd6', 22, 25)"@en ; chx:input "(lambda g: (exec(\"h = '751e76e8199196d454941c45d1b3a323f1433bd6'                          # HASH160 of the compressed public key\\nspk = '0014' + h                              # witness version 0, a push of 20 bytes, the hash\\nscript_code = '1976a914' + h + '88ac'         # the script BIP143 signs: the legacy key hash script with its length byte\\nresult = (spk, len(spk) // 2, len(script_code) // 2 - 1)\", g), g['result'])[1])({})" ; chx:output "('0014751e76e8199196d454941c45d1b3a323f1433bd6', 22, 25)" .
chx:X_P2wpkh rd:hasIOExample chx:IO_P2wpkh .
chx:X_P2wsh a owl:NamedIndividual, chx:P2wsh ; rdfs:label "0 <32-byte SHA-256 of the witness script>"@en ; skos:definition "A P2WSH output holds a version 0 and the 32-byte SHA-256 of a script; it is spent by a witness whose last item is that script and whose other items are its input."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_P2wsh a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nscript = bytes.fromhex('210279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798ac')        # BIP173's example script: a public key and OP_CHECKSIG\\nprogram = hashlib.sha256(script).digest()       # one SHA-256, not HASH160\\nresult = ('0020' + program.hex(), len(program))\", g), g['result'])[1])({}) evaluates to ('00201863143c14c5166804bd19203356da136c985678cd4d27a1b8c6329604903262', 32)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nscript = bytes.fromhex('210279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798ac')        # BIP173's example script: a public key and OP_CHECKSIG\\nprogram = hashlib.sha256(script).digest()       # one SHA-256, not HASH160\\nresult = ('0020' + program.hex(), len(program))\", g), g['result'])[1])({})" ; chx:output "('00201863143c14c5166804bd19203356da136c985678cd4d27a1b8c6329604903262', 32)" .
chx:X_P2wsh rd:hasIOExample chx:IO_P2wsh .
chx:X_SegwitAddress a owl:NamedIndividual, chx:SegwitAddress ; rdfs:label "bc1q... carries a version-0 program, bc1p... a version-1 program"@en ; skos:definition "A native segregated witness address writes the witness version and the program as a bech32 string with a human-readable part, a separator, 5-bit characters and a six-character checksum; version 0 uses bech32 and version 1 and later use bech32m."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_SegwitAddress a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"CH = 'qpzry9x8gf2tvdw0s3jn54khce6mua7l'\\ndef polymod(values):\\n    gen = [0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3]\\n    chk = 1\\n    for v in values:\\n        top = chk >> 25\\n        chk = (chk & 0x1ffffff) << 5 ^ v\\n        for i in range(5): chk ^= gen[i] if (top >> i) & 1 else 0\\n    return chk\\ndef segwit_address(hrp, version, program):\\n    const = 1 if version == 0 else 0x2bc830a3        # bech32 for version 0, bech32m for versions 1 to 16\\n    data, acc, bits = [version], 0, 0\\n    for byte in program:                              # regroup 8-bit bytes into 5-bit characters\\n        acc = (acc << 8) | byte; bits += 8\\n        while bits >= 5: bits -= 5; data.append((acc >> bits) & 31)\\n    if bits: data.append((acc << (5 - bits)) & 31)\\n    values = [ord(x) >> 5 for x in hrp] + [0] + [ord(x) & 31 for x in hrp] + data\\n    mod = polymod(values + [0] * 6) ^ const\\n    checksum = [(mod >> 5 * (5 - i)) & 31 for i in range(6)]\\n    return hrp + '1' + ''.join(CH[d] for d in data + checksum)\\nkey_hash = bytes.fromhex('751e76e8199196d454941c45d1b3a323f1433bd6')\\nresult = (segwit_address('bc', 0, key_hash), segwit_address('bc', 1, bytes.fromhex('79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798')))\", g), g['result'])[1])({}) evaluates to ('bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4', 'bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0')"@en ; chx:input "(lambda g: (exec(\"CH = 'qpzry9x8gf2tvdw0s3jn54khce6mua7l'\\ndef polymod(values):\\n    gen = [0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3]\\n    chk = 1\\n    for v in values:\\n        top = chk >> 25\\n        chk = (chk & 0x1ffffff) << 5 ^ v\\n        for i in range(5): chk ^= gen[i] if (top >> i) & 1 else 0\\n    return chk\\ndef segwit_address(hrp, version, program):\\n    const = 1 if version == 0 else 0x2bc830a3        # bech32 for version 0, bech32m for versions 1 to 16\\n    data, acc, bits = [version], 0, 0\\n    for byte in program:                              # regroup 8-bit bytes into 5-bit characters\\n        acc = (acc << 8) | byte; bits += 8\\n        while bits >= 5: bits -= 5; data.append((acc >> bits) & 31)\\n    if bits: data.append((acc << (5 - bits)) & 31)\\n    values = [ord(x) >> 5 for x in hrp] + [0] + [ord(x) & 31 for x in hrp] + data\\n    mod = polymod(values + [0] * 6) ^ const\\n    checksum = [(mod >> 5 * (5 - i)) & 31 for i in range(6)]\\n    return hrp + '1' + ''.join(CH[d] for d in data + checksum)\\nkey_hash = bytes.fromhex('751e76e8199196d454941c45d1b3a323f1433bd6')\\nresult = (segwit_address('bc', 0, key_hash), segwit_address('bc', 1, bytes.fromhex('79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798')))\", g), g['result'])[1])({})" ; chx:output "('bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4', 'bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0')" .
chx:X_SegwitAddress rd:hasIOExample chx:IO_SegwitAddress .
chx:X_BackwardCompatibleUpgrade a owl:NamedIndividual, chx:BackwardCompatibleUpgrade ; rdfs:label "old nodes see anyone-can-spend, new nodes check the witness"@en ; skos:definition "Segregated witness is a soft fork: an old node sees a witness output as two pushes that anyone can spend and ignores the witness, while an upgraded node enforces the witness rules, so the two kinds of node agree on the chain as long as the miners enforce the new rules."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_BackwardCompatibleUpgrade a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\nprogram = '11' * 20\\nold_view = run('0 0x' + program)                   # an old node runs only the output script: two pushes\\nresult = (len(old_view), true(old_view[-1]))\", g), g['result'])[1])({}) evaluates to (2, True)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\ndef enc(n):                                  # a script number: little-endian, the sign in the top bit of the last byte\\n    a, out = abs(n), bytearray()\\n    while a: out.append(a & 255); a >>= 8\\n    if out and out[-1] & 0x80: out.append(0x80 if n < 0 else 0)\\n    elif out and n < 0: out[-1] |= 0x80\\n    return bytes(out)\\ndef dec(b): return -int.from_bytes(b[:-1] + bytes([b[-1] & 0x7f]), 'little') if b and b[-1] & 0x80 else int.from_bytes(b, 'little')\\ndef true(b): return any(b[:-1]) or (len(b) > 0 and b[-1] not in (0, 0x80))\\ndef run(script, stack=()):\\n    st, branch = list(stack), []             # branch holds one flag per open IF: True while that arm is running\\n    for w in script.split():\\n        live = all(branch)\\n        if w in ('IF', 'NOTIF'): branch.append(live and (true(st.pop()) == (w == 'IF'))); continue\\n        if w == 'ELSE': branch[-1] = not branch[-1] and all(branch[:-1]); continue\\n        if w == 'ENDIF': branch.pop(); continue\\n        if not live: continue\\n        if w.startswith('0x'): st.append(bytes.fromhex(w[2:]))\\n        elif w.lstrip('-').isdigit(): st.append(enc(int(w)))\\n        elif w == 'DUP': st.append(st[-1])\\n        elif w == 'DROP': st.pop()\\n        elif w == 'SWAP': st[-2:] = st[-1], st[-2]\\n        elif w == 'ADD': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a + b))\\n        elif w == 'SUB': b, a = dec(st.pop()), dec(st.pop()); st.append(enc(a - b))\\n        elif w == 'NOT': st.append(enc(int(not true(st.pop()))))\\n        elif w == 'SIZE': st.append(enc(len(st[-1])))\\n        elif w == 'SHA256': st.append(hashlib.sha256(st.pop()).digest())\\n        elif w in ('EQUAL', 'EQUALVERIFY'):\\n            same = st.pop() == st.pop()\\n            if w == 'EQUAL': st.append(enc(int(same)))\\n            elif not same: return 'FAIL: EQUALVERIFY'\\n        elif w == 'VERIFY':\\n            if not true(st.pop()): return 'FAIL: VERIFY'\\n        elif w == 'RETURN': return 'FAIL: RETURN'\\n        else: raise ValueError('unknown word ' + w)\\n    return st\\nprogram = '11' * 20\\nold_view = run('0 0x' + program)                   # an old node runs only the output script: two pushes\\nresult = (len(old_view), true(old_view[-1]))\", g), g['result'])[1])({})" ; chx:output "(2, True)" .
chx:X_BackwardCompatibleUpgrade rd:hasIOExample chx:IO_BackwardCompatibleUpgrade .
chx:X_NestedSegwit a owl:NamedIndividual, chx:NestedSegwit ; rdfs:label "a witness program inside a P2SH redeem script"@en ; skos:definition "A nested segregated witness output is a script hash output whose redeem script is a witness program; a wallet that cannot send to a segwit address can pay the 3 address, and the receiver spends it with a witness."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_NestedSegwit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nA = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'\\ndef b58check(version, payload):              # Base58Check: version byte + payload + 4 checksum bytes, written in base 58\\n    d = bytes([version]) + payload\\n    d += hashlib.sha256(hashlib.sha256(d).digest()).digest()[:4]\\n    n, s = int.from_bytes(d, 'big'), ''\\n    while n: n, r = divmod(n, 58); s = A[r] + s\\n    return '1' * (len(d) - len(d.lstrip(b'\\\\0'))) + s\\nh = bytes.fromhex('3e0547268b3b19288b3adef9719ec8659f4b2b0b')                # HASH160 of the redeem script 0014 <key hash>\\nredeem = bytes.fromhex('0014ab68025513c3dbd2f7b92a94e0581f5d50f654e7')\\nresult = (b58check(5, h), len(redeem) + 1)\", g), g['result'])[1])({}) evaluates to ('37Lx99uaGn5avKBxiW26HjedQE3LrDCZru', 23)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nA = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'\\ndef b58check(version, payload):              # Base58Check: version byte + payload + 4 checksum bytes, written in base 58\\n    d = bytes([version]) + payload\\n    d += hashlib.sha256(hashlib.sha256(d).digest()).digest()[:4]\\n    n, s = int.from_bytes(d, 'big'), ''\\n    while n: n, r = divmod(n, 58); s = A[r] + s\\n    return '1' * (len(d) - len(d.lstrip(b'\\\\0'))) + s\\nh = bytes.fromhex('3e0547268b3b19288b3adef9719ec8659f4b2b0b')                # HASH160 of the redeem script 0014 <key hash>\\nredeem = bytes.fromhex('0014ab68025513c3dbd2f7b92a94e0581f5d50f654e7')\\nresult = (b58check(5, h), len(redeem) + 1)\", g), g['result'])[1])({})" ; chx:output "('37Lx99uaGn5avKBxiW26HjedQE3LrDCZru', 23)" .
chx:X_NestedSegwit rd:hasIOExample chx:IO_NestedSegwit .
chx:X_WitnessSighash a owl:NamedIndividual, chx:WitnessSighash ; rdfs:label "sighash v0 commits to the amount of the spent output"@en ; skos:definition "BIP143 defines the signature hash for version-0 witness programs: it hashes the parts of the transaction in a fixed order with the value of the output being spent, and it reuses three hashes for all inputs, so that the work grows with the size of the transaction and not with its square."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_WitnessSighash a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib, struct\\ndef h256(b): return hashlib.sha256(hashlib.sha256(b).digest()).digest()\\ndef sighash(amount):                                   # BIP143 for a one-input, one-output transaction, hash type ALL\\n    outpoint = bytes(32) + struct.pack('<I', 0)\\n    script_code = bytes.fromhex('1976a914' + '11' * 20 + '88ac')\\n    outputs = struct.pack('<q', 50000) + bytes.fromhex('160014' + '22' * 20)\\n    return h256(struct.pack('<i', 2) + h256(outpoint) + h256(struct.pack('<I', 0xfffffffd)) + outpoint + script_code\\n                + struct.pack('<q', amount) + struct.pack('<I', 0xfffffffd) + h256(outputs) + struct.pack('<I', 0) + struct.pack('<I', 1))\\nresult = (len(sighash(100000)), sighash(100000) != sighash(100001))\", g), g['result'])[1])({}) evaluates to (32, True)"@en ; chx:input "(lambda g: (exec(\"import hashlib, struct\\ndef h256(b): return hashlib.sha256(hashlib.sha256(b).digest()).digest()\\ndef sighash(amount):                                   # BIP143 for a one-input, one-output transaction, hash type ALL\\n    outpoint = bytes(32) + struct.pack('<I', 0)\\n    script_code = bytes.fromhex('1976a914' + '11' * 20 + '88ac')\\n    outputs = struct.pack('<q', 50000) + bytes.fromhex('160014' + '22' * 20)\\n    return h256(struct.pack('<i', 2) + h256(outpoint) + h256(struct.pack('<I', 0xfffffffd)) + outpoint + script_code\\n                + struct.pack('<q', amount) + struct.pack('<I', 0xfffffffd) + h256(outputs) + struct.pack('<I', 0) + struct.pack('<I', 1))\\nresult = (len(sighash(100000)), sighash(100000) != sighash(100001))\", g), g['result'])[1])({})" ; chx:output "(32, True)" .
chx:X_WitnessSighash rd:hasIOExample chx:IO_WitnessSighash .
chx:X_Mast a owl:NamedIndividual, chx:Mast ; rdfs:label "a spend reveals one script and one hash per level of the tree"@en ; skos:definition "A Merklized alternative script tree commits to a set of alternative scripts with the root of a Merkle tree; a spender shows the script that is used and the hashes that connect it to the root, which costs one 32-byte hash for each level between the script and the root."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_Mast a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\ndef tagged(tag, data):                                  # BIP340's tagged hash: SHA-256(SHA-256(tag) + SHA-256(tag) + data)\\n    t = hashlib.sha256(tag.encode()).digest()\\n    return hashlib.sha256(t + t + data).digest()\\ndef leaf(script): return tagged('TapLeaf', bytes([0xc0, len(script)]) + script)\\ndef branch(a, b): return tagged('TapBranch', min(a, b) + max(a, b))\\ndef check(leaf_hash, proof, root):                      # fold the sibling hashes upward and compare with the root\\n    h = leaf_hash\\n    for sibling in proof: h = branch(h, sibling)\\n    return h == root\\nscripts = [bytes([0x51]), bytes([0x52]), bytes([0x53])]       # three alternative scripts, one byte each, for the example\\nla, lb, lc = [leaf(s) for s in scripts]\\nroot = branch(branch(la, lb), lc)\\nresult = (check(la, [lb, lc], root), check(lc, [branch(la, lb)], root), check(la, [lc, lb], root))\", g), g['result'])[1])({}) evaluates to (True, True, False)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\ndef tagged(tag, data):                                  # BIP340's tagged hash: SHA-256(SHA-256(tag) + SHA-256(tag) + data)\\n    t = hashlib.sha256(tag.encode()).digest()\\n    return hashlib.sha256(t + t + data).digest()\\ndef leaf(script): return tagged('TapLeaf', bytes([0xc0, len(script)]) + script)\\ndef branch(a, b): return tagged('TapBranch', min(a, b) + max(a, b))\\ndef check(leaf_hash, proof, root):                      # fold the sibling hashes upward and compare with the root\\n    h = leaf_hash\\n    for sibling in proof: h = branch(h, sibling)\\n    return h == root\\nscripts = [bytes([0x51]), bytes([0x52]), bytes([0x53])]       # three alternative scripts, one byte each, for the example\\nla, lb, lc = [leaf(s) for s in scripts]\\nroot = branch(branch(la, lb), lc)\\nresult = (check(la, [lb, lc], root), check(lc, [branch(la, lb)], root), check(la, [lc, lb], root))\", g), g['result'])[1])({})" ; chx:output "(True, True, False)" .
chx:X_Mast rd:hasIOExample chx:IO_Mast .
chx:X_MastVersusAst a owl:NamedIndividual, chx:MastVersusAst ; rdfs:label "commitments needed: 3 scripts need 3, 32,768 scripts need 16"@en ; skos:definition "The name MAST first meant a Merklized abstract syntax tree, which commits to every part of a program, and now means a Merklized alternative script tree, which commits to a set of complete scripts of which one is used; the second needs only one hash for each level of depth."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_MastVersusAst a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('def commitments(n):                    # the siblings on the path, one per level, plus the root\\n    return (n - 1).bit_length() + 1\\nresult = [(n, commitments(n), 32 * commitments(n)) for n in (3, 4, 8, 32768)]', g), g['result'])[1])({}) evaluates to [(3, 3, 96), (4, 3, 96), (8, 4, 128), (32768, 16, 512)]"@en ; chx:input "(lambda g: (exec('def commitments(n):                    # the siblings on the path, one per level, plus the root\\n    return (n - 1).bit_length() + 1\\nresult = [(n, commitments(n), 32 * commitments(n)) for n in (3, 4, 8, 32768)]', g), g['result'])[1])({})" ; chx:output "[(3, 3, 96), (4, 3, 96), (8, 4, 128), (32768, 16, 512)]" .
chx:X_MastVersusAst rd:hasIOExample chx:IO_MastVersusAst .
chx:X_PayToContract a owl:NamedIndividual, chx:PayToContract ; rdfs:label "pay to the key P + t*G, where t is a hash of the contract"@en ; skos:definition "Pay to contract is a key tweak that commits to an agreed description: the payer adds the hash of the description, as a number, to the public key of the payee, and the payee spends with the private key plus the same number."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_PayToContract a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import hashlib\\nP = 2**256 - 2**32 - 977\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nG = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\\ndef add(a, b):                               # point addition on y^2 = x^3 + 7 (None is the point at infinity)\\n    if a is None or b is None: return a or b\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return x, (m * (a[0] - x) - a[1]) % P\\ndef mul(k, p):\\n    r = None\\n    while k:\\n        if k & 1: r = add(r, p)\\n        p, k = add(p, p), k >> 1\\n    return r\\ndef pubkey(sec):                             # a 33- or 65-byte public key as a point\\n    x = int.from_bytes(sec[1:33], \\'big\\')\\n    if sec[0] == 4: return x, int.from_bytes(sec[33:65], \\'big\\')\\n    y = pow(x**3 + 7, (P + 1) // 4, P)\\n    return x, y if y % 2 == sec[0] % 2 else P - y\\ndef verify(sec, z, r, s):                    # ECDSA: R = (z/s)G + (r/s)Q must have x = r (mod n)\\n    w = pow(s, -1, N)\\n    R = add(mul(z * w % N, G), mul(r * w % N, pubkey(sec)))\\n    return R is not None and R[0] % N == r\\nt = int.from_bytes(hashlib.sha256(b\"Alice\\'s podcast episode #123\").digest(), \\'big\\') % N      # the tweak\\nalice = mul(11, G)                                   # Alice\\'s public key, from the private key 11\\npaid = add(alice, mul(t, G))                         # the key Bob pays to\\nresult = mul((11 + t) % N, G) == paid                  # Alice\\'s tweaked private key opens it', g), g['result'])[1])({}) evaluates to True"@en ; chx:input "(lambda g: (exec('import hashlib\\nP = 2**256 - 2**32 - 977\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nG = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\\ndef add(a, b):                               # point addition on y^2 = x^3 + 7 (None is the point at infinity)\\n    if a is None or b is None: return a or b\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return x, (m * (a[0] - x) - a[1]) % P\\ndef mul(k, p):\\n    r = None\\n    while k:\\n        if k & 1: r = add(r, p)\\n        p, k = add(p, p), k >> 1\\n    return r\\ndef pubkey(sec):                             # a 33- or 65-byte public key as a point\\n    x = int.from_bytes(sec[1:33], \\'big\\')\\n    if sec[0] == 4: return x, int.from_bytes(sec[33:65], \\'big\\')\\n    y = pow(x**3 + 7, (P + 1) // 4, P)\\n    return x, y if y % 2 == sec[0] % 2 else P - y\\ndef verify(sec, z, r, s):                    # ECDSA: R = (z/s)G + (r/s)Q must have x = r (mod n)\\n    w = pow(s, -1, N)\\n    R = add(mul(z * w % N, G), mul(r * w % N, pubkey(sec)))\\n    return R is not None and R[0] % N == r\\nt = int.from_bytes(hashlib.sha256(b\"Alice\\'s podcast episode #123\").digest(), \\'big\\') % N      # the tweak\\nalice = mul(11, G)                                   # Alice\\'s public key, from the private key 11\\npaid = add(alice, mul(t, G))                         # the key Bob pays to\\nresult = mul((11 + t) % N, G) == paid                  # Alice\\'s tweaked private key opens it', g), g['result'])[1])({})" ; chx:output "True" .
chx:X_PayToContract rd:hasIOExample chx:IO_PayToContract .
chx:X_ScriptlessMultisignature a owl:NamedIndividual, chx:ScriptlessMultisignature ; rdfs:label "many partial keys and signatures sum to one key and one signature"@en ; skos:definition "A scriptless multisignature is a way for several participants to produce one public key and one signature that look exactly like those of a single signer; the script that would count the keys and signatures disappears."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_ScriptlessMultisignature a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nP = 2**256 - 2**32 - 977\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nG = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\\ndef add(a, b):                               # point addition on y^2 = x^3 + 7 (None is the point at infinity)\\n    if a is None or b is None: return a or b\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return x, (m * (a[0] - x) - a[1]) % P\\ndef mul(k, p):\\n    r = None\\n    while k:\\n        if k & 1: r = add(r, p)\\n        p, k = add(p, p), k >> 1\\n    return r\\ndef pubkey(sec):                             # a 33- or 65-byte public key as a point\\n    x = int.from_bytes(sec[1:33], 'big')\\n    if sec[0] == 4: return x, int.from_bytes(sec[33:65], 'big')\\n    y = pow(x**3 + 7, (P + 1) // 4, P)\\n    return x, y if y % 2 == sec[0] % 2 else P - y\\ndef verify(sec, z, r, s):                    # ECDSA: R = (z/s)G + (r/s)Q must have x = r (mod n)\\n    w = pow(s, -1, N)\\n    R = add(mul(z * w % N, G), mul(r * w % N, pubkey(sec)))\\n    return R is not None and R[0] % N == r\\npartial_private_keys = [11, 12, 13]                          # one secret per participant\\npartial_public_keys = [mul(k, G) for k in partial_private_keys]\\ncombined = None\\nfor p in partial_public_keys: combined = add(combined, p)       # the combined key is the sum of the partial keys\\nresult = (combined == mul(sum(partial_private_keys) % N, G), len(partial_public_keys))\", g), g['result'])[1])({}) evaluates to (True, 3)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nP = 2**256 - 2**32 - 977\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nG = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\\ndef add(a, b):                               # point addition on y^2 = x^3 + 7 (None is the point at infinity)\\n    if a is None or b is None: return a or b\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return x, (m * (a[0] - x) - a[1]) % P\\ndef mul(k, p):\\n    r = None\\n    while k:\\n        if k & 1: r = add(r, p)\\n        p, k = add(p, p), k >> 1\\n    return r\\ndef pubkey(sec):                             # a 33- or 65-byte public key as a point\\n    x = int.from_bytes(sec[1:33], 'big')\\n    if sec[0] == 4: return x, int.from_bytes(sec[33:65], 'big')\\n    y = pow(x**3 + 7, (P + 1) // 4, P)\\n    return x, y if y % 2 == sec[0] % 2 else P - y\\ndef verify(sec, z, r, s):                    # ECDSA: R = (z/s)G + (r/s)Q must have x = r (mod n)\\n    w = pow(s, -1, N)\\n    R = add(mul(z * w % N, G), mul(r * w % N, pubkey(sec)))\\n    return R is not None and R[0] % N == r\\npartial_private_keys = [11, 12, 13]                          # one secret per participant\\npartial_public_keys = [mul(k, G) for k in partial_private_keys]\\ncombined = None\\nfor p in partial_public_keys: combined = add(combined, p)       # the combined key is the sum of the partial keys\\nresult = (combined == mul(sum(partial_private_keys) % N, G), len(partial_public_keys))\", g), g['result'])[1])({})" ; chx:output "(True, 3)" .
chx:X_ScriptlessMultisignature rd:hasIOExample chx:IO_ScriptlessMultisignature .
chx:X_ThresholdSignature a owl:NamedIndividual, chx:ThresholdSignature ; rdfs:label "any 2 of 3 shares reconstruct the key"@en ; skos:definition "A threshold signature lets any t of k participants sign; because the result is an ordinary signature, it does not show which of them signed, which is good for privacy and bad for accountability."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_ThresholdSignature a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nsecret, a1 = 12345, 67890                          # a line f(x) = secret + a1 * x, so that two points fix it\\nshares = {x: (secret + a1 * x) % N for x in (1, 2, 3)}\\ndef combine(i, j):                                 # Lagrange interpolation at x = 0 from the shares i and j\\n    return (j * pow(j - i, -1, N) * shares[i] + (-i) * pow(j - i, -1, N) * shares[j]) % N\\nresult = [combine(1, 2) == secret, combine(1, 3) == secret, combine(2, 3) == secret]', g), g['result'])[1])({}) evaluates to [True, True, True]"@en ; chx:input "(lambda g: (exec('N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nsecret, a1 = 12345, 67890                          # a line f(x) = secret + a1 * x, so that two points fix it\\nshares = {x: (secret + a1 * x) % N for x in (1, 2, 3)}\\ndef combine(i, j):                                 # Lagrange interpolation at x = 0 from the shares i and j\\n    return (j * pow(j - i, -1, N) * shares[i] + (-i) * pow(j - i, -1, N) * shares[j]) % N\\nresult = [combine(1, 2) == secret, combine(1, 3) == secret, combine(2, 3) == secret]', g), g['result'])[1])({})" ; chx:output "[True, True, True]" .
chx:X_ThresholdSignature rd:hasIOExample chx:IO_ThresholdSignature .
chx:X_Taproot a owl:NamedIndividual, chx:Taproot ; rdfs:label "the output key is the internal key plus a tweak that commits to the tree"@en ; skos:definition "A taproot output is a witness program of version 1 whose program is the 32-byte x coordinate of a point Q, computed as the internal key P plus the tagged hash of P and the root of a script tree, times the generator point; paying to Q is also a commitment to the scripts."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_Taproot a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nP = 2**256 - 2**32 - 977\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nG = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\\ndef add(a, b):                               # point addition on y^2 = x^3 + 7 (None is the point at infinity)\\n    if a is None or b is None: return a or b\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return x, (m * (a[0] - x) - a[1]) % P\\ndef mul(k, p):\\n    r = None\\n    while k:\\n        if k & 1: r = add(r, p)\\n        p, k = add(p, p), k >> 1\\n    return r\\ndef pubkey(sec):                             # a 33- or 65-byte public key as a point\\n    x = int.from_bytes(sec[1:33], 'big')\\n    if sec[0] == 4: return x, int.from_bytes(sec[33:65], 'big')\\n    y = pow(x**3 + 7, (P + 1) // 4, P)\\n    return x, y if y % 2 == sec[0] % 2 else P - y\\ndef verify(sec, z, r, s):                    # ECDSA: R = (z/s)G + (r/s)Q must have x = r (mod n)\\n    w = pow(s, -1, N)\\n    R = add(mul(z * w % N, G), mul(r * w % N, pubkey(sec)))\\n    return R is not None and R[0] % N == r\\ndef tagged(tag, data):                       # BIP340's tagged hash: SHA-256(SHA-256(tag) + SHA-256(tag) + data)\\n    t = hashlib.sha256(tag.encode()).digest()\\n    return hashlib.sha256(t + t + data).digest()\\ndef lift_x(x):                               # the curve point with this x and an even y (None when x is not on the curve)\\n    y = pow((pow(x, 3, P) + 7) % P, (P + 1) // 4, P)\\n    return None if pow(y, 2, P) != (x ** 3 + 7) % P else (x, y if y % 2 == 0 else P - y)\\ndef schnorr_verify(pub32, msg, sig):         # BIP340: s*G - e*P must have an even y and the x of R\\n    Pt, r, s = lift_x(int.from_bytes(pub32, 'big')), int.from_bytes(sig[:32], 'big'), int.from_bytes(sig[32:], 'big')\\n    if Pt is None or r >= P or s >= N: return False\\n    e = int.from_bytes(tagged('BIP0340/challenge', sig[:32] + pub32 + msg), 'big') % N\\n    R = add(mul(s, G), mul(N - e, Pt))\\n    return R is not None and R[1] % 2 == 0 and R[0] == r\\ndef output_key(internal32, root=b''):        # BIP341: Q = P + tagged_hash('TapTweak', P + root) * G; returns (parity of Q's y, x of Q)\\n    t = int.from_bytes(tagged('TapTweak', internal32 + root), 'big')\\n    Q = add(lift_x(int.from_bytes(internal32, 'big')), mul(t, G))\\n    return Q[1] & 1, Q[0].to_bytes(32, 'big')\\ninternal = G[0].to_bytes(32, 'big')                                  # the internal key P: here the generator point, for the example\\nroot = tagged('TapLeaf', bytes([0xc0, 1]) + bytes([0x51]))      # the root of a tree with one leaf: the script OP_TRUE\\nparity, q = output_key(internal, root)\\nresult = (parity, q.hex(), output_key(internal)[1] != q)\", g), g['result'])[1])({}) evaluates to (0, '9b6ce0db0707e29f92bf8893ed1911d397e3d2d76bbc68110c49da2ceec8be23', True)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nP = 2**256 - 2**32 - 977\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nG = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\\ndef add(a, b):                               # point addition on y^2 = x^3 + 7 (None is the point at infinity)\\n    if a is None or b is None: return a or b\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return x, (m * (a[0] - x) - a[1]) % P\\ndef mul(k, p):\\n    r = None\\n    while k:\\n        if k & 1: r = add(r, p)\\n        p, k = add(p, p), k >> 1\\n    return r\\ndef pubkey(sec):                             # a 33- or 65-byte public key as a point\\n    x = int.from_bytes(sec[1:33], 'big')\\n    if sec[0] == 4: return x, int.from_bytes(sec[33:65], 'big')\\n    y = pow(x**3 + 7, (P + 1) // 4, P)\\n    return x, y if y % 2 == sec[0] % 2 else P - y\\ndef verify(sec, z, r, s):                    # ECDSA: R = (z/s)G + (r/s)Q must have x = r (mod n)\\n    w = pow(s, -1, N)\\n    R = add(mul(z * w % N, G), mul(r * w % N, pubkey(sec)))\\n    return R is not None and R[0] % N == r\\ndef tagged(tag, data):                       # BIP340's tagged hash: SHA-256(SHA-256(tag) + SHA-256(tag) + data)\\n    t = hashlib.sha256(tag.encode()).digest()\\n    return hashlib.sha256(t + t + data).digest()\\ndef lift_x(x):                               # the curve point with this x and an even y (None when x is not on the curve)\\n    y = pow((pow(x, 3, P) + 7) % P, (P + 1) // 4, P)\\n    return None if pow(y, 2, P) != (x ** 3 + 7) % P else (x, y if y % 2 == 0 else P - y)\\ndef schnorr_verify(pub32, msg, sig):         # BIP340: s*G - e*P must have an even y and the x of R\\n    Pt, r, s = lift_x(int.from_bytes(pub32, 'big')), int.from_bytes(sig[:32], 'big'), int.from_bytes(sig[32:], 'big')\\n    if Pt is None or r >= P or s >= N: return False\\n    e = int.from_bytes(tagged('BIP0340/challenge', sig[:32] + pub32 + msg), 'big') % N\\n    R = add(mul(s, G), mul(N - e, Pt))\\n    return R is not None and R[1] % 2 == 0 and R[0] == r\\ndef output_key(internal32, root=b''):        # BIP341: Q = P + tagged_hash('TapTweak', P + root) * G; returns (parity of Q's y, x of Q)\\n    t = int.from_bytes(tagged('TapTweak', internal32 + root), 'big')\\n    Q = add(lift_x(int.from_bytes(internal32, 'big')), mul(t, G))\\n    return Q[1] & 1, Q[0].to_bytes(32, 'big')\\ninternal = G[0].to_bytes(32, 'big')                                  # the internal key P: here the generator point, for the example\\nroot = tagged('TapLeaf', bytes([0xc0, 1]) + bytes([0x51]))      # the root of a tree with one leaf: the script OP_TRUE\\nparity, q = output_key(internal, root)\\nresult = (parity, q.hex(), output_key(internal)[1] != q)\", g), g['result'])[1])({})" ; chx:output "(0, '9b6ce0db0707e29f92bf8893ed1911d397e3d2d76bbc68110c49da2ceec8be23', True)" .
chx:X_Taproot rd:hasIOExample chx:IO_Taproot .
chx:X_KeyPathSpending a owl:NamedIndividual, chx:KeyPathSpending ; rdfs:label "the witness is one 64-byte signature for the output key"@en ; skos:definition "Spending a taproot output by the key path needs one witness element, a BIP340 signature for the output key; it is checked like any other signature and shows nothing about any script the output might have committed to."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_KeyPathSpending a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nP = 2**256 - 2**32 - 977\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nG = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\\ndef add(a, b):                               # point addition on y^2 = x^3 + 7 (None is the point at infinity)\\n    if a is None or b is None: return a or b\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return x, (m * (a[0] - x) - a[1]) % P\\ndef mul(k, p):\\n    r = None\\n    while k:\\n        if k & 1: r = add(r, p)\\n        p, k = add(p, p), k >> 1\\n    return r\\ndef pubkey(sec):                             # a 33- or 65-byte public key as a point\\n    x = int.from_bytes(sec[1:33], 'big')\\n    if sec[0] == 4: return x, int.from_bytes(sec[33:65], 'big')\\n    y = pow(x**3 + 7, (P + 1) // 4, P)\\n    return x, y if y % 2 == sec[0] % 2 else P - y\\ndef verify(sec, z, r, s):                    # ECDSA: R = (z/s)G + (r/s)Q must have x = r (mod n)\\n    w = pow(s, -1, N)\\n    R = add(mul(z * w % N, G), mul(r * w % N, pubkey(sec)))\\n    return R is not None and R[0] % N == r\\ndef tagged(tag, data):                       # BIP340's tagged hash: SHA-256(SHA-256(tag) + SHA-256(tag) + data)\\n    t = hashlib.sha256(tag.encode()).digest()\\n    return hashlib.sha256(t + t + data).digest()\\ndef lift_x(x):                               # the curve point with this x and an even y (None when x is not on the curve)\\n    y = pow((pow(x, 3, P) + 7) % P, (P + 1) // 4, P)\\n    return None if pow(y, 2, P) != (x ** 3 + 7) % P else (x, y if y % 2 == 0 else P - y)\\ndef schnorr_verify(pub32, msg, sig):         # BIP340: s*G - e*P must have an even y and the x of R\\n    Pt, r, s = lift_x(int.from_bytes(pub32, 'big')), int.from_bytes(sig[:32], 'big'), int.from_bytes(sig[32:], 'big')\\n    if Pt is None or r >= P or s >= N: return False\\n    e = int.from_bytes(tagged('BIP0340/challenge', sig[:32] + pub32 + msg), 'big') % N\\n    R = add(mul(s, G), mul(N - e, Pt))\\n    return R is not None and R[1] % 2 == 0 and R[0] == r\\ndef output_key(internal32, root=b''):        # BIP341: Q = P + tagged_hash('TapTweak', P + root) * G; returns (parity of Q's y, x of Q)\\n    t = int.from_bytes(tagged('TapTweak', internal32 + root), 'big')\\n    Q = add(lift_x(int.from_bytes(internal32, 'big')), mul(t, G))\\n    return Q[1] & 1, Q[0].to_bytes(32, 'big')\\nq = bytes.fromhex('19cba5b63bdcbf46629edf17cda13bce567b90442bb421eae8a32e35843967c3')       # an output key\\nsig = bytes.fromhex('f1473c2449c0ffa8c93f1c5585cede0eb918113ca49cfbd4d493591766d9f4c5bbc5fe8c237f2d1ef17925b0d58f7672aec55c06df41c6bac9be3ee6ef47bb13')\\nmsg = hashlib.sha256(b'pay Bob 20000 satoshis').digest()\\nresult = (len(sig), schnorr_verify(q, msg, sig), schnorr_verify(q, hashlib.sha256(b'pay Eve').digest(), sig))\", g), g['result'])[1])({}) evaluates to (64, True, False)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nP = 2**256 - 2**32 - 977\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nG = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\\ndef add(a, b):                               # point addition on y^2 = x^3 + 7 (None is the point at infinity)\\n    if a is None or b is None: return a or b\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return x, (m * (a[0] - x) - a[1]) % P\\ndef mul(k, p):\\n    r = None\\n    while k:\\n        if k & 1: r = add(r, p)\\n        p, k = add(p, p), k >> 1\\n    return r\\ndef pubkey(sec):                             # a 33- or 65-byte public key as a point\\n    x = int.from_bytes(sec[1:33], 'big')\\n    if sec[0] == 4: return x, int.from_bytes(sec[33:65], 'big')\\n    y = pow(x**3 + 7, (P + 1) // 4, P)\\n    return x, y if y % 2 == sec[0] % 2 else P - y\\ndef verify(sec, z, r, s):                    # ECDSA: R = (z/s)G + (r/s)Q must have x = r (mod n)\\n    w = pow(s, -1, N)\\n    R = add(mul(z * w % N, G), mul(r * w % N, pubkey(sec)))\\n    return R is not None and R[0] % N == r\\ndef tagged(tag, data):                       # BIP340's tagged hash: SHA-256(SHA-256(tag) + SHA-256(tag) + data)\\n    t = hashlib.sha256(tag.encode()).digest()\\n    return hashlib.sha256(t + t + data).digest()\\ndef lift_x(x):                               # the curve point with this x and an even y (None when x is not on the curve)\\n    y = pow((pow(x, 3, P) + 7) % P, (P + 1) // 4, P)\\n    return None if pow(y, 2, P) != (x ** 3 + 7) % P else (x, y if y % 2 == 0 else P - y)\\ndef schnorr_verify(pub32, msg, sig):         # BIP340: s*G - e*P must have an even y and the x of R\\n    Pt, r, s = lift_x(int.from_bytes(pub32, 'big')), int.from_bytes(sig[:32], 'big'), int.from_bytes(sig[32:], 'big')\\n    if Pt is None or r >= P or s >= N: return False\\n    e = int.from_bytes(tagged('BIP0340/challenge', sig[:32] + pub32 + msg), 'big') % N\\n    R = add(mul(s, G), mul(N - e, Pt))\\n    return R is not None and R[1] % 2 == 0 and R[0] == r\\ndef output_key(internal32, root=b''):        # BIP341: Q = P + tagged_hash('TapTweak', P + root) * G; returns (parity of Q's y, x of Q)\\n    t = int.from_bytes(tagged('TapTweak', internal32 + root), 'big')\\n    Q = add(lift_x(int.from_bytes(internal32, 'big')), mul(t, G))\\n    return Q[1] & 1, Q[0].to_bytes(32, 'big')\\nq = bytes.fromhex('19cba5b63bdcbf46629edf17cda13bce567b90442bb421eae8a32e35843967c3')       # an output key\\nsig = bytes.fromhex('f1473c2449c0ffa8c93f1c5585cede0eb918113ca49cfbd4d493591766d9f4c5bbc5fe8c237f2d1ef17925b0d58f7672aec55c06df41c6bac9be3ee6ef47bb13')\\nmsg = hashlib.sha256(b'pay Bob 20000 satoshis').digest()\\nresult = (len(sig), schnorr_verify(q, msg, sig), schnorr_verify(q, hashlib.sha256(b'pay Eve').digest(), sig))\", g), g['result'])[1])({})" ; chx:output "(64, True, False)" .
chx:X_KeyPathSpending rd:hasIOExample chx:IO_KeyPathSpending .
chx:X_ScriptPathSpending a owl:NamedIndividual, chx:ScriptPathSpending ; rdfs:label "the witness shows a script, a proof and the data that satisfies it"@en ; skos:definition "Spending a taproot output by the script path reveals one script of the committed tree, the control block that connects the script to the output key, and the items that satisfy the script; no other script of the tree is shown."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_ScriptPathSpending a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nP = 2**256 - 2**32 - 977\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nG = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\\ndef add(a, b):                               # point addition on y^2 = x^3 + 7 (None is the point at infinity)\\n    if a is None or b is None: return a or b\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return x, (m * (a[0] - x) - a[1]) % P\\ndef mul(k, p):\\n    r = None\\n    while k:\\n        if k & 1: r = add(r, p)\\n        p, k = add(p, p), k >> 1\\n    return r\\ndef pubkey(sec):                             # a 33- or 65-byte public key as a point\\n    x = int.from_bytes(sec[1:33], 'big')\\n    if sec[0] == 4: return x, int.from_bytes(sec[33:65], 'big')\\n    y = pow(x**3 + 7, (P + 1) // 4, P)\\n    return x, y if y % 2 == sec[0] % 2 else P - y\\ndef verify(sec, z, r, s):                    # ECDSA: R = (z/s)G + (r/s)Q must have x = r (mod n)\\n    w = pow(s, -1, N)\\n    R = add(mul(z * w % N, G), mul(r * w % N, pubkey(sec)))\\n    return R is not None and R[0] % N == r\\ndef tagged(tag, data):                       # BIP340's tagged hash: SHA-256(SHA-256(tag) + SHA-256(tag) + data)\\n    t = hashlib.sha256(tag.encode()).digest()\\n    return hashlib.sha256(t + t + data).digest()\\ndef lift_x(x):                               # the curve point with this x and an even y (None when x is not on the curve)\\n    y = pow((pow(x, 3, P) + 7) % P, (P + 1) // 4, P)\\n    return None if pow(y, 2, P) != (x ** 3 + 7) % P else (x, y if y % 2 == 0 else P - y)\\ndef schnorr_verify(pub32, msg, sig):         # BIP340: s*G - e*P must have an even y and the x of R\\n    Pt, r, s = lift_x(int.from_bytes(pub32, 'big')), int.from_bytes(sig[:32], 'big'), int.from_bytes(sig[32:], 'big')\\n    if Pt is None or r >= P or s >= N: return False\\n    e = int.from_bytes(tagged('BIP0340/challenge', sig[:32] + pub32 + msg), 'big') % N\\n    R = add(mul(s, G), mul(N - e, Pt))\\n    return R is not None and R[1] % 2 == 0 and R[0] == r\\ndef output_key(internal32, root=b''):        # BIP341: Q = P + tagged_hash('TapTweak', P + root) * G; returns (parity of Q's y, x of Q)\\n    t = int.from_bytes(tagged('TapTweak', internal32 + root), 'big')\\n    Q = add(lift_x(int.from_bytes(internal32, 'big')), mul(t, G))\\n    return Q[1] & 1, Q[0].to_bytes(32, 'big')\\ndef leaf(script): return tagged('TapLeaf', bytes([0xc0, len(script)]) + script)\\ndef branch(a, b): return tagged('TapBranch', min(a, b) + max(a, b))\\nscripts = [bytes([0x51]), bytes([0x52]), bytes([0x53])]\\nla, lb, lc = [leaf(s) for s in scripts]\\nroot = branch(branch(la, lb), lc)\\ninternal = G[0].to_bytes(32, 'big')\\nparity, q = output_key(internal, root)\\ncontrol = bytes([0xc0 + parity]) + internal + lc + la          # reveal the second script's neighbours in order... for the first script: lb then lc\\nproof_for_a = [lb, lc]\\nh = la\\nfor sibling in proof_for_a: h = branch(h, sibling)\\nresult = (h == root, output_key(internal, h)[1] == q, len(control))\", g), g['result'])[1])({}) evaluates to (True, True, 97)"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nP = 2**256 - 2**32 - 977\\nN = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141\\nG = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)\\ndef add(a, b):                               # point addition on y^2 = x^3 + 7 (None is the point at infinity)\\n    if a is None or b is None: return a or b\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return x, (m * (a[0] - x) - a[1]) % P\\ndef mul(k, p):\\n    r = None\\n    while k:\\n        if k & 1: r = add(r, p)\\n        p, k = add(p, p), k >> 1\\n    return r\\ndef pubkey(sec):                             # a 33- or 65-byte public key as a point\\n    x = int.from_bytes(sec[1:33], 'big')\\n    if sec[0] == 4: return x, int.from_bytes(sec[33:65], 'big')\\n    y = pow(x**3 + 7, (P + 1) // 4, P)\\n    return x, y if y % 2 == sec[0] % 2 else P - y\\ndef verify(sec, z, r, s):                    # ECDSA: R = (z/s)G + (r/s)Q must have x = r (mod n)\\n    w = pow(s, -1, N)\\n    R = add(mul(z * w % N, G), mul(r * w % N, pubkey(sec)))\\n    return R is not None and R[0] % N == r\\ndef tagged(tag, data):                       # BIP340's tagged hash: SHA-256(SHA-256(tag) + SHA-256(tag) + data)\\n    t = hashlib.sha256(tag.encode()).digest()\\n    return hashlib.sha256(t + t + data).digest()\\ndef lift_x(x):                               # the curve point with this x and an even y (None when x is not on the curve)\\n    y = pow((pow(x, 3, P) + 7) % P, (P + 1) // 4, P)\\n    return None if pow(y, 2, P) != (x ** 3 + 7) % P else (x, y if y % 2 == 0 else P - y)\\ndef schnorr_verify(pub32, msg, sig):         # BIP340: s*G - e*P must have an even y and the x of R\\n    Pt, r, s = lift_x(int.from_bytes(pub32, 'big')), int.from_bytes(sig[:32], 'big'), int.from_bytes(sig[32:], 'big')\\n    if Pt is None or r >= P or s >= N: return False\\n    e = int.from_bytes(tagged('BIP0340/challenge', sig[:32] + pub32 + msg), 'big') % N\\n    R = add(mul(s, G), mul(N - e, Pt))\\n    return R is not None and R[1] % 2 == 0 and R[0] == r\\ndef output_key(internal32, root=b''):        # BIP341: Q = P + tagged_hash('TapTweak', P + root) * G; returns (parity of Q's y, x of Q)\\n    t = int.from_bytes(tagged('TapTweak', internal32 + root), 'big')\\n    Q = add(lift_x(int.from_bytes(internal32, 'big')), mul(t, G))\\n    return Q[1] & 1, Q[0].to_bytes(32, 'big')\\ndef leaf(script): return tagged('TapLeaf', bytes([0xc0, len(script)]) + script)\\ndef branch(a, b): return tagged('TapBranch', min(a, b) + max(a, b))\\nscripts = [bytes([0x51]), bytes([0x52]), bytes([0x53])]\\nla, lb, lc = [leaf(s) for s in scripts]\\nroot = branch(branch(la, lb), lc)\\ninternal = G[0].to_bytes(32, 'big')\\nparity, q = output_key(internal, root)\\ncontrol = bytes([0xc0 + parity]) + internal + lc + la          # reveal the second script's neighbours in order... for the first script: lb then lc\\nproof_for_a = [lb, lc]\\nh = la\\nfor sibling in proof_for_a: h = branch(h, sibling)\\nresult = (h == root, output_key(internal, h)[1] == q, len(control))\", g), g['result'])[1])({})" ; chx:output "(True, True, 97)" .
chx:X_ScriptPathSpending rd:hasIOExample chx:IO_ScriptPathSpending .
chx:X_ControlBlock a owl:NamedIndividual, chx:ControlBlock ; rdfs:label "the control block is 33 bytes plus 32 for each level of the tree"@en ; skos:definition "The control block is the last element of a script path witness: one byte that holds the leaf version and the parity of the output key, the 32-byte internal key, and the sibling hashes from the leaf up to the root, so its length is 33 plus 32 times the depth of the leaf."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_ControlBlock a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"control = bytes.fromhex('c100fd948e98e6289f833ddb7f10b8f72fbcdd4804b89421a1d3be9c1a9ea039a5')          # the control block of the block's only script path spend\\nversion, parity = control[0] & 0xfe, control[0] & 1\\ninternal_key = control[1:33]\\nresult = (version, parity, len(internal_key), (len(control) - 33) // 32)\", g), g['result'])[1])({}) evaluates to (192, 1, 32, 0)"@en ; chx:input "(lambda g: (exec(\"control = bytes.fromhex('c100fd948e98e6289f833ddb7f10b8f72fbcdd4804b89421a1d3be9c1a9ea039a5')          # the control block of the block's only script path spend\\nversion, parity = control[0] & 0xfe, control[0] & 1\\ninternal_key = control[1:33]\\nresult = (version, parity, len(internal_key), (len(control) - 33) // 32)\", g), g['result'])[1])({})" ; chx:output "(192, 1, 32, 0)" .
chx:X_ControlBlock rd:hasIOExample chx:IO_ControlBlock .
chx:X_TapscriptChanges a owl:NamedIndividual, chx:TapscriptChanges ; rdfs:label "the old multisignature opcodes fail; every signature is a Schnorr signature or empty"@en ; skos:definition "Tapscript disables the old multisignature opcodes, makes every signature check use BIP340 Schnorr signatures, requires a signature that is not expected to succeed to be the empty value, and makes the MINIMALIF rule part of the consensus."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_TapscriptChanges a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('legacy = 1 + 3 * 34 + 1 + 1          # OP_2, three 33-byte keys with their push byte, OP_3, OP_CHECKMULTISIG\\ntapscript = 3 * 33 + 1 + 2 + 1 + 1     # three 32-byte keys with their push byte, CHECKSIG, two CHECKSIGADD, OP_2, NUMEQUAL\\nresult = (legacy, tapscript, legacy - tapscript)', g), g['result'])[1])({}) evaluates to (105, 104, 1)"@en ; chx:input "(lambda g: (exec('legacy = 1 + 3 * 34 + 1 + 1          # OP_2, three 33-byte keys with their push byte, OP_3, OP_CHECKMULTISIG\\ntapscript = 3 * 33 + 1 + 2 + 1 + 1     # three 32-byte keys with their push byte, CHECKSIG, two CHECKSIGADD, OP_2, NUMEQUAL\\nresult = (legacy, tapscript, legacy - tapscript)', g), g['result'])[1])({})" ; chx:output "(105, 104, 1)" .
chx:X_TapscriptChanges rd:hasIOExample chx:IO_TapscriptChanges .
chx:X_ChecksigAdd a owl:NamedIndividual, chx:ChecksigAdd ; rdfs:label "each valid signature adds one; an empty signature adds nothing"@en ; skos:definition "OP_CHECKSIGADD pops a public key, a number and a signature, adds one to the number if the signature is valid, leaves it unchanged if the signature is empty and fails the script if the signature is not empty and not valid; a multisignature is a chain of these followed by a comparison."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_ChecksigAdd a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"def checksigadd(count, sig, valid):              # a model of the opcode: the signature is valid, empty or wrong\\n    if sig == b'': return count                         # an empty signature counts nothing\\n    if sig in valid: return count + 1                   # a valid one counts one\\n    raise ValueError('a non-empty invalid signature fails the script')\\ndef two_of_three(sigs, valid):\\n    count = 0\\n    for s in sigs: count = checksigadd(count, s, valid)\\n    return count == 2\\nvalid = {b'sig-a', b'sig-b', b'sig-c'}\\nresult = (two_of_three([b'', b'sig-b', b'sig-a'], valid), two_of_three([b'', b'', b'sig-a'], valid), two_of_three([b'sig-a', b'sig-b', b'sig-c'], valid))\", g), g['result'])[1])({}) evaluates to (True, False, False)"@en ; chx:input "(lambda g: (exec(\"def checksigadd(count, sig, valid):              # a model of the opcode: the signature is valid, empty or wrong\\n    if sig == b'': return count                         # an empty signature counts nothing\\n    if sig in valid: return count + 1                   # a valid one counts one\\n    raise ValueError('a non-empty invalid signature fails the script')\\ndef two_of_three(sigs, valid):\\n    count = 0\\n    for s in sigs: count = checksigadd(count, s, valid)\\n    return count == 2\\nvalid = {b'sig-a', b'sig-b', b'sig-c'}\\nresult = (two_of_three([b'', b'sig-b', b'sig-a'], valid), two_of_three([b'', b'', b'sig-a'], valid), two_of_three([b'sig-a', b'sig-b', b'sig-c'], valid))\", g), g['result'])[1])({})" ; chx:output "(True, False, False)" .
chx:X_ChecksigAdd rd:hasIOExample chx:IO_ChecksigAdd .
chx:X_OpSuccess a owl:NamedIndividual, chx:OpSuccess ; rdfs:label "87 opcode values make a tapscript succeed at once"@en ; skos:definition "In tapscript, 87 opcode values that were unused or disabled are renamed OP_SUCCESSx, and a script in which one is found succeeds unconditionally even when the bytes after it could not be decoded; a later soft fork can give any of them a meaning, as that can only turn a valid script into an invalid one."@en ; dcterms:source <http://example.org/sen0401/ch07/research> .
chx:IO_OpSuccess a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"success = {80, 98, *range(126, 130), *range(131, 135), 137, 138, 141, 142, *range(149, 154), *range(187, 255)}   # the numbers BIP342 lists\\ndef tapscript_result(opcodes):                           # a model: scan the opcodes in order\\n    return 'success' if any(o in success for o in opcodes) else 'run the script'\\nresult = (len(success), tapscript_result([0x51, 0xac]), tapscript_result([0x51, 187, 0xff]))\", g), g['result'])[1])({}) evaluates to (87, 'run the script', 'success')"@en ; chx:input "(lambda g: (exec(\"success = {80, 98, *range(126, 130), *range(131, 135), 137, 138, 141, 142, *range(149, 154), *range(187, 255)}   # the numbers BIP342 lists\\ndef tapscript_result(opcodes):                           # a model: scan the opcodes in order\\n    return 'success' if any(o in success for o in opcodes) else 'run the script'\\nresult = (len(success), tapscript_result([0x51, 0xac]), tapscript_result([0x51, 187, 0xff]))\", g), g['result'])[1])({})" ; chx:output "(87, 'run the script', 'success')" .
chx:X_OpSuccess rd:hasIOExample chx:IO_OpSuccess .
