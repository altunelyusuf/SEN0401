chx:X_RedeemScript chx:hasOwner chx:X_PayToScriptHashOutput .
chx:X_P2shAddress chx:hasOwner chx:X_PayToScriptHashOutput .
chx:X_P2shRules chx:hasOwner chx:X_PayToScriptHashOutput .
chx:X_DataCarrierPolicy chx:hasOwner chx:X_OpReturnOutput .
chx:X_LockTimeLimits chx:hasOwner chx:X_CheckLockTimeVerify .
chx:X_RelativeTimelock chx:hasOwner chx:X_CheckSequenceVerify .
chx:X_VerifyGuard chx:hasOwner chx:X_ConditionalClauses .
chx:X_MultiPathScript chx:hasOwner chx:X_ConditionalClauses .
chx:X_P2wpkh chx:hasOwner chx:X_WitnessProgram .
chx:X_P2wsh chx:hasOwner chx:X_WitnessProgram .
chx:X_SegwitAddress chx:hasOwner chx:X_WitnessProgram .
chx:X_WitnessSighash chx:hasOwner chx:X_BackwardCompatibleUpgrade .
chx:X_NestedSegwit chx:hasOwner chx:X_BackwardCompatibleUpgrade .
chx:X_MastVersusAst chx:hasOwner chx:X_Mast .
chx:X_ThresholdSignature chx:hasOwner chx:X_ScriptlessMultisignature .
chx:X_KeyPathSpending chx:hasOwner chx:X_Taproot .
chx:X_ScriptPathSpending chx:hasOwner chx:X_Taproot .
chx:X_ControlBlock chx:hasOwner chx:X_ScriptPathSpending .
chx:X_ChecksigAdd chx:hasOwner chx:X_TapscriptChanges .
chx:X_OpSuccess chx:hasOwner chx:X_TapscriptChanges .
chx:X_StackExecution chx:hasOwner chx:X_Script .
chx:X_ScriptLimits chx:hasOwner chx:X_Script .
chx:X_InputScript chx:hasOwner chx:X_SeparateExecution .
chx:X_OutputScript chx:hasOwner chx:X_SeparateExecution .
chx:Err_Script a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "bytes.fromhex('5g') raises ValueError: non-hexadecimal number found in fromhex() arg"@en .
chx:X_Script rd:hasErrorCondition chx:Err_Script .
chx:Err_ScriptLimits a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"script = bytes(10001)\\nassert len(script) <= 10000, 'a script is at most 10,000 bytes'\\nresult = len(script)\", g), g['result'])[1])({}) raises AssertionError: a script is at most 10,000 bytes"@en .
chx:X_ScriptLimits rd:hasErrorCondition chx:Err_ScriptLimits .
chx:Err_SignatureEncoding a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"sig = bytes.fromhex('3145022100aa0220bb01')\\nassert sig[0] == 0x30, 'a DER signature starts with the byte 0x30'\\nresult = sig[0]\", g), g['result'])[1])({}) raises AssertionError: a DER signature starts with the byte 0x30"@en .
chx:X_SignatureEncoding rd:hasErrorCondition chx:Err_SignatureEncoding .
chx:Err_PublicKeyHash a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"import hashlib\\nkey_hash = hashlib.sha256(b'a public key').digest()          # 32 bytes: SHA-256 alone, not HASH160\\nassert len(key_hash) == 20, 'a public key hash is 20 bytes'\\nresult = key_hash.hex()\", g), g['result'])[1])({}) raises AssertionError: a public key hash is 20 bytes"@en .
chx:X_PublicKeyHash rd:hasErrorCondition chx:Err_PublicKeyHash .
chx:Err_MultisigLimits a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"keys = 21\\nassert 1 <= keys <= 20, 'a multisignature holds at most 20 keys'\\nresult = keys\", g), g['result'])[1])({}) raises AssertionError: a multisignature holds at most 20 keys"@en .
chx:X_MultisigLimits rd:hasErrorCondition chx:Err_MultisigLimits .
chx:Err_CheckLockTimeVerify a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"lock = -5\\nassert lock >= 0, 'a lock time is not negative'\\nresult = lock\", g), g['result'])[1])({}) raises AssertionError: a lock time is not negative"@en .
chx:X_CheckLockTimeVerify rd:hasErrorCondition chx:Err_CheckLockTimeVerify .
chx:Err_RelativeTimelock a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"blocks = 65536\\nassert blocks <= 0xffff, 'a relative timelock holds at most 65535 blocks'\\nresult = blocks & 0xffff\", g), g['result'])[1])({}) raises AssertionError: a relative timelock holds at most 65535 blocks"@en .
chx:X_RelativeTimelock rd:hasErrorCondition chx:Err_RelativeTimelock .
chx:Err_RedeemScript a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"redeem_script = bytes(521)\\nassert len(redeem_script) <= 520, 'a redeem script is one push of at most 520 bytes'\\nresult = len(redeem_script)\", g), g['result'])[1])({}) raises AssertionError: a redeem script is one push of at most 520 bytes"@en .
chx:X_RedeemScript rd:hasErrorCondition chx:Err_RedeemScript .
chx:Err_WitnessProgram a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"program = bytes(19)\\nassert len(program) in (20, 32), 'a version 0 witness program is 20 or 32 bytes'\\nresult = len(program)\", g), g['result'])[1])({}) raises AssertionError: a version 0 witness program is 20 or 32 bytes"@en .
chx:X_WitnessProgram rd:hasErrorCondition chx:Err_WitnessProgram .
chx:Err_SegwitAddress a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "'qpzry9x8gf2tvdw0s3jn54khce6mua7l'.index('b') raises ValueError: substring not found"@en .
chx:X_SegwitAddress rd:hasErrorCondition chx:Err_SegwitAddress .
chx:Err_Taproot a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"internal_key = bytes(33)          # a compressed key still has its prefix byte\\nassert len(internal_key) == 32, 'an internal key is 32 bytes, the x coordinate only'\\nresult = internal_key.hex()\", g), g['result'])[1])({}) raises AssertionError: an internal key is 32 bytes, the x coordinate only"@en .
chx:X_Taproot rd:hasErrorCondition chx:Err_Taproot .
chx:Err_ControlBlock a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"control = bytes(34)\\nassert 33 <= len(control) <= 4129 and (len(control) - 33) % 32 == 0, 'a control block is 33 bytes plus 32 for each level'\\nresult = len(control)\", g), g['result'])[1])({}) raises AssertionError: a control block is 33 bytes plus 32 for each level"@en .
chx:X_ControlBlock rd:hasErrorCondition chx:Err_ControlBlock .
chx:Err_KeyPathSpending a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"witness = [bytes(63)]\\nassert len(witness) == 1 and len(witness[0]) in (64, 65), 'a key path witness is one signature of 64 or 65 bytes'\\nresult = len(witness[0])\", g), g['result'])[1])({}) raises AssertionError: a key path witness is one signature of 64 or 65 bytes"@en .
chx:X_KeyPathSpending rd:hasErrorCondition chx:Err_KeyPathSpending .
chx:Err_Mast a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"proof = [bytes(32)] * 129\\nassert len(proof) <= 128, 'a script path has at most 128 hashes'\\nresult = len(proof)\", g), g['result'])[1])({}) raises AssertionError: a script path has at most 128 hashes"@en .
chx:X_Mast rd:hasErrorCondition chx:Err_Mast .
chx:Err_ThresholdSignature a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "pow(0, -1, 7) raises ValueError: base is not invertible for the given modulus"@en .
chx:X_ThresholdSignature rd:hasErrorCondition chx:Err_ThresholdSignature .

chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 7 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch07/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 7 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2, chx:CQ3, chx:CQ4, chx:CQ5, chx:CQ6, chx:CQ7 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What does a Bitcoin output ask of its spender, and how do the input script and the output script together decide whether a spend is authorized?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How does a script run on a stack, why is the language deliberately not Turing complete, and why can every node verify a spend without knowing anything but the transaction and the outputs it spends?"@en .
chx:CQ3 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How do pay to public key hash, scripted multisignatures and pay to script hash move the cost of a complicated condition from the payer to the spender, and what does the signature check count?"@en .
chx:CQ4 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How do lock time, OP_CHECKLOCKTIMEVERIFY, the sequence field and OP_CHECKSEQUENCEVERIFY make a spend wait, and where do the book and Bitcoin Core's rules differ by one block?"@en .
chx:CQ5 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How does segregated witness fix signature malleability and add a version byte for later upgrades, and what do P2WPKH, P2WSH and the nested forms look like on the chain?"@en .
chx:CQ6 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How do a script tree, a tweaked key and a scriptless multisignature combine into taproot, and what does a key path spend or a script path spend reveal?"@en .
chx:CQ7 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What does tapscript change in the language, and which statements of the book differ from the BIPs and from Bitcoin Core's sources?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 7 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 7 through the Stage 1 research record: the chapter's own sections and named terms first, then the standards it cites (BIP11, BIP13, BIP16, BIP65, BIP66, BIP68, BIP86, BIP112, BIP114, BIP116, BIP141, BIP143, BIP146, BIP147, BIP173, BIP327, BIP340, BIP341, BIP342, BIP350 and BIP379), Bitcoin Core's script, policy and consensus sources at commit 05bc2f5 with its list of implemented proposals and its script and signature-hash test data, the first interpreter of Bitcoin 0.3.0 and its repair, and the raw bytes and explorer records of 599 transactions of block 775,072 fetched from mempool.space on 2026-10-08; the supporting concepts (the stack, the truth of a script, the key hash, the DER encoding, the signature check count and the witness program) were added because an audit of the explanations found them used without a concept of their own."@en ;
    dcterms:source <http://example.org/sen0401/ch07/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (565 checks listed in sen0401_ch07_corpus_v1_0_0.py), executed under CPython 3.14.6."@en ;
    dcterms:source "The execution run of this ontology's build, 08-tooling/sen0401_chapter_build_v1_0_1.py, over the claims in 08-tooling/sen0401_ch07_corpus_v1_0_0.py" .

