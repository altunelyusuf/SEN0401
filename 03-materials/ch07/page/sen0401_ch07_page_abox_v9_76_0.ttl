pg:Card a ipo:Sidebar,
        owl:NamedIndividual ;
    rdfs:label "Detail card"@en ;
    dcterms:source <http://example.org/sen0401/ch07/document> ;
    skos:definition "The detail card at the right opens only when the reader explicitly asks for the details of a concept."@en .

pg:Header a ipo:Header,
        owl:NamedIndividual ;
    rdfs:label "Header with the main menu"@en ;
    dcterms:source <http://example.org/sen0401/ch07/document> ;
    skos:definition "The header at the top holds the main menu, whose items are intro, learn, maps, lab, agents, practice, reference, about."@en .

pg:Layout a ipo:LayoutPattern,
        owl:NamedIndividual ;
    rdfs:label "Explorer, main area and detail card"@en ;
    dcterms:source <http://example.org/sen0401/ch07/document> ;
    skos:definition "The page puts the chapter explorer at the left, the main area in the centre and a detail card at the right that stays closed until the reader asks for a detail."@en .

pg:Main a ipo:MainContent,
        owl:NamedIndividual ;
    rdfs:label "Main area"@en ;
    dcterms:source <http://example.org/sen0401/ch07/document> ;
    skos:definition "The main area shows the chapter content of the selected menu item, with the widgets of its sections inline."@en .

pg:Q10_O1 a ld:AnswerOption ;
    rdfs:label "7,200,000 seconds"@en .

pg:Q10_O2 a ld:AnswerOption ;
    rdfs:label "7,862,400 seconds"@en .

pg:Q1_O1 a ld:AnswerOption ;
    rdfs:label "That the input script and the output script are byte for byte equal"@en .

pg:Q1_O2 a ld:AnswerOption ;
    rdfs:label "That the signature is the same as the signature of the previous spend of the key"@en .

pg:Q2_O0 a ld:AnswerOption ;
    rdfs:label "The spend succeeds, because 1 is true"@en .

pg:Q2_O2 a ld:AnswerOption ;
    rdfs:label "The output script runs and the result decides"@en .

pg:Q3_O0 a ld:AnswerOption ;
    rdfs:label "175 bytes"@en .

pg:Q3_O2 a ld:AnswerOption ;
    rdfs:label "210 bytes"@en .

pg:Q4_O1 a ld:AnswerOption ;
    rdfs:label "Keys are limited to 15 by the signature hash"@en .

pg:Q4_O2 a ld:AnswerOption ;
    rdfs:label "Script hash outputs cannot hold compressed keys"@en .

pg:Q5_O0 a ld:AnswerOption ;
    rdfs:label "8 blocks"@en .

pg:Q5_O2 a ld:AnswerOption ;
    rdfs:label "No lock: the type flag disables it"@en .

pg:Q6_O0 a ld:AnswerOption ;
    rdfs:label "It sets the lock time of the transaction that contains the script"@en .

pg:Q6_O2 a ld:AnswerOption ;
    rdfs:label "It pauses the node until the time is reached"@en .

pg:Q7_O1 a ld:AnswerOption ;
    rdfs:label "Because every node upgraded on the same day"@en .

pg:Q7_O2 a ld:AnswerOption ;
    rdfs:label "Because the witness data is placed inside the transaction identifier"@en .

pg:Q8_O0 a ld:AnswerOption ;
    rdfs:label "A script path spend"@en .

pg:Q8_O2 a ld:AnswerOption ;
    rdfs:label "An invalid spend, because a signature has 65 bytes"@en .

pg:Q9_O1 a ld:AnswerOption ;
    rdfs:label "1"@en .

pg:Q9_O2 a ld:AnswerOption ;
    rdfs:label "33"@en .

pg:SectionTree a ipo:TreeNavigation,
        owl:NamedIndividual ;
    rdfs:label "Section tree"@en ;
    dcterms:source <http://example.org/sen0401/ch07/document> ;
    skos:definition "The section tree lists the sections of the chapter by their three levels, and choosing one opens that single section."@en .

pg:Sidebar a ipo:Sidebar,
        owl:NamedIndividual ;
    rdfs:label "Chapter explorer"@en ;
    dcterms:source <http://example.org/sen0401/ch07/document> ;
    skos:definition "The explorer at the left shows the chapter's sections as a tree and keeps pace with the tabs of the main area."@en .

pg:SourceDocument a ipo:SourceDocument,
        owl:NamedIndividual ;
    rdfs:label "Chapter 7 Stage 3 document"@en ;
    ipo:hasLearningObjective pg:CO1,
        pg:CO2,
        pg:CO3,
        pg:CO4,
        pg:CO5,
        pg:CO6 ;
    dcterms:source <http://example.org/sen0401/ch07/document> ;
    skos:definition "The Stage 3 document of chapter 7 is the text this page renders, section for section."@en .

pg:TopMenu a ipo:PrimaryNavigation,
        owl:NamedIndividual ;
    rdfs:label "Main menu"@en ;
    dcterms:source <http://example.org/sen0401/ch07/document> ;
    skos:definition "The main menu is permanently visible at the top and lets the reader reach every top-level area without scrolling or opening anything first."@en .

pg:Q10_O0 a ld:AnswerOption ;
    rdfs:label "7,776,000 seconds"@en .

pg:Q1_O0 a ld:AnswerOption ;
    rdfs:label "That the public key in the input script hashes to the 20 bytes in the output script, and that the signature is valid for that key"@en .

pg:Q2_O1 a ld:AnswerOption ;
    rdfs:label "The spend fails, because OP_RETURN ends the script with an error"@en .

pg:Q3_O1 a ld:AnswerOption ;
    rdfs:label "173 bytes"@en .

pg:Q4_O0 a ld:AnswerOption ;
    rdfs:label "The 16-key script is 547 bytes and a redeem script is one push of at most 520 bytes"@en .

pg:Q5_O1 a ld:AnswerOption ;
    rdfs:label "8 units of 512 seconds, that is 4,096 seconds"@en .

pg:Q6_O1 a ld:AnswerOption ;
    rdfs:label "It fails the spend unless the spending transaction's lock time is of the same kind and at least as large as the script's number"@en .

pg:Q7_O0 a ld:AnswerOption ;
    rdfs:label "Old nodes see a witness program as an output anyone can spend and accept an empty input script, while new nodes require a valid witness"@en .

pg:Q8_O1 a ld:AnswerOption ;
    rdfs:label "A key path spend with the default hash type"@en .

pg:Q9_O0 a ld:AnswerOption ;
    rdfs:label "0, a tree with one leaf"@en .

pg:S_AbsoluteTimelocks a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Absolute timelocks"@en ;
    sen0401:anchor "#AbsoluteTimelocks" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_AbsoluteTimelocks> ;
    skos:definition "This group is about conditions that name a point in time or a block height."@en .

pg:S_BackwardCompatibleUpgrade a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Backward-compatible upgrade"@en ;
    sen0401:anchor "#BackwardCompatibleUpgrade" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_BackwardCompatibleUpgrade> ;
    skos:definition "Segregated witness is a soft fork: an old node sees a witness output as two pushes that anyone can spend and ignores the witness, while an upgraded node enforces the witness rules, so the two kinds of node agree on the chain as long as the miners enforce the new rules."@en .

pg:S_CheckLockTimeVerify a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "OP_CHECKLOCKTIMEVERIFY"@en ;
    sen0401:anchor "#CheckLockTimeVerify" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_CheckLockTimeVerify> ;
    skos:definition "OP_CHECKLOCKTIMEVERIFY fails a script unless the lock time of the spending transaction is of the same kind as, and at least as large as, the number on top of the stack, and the input is not final."@en .

pg:S_CheckSequenceVerify a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "OP_CHECKSEQUENCEVERIFY"@en ;
    sen0401:anchor "#CheckSequenceVerify" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_CheckSequenceVerify> ;
    skos:definition "OP_CHECKSEQUENCEVERIFY fails a script unless the transaction has version 2 or more and the sequence of the spending input carries a relative lock of the same kind as, and at least as large as, the number on top of the stack."@en .

pg:S_CheckmultisigDummy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The CHECKMULTISIG dummy element"@en ;
    sen0401:anchor "#CheckmultisigDummy" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_CheckmultisigDummy> ;
    skos:definition "The dummy element is the extra stack item that OP_CHECKMULTISIG pops after its signatures; its content is ignored by the opcode itself, but since BIP147 it must be an empty byte array."@en .

pg:S_ChecksigAdd a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "OP_CHECKSIGADD"@en ;
    sen0401:anchor "#ChecksigAdd" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ChecksigAdd> ;
    skos:definition "OP_CHECKSIGADD pops a public key, a number and a signature, adds one to the number if the signature is valid, leaves it unchanged if the signature is empty and fails the script if the signature is not empty and not valid; a multisignature is a chain of these followed by a comparison."@en .

pg:S_ComplexScripts a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Script with timelocks and signers"@en ;
    sen0401:anchor "#ComplexScripts" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ComplexScripts> ;
    skos:definition "This group puts the previous branches together."@en .

pg:S_ConditionalClauses a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Conditional clauses"@en ;
    sen0401:anchor "#ConditionalClauses" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ConditionalClauses> ;
    skos:definition "A conditional clause is a group of opcodes between OP_IF or OP_NOTIF and OP_ENDIF, with an optional OP_ELSE, that runs one of two code paths according to the value on top of the stack when the OP_IF is reached."@en .

pg:S_Conditionals a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Conditionals and guards"@en ;
    sen0401:anchor "#Conditionals" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_Conditionals> ;
    skos:definition "This group covers the three ways a script decides what to do."@en .

pg:S_ControlBlock a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Control block"@en ;
    sen0401:anchor "#ControlBlock" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ControlBlock> ;
    skos:definition "The control block is the last element of a script path witness: one byte that holds the leaf version and the parity of the output key, the 32-byte internal key, and the sibling hashes from the leaf up to the root, so its length is 33 plus 32 times the depth of the leaf."@en .

pg:S_DataAndTime a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Data output and timelocks"@en ;
    sen0401:anchor "#DataAndTime" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch07#S_DataAndTime> ;
    skos:definition "This branch collects two kinds of condition that have nothing to do with keys."@en .

pg:S_DataCarrierPolicy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Data carrier policy"@en ;
    sen0401:anchor "#DataCarrierPolicy" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_DataCarrierPolicy> ;
    skos:definition "The data carrier policy is the relay rule that decides how many bytes of OP_RETURN data a transaction may carry; in Bitcoin Core it accepts data carriers by default and shares one budget of 100,000 vbytes among all the data outputs of a transaction."@en .

pg:S_DataOutput a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Recording data without bloat"@en ;
    sen0401:anchor "#DataOutput" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_DataOutput> ;
    skos:definition "This group is about outputs that exist only to carry data."@en .

pg:S_FlowControl a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Flow control and complex scripts"@en ;
    sen0401:anchor "#FlowControl" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch07#S_FlowControl> ;
    skos:definition "This branch is about scripts that have more than one way of being spent, and the tools for writing them."@en .

pg:S_InputScript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Input script"@en ;
    sen0401:anchor "#InputScript" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_InputScript> ;
    skos:definition "An input script, called scriptSig in the code, is a script that satisfies the conditions placed in an output script and so allows the output to be spent; in legacy transactions it usually holds a signature and a public key."@en .

pg:S_KeyLocking a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Locking to a key"@en ;
    sen0401:anchor "#KeyLocking" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch07#S_KeyLocking> ;
    skos:definition "This branch follows the oldest and still the commonest way of controlling an output: locking it to a key."@en .

pg:S_KeyPathSpending a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Key path spending"@en ;
    sen0401:anchor "#KeyPathSpending" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_KeyPathSpending> ;
    skos:definition "Spending a taproot output by the key path needs one witness element, a BIP340 signature for the output key; it is checked like any other signature and shows nothing about any script the output might have committed to."@en .

pg:S_KeyTweaks a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Tweaking keys"@en ;
    sen0401:anchor "#KeyTweaks" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_KeyTweaks> ;
    skos:definition "This group is about changing a public key by adding to it a value that is made from other data."@en .

pg:S_LockTimeLimits a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Lock time limits"@en ;
    sen0401:anchor "#LockTimeLimits" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_LockTimeLimits> ;
    skos:definition "The lock time of a transaction restricts only when that transaction can be included in a block; it does not stop the signer from spending the same inputs in another transaction without a lock time."@en .

pg:S_Mast a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Merklized alternative script tree"@en ;
    sen0401:anchor "#Mast" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_Mast> ;
    skos:definition "A Merklized alternative script tree commits to a set of alternative scripts with the root of a Merkle tree; a spender shows the script that is used and the hashes that connect it to the root, which costs one 32-byte hash for each level between the script and the root."@en .

pg:S_MastVersusAst a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Two meanings of MAST"@en ;
    sen0401:anchor "#MastVersusAst" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_MastVersusAst> ;
    skos:definition "The name MAST first meant a Merklized abstract syntax tree, which commits to every part of a program, and now means a Merklized alternative script tree, which commits to a set of complete scripts of which one is used; the second needs only one hash for each level of depth."@en .

pg:S_Miniscript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Miniscript"@en ;
    sen0401:anchor "#Miniscript" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_Miniscript> ;
    skos:definition "Miniscript is a structured way of writing a subset of Bitcoin Script, in which small fragments with known behaviour are composed by rules, so that a program can analyse the result, find the spending conditions and construct witnesses."@en .

pg:S_MohammedScript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Capital account script"@en ;
    sen0401:anchor "#MohammedScript" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_MohammedScript> ;
    skos:definition "The capital-account script of the book has three execution paths: two of three partners at any time, the lawyer with one partner after 30 days, and the lawyer alone after 90 days, selected by two true or false values in the input script."@en .

pg:S_MultiPathScript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Scripts with several paths"@en ;
    sen0401:anchor "#MultiPathScript" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_MultiPathScript> ;
    skos:definition "A script with several paths nests conditional clauses so that each path is a different way to redeem the output, and the input script selects the path by pushing a true or false value for each clause."@en .

pg:S_MultisigForm a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The t-of-k script and its limits"@en ;
    sen0401:anchor "#MultisigForm" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_MultisigForm> ;
    skos:definition "This group states what a multisignature output script looks like and how large it may be."@en .

pg:S_MultisigLimits a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Multisignature limits"@en ;
    sen0401:anchor "#MultisigLimits" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_MultisigLimits> ;
    skos:definition "The number of keys a multisignature may list is limited in three different ways: three for a bare script by relay policy, fifteen for a script hash because of the 520-byte limit on a script element, and twenty for every script by consensus."@en .

pg:S_MultisigOddity a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The multisig extra-element bug"@en ;
    sen0401:anchor "#MultisigOddity" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_MultisigOddity> ;
    skos:definition "This group covers two consequences of the way OP_CHECKMULTISIG is implemented."@en .

pg:S_NestedSegwit a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Nested segregated witness"@en ;
    sen0401:anchor "#NestedSegwit" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_NestedSegwit> ;
    skos:definition "A nested segregated witness output is a script hash output whose redeem script is a witness program; a wallet that cannot send to a segwit address can pay the 3 address, and the receiver spends it with a witness."@en .

pg:S_OpChecksig a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "OP_CHECKSIG"@en ;
    sen0401:anchor "#OpChecksig" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_OpChecksig> ;
    skos:definition "OP_CHECKSIG pops a public key and a signature, checks the signature against a hash of the spending transaction, and pushes true if it is valid and false otherwise."@en .

pg:S_OpReturnBug a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The +1 OP_RETURN+ bug"@en ;
    sen0401:anchor "#OpReturnBug" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_OpReturnBug> ;
    skos:definition "In the first release the two scripts were joined and OP_RETURN jumped to the end of the joined script, so an input script that began with a true value and then executed OP_RETURN made any output spendable by anyone."@en .

pg:S_OpReturnOutput a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "OP_RETURN output"@en ;
    sen0401:anchor "#OpReturnOutput" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_OpReturnOutput> ;
    skos:definition "An OP_RETURN output is an output whose script begins with OP_RETURN followed by data; it can never be spent, so nodes need not keep it in the set of unspent outputs."@en .

pg:S_OpSuccess a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "OP_SUCCESS opcodes"@en ;
    sen0401:anchor "#OpSuccess" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_OpSuccess> ;
    skos:definition "In tapscript, 87 opcode values that were unused or disabled are renamed OP_SUCCESSx, and a script in which one is found succeeds unconditionally even when the bytes after it could not be decoded; a later soft fork can give any of them a meaning, as that can only turn a valid script into an invalid one."@en .

pg:S_OutputScript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Output script"@en ;
    sen0401:anchor "#OutputScript" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_OutputScript> ;
    skos:definition "An output script, called scriptPubKey in the code, states the conditions that must be met to spend the output in the future, such as who is authorized to spend it and how they will be authenticated."@en .

pg:S_P2shAddress a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "P2SH address"@en ;
    sen0401:anchor "#P2shAddress" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_P2shAddress> ;
    skos:definition "A P2SH address is the Base58Check encoding of the 20-byte script hash with a version byte of 5, which makes it begin with the character 3."@en .

pg:S_P2shBenefits a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Benefits of P2SH"@en ;
    sen0401:anchor "#P2shBenefits" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_P2shBenefits> ;
    skos:definition "P2SH makes a complex payment as easy as an ordinary one for the payer and shifts the storage and the fee of the long script to the later spender."@en .

pg:S_P2shConsequences a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "What the hash changes"@en ;
    sen0401:anchor "#P2shConsequences" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_P2shConsequences> ;
    skos:definition "This group draws together what P2SH changes for the people and the nodes that use it."@en .

pg:S_P2shMechanism a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hashing the script"@en ;
    sen0401:anchor "#P2shMechanism" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_P2shMechanism> ;
    skos:definition "This group describes how a script becomes a hash and how the hash becomes an address and then a script again."@en .

pg:S_P2shRules a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "P2SH validation rules"@en ;
    sen0401:anchor "#P2shRules" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_P2shRules> ;
    skos:definition "The validation rules of P2SH say that the input script may only push data, that the redeem script is run exactly once, with no further P2SH inside, and that the signature checks it hides are counted."@en .

pg:S_P2wpkh a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Pay to witness public key hash"@en ;
    sen0401:anchor "#P2wpkh" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_P2wpkh> ;
    skos:definition "A P2WPKH output holds a version 0 and the 20-byte hash of a compressed public key; it is spent by a witness of exactly two items, a signature and the public key, and an empty input script."@en .

pg:S_P2wsh a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Pay to witness script hash"@en ;
    sen0401:anchor "#P2wsh" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_P2wsh> ;
    skos:definition "A P2WSH output holds a version 0 and the 32-byte SHA-256 of a script; it is spent by a witness whose last item is that script and whose other items are its input."@en .

pg:S_PayToContract a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Pay to contract"@en ;
    sen0401:anchor "#PayToContract" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_PayToContract> ;
    skos:definition "Pay to contract is a key tweak that commits to an agreed description: the payer adds the hash of the description, as a number, to the public key of the payee, and the payee spends with the private key plus the same number."@en .

pg:S_PayToKey a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "From a public key to its hash"@en ;
    sen0401:anchor "#PayToKey" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_PayToKey> ;
    skos:definition "This group covers the three ways an output has been locked to a single key."@en .

pg:S_PayToPublicKey a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Pay to public key"@en ;
    sen0401:anchor "#PayToPublicKey" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_PayToPublicKey> ;
    skos:definition "A pay to public key output holds the public key itself followed by the signature operator, so that it is spent by a signature that the key can verify; it is the form in which Bitcoin was first described and used."@en .

pg:S_PayToPublicKeyHash a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Pay to public key hash"@en ;
    sen0401:anchor "#PayToPublicKeyHash" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_PayToPublicKeyHash> ;
    skos:definition "A pay to public key hash output script contains a hash that commits to a public key, and it is spent by presenting a public key that matches the hash together with a signature made by the corresponding private key."@en .

pg:S_PayToScriptHash a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Pay to script hash"@en ;
    sen0401:anchor "#PayToScriptHash" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch07#S_PayToScriptHash> ;
    skos:definition "This branch is about the output type that lets a payer lock coins to the fingerprint of a script instead of to the script itself."@en .

pg:S_PayToScriptHashOutput a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Pay to script hash output"@en ;
    sen0401:anchor "#PayToScriptHashOutput" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_PayToScriptHashOutput> ;
    skos:definition "A pay to script hash output script holds only the 20-byte HASH160 of a script, so that whoever spends it must present a script that hashes to the same value and then satisfy that script."@en .

pg:S_PublicKeyHash a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Public key hash"@en ;
    sen0401:anchor "#PublicKeyHash" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_PublicKeyHash> ;
    skos:definition "A public key hash is the 20-byte digest obtained by applying SHA-256 and then RIPEMD-160 to a public key; the legacy address that begins with a 1 is its Base58Check encoding."@en .

pg:S_RedeemScript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Redeem script"@en ;
    sen0401:anchor "#RedeemScript" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_RedeemScript> ;
    skos:definition "The redeem script is the script whose hash is committed to in a pay to script hash output; it is revealed as the last item of the input script when the output is spent and is then executed with the items that precede it."@en .

pg:S_RelativeTimelock a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Relative timelock (sequence)"@en ;
    sen0401:anchor "#RelativeTimelock" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_RelativeTimelock> ;
    skos:definition "A relative timelock is encoded in the sequence field of an input: if bit 31 is clear, the low 16 bits are a number of blocks, or of 512-second units when bit 22 is set, that the spent output must have aged before the input is valid."@en .

pg:S_RelativeTimelocks a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Relative timelocks"@en ;
    sen0401:anchor "#RelativeTimelocks" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_RelativeTimelocks> ;
    skos:definition "This group is about conditions that count time from the moment an output was confirmed."@en .

pg:S_Script a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Script"@en ;
    sen0401:anchor "#Script" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_Script> ;
    skos:definition "Script is the Forth-like, stack-based language in which the conditions for spending an output, and the proof that the conditions are met, are written."@en .

pg:S_ScriptExecution a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Locking and running a script"@en ;
    sen0401:anchor "#ScriptExecution" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ScriptExecution> ;
    skos:definition "This group follows a single spend from the two halves of its condition to its verdict."@en .

pg:S_ScriptLanguage a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction scripts and the Script language"@en ;
    sen0401:anchor "#ScriptLanguage" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ScriptLanguage> ;
    skos:definition "This branch opens the chapter's central idea."@en .

pg:S_ScriptLimits a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Consensus limits of a script"@en ;
    sen0401:anchor "#ScriptLimits" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ScriptLimits> ;
    skos:definition "Bitcoin Core bounds a script by its size, its number of non-push operations, the size of any item it pushes, the depth of its stack and the number of keys one multisignature operator accepts."@en .

pg:S_ScriptModel a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The language and its limits"@en ;
    sen0401:anchor "#ScriptModel" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ScriptModel> ;
    skos:definition "This group describes the language itself before any payment pattern is built from it."@en .

pg:S_ScriptPathSpending a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Script path spending"@en ;
    sen0401:anchor "#ScriptPathSpending" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ScriptPathSpending> ;
    skos:definition "Spending a taproot output by the script path reveals one script of the committed tree, the control block that connects the script to the output key, and the items that satisfy the script; no other script of the tree is shown."@en .

pg:S_ScriptTrees a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Trees of alternative scripts"@en ;
    sen0401:anchor "#ScriptTrees" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ScriptTrees> ;
    skos:definition "This group is about committing to many scripts with one hash."@en .

pg:S_ScriptTruth a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "When a script succeeds"@en ;
    sen0401:anchor "#ScriptTruth" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ScriptTruth> ;
    skos:definition "A script succeeds when it runs without error and leaves a non-zero value on top of the stack; zero, negative zero, an empty item and an empty stack are false."@en .

pg:S_ScriptedMultisig a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Scripted multisignatures"@en ;
    sen0401:anchor "#ScriptedMultisig" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ScriptedMultisig> ;
    skos:definition "This branch is about the first way Bitcoin lets several people share control of one output."@en .

pg:S_ScriptedMultisignature a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Scripted multisignature"@en ;
    sen0401:anchor "#ScriptedMultisignature" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ScriptedMultisignature> ;
    skos:definition "A scripted multisignature output lists k public keys and requires at least t valid signatures from them, given in the same order as the keys, before it can be spent."@en .

pg:S_ScriptlessMultisignature a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Scriptless multisignature"@en ;
    sen0401:anchor "#ScriptlessMultisignature" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ScriptlessMultisignature> ;
    skos:definition "A scriptless multisignature is a way for several participants to produce one public key and one signature that look exactly like those of a single signer; the script that would count the keys and signatures disappears."@en .

pg:S_SegwitAddress a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Segwit address (bech32)"@en ;
    sen0401:anchor "#SegwitAddress" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_SegwitAddress> ;
    skos:definition "A native segregated witness address writes the witness version and the program as a bech32 string with a human-readable part, a separator, 5-bit characters and a six-character checksum; version 0 uses bech32 and version 1 and later use bech32m."@en .

pg:S_SegwitScripts a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Segregated witness scripts"@en ;
    sen0401:anchor "#SegwitScripts" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch07#S_SegwitScripts> ;
    skos:definition "This branch is about the outputs that came with segregated witness, the upgrade of 2017 that moved the proofs of authorization out of the part of a transaction that identifies it."@en .

pg:S_SegwitUpgrade a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Upgrading to segregated witness"@en ;
    sen0401:anchor "#SegwitUpgrade" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_SegwitUpgrade> ;
    skos:definition "This group explains how a system with millions of users changed its rules without stopping."@en .

pg:S_SeparateExecution a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Separate execution of the two scripts"@en ;
    sen0401:anchor "#SeparateExecution" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_SeparateExecution> ;
    skos:definition "Since 2010 the input script and the output script are executed one after the other, with the stack that the first leaves transferred to the second, instead of being joined into a single script."@en .

pg:S_SignatureCheckCount a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Signature check count"@en ;
    sen0401:anchor "#SignatureCheckCount" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_SignatureCheckCount> ;
    skos:definition "The opcode compares signatures with keys one by one, and a signature that matches a key that is far from the top of the stack is found only after many failed attempts, so that the number of checks can be as large as the number of keys."@en .

pg:S_SignatureChecking a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Checking a signature"@en ;
    sen0401:anchor "#SignatureChecking" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_SignatureChecking> ;
    skos:definition "This group opens the signature operator."@en .

pg:S_SignatureEncoding a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Signature encoding (DER)"@en ;
    sen0401:anchor "#SignatureEncoding" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_SignatureEncoding> ;
    skos:definition "An ECDSA signature is the pair of integers r and s written in DER, the Distinguished Encoding Rules, followed by one hash-type byte; Bitcoin requires the strict form of DER and policy requires the lower of the two possible values of s."@en .

pg:S_SignatureHash a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The signature hash and its hash types"@en ;
    sen0401:anchor "#SignatureHash" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_SignatureHash> ;
    skos:definition "The signature hash, or commitment hash, is the digest of a modified copy of the transaction plus the hash type, and the hash type, one byte appended to the signature, says which parts of the transaction the signature commits to."@en .

pg:S_StackExecution a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The script execution stack"@en ;
    sen0401:anchor "#StackExecution" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_StackExecution> ;
    skos:definition "A stack is a pile of items with two basic operations, push and pop, and the script engine reads a script from left to right, pushing data and letting each operator pop its inputs and push its result."@en .

pg:S_StatelessVerification a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Stateless verification"@en ;
    sen0401:anchor "#StatelessVerification" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_StatelessVerification> ;
    skos:definition "Script verification is stateless: there is no state before a script runs and none saved afterward, so a script runs the same way on any system."@en .

pg:S_Taproot a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Taproot output"@en ;
    sen0401:anchor "#Taproot" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_Taproot> ;
    skos:definition "A taproot output is a witness program of version 1 whose program is the 32-byte x coordinate of a point Q, computed as the internal key P plus the tagged hash of P and the root of a script tree, times the generator point; paying to Q is also a commitment to the scripts."@en .

pg:S_TaprootBranch a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Taproot and tapscript"@en ;
    sen0401:anchor "#TaprootBranch" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch07#S_TaprootBranch> ;
    skos:definition "This branch presents the last upgrade of the chapter."@en .

pg:S_TaprootOutputs a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Taproot outputs"@en ;
    sen0401:anchor "#TaprootOutputs" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_TaprootOutputs> ;
    skos:definition "This group is about the output itself and the two ways to spend it."@en .

pg:S_Tapscript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Tapscript"@en ;
    sen0401:anchor "#Tapscript" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_Tapscript> ;
    skos:definition "This group is about the version of the script language that the leaves of a taproot tree use."@en .

pg:S_TapscriptChanges a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Changes in tapscript"@en ;
    sen0401:anchor "#TapscriptChanges" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_TapscriptChanges> ;
    skos:definition "Tapscript disables the old multisignature opcodes, makes every signature check use BIP340 Schnorr signatures, requires a signature that is not expected to succeed to be the empty value, and makes the MINIMALIF rule part of the consensus."@en .

pg:S_ThresholdSignature a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Threshold signature"@en ;
    sen0401:anchor "#ThresholdSignature" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_ThresholdSignature> ;
    skos:definition "A threshold signature lets any t of k participants sign; because the result is an ordinary signature, it does not show which of them signed, which is good for privacy and bad for accountability."@en .

pg:S_TreesAndTweaks a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Script trees and key tweaks"@en ;
    sen0401:anchor "#TreesAndTweaks" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch07#S_TreesAndTweaks> ;
    skos:definition "This branch presents the three ideas that taproot, the last upgrade of the chapter, combines."@en .

pg:S_TuringIncompleteness a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Turing incompleteness"@en ;
    sen0401:anchor "#TuringIncompleteness" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_TuringIncompleteness> ;
    skos:definition "Script is deliberately not Turing complete: it has no loops and no flow control but conditionals, so every script ends and its running time is predictable."@en .

pg:S_VerifyGuard a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "VERIFY guard clause"@en ;
    sen0401:anchor "#VerifyGuard" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_VerifyGuard> ;
    skos:definition "An opcode with the suffix VERIFY ends the script with failure unless its result is true, and otherwise continues; it acts as a guard clause that attaches one precondition without offering a second path."@en .

pg:S_WitnessProgram a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Witness program"@en ;
    sen0401:anchor "#WitnessProgram" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_WitnessProgram> ;
    skos:definition "A witness program is an output script made of a version byte (OP_0, or OP_1 to OP_16) followed by one push of 2 to 40 bytes; the version and the length of the program decide how the output is spent."@en .

pg:S_WitnessPrograms a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Witness programs and addresses"@en ;
    sen0401:anchor "#WitnessPrograms" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch07#S_WitnessPrograms> ;
    skos:definition "This group defines the new kind of output and shows its three faces: the output script, the witness that spends it, and the address that carries it."@en .

pg:S_WitnessSighash a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Witness signature hash"@en ;
    sen0401:anchor "#WitnessSighash" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch07#S_WitnessSighash> ;
    skos:definition "BIP143 defines the signature hash for version-0 witness programs: it hashes the parts of the transaction in a fixed order with the value of the output being spent, and it reuses three hashes for all inputs, so that the work grows with the size of the transaction and not with its square."@en .

pg:CO4 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Analyse how segregated witness changes authorization - witness programs, P2WPKH and P2WSH, bech32 addresses, nested forms, the BIP143 signature hash - and why it can be deployed as a soft fork"@en ;
    ld:bloomLevel ld:Analyze ;
    dcterms:source <http://example.org/sen0401/ch07/document> ;
    skos:definition "After this chapter the learner can analyse how segregated witness changes authorization - witness programs, P2WPKH and P2WSH, bech32 addresses, nested forms, the BIP143 signature hash - and why it can be deployed as a soft fork."@en .

pg:CO6 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Check the chapter's figures and statements against the BIPs, Bitcoin Core's sources and tests and real chain data, and say where each differs and what the difference changes"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch07/document> ;
    skos:definition "After this chapter the learner can check the chapter's figures and statements against the BIPs, Bitcoin Core's sources and tests and real chain data, and say where each differs and what the difference changes."@en .

pg:CO1 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Run input and output scripts on a stack by hand and with a standard-library interpreter - pay to public key hash, the truth rule and separate execution - and say why Script is stateless and not Turing complete"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch07/document> ;
    skos:definition "After this chapter the learner can run input and output scripts on a stack by hand and with a standard-library interpreter - pay to public key hash, the truth rule and separate execution - and say why Script is stateless and not Turing complete."@en .

pg:CO2 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Build and check scripted multisignatures and pay to script hash outputs: compute a redeem script, its hash and its address, count the signature checks and the bytes, and explain the dummy element and the limits on keys"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch07/document> ;
    skos:definition "After this chapter the learner can build and check scripted multisignatures and pay to script hash outputs: compute a redeem script, its hash and its address, count the signature checks and the bytes, and explain the dummy element and the limits on keys."@en .

pg:CO3 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Decide when an output with a lock time, OP_CHECKLOCKTIMEVERIFY, a relative sequence, OP_CHECKSEQUENCEVERIFY or a flow-control script can first be spent, and which path of a multi-path script a given input script selects"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch07/document> ;
    skos:definition "After this chapter the learner can decide when an output with a lock time, OP_CHECKLOCKTIMEVERIFY, a relative sequence, OP_CHECKSEQUENCEVERIFY or a flow-control script can first be spent, and which path of a multi-path script a given input script selects."@en .

pg:CO5 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Analyse taproot and tapscript: the key tweak and the script tree, key path against script path, the control block, OP_CHECKSIGADD and the OP_SUCCESS opcodes, and what each spend reveals on the chain"@en ;
    ld:bloomLevel ld:Analyze ;
    dcterms:source <http://example.org/sen0401/ch07/document> ;
    skos:definition "After this chapter the learner can analyse taproot and tapscript: the key tweak and the script tree, key path against script path, the control block, OP_CHECKSIGADD and the OP_SUCCESS opcodes, and what each spend reveals on the chain."@en .

