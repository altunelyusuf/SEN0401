    skos:definition "This page teaches chapter 7 of the course book as an interactive surface with 83 sections in a three-level outline, 89 widgets that the browser test exercised, and a quiz of 10 questions."@en .

pg:Q1 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "What does a full node check when it validates the spend of a pay to public key hash output?"@en ;
    ld:assessesObjective pg:CO1 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "Each signature commits to the spending transaction, so it cannot repeat.",
        "The two scripts are different programs: one supplies data and the other states a condition." ;
    ld:hasCorrectOption pg:Q1_O0 ;
    ld:hasOption pg:Q1_O0,
        pg:Q1_O1,
        pg:Q1_O2 .

pg:Q10 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "The chapter gives 7,760,000 seconds for three months. What is the exact figure for 90 days?"@en ;
    ld:assessesObjective pg:CO6 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "90 days of 86,400 seconds are 7,776,000; 7,200,000 is about 83.3 days.",
        "That would be 91 days." ;
    ld:hasCorrectOption pg:Q10_O0 ;
    ld:hasOption pg:Q10_O0,
        pg:Q10_O1,
        pg:Q10_O2 .

pg:Q2 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "The input script of a spend is 1 OP_RETURN. In today's software, what happens?"@en ;
    ld:assessesObjective pg:CO1 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "That was the behaviour of the first release and the bug CVE-2010-5141; the scripts are now run separately and OP_RETURN fails.",
        "The input script is evaluated first and a failure there ends the validation." ;
    ld:hasCorrectOption pg:Q2_O1 ;
    ld:hasOption pg:Q2_O0,
        pg:Q2_O1,
        pg:Q2_O2 .

pg:Q3 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "A 2-of-3 multisignature script with compressed keys is 105 bytes. How long is a 2-of-5 script?"@en ;
    ld:assessesObjective pg:CO2 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "Doubling the keys does not double the fixed bytes: the script is 34 per key plus 3.",
        "Each key adds 34 bytes, but the three fixed bytes are counted only once: 175 is 5 times 35." ;
    ld:hasCorrectOption pg:Q3_O1 ;
    ld:hasOption pg:Q3_O0,
        pg:Q3_O1,
        pg:Q3_O2 .

pg:Q4 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Why can a redeem script be as long as 520 bytes but a 16-key multisignature not be used in a script hash output?"@en ;
    ld:assessesObjective pg:CO2 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "Compressed keys are what make 15 keys fit.",
        "The limit of 20 keys applies to the opcode; the limit of 15 comes from the size of the push." ;
    ld:hasCorrectOption pg:Q4_O0 ;
    ld:hasOption pg:Q4_O0,
        pg:Q4_O1,
        pg:Q4_O2 .

pg:Q5 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "An input sequence is 0x00400008 in a version 2 transaction. What lock does it set?"@en ;
    ld:assessesObjective pg:CO3 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "Bit 22 is set, which selects units of 512 seconds.",
        "The disable flag is bit 31, which is clear in this value." ;
    ld:hasCorrectOption pg:Q5_O1 ;
    ld:hasOption pg:Q5_O0,
        pg:Q5_O1,
        pg:Q5_O2 .

pg:Q6 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Which statement about OP_CHECKLOCKTIMEVERIFY in a script is correct?"@en ;
    ld:assessesObjective pg:CO3 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "It reads the lock time of the spending transaction; the spender sets it.",
        "Nodes validate at once; a spend that is too early is simply invalid for now." ;
    ld:hasCorrectOption pg:Q6_O1 ;
    ld:hasOption pg:Q6_O0,
        pg:Q6_O1,
        pg:Q6_O2 .

pg:Q7 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Why can segregated witness be deployed as a soft fork?"@en ;
    ld:assessesObjective pg:CO4 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "The point of the change is to leave the witness out of the identifier.",
        "Upgrades cannot be assumed to be simultaneous; the design lets old nodes follow the chain." ;
    ld:hasCorrectOption pg:Q7_O0 ;
    ld:hasOption pg:Q7_O0,
        pg:Q7_O1,
        pg:Q7_O2 .

pg:Q8 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "A taproot output is spent with a witness of one element of 64 bytes. Which spend is it?"@en ;
    ld:assessesObjective pg:CO5 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "A script path witness has at least two elements: the script and the control block.",
        "A signature of 64 bytes implies the default hash type; 65 bytes carry the type byte." ;
    ld:hasCorrectOption pg:Q8_O1 ;
    ld:hasOption pg:Q8_O0,
        pg:Q8_O1,
        pg:Q8_O2 .

pg:Q9 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "The block 775,072 inscription spend has a control block of 33 bytes. How many levels deep is its leaf?"@en ;
    ld:assessesObjective pg:CO5 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "A control block of 33 bytes plus 32 for each level would be 65 bytes at depth 1.",
        "The 33 bytes are the fixed part, not a depth." ;
    ld:hasCorrectOption pg:Q9_O0 ;
    ld:hasOption pg:Q9_O0,
        pg:Q9_O1,
        pg:Q9_O2 .

