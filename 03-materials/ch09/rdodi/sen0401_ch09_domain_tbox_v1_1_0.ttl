#################################################################
# Connectedness repair (discipline v2.19.0, BP-D56 and BP-D57), 2026-10-19.
# The datatype properties the A-Box uses and nothing declared, then the relations
# between the chapter's subject branches that the chapter's own sources state.
#################################################################
chx:input a owl:DatatypeProperty ; rdfs:label "input expression"@en ; rdfs:comment "The expression an input/output example evaluates."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:output a owl:DatatypeProperty ; rdfs:label "output value"@en ; rdfs:comment "The value that evaluating the example expression gives."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:isPackagedAs a owl:ObjectProperty ; rdfs:label "is part of the package"@en ;
    rdfs:comment "A receiver who pays for a parent in a child transaction makes a package that is mined together. Basis: the chapter says of Fee paid in another transaction: 'the parent paid 141 satoshis, its child 14,100, and the node mined both together in one block'; the chapter says of Package fee rate: 'A parent paying 141 satoshis and a child paying 14,100 form a package of 14,241 satoshis'."@en ;
    rdfs:domain chx:FeePaidInAnotherTransaction ; rdfs:range chx:PackageFeeRate ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:guardsAgainstForgottenChange a owl:ObjectProperty ; rdfs:label "refuses"@en ;
    rdfs:comment "The absurd-fee guard of sendrawtransaction refused the transaction that forgot its change. Basis: the chapter says of Absurd fee guard: 'the forgotten-change transaction paid 17,272,727 satoshis per virtual byte and was refused'; the chapter says of Forgotten change becomes fee: 'The node refuses the transaction that forgot its change with the reason max-fee-exceeded'."@en ;
    rdfs:domain chx:AbsurdFeeGuard ; rdfs:range chx:ForgottenChangeBecomesFee ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:ranksByFeeRate a owl:ObjectProperty ; rdfs:label "ranks by"@en ;
    rdfs:comment "A node's block template lists transactions from the highest fee rate to the lowest. Basis: the chapter says of A fee is a bid: 'listed them from the highest fee rate'; the chapter says of Fee rate definition: 'The fee rate is the fee divided by the size'."@en ;
    rdfs:domain chx:FeeIsABid ; rdfs:range chx:FeeRateDefinition ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:extendsRankingByAncestors a owl:ObjectProperty ; rdfs:label "extends the ranking of"@en ;
    rdfs:comment "Miners rank transactions together with their unconfirmed ancestors. Basis: the chapter says of Ancestor feerate mining: 'miners rank transactions with their unconfirmed ancestors'; the chapter says of A fee is a bid: 'listed them from the highest fee rate'."@en ;
    rdfs:domain chx:AncestorFeerateMining ; rdfs:range chx:FeeIsABid ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:usesSubsidyOfEra a owl:ObjectProperty ; rdfs:label "uses the subsidy of"@en ;
    rdfs:comment "The reward of block 840,000 equals the subsidy of 312,500,000 satoshis plus the fees. Basis: the chapter says of Coinbase is excluded: 'equals the subsidy of 312,500,000'; the chapter says of Subsidy halvings: '312,500,000 from it'."@en ;
    rdfs:domain chx:CoinbaseIsExcluded ; rdfs:range chx:SubsidyHalvings ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:answersEstimateSmartFee a owl:ObjectProperty ; rdfs:label "converts the answer of"@en ;
    rdfs:comment "The estimatesmartfee answer in bitcoin per kilo-virtual-byte is a fee rate in satoshis per virtual byte. Basis: the chapter says of Units of fee rate: 'estimatesmartfee answer 0.00006570 bitcoin per kilo-virtual-byte is exactly 6.57 satoshis per virtual byte'; the chapter says of The estimatesmartfee call: 'it answered 1.225 satoshis per virtual byte for 2 blocks'."@en ;
    rdfs:domain chx:UnitsOfFeeRate ; rdfs:range chx:EstimateSmartFeeCall ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:isCensusedWithSignals a owl:ObjectProperty ; rdfs:label "is counted in the same sample as"@en ;
    rdfs:comment "Both censuses of block 840,000 count the first 599 transactions after the coinbase. Basis: the chapter says of Signal in the wild: 'In the first 599 transactions after the coinbase'; the chapter says of Block fee census: 'Of the first 599 transactions after the coinbase'."@en ;
    rdfs:domain chx:SignalInTheWild ; rdfs:range chx:BlockFeeCensus ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:isCensusedWithLockTimes a owl:ObjectProperty ; rdfs:label "is counted in the same sample as"@en ;
    rdfs:comment "Both censuses of block 840,000 count the first 599 transactions. Basis: the chapter says of Share of mainnet transactions with the previous height: 'of the first 599 transactions of block 840,000'; the chapter says of Block fee census: 'Of the first 599 transactions after the coinbase'."@en ;
    rdfs:domain chx:MainnetPrevHeightShare ; rdfs:range chx:BlockFeeCensus ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:boundsLargeChildPin a owl:ObjectProperty ; rdfs:label "bounds"@en ;
    rdfs:comment "TRUC limits the cost of replacing against a large child pin. Basis: the chapter says of TRUC pinning bound: '88 times less than the 450,780 of the unrestricted pin'; the chapter says of Large child pin: 'in the run a 90,012-byte child raised the price of replacing'."@en ;
    rdfs:domain chx:TrucPinningBound ; rdfs:range chx:LargeChildPin ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:failsMinimumRelay a owl:ObjectProperty ; rdfs:label "was refused for"@en ;
    rdfs:comment "A parent paying below the minimum relay fee was refused alone. Basis: the chapter says of The minimum relay problem: 'was refused alone with min relay fee not met'; the chapter says of Minimum relay fee: 'the node refused 8 and 14 with min relay fee not met, and accepted 15'."@en ;
    rdfs:domain chx:MinimumRelayProblem ; rdfs:range chx:MinRelayFee ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:appliesFeeRate a owl:ObjectProperty ; rdfs:label "is a fee rate by"@en ;
    rdfs:comment "A package fee rate is the fee of the package divided by its size. Basis: the chapter says of Package fee rate: 'form a package of 14,241 satoshis over 280.5 virtual bytes'; the chapter says of Fee rate definition: 'The fee rate is the fee divided by the size'."@en ;
    rdfs:domain chx:PackageFeeRate ; rdfs:range chx:FeeRateDefinition ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:replacesDescendantLimits a owl:ObjectProperty ; rdfs:label "was removed because of"@en ;
    rdfs:comment "The carve-out was removed because the cluster limits took the place of the descendant limits it worked around. Basis: the chapter says of Carve out removed: 'because the cluster limits replaced the descendant limits it worked around'."@en ;
    rdfs:domain chx:CarveOutRemoved ; rdfs:range chx:ClusterLimits ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:exceedsAncestorLimits a owl:ObjectProperty ; rdfs:label "goes beyond"@en ;
    rdfs:comment "The carve-out admitted one extra child beyond the 25-descendant and 101,000-byte limits that release 31.0 removed. Basis: the chapter says of Carve out rule: 'beyond the 25-descendant and 101,000-byte limits'; the chapter says of Removed ancestor limits: 'The old limits of 25 ancestors or descendants and 101,000 virtual bytes are gone in release 31.0'."@en ;
    rdfs:domain chx:CarveOutRule ; rdfs:range chx:RemovedAncestorLimits ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:letsParentPayNothing a owl:ObjectProperty ; rdfs:label "lets the parent pay nothing in"@en ;
    rdfs:comment "A zero-fee parent with ephemeral dust is accepted only together with its child. Basis: the chapter says of Ephemeral dust: 'the zero-fee parent was refused alone and mined with its child'; the chapter says of One parent one child: 'lets the parent of such a one-parent-one-child package pay nothing'."@en ;
    rdfs:domain chx:EphemeralDust ; rdfs:range chx:OneParentOneChild ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:bumpsByChildPaysForParent a owl:ObjectProperty ; rdfs:label "lets a side fee bump by"@en ;
    rdfs:comment "Lightning anchor outputs let either side fee bump by child pays for parent. Basis: the chapter says of Lightning anchor outputs: 'so either side can fee bump by child pays for parent'."@en ;
    rdfs:domain chx:LightningAnchorOutputs ; rdfs:range chx:ChildPaysForParent ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
chx:sizesDustOfAnchor a owl:ObjectProperty ; rdfs:label "has a dust threshold for"@en ;
    rdfs:comment "The dust threshold for pay-to-anchor is 240 satoshis. Basis: the chapter says of Dust threshold: '294 satoshis for P2WPKH, 330 for P2WSH and 240 for pay-to-anchor'; the chapter says of Pay to anchor (P2A): 'anyone can spend it'."@en ;
    rdfs:domain chx:DustThreshold ; rdfs:range chx:PayToAnchor ; rdfs:isDefinedBy <http://example.org/sen0401/ch09/tbox> .
