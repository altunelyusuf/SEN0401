chx:X_FeeIsInputsMinusOutputs a owl:NamedIndividual, chx:FeeIsInputsMinusOutputs ; rdfs:label "20 BTC in, 1 BTC out"@en ; skos:definition "A transaction of one 20-bitcoin input and one 1-bitcoin output leaves 19 bitcoins (1,900,000,000 satoshis) unspent, and the node lists exactly that as the fee of the transaction in its mempool."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_FeeIsInputsMinusOutputs a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); t = L.parse_tx(R['fee_arith']['tx']['hex']); out = sum(o['value'] for o in t['vout']); (round(R['fee_arith']['inputs_btc'] * 10 ** 8 - out), round(R['fee_arith']['mempoolentry_fees']['base'] * 10 ** 8), len(t['vin']), len(t['vout'])) evaluates to (1900000000, 1900000000, 1, 1)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); t = L.parse_tx(R['fee_arith']['tx']['hex']); out = sum(o['value'] for o in t['vout']); (round(R['fee_arith']['inputs_btc'] * 10 ** 8 - out), round(R['fee_arith']['mempoolentry_fees']['base'] * 10 ** 8), len(t['vin']), len(t['vout']))" ; chx:output "(1900000000, 1900000000, 1, 1)" .
chx:X_FeeIsInputsMinusOutputs rd:hasIOExample chx:IO_FeeIsInputsMinusOutputs .
chx:X_ForgottenChangeBecomesFee a owl:NamedIndividual, chx:ForgottenChangeBecomesFee ; rdfs:label "no change output on a 20 BTC input"@en ; skos:definition "The node refuses the transaction that forgot its change with the reason max-fee-exceeded, and when the sender forces it through, the miner's coinbase pays out the subsidy plus the 19 bitcoins."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_ForgottenChangeBecomesFee a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = R['fee_arith']; (a['testmempoolaccept']['reject-reason'], 'maxfeerate' in a['sendrawtransaction_default']['error'], a['coinbase_out_sat'], a['coinbase_out_sat'] == a['blockstats']['subsidy'] + a['blockstats']['totalfee']) evaluates to ('max-fee-exceeded', True, 4400000000, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = R['fee_arith']; (a['testmempoolaccept']['reject-reason'], 'maxfeerate' in a['sendrawtransaction_default']['error'], a['coinbase_out_sat'], a['coinbase_out_sat'] == a['blockstats']['subsidy'] + a['blockstats']['totalfee'])" ; chx:output "('max-fee-exceeded', True, 4400000000, True)" .
chx:X_ForgottenChangeBecomesFee rd:hasIOExample chx:IO_ForgottenChangeBecomesFee .
chx:X_NoFeeFieldInTransaction a owl:NamedIndividual, chx:NoFeeFieldInTransaction ; rdfs:label "the fields of a parsed transaction"@en ; skos:definition "Parsing the raw bytes of a transaction with an independent parser gives version, inputs, outputs, witness and lock time and no field called fee: the fee exists only as a difference."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_NoFeeFieldInTransaction a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); t = L.parse_tx(R['fee_arith']['tx']['hex']); ('fee' in t, sorted(k for k in t if k in ('version', 'vin', 'vout', 'locktime')), t['txid'] == R['fee_arith']['tx']['txid']) evaluates to (False, ['locktime', 'version', 'vin', 'vout'], True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); t = L.parse_tx(R['fee_arith']['tx']['hex']); ('fee' in t, sorted(k for k in t if k in ('version', 'vin', 'vout', 'locktime')), t['txid'] == R['fee_arith']['tx']['txid'])" ; chx:output "(False, ['locktime', 'version', 'vin', 'vout'], True)" .
chx:X_NoFeeFieldInTransaction rd:hasIOExample chx:IO_NoFeeFieldInTransaction .
chx:X_FeeNeedsSpendersSignature a owl:NamedIndividual, chx:FeeNeedsSpendersSignature ; rdfs:label "an output lowered by 5,000 satoshis after signing"@en ; skos:definition "A signed transaction is accepted by the node; the same transaction with its first output lowered by 5,000 satoshis (a larger fee) is refused because the signature no longer matches."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_FeeNeedsSpendersSignature a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); x = R2['tamper']; (x['original']['allowed'], x['tampered']['allowed'], x['tampered']['reject-reason'][:36], x['output0_original_sat'] - x['output0_tampered_sat']) evaluates to (True, False, 'mempool-script-verify-flag-failed (S', 5000)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); x = R2['tamper']; (x['original']['allowed'], x['tampered']['allowed'], x['tampered']['reject-reason'][:36], x['output0_original_sat'] - x['output0_tampered_sat'])" ; chx:output "(True, False, 'mempool-script-verify-flag-failed (S', 5000)" .
chx:X_FeeNeedsSpendersSignature rd:hasIOExample chx:IO_FeeNeedsSpendersSignature .
chx:X_FeePaidInAnotherTransaction a owl:NamedIndividual, chx:FeePaidInAnotherTransaction ; rdfs:label "a parent that pays 141 satoshis and a child that pays 14,100"@en ; skos:definition "The receiver of an output can pay for the parent in a different transaction: the parent paid 141 satoshis, its child 14,100, and the node mined both together in one block."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_FeePaidInAnotherTransaction a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = R['ancestor_mining']['cpfp_wins']; (a['fees_sat']['P'], a['fees_sat']['C'], a['fees_sat']['P'] + a['fees_sat']['C'], a['P']['txid'] in a['block_txids'], a['C']['txid'] in a['block_txids']) evaluates to (141, 14100, 14241, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = R['ancestor_mining']['cpfp_wins']; (a['fees_sat']['P'], a['fees_sat']['C'], a['fees_sat']['P'] + a['fees_sat']['C'], a['P']['txid'] in a['block_txids'], a['C']['txid'] in a['block_txids'])" ; chx:output "(141, 14100, 14241, True, True)" .
chx:X_FeePaidInAnotherTransaction rd:hasIOExample chx:IO_FeePaidInAnotherTransaction .
chx:X_FeeIsABid a owl:NamedIndividual, chx:FeeIsABid ; rdfs:label "ten transactions sorted by the node"@en ; skos:definition "Ten transactions of one size and ten different fees were offered to a node and its block template listed them from the highest fee rate (50 satoshis per virtual byte) to the lowest (1 satoshi per virtual byte)."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_FeeIsABid a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); o = R2['template_order']; f = o['template_fees']; w = o['template_weights']; rates = [f[t] / -(-w[t] // 4) for t in o['template_order']]; (len(rates), rates == sorted(rates, reverse=True), round(rates[0], 2), round(rates[-1], 2)) evaluates to (10, True, 50.0, 1.0)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); o = R2['template_order']; f = o['template_fees']; w = o['template_weights']; rates = [f[t] / -(-w[t] // 4) for t in o['template_order']]; (len(rates), rates == sorted(rates, reverse=True), round(rates[0], 2), round(rates[-1], 2))" ; chx:output "(10, True, 50.0, 1.0)" .
chx:X_FeeIsABid rd:hasIOExample chx:IO_FeeIsABid .
chx:X_CoinbaseIsExcluded a owl:NamedIndividual, chx:CoinbaseIsExcluded ; rdfs:label "the first transaction of block 840,000"@en ; skos:definition "The first transaction of block 840,000 spends no earlier output (it is the coinbase), and the block's reward of 4,075,061,499 satoshis equals the subsidy of 312,500,000 plus the 3,762,561,499 satoshis of fees."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_CoinbaseIsExcluded a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); b = C['blocks']['840000']; e = b['extras']; (b['txs'][0]['vin'][0]['coinbase'], L.subsidy(840000), e['totalFees'], e['reward'], e['totalFees'] + L.subsidy(840000) == e['reward']) evaluates to (True, 312500000, 3762561499, 4075061499, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); b = C['blocks']['840000']; e = b['extras']; (b['txs'][0]['vin'][0]['coinbase'], L.subsidy(840000), e['totalFees'], e['reward'], e['totalFees'] + L.subsidy(840000) == e['reward'])" ; chx:output "(True, 312500000, 3762561499, 4075061499, True)" .
chx:X_CoinbaseIsExcluded rd:hasIOExample chx:IO_CoinbaseIsExcluded .
chx:X_WeightAndVirtualSize a owl:NamedIndividual, chx:WeightAndVirtualSize ; rdfs:label "a 222-byte transaction weighs 561 units"@en ; skos:definition "A one-input, two-output P2WPKH transaction has 113 bytes without witness and 222 with it, so its weight is 3 x 113 + 222 = 561 weight units and its virtual size is 561 / 4 rounded up, 141 virtual bytes, as the node says."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_WeightAndVirtualSize a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); x = R['rbf']['t1']; t = L.parse_tx(x['hex']); (t['base_size'], t['size'], t['weight'], t['vsize'], t['weight'] == x['weight'], t['vsize'] == x['vsize']) evaluates to (113, 222, 561, 141, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); x = R['rbf']['t1']; t = L.parse_tx(x['hex']); (t['base_size'], t['size'], t['weight'], t['vsize'], t['weight'] == x['weight'], t['vsize'] == x['vsize'])" ; chx:output "(113, 222, 561, 141, True, True)" .
chx:X_WeightAndVirtualSize rd:hasIOExample chx:IO_WeightAndVirtualSize .
chx:X_BlockWeightLimit a owl:NamedIndividual, chx:BlockWeightLimit ; rdfs:label "block 840,000 fills 99.83 percent of 4,000,000"@en ; skos:definition "A block may weigh at most 4,000,000 weight units (the constant MAX_BLOCK_WEIGHT); block 840,000 weighed 3,993,281, which is 998,321 virtual bytes and 99.83 percent of the limit."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_BlockWeightLimit a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); w = C['blocks']['840000']['weight']; (L.const('core_src_consensus_consensus.h', 'MAX_BLOCK_WEIGHT'), w, L.vsize_of_weight(w), round(w / 4000000 * 100, 2)) evaluates to ('4000000', 3993281, 998321, 99.83)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); w = C['blocks']['840000']['weight']; (L.const('core_src_consensus_consensus.h', 'MAX_BLOCK_WEIGHT'), w, L.vsize_of_weight(w), round(w / 4000000 * 100, 2))" ; chx:output "('4000000', 3993281, 998321, 99.83)" .
chx:X_BlockWeightLimit rd:hasIOExample chx:IO_BlockWeightLimit .
chx:X_FeeRateDefinition a owl:NamedIndividual, chx:FeeRateDefinition ; rdfs:label "282 satoshis over 141 virtual bytes"@en ; skos:definition "The fee rate is the fee divided by the size: 282 satoshis over 141 virtual bytes is 2.0 satoshis per virtual byte (0.5027 per weight unit), while the book's wording, size divided by weight, would give 0.2513, which is no price at all."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_FeeRateDefinition a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); x = R['rbf']['t1']; (x['fee_sat'] / x['vsize'], round(x['fee_sat'] / x['weight'], 4), round(x['vsize'] / x['weight'], 4)) evaluates to (2.0, 0.5027, 0.2513)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); x = R['rbf']['t1']; (x['fee_sat'] / x['vsize'], round(x['fee_sat'] / x['weight'], 4), round(x['vsize'] / x['weight'], 4))" ; chx:output "(2.0, 0.5027, 0.2513)" .
chx:X_FeeRateDefinition rd:hasIOExample chx:IO_FeeRateDefinition .
chx:X_UnitsOfFeeRate a owl:NamedIndividual, chx:UnitsOfFeeRate ; rdfs:label "0.00006570 BTC per kvB is 6.57 sat per vB"@en ; skos:definition "The book's estimatesmartfee answer 0.00006570 bitcoin per kilo-virtual-byte is exactly 6.57 satoshis per virtual byte, and the 31.1 node's own answer 0.00001225 is 1.225, and 1 bitcoin per kilo-virtual-byte would be 100,000 satoshis per virtual byte."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_UnitsOfFeeRate a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (float(L.btc_kvb_to_sat_vb('0.00006570')), float(L.btc_kvb_to_sat_vb('0.00001225')), float(L.btc_kvb_to_sat_vb('1'))) evaluates to (6.57, 1.225, 100000.0)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (float(L.btc_kvb_to_sat_vb('0.00006570')), float(L.btc_kvb_to_sat_vb('0.00001225')), float(L.btc_kvb_to_sat_vb('1')))" ; chx:output "(6.57, 1.225, 100000.0)" .
chx:X_UnitsOfFeeRate rd:hasIOExample chx:IO_UnitsOfFeeRate .
chx:X_WrongUnitFactor a owl:NamedIndividual, chx:WrongUnitFactor ; rdfs:label "fee_rate 10 sat/vB against feeRate 0.0001 BTC/kvB"@en ; skos:definition "The wallet accepts fee_rate in satoshis per virtual byte and feeRate in bitcoin per kilo-virtual-byte: 10 and 0.0001 give the identical fee of 1,410 satoshis, while the number 10 in the second field is refused."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_WrongUnitFactor a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); u = R['units']; (u['fee_rate_sat_vb_10']['ok']['fee'] == u['feeRate_btc_kvb_0.0001']['ok']['fee'], round(u['fee_rate_sat_vb_10']['ok']['fee'] * 10 ** 8), 'error' in u['feeRate_btc_kvb_10'], 10 ** 8 // 10 ** 3) evaluates to (True, 1410, True, 100000)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); u = R['units']; (u['fee_rate_sat_vb_10']['ok']['fee'] == u['feeRate_btc_kvb_0.0001']['ok']['fee'], round(u['fee_rate_sat_vb_10']['ok']['fee'] * 10 ** 8), 'error' in u['feeRate_btc_kvb_10'], 10 ** 8 // 10 ** 3)" ; chx:output "(True, 1410, True, 100000)" .
chx:X_WrongUnitFactor rd:hasIOExample chx:IO_WrongUnitFactor .
chx:X_AbsurdFeeGuard a owl:NamedIndividual, chx:AbsurdFeeGuard ; rdfs:label "19 BTC over 110 virtual bytes against the 10,000 sat/vB guard"@en ; skos:definition "The default guard of sendrawtransaction is COIN / 10 per kilo-virtual-byte, 10,000 satoshis per virtual byte; the forgotten-change transaction paid 17,272,727 satoshis per virtual byte and was refused."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_AbsurdFeeGuard a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = R['fee_arith']; rate = round(a['mempoolentry_fees']['base'] * 10 ** 8 / a['mempoolentry_vsize']); (10 ** 8 // 10 // 1000, rate, rate > 10 ** 8 // 10 // 1000, L.has('core_src_node_transaction.h', 'DEFAULT_MAX_RAW_TX_FEE_RATE{COIN / 10}')) evaluates to (10000, 17272727, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = R['fee_arith']; rate = round(a['mempoolentry_fees']['base'] * 10 ** 8 / a['mempoolentry_vsize']); (10 ** 8 // 10 // 1000, rate, rate > 10 ** 8 // 10 // 1000, L.has('core_src_node_transaction.h', 'DEFAULT_MAX_RAW_TX_FEE_RATE{COIN / 10}'))" ; chx:output "(10000, 17272727, True, True)" .
chx:X_AbsurdFeeGuard rd:hasIOExample chx:IO_AbsurdFeeGuard .
chx:X_MinRelayFee a owl:NamedIndividual, chx:MinRelayFee ; rdfs:label "8, 14 and 15 satoshis for 141 virtual bytes"@en ; skos:definition "At the default minimum relay fee of 0.1 satoshi per virtual byte a 141-byte transaction needs 15 satoshis: the node refused 8 and 14 with min relay fee not met, and accepted 15."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_MinRelayFee a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); m = R['minrelay']; [(k, m[k]['fee_sat'], m[k]['result']['ok'][0]['allowed']) for k in ('below_0.05', 'just_below', 'exact_0.1')] + [R2['mempool_min']['minrelaytxfee'] * 10 ** 8 / 1000] evaluates to [('below_0.05', 8, False), ('just_below', 14, False), ('exact_0.1', 15, True), 0.1]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); m = R['minrelay']; [(k, m[k]['fee_sat'], m[k]['result']['ok'][0]['allowed']) for k in ('below_0.05', 'just_below', 'exact_0.1')] + [R2['mempool_min']['minrelaytxfee'] * 10 ** 8 / 1000]" ; chx:output "[('below_0.05', 8, False), ('just_below', 14, False), ('exact_0.1', 15, True), 0.1]" .
chx:X_MinRelayFee rd:hasIOExample chx:IO_MinRelayFee .
chx:X_WalletMinimumFee a owl:NamedIndividual, chx:WalletMinimumFee ; rdfs:label "the wallet refuses 0.5 sat/vB that the node would relay"@en ; skos:definition "Bitcoin Core's wallet has its own minimum of 1 satoshi per virtual byte (DEFAULT_TRANSACTION_MINFEE of 1000 per kilo-virtual-byte), ten times the 0.1 that nodes relay, and refused 0.5 and 0.1 while accepting 1."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_WalletMinimumFee a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); w = R2['wallet_min']; (L.const('core_src_wallet_wallet.h', 'DEFAULT_TRANSACTION_MINFEE'), 'error' in w['fee_rate_0.5'], 'error' in w['fee_rate_0.1'], 'ok' in w['fee_rate_1'], R2['mempool_min']['minrelaytxfee'] * 10 ** 8 / 1000) evaluates to ('1000', True, True, True, 0.1)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); w = R2['wallet_min']; (L.const('core_src_wallet_wallet.h', 'DEFAULT_TRANSACTION_MINFEE'), 'error' in w['fee_rate_0.5'], 'error' in w['fee_rate_0.1'], 'ok' in w['fee_rate_1'], R2['mempool_min']['minrelaytxfee'] * 10 ** 8 / 1000)" ; chx:output "('1000', True, True, True, 0.1)" .
chx:X_WalletMinimumFee rd:hasIOExample chx:IO_WalletMinimumFee .
chx:X_DustThreshold a owl:NamedIndividual, chx:DustThreshold ; rdfs:label "294, 330 and 240 satoshis"@en ; skos:definition "An output is dust when it costs more to spend than it is worth at 3 satoshis per byte: 294 satoshis for P2WPKH, 330 for P2WSH and 240 for pay-to-anchor; the node refused 293, 329 and 239 and accepted 294, 330 and 240."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_DustThreshold a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); d = R2['dust']; ok = lambda k: d[k]['result']['allowed']; ((31 + 67) * 3, (43 + 67) * 3, (13 + 67) * 3, [ok(k) for k in ('p2wpkh_293', 'p2wpkh_294', 'p2wsh_329', 'p2wsh_330', 'p2a_239', 'p2a_240')], L.has('bolt03_transactions.md', 'pay to anchor (p2a): 240 satoshis')) evaluates to (294, 330, 240, [False, True, False, True, False, True], True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); d = R2['dust']; ok = lambda k: d[k]['result']['allowed']; ((31 + 67) * 3, (43 + 67) * 3, (13 + 67) * 3, [ok(k) for k in ('p2wpkh_293', 'p2wpkh_294', 'p2wsh_329', 'p2wsh_330', 'p2a_239', 'p2a_240')], L.has('bolt03_transactions.md', 'pay to anchor (p2a): 240 satoshis'))" ; chx:output "(294, 330, 240, [False, True, False, True, False, True], True)" .
chx:X_DustThreshold rd:hasIOExample chx:IO_DustThreshold .
chx:X_EstimateSmartFeeCall a owl:NamedIndividual, chx:EstimateSmartFeeCall ; rdfs:label "bitcoin-cli -named estimatesmartfee conf_target=144"@en ; skos:definition "A fresh node answers the book's call with Insufficient data or no feerate found; after 120 blocks and 2,640 payments of mixed fee rates it answered 1.225 satoshis per virtual byte for 2 blocks and 1.173 for 6 and 25."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_EstimateSmartFeeCall a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); E = R['estimate']['results']; g = lambda k: E[k]['ok']; (R['estimate_fresh']['ok']['errors'][0], R['estimate']['rounds'], R['estimate']['sent'], [round(g(k)['feerate'] * 10 ** 8 / 1000, 3) for k in ('2_default', '6_default', '25_default')]) evaluates to ('Insufficient data or no feerate found', 120, 2640, [1.225, 1.173, 1.173])"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); E = R['estimate']['results']; g = lambda k: E[k]['ok']; (R['estimate_fresh']['ok']['errors'][0], R['estimate']['rounds'], R['estimate']['sent'], [round(g(k)['feerate'] * 10 ** 8 / 1000, 3) for k in ('2_default', '6_default', '25_default')])" ; chx:output "('Insufficient data or no feerate found', 120, 2640, [1.225, 1.173, 1.173])" .
chx:X_EstimateSmartFeeCall rd:hasIOExample chx:IO_EstimateSmartFeeCall .
chx:X_ConfirmationTargetLimits a owl:NamedIndividual, chx:ConfirmationTargetLimits ; rdfs:label "a target of 144 answered for 60 blocks"@en ; skos:definition "The RPC accepts targets from 1 to 1008 blocks, but the estimator can only look back as far as its own history allows, so on a chain 231 blocks high the target 144 was answered with an estimate for 60 blocks."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_ConfirmationTargetLimits a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); E = R['estimate']['results']; (L.has('core_src_rpc_fees.cpp', 'Confirmation target in blocks (1 - 1008)'), E['144_default']['ok']['blocks'], R['estimate']['tip'], L.has('core_src_policy_fees_block_policy_estimator.cpp', 'MaxUsableEstimate')) evaluates to (True, 60, 231, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); E = R['estimate']['results']; (L.has('core_src_rpc_fees.cpp', 'Confirmation target in blocks (1 - 1008)'), E['144_default']['ok']['blocks'], R['estimate']['tip'], L.has('core_src_policy_fees_block_policy_estimator.cpp', 'MaxUsableEstimate'))" ; chx:output "(True, 60, 231, True)" .
chx:X_ConfirmationTargetLimits rd:hasIOExample chx:IO_ConfirmationTargetLimits .
chx:X_EstimatorThresholds a owl:NamedIndividual, chx:EstimatorThresholds ; rdfs:label "85 percent within the target"@en ; skos:definition "The estimator looks for the lowest fee rate at which more than 85 percent of the transactions were confirmed within the target (60 percent within half of it, 95 percent within double), constants of the source file."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_EstimatorThresholds a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); L.has('core_src_policy_fees_block_policy_estimator.h', 'static constexpr double SUCCESS_PCT = .85;', 'static constexpr double HALF_SUCCESS_PCT = .6;', 'static constexpr double DOUBLE_SUCCESS_PCT = .95;') evaluates to True"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); L.has('core_src_policy_fees_block_policy_estimator.h', 'static constexpr double SUCCESS_PCT = .85;', 'static constexpr double HALF_SUCCESS_PCT = .6;', 'static constexpr double DOUBLE_SUCCESS_PCT = .95;')" ; chx:output "True" .
chx:X_EstimatorThresholds rd:hasIOExample chx:IO_EstimatorThresholds .
chx:X_DefaultModeEconomical a owl:NamedIndividual, chx:DefaultModeEconomical ; rdfs:label "economical since 28.0"@en ; skos:definition "Since release 28.0 the default mode of estimatesmartfee is economical, not conservative: on the 31.1 node the default answer equals the economical answer at all four targets and differs from the conservative one at 144 blocks."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_DefaultModeEconomical a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); E = R['estimate']['results']; (all(E['%d_default' % t] == E['%d_economical' % t] for t in (2, 6, 25, 144)), E['144_default'] == E['144_conservative'], round(E['144_economical']['ok']['feerate'] * 10 ** 8 / 1000, 3), round(E['144_conservative']['ok']['feerate'] * 10 ** 8 / 1000, 3), L.has('core_relnotes_28.0.md', 'from `conservative` to `economical`')) evaluates to (True, False, 1.122, 1.173, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); E = R['estimate']['results']; (all(E['%d_default' % t] == E['%d_economical' % t] for t in (2, 6, 25, 144)), E['144_default'] == E['144_conservative'], round(E['144_economical']['ok']['feerate'] * 10 ** 8 / 1000, 3), round(E['144_conservative']['ok']['feerate'] * 10 ** 8 / 1000, 3), L.has('core_relnotes_28.0.md', 'from `conservative` to `economical`'))" ; chx:output "(True, False, 1.122, 1.173, True)" .
chx:X_DefaultModeEconomical rd:hasIOExample chx:IO_DefaultModeEconomical .
chx:X_BlockFeeCensus a owl:NamedIndividual, chx:BlockFeeCensus ; rdfs:label "the highest-paying 599 transactions of two blocks"@en ; skos:definition "Of the first 599 transactions after the coinbase, the median fee rate was 1,436 satoshis per virtual byte in block 840,000 (2024-04-20) and 3.02 in block 971,489 (2026-10-15)."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_BlockFeeCensus a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.census_stats(840000)['n'], L.census_stats(840000)['median_rate'], L.census_stats(971489)['median_rate'], C['blocks']['971489']['extras']['medianFee'], C['blocks']['840000']['extras']['medianFee']) evaluates to (599, 1436.45, 3.02, 1, 200)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.census_stats(840000)['n'], L.census_stats(840000)['median_rate'], L.census_stats(971489)['median_rate'], C['blocks']['971489']['extras']['medianFee'], C['blocks']['840000']['extras']['medianFee'])" ; chx:output "(599, 1436.45, 3.02, 1, 200)" .
chx:X_BlockFeeCensus rd:hasIOExample chx:IO_BlockFeeCensus .
chx:X_RecommendedFeesToday a owl:NamedIndividual, chx:RecommendedFeesToday ; rdfs:label "every recommendation is 1 sat/vB"@en ; skos:definition "On 2026-10-15 the public explorer recommended 1 satoshi per virtual byte for every speed, and its series of 1,096 block-group averages over the last year ran from 798,426 to 8,098,275 satoshis of fees per block."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_RecommendedFeesToday a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); f = L.ev_json('mempool_fees_recommended.json'); y = L.ev_json('mempool_blocks_fees_1y.json'); a = [x['avgFees'] for x in y]; (f, len(y), min(a), max(a)) evaluates to ({'fastestFee': 1, 'halfHourFee': 1, 'hourFee': 1, 'economyFee': 1, 'minimumFee': 1}, 1096, 798426, 8098275)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); f = L.ev_json('mempool_fees_recommended.json'); y = L.ev_json('mempool_blocks_fees_1y.json'); a = [x['avgFees'] for x in y]; (f, len(y), min(a), max(a))" ; chx:output "({'fastestFee': 1, 'halfHourFee': 1, 'hourFee': 1, 'economyFee': 1, 'minimumFee': 1}, 1096, 798426, 8098275)" .
chx:X_RecommendedFeesToday rd:hasIOExample chx:IO_RecommendedFeesToday .
chx:X_RevealedFeeBehaviour a owl:NamedIndividual, chx:RevealedFeeBehaviour ; rdfs:label "the median latency was 1,339 seconds without a fee and 600 with 0.0005 bitcoin"@en ; skos:definition "A study of June 2012 to May 2013 found a median wait of 1,339 seconds for transactions with no fee, 600 for those paying 0.0005 bitcoin and 520 for 0.001, the first empirical look at fee behaviour; the claim is the table of the paper, found in the saved copy."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_RevealedFeeBehaviour a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); L.has('moeser_boehme_2015_fees.pdf', '0 1503 180 444 1339 4270 13927', '0.0005 5735 106 255 600 1244 2440', '0.001 1905 90 212 520 1129 2135') evaluates to True"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); L.has('moeser_boehme_2015_fees.pdf', '0 1503 180 444 1339 4270 13927', '0.0005 5735 106 255 600 1244 2440', '0.001 1905 90 212 520 1129 2135')" ; chx:output "True" .
chx:X_RevealedFeeBehaviour rd:hasIOExample chx:IO_RevealedFeeBehaviour .
chx:X_OptInSignalRule a owl:NamedIndividual, chx:OptInSignalRule ; rdfs:label "sequence 0xfffffffd signals, 0xfffffffe does not"@en ; skos:definition "A transaction signals replaceability when at least one input has a sequence number below 0xfffffffe: 0xfffffffd signals, 0xfffffffe and 0xffffffff do not, and every transaction of Bitcoin Core's wallet in the run used 0xfffffffd."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_OptInSignalRule a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.rbf_signal([0xfffffffd]), L.rbf_signal([0xfffffffe]), L.rbf_signal([0xffffffff]), L.rbf_signal([0xffffffff, 0xfffffffd]), set(tuple(s['sequences']) for s in R['sniping']['samples']), L.has('bip-0125.mediawiki', 'The replacement transaction pays an absolute fee of at least the sum paid by the original transactions.')) evaluates to (True, False, False, True, {(4294967293,)}, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.rbf_signal([0xfffffffd]), L.rbf_signal([0xfffffffe]), L.rbf_signal([0xffffffff]), L.rbf_signal([0xffffffff, 0xfffffffd]), set(tuple(s['sequences']) for s in R['sniping']['samples']), L.has('bip-0125.mediawiki', 'The replacement transaction pays an absolute fee of at least the sum paid by the original transactions.'))" ; chx:output "(True, False, False, True, {(4294967293,)}, True)" .
chx:X_OptInSignalRule rd:hasIOExample chx:IO_OptInSignalRule .
chx:X_SignalInTheWild a owl:NamedIndividual, chx:SignalInTheWild ; rdfs:label "485 of 599 signal in 2024, 273 of 599 in 2026"@en ; skos:definition "In the first 599 transactions after the coinbase, 485 signalled replaceability in block 840,000 (81 percent) and 273 in block 971,489 (46 percent), so signalling is common but no longer needed."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_SignalInTheWild a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = L.census_stats(840000); b = L.census_stats(971489); (a['signal_rbf'], a['n'], round(a['signal_rbf'] / a['n'] * 100), b['signal_rbf'], b['n'], round(b['signal_rbf'] / b['n'] * 100)) evaluates to (485, 599, 81, 273, 599, 46)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = L.census_stats(840000); b = L.census_stats(971489); (a['signal_rbf'], a['n'], round(a['signal_rbf'] / a['n'] * 100), b['signal_rbf'], b['n'], round(b['signal_rbf'] / b['n'] * 100))" ; chx:output "(485, 599, 81, 273, 599, 46)" .
chx:X_SignalInTheWild rd:hasIOExample chx:IO_SignalInTheWild .
chx:X_FullRbfDefault a owl:NamedIndividual, chx:FullRbfDefault ; rdfs:label "a final-sequence transaction is replaced"@en ; skos:definition "On Bitcoin Core 31.1 a transaction with the final sequence 0xffffffff (no signal) was replaced by a transaction of twice the fee, and getmempoolinfo reports fullrbf true; release 28.0 made this the default."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_FullRbfDefault a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); x = R['rbf']; (x['fullrbf_flag'], x['t1']['sequence'], 'ok' in x['t2']['result'], x['t1_still_in_mempool'], L.has('core_relnotes_28.0.md', 'has been changed from 0 to 1')) evaluates to (True, 4294967295, True, False, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); x = R['rbf']; (x['fullrbf_flag'], x['t1']['sequence'], 'ok' in x['t2']['result'], x['t1_still_in_mempool'], L.has('core_relnotes_28.0.md', 'has been changed from 0 to 1'))" ; chx:output "(True, 4294967295, True, False, True)" .
chx:X_FullRbfDefault rd:hasIOExample chx:IO_FullRbfDefault .
chx:X_RemovedOption a owl:NamedIndividual, chx:RemovedOption ; rdfs:label "-mempoolfullrbf=0 refused by 31.1"@en ; skos:definition "Release 29.0 removed the option -mempoolfullrbf, and a 31.1 node started with -mempoolfullrbf=0 stops with Invalid parameter -mempoolfullrbf=0 and exit code 1."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_RemovedOption a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); o = R2['removed_option']; (o['exit_code'], 'Invalid parameter -mempoolfullrbf=0' in o['message'], L.has('core_relnotes_29.0.md', 'the `-mempoolfullrbf` startup option was set to default to `1`')) evaluates to (1, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); o = R2['removed_option']; (o['exit_code'], 'Invalid parameter -mempoolfullrbf=0' in o['message'], L.has('core_relnotes_29.0.md', 'the `-mempoolfullrbf` startup option was set to default to `1`'))" ; chx:output "(1, True, True)" .
chx:X_RemovedOption rd:hasIOExample chx:IO_RemovedOption .
chx:X_ConflictRule a owl:NamedIndividual, chx:ConflictRule ; rdfs:label "two payments that spend the same output"@en ; skos:definition "Two transactions conflict when they spend a common output: version 1 (inputs A and B) conflicts with version 0 (input A) and replaced it in the mempool, and version 2 (inputs B and C) conflicts with version 1, but not with version 0."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_ConflictRule a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); h = R2['hazard']; i = h['inputs']; (L.conflict(i['v0'], i['v1']), L.conflict(i['v1'], i['v2']), L.conflict(i['v0'], i['v2']), h['v0_in_mempool_after_v1'], h['v1_in_mempool_after_v2']) evaluates to (True, True, False, False, False)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); h = R2['hazard']; i = h['inputs']; (L.conflict(i['v0'], i['v1']), L.conflict(i['v1'], i['v2']), L.conflict(i['v0'], i['v2']), h['v0_in_mempool_after_v1'], h['v1_in_mempool_after_v2'])" ; chx:output "(True, True, False, False, False)" .
chx:X_ConflictRule rd:hasIOExample chx:IO_ConflictRule .
chx:X_AbsoluteFeeRule a owl:NamedIndividual, chx:AbsoluteFeeRule ; rdfs:label "514 satoshis cannot replace 564"@en ; skos:definition "A replacement must pay at least the absolute fee of what it replaces: a replacement with 514 satoshis was refused with less fees than conflicting txs, and one with the same 564 satoshis with not enough additional fees to relay."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_AbsoluteFeeRule a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); x = R['rbf']; (x['lower_fee']['fee_sat'], 'less fees than conflicting txs' in L.reason(x['lower_fee']['result']), x['equal_fee']['fee_sat'], 'not enough additional fees to relay' in L.reason(x['equal_fee']['result'])) evaluates to (514, True, 564, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); x = R['rbf']; (x['lower_fee']['fee_sat'], 'less fees than conflicting txs' in L.reason(x['lower_fee']['result']), x['equal_fee']['fee_sat'], 'not enough additional fees to relay' in L.reason(x['equal_fee']['result']))" ; chx:output "(514, True, 564, True)" .
chx:X_AbsoluteFeeRule rd:hasIOExample chx:IO_AbsoluteFeeRule .
chx:X_IncrementalFeeRule a owl:NamedIndividual, chx:IncrementalFeeRule ; rdfs:label "579 satoshis replace 564, 578 do not"@en ; skos:definition "The replacement must also pay the incremental relay fee (0.1 satoshi per virtual byte, 15 satoshis for 141 bytes) on top: 578 satoshis were refused with 14 less than 15, and 579 accepted."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_IncrementalFeeRule a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); x = R['rbf']; (L.min_replacement_fee(564, 141), x['short_by_one']['fee_sat'], 'error' in x['short_by_one']['result'], x['exactly_enough']['fee_sat'], 'ok' in x['exactly_enough']['result'], x['incremental']) evaluates to (579, 578, True, 579, True, {'old_fee_sat': 564, 'replacement_vsize': 141, 'need_extra_sat': 15})"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); x = R['rbf']; (L.min_replacement_fee(564, 141), x['short_by_one']['fee_sat'], 'error' in x['short_by_one']['result'], x['exactly_enough']['fee_sat'], 'ok' in x['exactly_enough']['result'], x['incremental'])" ; chx:output "(579, 578, True, 579, True, {'old_fee_sat': 564, 'replacement_vsize': 141, 'need_extra_sat': 15})" .
chx:X_IncrementalFeeRule rd:hasIOExample chx:IO_IncrementalFeeRule .
chx:X_FeeBumpWithWallet a owl:NamedIndividual, chx:FeeBumpWithWallet ; rdfs:label "bumpfee raises 2 sat/vB to 7 sat/vB"@en ; skos:definition "The wallet's bumpfee RPC created the replacement itself: a 208-byte transaction at 2 satoshis per virtual byte (416 satoshis, signalling with 0xfffffffd) became one at 7 (1,457 satoshis) and the original left the mempool."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_FeeBumpWithWallet a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); b = R['rbf']['bumpfee']; (b['orig_fee_sat'] / b['orig_vsize'], round(b['new_fee_sat'] / b['new_tx'], 2), b['orig_sequences'], b['orig_in_mempool_after'], L.has('core_src_wallet_feebumper.cpp', 'Min total fee is old fee + relay fee')) evaluates to (2.0, 7.0, [4294967293, 4294967293], False, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); b = R['rbf']['bumpfee']; (b['orig_fee_sat'] / b['orig_vsize'], round(b['new_fee_sat'] / b['new_tx'], 2), b['orig_sequences'], b['orig_in_mempool_after'], L.has('core_src_wallet_feebumper.cpp', 'Min total fee is old fee + relay fee'))" ; chx:output "(2.0, 7.0, [4294967293, 4294967293], False, True)" .
chx:X_FeeBumpWithWallet rd:hasIOExample chx:IO_FeeBumpWithWallet .
chx:X_FeerateDiagramRule a owl:NamedIndividual, chx:FeerateDiagramRule ; rdfs:label "a replacement must improve the feerate diagram"@en ; skos:definition "Bitcoin Core 31.1 no longer asks only for a higher fee rate; its source requires that a replacement strictly improves the mempool's feerate diagram, the curve of cumulative fee against cumulative size."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_FeerateDiagramRule a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.has('core_src_policy_rbf.cpp', 'Require that the replacement strictly improves the mempool'), L.has('core_doc_policy_mempool-replacements.md', 'The replacement transaction pays an absolute fee of at least the sum paid by the original transactions.')) evaluates to (True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.has('core_src_policy_rbf.cpp', 'Require that the replacement strictly improves the mempool'), L.has('core_doc_policy_mempool-replacements.md', 'The replacement transaction pays an absolute fee of at least the sum paid by the original transactions.'))" ; chx:output "(True, True)" .
chx:X_FeerateDiagramRule rd:hasIOExample chx:IO_FeerateDiagramRule .
chx:X_ThreeVersionsPaidTwice a owl:NamedIndividual, chx:ThreeVersionsPaidTwice ; rdfs:label "0.4 BTC asked, 0.8 BTC received"@en ; skos:definition "When version 0 (input A), version 1 (A and B) and version 2 (B and C) of one payment of 0.4 bitcoin were made, a miner that kept version 0 mined it and then version 2, and the payee received 0.8 bitcoin."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_ThreeVersionsPaidTwice a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); h = R2['hazard']; (h['payee_asked_sat'], h['payee_received_sat'], h['v2_in_mempool_after_v0_block'], 'ok' in h['mine_v0'], 'ok' in h['mine_v2']) evaluates to (40000000, 80000000, True, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); h = R2['hazard']; (h['payee_asked_sat'], h['payee_received_sat'], h['v2_in_mempool_after_v0_block'], 'ok' in h['mine_v0'], 'ok' in h['mine_v2'])" ; chx:output "(40000000, 80000000, True, True, True)" .
chx:X_ThreeVersionsPaidTwice rd:hasIOExample chx:IO_ThreeVersionsPaidTwice .
chx:X_LargeChildPin a owl:NamedIndividual, chx:LargeChildPin ; rdfs:label "a 100-byte payment and a 100,000-byte child"@en ; skos:definition "A payment of 100 virtual bytes with a child of 100,000 makes a replacement pay for 100,100 bytes, 1,001 times the original; in the run a 90,012-byte child raised the price of replacing a 705-satoshi parent to 450,780 satoshis, 639 times."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_LargeChildPin a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); p = R['pinning']['v2']; ((100 + 100000) // 100, p['child']['vsize'], p['replacement_enough']['fee_sat'], round(p['replacement_enough']['fee_sat'] / p['parent']['fee_sat']), 'less fees than conflicting txs' in L.reason(p['replacement_at_6']['result'])) evaluates to (1001, 90012, 450780, 639, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); p = R['pinning']['v2']; ((100 + 100000) // 100, p['child']['vsize'], p['replacement_enough']['fee_sat'], round(p['replacement_enough']['fee_sat'] / p['parent']['fee_sat']), 'less fees than conflicting txs' in L.reason(p['replacement_at_6']['result']))" ; chx:output "(1001, 90012, 450780, 639, True)" .
chx:X_LargeChildPin rd:hasIOExample chx:IO_LargeChildPin .
chx:X_ReplacementCycling a owl:NamedIndividual, chx:ReplacementCycling ; rdfs:label "an attack on time-locked payments"@en ; skos:definition "Replacement cycling lets a counterparty repeatedly replace and remove a victim's time-sensitive transaction so that it never confirms in time; the claim is the Optech text, found in the saved copies, and the attack itself was not executed."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_ReplacementCycling a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); L.has('optech_topic_replacement_cycling.html', 'Replacement cycling is especially concerning in protocols that use time sensitive transactions.') and L.has('optech_newsletter_2023-10-25.html', 'describes the replacement cycling attack against HTLCs used in LN and other systems') evaluates to True"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); L.has('optech_topic_replacement_cycling.html', 'Replacement cycling is especially concerning in protocols that use time sensitive transactions.') and L.has('optech_newsletter_2023-10-25.html', 'describes the replacement cycling attack against HTLCs used in LN and other systems')" ; chx:output "True" .
chx:X_ReplacementCycling rd:hasIOExample chx:IO_ReplacementCycling .
chx:X_PackageFeeRate a owl:NamedIndividual, chx:PackageFeeRate ; rdfs:label "a parent at 1 sat/vB and a child at 100"@en ; skos:definition "A parent paying 141 satoshis and a child paying 14,100 form a package of 14,241 satoshis over 280.5 virtual bytes (1,122 weight units), 50.77 satoshis per virtual byte, the figure the node's chunk fields show, or 50.5 when each size is rounded up to 141."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_PackageFeeRate a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); e = R['ancestor_mining']['cpfp_wins']['mempoolentries']; f = e['P']['fees']['chunk'] * 10 ** 8; (round(f), e['P']['chunkweight'], round(f / (e['P']['chunkweight'] / 4), 2), float(L.package_rate([141, 14100], [141, 141]))) evaluates to (14241, 1122, 50.77, 50.5)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); e = R['ancestor_mining']['cpfp_wins']['mempoolentries']; f = e['P']['fees']['chunk'] * 10 ** 8; (round(f), e['P']['chunkweight'], round(f / (e['P']['chunkweight'] / 4), 2), float(L.package_rate([141, 14100], [141, 141])))" ; chx:output "(14241, 1122, 50.77, 50.5)" .
chx:X_PackageFeeRate rd:hasIOExample chx:IO_PackageFeeRate .
chx:X_ChildBeatsHighRateTransaction a owl:NamedIndividual, chx:ChildBeatsHighRateTransaction ; rdfs:label "the pair at 50.8 comes before a lone transaction at 20"@en ; skos:definition "In a block with room for two of the three transactions, the node chose the parent and its child (package rate 50.8) before an unrelated transaction paying 20 satoshis per virtual byte, and the parent comes before the child in the block."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_ChildBeatsHighRateTransaction a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = R['ancestor_mining']['cpfp_wins']; b = a['block_txids']; t = lambda k: a[k]['txid']; (t('P') in b, t('C') in b, t('A') in b, b.index(t('P')) < b.index(t('C')), a['block_weight']) evaluates to (True, True, False, True, 2014)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = R['ancestor_mining']['cpfp_wins']; b = a['block_txids']; t = lambda k: a[k]['txid']; (t('P') in b, t('C') in b, t('A') in b, b.index(t('P')) < b.index(t('C')), a['block_weight'])" ; chx:output "(True, True, False, True, 2014)" .
chx:X_ChildBeatsHighRateTransaction rd:hasIOExample chx:IO_ChildBeatsHighRateTransaction .
chx:X_LowFeeChildLoses a owl:NamedIndividual, chx:LowFeeChildLoses ; rdfs:label "a child at 5 sat/vB does not help"@en ; skos:definition "With a child paying only 5 satoshis per virtual byte the package rate is 3.0, below the 20 of the unrelated transaction, which was mined alone while the parent and child stayed in the mempool."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_LowFeeChildLoses a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = R['ancestor_mining']['cpfp_loses']; b = a['block_txids']; t = lambda k: a[k]['txid']; (round((a['fees_sat']['P'] + a['fees_sat']['C']) / (a['mempoolentries']['P']['chunkweight'] / 4), 2), t('A') in b, t('P') in b, t('C') in b) evaluates to (3.02, True, False, False)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = R['ancestor_mining']['cpfp_loses']; b = a['block_txids']; t = lambda k: a[k]['txid']; (round((a['fees_sat']['P'] + a['fees_sat']['C']) / (a['mempoolentries']['P']['chunkweight'] / 4), 2), t('A') in b, t('P') in b, t('C') in b)" ; chx:output "(3.02, True, False, False)" .
chx:X_LowFeeChildLoses rd:hasIOExample chx:IO_LowFeeChildLoses .
chx:X_AncestorFeerateMining a owl:NamedIndividual, chx:AncestorFeerateMining ; rdfs:label "chunk fee equals the child's ancestor fee"@en ; skos:definition "Since release 0.13.0 miners rank transactions with their unconfirmed ancestors; in the 31.1 node the parent's chunk fee equals the child's ancestor fee, and both chunks weigh 1,122 weight units."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_AncestorFeerateMining a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); e = R['ancestor_mining']['cpfp_wins']['mempoolentries']; (e['P']['fees']['chunk'] == e['C']['fees']['chunk'] == e['C']['fees']['ancestor'], e['P']['chunkweight'], e['C']['chunkweight'], L.has('core_relnotes_0.13.0.md', 'algorithm that selects transactions based on their feerate inclusive of unconfirmed ancestor transactions')) evaluates to (True, 1122, 1122, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); e = R['ancestor_mining']['cpfp_wins']['mempoolentries']; (e['P']['fees']['chunk'] == e['C']['fees']['chunk'] == e['C']['fees']['ancestor'], e['P']['chunkweight'], e['C']['chunkweight'], L.has('core_relnotes_0.13.0.md', 'algorithm that selects transactions based on their feerate inclusive of unconfirmed ancestor transactions'))" ; chx:output "(True, 1122, 1122, True)" .
chx:X_AncestorFeerateMining rd:hasIOExample chx:IO_AncestorFeerateMining .
chx:X_MinimumRelayProblem a owl:NamedIndividual, chx:MinimumRelayProblem ; rdfs:label "a parent of 8 satoshis that no node would take alone"@en ; skos:definition "A parent paying 8 satoshis (below the 15 needed) was refused alone with min relay fee not met, a child alone was refused as spending a missing output, and the two together were accepted by submitpackage."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_MinimumRelayProblem a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); p = R['package']; (R['package']['v2_parent']['fee_sat'], p['v2_parent_alone']['ok'][0]['reject-details'][:36], L.reason(p['child_alone']), p['submitpackage_v2']['ok']['package_msg']) evaluates to (8, 'min relay fee not met, 8 < 15', 'bad-txns-inputs-missingorspent', 'success')"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); p = R['package']; (R['package']['v2_parent']['fee_sat'], p['v2_parent_alone']['ok'][0]['reject-details'][:36], L.reason(p['child_alone']), p['submitpackage_v2']['ok']['package_msg'])" ; chx:output "(8, 'min relay fee not met, 8 < 15', 'bad-txns-inputs-missingorspent', 'success')" .
chx:X_MinimumRelayProblem rd:hasIOExample chx:IO_MinimumRelayProblem .
chx:X_SubmitPackageRpc a owl:NamedIndividual, chx:SubmitPackageRpc ; rdfs:label "a zero-fee version-3 parent with its anchor child"@en ; skos:definition "The RPC submitpackage accepted a version-3 parent paying nothing together with a child paying 10,000 satoshis for both, an effective rate of 36.5 satoshis per virtual byte over 274 virtual bytes."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_SubmitPackageRpc a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); p = R['package']; s = p['submitpackage_truc']['ok']; feer = list(s['tx-results'].values())[0]['fees']['effective-feerate']; (s['package_msg'], round(feer * 10 ** 8 / 1000, 1), p['truc_parent']['vsize'] + p['anchor_child']['vsize'], p['anchor_child']['fee_sat'], L.reason(p['parent_alone'])) evaluates to ('success', 36.5, 274, 10000, 'min relay fee not met, 0 < 13')"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); p = R['package']; s = p['submitpackage_truc']['ok']; feer = list(s['tx-results'].values())[0]['fees']['effective-feerate']; (s['package_msg'], round(feer * 10 ** 8 / 1000, 1), p['truc_parent']['vsize'] + p['anchor_child']['vsize'], p['anchor_child']['fee_sat'], L.reason(p['parent_alone']))" ; chx:output "('success', 36.5, 274, 10000, 'min relay fee not met, 0 < 13')" .
chx:X_SubmitPackageRpc rd:hasIOExample chx:IO_SubmitPackageRpc .
chx:X_OneParentOneChild a owl:NamedIndividual, chx:OneParentOneChild ; rdfs:label "limited package relay since 28.0"@en ; skos:definition "Release 28.0 pairs a transaction whose fee rate is too low with its child and submits them as one package, and release 31.0 lets the parent of such a one-parent-one-child package pay nothing even when it is not version 3."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_OneParentOneChild a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.has('core_relnotes_28.0.md', 'Transactions having a feerate that is too low will be opportunistically paired with their child transactions and submitted as a package'), L.has('core_relnotes_31.0.html', 'even 0 fee. This expands the change from 28.0 to also cover packages of non-TRUC transactions'), L.has('core_doc_policy_packages.md', 'MAX_PACKAGE_COUNT=25')) evaluates to (True, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.has('core_relnotes_28.0.md', 'Transactions having a feerate that is too low will be opportunistically paired with their child transactions and submitted as a package'), L.has('core_relnotes_31.0.html', 'even 0 fee. This expands the change from 28.0 to also cover packages of non-TRUC transactions'), L.has('core_doc_policy_packages.md', 'MAX_PACKAGE_COUNT=25'))" ; chx:output "(True, True, True)" .
chx:X_OneParentOneChild rd:hasIOExample chx:IO_OneParentOneChild .
chx:X_FeeFilterMessage a owl:NamedIndividual, chx:FeeFilterMessage ; rdfs:label "a peer says: send me nothing below this rate"@en ; skos:definition "BIP 133 lets a node tell its peers the lowest fee rate it will accept so that they do not announce cheaper transactions, and the book's getpeerinfo listing shows the field minfeefilter of a peer as 0."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_FeeFilterMessage a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.has('bip-0133.mediawiki', 'instruct peers not to send'), L.has('book_ch10_network.adoc', ''minfeefilter': 0.00000000')) evaluates to (True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.has('bip-0133.mediawiki', 'instruct peers not to send'), L.has('book_ch10_network.adoc', ''minfeefilter': 0.00000000'))" ; chx:output "(True, True)" .
chx:X_FeeFilterMessage rd:hasIOExample chx:IO_FeeFilterMessage .
chx:X_ClusterLimits a owl:NamedIndividual, chx:ClusterLimits ; rdfs:label "64 transactions accepted, the 65th refused"@en ; skos:definition "Release 31.0 limits a cluster (a connected set of mempool transactions) to 64 transactions and 101,000 virtual bytes; a chain of 65 payments was accepted up to 64 and the 65th refused with too-large-cluster."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_ClusterLimits a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); c = R['cluster']; m = c['mempoolinfo']; ch = c['chain']; (m['limitclustercount'], m['limitclustersize'], ch['attempted'], ch['accepted'], L.reason(ch['first_refusal']), L.const('core_src_policy_policy.h', 'DEFAULT_CLUSTER_LIMIT')) evaluates to (64, 101000, 65, 64, 'too-large-cluster', '64')"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); c = R['cluster']; m = c['mempoolinfo']; ch = c['chain']; (m['limitclustercount'], m['limitclustersize'], ch['attempted'], ch['accepted'], L.reason(ch['first_refusal']), L.const('core_src_policy_policy.h', 'DEFAULT_CLUSTER_LIMIT'))" ; chx:output "(64, 101000, 65, 64, 'too-large-cluster', '64')" .
chx:X_ClusterLimits rd:hasIOExample chx:IO_ClusterLimits .
chx:X_ChunksAndLinearization a owl:NamedIndividual, chx:ChunksAndLinearization ; rdfs:label "the best part of a cluster comes first"@en ; skos:definition "A cluster is linearized (put in an order that keeps parents before children) so that the highest fee rate prefix, a chunk, comes first; the parent and child of the run formed one chunk of 1,122 weight units."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_ChunksAndLinearization a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); e = R['ancestor_mining']['cpfp_wins']['mempoolentries']; (L.has('core_doc_policy_mempool-design.md', 'We call these subsets **chunks**'), e['P']['chunkweight'] == e['P']['weight'] + e['C']['weight'], round(e['P']['fees']['chunk'] * 10 ** 8) == round(e['P']['fees']['base'] * 10 ** 8) + round(e['C']['fees']['base'] * 10 ** 8)) evaluates to (True, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); e = R['ancestor_mining']['cpfp_wins']['mempoolentries']; (L.has('core_doc_policy_mempool-design.md', 'We call these subsets **chunks**'), e['P']['chunkweight'] == e['P']['weight'] + e['C']['weight'], round(e['P']['fees']['chunk'] * 10 ** 8) == round(e['P']['fees']['base'] * 10 ** 8) + round(e['C']['fees']['base'] * 10 ** 8))" ; chx:output "(True, True, True)" .
chx:X_ChunksAndLinearization rd:hasIOExample chx:IO_ChunksAndLinearization .
chx:X_RemovedAncestorLimits a owl:NamedIndividual, chx:RemovedAncestorLimits ; rdfs:label "a chain of 26 accepted"@en ; skos:definition "The old limits of 25 ancestors or descendants and 101,000 virtual bytes are gone in release 31.0: a chain whose 26th transaction the old rule would have refused was accepted, and the 64th as well."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_RemovedAncestorLimits a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); ch = R['cluster']['chain']; (ch['accepted_26th'], ch['accepted'], L.has('core_relnotes_31.0.html', 'The mempool no longer enforces ancestor or descendant size/count limits.'), L.has('core_relnotes_0.19.0.1.md', 'if a transaction in the mempool had 25 descendants, or it and all of its descendants were over 101,000 vbytes')) evaluates to (True, 64, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); ch = R['cluster']['chain']; (ch['accepted_26th'], ch['accepted'], L.has('core_relnotes_31.0.html', 'The mempool no longer enforces ancestor or descendant size/count limits.'), L.has('core_relnotes_0.19.0.1.md', 'if a transaction in the mempool had 25 descendants, or it and all of its descendants were over 101,000 vbytes'))" ; chx:output "(True, 64, True, True)" .
chx:X_RemovedAncestorLimits rd:hasIOExample chx:IO_RemovedAncestorLimits .
chx:X_MempoolSizeAndExpiry a owl:NamedIndividual, chx:MempoolSizeAndExpiry ; rdfs:label "300 MB and 336 hours, not one day"@en ; skos:definition "The default mempool holds 300 megabytes (-maxmempool) and forgets transactions after 336 hours, which is 14 days; the book's summary 'about one day's worth' describes neither number."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_MempoolSizeAndExpiry a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.const('core_src_kernel_mempool_options.h', 'DEFAULT_MAX_MEMPOOL_SIZE_MB'), L.const('core_src_kernel_mempool_options.h', 'DEFAULT_MEMPOOL_EXPIRY_HOURS'), int(L.const('core_src_kernel_mempool_options.h', 'DEFAULT_MEMPOOL_EXPIRY_HOURS')) // 24, R2['mempool_min']['maxmempool']) evaluates to ('300', '336', 14, 300000000)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.const('core_src_kernel_mempool_options.h', 'DEFAULT_MAX_MEMPOOL_SIZE_MB'), L.const('core_src_kernel_mempool_options.h', 'DEFAULT_MEMPOOL_EXPIRY_HOURS'), int(L.const('core_src_kernel_mempool_options.h', 'DEFAULT_MEMPOOL_EXPIRY_HOURS')) // 24, R2['mempool_min']['maxmempool'])" ; chx:output "('300', '336', 14, 300000000)" .
chx:X_MempoolSizeAndExpiry rd:hasIOExample chx:IO_MempoolSizeAndExpiry .
chx:X_CarveOutRule a owl:NamedIndividual, chx:CarveOutRule ; rdfs:label "the extra child may be 10,000 bytes, not 1,000"@en ; skos:definition "Bitcoin Core's carve-out admitted one extra child of at most 10,000 virtual bytes beyond the 25-descendant and 101,000-byte limits (the constant is EXTRA_DESCENDANT_TX_SIZE_LIMIT of 10000), where the book says 1,000 and 100,000; Corallo's 2018 proposal had said 1K."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_CarveOutRule a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.const('core_src_policy_policy.h', 'EXTRA_DESCENDANT_TX_SIZE_LIMIT'), L.has('core_relnotes_0.19.0.1.md', 'the child's size is 10,000 vbytes or less'), L.has('ml_corallo_2018-12_carveout.html', 'Be of size no greater than 1K in virtual size.'), L.has('book_ch09_fees.adoc', 'a single additional transaction up to 1,000 vbytes in size')) evaluates to ('10000', True, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.const('core_src_policy_policy.h', 'EXTRA_DESCENDANT_TX_SIZE_LIMIT'), L.has('core_relnotes_0.19.0.1.md', 'the child's size is 10,000 vbytes or less'), L.has('ml_corallo_2018-12_carveout.html', 'Be of size no greater than 1K in virtual size.'), L.has('book_ch09_fees.adoc', 'a single additional transaction up to 1,000 vbytes in size'))" ; chx:output "('10000', True, True, True)" .
chx:X_CarveOutRule rd:hasIOExample chx:IO_CarveOutRule .
chx:X_CarveOutRemoved a owl:NamedIndividual, chx:CarveOutRemoved ; rdfs:label "gone in 31.0"@en ; skos:definition "The carve-out was removed from the mempool in release 31.0 because the cluster limits replaced the descendant limits it worked around."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_CarveOutRemoved a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.has('core_relnotes_31.0.html', 'has been removed from the mempool logic'), L.has('core_relnotes_31.0.html', 'Nothing is allowed to bypass the cluster count limit.')) evaluates to (True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.has('core_relnotes_31.0.html', 'has been removed from the mempool logic'), L.has('core_relnotes_31.0.html', 'Nothing is allowed to bypass the cluster count limit.'))" ; chx:output "(True, True)" .
chx:X_CarveOutRemoved rd:hasIOExample chx:IO_CarveOutRemoved .
chx:X_QuadraticWork a owl:NamedIndividual, chx:QuadraticWork ; rdfs:label "25 ancestors with 25 children each is 625 packages"@en ; skos:definition "If a child pays for 25 ancestors that each have 25 other children, about 625 packages must be updated, and doubling the limit to 50 quadruples the work to 2,500, the cost that the old limits guarded against."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_QuadraticWork a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (25 ** 2, 50 ** 2, 50 ** 2 // 25 ** 2, L.has('book_ch09_fees.adoc', 'requires updating approximately 625 packages')) evaluates to (625, 2500, 4, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (25 ** 2, 50 ** 2, 50 ** 2 // 25 ** 2, L.has('book_ch09_fees.adoc', 'requires updating approximately 625 packages'))" ; chx:output "(625, 2500, 4, True)" .
chx:X_QuadraticWork rd:hasIOExample chx:IO_QuadraticWork .
chx:X_TrucLimits a owl:NamedIndividual, chx:TrucLimits ; rdfs:label "version 3, 10,000 and 1,000 virtual bytes"@en ; skos:definition "A version-3 (TRUC) transaction may have one unconfirmed parent and one child, at most 10,000 virtual bytes itself and 1,000 for the child; a child of 1,350 virtual bytes was refused, a child of 141 accepted."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_TrucLimits a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); q = lambda n: L.const('core_src_policy_truc_policy.h', n); t = R['truc']; (q('TRUC_VERSION'), q('TRUC_ANCESTOR_LIMIT'), q('TRUC_MAX_VSIZE'), q('TRUC_CHILD_MAX_VSIZE'), t['big_child']['vsize'], 'TRUC-violation' in L.reason(t['big_child']['result']), t['child1']['vsize'], 'ok' in t['child1']['result']) evaluates to ('3', '2', '10000', '1000', 1350, True, 141, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); q = lambda n: L.const('core_src_policy_truc_policy.h', n); t = R['truc']; (q('TRUC_VERSION'), q('TRUC_ANCESTOR_LIMIT'), q('TRUC_MAX_VSIZE'), q('TRUC_CHILD_MAX_VSIZE'), t['big_child']['vsize'], 'TRUC-violation' in L.reason(t['big_child']['result']), t['child1']['vsize'], 'ok' in t['child1']['result'])" ; chx:output "('3', '2', '10000', '1000', 1350, True, 141, True)" .
chx:X_TrucLimits rd:hasIOExample chx:IO_TrucLimits .
chx:X_TrucSiblingEviction a owl:NamedIndividual, chx:TrucSiblingEviction ; rdfs:label "a second child at a higher rate replaces the first"@en ; skos:definition "A second child of the same parent paying the same rate was refused for insufficient fee including sibling eviction, and one paying a higher rate was accepted and evicted the first child."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_TrucSiblingEviction a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); t = R['truc']; ('sibling eviction' in L.reason(t['sibling_same_rate']['result']), 'ok' in t['sibling_higher_rate']['result'], t['sibling_higher_rate']['child1_in_mempool_after']) evaluates to (True, True, False)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); t = R['truc']; ('sibling eviction' in L.reason(t['sibling_same_rate']['result']), 'ok' in t['sibling_higher_rate']['result'], t['sibling_higher_rate']['child1_in_mempool_after'])" ; chx:output "(True, True, False)" .
chx:X_TrucSiblingEviction rd:hasIOExample chx:IO_TrucSiblingEviction .
chx:X_TrucVersionMixing a owl:NamedIndividual, chx:TrucVersionMixing ; rdfs:label "a version-2 child of a version-3 parent"@en ; skos:definition "A version-2 transaction that spends an output of an unconfirmed version-3 transaction is refused with TRUC-violation, because the rules bind both sides."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_TrucVersionMixing a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); t = R['truc']['v2_child_of_v3']; (t['version'], L.reason(t['result'])[:30]) evaluates to (2, 'TRUC-violation, non-version=3 ')"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); t = R['truc']['v2_child_of_v3']; (t['version'], L.reason(t['result'])[:30])" ; chx:output "(2, 'TRUC-violation, non-version=3 ')" .
chx:X_TrucVersionMixing rd:hasIOExample chx:IO_TrucVersionMixing .
chx:X_TrucPinningBound a owl:NamedIndividual, chx:TrucPinningBound ; rdfs:label "replacing a pinned parent costs 5,145 instead of 450,780 satoshis"@en ; skos:definition "With a version-3 child capped at 1,000 virtual bytes (885 in the run) the same replacement cost 5,145 satoshis, 88 times less than the 450,780 of the unrestricted pin."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_TrucPinningBound a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); v2 = R['pinning']['v2']['replacement_enough']['fee_sat']; v3 = R['pinning']['v3']['replacement_enough']['fee_sat']; (R['pinning']['v3']['child']['vsize'], v3, v2, round(v2 / v3)) evaluates to (885, 5145, 450780, 88)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); v2 = R['pinning']['v2']['replacement_enough']['fee_sat']; v3 = R['pinning']['v3']['replacement_enough']['fee_sat']; (R['pinning']['v3']['child']['vsize'], v3, v2, round(v2 / v3))" ; chx:output "(885, 5145, 450780, 88)" .
chx:X_TrucPinningBound rd:hasIOExample chx:IO_TrucPinningBound .
chx:X_PayToAnchor a owl:NamedIndividual, chx:PayToAnchor ; rdfs:label "the script 51024e73"@en ; skos:definition "The pay-to-anchor output is the witness version 1 program 0x4e73, the script 51024e73, and anyone can spend it; the run's anchor output carried exactly that script and the value 0."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_PayToAnchor a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); t = L.parse_tx(R['package']['truc_parent']['hex']); (t['vout'][0]['spk'], t['vout'][0]['value'], L.has('bip-0433.mediawiki', 'scriptPubKey <code>OP_1 <0x4e73></code>')) evaluates to ('51024e73', 0, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); t = L.parse_tx(R['package']['truc_parent']['hex']); (t['vout'][0]['spk'], t['vout'][0]['value'], L.has('bip-0433.mediawiki', 'scriptPubKey <code>OP_1 <0x4e73></code>'))" ; chx:output "('51024e73', 0, True)" .
chx:X_PayToAnchor rd:hasIOExample chx:IO_PayToAnchor .
chx:X_EphemeralDust a owl:NamedIndividual, chx:EphemeralDust ; rdfs:label "a zero-fee parent with a dust output"@en ; skos:definition "Ephemeral dust allows one dust output in a transaction that pays no fee, provided the child spends it: the zero-fee parent was refused alone and mined with its child, and the mempool was empty after."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_EphemeralDust a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); p = R['package']; (p['truc_parent']['vsize'], L.reason(p['parent_alone']), p['submitpackage_truc']['ok']['package_msg'], p['after_mining']['mempool'], L.has('core_relnotes_29.0.md', 'Ephemeral dust is a new concept that allows a single dust output in a transaction, provided the transaction is zero fee.')) evaluates to (123, 'min relay fee not met, 0 < 13', 'success', 0, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); p = R['package']; (p['truc_parent']['vsize'], L.reason(p['parent_alone']), p['submitpackage_truc']['ok']['package_msg'], p['after_mining']['mempool'], L.has('core_relnotes_29.0.md', 'Ephemeral dust is a new concept that allows a single dust output in a transaction, provided the transaction is zero fee.'))" ; chx:output "(123, 'min relay fee not met, 0 < 13', 'success', 0, True)" .
chx:X_EphemeralDust rd:hasIOExample chx:IO_EphemeralDust .
chx:X_AnchorSpend a owl:NamedIndividual, chx:AnchorSpend ; rdfs:label "the child spends the anchor with an empty witness"@en ; skos:definition "The child spent the anchor with an empty witness stack, so anyone could have attached it, and paid 10,000 satoshis from a 1-bitcoin input."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_AnchorSpend a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); c = R['package']['anchor_child']; t = L.parse_tx(c['hex']); (len(t['vin']), [v['witness'] for v in t['vin']].count([]), c['fee_sat'], c['spent_value_sat']) evaluates to (2, 1, 10000, 100000000)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); c = R['package']['anchor_child']; t = L.parse_tx(c['hex']); (len(t['vin']), [v['witness'] for v in t['vin']].count([]), c['fee_sat'], c['spent_value_sat'])" ; chx:output "(2, 1, 10000, 100000000)" .
chx:X_AnchorSpend rd:hasIOExample chx:IO_AnchorSpend .
chx:X_LightningAnchorOutputs a owl:NamedIndividual, chx:LightningAnchorOutputs ; rdfs:label "330 satoshis per anchor"@en ; skos:definition "In the Lightning specification each commitment transaction has two anchor outputs of 330 satoshis, spendable by anyone after 16 blocks, so either side can fee bump by child pays for parent."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_LightningAnchorOutputs a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.has('bolt03_transactions.md', 'The amount of the output is fixed at 330 sats, the default dust limit for P2WSH.'), L.has('bolt03_transactions.md', 'After 16 blocks, anyone can sweep the'), L.has('optech_topic_anchor_outputs.html', 'came to depend on CPFP carve-out to circumvent the pinning problem')) evaluates to (True, True, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.has('bolt03_transactions.md', 'The amount of the output is fixed at 330 sats, the default dust limit for P2WSH.'), L.has('bolt03_transactions.md', 'After 16 blocks, anyone can sweep the'), L.has('optech_topic_anchor_outputs.html', 'came to depend on CPFP carve-out to circumvent the pinning problem'))" ; chx:output "(True, True, True)" .
chx:X_LightningAnchorOutputs rd:hasIOExample chx:IO_LightningAnchorOutputs .
chx:X_SubsidyHalvings a owl:NamedIndividual, chx:SubsidyHalvings ; rdfs:label "6.25 bitcoins to 3.125 at block 840,000"@en ; skos:definition "The subsidy is 50 bitcoins shifted right once per 210,000 blocks (GetBlockSubsidy): 625,000,000 satoshis before block 840,000 and 312,500,000 from it, as in block 971,489."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_SubsidyHalvings a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.subsidy(0), L.subsidy(209999), L.subsidy(210000), L.subsidy(839999), L.subsidy(840000), L.subsidy(971489), L.has('core_src_validation.cpp', 'nSubsidy >>= halvings;')) evaluates to (5000000000, 5000000000, 2500000000, 625000000, 312500000, 312500000, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.subsidy(0), L.subsidy(209999), L.subsidy(210000), L.subsidy(839999), L.subsidy(840000), L.subsidy(971489), L.has('core_src_validation.cpp', 'nSubsidy >>= halvings;'))" ; chx:output "(5000000000, 5000000000, 2500000000, 625000000, 312500000, 312500000, True)" .
chx:X_SubsidyHalvings rd:hasIOExample chx:IO_SubsidyHalvings .
chx:X_FeesVsSubsidy a owl:NamedIndividual, chx:FeesVsSubsidy ; rdfs:label "92 percent fees in a halving block, 0.5 percent two years later"@en ; skos:definition "Fees were 92.33 percent of the reward in block 840,000 (37.6 bitcoins of fees against 3.125 of subsidy) and 0.46 percent in block 971,489, so the book's remark that the subsidy is much higher than fees is true of some blocks only."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_FeesVsSubsidy a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = C['blocks']['840000']['extras']['totalFees']; b = C['blocks']['971489']['extras']['totalFees']; (a, round(float(L.fee_share([a], L.subsidy(840000))) * 100, 2), b, round(float(L.fee_share([b], L.subsidy(971489))) * 100, 2)) evaluates to (3762561499, 92.33, 1454221, 0.46)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = C['blocks']['840000']['extras']['totalFees']; b = C['blocks']['971489']['extras']['totalFees']; (a, round(float(L.fee_share([a], L.subsidy(840000))) * 100, 2), b, round(float(L.fee_share([b], L.subsidy(971489))) * 100, 2))" ; chx:output "(3762561499, 92.33, 1454221, 0.46)" .
chx:X_FeesVsSubsidy rd:hasIOExample chx:IO_FeesVsSubsidy .
chx:X_FeeOnlyFuture a owl:NamedIndividual, chx:FeeOnlyFuture ; rdfs:label "when the subsidy runs out"@en ; skos:definition "Satoshi Nakamoto's paper says transaction fees can fund the incentive once the coins are all in circulation, and a 2016 Princeton paper argues that a fee-only chain is less stable; both passages are found in the saved copies, and neither is recomputed."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_FeeOnlyFuture a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); L.has('nakamoto_2008_bitcoin.pdf', 'the difference is a transaction fee that is added to the incentive value of the block containing the transaction.') and L.has('carlsten_2016_instability.pdf', 'does not affect the security of the block chain. We show that this is not the case.') evaluates to True"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); L.has('nakamoto_2008_bitcoin.pdf', 'the difference is a transaction fee that is added to the incentive value of the block containing the transaction.') and L.has('carlsten_2016_instability.pdf', 'does not affect the security of the block chain. We show that this is not the case.')" ; chx:output "True" .
chx:X_FeeOnlyFuture rd:hasIOExample chx:IO_FeeOnlyFuture .
chx:X_SnipingProbability a owl:NamedIndividual, chx:SnipingProbability ; rdfs:label "(x / (1 - x)) squared"@en ; skos:definition "A miner with a share x of the hash rate wins the race to re-mine the last block and extend it with probability (x / (1 - x)) squared: 1.23 percent for 10 percent, 18.37 percent for 30 percent and 66.94 percent for 45 percent, reaching certainty at one half."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_SnipingProbability a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); [round(L.snipe_probability(x), 4) for x in (0.1, 0.3, 0.45)] + [L.snipe_probability(0.5)] evaluates to [0.0123, 0.1837, 0.6694, 1.0]"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); [round(L.snipe_probability(x), 4) for x in (0.1, 0.3, 0.45)] + [L.snipe_probability(0.5)]" ; chx:output "[0.0123, 0.1837, 0.6694, 1.0]" .
chx:X_SnipingProbability rd:hasIOExample chx:IO_SnipingProbability .
chx:X_UndercuttingAttack a owl:NamedIndividual, chx:UndercuttingAttack ; rdfs:label "forking the head to take the transactions"@en ; skos:definition "Carlsten and his coauthors show that with only fees miners profit by forking the head of the chain and leaving out its transactions, which they call undercutting; the passage is found in the saved copy and the attack is not recomputed."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_UndercuttingAttack a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); L.has('carlsten_2016_instability.pdf', 'attack, where miners will actively fork the head of the') evaluates to True"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); L.has('carlsten_2016_instability.pdf', 'attack, where miners will actively fork the head of the')" ; chx:output "True" .
chx:X_UndercuttingAttack rd:hasIOExample chx:IO_UndercuttingAttack .
chx:X_WalletLockTimeRule a owl:NamedIndividual, chx:WalletLockTimeRule ; rdfs:label "56 of 60 at the tip, 4 back-dated"@en ; skos:definition "The wallet sets the lock time to the height of the tip, and in about one case in ten back-dates it by a random 0 to 99 blocks: 56 of 60 transactions in the run had the tip, four were back-dated by 6, 28, 35 and 54."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_WalletLockTimeRule a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); s = R['sniping']['samples']; d = sorted(s_['tip'] - s_['locktime'] for s_ in s); (len(s), d.count(0), [x for x in d if x], L.has('core_src_wallet_spend.cpp', 'rng_fast.randrange(100)')) evaluates to (60, 56, [6, 28, 35, 54], True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); s = R['sniping']['samples']; d = sorted(s_['tip'] - s_['locktime'] for s_ in s); (len(s), d.count(0), [x for x in d if x], L.has('core_src_wallet_spend.cpp', 'rng_fast.randrange(100)'))" ; chx:output "(60, 56, [6, 28, 35, 54], True)" .
chx:X_WalletLockTimeRule rd:hasIOExample chx:IO_WalletLockTimeRule .
chx:X_WalletLagFallback a owl:NamedIndividual, chx:WalletLagFallback ; rdfs:label "a tip older than 8 hours means lock time 0"@en ; skos:definition "When the node is still syncing or its tip is older than 8 hours the wallet sets the lock time to 0, so as not to leak a unique fingerprint."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_WalletLagFallback a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.has('core_src_wallet_spend.cpp', 'MAX_ANTI_FEE_SNIPING_TIP_AGE = 8 * 60 * 60'), 8 * 60 * 60, L.has('core_src_wallet_spend.cpp', 'set nLockTime to a constant. tx.nLockTime = 0;')) evaluates to (True, 28800, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); (L.has('core_src_wallet_spend.cpp', 'MAX_ANTI_FEE_SNIPING_TIP_AGE = 8 * 60 * 60'), 8 * 60 * 60, L.has('core_src_wallet_spend.cpp', 'set nLockTime to a constant. tx.nLockTime = 0;'))" ; chx:output "(True, 28800, True)" .
chx:X_WalletLagFallback rd:hasIOExample chx:IO_WalletLagFallback .
chx:X_MainnetPrevHeightShare a owl:NamedIndividual, chx:MainnetPrevHeightShare ; rdfs:label "89 of 599 and 33 of 599 carry the tip"@en ; skos:definition "On mainnet 89 of the first 599 transactions of block 840,000 (15 percent) and 33 of block 971,489 (6 percent) carry the previous block's height as lock time, and 507 and 563 carry 0."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_MainnetPrevHeightShare a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = L.census_stats(840000); b = L.census_stats(971489); (a['locktime_prev_height'], a['locktime_zero'], round(a['locktime_prev_height'] / a['n'] * 100), b['locktime_prev_height'], b['locktime_zero'], round(b['locktime_prev_height'] / b['n'] * 100)) evaluates to (89, 507, 15, 33, 563, 6)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); a = L.census_stats(840000); b = L.census_stats(971489); (a['locktime_prev_height'], a['locktime_zero'], round(a['locktime_prev_height'] / a['n'] * 100), b['locktime_prev_height'], b['locktime_zero'], round(b['locktime_prev_height'] / b['n'] * 100))" ; chx:output "(89, 507, 15, 33, 563, 6)" .
chx:X_MainnetPrevHeightShare rd:hasIOExample chx:IO_MainnetPrevHeightShare .
chx:X_LockTimeBoundary a owl:NamedIndividual, chx:LockTimeBoundary ; rdfs:label "lock time 100,001 cannot join block 100,001"@en ; skos:definition "A transaction is final in a block when its lock time is below the block's height, so a lock time equal to the height is not: on the node a lock time of the next block's height was refused as non-final and rejected from a block, and the tip's height was accepted."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_LockTimeBoundary a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); b = R2['locktime_block']; (L.is_final(100001, 100001, [0xfffffffd]), L.is_final(100000, 100001, [0xfffffffd]), b['mempool_next']['reject-reason'], b['mempool_tip']['allowed'], L.reason(b['block_with_next'])[-28:], 'ok' in b['block_with_tip']) evaluates to (False, True, 'non-final', True, 'final, non-final transaction', True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); b = R2['locktime_block']; (L.is_final(100001, 100001, [0xfffffffd]), L.is_final(100000, 100001, [0xfffffffd]), b['mempool_next']['reject-reason'], b['mempool_tip']['allowed'], L.reason(b['block_with_next'])[-28:], 'ok' in b['block_with_tip'])" ; chx:output "(False, True, 'non-final', True, 'final, non-final transaction', True)" .
chx:X_LockTimeBoundary rd:hasIOExample chx:IO_LockTimeBoundary .
chx:X_FinalSequenceDisablesLockTime a owl:NamedIndividual, chx:FinalSequenceDisablesLockTime ; rdfs:label "tip plus 1 with sequence 0xffffffff is final"@en ; skos:definition "A lock time is ignored when every input has the final sequence 0xffffffff, so a lock time of tip plus 1 was accepted with that sequence and refused with 0xfffffffd, and the same transaction became acceptable one block later."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_FinalSequenceDisablesLockTime a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); e = R['sniping']['edge']; a = R['sniping']['edge_after_one_block']; (e['locktime_tip_plus_1_final_sequence']['result']['allowed'], e['locktime_tip_plus_1']['result']['allowed'], e['locktime_eq_tip']['result']['allowed'], a['result']['allowed'], a['tip'] - e['locktime_tip_plus_1']['tip'], L.is_final(255, 255, [0xffffffff])) evaluates to (True, False, True, True, 1, True)"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); e = R['sniping']['edge']; a = R['sniping']['edge_after_one_block']; (e['locktime_tip_plus_1_final_sequence']['result']['allowed'], e['locktime_tip_plus_1']['result']['allowed'], e['locktime_eq_tip']['result']['allowed'], a['result']['allowed'], a['tip'] - e['locktime_tip_plus_1']['tip'], L.is_final(255, 255, [0xffffffff]))" ; chx:output "(True, False, True, True, 1, True)" .
chx:X_FinalSequenceDisablesLockTime rd:hasIOExample chx:IO_FinalSequenceDisablesLockTime .
chx:X_TaprootAntiSniping a owl:NamedIndividual, chx:TaprootAntiSniping ; rdfs:label "sequence instead of lock time"@en ; skos:definition "BIP 326 proposes that taproot wallets use the sequence field instead of the lock time against fee sniping, so that the lock time does not mark some transactions as unusual; the passage is found in the saved copy and the proposal is not executed."@en ; dcterms:source <http://example.org/sen0401/ch09/research> .
chx:IO_TaprootAntiSniping a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); L.has('bip-0326.mediawiki', 'This would be in place of their regular nLockTime anti-fee-sniping protection.') evaluates to True"@en ; chx:input "import sys; sys.path.insert(0, '08-tooling'); import sen0401_ch09_lib_v1_0_0 as L; R = L.run(); R2 = L.run2(); C = L.census(); L.has('bip-0326.mediawiki', 'This would be in place of their regular nLockTime anti-fee-sniping protection.')" ; chx:output "True" .
chx:X_TaprootAntiSniping rd:hasIOExample chx:IO_TaprootAntiSniping .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 9 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch09/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 9 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which claims of the chapter can be checked by computation, and what does the computation give?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What in the chapter has changed since the book went to print, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 9 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from Mastering Bitcoin 3rd edition's chapter 9 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0401/ch09/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.6, installed with uv on 2026-10-15."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_0_0.py" .

