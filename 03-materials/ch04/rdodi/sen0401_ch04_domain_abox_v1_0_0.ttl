    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:created "2026-09-29"^^xsd:date ; dcterms:modified "2026-09-29"^^xsd:date ;
    dcterms:identifier "sen0401_ch04_abox_v1_0_0" ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/ch04-rdodi-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

chx:X_PublicKeyCryptography a owl:NamedIndividual, chx:PublicKeyCryptography ; rdfs:label "signatures, not secrecy"@en ; skos:definition "Public key cryptography lets a private key produce a signature that anyone can check against the public key, which is what Bitcoin uses it for, not for encrypting transactions."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_PrivateKey a owl:NamedIndividual, chx:PrivateKey ; rdfs:label "a random number below n"@en ; skos:definition "A private key is a number picked at random between 1 and n minus 1, where n, about 1.1579 times 10 to the 77, is the order of the curve and slightly less than 2 to the 256."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_PrivateKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141 < 2**256 evaluates to True"@en ; chx:input "0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141 < 2**256" ; chx:output "True" .
chx:X_PrivateKey rd:hasIOExample chx:IO_PrivateKey .
chx:X_PublicKey a owl:NamedIndividual, chx:PublicKey ; rdfs:label "K = k x G"@en ; skos:definition "A public key is the point K = k x G obtained by multiplying the generator point by the private key, which is easy in one direction and infeasible to reverse."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_SecureRandomness a owl:NamedIndividual, chx:SecureRandomness ; rdfs:label "secrets rather than random"@en ; skos:definition "A private key must come from a cryptographically secure random source; Python's secrets module is documented for that use and its random module for simulation."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_Secp256k1 a owl:NamedIndividual, chx:Secp256k1 ; rdfs:label "y squared equals x cubed plus 7 over F(p)"@en ; skos:definition "The secp256k1 curve, y squared = x cubed + 7 over the prime field with p = 2 to the 256 minus 2 to the 32 minus 977, is defined in SEC 2 by Certicom Research and is not a NIST-recommended curve."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Secp256k1 a owl:NamedIndividual, rd:IOExample ; rdfs:label "2**256 - 2**32 - 2**9 - 2**8 - 2**7 - 2**6 - 2**4 - 1 == 2**256 - 2**32 - 977 evaluates to True"@en ; chx:input "2**256 - 2**32 - 2**9 - 2**8 - 2**7 - 2**6 - 2**4 - 1 == 2**256 - 2**32 - 977" ; chx:output "True" .
chx:X_Secp256k1 rd:hasIOExample chx:IO_Secp256k1 .
chx:X_PointMultiplication a owl:NamedIndividual, chx:PointMultiplication ; rdfs:label "double and add"@en ; skos:definition "Multiplying a point by a whole number k is adding it to itself k times, done in about 256 doublings and additions by the double-and-add method."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_CompressedPublicKey a owl:NamedIndividual, chx:CompressedPublicKey ; rdfs:label "33 bytes: 02 or 03 and x"@en ; skos:definition "A compressed public key keeps only x and one byte for the parity of y, 33 bytes instead of 65, and the y coordinate is recovered by solving the curve equation."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_CompressedPublicKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(1 - 33 / 65, 3) evaluates to 0.492"@en ; chx:input "round(1 - 33 / 65, 3)" ; chx:output "0.492" .
chx:X_CompressedPublicKey rd:hasIOExample chx:IO_CompressedPublicKey .
chx:X_UncompressedPublicKey a owl:NamedIndividual, chx:UncompressedPublicKey ; rdfs:label "65 bytes: 04, x and y"@en ; skos:definition "An uncompressed public key is the prefix 04 followed by the x and y coordinates, 65 bytes, and it hashes to a different address than the compressed form of the same key."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_WalletImportFormat a owl:NamedIndividual, chx:WalletImportFormat ; rdfs:label "5J3m... and KxFC..."@en ; skos:definition "The wallet import format is the base58check encoding of version byte 0x80 and the private key, with a 0x01 suffix for the compressed form, which changes the first character from 5 to K or L."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_Base58Check a owl:NamedIndividual, chx:Base58Check ; rdfs:label "an alphabet without 0, O, l and I"@en ; skos:definition "Base58check encodes a version byte, the data and the first four bytes of a double SHA-256 checksum in a 58-character alphabet that leaves out the characters easily mistaken for each other."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Base58Check a owl:NamedIndividual, rd:IOExample ; rdfs:label "len('123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz') evaluates to 58"@en ; chx:input "len('123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz')" ; chx:output "58" .
chx:X_Base58Check rd:hasIOExample chx:IO_Base58Check .
chx:X_VersionPrefix a owl:NamedIndividual, chx:VersionPrefix ; rdfs:label "0x00 gives 1, 0x05 gives 3"@en ; skos:definition "The version byte makes the encoded text start with a recognisable character: 1 for a P2PKH address, 3 for P2SH, 5, K or L for a WIF key, and xpub for a BIP32 extended public key."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_Commitment a owl:NamedIndividual, chx:Commitment ; rdfs:label "a hash of the public key"@en ; skos:definition "A hash function output is a commitment to its input; Bitcoin commits to a public key with HASH160, the RIPEMD-160 of the SHA-256 of it, 20 bytes instead of 65."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Commitment a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hashlib').sha256(b'2007.  He said about a year and a half before Oct 2008\\n').hexdigest() evaluates to '94d7a772612c8f2f2ec609d41f5bd3d04a5aa1dfe3582f04af517d396a302e4e'"@en ; chx:input "__import__('hashlib').sha256(b'2007.  He said about a year and a half before Oct 2008\\n').hexdigest()" ; chx:output "'94d7a772612c8f2f2ec609d41f5bd3d04a5aa1dfe3582f04af517d396a302e4e'" .
chx:X_Commitment rd:hasIOExample chx:IO_Commitment .
chx:X_P2pkhAddress a owl:NamedIndividual, chx:P2pkhAddress ; rdfs:label "1J7mdg5rbQyUHENYdx39WVWK7fsLpEoXZy"@en ; skos:definition "A P2PKH address is the base58check encoding of version 0x00 and the HASH160 of the public key, and a compressed and an uncompressed key give two different addresses."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_P2shAddress a owl:NamedIndividual, chx:P2shAddress ; rdfs:label "3F6i6kwkevjR7AsAd4te2YB2zZyASEm1HM"@en ; skos:definition "A P2SH address commits with HASH160 to a redeem script instead of a key, uses version byte 0x05 and starts with 3."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_Bech32Address a owl:NamedIndividual, chx:Bech32Address ; rdfs:label "bc1q9d3xa5gg45q2j39m9y32xzvygcgay4rgc6aaee"@en ; skos:definition "A bech32 address is a human-readable part, the separator 1, a witness version, a witness program and a six-character checksum, in one case of a 32-character alphabet."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Bech32Address a owl:NamedIndividual, rd:IOExample ; rdfs:label "len('bc1q9d3xa5gg45q2j39m9y32xzvygcgay4rgc6aaee') evaluates to 42"@en ; chx:input "len('bc1q9d3xa5gg45q2j39m9y32xzvygcgay4rgc6aaee')" ; chx:output "42" .
chx:X_Bech32Address rd:hasIOExample chx:IO_Bech32Address .
chx:X_Bech32mAddress a owl:NamedIndividual, chx:Bech32mAddress ; rdfs:label "bc1p9nh05ha8wrljf7ru236awm4t2x0d5ctkkywmu9sclnm4t0av2vgs4k3au7"@en ; skos:definition "Bech32m differs from bech32 only in the constant merged into the checksum, 0x2bc830a3 instead of 1, and is required for witness version 1 and later."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Bech32mAddress a owl:NamedIndividual, rd:IOExample ; rdfs:label "hex(0x2bc830a3) evaluates to '0x2bc830a3'"@en ; chx:input "hex(0x2bc830a3)" ; chx:output "'0x2bc830a3'" .
chx:X_Bech32mAddress rd:hasIOExample chx:IO_Bech32mAddress .
chx:X_WitnessProgram a owl:NamedIndividual, chx:WitnessProgram ; rdfs:label "20 or 32 bytes for version 0"@en ; skos:definition "The witness program is 2 to 40 bytes and, for witness version 0, exactly 20 or 32; for version 1, taproot, it is a 32-byte point."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_ErrorDetection a owl:NamedIndividual, chx:ErrorDetection ; rdfs:label "detects, and locates, typing errors"@en ; skos:definition "Bech32 is guaranteed to detect any error affecting four characters or fewer, and Bitcoin Core points to where a typing error is, while bech32's original constant let a q be added before a final p without detection, which bech32m fixes."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_DefaultAddressType a owl:NamedIndividual, chx:DefaultAddressType ; rdfs:label "bech32 by default, bech32m on request"@en ; skos:definition "Bitcoin Core's addresstype option defaults to bech32, a P2WPKH address, and the four types are legacy, p2sh-segwit, bech32 and bech32m, the last a taproot address."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_KeyExport a owl:NamedIndividual, chx:KeyExport ; rdfs:label "no dumpprivkey any more"@en ; skos:definition "Deterministic descriptor wallets no longer export single keys, and Bitcoin Core removed dumpprivkey and importprivkey in 30.0, while a WIF key can still be used inside a descriptor."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_PassphraseProtection a owl:NamedIndividual, chx:PassphraseProtection ; rdfs:label "BIP38"@en ; skos:definition "BIP38 encrypts a private key under a passphrase; the BIPs repository lists it as Deployed with the comment summary Unanimously Discourage for implementation, and the 3rd edition does not cover it."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_VanityAddress a owl:NamedIndividual, chx:VanityAddress ; rdfs:label "1Kids and 58 to the fourth"@en ; skos:definition "A vanity address starts with a chosen string found by trying keys one after another, and each further character multiplies the work by 58, so four characters take 58 to the fourth, about 11 million keys."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_VanityAddress a owl:NamedIndividual, rd:IOExample ; rdfs:label "58**4 evaluates to 11316496"@en ; chx:input "58**4" ; chx:output "11316496" .
chx:X_VanityAddress rd:hasIOExample chx:IO_VanityAddress .
chx:X_PaperWallet a owl:NamedIndividual, chx:PaperWallet ; rdfs:label "a private key on paper"@en ; skos:definition "A paper wallet is a private key printed on paper, which the 3rd edition calls an obsolete technology and dangerous for most users."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_TestVectors a owl:NamedIndividual, chx:TestVectors ; rdfs:label "BIP350's list of valid and invalid addresses"@en ; skos:definition "The BIP350 test vectors give valid and invalid segwit addresses and bech32m strings against which any bech32m implementation should be run, including those for future witness versions."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_KeyControlProof a owl:NamedIndividual, chx:KeyControlProof ; rdfs:label "signing to prove control"@en ; skos:definition "Whoever holds a private key can prove control of the matching public key by signing, without a central registry or anyone's permission."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_DecentralizedIdentifier a owl:NamedIndividual, chx:DecentralizedIdentifier ; rdfs:label "a DID and its DID document"@en ; skos:definition "A decentralized identifier is a URI that associates a subject with a DID document that can carry verification methods such as public keys, so its controller can prove control without permission from another party."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 4 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch04/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 4 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which examples, figures and statements of the chapter can be reproduced by execution, and by independent software, and what does the execution give?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What in the chapter differs from primary sources or from Bitcoin Core as it is now, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 4 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from Mastering Bitcoin 3rd edition's chapter 4 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0401/ch04/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-09-29."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_0_0.py" .

