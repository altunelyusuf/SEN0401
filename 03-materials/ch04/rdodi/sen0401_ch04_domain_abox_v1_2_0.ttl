chx:X_InputScript chx:hasOwner chx:X_P2pk .
chx:Err_BitsAndBytes a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "bytes.fromhex('abc') raises ValueError: fromhex() arg must contain an even number of hexadecimal digits"@en .
chx:X_BitsAndBytes rd:hasErrorCondition chx:Err_BitsAndBytes .
chx:Err_NumberBase a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "int('0O', 16) raises ValueError: invalid literal for int() with base 16"@en .
chx:X_NumberBase rd:hasErrorCondition chx:Err_NumberBase .
chx:Err_FiniteField a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "pow(0, -1, 17) raises ValueError: base is not invertible for the given modulus"@en .
chx:X_FiniteField rd:hasErrorCondition chx:Err_FiniteField .
chx:Err_Sha256 a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('hashlib').sha256('abc') raises TypeError: Strings must be encoded before hashing"@en .
chx:X_Sha256 rd:hasErrorCondition chx:Err_Sha256 .
chx:Err_Ripemd160 a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('hashlib').new('ripemd160', 'abc') raises TypeError: Strings must be encoded before hashing"@en .
chx:X_Ripemd160 rd:hasErrorCondition chx:Err_Ripemd160 .
chx:Err_PrivateKey a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(2 ** 256).to_bytes(32, 'big') raises OverflowError: int too big to convert"@en .
chx:X_PrivateKey rd:hasErrorCondition chx:Err_PrivateKey .
chx:Err_Checksum a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(__import__('sys').path.insert(0, '/home/claude/sen0401/08-tooling') or __import__('sen0401_ch04_keys_v1_1_0')).b58check_decode('1J7mdg5rbQyUHENYdx39WVWK7fsLpEoXZz') raises AssertionError: checksum does not match"@en .
chx:X_Checksum rd:hasErrorCondition chx:Err_Checksum .
chx:Err_Base58Check a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(__import__('sys').path.insert(0, '/home/claude/sen0401/08-tooling') or __import__('sen0401_ch04_keys_v1_1_0')).b58check_decode('1J7mdg5rbQyUHENYdx39WVWK7fsLpEoX0y') raises ValueError: substring not found"@en .
chx:X_Base58Check rd:hasErrorCondition chx:Err_Base58Check .
chx:Err_CompressedPublicKey a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(__import__('sys').path.insert(0, '/home/claude/sen0401/08-tooling') or __import__('sen0401_ch04_keys_v1_1_0')).decompress(bytes.fromhex('02' + '00' * 32)) raises AssertionError: x is not on the curve"@en .
chx:X_CompressedPublicKey rd:hasErrorCondition chx:Err_CompressedPublicKey .
chx:Err_Bech32Address a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(__import__('sys').path.insert(0, '/home/claude/sen0401/08-tooling') or __import__('sen0401_ch04_keys_v1_1_0')).CHARSET.index('b') raises ValueError: substring not found"@en .
chx:X_Bech32Address rd:hasErrorCondition chx:Err_Bech32Address .
chx:Err_WalletImportFormat a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(__import__('sys').path.insert(0, '/home/claude/sen0401/08-tooling') or __import__('sen0401_ch04_keys_v1_1_0')).wif(2 ** 256) raises OverflowError: int too big to convert"@en .
chx:X_WalletImportFormat rd:hasErrorCondition chx:Err_WalletImportFormat .
chx:Err_ErrorDetection a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(__import__('sys').path.insert(0, '/home/claude/sen0401/08-tooling') or __import__('sen0401_ch04_keys_v1_1_0')).segwit_decode('bc', 'bc1q9d3xa5gg45q2j39m9y32xzvygcgay4rgc6aaef')[0] raises TypeError: 'NoneType' object is not subscriptable"@en .
chx:X_ErrorDetection rd:hasErrorCondition chx:Err_ErrorDetection .

chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 4 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch04/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 4 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2, chx:CQ3, chx:CQ4, chx:CQ5, chx:CQ6 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How does a private key become a public key, which constants of the secp256k1 standard does the calculation use, and why can the calculation not be run backwards?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which encodings can one and the same key or commitment appear in, what does each encoding add, and which first characters does each produce?"@en .
chx:CQ3 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which output script does each kind of address stand for, how is the script built from the address, and how does a node decide whether a spend of it is allowed?"@en .
chx:CQ4 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What does the checksum of each address format guarantee, which errors does it fail to catch, and what did the length extension weakness of bech32 change?"@en .
chx:CQ5 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Where do the statements and numbers of the 3rd edition's chapter 4 differ from the primary standards and from a run of Bitcoin Core 31.1, and what does each difference change?"@en .
chx:CQ6 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which terms do the explanations of this chapter rely on, and is each one a concept of this chapter or of an earlier chapter?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 4 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 4 through the Stage 1 research record; the explanations were rewritten for version 1.1.0 from the documents and files listed at the head of this module, each read for this version, and every quotation, number, address, script and encoding is re-checked by a claim that the chapter builder executes; the supporting concepts (the finite field, the elliptic curve, point addition, the generator point, the discrete logarithm, the cryptographic library, the hash function, SHA256, RIPEMD-160, HASH160, bits and bytes, number bases, the QR code, the checksum, the network selector, output and input scripts, the stack machine, the payment to an IP address, the redeem script, the multisignature script, the preimage, second preimage and collision attacks, the segregated witness upgrade, nested segwit, the witness version, the witness program, the human-readable part, the BCH code, the length extension weakness, the three witness output kinds, the deterministic wallet, address reuse, the hardware signing device, the test vectors, cross-checking and the uniform resource identifier) were added because an audit of the explanations found them used without a concept of their own."@en ;
    dcterms:source <http://example.org/sen0401/ch04/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (478 checks listed in sen0401_ch04_corpus_v1_2_0.py), executed under CPython 3.14.4."@en ;
    dcterms:source "The execution run of this ontology's build, 08-tooling/sen0401_chapter_build_v1_0_1.py, over the claims in 08-tooling/sen0401_ch04_corpus_v1_2_0.py" .

