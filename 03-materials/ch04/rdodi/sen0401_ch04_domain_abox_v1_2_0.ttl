    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:created "2026-09-29"^^xsd:date ; dcterms:modified "2026-10-05"^^xsd:date ;
    dcterms:identifier "sen0401_ch04_abox_v1_2_0" ; prov:wasRevisionOf <http://example.org/sen0401/ch04/abox/1.1.0> ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/ch04-rdodi-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

chx:X_PublicKeyCryptography a owl:NamedIndividual, chx:PublicKeyCryptography ; rdfs:label "signatures, not secrecy"@en ; skos:definition "Public key cryptography lets a private key produce a signature that anyone can check against the public key, which is what Bitcoin uses it for, not for encrypting transactions."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_PublicKeyCryptography a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda priv, pub: (len(bytes.fromhex(priv)), len(bytes.fromhex(pub)), len(bytes.fromhex(pub)) - len(bytes.fromhex(priv))))('1E99423A4ED27608A15A2616A2B0E9E52CED330AC530EDCC32C8FFC6A526AEDD', '0279BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798') evaluates to (32, 33, 1)"@en ; chx:input "(lambda priv, pub: (len(bytes.fromhex(priv)), len(bytes.fromhex(pub)), len(bytes.fromhex(pub)) - len(bytes.fromhex(priv))))('1E99423A4ED27608A15A2616A2B0E9E52CED330AC530EDCC32C8FFC6A526AEDD', '0279BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798')" ; chx:output "(32, 33, 1)" .
chx:X_PublicKeyCryptography rd:hasIOExample chx:IO_PublicKeyCryptography .
chx:X_DigitalSignature a owl:NamedIndividual, chx:DigitalSignature ; rdfs:label "a number only the key holder can produce"@en ; skos:definition "A digital signature is a number computed from a message and a private key that anyone holding the public key can verify, and that cannot be produced without the private key."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_DigitalSignature a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda h, a, b: sum(bin(x ^ y).count('1') for x, y in zip(h(a), h(b))))(lambda m: __import__('hashlib').sha256(m).digest(), b'pay Bob 1 BTC', b'pay Bob 2 BTC') evaluates to 135"@en ; chx:input "(lambda h, a, b: sum(bin(x ^ y).count('1') for x, y in zip(h(a), h(b))))(lambda m: __import__('hashlib').sha256(m).digest(), b'pay Bob 1 BTC', b'pay Bob 2 BTC')" ; chx:output "135" .
chx:X_DigitalSignature rd:hasIOExample chx:IO_DigitalSignature .
chx:X_PrivateKey a owl:NamedIndividual, chx:PrivateKey ; rdfs:label "a random number below n"@en ; skos:definition "A private key is a number picked at random between 1 and n minus 1, where n, about 1.1579 times 10 to the 77, is the order of the curve and slightly less than 2 to the 256."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_PrivateKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "2**256 - 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141 evaluates to 432420386565659656852420866394968145599"@en ; chx:input "2**256 - 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141" ; chx:output "432420386565659656852420866394968145599" .
chx:X_PrivateKey rd:hasIOExample chx:IO_PrivateKey .
chx:X_PublicKey a owl:NamedIndividual, chx:PublicKey ; rdfs:label "K = k x G"@en ; skos:definition "A public key is the point K = k x G obtained by multiplying the generator point by the private key, which is easy in one direction and infeasible to reverse."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_PublicKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "'03' if 0x07CF33DA18BD734C600B96A72BBC4749D5141C90EC8AC328AE52DDFE2E505BDB % 2 else '02' evaluates to '03'"@en ; chx:input "'03' if 0x07CF33DA18BD734C600B96A72BBC4749D5141C90EC8AC328AE52DDFE2E505BDB % 2 else '02'" ; chx:output "'03'" .
chx:X_PublicKey rd:hasIOExample chx:IO_PublicKey .
chx:X_Entropy a owl:NamedIndividual, chx:Entropy ; rdfs:label "a coin tossed 256 times"@en ; skos:definition "Entropy is unpredictability measured in bits; a private key needs 256 bits of it, as many as 256 fair coin tosses supply."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Entropy a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(__import__('math').log10(2**256), 2) evaluates to 77.06"@en ; chx:input "round(__import__('math').log10(2**256), 2)" ; chx:output "77.06" .
chx:X_Entropy rd:hasIOExample chx:IO_Entropy .
chx:X_SecureRandomness a owl:NamedIndividual, chx:SecureRandomness ; rdfs:label "secrets rather than random"@en ; skos:definition "A private key must come from a cryptographically secure random generator; Python's secrets module is documented for that use and its random module for modelling and simulation."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_SecureRandomness a owl:NamedIndividual, rd:IOExample ; rdfs:label "0 < __import__('secrets').randbelow(0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141 - 1) + 1 < 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141 evaluates to True"@en ; chx:input "0 < __import__('secrets').randbelow(0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141 - 1) + 1 < 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141" ; chx:output "True" .
chx:X_SecureRandomness rd:hasIOExample chx:IO_SecureRandomness .
chx:X_FiniteField a owl:NamedIndividual, chx:FiniteField ; rdfs:label "arithmetic modulo a prime"@en ; skos:definition "A finite field of prime order p is the whole numbers from 0 to p - 1 with addition, subtraction, multiplication and division carried out modulo p; division by 5 modulo 17 is multiplication by 7."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_FiniteField a owl:NamedIndividual, rd:IOExample ; rdfs:label "pow(5, -1, 17) evaluates to 7"@en ; chx:input "pow(5, -1, 17)" ; chx:output "7" .
chx:X_FiniteField rd:hasIOExample chx:IO_FiniteField .
chx:X_EllipticCurve a owl:NamedIndividual, chx:EllipticCurve ; rdfs:label "y squared = x cubed + 7"@en ; skos:definition "An elliptic curve is the set of points (x, y) that satisfy an equation such as y squared = x cubed + 7, together with a point at infinity; over the field with 17 elements the curve y squared = x cubed + 7 has 17 points besides the point at infinity."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_EllipticCurve a owl:NamedIndividual, rd:IOExample ; rdfs:label "sum(1 for x in range(17) for y in range(17) if (y * y - x ** 3 - 7) % 17 == 0) evaluates to 17"@en ; chx:input "sum(1 for x in range(17) for y in range(17) if (y * y - x ** 3 - 7) % 17 == 0)" ; chx:output "17" .
chx:X_EllipticCurve rd:hasIOExample chx:IO_EllipticCurve .
chx:X_PointAddition a owl:NamedIndividual, chx:PointAddition ; rdfs:label "(1, 5) + (2, 7) = (1, 12)"@en ; skos:definition "Two points of the curve are added by drawing a line through them, finding the third intersection and reflecting it in the x-axis; the point at infinity plays the role of zero."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_PointAddition a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a, b, p: (lambda m: (lambda x: (x, (m * (a[0] - x) - a[1]) % p))((m * m - a[0] - b[0]) % p))((b[1] - a[1]) * pow(b[0] - a[0], -1, p) % p))((1, 5), (2, 7), 17) evaluates to (1, 12)"@en ; chx:input "(lambda a, b, p: (lambda m: (lambda x: (x, (m * (a[0] - x) - a[1]) % p))((m * m - a[0] - b[0]) % p))((b[1] - a[1]) * pow(b[0] - a[0], -1, p) % p))((1, 5), (2, 7), 17)" ; chx:output "(1, 12)" .
chx:X_PointAddition rd:hasIOExample chx:IO_PointAddition .
chx:X_Secp256k1 a owl:NamedIndividual, chx:Secp256k1 ; rdfs:label "y squared = x cubed + 7 over F(p)"@en ; skos:definition "The secp256k1 curve, y squared = x cubed + 7 over the prime field with p = 2 to the 256 minus 2 to the 32 minus 977, is defined in SEC 2 by Certicom Research and is not a NIST-recommended curve."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Secp256k1 a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda p, x, y: (x ** 3 + 7 - y ** 2) % p)(115792089237316195423570985008687907853269984665640564039457584007908834671663, 55066263022277343669578718895168534326250603453777594175500187360389116729240, 32670510020758816978083085130507043184471273380659243275938904335757337482424) evaluates to 0"@en ; chx:input "(lambda p, x, y: (x ** 3 + 7 - y ** 2) % p)(115792089237316195423570985008687907853269984665640564039457584007908834671663, 55066263022277343669578718895168534326250603453777594175500187360389116729240, 32670510020758816978083085130507043184471273380659243275938904335757337482424)" ; chx:output "0" .
chx:X_Secp256k1 rd:hasIOExample chx:IO_Secp256k1 .
chx:X_CurveStandard a owl:NamedIndividual, chx:CurveStandard ; rdfs:label "secp256k1 and secp256r1"@en ; skos:definition "SEC 2 lists recommended curve parameters with a table of which other standards each conforms to; secp256k1 is marked as not on the NIST list and secp256r1 is marked as recommended by it."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_CurveStandard a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda table: [(n, nist) for n, sec, nist in table if n.startswith('secp256')])([('secp192k1', '2.2.1', '-'), ('secp192r1', '2.2.2', 'r'), ('secp224k1', '2.3.1', '-'), ('secp224r1', '2.3.2', 'r'), ('secp256k1', '2.4.1', '-'), ('secp256r1', '2.4.2', 'r')]) evaluates to [('secp256k1', '-'), ('secp256r1', 'r')]"@en ; chx:input "(lambda table: [(n, nist) for n, sec, nist in table if n.startswith('secp256')])([('secp192k1', '2.2.1', '-'), ('secp192r1', '2.2.2', 'r'), ('secp224k1', '2.3.1', '-'), ('secp224r1', '2.3.2', 'r'), ('secp256k1', '2.4.1', '-'), ('secp256r1', '2.4.2', 'r')])" ; chx:output "[('secp256k1', '-'), ('secp256r1', 'r')]" .
chx:X_CurveStandard rd:hasIOExample chx:IO_CurveStandard .
chx:X_GeneratorPoint a owl:NamedIndividual, chx:GeneratorPoint ; rdfs:label "G, the same for every key"@en ; skos:definition "The generator point G is the fixed point of the secp256k1 standard from which every public key is reached by multiplication; adding it to itself n times gives the point at infinity."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_GeneratorPoint a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda x, y: ('02' if y % 2 == 0 else '03') + format(x, '064x'))(0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8) evaluates to '0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798'"@en ; chx:input "(lambda x, y: ('02' if y % 2 == 0 else '03') + format(x, '064x'))(0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798, 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)" ; chx:output "'0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798'" .
chx:X_GeneratorPoint rd:hasIOExample chx:IO_GeneratorPoint .
chx:X_PointMultiplication a owl:NamedIndividual, chx:PointMultiplication ; rdfs:label "double and add"@en ; skos:definition "Multiplying a point by a whole number k means adding it to itself k times, which the double-and-add method does in about 256 doublings and additions; for the book's key it is 252 doublings and 123 additions."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_PointMultiplication a owl:NamedIndividual, rd:IOExample ; rdfs:label "(0x1E99423A4ED27608A15A2616A2B0E9E52CED330AC530EDCC32C8FFC6A526AEDD.bit_length() - 1, bin(0x1E99423A4ED27608A15A2616A2B0E9E52CED330AC530EDCC32C8FFC6A526AEDD).count('1') - 1) evaluates to (252, 123)"@en ; chx:input "(0x1E99423A4ED27608A15A2616A2B0E9E52CED330AC530EDCC32C8FFC6A526AEDD.bit_length() - 1, bin(0x1E99423A4ED27608A15A2616A2B0E9E52CED330AC530EDCC32C8FFC6A526AEDD).count('1') - 1)" ; chx:output "(252, 123)" .
chx:X_PointMultiplication rd:hasIOExample chx:IO_PointMultiplication .
chx:X_DiscreteLogarithm a owl:NamedIndividual, chx:DiscreteLogarithm ; rdfs:label "finding k from K"@en ; skos:definition "Finding the multiplier k from K = kG is the discrete logarithm problem; with no shortcut it is as hard as trying every value of k, a brute-force search; in a toy group modulo 101 it takes 9 tries to find that 2 to the power 9 leaves 7."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_DiscreteLogarithm a owl:NamedIndividual, rd:IOExample ; rdfs:label "next(k for k in range(1, 101) if pow(2, k, 101) == 7) evaluates to 9"@en ; chx:input "next(k for k in range(1, 101) if pow(2, k, 101) == 7)" ; chx:output "9" .
chx:X_DiscreteLogarithm rd:hasIOExample chx:IO_DiscreteLogarithm .
chx:X_CryptoLibrary a owl:NamedIndividual, chx:CryptoLibrary ; rdfs:label "libsecp256k1"@en ; skos:definition "A cryptographic library is tested, reusable code for the elliptic curve math; the book notes that many Bitcoin implementations use libsecp256k1, and this chapter's toolkit is only a readable sketch of the same calculation."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_CryptoLibrary a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda src: (len(src.splitlines()), len(src.splitlines()) < 20))('def ec_add(a, b):\\n    if a is None: return b\\n    if b is None: return a\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return (x, (m * (a[0] - x) - a[1]) % P)\\ndef ec_mul(k, pt=G):\\n    out = None\\n    while k:\\n        if k & 1: out = ec_add(out, pt)\\n        pt = ec_add(pt, pt); k >>= 1\\n    return out') evaluates to (13, True)"@en ; chx:input "(lambda src: (len(src.splitlines()), len(src.splitlines()) < 20))('def ec_add(a, b):\\n    if a is None: return b\\n    if b is None: return a\\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\\n    x = (m * m - a[0] - b[0]) % P\\n    return (x, (m * (a[0] - x) - a[1]) % P)\\ndef ec_mul(k, pt=G):\\n    out = None\\n    while k:\\n        if k & 1: out = ec_add(out, pt)\\n        pt = ec_add(pt, pt); k >>= 1\\n    return out')" ; chx:output "(13, True)" .
chx:X_CryptoLibrary rd:hasIOExample chx:IO_CryptoLibrary .
chx:X_HashFunction a owl:NamedIndividual, chx:HashFunction ; rdfs:label "same input, same output"@en ; skos:definition "A hash function takes a potentially large amount of data and outputs a fixed amount of data; a cryptographic hash function always gives the same output for the same input, and changing one bit of the input changes about half of the output bits."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_HashFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "bin(int(__import__('hashlib').sha256(b'a').hexdigest(), 16) ^ int(__import__('hashlib').sha256(b'`').hexdigest(), 16)).count('1') evaluates to 139"@en ; chx:input "bin(int(__import__('hashlib').sha256(b'a').hexdigest(), 16) ^ int(__import__('hashlib').sha256(b'`').hexdigest(), 16)).count('1')" ; chx:output "139" .
chx:X_HashFunction rd:hasIOExample chx:IO_HashFunction .
chx:X_Sha256 a owl:NamedIndividual, chx:Sha256 ; rdfs:label "32 bytes of output"@en ; skos:definition "SHA256 is the hash function most commonly used in Bitcoin; its output is 256 bits (32 bytes), and the SHA256 of the three bytes abc begins ba7816bf."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Sha256 a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hashlib').sha256(b'abc').hexdigest()[:8] evaluates to 'ba7816bf'"@en ; chx:input "__import__('hashlib').sha256(b'abc').hexdigest()[:8]" ; chx:output "'ba7816bf'" .
chx:X_Sha256 rd:hasIOExample chx:IO_Sha256 .
chx:X_Ripemd160 a owl:NamedIndividual, chx:Ripemd160 ; rdfs:label "20 bytes of output"@en ; skos:definition "RIPEMD-160 is a hash function with a 160-bit (20-byte) output; Bitcoin applies it to the SHA256 of a public key to obtain a 20-byte commitment."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Ripemd160 a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (len(bytes.fromhex(d)), len(bytes.fromhex(d)) * 8))('bbc1e42a39d05a4cc61752d6963b7f69d09bb27b') evaluates to (20, 160)"@en ; chx:input "(lambda d: (len(bytes.fromhex(d)), len(bytes.fromhex(d)) * 8))('bbc1e42a39d05a4cc61752d6963b7f69d09bb27b')" ; chx:output "(20, 160)" .
chx:X_Ripemd160 rd:hasIOExample chx:IO_Ripemd160 .
chx:X_Hash160 a owl:NamedIndividual, chx:Hash160 ; rdfs:label "RIPEMD160(SHA256(K))"@en ; skos:definition "HASH160 is the RIPEMD-160 of the SHA256 of the data; for the book's compressed example key it is bbc1e42a39d05a4cc61752d6963b7f69d09bb27b, and the uncompressed form of the same key gives a different value."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Hash160 a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c, u: (len(bytes.fromhex(c)), len(bytes.fromhex(u)), c == u))('bbc1e42a39d05a4cc61752d6963b7f69d09bb27b', '211b74ca4686f81efda5641767fc84ef16dafe0b') evaluates to (20, 20, False)"@en ; chx:input "(lambda c, u: (len(bytes.fromhex(c)), len(bytes.fromhex(u)), c == u))('bbc1e42a39d05a4cc61752d6963b7f69d09bb27b', '211b74ca4686f81efda5641767fc84ef16dafe0b')" ; chx:output "(20, 20, False)" .
chx:X_Hash160 rd:hasIOExample chx:IO_Hash160 .
chx:X_BitsAndBytes a owl:NamedIndividual, chx:BitsAndBytes ; rdfs:label "65 bytes is 520 bits"@en ; skos:definition "A bit is a binary digit, 0 or 1; a byte is 8 bits; a public key of 65 bytes has 520 bits, and each hexadecimal digit stands for 4 bits."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_BitsAndBytes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(65 * 8, 33 * 8) evaluates to (520, 264)"@en ; chx:input "(65 * 8, 33 * 8)" ; chx:output "(520, 264)" .
chx:X_BitsAndBytes rd:hasIOExample chx:IO_BitsAndBytes .
chx:X_NumberBase a owl:NamedIndividual, chx:NumberBase ; rdfs:label "ff is 255"@en ; skos:definition "A number base, or radix, is the count of different symbols used to write numbers; hexadecimal uses 16, base64 uses 64 and base58 uses 58, and the same number is shorter in a larger base."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_NumberBase a owl:NamedIndividual, rd:IOExample ; rdfs:label "(int('ff', 16), int('11111111', 2)) evaluates to (255, 255)"@en ; chx:input "(int('ff', 16), int('11111111', 2))" ; chx:output "(255, 255)" .
chx:X_NumberBase rd:hasIOExample chx:IO_NumberBase .
chx:X_QrCode a owl:NamedIndividual, chx:QrCode ; rdfs:label "an address as a picture"@en ; skos:definition "A QR code is a two-dimensional barcode that a camera can read; its alphanumeric mode makes uppercase text about 45 percent more compact than the normal byte mode, which is why bech32 addresses are put into QR codes in uppercase."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_QrCode a owl:NamedIndividual, rd:IOExample ; rdfs:label "'BC1Q9D3XA5GG45Q2J39M9Y32XZVYGCGAY4RGC6AAEE'.lower() evaluates to 'bc1q9d3xa5gg45q2j39m9y32xzvygcgay4rgc6aaee'"@en ; chx:input "'BC1Q9D3XA5GG45Q2J39M9Y32XZVYGCGAY4RGC6AAEE'.lower()" ; chx:output "'bc1q9d3xa5gg45q2j39m9y32xzvygcgay4rgc6aaee'" .
chx:X_QrCode rd:hasIOExample chx:IO_QrCode .
chx:X_CompressedPublicKey a owl:NamedIndividual, chx:CompressedPublicKey ; rdfs:label "33 bytes: 02 or 03 and x"@en ; skos:definition "A compressed public key keeps only x and one byte for the parity of y, 33 bytes instead of 65, and the y coordinate is recovered by solving the curve equation."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_CompressedPublicKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(1 - 33 / 65, 3) evaluates to 0.492"@en ; chx:input "round(1 - 33 / 65, 3)" ; chx:output "0.492" .
chx:X_CompressedPublicKey rd:hasIOExample chx:IO_CompressedPublicKey .
chx:X_UncompressedPublicKey a owl:NamedIndividual, chx:UncompressedPublicKey ; rdfs:label "65 bytes: 04, x and y"@en ; skos:definition "An uncompressed public key is the prefix 04 followed by the x and y coordinates, 65 bytes, and it hashes to a different address than the compressed form of the same key."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_UncompressedPublicKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(bytes.fromhex('04F028892BAD7ED57D2FB57BF33081D5CFCF6F9ED3D3D7F159C2E2FFF579DC341A07CF33DA18BD734C600B96A72BBC4749D5141C90EC8AC328AE52DDFE2E505BDB')) evaluates to 65"@en ; chx:input "len(bytes.fromhex('04F028892BAD7ED57D2FB57BF33081D5CFCF6F9ED3D3D7F159C2E2FFF579DC341A07CF33DA18BD734C600B96A72BBC4749D5141C90EC8AC328AE52DDFE2E505BDB'))" ; chx:output "65" .
chx:X_UncompressedPublicKey rd:hasIOExample chx:IO_UncompressedPublicKey .
chx:X_WalletImportFormat a owl:NamedIndividual, chx:WalletImportFormat ; rdfs:label "5J3m... and KxFC..."@en ; skos:definition "The wallet import format is the base58check encoding of version byte 0x80 and the private key, with a 0x01 suffix for the compressed form, which changes the first character from 5 to K or L."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_WalletImportFormat a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda h, d: (lambda n: ''.join('123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'[n // 58 ** i % 58] for i in range(60)[::-1]).lstrip('1'))(int.from_bytes(d + h(h(d).digest()).digest()[:4], 'big')))(__import__('hashlib').sha256, bytes.fromhex('801E99423A4ED27608A15A2616A2B0E9E52CED330AC530EDCC32C8FFC6A526AEDD')) evaluates to '5J3mBbAH58CpQ3Y5RNJpUKPE62SQ5tfcvU2JpbnkeyhfsYB1Jcn'"@en ; chx:input "(lambda h, d: (lambda n: ''.join('123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'[n // 58 ** i % 58] for i in range(60)[::-1]).lstrip('1'))(int.from_bytes(d + h(h(d).digest()).digest()[:4], 'big')))(__import__('hashlib').sha256, bytes.fromhex('801E99423A4ED27608A15A2616A2B0E9E52CED330AC530EDCC32C8FFC6A526AEDD'))" ; chx:output "'5J3mBbAH58CpQ3Y5RNJpUKPE62SQ5tfcvU2JpbnkeyhfsYB1Jcn'" .
chx:X_WalletImportFormat rd:hasIOExample chx:IO_WalletImportFormat .
chx:X_CompressedPrivateKey a owl:NamedIndividual, chx:CompressedPrivateKey ; rdfs:label "a misnomer: one byte longer"@en ; skos:definition "A 'compressed private key' is not compressed: it is the private key followed by a one-byte suffix 01 that says only compressed public keys should be derived from it, so its WIF is one character longer."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_CompressedPrivateKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "len('KxFC1jmwwCoACiCAWZ3eXa96mBM6tb3TYzGmf6YwgdGWZgawvrtJ') - len('5J3mBbAH58CpQ3Y5RNJpUKPE62SQ5tfcvU2JpbnkeyhfsYB1Jcn') evaluates to 1"@en ; chx:input "len('KxFC1jmwwCoACiCAWZ3eXa96mBM6tb3TYzGmf6YwgdGWZgawvrtJ') - len('5J3mBbAH58CpQ3Y5RNJpUKPE62SQ5tfcvU2JpbnkeyhfsYB1Jcn')" ; chx:output "1" .
chx:X_CompressedPrivateKey rd:hasIOExample chx:IO_CompressedPrivateKey .
chx:X_Checksum a owl:NamedIndividual, chx:Checksum ; rdfs:label "four bytes that catch typos"@en ; skos:definition "A checksum is a short value computed from data and attached to it so that a changed copy can be detected; base58check uses the first four bytes of a double SHA256, a mistyped address fails the check."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Checksum a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: __import__('hashlib').sha256(__import__('hashlib').sha256(d[:21]).digest()).digest()[:4] == d[21:])(sum('123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'.index(c) * 58 ** i for i, c in enumerate('1J7mdg5rbQyUHENYdx39WVWK7fsLpEoXZy'[::-1])).to_bytes(25, 'big')) evaluates to True"@en ; chx:input "(lambda d: __import__('hashlib').sha256(__import__('hashlib').sha256(d[:21]).digest()).digest()[:4] == d[21:])(sum('123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'.index(c) * 58 ** i for i, c in enumerate('1J7mdg5rbQyUHENYdx39WVWK7fsLpEoXZy'[::-1])).to_bytes(25, 'big'))" ; chx:output "True" .
chx:X_Checksum rd:hasIOExample chx:IO_Checksum .
chx:X_Base58Check a owl:NamedIndividual, chx:Base58Check ; rdfs:label "an alphabet without 0, O, l and I"@en ; skos:definition "Base58check encodes a version byte, the data and the first four bytes of a double SHA-256 checksum in a 58-character alphabet that leaves out the characters easily mistaken for each other."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Base58Check a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hashlib').sha256(__import__('hashlib').sha256(bytes.fromhex('801E99423A4ED27608A15A2616A2B0E9E52CED330AC530EDCC32C8FFC6A526AEDD')).digest()).digest()[:4].hex() evaluates to 'c47e83ff'"@en ; chx:input "__import__('hashlib').sha256(__import__('hashlib').sha256(bytes.fromhex('801E99423A4ED27608A15A2616A2B0E9E52CED330AC530EDCC32C8FFC6A526AEDD')).digest()).digest()[:4].hex()" ; chx:output "'c47e83ff'" .
chx:X_Base58Check rd:hasIOExample chx:IO_Base58Check .
chx:X_VersionPrefix a owl:NamedIndividual, chx:VersionPrefix ; rdfs:label "0x00 gives 1, 0x05 gives 3"@en ; skos:definition "The version byte makes the encoded text start with a recognisable character: 1 for a P2PKH address, 3 for P2SH, 5, K or L for a WIF key, and xpub for a BIP32 extended public key."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_VersionPrefix a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda B58, h, payload: tuple((lambda p: (lambda full: '1' * (len(full) - len(full.lstrip(bytes([0])))) + (lambda n: ''.join(B58[n // 58 ** i % 58] for i in range(40)[::-1]).lstrip('1'))(int.from_bytes(full, 'big')))(p + h(h(p).digest()).digest()[:4]))(bytes([v]) + payload)[0] for v in (0x00, 0x05, 0x6f)))('123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz', __import__('hashlib').sha256, bytes.fromhex('bbc1e42a39d05a4cc61752d6963b7f69d09bb27b')) evaluates to ('1', '3', 'm')"@en ; chx:input "(lambda B58, h, payload: tuple((lambda p: (lambda full: '1' * (len(full) - len(full.lstrip(bytes([0])))) + (lambda n: ''.join(B58[n // 58 ** i % 58] for i in range(40)[::-1]).lstrip('1'))(int.from_bytes(full, 'big')))(p + h(h(p).digest()).digest()[:4]))(bytes([v]) + payload)[0] for v in (0x00, 0x05, 0x6f)))('123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz', __import__('hashlib').sha256, bytes.fromhex('bbc1e42a39d05a4cc61752d6963b7f69d09bb27b'))" ; chx:output "('1', '3', 'm')" .
chx:X_VersionPrefix rd:hasIOExample chx:IO_VersionPrefix .
chx:X_NetworkSelector a owl:NamedIndividual, chx:NetworkSelector ; rdfs:label "bc and tb, 0x00 and 0x6F"@en ; skos:definition "The main network and a test network are separate chains with their own data; addresses show which one they belong to through the version byte of base58check (0x00 against 0x6F for P2PKH) or through the human-readable part of bech32 (bc against tb)."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_NetworkSelector a owl:NamedIndividual, rd:IOExample ; rdfs:label "('bc1q9d3xa5gg45q2j39m9y32xzvygcgay4rgc6aaee'[:2], 'tb1qw508d6qejxtdg4y5r3zarvary0c5xw7kxpjzsx'[:2]) evaluates to ('bc', 'tb')"@en ; chx:input "('bc1q9d3xa5gg45q2j39m9y32xzvygcgay4rgc6aaee'[:2], 'tb1qw508d6qejxtdg4y5r3zarvary0c5xw7kxpjzsx'[:2])" ; chx:output "('bc', 'tb')" .
chx:X_NetworkSelector rd:hasIOExample chx:IO_NetworkSelector .
chx:X_OutputScript a owl:NamedIndividual, chx:OutputScript ; rdfs:label "the lock on an output"@en ; skos:definition "An output script is the condition that a transaction output places on its spender; the script of a P2PKH output for the book's key is the 25 bytes 76a914, the 20-byte HASH160 of the key, and 88ac."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_OutputScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(bytes.fromhex('76a914bbc1e42a39d05a4cc61752d6963b7f69d09bb27b88ac')) evaluates to 25"@en ; chx:input "len(bytes.fromhex('76a914bbc1e42a39d05a4cc61752d6963b7f69d09bb27b88ac'))" ; chx:output "25" .
chx:X_OutputScript rd:hasIOExample chx:IO_OutputScript .
chx:X_InputScript a owl:NamedIndividual, chx:InputScript ; rdfs:label "the key that opens the lock"@en ; skos:definition "An input script supplies the data that satisfies the output script of the output being spent; for a P2PKH output it consists of a signature and the public key, with the public key on top of the stack."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_InputScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda stack: (stack[-1], stack[0], len(stack)))(['<Bob signature>', '<Bob public key>']) evaluates to ('<Bob public key>', '<Bob signature>', 2)"@en ; chx:input "(lambda stack: (stack[-1], stack[0], len(stack)))(['<Bob signature>', '<Bob public key>'])" ; chx:output "('<Bob public key>', '<Bob signature>', 2)" .
chx:X_InputScript rd:hasIOExample chx:IO_InputScript .
chx:X_StackExecution a owl:NamedIndividual, chx:StackExecution ; rdfs:label "push, operate, check the top"@en ; skos:definition "Scripts run on a stack: data is pushed on top of a list, each opcode consumes the topmost items and pushes its result, and the script passes if a nonzero item is on top at the end; OP_DUP copies the top item."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_StackExecution a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (s.append(s[-1]), s)[1])(['sig', 'pub']) evaluates to ['sig', 'pub', 'pub']"@en ; chx:input "(lambda s: (s.append(s[-1]), s)[1])(['sig', 'pub'])" ; chx:output "['sig', 'pub', 'pub']" .
chx:X_StackExecution rd:hasIOExample chx:IO_StackExecution .
chx:X_IpAddressPayment a owl:NamedIndividual, chx:IpAddressPayment ; rdfs:label "Bitcoin 0.1's send screen"@en ; skos:definition "The earliest Bitcoin software let a spender type the receiver's IP address; the spender's node contacted the receiver's node and obtained a new public key, but the receiver had to be online and reachable."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_IpAddressPayment a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda octets: (octets * 8, 2 ** (octets * 8)))(4) evaluates to (32, 4294967296)"@en ; chx:input "(lambda octets: (octets * 8, 2 ** (octets * 8)))(4)" ; chx:output "(32, 4294967296)" .
chx:X_IpAddressPayment rd:hasIOExample chx:IO_IpAddressPayment .
chx:X_P2pk a owl:NamedIndividual, chx:P2pk ; rdfs:label "<public key> OP_CHECKSIG"@en ; skos:definition "A pay to public key output locks funds with the receiver's public key and the opcode OP_CHECKSIG, and is spent with the signature alone; it was never widely used for payments."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_P2pk a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (s.pop(), s.pop(), s.append(1), s)[3])(['<Bob signature>', '<Bob public key>']) evaluates to [1]"@en ; chx:input "(lambda s: (s.pop(), s.pop(), s.append(1), s)[3])(['<Bob signature>', '<Bob public key>'])" ; chx:output "[1]" .
chx:X_P2pk rd:hasIOExample chx:IO_P2pk .
chx:X_Commitment a owl:NamedIndividual, chx:Commitment ; rdfs:label "a hash of the public key"@en ; skos:definition "A hash function output is a commitment to its input; Bitcoin commits to a public key with HASH160, the RIPEMD-160 of the SHA-256 of it, 20 bytes instead of 65."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Commitment a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hashlib').sha256(b'2007.  He said about a year and a half before Oct 2008\\n').hexdigest() evaluates to '94d7a772612c8f2f2ec609d41f5bd3d04a5aa1dfe3582f04af517d396a302e4e'"@en ; chx:input "__import__('hashlib').sha256(b'2007.  He said about a year and a half before Oct 2008\\n').hexdigest()" ; chx:output "'94d7a772612c8f2f2ec609d41f5bd3d04a5aa1dfe3582f04af517d396a302e4e'" .
chx:X_Commitment rd:hasIOExample chx:IO_Commitment .
chx:X_P2pkhAddress a owl:NamedIndividual, chx:P2pkhAddress ; rdfs:label "1J7mdg5rbQyUHENYdx39WVWK7fsLpEoXZy"@en ; skos:definition "A P2PKH address is the base58check encoding of version 0x00 and the HASH160 of the public key, and a compressed and an uncompressed key give two different addresses."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_P2pkhAddress a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda B58, a: (lambda n: (n.to_bytes(25, 'big')[0], len(n.to_bytes(25, 'big'))))(sum(B58.index(c) * 58 ** i for i, c in enumerate(a[::-1]))))('123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz', '1J7mdg5rbQyUHENYdx39WVWK7fsLpEoXZy') evaluates to (0, 25)"@en ; chx:input "(lambda B58, a: (lambda n: (n.to_bytes(25, 'big')[0], len(n.to_bytes(25, 'big'))))(sum(B58.index(c) * 58 ** i for i, c in enumerate(a[::-1]))))('123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz', '1J7mdg5rbQyUHENYdx39WVWK7fsLpEoXZy')" ; chx:output "(0, 25)" .
chx:X_P2pkhAddress rd:hasIOExample chx:IO_P2pkhAddress .
chx:X_RedeemScript a owl:NamedIndividual, chx:RedeemScript ; rdfs:label "a script revealed when spending"@en ; skos:definition "A redeem script is the script that a P2SH output commits to by its HASH160; it is revealed in the input script when the output is spent, and nodes check its hash before running it."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_RedeemScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "[0x14, 0x76, 0xa9, 0x87, 0x88, 0xac] evaluates to [20, 118, 169, 135, 136, 172]"@en ; chx:input "[0x14, 0x76, 0xa9, 0x87, 0x88, 0xac]" ; chx:output "[20, 118, 169, 135, 136, 172]" .
chx:X_RedeemScript rd:hasIOExample chx:IO_RedeemScript .
chx:X_MultisigScript a owl:NamedIndividual, chx:MultisigScript ; rdfs:label "2 of 3 keys"@en ; skos:definition "A multisignature script requires signatures from several keys; the opcode OP_CHECKMULTISIG checks m signatures against n public keys, as in BIP16's example of 2 of 3."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_MultisigScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda n: (3 + n * 34, 3 + (n + 1) * 34 > 520))(15) evaluates to (513, True)"@en ; chx:input "(lambda n: (3 + n * 34, 3 + (n + 1) * 34 > 520))(15)" ; chx:output "(513, True)" .
chx:X_MultisigScript rd:hasIOExample chx:IO_MultisigScript .
chx:X_P2shAddress a owl:NamedIndividual, chx:P2shAddress ; rdfs:label "3F6i6kwkevjR7AsAd4te2YB2zZyASEm1HM"@en ; skos:definition "A P2SH address commits with HASH160 to a redeem script instead of a key, uses version byte 0x05 and starts with 3."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_P2shAddress a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a: (lambda n: n.to_bytes(25, 'big')[0])(sum('123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'.index(c) * 58 ** i for i, c in enumerate(a[::-1]))))('3F6i6kwkevjR7AsAd4te2YB2zZyASEm1HM') evaluates to 5"@en ; chx:input "(lambda a: (lambda n: n.to_bytes(25, 'big')[0])(sum('123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'.index(c) * 58 ** i for i, c in enumerate(a[::-1]))))('3F6i6kwkevjR7AsAd4te2YB2zZyASEm1HM')" ; chx:output "5" .
chx:X_P2shAddress rd:hasIOExample chx:IO_P2shAddress .
chx:X_PreimageAttack a owl:NamedIndividual, chx:PreimageAttack ; rdfs:label "1 in 2 to the 160"@en ; skos:definition "A preimage attack is finding an input for a given hash output; for a secure 160-bit function such as HASH160 an attacker that tries inputs succeeds with probability 1 in 2 to the 160 per try."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_PreimageAttack a owl:NamedIndividual, rd:IOExample ; rdfs:label "2 ** 160 evaluates to 1461501637330902918203684832716283019655932542976"@en ; chx:input "2 ** 160" ; chx:output "1461501637330902918203684832716283019655932542976" .
chx:X_PreimageAttack rd:hasIOExample chx:IO_PreimageAttack .
chx:X_SecondPreimageAttack a owl:NamedIndividual, chx:SecondPreimageAttack ; rdfs:label "a different input, same hash"@en ; skos:definition "A second preimage attack is finding a different input that gives the same hash as a given input; for addresses created entirely by one party the chance is again about 1 in 2 to the 160 for HASH160."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_SecondPreimageAttack a owl:NamedIndividual, rd:IOExample ; rdfs:label "float(1 / 2 ** 160) evaluates to 6.842277657836021e-49"@en ; chx:input "float(1 / 2 ** 160)" ; chx:output "6.842277657836021e-49" .
chx:X_SecondPreimageAttack rd:hasIOExample chx:IO_SecondPreimageAttack .
chx:X_CollisionAttack a owl:NamedIndividual, chx:CollisionAttack ; rdfs:label "1 in 2 to the 80"@en ; skos:definition "A collision attack is finding any two inputs with the same hash; because the attacker chooses both, the work is only about the square root of the output space, 2 to the 80 for HASH160, which is why newer addresses use 256-bit commitments."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_CollisionAttack a owl:NamedIndividual, rd:IOExample ; rdfs:label "(2 ** 160) ** 0.5 == 2 ** 80 evaluates to True"@en ; chx:input "(2 ** 160) ** 0.5 == 2 ** 80" ; chx:output "True" .
chx:X_CollisionAttack rd:hasIOExample chx:IO_CollisionAttack .
chx:X_SegwitUpgrade a owl:NamedIndividual, chx:SegwitUpgrade ; rdfs:label "a new place for signatures"@en ; skos:definition "Segregated witness moves the signatures and scripts of a transaction into a separate witness structure, so that the transaction identifier no longer depends on them and a spender, not a third party, controls it."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_SegwitUpgrade a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda sha: (lambda nowit, wit: (sha(sha(nowit).digest()).hexdigest()[:8], sha(sha(nowit + wit).digest()).hexdigest()[:8]))(b'the bytes of a transaction without its witness', b' and the witness bytes'))(__import__('hashlib').sha256) evaluates to ('3116f499', 'd97ceb07')"@en ; chx:input "(lambda sha: (lambda nowit, wit: (sha(sha(nowit).digest()).hexdigest()[:8], sha(sha(nowit + wit).digest()).hexdigest()[:8]))(b'the bytes of a transaction without its witness', b' and the witness bytes'))(__import__('hashlib').sha256)" ; chx:output "('3116f499', 'd97ceb07')" .
chx:X_SegwitUpgrade rd:hasIOExample chx:IO_SegwitUpgrade .
chx:X_NestedSegwit a owl:NamedIndividual, chx:NestedSegwit ; rdfs:label "3FyC6EYuxW22uj4CaEGjNCjxeg7gHyFeVv"@en ; skos:definition "A P2SH address can wrap a witness program: the redeem script is the witness output script (OP_0 and the 20-byte key hash), so an older payer that only knows P2SH can pay a segwit receiver."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_NestedSegwit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda h: (bytes([0, 20]).hex() + h, len(bytes.fromhex('0014' + h))))('bbc1e42a39d05a4cc61752d6963b7f69d09bb27b') evaluates to ('0014bbc1e42a39d05a4cc61752d6963b7f69d09bb27b', 22)"@en ; chx:input "(lambda h: (bytes([0, 20]).hex() + h, len(bytes.fromhex('0014' + h))))('bbc1e42a39d05a4cc61752d6963b7f69d09bb27b')" ; chx:output "('0014bbc1e42a39d05a4cc61752d6963b7f69d09bb27b', 22)" .
chx:X_NestedSegwit rd:hasIOExample chx:IO_NestedSegwit .
chx:X_Bech32Address a owl:NamedIndividual, chx:Bech32Address ; rdfs:label "bc1q9d3xa5gg45q2j39m9y32xzvygcgay4rgc6aaee"@en ; skos:definition "A bech32 address is a human-readable part, the separator 1, a witness version, a witness program and a six-character checksum, in one case of a 32-character alphabet."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Bech32Address a owl:NamedIndividual, rd:IOExample ; rdfs:label "len('bc1q9d3xa5gg45q2j39m9y32xzvygcgay4rgc6aaee') evaluates to 42"@en ; chx:input "len('bc1q9d3xa5gg45q2j39m9y32xzvygcgay4rgc6aaee')" ; chx:output "42" .
chx:X_Bech32Address rd:hasIOExample chx:IO_Bech32Address .
chx:X_WitnessVersion a owl:NamedIndividual, chx:WitnessVersion ; rdfs:label "q is 0 and p is 1"@en ; skos:definition "The witness version is the first character after the separator of a segwit address; it is a number from 0 to 16, and the character q stands for 0 and p for 1."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_WitnessVersion a owl:NamedIndividual, rd:IOExample ; rdfs:label "('qpzry9x8gf2tvdw0s3jn54khce6mua7l'.index('q'), 'qpzry9x8gf2tvdw0s3jn54khce6mua7l'.index('p')) evaluates to (0, 1)"@en ; chx:input "('qpzry9x8gf2tvdw0s3jn54khce6mua7l'.index('q'), 'qpzry9x8gf2tvdw0s3jn54khce6mua7l'.index('p'))" ; chx:output "(0, 1)" .
chx:X_WitnessVersion rd:hasIOExample chx:IO_WitnessVersion .
chx:X_WitnessProgram a owl:NamedIndividual, chx:WitnessProgram ; rdfs:label "20 or 32 bytes for version 0"@en ; skos:definition "The witness program is 2 to 40 bytes and, for witness version 0, exactly 20 or 32; for version 1, taproot, it is a 32-byte point."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_WitnessProgram a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda p20, p32: (len(bytes.fromhex(p20)), len(bytes.fromhex(p32))))('2b626ed108ad00a944bb2922a309844611d25468', '648a32e50b6fb7c5233b228f60a6a2ca4158400268844c4bc295ed5e8c3d626f') evaluates to (20, 32)"@en ; chx:input "(lambda p20, p32: (len(bytes.fromhex(p20)), len(bytes.fromhex(p32))))('2b626ed108ad00a944bb2922a309844611d25468', '648a32e50b6fb7c5233b228f60a6a2ca4158400268844c4bc295ed5e8c3d626f')" ; chx:output "(20, 32)" .
chx:X_WitnessProgram rd:hasIOExample chx:IO_WitnessProgram .
chx:X_HumanReadablePart a owl:NamedIndividual, chx:HumanReadablePart ; rdfs:label "bc for mainnet, tb for testnet"@en ; skos:definition "The human-readable part opens a bech32 address and names its network or purpose, for Bitcoin bc for the main network and tb for testnet; it is followed by the separator 1."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_HumanReadablePart a owl:NamedIndividual, rd:IOExample ; rdfs:label "'bc1q9d3xa5gg45q2j39m9y32xzvygcgay4rgc6aaee'.rsplit('1', 1)[0] evaluates to 'bc'"@en ; chx:input "'bc1q9d3xa5gg45q2j39m9y32xzvygcgay4rgc6aaee'.rsplit('1', 1)[0]" ; chx:output "'bc'" .
chx:X_HumanReadablePart rd:hasIOExample chx:IO_HumanReadablePart .
chx:X_BchCode a owl:NamedIndividual, chx:BchCode ; rdfs:label "six characters, 30 bits"@en ; skos:definition "A BCH code is an error-correcting code; bech32's checksum is a BCH code of six 5-bit characters, 30 bits, which is why errors beyond the guaranteed ones slip through less than once in a billion."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_BchCode a owl:NamedIndividual, rd:IOExample ; rdfs:label "(6 * 5, 2 ** 30, 1 / 2 ** 30 < 1e-9) evaluates to (30, 1073741824, True)"@en ; chx:input "(6 * 5, 2 ** 30, 1 / 2 ** 30 < 1e-9)" ; chx:output "(30, 1073741824, True)" .
chx:X_BchCode rd:hasIOExample chx:IO_BchCode .
chx:X_ErrorDetection a owl:NamedIndividual, chx:ErrorDetection ; rdfs:label "detects, and locates, typing errors"@en ; skos:definition "Bech32 is guaranteed to detect any error affecting four characters or fewer, and Bitcoin Core points to where a typing error is, while bech32's original constant let a q be added before a final p without detection, which bech32m fixes."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_ErrorDetection a owl:NamedIndividual, rd:IOExample ; rdfs:label "[i for i, (a, b) in enumerate(zip('bc1p9nh05ha8wrljf7ru236awm4t2x0d5ctkkywmu9sclnm4t0av2vgs4k3au7', 'bc1p9nh05ha8wrljf7ru236awn4t2x0d5ctkkywmv9sclnm4t0av2vgs4k3au7')) if a != b] evaluates to [25, 40]"@en ; chx:input "[i for i, (a, b) in enumerate(zip('bc1p9nh05ha8wrljf7ru236awm4t2x0d5ctkkywmu9sclnm4t0av2vgs4k3au7', 'bc1p9nh05ha8wrljf7ru236awn4t2x0d5ctkkywmv9sclnm4t0av2vgs4k3au7')) if a != b]" ; chx:output "[25, 40]" .
chx:X_ErrorDetection rd:hasIOExample chx:IO_ErrorDetection .
chx:X_LengthExtension a owl:NamedIndividual, chx:LengthExtension ; rdfs:label "a q before a final p"@en ; skos:definition "In bech32, adding or removing the letter q just before a final p leaves the checksum valid; the book's six extended strings are valid under bech32 and invalid under bech32m."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_LengthExtension a owl:NamedIndividual, rd:IOExample ; rdfs:label "[len(a) for a in ('bc1pqqqsq9txsqp', 'bc1pqqqsq9txsqqqqp', 'bc1pqqqsq9txsqqqqqqp')] evaluates to [15, 18, 20]"@en ; chx:input "[len(a) for a in ('bc1pqqqsq9txsqp', 'bc1pqqqsq9txsqqqqp', 'bc1pqqqsq9txsqqqqqqp')]" ; chx:output "[15, 18, 20]" .
chx:X_LengthExtension rd:hasIOExample chx:IO_LengthExtension .
chx:X_Bech32mAddress a owl:NamedIndividual, chx:Bech32mAddress ; rdfs:label "bc1p9nh05ha8wrljf7ru236awm4t2x0d5ctkkywmu9sclnm4t0av2vgs4k3au7"@en ; skos:definition "Bech32m differs from bech32 only in the constant merged into the checksum, 0x2bc830a3 instead of 1, and is required for witness version 1 and later."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Bech32mAddress a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda b32, b32m: (b32[:-6] == b32m[:-6], b32[-6:], b32m[-6:]))('bc1p9nh05ha8wrljf7ru236awm4t2x0d5ctkkywmu9sclnm4t0av2vgsq2p3eu', 'bc1p9nh05ha8wrljf7ru236awm4t2x0d5ctkkywmu9sclnm4t0av2vgs4k3au7') evaluates to (True, 'q2p3eu', '4k3au7')"@en ; chx:input "(lambda b32, b32m: (b32[:-6] == b32m[:-6], b32[-6:], b32m[-6:]))('bc1p9nh05ha8wrljf7ru236awm4t2x0d5ctkkywmu9sclnm4t0av2vgsq2p3eu', 'bc1p9nh05ha8wrljf7ru236awm4t2x0d5ctkkywmu9sclnm4t0av2vgs4k3au7')" ; chx:output "(True, 'q2p3eu', '4k3au7')" .
chx:X_Bech32mAddress rd:hasIOExample chx:IO_Bech32mAddress .
chx:X_P2wpkh a owl:NamedIndividual, chx:P2wpkh ; rdfs:label "OP_0 and a 20-byte key hash"@en ; skos:definition "A P2WPKH output script is OP_0 followed by the 20-byte HASH160 of a public key, the same commitment as P2PKH, 22 bytes in all; its address is bech32."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_P2wpkh a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(bytes.fromhex('00142b626ed108ad00a944bb2922a309844611d25468')) evaluates to 22"@en ; chx:input "len(bytes.fromhex('00142b626ed108ad00a944bb2922a309844611d25468'))" ; chx:output "22" .
chx:X_P2wpkh rd:hasIOExample chx:IO_P2wpkh .
chx:X_P2wsh a owl:NamedIndividual, chx:P2wsh ; rdfs:label "OP_0 and a 32-byte script hash"@en ; skos:definition "A P2WSH output script is OP_0 followed by the 32-byte SHA256 of a script, without the RIPEMD-160 step of P2SH, 34 bytes in all."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_P2wsh a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(bytes.fromhex('0020648a32e50b6fb7c5233b228f60a6a2ca4158400268844c4bc295ed5e8c3d626f')) evaluates to 34"@en ; chx:input "len(bytes.fromhex('0020648a32e50b6fb7c5233b228f60a6a2ca4158400268844c4bc295ed5e8c3d626f'))" ; chx:output "34" .
chx:X_P2wsh rd:hasIOExample chx:IO_P2wsh .
chx:X_P2tr a owl:NamedIndividual, chx:P2tr ; rdfs:label "OP_1 and a 32-byte point"@en ; skos:definition "A P2TR output script is OP_1 followed by a 32-byte witness program that is a point on the secp256k1 curve, which may be a public key or a key that commits to more data; its address is bech32m."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_P2tr a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(bytes.fromhex('2ceefa5fa770ff24f87c5475d76eab519eda6176b11dbe1618fcf755bfac5311')) evaluates to 32"@en ; chx:input "len(bytes.fromhex('2ceefa5fa770ff24f87c5475d76eab519eda6176b11dbe1618fcf755bfac5311'))" ; chx:output "32" .
chx:X_P2tr rd:hasIOExample chx:IO_P2tr .
chx:X_DefaultAddressType a owl:NamedIndividual, chx:DefaultAddressType ; rdfs:label "bech32 by default, bech32m on request"@en ; skos:definition "Bitcoin Core's addresstype option defaults to bech32, a P2WPKH address, and the four types are legacy, p2sh-segwit, bech32 and bech32m, the last a taproot address."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_DefaultAddressType a owl:NamedIndividual, rd:IOExample ; rdfs:label "['legacy', 'p2sh-segwit', 'bech32', 'bech32m'].index('bech32') evaluates to 2"@en ; chx:input "['legacy', 'p2sh-segwit', 'bech32', 'bech32m'].index('bech32')" ; chx:output "2" .
chx:X_DefaultAddressType rd:hasIOExample chx:IO_DefaultAddressType .
chx:X_KeyExport a owl:NamedIndividual, chx:KeyExport ; rdfs:label "no dumpprivkey any more"@en ; skos:definition "Deterministic descriptor wallets no longer export single keys, and Bitcoin Core removed dumpprivkey and importprivkey in 30.0, while a WIF key can still be used inside a descriptor."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_KeyExport a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda present, removed: sorted(set(present) - set(removed)))(['getnewaddress', 'dumpprivkey', 'importdescriptors', 'importprivkey'], ['dumpprivkey', 'importprivkey']) evaluates to ['getnewaddress', 'importdescriptors']"@en ; chx:input "(lambda present, removed: sorted(set(present) - set(removed)))(['getnewaddress', 'dumpprivkey', 'importdescriptors', 'importprivkey'], ['dumpprivkey', 'importprivkey'])" ; chx:output "['getnewaddress', 'importdescriptors']" .
chx:X_KeyExport rd:hasIOExample chx:IO_KeyExport .
chx:X_PassphraseProtection a owl:NamedIndividual, chx:PassphraseProtection ; rdfs:label "BIP38 and the prefix 6P"@en ; skos:definition "BIP38 encrypts a private key under a passphrase into a 58-character base58check string starting with 6P; the BIPs repository lists it as Deployed with the comment summary Unanimously Discourage for implementation, and the 3rd edition does not cover it."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_PassphraseProtection a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (len(s), s[:2]))('6PRHv1jg1ytiE4kT2QtrUz8gEjMQghZDWg1FuxjdYDzjUkcJeGdFj9q9Vi') evaluates to (58, '6P')"@en ; chx:input "(lambda s: (len(s), s[:2]))('6PRHv1jg1ytiE4kT2QtrUz8gEjMQghZDWg1FuxjdYDzjUkcJeGdFj9q9Vi')" ; chx:output "(58, '6P')" .
chx:X_PassphraseProtection rd:hasIOExample chx:IO_PassphraseProtection .
chx:X_DeterministicWallet a owl:NamedIndividual, chx:DeterministicWallet ; rdfs:label "one seed, all the keys"@en ; skos:definition "A deterministic wallet derives all its private keys from a single seed, a random value, by a repeatable procedure, so one backup covers every key; the book's example derives three keys by hashing the seed with 0, 1 and 2."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_DeterministicWallet a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hashlib').sha256(b'f1cc3bc03ef51cb43ee7844460fa5049e779e7425a6349c8e89dfbb0fd97bb73 + 0\\n').hexdigest()[:8] evaluates to '50b18e0b'"@en ; chx:input "__import__('hashlib').sha256(b'f1cc3bc03ef51cb43ee7844460fa5049e779e7425a6349c8e89dfbb0fd97bb73 + 0\\n').hexdigest()[:8]" ; chx:output "'50b18e0b'" .
chx:X_DeterministicWallet rd:hasIOExample chx:IO_DeterministicWallet .
chx:X_AddressReuse a owl:NamedIndividual, chx:AddressReuse ; rdfs:label "one address, many payments"@en ; skos:definition "Receiving several payments to the same address links them all together for anyone looking at the blockchain, which reduces the privacy of everyone who pays or is paid by that address."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_AddressReuse a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda reused, fresh: (len(set(reused)), len(set(fresh))))(['bc1qh0q7g23e6pdye3sh2ttfvwmld8gfhvnmmfxuck'] * 3, ['bc1qaaa', 'bc1qbbb', 'bc1qccc']) evaluates to (1, 3)"@en ; chx:input "(lambda reused, fresh: (len(set(reused)), len(set(fresh))))(['bc1qh0q7g23e6pdye3sh2ttfvwmld8gfhvnmmfxuck'] * 3, ['bc1qaaa', 'bc1qbbb', 'bc1qccc'])" ; chx:output "(1, 3)" .
chx:X_AddressReuse rd:hasIOExample chx:IO_AddressReuse .
chx:X_VanityAddress a owl:NamedIndividual, chx:VanityAddress ; rdfs:label "1Kids and 58 to the fourth"@en ; skos:definition "A vanity address starts with a chosen string found by trying keys one after another, and each further character multiplies the work by 58, so four characters take 58 to the fourth, about 11 million keys."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_VanityAddress a owl:NamedIndividual, rd:IOExample ; rdfs:label "58**4 evaluates to 11316496"@en ; chx:input "58**4" ; chx:output "11316496" .
chx:X_VanityAddress rd:hasIOExample chx:IO_VanityAddress .
chx:X_PaperWallet a owl:NamedIndividual, chx:PaperWallet ; rdfs:label "a private key on paper"@en ; skos:definition "A paper wallet is a private key printed on paper, which the 3rd edition calls an obsolete technology and dangerous for most users."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_PaperWallet a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda k: (len(k), len(bytes.fromhex(k))))('1E99423A4ED27608A15A2616A2B0E9E52CED330AC530EDCC32C8FFC6A526AEDD') evaluates to (64, 32)"@en ; chx:input "(lambda k: (len(k), len(bytes.fromhex(k))))('1E99423A4ED27608A15A2616A2B0E9E52CED330AC530EDCC32C8FFC6A526AEDD')" ; chx:output "(64, 32)" .
chx:X_PaperWallet rd:hasIOExample chx:IO_PaperWallet .
chx:X_HardwareSigningDevice a owl:NamedIndividual, chx:HardwareSigningDevice ; rdfs:label "keys that never leave the device"@en ; skos:definition "A hardware signing device holds private keys and uses them only to sign; a less secure program prepares the transaction and broadcasts it, so the keys never meet general-purpose software."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_HardwareSigningDevice a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda steps: (steps.index('sign'), 'private key' in steps))(['prepare', 'sign', 'broadcast']) evaluates to (1, False)"@en ; chx:input "(lambda steps: (steps.index('sign'), 'private key' in steps))(['prepare', 'sign', 'broadcast'])" ; chx:output "(1, False)" .
chx:X_HardwareSigningDevice rd:hasIOExample chx:IO_HardwareSigningDevice .
chx:X_TestVectors a owl:NamedIndividual, chx:TestVectors ; rdfs:label "BIP350's list of valid and invalid addresses"@en ; skos:definition "The BIP350 test vectors give valid and invalid segwit addresses and bech32m strings against which any bech32m implementation should be run, including those for future witness versions."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_TestVectors a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda b32m, valid, invalid: (len(b32m), len(valid), len(invalid)))(['A1LQFN3A', 'a1lqfn3a', 'an83characterlonghumanreadablepartthatcontainsthetheexcludedcharactersbioandnumber11sg7hg6', 'abcdef1l7aum6echk45nj3s0wdvt2fg8x9yrzpqzd3ryx', '11llllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllludsr8', 'split1checkupstagehandshakeupstreamerranterredcaperredlc445v', '?1v759aa'], ['BC1QW508D6QEJXTDG4Y5R3ZARVARY0C5XW7KV8F3T4', 'tb1qrp33g0q5c5txsp9arysrx4k6zdkfs4nce4xj0gdcccefvpysxf3q0sl5k7', 'bc1pw508d6qejxtdg4y5r3zarvary0c5xw7kw508d6qejxtdg4y5r3zarvary0c5xw7kt5nd6y', 'BC1SW50QGDZ25J', 'bc1zw508d6qejxtdg4y5r3zarvaryvaxxpcs', 'tb1qqqqqp399et2xygdj5xreqhjjvcmzhxw4aywxecjdzew6hylgvsesrxh6hy', 'tb1pqqqqp399et2xygdj5xreqhjjvcmzhxw4aywxecjdzew6hylgvsesf3hn0c', 'bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0'], ['Invalid human-readable part', 'Invalid checksum: bech32 for v1', 'Invalid checksum: bech32 for v1 again', 'Invalid checksum: bech32 for v16', 'Invalid checksum: bech32m for v0', 'Invalid checksum: bech32m for v0 again', 'Invalid character in checksum', 'Invalid witness version', 'Invalid program length (1 byte)', 'Invalid program length (41 bytes)', 'Invalid program length for witness version 0', 'Mixed case', 'Zero padding of more than 4 bits', 'Non-zero padding in the 8-to-5 conversion', 'Empty data section']) evaluates to (7, 8, 15)"@en ; chx:input "(lambda b32m, valid, invalid: (len(b32m), len(valid), len(invalid)))(['A1LQFN3A', 'a1lqfn3a', 'an83characterlonghumanreadablepartthatcontainsthetheexcludedcharactersbioandnumber11sg7hg6', 'abcdef1l7aum6echk45nj3s0wdvt2fg8x9yrzpqzd3ryx', '11llllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllludsr8', 'split1checkupstagehandshakeupstreamerranterredcaperredlc445v', '?1v759aa'], ['BC1QW508D6QEJXTDG4Y5R3ZARVARY0C5XW7KV8F3T4', 'tb1qrp33g0q5c5txsp9arysrx4k6zdkfs4nce4xj0gdcccefvpysxf3q0sl5k7', 'bc1pw508d6qejxtdg4y5r3zarvary0c5xw7kw508d6qejxtdg4y5r3zarvary0c5xw7kt5nd6y', 'BC1SW50QGDZ25J', 'bc1zw508d6qejxtdg4y5r3zarvaryvaxxpcs', 'tb1qqqqqp399et2xygdj5xreqhjjvcmzhxw4aywxecjdzew6hylgvsesrxh6hy', 'tb1pqqqqp399et2xygdj5xreqhjjvcmzhxw4aywxecjdzew6hylgvsesf3hn0c', 'bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0'], ['Invalid human-readable part', 'Invalid checksum: bech32 for v1', 'Invalid checksum: bech32 for v1 again', 'Invalid checksum: bech32 for v16', 'Invalid checksum: bech32m for v0', 'Invalid checksum: bech32m for v0 again', 'Invalid character in checksum', 'Invalid witness version', 'Invalid program length (1 byte)', 'Invalid program length (41 bytes)', 'Invalid program length for witness version 0', 'Mixed case', 'Zero padding of more than 4 bits', 'Non-zero padding in the 8-to-5 conversion', 'Empty data section'])" ; chx:output "(7, 8, 15)" .
chx:X_TestVectors rd:hasIOExample chx:IO_TestVectors .
chx:X_IndependentCheck a owl:NamedIndividual, chx:IndependentCheck ; rdfs:label "three sources, one answer"@en ; skos:definition "Cross-checking compares the results of independent implementations on the same input; this chapter compares its own toolkit with Bitcoin Core 31.1 and with the book's reference code, and finds the same addresses."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_IndependentCheck a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda answers: (len(set(answers)), len(set(answers)) == 1))(['1J7mdg5rbQyUHENYdx39WVWK7fsLpEoXZy', '1J7mdg5rbQyUHENYdx39WVWK7fsLpEoXZy', '1J7mdg5rbQyUHENYdx39WVWK7fsLpEoXZy']) evaluates to (1, True)"@en ; chx:input "(lambda answers: (len(set(answers)), len(set(answers)) == 1))(['1J7mdg5rbQyUHENYdx39WVWK7fsLpEoXZy', '1J7mdg5rbQyUHENYdx39WVWK7fsLpEoXZy', '1J7mdg5rbQyUHENYdx39WVWK7fsLpEoXZy'])" ; chx:output "(1, True)" .
chx:X_IndependentCheck rd:hasIOExample chx:IO_IndependentCheck .
chx:X_KeyControlProof a owl:NamedIndividual, chx:KeyControlProof ; rdfs:label "signing to prove control"@en ; skos:definition "Whoever holds a private key can prove control of the matching public key by signing, without a central registry or anyone's permission."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:X_Uri a owl:NamedIndividual, chx:Uri ; rdfs:label "did:example:123456789abcdefghi"@en ; skos:definition "A URI is a compact sequence of characters that identifies an abstract or physical resource; the identifiers of the DID standard are URIs of the form did, a colon, a method name, a colon and a method-specific identifier."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_Uri a owl:NamedIndividual, rd:IOExample ; rdfs:label "'did:example:123456789abcdefghi'.split(':') evaluates to ['did', 'example', '123456789abcdefghi']"@en ; chx:input "'did:example:123456789abcdefghi'.split(':')" ; chx:output "['did', 'example', '123456789abcdefghi']" .
chx:X_Uri rd:hasIOExample chx:IO_Uri .
chx:X_DecentralizedIdentifier a owl:NamedIndividual, chx:DecentralizedIdentifier ; rdfs:label "a DID and its DID document"@en ; skos:definition "A decentralized identifier is a URI that associates a subject with a DID document that can carry verification methods such as public keys, so its controller can prove control without permission from another party."@en ; dcterms:source <http://example.org/sen0401/ch04/research> .
chx:IO_DecentralizedIdentifier a owl:NamedIndividual, rd:IOExample ; rdfs:label "'did:example:123456789abcdefghi'.split(':') evaluates to ['did', 'example', '123456789abcdefghi']"@en ; chx:input "'did:example:123456789abcdefghi'.split(':')" ; chx:output "['did', 'example', '123456789abcdefghi']" .
chx:X_DecentralizedIdentifier rd:hasIOExample chx:IO_DecentralizedIdentifier .
