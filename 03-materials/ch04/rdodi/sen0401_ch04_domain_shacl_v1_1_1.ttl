@prefix chx:     <http://example.org/sen0401/ch04#> .
@prefix res:     <http://example.org/rdodi/research-ontology#> .
@prefix rd:      <http://example.org/rdodi/domain-ontology#> .
@prefix doc:     <http://example.org/rdodi/document-ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
<http://example.org/sen0401/ch04/shacl> a owl:Ontology ;
    rdfs:label "SEN0401 chapter 4 domain ontology - shapes"@en ; owl:versionInfo "1.1.1" ; owl:versionIRI <http://example.org/sen0401/ch04/shacl/1.1.1> ;
    rdfs:comment "PATCH over 1.1.0: an unused prefix declaration is removed. The file declared a second, differently named prefix for this course's own vendor namespace <http://example.org/sen0401#>, borrowed from the sibling Python course's files and never used here; under the ontology-engineering scope rule a token of another course has no place in a SEN0401 artifact. No shape, target, path, severity or message is changed, so the set of triples is identical and the gate this file states is unchanged."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:created "2026-09-29"^^xsd:date ; dcterms:modified "2026-10-05"^^xsd:date ;
    dcterms:identifier "sen0401_ch04_shacl_v1_1_1" ;
    owl:priorVersion <http://example.org/sen0401/ch04/shacl/1.1.0> ;
    prov:wasRevisionOf <http://example.org/sen0401/ch04/shacl/1.1.0> ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/ch04-rdodi-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> ;
    prov:wasRevisionOf <http://example.org/sen0401/ch04/shacl/1.0.0> .
chx:ExemplarShape a sh:NodeShape ; sh:targetClass owl:NamedIndividual ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "Every individual needs a label." ] .
chx:ExemplarSourcedShape a sh:NodeShape ; sh:targetSubjectsOf skos:definition ;
    sh:property [ sh:path dcterms:source ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "A defined individual must cite its source." ] .
chx:IOShape a sh:NodeShape ; sh:targetClass rd:IOExample ;
    sh:property [ sh:path chx:input ; sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation ; sh:message "An I/O example needs exactly one input." ] ;
    sh:property [ sh:path chx:output ; sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation ; sh:message "An I/O example needs exactly one output." ] .
chx:ErrorConditionShape a sh:NodeShape ; sh:targetClass rd:ErrorCondition ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern " raises " ; sh:severity sh:Violation ; sh:message "An error condition is labelled 'expression raises ErrorType: message'." ] .
chx:OwnedConceptShape a sh:NodeShape ; sh:targetObjectsOf chx:hasOwner ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "The owning concept of another concept must itself be a labelled individual." ] .
chx:ResolutionEnvironmentShape a sh:NodeShape ; sh:targetClass rd:ResolutionEnvironment ;
    sh:property [ sh:path skos:definition ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "The resolution environment must say what it executed." ] ;
    sh:property [ sh:path dcterms:source ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "The resolution environment must name the run that executed the claims." ] .
chx:IOExampleOwnerShape a sh:NodeShape ; sh:targetObjectsOf rd:hasIOExample ;
    sh:property [ sh:path chx:input ; sh:minCount 1 ; sh:severity sh:Violation ; sh:message "A worked example of a concept must carry the expression that was executed." ] .
