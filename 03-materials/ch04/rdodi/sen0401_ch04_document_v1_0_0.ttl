chx:Document a doc:ReportSection ; rdfs:label "Keys and addresses: from a random number to a payable string, recomputed and cross-checked"@en ; skos:definition "This document renews chapter 4 of the 3rd edition of Mastering Bitcoin for SEN0401 (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04/research> ;
    doc:hasSection chx:S_Keys, chx:S_Format, chx:S_Address, chx:S_Practice, chx:S_Semantics .
chx:S_Keys a doc:TaxonomicSection ; rdfs:label "Keys"@en ; doc:sectionTitle "Keys" ; doc:hierarchyLevel 1 ; doc:sectionOrder 1 ;
    skos:definition "Keys and Addresses begins with Alice paying Bob without the network learning who either is, using the scheme of the original paper in which a payment goes to a public key and is signed by the spender (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#Keys> .
chx:S_KeyPair a doc:TaxonomicSection ; rdfs:label "Key pair"@en ; doc:sectionTitle "Key pair" ; doc:hierarchyLevel 2 ; doc:sectionOrder 2 ;
    doc:hasParentSection chx:S_Keys ;
    skos:definition "Public Key Cryptography and its subsections introduce the pair of a private and a public key (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#KeyPair> .
chx:S_PublicKeyCryptography a doc:ConceptSection ; rdfs:label "Public key cryptography"@en ; doc:sectionTitle "Public key cryptography" ; doc:hierarchyLevel 3 ; doc:sectionOrder 3 ;
    doc:hasParentSection chx:S_KeyPair ;
    skos:definition "Asymmetric cryptography is not used to encrypt transactions: its useful property is that a private key produces a signature that anyone with the public key can verify, while only the private key's owner could have produced it (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#PublicKeyCryptography> .
chx:S_PrivateKey a doc:ConceptSection ; rdfs:label "Private key"@en ; doc:sectionTitle "Private key" ; doc:hierarchyLevel 3 ; doc:sectionOrder 4 ;
    doc:hasParentSection chx:S_KeyPair ;
    skos:definition "A private key is a number picked at random between 0 and n minus 1, where n, about 1.1578 times 10 to the 77 in the book, is the order of the curve, and it must come from a cryptographically secure random number generator (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#PrivateKey> .
chx:S_PublicKey a doc:ConceptSection ; rdfs:label "Public key"@en ; doc:sectionTitle "Public key" ; doc:hierarchyLevel 3 ; doc:sectionOrder 5 ;
    doc:hasParentSection chx:S_KeyPair ;
    skos:definition "The public key is K = k x G, the private key multiplied by the constant generator point of secp256k1, and for the book's example key it is the point whose x coordinate begins F028892B (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#PublicKey> .
chx:S_RandomSource a doc:TaxonomicSection ; rdfs:label "Randomness"@en ; doc:sectionTitle "Randomness" ; doc:hierarchyLevel 2 ; doc:sectionOrder 6 ;
    doc:hasParentSection chx:S_Keys ;
    skos:definition "The chapter warns against writing your own random number code or using a simple generator, and asks for a cryptographically secure one with enough entropy (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#RandomSource> .
chx:S_SecureRandomness a doc:ConceptSection ; rdfs:label "Secure randomness"@en ; doc:sectionTitle "Secure randomness" ; doc:hierarchyLevel 3 ; doc:sectionOrder 7 ;
    doc:hasParentSection chx:S_RandomSource ;
    skos:definition "Python's documentation says the secrets module generates cryptographically strong random numbers suitable for secrets and should be used in preference to the random module, which is designed for modelling and simulation (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0401/ch04#SecureRandomness> .
chx:S_Curve a doc:TaxonomicSection ; rdfs:label "The curve"@en ; doc:sectionTitle "The curve" ; doc:hierarchyLevel 2 ; doc:sectionOrder 8 ;
    doc:hasParentSection chx:S_Keys ;
    skos:definition "Elliptic Curve Cryptography Explained describes the curve Bitcoin uses and the arithmetic on its points (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#Curve> .
chx:S_Secp256k1 a doc:ConceptSection ; rdfs:label "The secp256k1 curve"@en ; doc:sectionTitle "The secp256k1 curve" ; doc:hierarchyLevel 3 ; doc:sectionOrder 9 ;
    doc:hasParentSection chx:S_Curve ;
    skos:definition "The book says secp256k1 was established by NIST, but the curve is defined in SEC 2 from Certicom Research, whose Table 2 lists it with no NIST recommendation and lists secp256r1 with one (Certicom Research, 2010)." ; dcterms:source <http://example.org/sen0401/ch04#Secp256k1> .
chx:S_PointMultiplication a doc:ConceptSection ; rdfs:label "Elliptic curve multiplication"@en ; doc:sectionTitle "Elliptic curve multiplication" ; doc:hierarchyLevel 3 ; doc:sectionOrder 10 ;
    doc:hasParentSection chx:S_Curve ;
    skos:definition "Adding a point to itself is drawing a tangent and reflecting the third intersection, multiplication by k extends that addition, and the toolkit does it in about 256 doublings and additions for the book's key (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#PointMultiplication> .
chx:S_Format a doc:TaxonomicSection ; rdfs:label "Format"@en ; doc:sectionTitle "Format" ; doc:hierarchyLevel 1 ; doc:sectionOrder 11 ;
    skos:definition "Base58check Encoding, Compressed Public Keys and Private Key Formats describe how keys and hashes become text (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#Format> .
chx:S_KeyEncoding a doc:TaxonomicSection ; rdfs:label "Key encoding"@en ; doc:sectionTitle "Key encoding" ; doc:hierarchyLevel 2 ; doc:sectionOrder 12 ;
    doc:hasParentSection chx:S_Format ;
    skos:definition "The same public key can be written in two forms and the same private key exported in two forms (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#KeyEncoding> .
chx:S_CompressedPublicKey a doc:ConceptSection ; rdfs:label "Compressed public key"@en ; doc:sectionTitle "Compressed public key" ; doc:hierarchyLevel 3 ; doc:sectionOrder 13 ;
    doc:hasParentSection chx:S_KeyEncoding ;
    skos:definition "A compressed public key of 33 bytes carries the prefix 02 or 03 for the parity of y and the x coordinate, and the y coordinate is recovered from y squared = x cubed + 7 (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#CompressedPublicKey> .
chx:S_UncompressedPublicKey a doc:ConceptSection ; rdfs:label "Uncompressed public key"@en ; doc:sectionTitle "Uncompressed public key" ; doc:hierarchyLevel 3 ; doc:sectionOrder 14 ;
    doc:hasParentSection chx:S_KeyEncoding ;
    skos:definition "The uncompressed key is 04 followed by x and y, 65 bytes, and hashing it gives a different commitment and so a different address from the compressed key of the same private key (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#UncompressedPublicKey> .
chx:S_WalletImportFormat a doc:ConceptSection ; rdfs:label "Wallet import format (WIF)"@en ; doc:sectionTitle "Wallet import format (WIF)" ; doc:hierarchyLevel 3 ; doc:sectionOrder 15 ;
    doc:hasParentSection chx:S_KeyEncoding ;
    skos:definition "The book's example private key exports as the WIF 5J3mBbAH58CpQ3Y5RNJpUKPE62SQ5tfcvU2JpbnkeyhfsYB1Jcn and, with the 01 suffix, as the WIF-compressed KxFC1jmwwCoACiCAWZ3eXa96mBM6tb3TYzGmf6YwgdGWZgawvrtJ (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#WalletImportFormat> .
chx:S_Checksummed a doc:TaxonomicSection ; rdfs:label "Checksummed text"@en ; doc:sectionTitle "Checksummed text" ; doc:hierarchyLevel 2 ; doc:sectionOrder 16 ;
    doc:hasParentSection chx:S_Format ;
    skos:definition "Base58check adds a version byte and a checksum to data before encoding it (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#Checksummed> .
chx:S_Base58Check a doc:ConceptSection ; rdfs:label "Base58check encoding"@en ; doc:sectionTitle "Base58check encoding" ; doc:hierarchyLevel 3 ; doc:sectionOrder 17 ;
    doc:hasParentSection chx:S_Checksummed ;
    skos:definition "Base58 is base64 without 0, O, l, I, plus and slash, and base58check appends the first four bytes of the double SHA-256 of the prefixed data as a checksum (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#Base58Check> .
chx:S_VersionPrefix a doc:ConceptSection ; rdfs:label "Version prefix"@en ; doc:sectionTitle "Version prefix" ; doc:hierarchyLevel 3 ; doc:sectionOrder 18 ;
    doc:hasParentSection chx:S_Checksummed ;
    skos:definition "The version byte 0x00 gives an address starting with 1, 0x05 starts with 3, 0x80 gives a WIF starting with 5, K or L, and 0x0488B21E gives xpub (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#VersionPrefix> .
chx:S_Address a doc:TaxonomicSection ; rdfs:label "Address"@en ; doc:sectionTitle "Address" ; doc:hierarchyLevel 1 ; doc:sectionOrder 19 ;
    skos:definition "Legacy Addresses for P2PKH, Legacy Pay to Script Hash and Bech32 Addresses describe the ways a payer is given a receiver's script (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#Address> .
chx:S_Legacy a doc:TaxonomicSection ; rdfs:label "Legacy addresses"@en ; doc:sectionTitle "Legacy addresses" ; doc:hierarchyLevel 2 ; doc:sectionOrder 20 ;
    doc:hasParentSection chx:S_Address ;
    skos:definition "The legacy address types use base58check and are two of the script templates Bitcoin supports (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#Legacy> .
chx:S_Commitment a doc:ConceptSection ; rdfs:label "Hash commitment (HASH160)"@en ; doc:sectionTitle "Hash commitment (HASH160)" ; doc:hierarchyLevel 3 ; doc:sectionOrder 21 ;
    doc:hasParentSection chx:S_Legacy ;
    skos:definition "The book commits to an answer with a SHA-256 value beginning 94d7a772 and reveals it by hashing the sentence again, and Bitcoin commits to a public key the same way with RIPEMD-160 of its SHA-256 (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#Commitment> .
chx:S_P2pkhAddress a doc:ConceptSection ; rdfs:label "P2PKH address"@en ; doc:sectionTitle "P2PKH address" ; doc:hierarchyLevel 3 ; doc:sectionOrder 22 ;
    doc:hasParentSection chx:S_Legacy ;
    skos:definition "For the book's key, the compressed public key gives the address 1J7mdg5rbQyUHENYdx39WVWK7fsLpEoXZy and the uncompressed one 1424C2F4bC9JidNjjTUZCbUxv6Sa1Mt62x, and Bitcoin Core 31.1 derives the same two from the public keys (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch04#P2pkhAddress> .
chx:S_P2shAddress a doc:ConceptSection ; rdfs:label "P2SH address"@en ; doc:sectionTitle "P2SH address" ; doc:hierarchyLevel 3 ; doc:sectionOrder 23 ;
    doc:hasParentSection chx:S_Legacy ;
    skos:definition "P2SH lets an output commit to a redeem script with HASH160, its address uses version 5 and starts with 3, and the book's example 3F6i6kwkevjR7AsAd4te2YB2zZyASEm1HM has a valid checksum (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#P2shAddress> .
chx:S_Segwit a doc:TaxonomicSection ; rdfs:label "Segwit addresses"@en ; doc:sectionTitle "Segwit addresses" ; doc:hierarchyLevel 2 ; doc:sectionOrder 24 ;
    doc:hasParentSection chx:S_Address ;
    skos:definition "Bech32 Addresses, Problems with Bech32 Addresses and Bech32m describe the address format for segregated witness outputs (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#Segwit> .
chx:S_Bech32Address a doc:ConceptSection ; rdfs:label "Bech32 address"@en ; doc:sectionTitle "Bech32 address" ; doc:hierarchyLevel 3 ; doc:sectionOrder 25 ;
    doc:hasParentSection chx:S_Segwit ;
    skos:definition "A bech32 address such as bc1q9d3xa5gg45q2j39m9y32xzvygcgay4rgc6aaee is 42 characters for a 20-byte witness program and 62 for a 32-byte one, and the book's reference library and the toolkit both produce it from the script's program (Wuille, 2020)." ; dcterms:source <http://example.org/sen0401/ch04#Bech32Address> .
chx:S_Bech32mAddress a doc:ConceptSection ; rdfs:label "Bech32m address"@en ; doc:sectionTitle "Bech32m address" ; doc:hierarchyLevel 3 ; doc:sectionOrder 26 ;
    doc:hasParentSection chx:S_Segwit ;
    skos:definition "Bech32m changes the checksum constant from 1 to 0x2bc830a3 and is used from segwit version 1, so the taproot example bc1p9nh05ha8wrljf7ru236awm4t2x0d5ctkkywmu9sclnm4t0av2vgs4k3au7 carries a bech32m checksum (Wuille, 2020)." ; dcterms:source <http://example.org/sen0401/ch04#Bech32mAddress> .
chx:S_WitnessProgram a doc:ConceptSection ; rdfs:label "Witness program"@en ; doc:sectionTitle "Witness program" ; doc:hierarchyLevel 3 ; doc:sectionOrder 27 ;
    doc:hasParentSection chx:S_Segwit ;
    skos:definition "A witness program is 2 to 40 bytes, exactly 20 or 32 for version 0, and for version 1 the book's example is a 32-byte point on the secp256k1 curve (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#WitnessProgram> .
chx:S_ErrorDetection a doc:ConceptSection ; rdfs:label "Error detection"@en ; doc:sectionTitle "Error detection" ; doc:hierarchyLevel 3 ; doc:sectionOrder 28 ;
    doc:hasParentSection chx:S_Segwit ;
    skos:definition "Bitcoin Core validates the book's typo example as invalid with a bech32m checksum error at positions 25 and 40, the two characters the book underlines, and rejects the length-extension strings that carry only a bech32 checksum (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch04#ErrorDetection> .
chx:S_Practice a doc:TaxonomicSection ; rdfs:label "Practice"@en ; doc:sectionTitle "Practice" ; doc:hierarchyLevel 1 ; doc:sectionOrder 29 ;
    skos:definition "Vanity Addresses, Paper Wallets and the sections after them describe what is done with keys and addresses beyond the basics (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#Practice> .
chx:S_Modern a doc:TaxonomicSection ; rdfs:label "Practice now"@en ; doc:sectionTitle "Practice now" ; doc:hierarchyLevel 2 ; doc:sectionOrder 30 ;
    doc:hasParentSection chx:S_Practice ;
    skos:definition "Some of that practice has changed in current software (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch04#Modern> .
chx:S_DefaultAddressType a doc:ConceptSection ; rdfs:label "Default address type"@en ; doc:sectionTitle "Default address type" ; doc:hierarchyLevel 3 ; doc:sectionOrder 31 ;
    doc:hasParentSection chx:S_Modern ;
    skos:definition "Bitcoin Core 31.1 lists the address types legacy, p2sh-segwit, bech32 and bech32m and defaults to bech32, and a new wallet's default address is a version 0 witness address (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch04#DefaultAddressType> .
chx:S_KeyExport a doc:ConceptSection ; rdfs:label "Exporting a single key"@en ; doc:sectionTitle "Exporting a single key" ; doc:hierarchyLevel 3 ; doc:sectionOrder 32 ;
    doc:hasParentSection chx:S_Modern ;
    skos:definition "Bitcoin Core 30.0 removed the legacy wallet RPCs including dumpprivkey and importprivkey, and the 31.1 release answers that they are unknown commands (Bitcoin Core, 2026)." ; dcterms:source <http://example.org/sen0401/ch04#KeyExport> .
chx:S_PassphraseProtection a doc:ConceptSection ; rdfs:label "Passphrase-protected key"@en ; doc:sectionTitle "Passphrase-protected key" ; doc:hierarchyLevel 3 ; doc:sectionOrder 33 ;
    doc:hasParentSection chx:S_Modern ;
    skos:definition "The BIPs repository lists BIP38, a passphrase-protected private key, as Deployed and carries the comment summary Unanimously Discourage for implementation (Caldwell, 2012)." ; dcterms:source <http://example.org/sen0401/ch04#PassphraseProtection> .
chx:S_VanityAddress a doc:ConceptSection ; rdfs:label "Vanity address"@en ; doc:sectionTitle "Vanity address" ; doc:hierarchyLevel 3 ; doc:sectionOrder 34 ;
    doc:hasParentSection chx:S_Modern ;
    skos:definition "Vanity addresses were popular early and are almost gone, and the book's table of search times is exact in frequency and consistent with its own rule up to seven characters (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#VanityAddress> .
chx:S_PaperWallet a doc:ConceptSection ; rdfs:label "Paper wallet"@en ; doc:sectionTitle "Paper wallet" ; doc:hierarchyLevel 3 ; doc:sectionOrder 35 ;
    doc:hasParentSection chx:S_Modern ;
    skos:definition "The book calls paper wallets an obsolete technology that is dangerous for most users and shows them only for information (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#PaperWallet> .
chx:S_Assurance a doc:TaxonomicSection ; rdfs:label "Assurance"@en ; doc:sectionTitle "Assurance" ; doc:hierarchyLevel 2 ; doc:sectionOrder 36 ;
    doc:hasParentSection chx:S_Practice ;
    skos:definition "An implementation of bech32m can be tested against published vectors (Wuille, 2020)." ; dcterms:source <http://example.org/sen0401/ch04#Assurance> .
chx:S_TestVectors a doc:ConceptSection ; rdfs:label "BIP350 test vectors"@en ; doc:sectionTitle "BIP350 test vectors" ; doc:hierarchyLevel 3 ; doc:sectionOrder 37 ;
    doc:hasParentSection chx:S_Assurance ;
    skos:definition "BIP350 publishes 8 valid and 15 invalid segwit address vectors and 7 valid bech32m strings, and the toolkit and the reference library both pass all of the address vectors (Wuille, 2020)." ; dcterms:source <http://example.org/sen0401/ch04#TestVectors> .
chx:S_Semantics a doc:TaxonomicSection ; rdfs:label "Semantics"@en ; doc:sectionTitle "Semantics" ; doc:hierarchyLevel 1 ; doc:sectionOrder 38 ;
    skos:definition "The course theme of semantic technologies meets the chapter in what a key pair is: an identifier whose holder can prove control (World Wide Web Consortium, 2022)." ; dcterms:source <http://example.org/sen0401/ch04#Semantics> .
chx:S_Identifiers a doc:TaxonomicSection ; rdfs:label "Identifiers"@en ; doc:sectionTitle "Identifiers" ; doc:hierarchyLevel 2 ; doc:sectionOrder 39 ;
    doc:hasParentSection chx:S_Semantics ;
    skos:definition "Keys and decentralized identifiers both name a subject and let its controller prove control (World Wide Web Consortium, 2022)." ; dcterms:source <http://example.org/sen0401/ch04#Identifiers> .
chx:S_KeyControlProof a doc:ConceptSection ; rdfs:label "Proof of control by a key"@en ; doc:sectionTitle "Proof of control by a key" ; doc:hierarchyLevel 3 ; doc:sectionOrder 40 ;
    doc:hasParentSection chx:S_Identifiers ;
    skos:definition "A signature by the private key proves control of the public key and so of the funds or the identifier, without permission from a registry (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch04#KeyControlProof> .
chx:S_DecentralizedIdentifier a doc:ConceptSection ; rdfs:label "Decentralized identifier (DID)"@en ; doc:sectionTitle "Decentralized identifier (DID)" ; doc:hierarchyLevel 3 ; doc:sectionOrder 41 ;
    doc:hasParentSection chx:S_Identifiers ;
    skos:definition "W3C's Decentralized Identifiers are URIs that associate a subject with a DID document that can express cryptographic material and verification methods, designed so a controller can prove control without permission from any other party (World Wide Web Consortium, 2022)." ; dcterms:source <http://example.org/sen0401/ch04#DecentralizedIdentifier> .
