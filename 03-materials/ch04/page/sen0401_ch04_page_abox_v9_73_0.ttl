pg:Q1 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Why does Bitcoin use public key cryptography?"@en ;
    ld:assessesObjective pg:CO2 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "Nothing in a transaction is encrypted; the blockchain is public.",
        "Signatures add no size saving; their purpose is proof of control." ;
    ld:hasCorrectOption pg:Q1_O1 ;
    ld:hasOption pg:Q1_O0,
        pg:Q1_O1,
        pg:Q1_O2 .

pg:Q2 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "One private key gives two public keys, compressed and uncompressed. What follows for its P2PKH addresses?"@en ;
    ld:assessesObjective pg:CO1 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "Both forms are valid keys; the uncompressed one gives the legacy address 1424C2F4...",
        "The address commits to the public key's bytes, not to the private key." ;
    ld:hasCorrectOption pg:Q2_O2 ;
    ld:hasOption pg:Q2_O0,
        pg:Q2_O1,
        pg:Q2_O2 .

pg:Q3 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "A WIF-compressed private key starts with K or L, where a WIF key starts with 5. What causes that?"@en ;
    ld:assessesObjective pg:CO1 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "A private key cannot be compressed; the suffix only says to derive compressed public keys.",
        "Both formats use version 0x80." ;
    ld:hasCorrectOption pg:Q3_O0 ;
    ld:hasOption pg:Q3_O0,
        pg:Q3_O1,
        pg:Q3_O2 .

pg:Q4 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Which standard defines the secp256k1 curve, and is it on NIST's list?"@en ;
    ld:assessesObjective pg:CO4 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "SEC 2's table marks secp256k1 with a dash in the NIST column, unlike secp256r1.",
        "The whitepaper does not define curve parameters." ;
    ld:hasCorrectOption pg:Q4_O2 ;
    ld:hasOption pg:Q4_O0,
        pg:Q4_O1,
        pg:Q4_O2 .

pg:Q5 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "What is the only difference between the bech32 and bech32m checksums?"@en ;
    ld:assessesObjective pg:CO3 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "Both checksums are six characters.",
        "Both use the same 32-character alphabet." ;
    ld:hasCorrectOption pg:Q5_O1 ;
    ld:hasOption pg:Q5_O0,
        pg:Q5_O1,
        pg:Q5_O2 .

pg:Q6 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "The book's five extended strings such as bc1pqqqsq9txsqqqqp carry a valid bech32 checksum. What does Bitcoin Core 31.1 do with them?"@en ;
    ld:assessesObjective pg:CO3 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "Accepting them is the exact hazard bech32m was made to close.",
        "Core's validateaddress returns isvalid false, not a warning." ;
    ld:hasCorrectOption pg:Q6_O0 ;
    ld:hasOption pg:Q6_O0,
        pg:Q6_O1,
        pg:Q6_O2 .

pg:Q7 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "The book's vanity table says an eight-character pattern takes 13 to 18 years on average at 100,000 keys a second. What does its own rule (half the frequency) give?"@en ;
    ld:assessesObjective pg:CO4 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "58 to the eighth is 1.28 times 10 to the 14; half of it over 100,000 a second is 20.3 years, not 13 to 18.",
        "Two years would be a tenth of the figure the rule gives." ;
    ld:hasCorrectOption pg:Q7_O2 ;
    ld:hasOption pg:Q7_O0,
        pg:Q7_O1,
        pg:Q7_O2 .

