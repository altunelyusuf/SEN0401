pg:Card a ipo:Sidebar,
        owl:NamedIndividual ;
    rdfs:label "Detail card"@en ;
    dcterms:source <http://example.org/sen0401/ch04/document> ;
    skos:definition "The detail card at the right opens only when the reader explicitly asks for the details of a concept."@en .

pg:Header a ipo:Header,
        owl:NamedIndividual ;
    rdfs:label "Header with the main menu"@en ;
    dcterms:source <http://example.org/sen0401/ch04/document> ;
    skos:definition "The header at the top holds the main menu, whose items are intro, learn, maps, lab, agents, practice, reference, about."@en .

pg:Layout a ipo:LayoutPattern,
        owl:NamedIndividual ;
    rdfs:label "Explorer, main area and detail card"@en ;
    dcterms:source <http://example.org/sen0401/ch04/document> ;
    skos:definition "The page puts the chapter explorer at the left, the main area in the centre and a detail card at the right that stays closed until the reader asks for a detail."@en .

pg:Main a ipo:MainContent,
        owl:NamedIndividual ;
    rdfs:label "Main area"@en ;
    dcterms:source <http://example.org/sen0401/ch04/document> ;
    skos:definition "The main area shows the chapter content of the selected menu item, with the widgets of its sections inline."@en .

pg:Q1_O0 a ld:AnswerOption ;
    rdfs:label "To encrypt transactions so nobody can read them"@en .

pg:Q1_O2 a ld:AnswerOption ;
    rdfs:label "To make transactions smaller"@en .

pg:Q2_O0 a ld:AnswerOption ;
    rdfs:label "The same address, since the private key is the same"@en .

pg:Q2_O1 a ld:AnswerOption ;
    rdfs:label "No address for the uncompressed key"@en .

pg:Q3_O1 a ld:AnswerOption ;
    rdfs:label "The 0x80 version byte differs"@en .

pg:Q3_O2 a ld:AnswerOption ;
    rdfs:label "The private key itself is compressed"@en .

pg:Q4_O0 a ld:AnswerOption ;
    rdfs:label "NIST's FIPS 186, and yes"@en .

pg:Q4_O1 a ld:AnswerOption ;
    rdfs:label "The Bitcoin whitepaper, and not applicable"@en .

pg:Q5_O0 a ld:AnswerOption ;
    rdfs:label "The alphabet used for the characters"@en .

pg:Q5_O2 a ld:AnswerOption ;
    rdfs:label "The length of the checksum"@en .

pg:Q6_O1 a ld:AnswerOption ;
    rdfs:label "Accepts them as version 1 addresses"@en .

pg:Q6_O2 a ld:AnswerOption ;
    rdfs:label "Accepts them but warns"@en .

pg:Q7_O0 a ld:AnswerOption ;
    rdfs:label "About 13 to 18 years, so the table agrees"@en .

pg:Q7_O1 a ld:AnswerOption ;
    rdfs:label "About 2 years"@en .

pg:SectionTree a ipo:TreeNavigation,
        owl:NamedIndividual ;
    rdfs:label "Section tree"@en ;
    dcterms:source <http://example.org/sen0401/ch04/document> ;
    skos:definition "The section tree lists the sections of the chapter by their three levels, and choosing one opens that single section."@en .

pg:Sidebar a ipo:Sidebar,
        owl:NamedIndividual ;
    rdfs:label "Chapter explorer"@en ;
    dcterms:source <http://example.org/sen0401/ch04/document> ;
    skos:definition "The explorer at the left shows the chapter's sections as a tree and keeps pace with the tabs of the main area."@en .

pg:SourceDocument a ipo:SourceDocument,
        owl:NamedIndividual ;
    rdfs:label "Chapter 4 Stage 3 document"@en ;
    ipo:hasLearningObjective pg:CO1,
        pg:CO2,
        pg:CO3,
        pg:CO4 ;
    dcterms:source <http://example.org/sen0401/ch04/document> ;
    skos:definition "The Stage 3 document of chapter 4 is the text this page renders, section for section."@en .

pg:TopMenu a ipo:PrimaryNavigation,
        owl:NamedIndividual ;
    rdfs:label "Main menu"@en ;
    dcterms:source <http://example.org/sen0401/ch04/document> ;
    skos:definition "The main menu is permanently visible at the top and lets the reader reach every top-level area without scrolling or opening anything first."@en .

pg:Q1_O1 a ld:AnswerOption ;
    rdfs:label "So that only the private key's owner can sign and anyone can verify the signature"@en .

pg:Q2_O2 a ld:AnswerOption ;
    rdfs:label "Two different addresses, because the two keys hash to different commitments"@en .

pg:Q3_O0 a ld:AnswerOption ;
    rdfs:label "The extra 0x01 suffix makes the payload one byte longer"@en .

pg:Q4_O2 a ld:AnswerOption ;
    rdfs:label "SEC 2 of the Standards for Efficient Cryptography, and no"@en .

pg:Q5_O1 a ld:AnswerOption ;
    rdfs:label "The constant merged into the checksum, 1 against 0x2bc830a3"@en .

pg:Q6_O0 a ld:AnswerOption ;
    rdfs:label "Rejects them, because a version 1 witness needs a bech32m checksum"@en .

pg:Q7_O2 a ld:AnswerOption ;
    rdfs:label "About 20 years, so the table's figure is low"@en .

pg:S_Address a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Address"@en ;
    sen0401:anchor "#Address" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Address> ;
    skos:definition "This branch turns the keys of the first branch into something one person can hand to another."@en .

pg:S_AddressReuse a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Address reuse and privacy"@en ;
    sen0401:anchor "#AddressReuse" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_AddressReuse> ;
    skos:definition "Receiving several payments to the same address links them all together for anyone looking at the blockchain, which reduces the privacy of everyone who pays or is paid by that address."@en .

pg:S_Assurance a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Assurance"@en ;
    sen0401:anchor "#Assurance" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Assurance> ;
    skos:definition "Assurance is the confidence that an implementation does what the standard says."@en .

pg:S_Base58Check a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Base58check encoding"@en ;
    sen0401:anchor "#Base58Check" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Base58Check> ;
    skos:definition "Base58check encodes a version byte, the data and the first four bytes of a double SHA-256 checksum in a 58-character alphabet that leaves out the characters easily mistaken for each other."@en .

pg:S_BchCode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "BCH code"@en ;
    sen0401:anchor "#BchCode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_BchCode> ;
    skos:definition "A BCH code is an error-correcting code; bech32's checksum is a BCH code of six 5-bit characters, 30 bits, which is why errors beyond the guaranteed ones slip through less than once in a billion."@en .

pg:S_Bech32Address a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bech32 address"@en ;
    sen0401:anchor "#Bech32Address" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Bech32Address> ;
    skos:definition "A bech32 address is a human-readable part, the separator 1, a witness version, a witness program and a six-character checksum, in one case of a 32-character alphabet."@en .

pg:S_Bech32mAddress a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bech32m address"@en ;
    sen0401:anchor "#Bech32mAddress" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Bech32mAddress> ;
    skos:definition "Bech32m differs from bech32 only in the constant merged into the checksum, 0x2bc830a3 instead of 1, and is required for witness version 1 and later."@en .

pg:S_BitsAndBytes a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bits and bytes"@en ;
    sen0401:anchor "#BitsAndBytes" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_BitsAndBytes> ;
    skos:definition "A bit is a binary digit, 0 or 1; a byte is 8 bits; a public key of 65 bytes has 520 bits, and each hexadecimal digit stands for 4 bits."@en .

pg:S_Checksum a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Checksum"@en ;
    sen0401:anchor "#Checksum" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Checksum> ;
    skos:definition "A checksum is a short value computed from data and attached to it so that a changed copy can be detected; base58check uses the first four bytes of a double SHA256, a mistyped address fails the check."@en .

pg:S_Checksummed a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Checksummed text"@en ;
    sen0401:anchor "#Checksummed" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Checksummed> ;
    skos:definition "Checksummed text is text that carries a few extra characters computed from the rest, so that the reader of the text can detect a copying mistake."@en .

pg:S_CollisionAttack a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Collision attack"@en ;
    sen0401:anchor "#CollisionAttack" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_CollisionAttack> ;
    skos:definition "A collision attack is finding any two inputs with the same hash; because the attacker chooses both, the work is only about the square root of the output space, 2 to the 80 for HASH160, which is why newer addresses use 256-bit commitments."@en .

pg:S_Commitment a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hash commitment (HASH160)"@en ;
    sen0401:anchor "#Commitment" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Commitment> ;
    skos:definition "A hash function output is a commitment to its input; Bitcoin commits to a public key with HASH160, the RIPEMD-160 of the SHA-256 of it, 20 bytes instead of 65."@en .

pg:S_CompressedPrivateKey a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Compressed private key"@en ;
    sen0401:anchor "#CompressedPrivateKey" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_CompressedPrivateKey> ;
    skos:definition "A 'compressed private key' is not compressed: it is the private key followed by a one-byte suffix 01 that says only compressed public keys should be derived from it, so its WIF is one character longer."@en .

pg:S_CompressedPublicKey a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Compressed public key"@en ;
    sen0401:anchor "#CompressedPublicKey" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_CompressedPublicKey> ;
    skos:definition "A compressed public key keeps only x and one byte for the parity of y, 33 bytes instead of 65, and the y coordinate is recovered by solving the curve equation."@en .

pg:S_CryptoLibrary a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Cryptographic library (libsecp256k1)"@en ;
    sen0401:anchor "#CryptoLibrary" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_CryptoLibrary> ;
    skos:definition "A cryptographic library is tested, reusable code for the elliptic curve math; the book notes that many Bitcoin implementations use libsecp256k1, and this chapter's toolkit is only a readable sketch of the same calculation."@en .

pg:S_Curve a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The curve"@en ;
    sen0401:anchor "#Curve" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Curve> ;
    skos:definition "The curve is the mathematical object on which Bitcoin's public key cryptography is built."@en .

pg:S_CurveStandard a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Curve standard (SEC 2 and NIST)"@en ;
    sen0401:anchor "#CurveStandard" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_CurveStandard> ;
    skos:definition "SEC 2 lists recommended curve parameters with a table of which other standards each conforms to; secp256k1 is marked as not on the NIST list and secp256r1 is marked as recommended by it."@en .

pg:S_DecentralizedIdentifier a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Decentralized identifier (DID)"@en ;
    sen0401:anchor "#DecentralizedIdentifier" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_DecentralizedIdentifier> ;
    skos:definition "A decentralized identifier is a URI that associates a subject with a DID document that can carry verification methods such as public keys, so its controller can prove control without permission from another party."@en .

pg:S_DefaultAddressType a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Default address type"@en ;
    sen0401:anchor "#DefaultAddressType" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_DefaultAddressType> ;
    skos:definition "Bitcoin Core's addresstype option defaults to bech32, a P2WPKH address, and the four types are legacy, p2sh-segwit, bech32 and bech32m, the last a taproot address."@en .

pg:S_DeterministicWallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Deterministic wallet and seed"@en ;
    sen0401:anchor "#DeterministicWallet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_DeterministicWallet> ;
    skos:definition "A deterministic wallet derives all its private keys from a single seed, a random value, by a repeatable procedure, so one backup covers every key; the book's example derives three keys by hashing the seed with 0, 1 and 2."@en .

pg:S_DigitalSignature a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Digital signature"@en ;
    sen0401:anchor "#DigitalSignature" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_DigitalSignature> ;
    skos:definition "A digital signature is a number computed from a message and a private key that anyone holding the public key can verify, and that cannot be produced without the private key."@en .

pg:S_DiscreteLogarithm a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Discrete logarithm and brute-force search"@en ;
    sen0401:anchor "#DiscreteLogarithm" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_DiscreteLogarithm> ;
    skos:definition "Finding the multiplier k from K = kG is the discrete logarithm problem; with no shortcut it is as hard as trying every value of k, a brute-force search; in a toy group modulo 101 it takes 9 tries to find that 2 to the power 9 leaves 7."@en .

pg:S_EllipticCurve a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Elliptic curve"@en ;
    sen0401:anchor "#EllipticCurve" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_EllipticCurve> ;
    skos:definition "An elliptic curve is the set of points (x, y) that satisfy an equation such as y squared = x cubed + 7, together with a point at infinity; over the field with 17 elements the curve y squared = x cubed + 7 has 17 points besides the point at infinity."@en .

pg:S_Entropy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Entropy"@en ;
    sen0401:anchor "#Entropy" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Entropy> ;
    skos:definition "Entropy is unpredictability measured in bits; a private key needs 256 bits of it, as many as 256 fair coin tosses supply."@en .

pg:S_ErrorDetection a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Error detection"@en ;
    sen0401:anchor "#ErrorDetection" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_ErrorDetection> ;
    skos:definition "Bech32 is guaranteed to detect any error affecting four characters or fewer, and Bitcoin Core points to where a typing error is, while bech32's original constant let a q be added before a final p without detection, which bech32m fixes."@en .

pg:S_FiniteField a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Finite field"@en ;
    sen0401:anchor "#FiniteField" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_FiniteField> ;
    skos:definition "A finite field of prime order p is the whole numbers from 0 to p - 1 with addition, subtraction, multiplication and division carried out modulo p; division by 5 modulo 17 is multiplication by 7."@en .

pg:S_Format a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Format"@en ;
    sen0401:anchor "#Format" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Format> ;
    skos:definition "This branch is about writing the same information down in different ways."@en .

pg:S_GeneratorPoint a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Generator point"@en ;
    sen0401:anchor "#GeneratorPoint" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_GeneratorPoint> ;
    skos:definition "The generator point G is the fixed point of the secp256k1 standard from which every public key is reached by multiplication; adding it to itself n times gives the point at infinity."@en .

pg:S_HardwareSigningDevice a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hardware signing device"@en ;
    sen0401:anchor "#HardwareSigningDevice" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_HardwareSigningDevice> ;
    skos:definition "A hardware signing device holds private keys and uses them only to sign; a less secure program prepares the transaction and broadcasts it, so the keys never meet general-purpose software."@en .

pg:S_Hash160 a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "HASH160"@en ;
    sen0401:anchor "#Hash160" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Hash160> ;
    skos:definition "HASH160 is the RIPEMD-160 of the SHA256 of the data; for the book's compressed example key it is bbc1e42a39d05a4cc61752d6963b7f69d09bb27b, and the uncompressed form of the same key gives a different value."@en .

pg:S_HashFunction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hash function"@en ;
    sen0401:anchor "#HashFunction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_HashFunction> ;
    skos:definition "A hash function takes a potentially large amount of data and outputs a fixed amount of data; a cryptographic hash function always gives the same output for the same input, and changing one bit of the input changes about half of the output bits."@en .

pg:S_Hashing a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hash functions"@en ;
    sen0401:anchor "#Hashing" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Hashing> ;
    skos:definition "A hash function is the second tool, next to the elliptic curve, from which Bitcoin addresses are built."@en .

pg:S_HumanReadablePart a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Human-readable part"@en ;
    sen0401:anchor "#HumanReadablePart" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_HumanReadablePart> ;
    skos:definition "The human-readable part opens a bech32 address and names its network or purpose, for Bitcoin bc for the main network and tb for testnet; it is followed by the separator 1."@en .

pg:S_Identifiers a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Identifiers"@en ;
    sen0401:anchor "#Identifiers" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Identifiers> ;
    skos:definition "An identifier is a name that refers to a thing, so that statements about the thing can be made, stored and found."@en .

pg:S_IndependentCheck a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Cross-checking with independent software"@en ;
    sen0401:anchor "#IndependentCheck" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_IndependentCheck> ;
    skos:definition "Cross-checking compares the results of independent implementations on the same input; this chapter compares its own toolkit with Bitcoin Core 31.1 and with the book's reference code, and finds the same addresses."@en .

pg:S_InputScript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Input script"@en ;
    sen0401:anchor "#InputScript" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_InputScript> ;
    skos:definition "An input script supplies the data that satisfies the output script of the output being spent; for a P2PKH output it consists of a signature and the public key, with the public key on top of the stack."@en .

pg:S_IpAddressPayment a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Payment to an IP address"@en ;
    sen0401:anchor "#IpAddressPayment" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_IpAddressPayment> ;
    skos:definition "The earliest Bitcoin software let a spender type the receiver's IP address; the spender's node contacted the receiver's node and obtained a new public key, but the receiver had to be online and reachable."@en .

pg:S_KeyControlProof a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Proof of control by a key"@en ;
    sen0401:anchor "#KeyControlProof" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_KeyControlProof> ;
    skos:definition "Whoever holds a private key can prove control of the matching public key by signing, without a central registry or anyone's permission."@en .

pg:S_KeyEncoding a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Key encoding"@en ;
    sen0401:anchor "#KeyEncoding" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch04#S_KeyEncoding> ;
    skos:definition "A key encoding is a particular way of writing a key down as bytes or as text."@en .

pg:S_KeyExport a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Exporting a single key"@en ;
    sen0401:anchor "#KeyExport" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_KeyExport> ;
    skos:definition "Deterministic descriptor wallets no longer export single keys, and Bitcoin Core removed dumpprivkey and importprivkey in 30.0, while a WIF key can still be used inside a descriptor."@en .

pg:S_KeyPair a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Key pair"@en ;
    sen0401:anchor "#KeyPair" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch04#S_KeyPair> ;
    skos:definition "A key pair is the combination of a private key and a public key that belongs to it."@en .

pg:S_Keys a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Keys"@en ;
    sen0401:anchor "#Keys" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Keys> ;
    skos:definition "This branch of the chapter starts from a payment."@en .

pg:S_Legacy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Legacy addresses"@en ;
    sen0401:anchor "#Legacy" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Legacy> ;
    skos:definition "Legacy addresses are the address kinds that Bitcoin used before the introduction of segregated witness, and the book still calls them legacy: pay to public key hash (P2PKH) and pay to script hash (P2SH), both written with the base58check encoding (Antonopoulos and Harding, 2023)."@en .

pg:S_LengthExtension a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bech32 length extension weakness"@en ;
    sen0401:anchor "#LengthExtension" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_LengthExtension> ;
    skos:definition "In bech32, adding or removing the letter q just before a final p leaves the checksum valid; the book's six extended strings are valid under bech32 and invalid under bech32m."@en .

pg:S_Modern a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Practice now"@en ;
    sen0401:anchor "#Modern" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Modern> ;
    skos:definition "Practice now means the behaviour of current wallets and the advice of the book's third edition."@en .

pg:S_MultisigScript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Multisignature script"@en ;
    sen0401:anchor "#MultisigScript" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_MultisigScript> ;
    skos:definition "A multisignature script requires signatures from several keys; the opcode OP_CHECKMULTISIG checks m signatures against n public keys, as in BIP16's example of 2 of 3."@en .

pg:S_NestedSegwit a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Segwit inside P2SH"@en ;
    sen0401:anchor "#NestedSegwit" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_NestedSegwit> ;
    skos:definition "A P2SH address can wrap a witness program: the redeem script is the witness output script (OP_0 and the 20-byte key hash), so an older payer that only knows P2SH can pay a segwit receiver."@en .

pg:S_NetworkSelector a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Mainnet and testnet"@en ;
    sen0401:anchor "#NetworkSelector" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_NetworkSelector> ;
    skos:definition "The main network and a test network are separate chains with their own data; addresses show which one they belong to through the version byte of base58check (0x00 against 0x6F for P2PKH) or through the human-readable part of bech32 (bc against tb)."@en .

pg:S_NumberBase a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Number base (hexadecimal, base58, base64)"@en ;
    sen0401:anchor "#NumberBase" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_NumberBase> ;
    skos:definition "A number base, or radix, is the count of different symbols used to write numbers; hexadecimal uses 16, base64 uses 64 and base58 uses 58, and the same number is shorter in a larger base."@en .

pg:S_OutputScript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Output script"@en ;
    sen0401:anchor "#OutputScript" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_OutputScript> ;
    skos:definition "An output script is the condition that a transaction output places on its spender; the script of a P2PKH output for the book's key is the 25 bytes 76a914, the 20-byte HASH160 of the key, and 88ac."@en .

pg:S_P2pk a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Pay to public key (P2PK)"@en ;
    sen0401:anchor "#P2pk" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_P2pk> ;
    skos:definition "A pay to public key output locks funds with the receiver's public key and the opcode OP_CHECKSIG, and is spent with the signature alone; it was never widely used for payments."@en .

pg:S_P2pkhAddress a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "P2PKH address"@en ;
    sen0401:anchor "#P2pkhAddress" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_P2pkhAddress> ;
    skos:definition "A P2PKH address is the base58check encoding of version 0x00 and the HASH160 of the public key, and a compressed and an uncompressed key give two different addresses."@en .

pg:S_P2shAddress a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "P2SH address"@en ;
    sen0401:anchor "#P2shAddress" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_P2shAddress> ;
    skos:definition "A P2SH address commits with HASH160 to a redeem script instead of a key, uses version byte 0x05 and starts with 3."@en .

pg:S_P2tr a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Pay to taproot (P2TR)"@en ;
    sen0401:anchor "#P2tr" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_P2tr> ;
    skos:definition "A P2TR output script is OP_1 followed by a 32-byte witness program that is a point on the secp256k1 curve, which may be a public key or a key that commits to more data; its address is bech32m."@en .

pg:S_P2wpkh a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Pay to witness public key hash (P2WPKH)"@en ;
    sen0401:anchor "#P2wpkh" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_P2wpkh> ;
    skos:definition "A P2WPKH output script is OP_0 followed by the 20-byte HASH160 of a public key, the same commitment as P2PKH, 22 bytes in all; its address is bech32."@en .

pg:S_P2wsh a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Pay to witness script hash (P2WSH)"@en ;
    sen0401:anchor "#P2wsh" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_P2wsh> ;
    skos:definition "A P2WSH output script is OP_0 followed by the 32-byte SHA256 of a script, without the RIPEMD-160 step of P2SH, 34 bytes in all."@en .

pg:S_PaperWallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Paper wallet"@en ;
    sen0401:anchor "#PaperWallet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_PaperWallet> ;
    skos:definition "A paper wallet is a private key printed on paper, which the 3rd edition calls an obsolete technology and dangerous for most users."@en .

pg:S_PassphraseProtection a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Passphrase-protected key"@en ;
    sen0401:anchor "#PassphraseProtection" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_PassphraseProtection> ;
    skos:definition "BIP38 encrypts a private key under a passphrase into a 58-character base58check string starting with 6P; the BIPs repository lists it as Deployed with the comment summary Unanimously Discourage for implementation, and the 3rd edition does not cover it."@en .

pg:S_PointAddition a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Point addition and the point at infinity"@en ;
    sen0401:anchor "#PointAddition" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_PointAddition> ;
    skos:definition "Two points of the curve are added by drawing a line through them, finding the third intersection and reflecting it in the x-axis; the point at infinity plays the role of zero."@en .

pg:S_PointMultiplication a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Elliptic curve multiplication"@en ;
    sen0401:anchor "#PointMultiplication" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_PointMultiplication> ;
    skos:definition "Multiplying a point by a whole number k means adding it to itself k times, which the double-and-add method does in about 256 doublings and additions; for the book's key it is 252 doublings and 123 additions."@en .

pg:S_Practice a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Practice"@en ;
    sen0401:anchor "#Practice" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Practice> ;
    skos:definition "This branch asks what a user or a developer should do with the material of the earlier branches today."@en .

pg:S_PreimageAttack a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Preimage attack"@en ;
    sen0401:anchor "#PreimageAttack" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_PreimageAttack> ;
    skos:definition "A preimage attack is finding an input for a given hash output; for a secure 160-bit function such as HASH160 an attacker that tries inputs succeeds with probability 1 in 2 to the 160 per try."@en .

pg:S_PrivateKey a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Private key"@en ;
    sen0401:anchor "#PrivateKey" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_PrivateKey> ;
    skos:definition "A private key is a number picked at random between 1 and n minus 1, where n, about 1.1579 times 10 to the 77, is the order of the curve and slightly less than 2 to the 256."@en .

pg:S_PublicKey a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Public key"@en ;
    sen0401:anchor "#PublicKey" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_PublicKey> ;
    skos:definition "A public key is the point K = k x G obtained by multiplying the generator point by the private key, which is easy in one direction and infeasible to reverse."@en .

pg:S_PublicKeyCryptography a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Public key cryptography"@en ;
    sen0401:anchor "#PublicKeyCryptography" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_PublicKeyCryptography> ;
    skos:definition "Public key cryptography lets a private key produce a signature that anyone can check against the public key, which is what Bitcoin uses it for, not for encrypting transactions."@en .

pg:S_QrCode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "QR code"@en ;
    sen0401:anchor "#QrCode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_QrCode> ;
    skos:definition "A QR code is a two-dimensional barcode that a camera can read; its alphanumeric mode makes uppercase text about 45 percent more compact than the normal byte mode, which is why bech32 addresses are put into QR codes in uppercase."@en .

pg:S_RandomSource a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Randomness"@en ;
    sen0401:anchor "#RandomSource" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch04#S_RandomSource> ;
    skos:definition "Randomness is the property of a number or a sequence of numbers that nobody can predict or repeat."@en .

pg:S_RedeemScript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Redeem script"@en ;
    sen0401:anchor "#RedeemScript" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_RedeemScript> ;
    skos:definition "A redeem script is the script that a P2SH output commits to by its HASH160; it is revealed in the input script when the output is spent, and nodes check its hash before running it."@en .

pg:S_Representation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Representation of data"@en ;
    sen0401:anchor "#Representation" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Representation> ;
    skos:definition "The representation of data is the way a value is written down: as a count of bits, as a sequence of bytes, as digits in some number base, or as a picture that a camera can read."@en .

pg:S_Ripemd160 a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "RIPEMD-160"@en ;
    sen0401:anchor "#Ripemd160" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Ripemd160> ;
    skos:definition "RIPEMD-160 is a hash function with a 160-bit (20-byte) output; Bitcoin applies it to the SHA256 of a public key to obtain a 20-byte commitment."@en .

pg:S_Scripts a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Locking and unlocking scripts"@en ;
    sen0401:anchor "#Scripts" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Scripts> ;
    skos:definition "A script, in Bitcoin, is a short program that decides whether a spend of an output is allowed."@en .

pg:S_SecondPreimageAttack a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Second preimage attack"@en ;
    sen0401:anchor "#SecondPreimageAttack" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_SecondPreimageAttack> ;
    skos:definition "A second preimage attack is finding a different input that gives the same hash as a given input; for addresses created entirely by one party the chance is again about 1 in 2 to the 160 for HASH160."@en .

pg:S_Secp256k1 a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The secp256k1 curve"@en ;
    sen0401:anchor "#Secp256k1" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Secp256k1> ;
    skos:definition "The secp256k1 curve, y squared = x cubed + 7 over the prime field with p = 2 to the 256 minus 2 to the 32 minus 977, is defined in SEC 2 by Certicom Research and is not a NIST-recommended curve."@en .

pg:S_SecureRandomness a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Secure randomness"@en ;
    sen0401:anchor "#SecureRandomness" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_SecureRandomness> ;
    skos:definition "A private key must come from a cryptographically secure random generator; Python's secrets module is documented for that use and its random module for modelling and simulation."@en .

pg:S_Segwit a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Segwit addresses"@en ;
    sen0401:anchor "#Segwit" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Segwit> ;
    skos:definition "Segwit addresses are the addresses written for segregated witness outputs."@en .

pg:S_SegwitUpgrade a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Segregated witness upgrade"@en ;
    sen0401:anchor "#SegwitUpgrade" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_SegwitUpgrade> ;
    skos:definition "Segregated witness moves the signatures and scripts of a transaction into a separate witness structure, so that the transaction identifier no longer depends on them and a spender, not a third party, controls it."@en .

pg:S_Semantics a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Semantics"@en ;
    sen0401:anchor "#Semantics" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Semantics> ;
    skos:definition "This branch links the chapter to the theme of the course on identity and semantics."@en .

pg:S_Sha256 a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "SHA256"@en ;
    sen0401:anchor "#Sha256" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Sha256> ;
    skos:definition "SHA256 is the hash function most commonly used in Bitcoin; its output is 256 bits (32 bytes), and the SHA256 of the three bytes abc begins ba7816bf."@en .

pg:S_StackExecution a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Stack, opcodes and script evaluation"@en ;
    sen0401:anchor "#StackExecution" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_StackExecution> ;
    skos:definition "Scripts run on a stack: data is pushed on top of a list, each opcode consumes the topmost items and pushes its result, and the script passes if a nonzero item is on top at the end; OP_DUP copies the top item."@en .

pg:S_TestVectors a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "BIP350 test vectors"@en ;
    sen0401:anchor "#TestVectors" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_TestVectors> ;
    skos:definition "The BIP350 test vectors give valid and invalid segwit addresses and bech32m strings against which any bech32m implementation should be run, including those for future witness versions."@en .

pg:S_UncompressedPublicKey a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Uncompressed public key"@en ;
    sen0401:anchor "#UncompressedPublicKey" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_UncompressedPublicKey> ;
    skos:definition "An uncompressed public key is the prefix 04 followed by the x and y coordinates, 65 bytes, and it hashes to a different address than the compressed form of the same key."@en .

pg:S_Uri a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Uniform resource identifier (URI)"@en ;
    sen0401:anchor "#Uri" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_Uri> ;
    skos:definition "A URI is a compact sequence of characters that identifies an abstract or physical resource; the identifiers of the DID standard are URIs of the form did, a colon, a method name, a colon and a method-specific identifier."@en .

pg:S_VanityAddress a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Vanity address"@en ;
    sen0401:anchor "#VanityAddress" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_VanityAddress> ;
    skos:definition "A vanity address starts with a chosen string found by trying keys one after another, and each further character multiplies the work by 58, so four characters take 58 to the fourth, about 11 million keys."@en .

pg:S_VersionPrefix a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Version prefix"@en ;
    sen0401:anchor "#VersionPrefix" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_VersionPrefix> ;
    skos:definition "The version byte makes the encoded text start with a recognisable character: 1 for a P2PKH address, 3 for P2SH, 5, K or L for a WIF key, and xpub for a BIP32 extended public key."@en .

pg:S_WalletImportFormat a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Wallet import format (WIF)"@en ;
    sen0401:anchor "#WalletImportFormat" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_WalletImportFormat> ;
    skos:definition "The wallet import format is the base58check encoding of version byte 0x80 and the private key, with a 0x01 suffix for the compressed form, which changes the first character from 5 to K or L."@en .

pg:S_WitnessProgram a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Witness program"@en ;
    sen0401:anchor "#WitnessProgram" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_WitnessProgram> ;
    skos:definition "The witness program is 2 to 40 bytes and, for witness version 0, exactly 20 or 32; for version 1, taproot, it is a 32-byte point."@en .

pg:S_WitnessVersion a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Witness version"@en ;
    sen0401:anchor "#WitnessVersion" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch04#S_WitnessVersion> ;
    skos:definition "The witness version is the first character after the separator of a segwit address; it is a number from 0 to 16, and the character q stands for 0 and p for 1."@en .

pg:CO2 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Explain why Bitcoin uses public key cryptography and what a hash commitment to a key achieves"@en ;
    ld:bloomLevel ld:Understand ;
    dcterms:source <http://example.org/sen0401/ch04/document> ;
    skos:definition "After this chapter the learner can explain why Bitcoin uses public key cryptography and what a hash commitment to a key achieves."@en .

pg:CO1 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Compute a public key, its addresses and its WIF from a private key, and say which forms are compressed"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch04/document> ;
    skos:definition "After this chapter the learner can compute a public key, its addresses and its WIF from a private key, and say which forms are compressed."@en .

pg:CO3 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Encode and validate base58check, bech32 and bech32m strings, and explain what bech32m changed"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch04/document> ;
    skos:definition "After this chapter the learner can encode and validate base58check, bech32 and bech32m strings, and explain what bech32m changed."@en .

pg:CO4 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Check a chapter's statements against primary sources and independent software, and say which is right"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch04/document> ;
    skos:definition "After this chapter the learner can check a chapter's statements against primary sources and independent software, and say which is right."@en .

