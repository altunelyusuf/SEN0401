pg:Page a ipo:Page, ipo:InteractiveLearningSurface ; rdfs:label "Chapter 4 interactive page"@en ;
    dcterms:source <http://example.org/sen0401/ch04/document> ; ipo:hasSourceDocument pg:SourceDocument ;
    ipo:satisfiesHeuristic ipo:RecognitionRatherThanRecall, ipo:ConsistencyAndStandards, ipo:AestheticAndMinimalistDesign,
        ipo:ShneidermanRule_OfferInformativeFeedback, ipo:ShneidermanRule_PermitEasyReversalOfActions, ipo:HelpAndDocumentation ;
    ipo:hasLayoutPattern pg:Layout ; ipo:hasSemanticRegion pg:Header, pg:Sidebar, pg:Main ;
    ipo:includesNavigationPattern pg:GroupedTopBar, pg:SectionTree ;
    ipo:coversLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 ;
    sen0401:navigationRule "BP-D34: 41 sections falls in 26-50, so a grouped permanent top bar with a sub-section sidebar; the named single flowing anchor-page variation of procedure v1.6.0 section 5.3." ;
    sen0401:pythonUsed "Python 3.14.4" .
pg:Layout a ipo:SplitLayout ; rdfs:label "Sidebar and main content"@en .
pg:Header a ipo:Header ; rdfs:label "Sticky header with grouped section bar"@en .
pg:Sidebar a ipo:Sidebar ; rdfs:label "Section tree"@en .
pg:Main a ipo:MainContent ; rdfs:label "Chapter content with inline widgets"@en .
pg:GroupedTopBar a ipo:PrimaryNavigation ; rdfs:label "Grouped permanent top bar"@en .
pg:SectionTree a ipo:TreeNavigation ; rdfs:label "Sub-section sidebar tree"@en .
pg:SourceDocument a ipo:SourceDocument ; rdfs:label "Chapter 4 Stage 3 document"@en ; dcterms:source <http://example.org/sen0401/ch04/document> ;
    ipo:hasLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 .

pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Compute a public key, its addresses and its WIF from a private key, and say which forms are compressed"@en ; ld:bloomLevel ld:Apply  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Explain why Bitcoin uses public key cryptography and what a hash commitment to a key achieves"@en ; ld:bloomLevel ld:Understand  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Encode and validate base58check, bech32 and bech32m strings, and explain what bech32m changed"@en ; ld:bloomLevel ld:Apply  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Check a chapter's statements against primary sources and independent software, and say which is right"@en ; ld:bloomLevel ld:Apply  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Why does Bitcoin use public key cryptography?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "Nothing in a transaction is encrypted; the blockchain is public." ; ld:distractorRationale "Signatures add no size saving; their purpose is proof of control." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "To encrypt transactions so nobody can read them" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "So that only the private key's owner can sign and anyone can verify the signature" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "To make transactions smaller" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "One private key gives two public keys, compressed and uncompressed. What follows for its P2PKH addresses?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O2 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "The address commits to the public key's bytes, not to the private key." ; ld:distractorRationale "Both forms are valid keys; the uncompressed one gives the legacy address 1424C2F4..." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "The same address, since the private key is the same" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "No address for the uncompressed key" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "Two different addresses, because the two keys hash to different commitments" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A WIF-compressed private key starts with K or L, where a WIF key starts with 5. What causes that?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "Both formats use version 0x80." ; ld:distractorRationale "A private key cannot be compressed; the suffix only says to derive compressed public keys." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "The extra 0x01 suffix makes the payload one byte longer" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "The 0x80 version byte differs" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "The private key itself is compressed" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Which standard defines the secp256k1 curve, and is it on NIST's list?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O2 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "SEC 2's table marks secp256k1 with a dash in the NIST column, unlike secp256r1." ; ld:distractorRationale "The whitepaper does not define curve parameters." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "NIST's FIPS 186, and yes" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "The Bitcoin whitepaper, and not applicable" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "SEC 2 of the Standards for Efficient Cryptography, and no" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What is the only difference between the bech32 and bech32m checksums?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "Both use the same 32-character alphabet." ; ld:distractorRationale "Both checksums are six characters." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "The alphabet used for the characters" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "The constant merged into the checksum, 1 against 0x2bc830a3" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "The length of the checksum" .
pg:Q6 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "The book's five extended strings such as bc1pqqqsq9txsqqqqp carry a valid bech32 checksum. What does Bitcoin Core 31.1 do with them?"@en ; ld:hasOption pg:Q6_O0, pg:Q6_O1, pg:Q6_O2 ; ld:hasCorrectOption pg:Q6_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "Accepting them is the exact hazard bech32m was made to close." ; ld:distractorRationale "Core's validateaddress returns isvalid false, not a warning." .
pg:Q6_O0 a ld:AnswerOption ; rdfs:label "Rejects them, because a version 1 witness needs a bech32m checksum" .
pg:Q6_O1 a ld:AnswerOption ; rdfs:label "Accepts them as version 1 addresses" .
pg:Q6_O2 a ld:AnswerOption ; rdfs:label "Accepts them but warns" .
pg:Q7 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "The book's vanity table says an eight-character pattern takes 13 to 18 years on average at 100,000 keys a second. What does its own rule (half the frequency) give?"@en ; ld:hasOption pg:Q7_O0, pg:Q7_O1, pg:Q7_O2 ; ld:hasCorrectOption pg:Q7_O2 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "58 to the eighth is 1.28 times 10 to the 14; half of it over 100,000 a second is 20.3 years, not 13 to 18." ; ld:distractorRationale "Two years would be a tenth of the figure the rule gives." .
pg:Q7_O0 a ld:AnswerOption ; rdfs:label "About 13 to 18 years, so the table agrees" .
pg:Q7_O1 a ld:AnswerOption ; rdfs:label "About 2 years" .
pg:Q7_O2 a ld:AnswerOption ; rdfs:label "About 20 years, so the table's figure is low" .
