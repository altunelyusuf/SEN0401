pg:w_PrivateKey a ipo:InstructionalWidget, ipo:CoupledVariableDemonstrator ; rdfs:label "predict widget for PrivateKey"@en ; ipo:demonstratesSubject <http://example.org/sen0401/ch04#PrivateKey> ;
    ipo:enforcesDomainConstraint <http://example.org/sen0401/ch04#PrivateKey> ;
    mp:numericModelStatus mp:Validated ; mp:hasValidationDerivation "Every value the widget reveals was produced by executing the expression under Python 3.14.4 at build time, not typed" ; mp:hasConformanceTest "The browser design test requires the revealed value to equal the executed one" ;
    wp:instantiatesPrimitive wp:Primitive_CoupledVariableExplorer ; ds:selectionWarrant "Feature_AsymmetricContrast: the learner edits and predicts 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141 < 2**256, then Pyodide shows what Python actually does" ;
    wp:demonstratesConcept <http://example.org/sen0401/ch04#PrivateKey> ; dcterms:source <http://example.org/sen0401/ch04/document> ;
    wp:hasDesignTest "Exercised in headless Chromium by 08-tooling/sen0401_page_test_v2_0_0.py: printed 'True'; edited to 2 + 2 printed '4'; card shows 'True'" ; wp:designTestPassed true .
