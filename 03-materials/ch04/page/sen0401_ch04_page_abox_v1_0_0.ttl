    wp:instantiatesPrimitive wp:Primitive_GuidedNarrativeWalkthrough ; ds:selectionWarrant "Feature_OrderedArgument: example first, then its explanation" ;
    wp:demonstratesConcept <http://example.org/sen0401/ch04#PublicKeyCryptography> ; dcterms:source <http://example.org/sen0401/ch04/document> ;
