chx:Document a doc:ReportSection ; rdfs:label "Bitcoin in numbers: price, supply and mining power since 2009"@en ; skos:definition "This document turns the Bitcoin price, supply and mining power dashboard into SEN0401 course material, grounded in its Blockchain.com snapshot and in Mastering Bitcoin's 3rd edition (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers/research> ;
    doc:hasSection chx:S_Price, chx:S_Supply, chx:S_Mining, chx:S_Provenance .
chx:S_Price a doc:TaxonomicSection ; rdfs:label "Price"@en ; doc:sectionTitle "Price" ; doc:hierarchyLevel 1 ; doc:sectionOrder 1 ;
    skos:definition "The first part of the dashboard follows the market price, where boom-and-bust cycles dominate the history (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#Price> .
chx:S_PriceHistory a doc:TaxonomicSection ; rdfs:label "Price history"@en ; doc:sectionTitle "Price history" ; doc:hierarchyLevel 2 ; doc:sectionOrder 2 ;
    doc:hasParentSection chx:S_Price ;
    skos:definition "The price history is shown two ways: the full series, and each year's range (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#PriceHistory> .
chx:S_MarketPrice a doc:ConceptSection ; rdfs:label "Market price"@en ; doc:sectionTitle "Market price" ; doc:hierarchyLevel 3 ; doc:sectionOrder 3 ;
    doc:hasParentSection chx:S_PriceHistory ;
    skos:definition "The chart Market price, USD shows the market price: the average US-dollar price across major exchanges; a logarithmic scale shows the whole history and a linear scale shows recent dollar swings, and the price at its last sample was 86,184.81 dollars (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#MarketPrice> .
chx:S_YearlyTradingRange a doc:ConceptSection ; rdfs:label "Yearly trading range"@en ; doc:sectionTitle "Yearly trading range" ; doc:hierarchyLevel 3 ; doc:sectionOrder 4 ;
    doc:hasParentSection chx:S_PriceHistory ;
    skos:definition "In the Yearly trading range chart each year appears as a floating bar from its low to its high with the closing price marked, so a volatile year is a tall bar (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#YearlyTradingRange> .
chx:S_PriceChange a doc:TaxonomicSection ; rdfs:label "Price change"@en ; doc:sectionTitle "Price change" ; doc:hierarchyLevel 2 ; doc:sectionOrder 5 ;
    doc:hasParentSection chx:S_Price ;
    skos:definition "Change is easier to compare than level when prices span six orders of magnitude (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#PriceChange> .
chx:S_YearOnYearChange a doc:ConceptSection ; rdfs:label "Year-on-year change"@en ; doc:sectionTitle "Year-on-year change" ; doc:hierarchyLevel 3 ; doc:sectionOrder 6 ;
    doc:hasParentSection chx:S_PriceChange ;
    skos:definition "The Year-on-year change chart compares each close with the previous close; bars beyond plus 400 per cent are cut off and labelled (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#YearOnYearChange> .
chx:S_Supply a doc:TaxonomicSection ; rdfs:label "Supply"@en ; doc:sectionTitle "Supply" ; doc:hierarchyLevel 1 ; doc:sectionOrder 7 ;
    skos:definition "The second part, Minted coins, shows the coins issued against the 21 million cap that chapter 1 describes (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/numbers#Supply> .
chx:S_Circulation a doc:TaxonomicSection ; rdfs:label "Circulation"@en ; doc:sectionTitle "Circulation" ; doc:hierarchyLevel 2 ; doc:sectionOrder 8 ;
    doc:hasParentSection chx:S_Supply ;
    skos:definition "Circulation is the running total of every block subsidy paid so far (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#Circulation> .
chx:S_CirculatingSupply a doc:ConceptSection ; rdfs:label "Circulating supply"@en ; doc:sectionTitle "Circulating supply" ; doc:hierarchyLevel 3 ; doc:sectionOrder 9 ;
    doc:hasParentSection chx:S_Circulation ;
    skos:definition "The Circulating supply chart grows in steps toward the 21 million ceiling, each step flatter than the last (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#CirculatingSupply> .
chx:S_MinedVsRemaining a doc:ConceptSection ; rdfs:label "Mined vs still to mine"@en ; doc:sectionTitle "Mined vs still to mine" ; doc:hierarchyLevel 3 ; doc:sectionOrder 10 ;
    doc:hasParentSection chx:S_Circulation ;
    skos:definition "Mined vs still to mine puts it plainly: at the snapshot, 20,087,925 bitcoins had been issued - 95.66 per cent of the 21 million cap - leaving less than a twentieth to be mined over more than a century (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#MinedVsRemaining> .
chx:S_Issuance a doc:TaxonomicSection ; rdfs:label "Issuance"@en ; doc:sectionTitle "Issuance" ; doc:hierarchyLevel 2 ; doc:sectionOrder 11 ;
    doc:hasParentSection chx:S_Supply ;
    skos:definition "Yearly issuance falls in steps because the block subsidy halves every 210,000 blocks (Bitcoin Wiki, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#Issuance> .
chx:S_AnnualIssuance a doc:ConceptSection ; rdfs:label "Annual issuance"@en ; doc:sectionTitle "Annual issuance" ; doc:hierarchyLevel 3 ; doc:sectionOrder 12 ;
    doc:hasParentSection chx:S_Issuance ;
    skos:definition "The chart New coins minted per year drops sharply after each halving, from over three million in 2010 to about 165,000 in 2025 (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#AnnualIssuance> .
chx:S_HalvingEra a doc:ConceptSection ; rdfs:label "Halving era"@en ; doc:sectionTitle "Halving era" ; doc:hierarchyLevel 3 ; doc:sectionOrder 13 ;
    doc:hasParentSection chx:S_Issuance ;
    skos:definition "The subsidy started at 50 bitcoin and halves every 210,000 blocks; the fourth halving, on 2024-04-20, set it at 3.125 bitcoin (Bitcoin Wiki, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#HalvingEra> .
chx:S_Mining a doc:TaxonomicSection ; rdfs:label "Mining"@en ; doc:sectionTitle "Mining" ; doc:hierarchyLevel 1 ; doc:sectionOrder 14 ;
    skos:definition "The third part, Mining capacity, shows the computing power securing the chain, which is chapter 2's security by computation made visible (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/numbers#Mining> .
chx:S_HashPower a doc:TaxonomicSection ; rdfs:label "Hash power"@en ; doc:sectionTitle "Hash power" ; doc:hierarchyLevel 2 ; doc:sectionOrder 15 ;
    doc:hasParentSection chx:S_Mining ;
    skos:definition "Hash power is the total rate of guesses miners make in the proof-of-work search (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/numbers#HashPower> .
chx:S_NetworkHashRate a doc:ConceptSection ; rdfs:label "Network hash rate"@en ; doc:sectionTitle "Network hash rate" ; doc:hierarchyLevel 3 ; doc:sectionOrder 16 ;
    doc:hasParentSection chx:S_HashPower ;
    skos:definition "The chart Network hash rate, EH/s plots the estimate in exahashes per second - a billion billion hashes each second - on a logarithmic scale (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#NetworkHashRate> .
chx:S_AnnualHashRate a doc:ConceptSection ; rdfs:label "Annual hash rate"@en ; doc:sectionTitle "Annual hash rate" ; doc:hierarchyLevel 3 ; doc:sectionOrder 17 ;
    doc:hasParentSection chx:S_HashPower ;
    skos:definition "Average hash rate by year shows it rising from about 4.358e-12 EH/s in 2009 to 952.8 EH/s in 2026, a factor of about 2.19e14 - the dashboard's 'about 200 trillion times' (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#AnnualHashRate> .
chx:S_Relationship a doc:TaxonomicSection ; rdfs:label "Relationship"@en ; doc:sectionTitle "Relationship" ; doc:hierarchyLevel 2 ; doc:sectionOrder 18 ;
    doc:hasParentSection chx:S_Mining ;
    skos:definition "Setting price against hash rate asks whether security followed value (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#Relationship> .
chx:S_PriceVsHashRate a doc:ConceptSection ; rdfs:label "Price vs hash rate"@en ; doc:sectionTitle "Price vs hash rate" ; doc:hierarchyLevel 3 ; doc:sectionOrder 19 ;
    doc:hasParentSection chx:S_Relationship ;
    skos:definition "The Price vs hash rate scatter puts price against hash rate on logarithmic scales, coloured from early to recent, so the joint rise of both shows as a path to the upper right (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#PriceVsHashRate> .
chx:S_Provenance a doc:TaxonomicSection ; rdfs:label "Provenance"@en ; doc:sectionTitle "Provenance" ; doc:hierarchyLevel 1 ; doc:sectionOrder 20 ;
    skos:definition "Every chart rests on one data source, and its limits belong on the page (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#Provenance> .
chx:S_DataSource a doc:TaxonomicSection ; rdfs:label "Data source"@en ; doc:sectionTitle "Data source" ; doc:hierarchyLevel 2 ; doc:sectionOrder 21 ;
    doc:hasParentSection chx:S_Provenance ;
    skos:definition "The dashboard states where its numbers come from and how current they are (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#DataSource> .
chx:S_BlockchainComSnapshot a doc:ConceptSection ; rdfs:label "Blockchain.com snapshot"@en ; doc:sectionTitle "Blockchain.com snapshot" ; doc:hierarchyLevel 3 ; doc:sectionOrder 22 ;
    doc:hasParentSection chx:S_DataSource ;
    skos:definition "The data are a snapshot of Blockchain.com's public charts, sampled about every four days and taken when the page was built - so the numbers change only when the page is rebuilt (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#BlockchainComSnapshot> .
chx:S_HashRateEstimate a doc:ConceptSection ; rdfs:label "Hash-rate estimate"@en ; doc:sectionTitle "Hash-rate estimate" ; doc:hierarchyLevel 3 ; doc:sectionOrder 23 ;
    doc:hasParentSection chx:S_DataSource ;
    skos:definition "Hash rate is an estimate derived from difficulty and block times, because no one can count every miner's hashes directly (Blockchain.com, 2026)." ; dcterms:source <http://example.org/sen0401/numbers#HashRateEstimate> .
