chx:X_MarketPrice a owl:NamedIndividual, chx:MarketPrice ; rdfs:label "the average USD price across exchanges"@en ; skos:definition "The average US-dollar price across major exchanges, sampled about every four days; halvings are marked on the chart."@en ; dcterms:source <http://example.org/sen0401/numbers/research> .
chx:X_MarketPrice sen0414:hasChartCanvas "cPrice" .
chx:X_YearlyTradingRange a owl:NamedIndividual, chx:YearlyTradingRange ; rdfs:label "each year's low, high and close"@en ; skos:definition "Floating bars from each year's lowest to highest price, with the closing price marked."@en ; dcterms:source <http://example.org/sen0401/numbers/research> .
chx:X_YearlyTradingRange sen0414:hasChartCanvas "cRange" .
chx:X_YearOnYearChange a owl:NamedIndividual, chx:YearOnYearChange ; rdfs:label "close against previous close"@en ; skos:definition "Each year's closing price compared with the previous year's close."@en ; dcterms:source <http://example.org/sen0401/numbers/research> .
chx:X_YearOnYearChange sen0414:hasChartCanvas "cYoy" .
chx:X_CirculatingSupply a owl:NamedIndividual, chx:CirculatingSupply ; rdfs:label "bitcoins in circulation"@en ; skos:definition "The number of bitcoins issued so far, growing in steps toward the 21 million cap."@en ; dcterms:source <http://example.org/sen0401/numbers/research> .
chx:X_CirculatingSupply sen0414:hasChartCanvas "cSupply" .
chx:X_MinedVsRemaining a owl:NamedIndividual, chx:MinedVsRemaining ; rdfs:label "share of the cap already issued"@en ; skos:definition "The issued share of the 21 million cap against what remains to be mined."@en ; dcterms:source <http://example.org/sen0401/numbers/research> .
chx:IO_MinedVsRemaining a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(20087925 / 21e6 * 100, 2) evaluates to 95.66"@en ; chx:input "round(20087925 / 21e6 * 100, 2)" ; chx:output "95.66" .
chx:X_MinedVsRemaining rd:hasIOExample chx:IO_MinedVsRemaining .
chx:X_MinedVsRemaining sen0414:hasChartCanvas "cDonut" .
chx:X_AnnualIssuance a owl:NamedIndividual, chx:AnnualIssuance ; rdfs:label "new coins minted per year"@en ; skos:definition "Bitcoins minted each year, dropping in steps at each halving."@en ; dcterms:source <http://example.org/sen0401/numbers/research> .
chx:X_AnnualIssuance sen0414:hasChartCanvas "cMint" .
chx:X_HalvingEra a owl:NamedIndividual, chx:HalvingEra ; rdfs:label "the fourth block-reward era"@en ; skos:definition "The subsidy halves every 210,000 blocks; the fourth halving, on 2024-04-20, set it at 3.125 bitcoin."@en ; dcterms:source <http://example.org/sen0401/numbers/research> .
chx:IO_HalvingEra a owl:NamedIndividual, rd:IOExample ; rdfs:label "(50 * 10**8 >> 4) / 10**8 evaluates to 3.125"@en ; chx:input "(50 * 10**8 >> 4) / 10**8" ; chx:output "3.125" .
chx:X_HalvingEra rd:hasIOExample chx:IO_HalvingEra .
chx:X_NetworkHashRate a owl:NamedIndividual, chx:NetworkHashRate ; rdfs:label "hashes per second securing the chain"@en ; skos:definition "The estimated number of hashes the whole network computes per second, in exahashes (10^18) per second."@en ; dcterms:source <http://example.org/sen0401/numbers/research> .
chx:X_NetworkHashRate sen0414:hasChartCanvas "cHash" .
chx:X_AnnualHashRate a owl:NamedIndividual, chx:AnnualHashRate ; rdfs:label "yearly average hash rate"@en ; skos:definition "The hash rate averaged over each year, on a logarithmic axis because it spans about fourteen orders of magnitude."@en ; dcterms:source <http://example.org/sen0401/numbers/research> .
chx:IO_AnnualHashRate a owl:NamedIndividual, rd:IOExample ; rdfs:label "f'{952.8 / 4.358e-12:.3g}' evaluates to '2.19e+14'"@en ; chx:input "f'{952.8 / 4.358e-12:.3g}'" ; chx:output "'2.19e+14'" .
chx:X_AnnualHashRate rd:hasIOExample chx:IO_AnnualHashRate .
chx:X_AnnualHashRate sen0414:hasChartCanvas "cHashYear" .
chx:X_PriceVsHashRate a owl:NamedIndividual, chx:PriceVsHashRate ; rdfs:label "price against hash rate over time"@en ; skos:definition "A scatter of price against hash rate, both on logarithmic scales, coloured from early to recent."@en ; dcterms:source <http://example.org/sen0401/numbers/research> .
chx:X_PriceVsHashRate sen0414:hasChartCanvas "cScatter" .
chx:X_BlockchainComSnapshot a owl:NamedIndividual, chx:BlockchainComSnapshot ; rdfs:label "the data behind every chart"@en ; skos:definition "A snapshot of Blockchain.com's public charts taken when the page was built - not a live feed."@en ; dcterms:source <http://example.org/sen0401/numbers/research> .
chx:X_HashRateEstimate a owl:NamedIndividual, chx:HashRateEstimate ; rdfs:label "hash rate inferred, not measured"@en ; skos:definition "The hash rate cannot be observed directly; it is estimated from mining difficulty and block times."@en ; dcterms:source <http://example.org/sen0401/numbers/research> .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 Bitcoin in numbers domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/numbers/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Bitcoin in numbers competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which claims of the chapter can be checked by computation, and what does the computation give?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which concepts reach beyond the book into the current state of Bitcoin and the course theme, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the Bitcoin in numbers research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the Bitcoin: price, supply and mining power dashboard (v1.1.0) and its Blockchain.com data through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0401/numbers/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-09-24."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_0_0.py" .

