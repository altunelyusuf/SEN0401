@prefix chx:     <http://example.org/sen0401/numbers#> .
@prefix res:     <http://example.org/rdodi/research-ontology#> .
@prefix rd:      <http://example.org/rdodi/domain-ontology#> .
@prefix doc:     <http://example.org/rdodi/document-ontology#> .
@prefix sen0414: <http://example.org/sen0401#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

<http://example.org/sen0401/numbers/tbox> a owl:Ontology ;
    rdfs:label "SEN0401 Bitcoin in numbers domain ontology - TBox"@en ; owl:versionInfo "1.1.0" ; owl:versionIRI <http://example.org/sen0401/numbers/tbox/1.1.0> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:created "2026-09-24"^^xsd:date ; dcterms:modified "2026-10-19"^^xsd:date ;
    dcterms:identifier "sen0401_numbers_tbox_v1_1_0" ;
    owl:priorVersion <http://example.org/sen0401/numbers/tbox/1.0.0> ; prov:wasRevisionOf <http://example.org/sen0401/numbers/tbox/1.0.0> ;
    skos:changeNote "Version 1.1.0 repairs connectedness (discipline version 2.18.0 BP-D56 and version 2.19.0 BP-D57): the subject branches of the chapter are now linked to one another by the relations the chapter's own definitions state, chx:hasOwner has the domain and range its use shows where the file declares it, and chx:input and chx:output are declared. No class was added, removed or renamed, so MINOR."@en ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/numbers-rdodi-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

chx:Price a owl:Class ; rdfs:label "Price"@en ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:PriceHistory a owl:Class ; rdfs:label "Price history"@en ; rdfs:subClassOf chx:Price ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:MarketPrice a owl:Class ; rdfs:label "Market price"@en ; rdfs:subClassOf chx:PriceHistory ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:YearlyTradingRange a owl:Class ; rdfs:label "Yearly trading range"@en ; rdfs:subClassOf chx:PriceHistory ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:PriceChange a owl:Class ; rdfs:label "Price change"@en ; rdfs:subClassOf chx:Price ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:YearOnYearChange a owl:Class ; rdfs:label "Year-on-year change"@en ; rdfs:subClassOf chx:PriceChange ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:Supply a owl:Class ; rdfs:label "Supply"@en ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:Circulation a owl:Class ; rdfs:label "Circulation"@en ; rdfs:subClassOf chx:Supply ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:CirculatingSupply a owl:Class ; rdfs:label "Circulating supply"@en ; rdfs:subClassOf chx:Circulation ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:MinedVsRemaining a owl:Class ; rdfs:label "Mined vs still to mine"@en ; rdfs:subClassOf chx:Circulation ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:Issuance a owl:Class ; rdfs:label "Issuance"@en ; rdfs:subClassOf chx:Supply ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:AnnualIssuance a owl:Class ; rdfs:label "Annual issuance"@en ; rdfs:subClassOf chx:Issuance ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:HalvingEra a owl:Class ; rdfs:label "Halving era"@en ; rdfs:subClassOf chx:Issuance ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:Mining a owl:Class ; rdfs:label "Mining"@en ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:HashPower a owl:Class ; rdfs:label "Hash power"@en ; rdfs:subClassOf chx:Mining ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:NetworkHashRate a owl:Class ; rdfs:label "Network hash rate"@en ; rdfs:subClassOf chx:HashPower ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:AnnualHashRate a owl:Class ; rdfs:label "Annual hash rate"@en ; rdfs:subClassOf chx:HashPower ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:Relationship a owl:Class ; rdfs:label "Relationship"@en ; rdfs:subClassOf chx:Mining ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:PriceVsHashRate a owl:Class ; rdfs:label "Price vs hash rate"@en ; rdfs:subClassOf chx:Relationship ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:Provenance a owl:Class ; rdfs:label "Provenance"@en ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:DataSource a owl:Class ; rdfs:label "Data source"@en ; rdfs:subClassOf chx:Provenance ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:BlockchainComSnapshot a owl:Class ; rdfs:label "Blockchain.com snapshot"@en ; rdfs:subClassOf chx:DataSource ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:HashRateEstimate a owl:Class ; rdfs:label "Hash-rate estimate"@en ; rdfs:subClassOf chx:DataSource ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:Price owl:disjointWith chx:Supply .
chx:Price owl:disjointWith chx:Mining .
chx:Price owl:disjointWith chx:Provenance .
chx:Supply owl:disjointWith chx:Mining .
chx:Supply owl:disjointWith chx:Provenance .
chx:Mining owl:disjointWith chx:Provenance .

#################################################################
# Connectedness repair (discipline v2.19.0, BP-D56 and BP-D57), 2026-10-19.
# The datatype properties the A-Box uses and nothing declared, then the relations
# between the chapter's subject branches that the chapter's own sources state.
#################################################################
chx:input a owl:DatatypeProperty ; rdfs:label "input expression"@en ; rdfs:comment "The expression an input/output example evaluates."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:output a owl:DatatypeProperty ; rdfs:label "output value"@en ; rdfs:comment "The value that evaluating the example expression gives."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:plotsPrice a owl:ObjectProperty ; rdfs:label "plots the price of"@en ;
    rdfs:comment "The scatter puts price against hash rate. Basis: the chapter says of Price vs hash rate: 'A scatter of price against hash rate'; the chapter says of Market price: 'The average US-dollar price across major exchanges'."@en ;
    rdfs:domain chx:PriceVsHashRate ; rdfs:range chx:MarketPrice ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:plotsHashRate a owl:ObjectProperty ; rdfs:label "plots the hash rate of"@en ;
    rdfs:comment "The scatter puts price against hash rate. Basis: the chapter says of Price vs hash rate: 'A scatter of price against hash rate'; the chapter says of Annual hash rate: 'The hash rate averaged over each year'."@en ;
    rdfs:domain chx:PriceVsHashRate ; rdfs:range chx:AnnualHashRate ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:marksHalvingOn a owl:ObjectProperty ; rdfs:label "marks the halving of"@en ;
    rdfs:comment "Halvings are marked on the price chart. Basis: the chapter says of Market price: 'halvings are marked on the chart'; the chapter says of Halving era: 'The subsidy halves every 210,000 blocks'."@en ;
    rdfs:domain chx:MarketPrice ; rdfs:range chx:HalvingEra ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:dropsAtHalving a owl:ObjectProperty ; rdfs:label "drops at each halving of"@en ;
    rdfs:comment "Annual issuance drops in steps at each halving. Basis: the chapter says of Annual issuance: 'dropping in steps at each halving'; the chapter says of Halving era: 'The subsidy halves every 210,000 blocks'."@en ;
    rdfs:domain chx:AnnualIssuance ; rdfs:range chx:HalvingEra ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:estimatesHashRate a owl:ObjectProperty ; rdfs:label "estimates"@en ;
    rdfs:comment "The hash rate is estimated from difficulty and block times. Basis: the chapter says of Hash-rate estimate: 'it is estimated from mining difficulty and block times'; the chapter says of Network hash rate: 'The estimated number of hashes the whole network computes per second'."@en ;
    rdfs:domain chx:HashRateEstimate ; rdfs:range chx:NetworkHashRate ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:snapshotsPrice a owl:ObjectProperty ; rdfs:label "snapshots the price of"@en ;
    rdfs:comment "The snapshot holds the Blockchain.com chart Market Price (USD). Basis: the chapter says of Blockchain.com snapshot: 'Blockchain.com charts API - Market Price (USD)'; the chapter says of Market price: 'The average US-dollar price across major exchanges'."@en ;
    rdfs:domain chx:BlockchainComSnapshot ; rdfs:range chx:MarketPrice ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:snapshotsHashRate a owl:ObjectProperty ; rdfs:label "snapshots the hash rate of"@en ;
    rdfs:comment "The snapshot holds the Blockchain.com chart Hash Rate. Basis: the chapter says of Blockchain.com snapshot: 'Blockchain.com charts API - Hash Rate'; the chapter says of Network hash rate: 'The estimated number of hashes the whole network computes per second'."@en ;
    rdfs:domain chx:BlockchainComSnapshot ; rdfs:range chx:NetworkHashRate ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:snapshotsCirculation a owl:ObjectProperty ; rdfs:label "snapshots the circulation of"@en ;
    rdfs:comment "The snapshot holds the Blockchain.com chart Bitcoins in circulation. Basis: the chapter says of Blockchain.com snapshot: 'Blockchain.com charts API - Bitcoins in circulation'; the chapter says of Circulating supply: 'The number of bitcoins issued so far'."@en ;
    rdfs:domain chx:BlockchainComSnapshot ; rdfs:range chx:CirculatingSupply ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
