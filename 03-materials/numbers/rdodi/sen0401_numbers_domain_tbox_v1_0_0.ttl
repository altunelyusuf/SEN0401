    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:created "2026-09-24"^^xsd:date ; dcterms:modified "2026-09-24"^^xsd:date ;
    dcterms:identifier "sen0401_numbers_tbox_v1_0_0" ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/numbers-rdodi-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

chx:Price a owl:Class ; rdfs:label "Price"@en ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:PriceHistory a owl:Class ; rdfs:label "Price history"@en ; rdfs:subClassOf chx:Price ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:MarketPrice a owl:Class ; rdfs:label "Market price"@en ; rdfs:subClassOf chx:PriceHistory ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:YearlyTradingRange a owl:Class ; rdfs:label "Yearly trading range"@en ; rdfs:subClassOf chx:PriceHistory ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:PriceChange a owl:Class ; rdfs:label "Price change"@en ; rdfs:subClassOf chx:Price ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:YearOnYearChange a owl:Class ; rdfs:label "Year-on-year change"@en ; rdfs:subClassOf chx:PriceChange ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:Supply a owl:Class ; rdfs:label "Supply"@en ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:Circulation a owl:Class ; rdfs:label "Circulation"@en ; rdfs:subClassOf chx:Supply ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:CirculatingSupply a owl:Class ; rdfs:label "Circulating supply"@en ; rdfs:subClassOf chx:Circulation ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:MinedVsRemaining a owl:Class ; rdfs:label "Mined vs still to mine"@en ; rdfs:subClassOf chx:Circulation ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:Issuance a owl:Class ; rdfs:label "Issuance"@en ; rdfs:subClassOf chx:Supply ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:AnnualIssuance a owl:Class ; rdfs:label "Annual issuance"@en ; rdfs:subClassOf chx:Issuance ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:HalvingEra a owl:Class ; rdfs:label "Halving era"@en ; rdfs:subClassOf chx:Issuance ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:Mining a owl:Class ; rdfs:label "Mining"@en ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:HashPower a owl:Class ; rdfs:label "Hash power"@en ; rdfs:subClassOf chx:Mining ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:NetworkHashRate a owl:Class ; rdfs:label "Network hash rate"@en ; rdfs:subClassOf chx:HashPower ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:AnnualHashRate a owl:Class ; rdfs:label "Annual hash rate"@en ; rdfs:subClassOf chx:HashPower ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:Relationship a owl:Class ; rdfs:label "Relationship"@en ; rdfs:subClassOf chx:Mining ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:PriceVsHashRate a owl:Class ; rdfs:label "Price vs hash rate"@en ; rdfs:subClassOf chx:Relationship ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:Provenance a owl:Class ; rdfs:label "Provenance"@en ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:DataSource a owl:Class ; rdfs:label "Data source"@en ; rdfs:subClassOf chx:Provenance ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:BlockchainComSnapshot a owl:Class ; rdfs:label "Blockchain.com snapshot"@en ; rdfs:subClassOf chx:DataSource ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:HashRateEstimate a owl:Class ; rdfs:label "Hash-rate estimate"@en ; rdfs:subClassOf chx:DataSource ; rdfs:isDefinedBy <http://example.org/sen0401/numbers/tbox> .
chx:Price owl:disjointWith chx:Supply .
chx:Price owl:disjointWith chx:Mining .
chx:Price owl:disjointWith chx:Provenance .
chx:Supply owl:disjointWith chx:Mining .
chx:Supply owl:disjointWith chx:Provenance .
chx:Mining owl:disjointWith chx:Provenance .
