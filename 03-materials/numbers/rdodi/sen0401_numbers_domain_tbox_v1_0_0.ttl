@prefix sh:      <http://www.w3.org/ns/shacl#> .

<http://example.org/sen0401/numbers/tbox> a owl:Ontology ;
    rdfs:label "SEN0401 Bitcoin in numbers domain ontology - TBox"@en ; owl:versionInfo "1.0.0" ; owl:versionIRI <http://example.org/sen0401/numbers/tbox/1.0.0> ;
