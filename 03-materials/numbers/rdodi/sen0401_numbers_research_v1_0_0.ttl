chx:Research a res:ResearchProject ; rdfs:label "Bitcoin in numbers: price, supply and mining power since 2009"@en ;
    sen0414:methodology "Primary source first: the chapter's named concepts from the book's own source at tag third_edition_print1. Then the official documentation for the current release and the PEPs the chapter's topics touch. Every source opened and read on 2026-09-25T08:59:33; every claim taken from text actually read; every behaviour executed under Python 3.14.4." ;
    res:hasResearchScope chx:Scope ; rdfs:member chx:P01, chx:P02, chx:P03, chx:P04, chx:P05, chx:P06 .
chx:Scope a res:ResearchScope ; res:hasResearchQuestion "What do Bitcoin's price, supply and mining-power histories show, which of the dashboard's statements can be recomputed from its own data, and how do they connect to chapters 1 and 2?" ; res:hasTimeWindow "Current as of 2026-09-24." .
chx:P01 a res:Publication ; rdfs:label "Bitcoin: price, supply and mining power v1.1.0 - interactive dashboard, claude.ai artifact built 25 September 2026 (owner's)"@en ; dcterms:source "https://claude.ai/artifact/YW85r4NW1APUyQGMw8CtL2"^^xsd:anyURI ; res:hasVerificationStatus res:Status_Verified ; sen0414:verifiedAt "2026-09-25T08:59:33"^^xsd:dateTime ; sen0414:sourceRole "primary" .
chx:P02 a res:Publication ; rdfs:label "Blockchain.com charts API - Market Price (USD)"@en ; dcterms:source "https://api.blockchain.info/charts/market-price"^^xsd:anyURI ; res:hasVerificationStatus res:Status_Verified ; sen0414:verifiedAt "2026-09-25T08:59:33"^^xsd:dateTime ; sen0414:sourceRole "secondary" .
chx:P03 a res:Publication ; rdfs:label "Blockchain.com charts API - Bitcoins in circulation"@en ; dcterms:source "https://api.blockchain.info/charts/total-bitcoins"^^xsd:anyURI ; res:hasVerificationStatus res:Status_Verified ; sen0414:verifiedAt "2026-09-25T08:59:33"^^xsd:dateTime ; sen0414:sourceRole "secondary" .
chx:P04 a res:Publication ; rdfs:label "Blockchain.com charts API - Hash Rate"@en ; dcterms:source "https://api.blockchain.info/charts/hash-rate"^^xsd:anyURI ; res:hasVerificationStatus res:Status_Verified ; sen0414:verifiedAt "2026-09-25T08:59:33"^^xsd:dateTime ; sen0414:sourceRole "secondary" .
chx:P05 a res:Publication ; rdfs:label "Controlled supply - Bitcoin Wiki"@en ; dcterms:source "https://en.bitcoin.it/wiki/Controlled_supply"^^xsd:anyURI ; res:hasVerificationStatus res:Status_Verified ; sen0414:verifiedAt "2026-09-25T08:59:33"^^xsd:dateTime ; sen0414:sourceRole "secondary" .
