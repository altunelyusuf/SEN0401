pg:Page a ipo:Page, ipo:InteractiveLearningSurface ; rdfs:label "Bitcoin in numbers interactive page"@en ;
    dcterms:source <http://example.org/sen0401/numbers/document> ; ipo:hasSourceDocument pg:SourceDocument ;
    ipo:satisfiesHeuristic ipo:RecognitionRatherThanRecall, ipo:ConsistencyAndStandards, ipo:AestheticAndMinimalistDesign,
        ipo:ShneidermanRule_OfferInformativeFeedback, ipo:ShneidermanRule_PermitEasyReversalOfActions, ipo:HelpAndDocumentation ;
    ipo:hasLayoutPattern pg:Layout ; ipo:hasSemanticRegion pg:Header, pg:Sidebar, pg:Main ;
    ipo:includesNavigationPattern pg:GroupedTopBar, pg:SectionTree ;
    ipo:coversLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 ;
    sen0401:navigationRule "BP-D34: 23 sections falls in 26-50, so a grouped permanent top bar with a sub-section sidebar; the named single flowing anchor-page variation of procedure v1.6.0 section 5.3." ;
    sen0401:pythonUsed "Python 3.14.4" .
pg:Layout a ipo:SplitLayout ; rdfs:label "Sidebar and main content"@en .
pg:Header a ipo:Header ; rdfs:label "Sticky header with grouped section bar"@en .
pg:Sidebar a ipo:Sidebar ; rdfs:label "Section tree"@en .
pg:Main a ipo:MainContent ; rdfs:label "Chapter content with inline widgets"@en .
pg:GroupedTopBar a ipo:PrimaryNavigation ; rdfs:label "Grouped permanent top bar"@en .
pg:SectionTree a ipo:TreeNavigation ; rdfs:label "Sub-section sidebar tree"@en .
pg:SourceDocument a ipo:SourceDocument ; rdfs:label "Bitcoin in numbers Stage 3 document"@en ; dcterms:source <http://example.org/sen0401/numbers/document> ;
    ipo:hasLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 .

pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Read a logarithmic chart and explain why the price and hash-rate histories need one"@en ; ld:bloomLevel ld:Understand  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Compute the issued share of the 21 million cap from circulating supply"@en ; ld:bloomLevel ld:Apply  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Relate the steps in yearly issuance to the halving schedule"@en ; ld:bloomLevel ld:Analyze  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "State what the data can and cannot show, including that hash rate is an estimate"@en ; ld:bloomLevel ld:Understand  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Why are the price and hash-rate charts drawn on a logarithmic scale?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "A log axis changes spacing, not values; it hides nothing and exaggerates nothing." ; ld:distractorRationale "The API returns plain values; the scale is a drawing choice." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "Their values span many orders of magnitude, so a linear axis would hide the early years" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "Logarithmic scales make prices look higher" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "Blockchain.com only publishes logarithms" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "20,087,925 bitcoins are in circulation. About what share of the 21 million cap is that?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "Half the cap was issued back in 2012; far more has been issued since." ; ld:distractorRationale "About 912,000 bitcoins remain, over four per cent of the cap." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "95.66 per cent" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "50 per cent" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "99.9 per cent" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Why does yearly issuance drop in steps rather than smoothly?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O0 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "No vote exists; the schedule is fixed by the protocol." ; ld:distractorRationale "Issuance follows the schedule regardless of demand." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "The block subsidy halves every 210,000 blocks" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "Miners vote to issue less" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "Demand for bitcoin falls" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "How is the network hash rate obtained?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "No node can see other miners' hashes; only found blocks are visible." ; ld:distractorRationale "Miners do not report their hashing; it would be unverifiable anyway." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "Estimated from mining difficulty and block times" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "Counted exactly by each node" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "Reported by every miner" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Is the dashboard's data live?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "A page like this cannot call external services when viewed; numbers change only when it is rebuilt." ; ld:distractorRationale "Nothing on the page fetches new data." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "No - it is a snapshot taken when the page was built" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "Yes - it refreshes every block" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "Yes - it updates daily" .
