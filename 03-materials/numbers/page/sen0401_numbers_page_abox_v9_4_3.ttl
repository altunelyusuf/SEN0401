pg:Layout a ipo:LayoutPattern,
        owl:NamedIndividual ;
    rdfs:label "Explorer, main area and detail card"@en ;
    dcterms:source <http://example.org/sen0401/numbers/document> ;
    skos:definition "The page puts the page explorer at the left, the main area in the centre and a detail card at the right that stays closed until the reader asks for a detail."@en .

pg:Main a ipo:MainContent,
        owl:NamedIndividual ;
    rdfs:label "Main area"@en ;
    dcterms:source <http://example.org/sen0401/numbers/document> ;
    skos:definition "The main area shows the page content of the selected menu item, with the widgets of its sections inline."@en .

pg:Q1_O1 a ld:AnswerOption ;
    rdfs:label "Logarithmic scales make prices look higher"@en .

pg:Q1_O2 a ld:AnswerOption ;
    rdfs:label "Blockchain.com only publishes logarithms"@en .

pg:Q2_O1 a ld:AnswerOption ;
    rdfs:label "50 per cent"@en .

pg:Q2_O2 a ld:AnswerOption ;
    rdfs:label "99.9 per cent"@en .

pg:Q3_O1 a ld:AnswerOption ;
    rdfs:label "Miners vote to issue less"@en .

pg:Q3_O2 a ld:AnswerOption ;
    rdfs:label "Demand for bitcoin falls"@en .

pg:Q4_O1 a ld:AnswerOption ;
    rdfs:label "Counted exactly by each node"@en .

pg:Q4_O2 a ld:AnswerOption ;
    rdfs:label "Reported by every miner"@en .

pg:Q5_O1 a ld:AnswerOption ;
    rdfs:label "Yes - it refreshes every block"@en .

pg:Q5_O2 a ld:AnswerOption ;
    rdfs:label "Yes - it updates daily"@en .

pg:SectionTree a ipo:TreeNavigation,
        owl:NamedIndividual ;
    rdfs:label "Section tree"@en ;
    dcterms:source <http://example.org/sen0401/numbers/document> ;
    skos:definition "The section tree lists the sections of the page by their three levels, and choosing one opens that single section."@en .

pg:Sidebar a ipo:Sidebar,
        owl:NamedIndividual ;
    rdfs:label "Page explorer"@en ;
    dcterms:source <http://example.org/sen0401/numbers/document> ;
    skos:definition "The explorer at the left shows the page's sections as a tree and keeps pace with the tabs of the main area."@en .

pg:SourceDocument a ipo:SourceDocument,
        owl:NamedIndividual ;
    rdfs:label "Bitcoin in numbers Stage 3 document"@en ;
    ipo:hasLearningObjective pg:CO1,
        pg:CO2,
        pg:CO3,
        pg:CO4 ;
    dcterms:source <http://example.org/sen0401/numbers/document> ;
    skos:definition "The Stage 3 document of the supplement Bitcoin in numbers is the text this page renders, section for section."@en .

pg:TopMenu a ipo:PrimaryNavigation,
        owl:NamedIndividual ;
    rdfs:label "Main menu"@en ;
    dcterms:source <http://example.org/sen0401/numbers/document> ;
    skos:definition "The main menu is permanently visible at the top and lets the reader reach every top-level area without scrolling or opening anything first."@en .

pg:Q1_O0 a ld:AnswerOption ;
    rdfs:label "Their values span many orders of magnitude, so a linear axis would hide the early years"@en .

pg:Q2_O0 a ld:AnswerOption ;
    rdfs:label "95.66 per cent"@en .

pg:Q3_O0 a ld:AnswerOption ;
    rdfs:label "The block subsidy halves every 210,000 blocks"@en .

pg:Q4_O0 a ld:AnswerOption ;
    rdfs:label "Estimated from mining difficulty and block times"@en .

pg:Q5_O0 a ld:AnswerOption ;
    rdfs:label "No - it is a snapshot taken when the page was built"@en .

pg:S_AnnualHashRate a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Annual hash rate"@en ;
    sen0401:anchor "#AnnualHashRate" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/numbers#S_AnnualHashRate> ;
    skos:definition "The hash rate averaged over each year, on a logarithmic axis because it spans about fourteen orders of magnitude."@en .

pg:S_AnnualIssuance a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Annual issuance"@en ;
    sen0401:anchor "#AnnualIssuance" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/numbers#S_AnnualIssuance> ;
    skos:definition "Bitcoins minted each year, dropping in steps at each halving."@en .

pg:S_BlockchainComSnapshot a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Blockchain.com snapshot"@en ;
    sen0401:anchor "#BlockchainComSnapshot" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/numbers#S_BlockchainComSnapshot> ;
    skos:definition "A snapshot of Blockchain.com's public charts taken when the page was built - not a live feed."@en .

pg:S_CirculatingSupply a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Circulating supply"@en ;
    sen0401:anchor "#CirculatingSupply" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/numbers#S_CirculatingSupply> ;
    skos:definition "The number of bitcoins issued so far, growing in steps toward the 21 million cap."@en .

pg:S_Circulation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Circulation"@en ;
    sen0401:anchor "#Circulation" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/numbers#S_Circulation> ;
    skos:definition "Circulation is the running total of every block subsidy paid so far (Blockchain.com, 2026)."@en .

pg:S_DataSource a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Data source"@en ;
    sen0401:anchor "#DataSource" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/numbers#S_DataSource> ;
    skos:definition "The dashboard states where its numbers come from and how current they are (Blockchain.com, 2026)."@en .

pg:S_HalvingEra a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Halving era"@en ;
    sen0401:anchor "#HalvingEra" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/numbers#S_HalvingEra> ;
    skos:definition "The subsidy halves every 210,000 blocks; the fourth halving, on 2024-04-20, set it at 3.125 bitcoin."@en .

pg:S_HashPower a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hash power"@en ;
    sen0401:anchor "#HashPower" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/numbers#S_HashPower> ;
    skos:definition "Hash power is the total rate of guesses miners make in the proof-of-work search (Antonopoulos and Harding, 2023)."@en .

pg:S_HashRateEstimate a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hash-rate estimate"@en ;
    sen0401:anchor "#HashRateEstimate" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/numbers#S_HashRateEstimate> ;
    skos:definition "The hash rate cannot be observed directly; it is estimated from mining difficulty and block times."@en .

pg:S_Issuance a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Issuance"@en ;
    sen0401:anchor "#Issuance" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/numbers#S_Issuance> ;
    skos:definition "Yearly issuance falls in steps because the block subsidy halves every 210,000 blocks (Bitcoin Wiki, 2026)."@en .

pg:S_MarketPrice a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Market price"@en ;
    sen0401:anchor "#MarketPrice" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/numbers#S_MarketPrice> ;
    skos:definition "The average US-dollar price across major exchanges, sampled about every four days; halvings are marked on the chart."@en .

pg:S_MinedVsRemaining a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Mined vs still to mine"@en ;
    sen0401:anchor "#MinedVsRemaining" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/numbers#S_MinedVsRemaining> ;
    skos:definition "The issued share of the 21 million cap against what remains to be mined."@en .

pg:S_Mining a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Mining"@en ;
    sen0401:anchor "#Mining" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/numbers#S_Mining> ;
    skos:definition "The third part, Mining capacity, shows the computing power securing the chain, which is chapter 2's security by computation made visible (Antonopoulos and Harding, 2023)."@en .

pg:S_NetworkHashRate a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Network hash rate"@en ;
    sen0401:anchor "#NetworkHashRate" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/numbers#S_NetworkHashRate> ;
    skos:definition "The estimated number of hashes the whole network computes per second, in exahashes (10^18) per second."@en .

pg:S_Price a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Price"@en ;
    sen0401:anchor "#Price" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/numbers#S_Price> ;
    skos:definition "The first part of the dashboard follows the market price, where boom-and-bust cycles dominate the history (Blockchain.com, 2026)."@en .

pg:S_PriceChange a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Price change"@en ;
    sen0401:anchor "#PriceChange" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/numbers#S_PriceChange> ;
    skos:definition "Change is easier to compare than level when prices span six orders of magnitude (Blockchain.com, 2026)."@en .

pg:S_PriceHistory a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Price history"@en ;
    sen0401:anchor "#PriceHistory" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/numbers#S_PriceHistory> ;
    skos:definition "The price history is shown two ways: the full series, and each year's range (Blockchain.com, 2026)."@en .

pg:S_PriceVsHashRate a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Price vs hash rate"@en ;
    sen0401:anchor "#PriceVsHashRate" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/numbers#S_PriceVsHashRate> ;
    skos:definition "A scatter of price against hash rate, both on logarithmic scales, coloured from early to recent."@en .

pg:S_Provenance a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Provenance"@en ;
    sen0401:anchor "#Provenance" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/numbers#S_Provenance> ;
    skos:definition "Every chart rests on one data source, and its limits belong on the page (Blockchain.com, 2026)."@en .

pg:S_Relationship a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Relationship"@en ;
    sen0401:anchor "#Relationship" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/numbers#S_Relationship> ;
    skos:definition "Setting price against hash rate asks whether security followed value (Blockchain.com, 2026)."@en .

pg:S_Supply a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Supply"@en ;
    sen0401:anchor "#Supply" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/numbers#S_Supply> ;
    skos:definition "The second part, Minted coins, shows the coins issued against the 21 million cap that chapter 1 describes (Antonopoulos and Harding, 2023)."@en .

pg:S_YearOnYearChange a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Year-on-year change"@en ;
    sen0401:anchor "#YearOnYearChange" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/numbers#S_YearOnYearChange> ;
    skos:definition "Each year's closing price compared with the previous year's close."@en .

pg:S_YearlyTradingRange a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Yearly trading range"@en ;
    sen0401:anchor "#YearlyTradingRange" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/numbers#S_YearlyTradingRange> ;
    skos:definition "Floating bars from each year's lowest to highest price, with the closing price marked."@en .

pg:CO1 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Read a logarithmic chart and explain why the price and hash-rate histories need one"@en ;
    ld:bloomLevel ld:Understand ;
    dcterms:source <http://example.org/sen0401/numbers/document> ;
    skos:definition "After this page the learner can read a logarithmic chart and explain why the price and hash-rate histories need one."@en .

pg:CO2 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Compute the issued share of the 21 million cap from circulating supply"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/numbers/document> ;
    skos:definition "After this page the learner can compute the issued share of the 21 million cap from circulating supply."@en .

pg:CO3 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Relate the steps in yearly issuance to the halving schedule"@en ;
    ld:bloomLevel ld:Analyze ;
    dcterms:source <http://example.org/sen0401/numbers/document> ;
    skos:definition "After this page the learner can relate the steps in yearly issuance to the halving schedule."@en .

pg:CO4 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "State what the data can and cannot show, including that hash rate is an estimate"@en ;
    ld:bloomLevel ld:Understand ;
    dcterms:source <http://example.org/sen0401/numbers/document> ;
    skos:definition "After this page the learner can state what the data can and cannot show, including that hash rate is an estimate."@en .

