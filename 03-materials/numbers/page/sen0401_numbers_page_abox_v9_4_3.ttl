pg:Page a ipo:InteractiveLearningSurface,
        ipo:Page,
        owl:NamedIndividual ;
    rdfs:label "Bitcoin in numbers interactive page"@en ;
    ipo:coversChapterSection pg:S_AnnualHashRate,
        pg:S_AnnualIssuance,
        pg:S_BlockchainComSnapshot,
        pg:S_CirculatingSupply,
        pg:S_Circulation,
        pg:S_DataSource,
        pg:S_HalvingEra,
        pg:S_HashPower,
        pg:S_HashRateEstimate,
        pg:S_Issuance,
        pg:S_MarketPrice,
        pg:S_MinedVsRemaining,
        pg:S_Mining,
        pg:S_NetworkHashRate,
        pg:S_Price,
        pg:S_PriceChange,
        pg:S_PriceHistory,
        pg:S_PriceVsHashRate,
        pg:S_Provenance,
        pg:S_Relationship,
        pg:S_Supply,
        pg:S_YearOnYearChange,
        pg:S_YearlyTradingRange ;
    ipo:coversLearningObjective pg:CO1,
        pg:CO2,
        pg:CO3,
        pg:CO4 ;
    ipo:hasLayoutPattern pg:Layout ;
    ipo:hasSemanticRegion pg:Card,
        pg:Header,
        pg:Main,
        pg:Sidebar ;
    ipo:hasSourceDocument pg:SourceDocument ;
    ipo:includesNavigationPattern pg:SectionTree,
        pg:TopMenu ;
    sen0401:pageFileSha256 "18509b7ee876bde19a41de585d3205e5def907b2bc3bd4d88dd45498f8621f96" ;
    sen0401:pythonUsed "Python 3.14.4" ;
    sen0401:testNote "The browser test ran on a copy of the page in which the instructor's release key is replaced by a test key; the result proves the page's logic and not the release step."@en ;
    dcterms:source <http://example.org/sen0401/numbers/document> ;
    skos:definition "This page teaches the supplement Bitcoin in numbers of the course page as an interactive surface with 23 sections in a three-level outline, 23 widgets that the browser test exercised, and a quiz of 5 questions."@en .

pg:Q1 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Why are the price and hash-rate charts drawn on a logarithmic scale?"@en ;
    ld:assessesObjective pg:CO1 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "A log axis changes spacing, not values; it hides nothing and exaggerates nothing.",
        "The API returns plain values; the scale is a drawing choice." ;
    ld:hasCorrectOption pg:Q1_O0 ;
    ld:hasOption pg:Q1_O0,
        pg:Q1_O1,
        pg:Q1_O2 .

pg:Q2 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "20,087,925 bitcoins are in circulation. About what share of the 21 million cap is that?"@en ;
    ld:assessesObjective pg:CO2 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "About 912,000 bitcoins remain, over four per cent of the cap.",
        "Half the cap was issued back in 2012; far more has been issued since." ;
    ld:hasCorrectOption pg:Q2_O0 ;
    ld:hasOption pg:Q2_O0,
        pg:Q2_O1,
        pg:Q2_O2 .

pg:Q3 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Why does yearly issuance drop in steps rather than smoothly?"@en ;
    ld:assessesObjective pg:CO3 ;
    ld:cognitiveLevel ld:Analyze ;
    ld:distractorRationale "Issuance follows the schedule regardless of demand.",
        "No vote exists; the schedule is fixed by the protocol." ;
    ld:hasCorrectOption pg:Q3_O0 ;
    ld:hasOption pg:Q3_O0,
        pg:Q3_O1,
        pg:Q3_O2 .

pg:Q4 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "How is the network hash rate obtained?"@en ;
    ld:assessesObjective pg:CO4 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "Miners do not report their hashing; it would be unverifiable anyway.",
        "No node can see other miners' hashes; only found blocks are visible." ;
    ld:hasCorrectOption pg:Q4_O0 ;
    ld:hasOption pg:Q4_O0,
        pg:Q4_O1,
        pg:Q4_O2 .

pg:Q5 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Is the dashboard's data live?"@en ;
    ld:assessesObjective pg:CO4 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "A page like this cannot call external services when viewed; numbers change only when it is rebuilt.",
        "Nothing on the page fetches new data." ;
    ld:hasCorrectOption pg:Q5_O0 ;
    ld:hasOption pg:Q5_O0,
        pg:Q5_O1,
        pg:Q5_O2 .

pg:W_AnnualHashRate a ipo:InstructionalWidget,
        owl:NamedIndividual ;
    rdfs:label "Widget of Annual hash rate"@en ;
    ipo:demonstratesSubject <http://example.org/sen0401/numbers#AnnualHashRate> ;
    sen0401:placedInSection pg:S_AnnualHashRate ;
    sen0401:runsInBrowser true ;
    wp:demonstratesConcept <http://example.org/sen0401/numbers#AnnualHashRate> ;
    wp:designTestPassed true ;
    wp:hasDesignTest "Exercised in headless Chromium by 08-tooling/sen0401_page_test_v9.35.0.py on page 9.4.2: printed \"'2.19e+14'\"; edited to 2 + 2 printed '4'; card shows \"'2.19e+14'\"" ;
    dcterms:source <http://example.org/sen0401/numbers#S_AnnualHashRate> ;
    skos:definition "This widget runs the worked example of the concept Annual hash rate in the reader's browser on the page's own library, shows what it printed, and lets the reader edit the code so that the printed result changes."@en .

