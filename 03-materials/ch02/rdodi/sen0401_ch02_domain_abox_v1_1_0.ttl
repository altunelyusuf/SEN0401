chx:X_Input a owl:NamedIndividual, chx:Input ; rdfs:label "an earlier output being spent"@en ; skos:definition "An input spends funds by referring to an earlier transaction's output and proving ownership with a digital signature."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_Output a owl:NamedIndividual, chx:Output ; rdfs:label "an amount locked to an address"@en ; skos:definition "An output receives funds; the outputs add up to slightly less than the inputs."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_TransactionFee a owl:NamedIndividual, chx:TransactionFee ; rdfs:label "inputs minus outputs"@en ; skos:definition "The fee is implied: the difference between the inputs and the outputs, collected by the miner."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_TransactionFee a owl:NamedIndividual, rd:IOExample ; rdfs:label "sum([15_000_000]) - sum([10_000_000, 4_990_000]) evaluates to 10000"@en ; chx:input "sum([15_000_000]) - sum([10_000_000, 4_990_000])" ; chx:output "10000" .
chx:X_TransactionFee rd:hasIOExample chx:IO_TransactionFee .
chx:X_TransactionChain a owl:NamedIndividual, chx:TransactionChain ; rdfs:label "Alice's payment spending Joe's output"@en ; skos:definition "Each transaction's inputs spend earlier outputs, so transactions form chains back through history."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_MakingChange a owl:NamedIndividual, chx:MakingChange ; rdfs:label "paying 5 from a 20 input"@en ; skos:definition "An output larger than the payment returns the rest as change to a new address of the payer."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_MakingChange a owl:NamedIndividual, rd:IOExample ; rdfs:label "20 - 5 evaluates to 15"@en ; chx:input "20 - 5" ; chx:output "15" .
chx:X_MakingChange rd:hasIOExample chx:IO_MakingChange .
chx:X_CoinSelection a owl:NamedIndividual, chx:CoinSelection ; rdfs:label "choosing which inputs to spend"@en ; skos:definition "Wallets choose which inputs to spend, balancing many small inputs against few large ones, much as people handle cash."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_SimplePayment a owl:NamedIndividual, chx:SimplePayment ; rdfs:label "one input, two outputs"@en ; skos:definition "The most common form: one input, and two outputs - the payment and the change."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_Consolidation a owl:NamedIndividual, chx:Consolidation ; rdfs:label "many inputs, one output"@en ; skos:definition "Many inputs spent into a single output, like exchanging a pile of coins for one note."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_Satoshi a owl:NamedIndividual, chx:Satoshi ; rdfs:label "one hundred-millionth of a bitcoin"@en ; skos:definition "The smallest unit: a bitcoin divides into 100,000,000 satoshis."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Satoshi a owl:NamedIndividual, rd:IOExample ; rdfs:label "10**8 // 1000 evaluates to 100000"@en ; chx:input "10**8 // 1000" ; chx:output "100000" .
chx:X_Satoshi rd:hasIOExample chx:IO_Satoshi .
chx:X_TransactionPropagation a owl:NamedIndividual, chx:TransactionPropagation ; rdfs:label "a transaction relayed across nodes"@en ; skos:definition "A signed transaction is transmitted to the network and relayed by nodes until it reaches miners."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_BlockExplorer a owl:NamedIndividual, chx:BlockExplorer ; rdfs:label "a site that shows a transaction or block"@en ; skos:definition "A block explorer looks up addresses, transactions and blocks - and may learn what you look up."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_Block a owl:NamedIndividual, chx:Block ; rdfs:label "a bundle of transactions with a small header"@en ; skos:definition "Transactions are bundled into blocks whose header is hard to form correctly and easy to verify."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_ConsensusRules a owl:NamedIndividual, chx:ConsensusRules ; rdfs:label "the rules every block must follow"@en ; skos:definition "Miners earn honest income only from blocks that follow all consensus rules, which keeps blocks valid."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_Confirmation a owl:NamedIndividual, chx:Confirmation ; rdfs:label "each block built on top"@en ; skos:definition "Each block mined on top of the one containing a transaction is one more confirmation; more confirmations make reversal harder."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Confirmation a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(1 - sum(__import__('math').exp(-6*0.1/0.9) * (6*0.1/0.9)**k / __import__('math').factorial(k) * (1 - (0.1/0.9)**(6-k)) for k in range(7)), 7) evaluates to 0.0002428"@en ; chx:input "round(1 - sum(__import__('math').exp(-6*0.1/0.9) * (6*0.1/0.9)**k / __import__('math').factorial(k) * (1 - (0.1/0.9)**(6-k)) for k in range(7)), 7)" ; chx:output "0.0002428" .
chx:X_Confirmation rd:hasIOExample chx:IO_Confirmation .
chx:X_GenesisBlock a owl:NamedIndividual, chx:GenesisBlock ; rdfs:label "block number 0"@en ; skos:definition "The first block of the chain, to which every block links back."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_ProvenanceGraph a owl:NamedIndividual, chx:ProvenanceGraph ; rdfs:label "a transaction chain described in PROV-O"@en ; skos:definition "A transaction chain is a provenance graph: outputs derived from outputs by transactions, attributed to key holders - expressible in W3C PROV-O."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_Bip21Uri a owl:NamedIndividual, chx:Bip21Uri ; rdfs:label "the invoice encoded in the store's QR code"@en ; skos:definition "A BIP21 URI carrying the address, amount, label and message, which the wallet reads so the payer never types an address."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Bip21Uri a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('urllib.parse').parse.parse_qs(__import__('urllib.parse').parse.urlsplit('bitcoin:bc1qk2g6u8p4qm2s2lh3gts5cpt2mrv5skcuu7u3e4?amount=0.01577764&label=Bob%27s%20Store').query)['label'][0] evaluates to 'Bob's Store'"@en ; chx:input "__import__('urllib.parse').parse.parse_qs(__import__('urllib.parse').parse.urlsplit('bitcoin:bc1qk2g6u8p4qm2s2lh3gts5cpt2mrv5skcuu7u3e4?amount=0.01577764&label=Bob%27s%20Store').query)['label'][0]" ; chx:output "'Bob's Store'" .
chx:X_Bip21Uri rd:hasIOExample chx:IO_Bip21Uri .
chx:X_UnconfirmedTransaction a owl:NamedIndividual, chx:UnconfirmedTransaction ; rdfs:label "a payment propagated but not yet in a block"@en ; skos:definition "Propagated to the network but not yet recorded in a block; blocks arrive every 10 minutes on average, not on a timetable."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_SmallPaymentAcceptance a owl:NamedIndividual, chx:SmallPaymentAcceptance ; rdfs:label "a cheap item sold without waiting"@en ; skos:definition "A merchant may accept a small payment unconfirmed because the double-spend risk is low, as coffee shops accept small card payments without a signature."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_SudokuAnalogy a owl:NamedIndividual, chx:SudokuAnalogy ; rdfs:label "mining pictured as a giant sudoku"@en ; skos:definition "An analogy from the course notes: hard to solve, easy to check, adjustable in size, restarted after every solution."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:X_BlockchainDemo a owl:NamedIndividual, chx:BlockchainDemo ; rdfs:label "Anders Brownworth's blockchain demo"@en ; skos:definition "An interactive page where changing one earlier block invalidates every later block's hash."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 2 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch02/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 2 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which claims of the chapter can be checked by computation, and what does the computation give?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which concepts reach beyond the book into the current state of Bitcoin and the course theme, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 2 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from Mastering Bitcoin 3rd edition's chapter 2 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0401/ch02/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-09-24."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_0_0.py" .

