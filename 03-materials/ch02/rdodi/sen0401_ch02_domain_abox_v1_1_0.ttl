@prefix sh:      <http://www.w3.org/ns/shacl#> .

<http://example.org/sen0401/ch02/abox> a owl:Ontology ;
    rdfs:label "SEN0401 chapter 2 domain ontology - ABox"@en ; owl:versionInfo "1.1.0" ; owl:versionIRI <http://example.org/sen0401/ch02/abox/1.1.0> ;
