chx:Document a doc:ReportSection ; rdfs:label "How Bitcoin works: one transaction from wallet to blockchain, checked against the whitepaper"@en ; skos:definition "This document renews chapter 2 of the 3rd edition of Mastering Bitcoin for SEN0401 (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02/research> ;
    doc:hasSection chx:S_Transaction, chx:S_Network, chx:S_Blockchain, chx:S_Semantics, chx:S_Practice .
chx:S_Transaction a doc:TaxonomicSection ; rdfs:label "Transaction"@en ; doc:sectionTitle "Transaction" ; doc:hierarchyLevel 1 ; doc:sectionOrder 1 ;
    skos:definition "How Bitcoin Works follows one payment, Buying from an Online Store, and its Bitcoin Transactions section treats a transaction like a line in a double-entry ledger whose difference is the transaction fee (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Transaction> .
chx:S_TransactionPart a doc:TaxonomicSection ; rdfs:label "Transaction part"@en ; doc:sectionTitle "Transaction part" ; doc:hierarchyLevel 2 ; doc:sectionOrder 2 ;
    doc:hasParentSection chx:S_Transaction ;
    skos:definition "Transaction Inputs and Outputs names the two sides of every transaction and what lies between them (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#TransactionPart> .
chx:S_Input a doc:ConceptSection ; rdfs:label "Input"@en ; doc:sectionTitle "Input" ; doc:hierarchyLevel 3 ; doc:sectionOrder 3 ;
    doc:hasParentSection chx:S_TransactionPart ;
    skos:definition "An input spends funds by pointing at an earlier output and carrying a digital signature from its owner that anyone can check (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Input> .
chx:S_Output a doc:ConceptSection ; rdfs:label "Output"@en ; doc:sectionTitle "Output" ; doc:hierarchyLevel 3 ; doc:sectionOrder 4 ;
    doc:hasParentSection chx:S_TransactionPart ;
    skos:definition "An output receives funds, and the outputs add up to slightly less than the inputs (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Output> .
chx:S_TransactionFee a doc:ConceptSection ; rdfs:label "Transaction fee"@en ; doc:sectionTitle "Transaction fee" ; doc:hierarchyLevel 3 ; doc:sectionOrder 5 ;
    doc:hasParentSection chx:S_TransactionPart ;
    skos:definition "The fee is never written down as such: it is the difference between inputs and outputs, collected by the miner who includes the transaction (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#TransactionFee> .
chx:S_Linkage a doc:TaxonomicSection ; rdfs:label "Linkage"@en ; doc:sectionTitle "Linkage" ; doc:hierarchyLevel 2 ; doc:sectionOrder 6 ;
    doc:hasParentSection chx:S_Transaction ;
    skos:definition "Transaction Chains, Making Change and Coin Selection show how transactions connect to one another (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Linkage> .
chx:S_TransactionChain a doc:ConceptSection ; rdfs:label "Transaction chain"@en ; doc:sectionTitle "Transaction chain" ; doc:hierarchyLevel 3 ; doc:sectionOrder 7 ;
    doc:hasParentSection chx:S_Linkage ;
    skos:definition "Alice's payment to Bob's Store spends an output of the transaction in which her friend Joe paid her, so each payment links back to earlier ones (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#TransactionChain> .
chx:S_MakingChange a doc:ConceptSection ; rdfs:label "Making change"@en ; doc:sectionTitle "Making change" ; doc:hierarchyLevel 3 ; doc:sectionOrder 8 ;
    doc:hasParentSection chx:S_Linkage ;
    skos:definition "Buying an item that costs 5 bitcoins with a 20-bitcoin input sends 5 to the store and 15 back as change, not counting the fee, often to a new change address for privacy (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#MakingChange> .
chx:S_CoinSelection a doc:ConceptSection ; rdfs:label "Coin selection"@en ; doc:sectionTitle "Coin selection" ; doc:hierarchyLevel 3 ; doc:sectionOrder 9 ;
    doc:hasParentSection chx:S_Linkage ;
    skos:definition "Coin selection is the wallet's choice of inputs: aggregating many small ones or using one large one, a balance people also strike with cash (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#CoinSelection> .
chx:S_Form a doc:TaxonomicSection ; rdfs:label "Form"@en ; doc:sectionTitle "Form" ; doc:hierarchyLevel 2 ; doc:sectionOrder 10 ;
    doc:hasParentSection chx:S_Transaction ;
    skos:definition "Common Transaction Forms names the shapes transactions usually take (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Form> .
chx:S_SimplePayment a doc:ConceptSection ; rdfs:label "Simple payment"@en ; doc:sectionTitle "Simple payment" ; doc:hierarchyLevel 3 ; doc:sectionOrder 11 ;
    doc:hasParentSection chx:S_Form ;
    skos:definition "The most common transaction is a simple payment with one input and two outputs, one of them change (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#SimplePayment> .
chx:S_Consolidation a doc:ConceptSection ; rdfs:label "Consolidation"@en ; doc:sectionTitle "Consolidation" ; doc:hierarchyLevel 3 ; doc:sectionOrder 12 ;
    doc:hasParentSection chx:S_Form ;
    skos:definition "A consolidation transaction spends several inputs into one output, the real-world equivalent of exchanging a pile of coins for a single note (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Consolidation> .
chx:S_Unit a doc:TaxonomicSection ; rdfs:label "Unit"@en ; doc:sectionTitle "Unit" ; doc:hierarchyLevel 2 ; doc:sectionOrder 13 ;
    doc:hasParentSection chx:S_Transaction ;
    skos:definition "Amounts can be fractional, down to a smallest indivisible unit (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Unit> .
chx:S_Satoshi a doc:ConceptSection ; rdfs:label "Satoshi"@en ; doc:sectionTitle "Satoshi" ; doc:hierarchyLevel 3 ; doc:sectionOrder 14 ;
    doc:hasParentSection chx:S_Unit ;
    skos:definition "A bitcoin divides into units from the millibitcoin, a thousandth, down to the satoshi, a hundred-millionth, so a millibitcoin is 100,000 satoshis (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Satoshi> .
chx:S_PaymentRequest a doc:TaxonomicSection ; rdfs:label "Payment request"@en ; doc:sectionTitle "Payment request" ; doc:hierarchyLevel 2 ; doc:sectionOrder 15 ;
    doc:hasParentSection chx:S_Transaction ;
    skos:definition "Buying from an Online Store shows the invoice Alice's wallet scans (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#PaymentRequest> .
chx:S_Bip21Uri a doc:ConceptSection ; rdfs:label "BIP21 URI"@en ; doc:sectionTitle "BIP21 URI" ; doc:hierarchyLevel 3 ; doc:sectionOrder 16 ;
    doc:hasParentSection chx:S_PaymentRequest ;
    skos:definition "The invoice QR code encodes a URI defined in BIP21 with the address, the payment amount 0.01577764, the label Bob's Store and a message, so Alice never types an address (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Bip21Uri> .
chx:S_Network a doc:TaxonomicSection ; rdfs:label "Network"@en ; doc:sectionTitle "Network" ; doc:hierarchyLevel 1 ; doc:sectionOrder 17 ;
    skos:definition "Constructing a Transaction and Adding the Transaction to the Blockchain follow the payment from Alice's wallet onto the network (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Network> .
chx:S_Propagation a doc:TaxonomicSection ; rdfs:label "Propagation"@en ; doc:sectionTitle "Propagation" ; doc:hierarchyLevel 2 ; doc:sectionOrder 18 ;
    doc:hasParentSection chx:S_Network ;
    skos:definition "A transaction does not need a central server: Getting the Right Inputs, Creating the Outputs and transmitting it are all done by the wallet (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Propagation> .
chx:S_TransactionPropagation a doc:ConceptSection ; rdfs:label "Transaction propagation"@en ; doc:sectionTitle "Transaction propagation" ; doc:hierarchyLevel 3 ; doc:sectionOrder 19 ;
    doc:hasParentSection chx:S_Propagation ;
    skos:definition "Once signed, the transaction is transmitted to the network and relayed by nodes until miners hold it (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#TransactionPropagation> .
chx:S_BlockExplorer a doc:ConceptSection ; rdfs:label "Block explorer"@en ; doc:sectionTitle "Block explorer" ; doc:hierarchyLevel 3 ; doc:sectionOrder 20 ;
    doc:hasParentSection chx:S_Propagation ;
    skos:definition "Block explorers such as Mempool.Space let anyone look up a transaction or block - and a Bitcoin Overview warning says the operator may learn what you look up (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#BlockExplorer> .
chx:S_Blockchain a doc:TaxonomicSection ; rdfs:label "Blockchain"@en ; doc:sectionTitle "Blockchain" ; doc:hierarchyLevel 1 ; doc:sectionOrder 21 ;
    skos:definition "The blockchain is the authoritative journal of all transactions, produced by miners through competitive computation (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Blockchain> .
chx:S_Mining a doc:TaxonomicSection ; rdfs:label "Mining"@en ; doc:sectionTitle "Mining" ; doc:hierarchyLevel 2 ; doc:sectionOrder 22 ;
    doc:hasParentSection chx:S_Blockchain ;
    skos:definition "The Bitcoin Mining section explains how transactions become part of that journal (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Mining> .
chx:S_Block a doc:ConceptSection ; rdfs:label "Block"@en ; doc:sectionTitle "Block" ; doc:hierarchyLevel 3 ; doc:sectionOrder 23 ;
    doc:hasParentSection chx:S_Mining ;
    skos:definition "Transactions are bundled into blocks whose small header needs an enormous amount of computation to form correctly but little to verify (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Block> .
chx:S_ConsensusRules a doc:ConceptSection ; rdfs:label "Consensus rules"@en ; doc:sectionTitle "Consensus rules" ; doc:hierarchyLevel 3 ; doc:sectionOrder 24 ;
    doc:hasParentSection chx:S_Mining ;
    skos:definition "Miners can only earn honest income from blocks that follow all of Bitcoin's consensus rules, so they are incentivised to include only valid transactions (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#ConsensusRules> .
chx:S_SudokuAnalogy a doc:ConceptSection ; rdfs:label "Sudoku analogy"@en ; doc:sectionTitle "Sudoku analogy" ; doc:hierarchyLevel 3 ; doc:sectionOrder 25 ;
    doc:hasParentSection chx:S_Mining ;
    skos:definition "The course notes picture mining as a giant competitive sudoku - hard to solve, easy to verify, harder or easier by grid size, and restarted after each solution - an analogy the 3rd edition does not use (Altunel, 2021)." ; dcterms:source <http://example.org/sen0401/ch02#SudokuAnalogy> .
chx:S_Security a doc:TaxonomicSection ; rdfs:label "Security"@en ; doc:sectionTitle "Security" ; doc:hierarchyLevel 2 ; doc:sectionOrder 26 ;
    doc:hasParentSection chx:S_Blockchain ;
    skos:definition "Spending the Transaction shows how confidence in a payment grows over time (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#Security> .
chx:S_Confirmation a doc:ConceptSection ; rdfs:label "Confirmation"@en ; doc:sectionTitle "Confirmation" ; doc:hierarchyLevel 3 ; doc:sectionOrder 27 ;
    doc:hasParentSection chx:S_Security ;
    skos:definition "Each block on top adds a confirmation; Nakamoto's paper computes that an attacker with a tenth of the hash power catches up from six blocks behind with probability 0.0002428 (Nakamoto, 2008)." ; dcterms:source <http://example.org/sen0401/ch02#Confirmation> .
chx:S_GenesisBlock a doc:ConceptSection ; rdfs:label "Genesis block"@en ; doc:sectionTitle "Genesis block" ; doc:hierarchyLevel 3 ; doc:sectionOrder 28 ;
    doc:hasParentSection chx:S_Security ;
    skos:definition "Every block links back through hundreds of thousands of blocks to block number 0, the genesis block (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#GenesisBlock> .
chx:S_UnconfirmedTransaction a doc:ConceptSection ; rdfs:label "Unconfirmed transaction"@en ; doc:sectionTitle "Unconfirmed transaction" ; doc:hierarchyLevel 3 ; doc:sectionOrder 29 ;
    doc:hasParentSection chx:S_Security ;
    skos:definition "A payment first shows as unconfirmed: propagated but not yet in a block, and blocks arrive every 10 minutes on average rather than on a timetable - the ten-minute misconception the course notes warn about (Altunel, 2021)." ; dcterms:source <http://example.org/sen0401/ch02#UnconfirmedTransaction> .
chx:S_SmallPaymentAcceptance a doc:ConceptSection ; rdfs:label "Small payment acceptance"@en ; doc:sectionTitle "Small payment acceptance" ; doc:hierarchyLevel 3 ; doc:sectionOrder 30 ;
    doc:hasParentSection chx:S_Security ;
    skos:definition "Selling a cheap item unconfirmed carries low double-spend risk, as coffee shops accept small card payments without a signature, while an expensive item justifies waiting for confirmations (Antonopoulos and Harding, 2023)." ; dcterms:source <http://example.org/sen0401/ch02#SmallPaymentAcceptance> .
chx:S_Semantics a doc:TaxonomicSection ; rdfs:label "Semantics"@en ; doc:sectionTitle "Semantics" ; doc:hierarchyLevel 1 ; doc:sectionOrder 31 ;
    skos:definition "The course theme of semantic technologies meets the chapter in its transaction chain (World Wide Web Consortium, 2013)." ; dcterms:source <http://example.org/sen0401/ch02#Semantics> .
chx:S_ProvenanceModel a doc:TaxonomicSection ; rdfs:label "Provenance model"@en ; doc:sectionTitle "Provenance model" ; doc:hierarchyLevel 2 ; doc:sectionOrder 32 ;
    doc:hasParentSection chx:S_Semantics ;
    skos:definition "A chain of spends is a record of where each value came from - a provenance record (World Wide Web Consortium, 2013)." ; dcterms:source <http://example.org/sen0401/ch02#ProvenanceModel> .
chx:S_ProvenanceGraph a doc:ConceptSection ; rdfs:label "Provenance graph"@en ; doc:sectionTitle "Provenance graph" ; doc:hierarchyLevel 3 ; doc:sectionOrder 33 ;
    doc:hasParentSection chx:S_ProvenanceModel ;
    skos:definition "W3C's PROV Ontology describes entities derived from other entities by activities and attributed to agents, which is exactly the shape of outputs spent by transactions signed by key holders (World Wide Web Consortium, 2013)." ; dcterms:source <http://example.org/sen0401/ch02#ProvenanceGraph> .
chx:S_Practice a doc:TaxonomicSection ; rdfs:label "Practice"@en ; doc:sectionTitle "Practice" ; doc:hierarchyLevel 1 ; doc:sectionOrder 34 ;
    skos:definition "The course notes point students to an interactive demonstration of the chain of hashes this chapter describes (Altunel, 2021)." ; dcterms:source <http://example.org/sen0401/ch02#Practice> .
chx:S_InteractiveDemo a doc:TaxonomicSection ; rdfs:label "Interactive demo"@en ; doc:sectionTitle "Interactive demo" ; doc:hierarchyLevel 2 ; doc:sectionOrder 35 ;
    doc:hasParentSection chx:S_Practice ;
    skos:definition "Seeing a hash chain break is more convincing than reading about it (Altunel, 2021)." ; dcterms:source <http://example.org/sen0401/ch02#InteractiveDemo> .
chx:S_BlockchainDemo a doc:ConceptSection ; rdfs:label "Blockchain demo"@en ; doc:sectionTitle "Blockchain demo" ; doc:hierarchyLevel 3 ; doc:sectionOrder 36 ;
    doc:hasParentSection chx:S_InteractiveDemo ;
    skos:definition "Anders Brownworth's Blockchain Demo shows that changing one character in an earlier block invalidates every later block, which is what makes the journal tamper-evident (Altunel, 2021)." ; dcterms:source <http://example.org/sen0401/ch02#BlockchainDemo> .
