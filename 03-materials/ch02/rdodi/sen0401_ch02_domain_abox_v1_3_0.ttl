@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

<http://example.org/sen0401/ch02/abox> a owl:Ontology ;
    rdfs:label "SEN0401 chapter 2 domain ontology - ABox"@en ; owl:versionInfo "1.3.0" ; owl:versionIRI <http://example.org/sen0401/ch02/abox/1.3.0> ; rdfs:comment "1.3.0 keeps every concept, example and worked output of 1.2.0 and rewrites eight paragraphs, so it is MINOR. Eight second-level sections carried a paragraph whose whole content was a list of the concepts beneath them, which the page's breadcrumb row already prints; each is replaced by a paragraph on how the section's subject works, in the same facet and the same position, so no section changes length. This chapter needed no other change from the audit: its fourteen second-level sections already carry four or five paragraphs, and all eighty-two of its leaf concepts already carry an executed worked example."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:created "2026-09-24"^^xsd:date ; dcterms:modified "2026-10-05"^^xsd:date ;
    dcterms:identifier "sen0401_ch02_abox_v1_3_0" ; prov:wasRevisionOf <http://example.org/sen0401/ch02/abox/1.2.0> ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/ch02-rdodi-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

chx:X_DoubleEntryLedger a owl:NamedIndividual, chx:DoubleEntryLedger ; rdfs:label "inputs balance outputs plus fee"@en ; skos:definition "A ledger records every movement of value as an entry; the chapter pictures a transaction as a double-entry line whose two sides, inputs and outputs, differ only by the fee."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_DoubleEntryLedger a owl:NamedIndividual, rd:IOExample ; rdfs:label "sum([75000, 20000, 5000]) == 100000 evaluates to True"@en ; chx:input "sum([75000, 20000, 5000]) == 100000" ; chx:output "True" .
chx:X_DoubleEntryLedger rd:hasIOExample chx:IO_DoubleEntryLedger .
chx:X_Input a owl:NamedIndividual, chx:Input ; rdfs:label "an earlier output being spent"@en ; skos:definition "An input spends funds by referring to an earlier transaction's output and proving ownership with a digital signature."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Input a owl:NamedIndividual, rd:IOExample ; rdfs:label "bytes.fromhex('eb3ae38f27191aa5f3850dc9cad00492b88b72404f9da135698679268041c54a')[::-1].hex() evaluates to '4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb'"@en ; chx:input "bytes.fromhex('eb3ae38f27191aa5f3850dc9cad00492b88b72404f9da135698679268041c54a')[::-1].hex()" ; chx:output "'4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb'" .
chx:X_Input rd:hasIOExample chx:IO_Input .
chx:X_Output a owl:NamedIndividual, chx:Output ; rdfs:label "an amount locked to an address"@en ; skos:definition "An output receives funds; the outputs add up to slightly less than the inputs."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Output a owl:NamedIndividual, rd:IOExample ; rdfs:label "sum([75000, 20000]) evaluates to 95000"@en ; chx:input "sum([75000, 20000])" ; chx:output "95000" .
chx:X_Output rd:hasIOExample chx:IO_Output .
chx:X_TransactionFee a owl:NamedIndividual, chx:TransactionFee ; rdfs:label "inputs minus outputs"@en ; skos:definition "The fee is implied: the difference between the inputs and the outputs, collected by the miner who includes the transaction."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_TransactionFee a owl:NamedIndividual, rd:IOExample ; rdfs:label "100000 - sum([75000, 20000]) evaluates to 5000"@en ; chx:input "100000 - sum([75000, 20000])" ; chx:output "5000" .
chx:X_TransactionFee rd:hasIOExample chx:IO_TransactionFee .
chx:X_TransactionSize a owl:NamedIndividual, chx:TransactionSize ; rdfs:label "Alice's payment: 194 bytes, weight 569, 143 vbytes"@en ; skos:definition "A block has limited room; transactions are measured in weight units, four of which make one virtual byte (vbyte), and a miner compares them by fee per unit."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_TransactionSize a owl:NamedIndividual, rd:IOExample ; rdfs:label "(569 + 3) // 4 evaluates to 143"@en ; chx:input "(569 + 3) // 4" ; chx:output "143" .
chx:X_TransactionSize rd:hasIOExample chx:IO_TransactionSize .
chx:X_FeeRate a owl:NamedIndividual, chx:FeeRate ; rdfs:label "fee divided by size"@en ; skos:definition "A miner compares transactions by their fee for the space they use, the fee rate, usually quoted in satoshis per virtual byte."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_FeeRate a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(5000 / 143, 2) evaluates to 34.97"@en ; chx:input "round(5000 / 143, 2)" ; chx:output "34.97" .
chx:X_FeeRate rd:hasIOExample chx:IO_FeeRate .
chx:X_UnspentOutput a owl:NamedIndividual, chx:UnspentOutput ; rdfs:label "an output nobody has spent"@en ; skos:definition "An unspent transaction output (UTXO) is an output that no later transaction has consumed; full nodes keep the set of all of them."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_UnspentOutput a owl:NamedIndividual, rd:IOExample ; rdfs:label "[o for o, spent in {'Tx1:0': True, 'Tx2:0': False, 'Tx2:1': False}.items() if not spent] evaluates to ['Tx2:0', 'Tx2:1']"@en ; chx:input "[o for o, spent in {'Tx1:0': True, 'Tx2:0': False, 'Tx2:1': False}.items() if not spent]" ; chx:output "['Tx2:0', 'Tx2:1']" .
chx:X_UnspentOutput rd:hasIOExample chx:IO_UnspentOutput .
chx:X_TransactionIdentifier a owl:NamedIndividual, chx:TransactionIdentifier ; rdfs:label "a 32-byte name for Alice's payment"@en ; skos:definition "The transaction identifier, or txid, is a 32-byte value derived from the transaction's data; an input points to an earlier output by txid and position."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_TransactionIdentifier a owl:NamedIndividual, rd:IOExample ; rdfs:label "bytes.fromhex('eb3ae38f27191aa5f3850dc9cad00492b88b72404f9da135698679268041c54a')[::-1].hex() evaluates to '4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb'"@en ; chx:input "bytes.fromhex('eb3ae38f27191aa5f3850dc9cad00492b88b72404f9da135698679268041c54a')[::-1].hex()" ; chx:output "'4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb'" .
chx:X_TransactionIdentifier rd:hasIOExample chx:IO_TransactionIdentifier .
chx:X_HashFunction a owl:NamedIndividual, chx:HashFunction ; rdfs:label "a fixed-size fingerprint of any data"@en ; skos:definition "A hash function turns data of any length into a fixed-length value that is easy to compute, always the same for the same input, and impractical to steer toward a chosen result."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_HashFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hashlib').sha256(b'Hello, world!\\n').hexdigest() evaluates to 'd9014c4624844aa5bac314773d6b689ad467fa4e1d1a50a1b8a99d5a95f72ff5'"@en ; chx:input "__import__('hashlib').sha256(b'Hello, world!\\n').hexdigest()" ; chx:output "'d9014c4624844aa5bac314773d6b689ad467fa4e1d1a50a1b8a99d5a95f72ff5'" .
chx:X_HashFunction rd:hasIOExample chx:IO_HashFunction .
chx:X_KeyPair a owl:NamedIndividual, chx:KeyPair ; rdfs:label "a secret number and the public value made from it"@en ; skos:definition "A key pair is a private key, a secret 256-bit number, together with the public key calculated from it; the public key can be shared, the private key must not be."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_KeyPair a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(bytes.fromhex('1E99423A4ED27608A15A2616A2B0E9E52CED330AC530EDCC32C8FFC6A526AEDD')) * 8 evaluates to 256"@en ; chx:input "len(bytes.fromhex('1E99423A4ED27608A15A2616A2B0E9E52CED330AC530EDCC32C8FFC6A526AEDD')) * 8" ; chx:output "256" .
chx:X_KeyPair rd:hasIOExample chx:IO_KeyPair .
chx:X_PublicKeyCryptography a owl:NamedIndividual, chx:PublicKeyCryptography ; rdfs:label "easy forward, impractical backward"@en ; skos:definition "Public-key cryptography uses a pair of related keys and a mathematical function that is easy to compute in one direction and infeasible to reverse, which makes unforgeable digital signatures possible."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_PublicKeyCryptography a owl:NamedIndividual, rd:IOExample ; rdfs:label "[k for k in range(1, 17) if pow(3, k, 17) == 11] evaluates to [7]"@en ; chx:input "[k for k in range(1, 17) if pow(3, k, 17) == 11]" ; chx:output "[7]" .
chx:X_PublicKeyCryptography rd:hasIOExample chx:IO_PublicKeyCryptography .
chx:X_EllipticCurve a owl:NamedIndividual, chx:EllipticCurve ; rdfs:label "the curve y squared equals x cubed plus 7"@en ; skos:definition "Bitcoin's keys are points on the curve secp256k1, y squared = x cubed + 7 over a finite field of prime order p; multiplying a point by a number is easy and the reverse is infeasible."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_EllipticCurve a owl:NamedIndividual, rd:IOExample ; rdfs:label "(0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8 ** 2 - 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798 ** 3 - 7) % (2 ** 256 - 2 ** 32 - 977) evaluates to 0"@en ; chx:input "(0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8 ** 2 - 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798 ** 3 - 7) % (2 ** 256 - 2 ** 32 - 977)" ; chx:output "0" .
chx:X_EllipticCurve rd:hasIOExample chx:IO_EllipticCurve .
chx:X_DigitalSignature a owl:NamedIndividual, chx:DigitalSignature ; rdfs:label "a proof made with the private key"@en ; skos:definition "A digital signature is a value computed from a message and a private key that anyone can check against the public key, proving authorization, preventing denial and detecting changes."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_DigitalSignature a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(bytes.fromhex('cf5efe2d8ef13ed0af21d4f4cb82422d6252d70324f6f4576b727b7d918e521c00b51be739df2f899c49dc267c0ad280aca6dab0d2fa2b42a45182fc83e8171301')) evaluates to 65"@en ; chx:input "len(bytes.fromhex('cf5efe2d8ef13ed0af21d4f4cb82422d6252d70324f6f4576b727b7d918e521c00b51be739df2f899c49dc267c0ad280aca6dab0d2fa2b42a45182fc83e8171301'))" ; chx:output "65" .
chx:X_DigitalSignature rd:hasIOExample chx:IO_DigitalSignature .
chx:X_Checksum a owl:NamedIndividual, chx:Checksum ; rdfs:label "a few bytes of hash that catch typing errors"@en ; skos:definition "A checksum is a short value derived from data and appended to it so that a transcription or typing error can be detected; Bitcoin addresses carry one."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Checksum a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hashlib').sha256(__import__('hashlib').sha256(b'bitcoin').digest()).digest()[:4].hex() evaluates to 'f1ef1bf1'"@en ; chx:input "__import__('hashlib').sha256(__import__('hashlib').sha256(b'bitcoin').digest()).digest()[:4].hex()" ; chx:output "'f1ef1bf1'" .
chx:X_Checksum rd:hasIOExample chx:IO_Checksum .
chx:X_Script a owl:NamedIndividual, chx:Script ; rdfs:label "2 3 OP_ADD 5 OP_EQUAL"@en ; skos:definition "A script is a short program in Bitcoin's stack-based language; an output carries the conditions for spending it, and the spender supplies data that makes the program end with TRUE."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Script a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: [s.append(s.pop() + s.pop()) if t == 'OP_ADD' else s.append(s.pop() == s.pop()) if t == 'OP_EQUAL' else s.append(int(t)) for t in '2 3 OP_ADD 5 OP_EQUAL'.split()] and s)([]) evaluates to [True]"@en ; chx:input "(lambda s: [s.append(s.pop() + s.pop()) if t == 'OP_ADD' else s.append(s.pop() == s.pop()) if t == 'OP_EQUAL' else s.append(int(t)) for t in '2 3 OP_ADD 5 OP_EQUAL'.split()] and s)([])" ; chx:output "[True]" .
chx:X_Script rd:hasIOExample chx:IO_Script .
chx:X_TransactionChain a owl:NamedIndividual, chx:TransactionChain ; rdfs:label "Alice's payment spending Joe's output"@en ; skos:definition "Each transaction's inputs spend earlier outputs, so transactions form chains back through history."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_TransactionChain a owl:NamedIndividual, rd:IOExample ; rdfs:label "[100000 - 75000 - 20000, 75000 - 67000] evaluates to [5000, 8000]"@en ; chx:input "[100000 - 75000 - 20000, 75000 - 67000]" ; chx:output "[5000, 8000]" .
chx:X_TransactionChain rd:hasIOExample chx:IO_TransactionChain .
chx:X_MakingChange a owl:NamedIndividual, chx:MakingChange ; rdfs:label "paying 5 from a 20 input"@en ; skos:definition "An output larger than the payment returns the rest as change to a new address of the payer, because an input cannot be partly spent."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_MakingChange a owl:NamedIndividual, rd:IOExample ; rdfs:label "20 - 5 evaluates to 15"@en ; chx:input "20 - 5" ; chx:output "15" .
chx:X_MakingChange rd:hasIOExample chx:IO_MakingChange .
chx:X_CoinSelection a owl:NamedIndividual, chx:CoinSelection ; rdfs:label "choosing which inputs to spend"@en ; skos:definition "Wallets choose which inputs to spend, balancing many small inputs against few large ones, much as people handle cash."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_CoinSelection a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda vals, need: next((vals[:i + 1], sum(vals[:i + 1]) - need) for i in range(len(vals)) if sum(vals[:i + 1]) >= need))([60000, 30000, 25000], 80000) evaluates to ([60000, 30000], 10000)"@en ; chx:input "(lambda vals, need: next((vals[:i + 1], sum(vals[:i + 1]) - need) for i in range(len(vals)) if sum(vals[:i + 1]) >= need))([60000, 30000, 25000], 80000)" ; chx:output "([60000, 30000], 10000)" .
chx:X_CoinSelection rd:hasIOExample chx:IO_CoinSelection .
chx:X_SimplePayment a owl:NamedIndividual, chx:SimplePayment ; rdfs:label "one input, two outputs"@en ; skos:definition "The most common form: one input, and two outputs - the payment and the change."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_SimplePayment a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ins, outs: (len(ins), len(outs), sum(ins) - sum(outs)))([100000], [20000, 75000]) evaluates to (1, 2, 5000)"@en ; chx:input "(lambda ins, outs: (len(ins), len(outs), sum(ins) - sum(outs)))([100000], [20000, 75000])" ; chx:output "(1, 2, 5000)" .
chx:X_SimplePayment rd:hasIOExample chx:IO_SimplePayment .
chx:X_Consolidation a owl:NamedIndividual, chx:Consolidation ; rdfs:label "many inputs, one output"@en ; skos:definition "Many inputs spent into a single output, like exchanging a pile of coins for one note."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Consolidation a owl:NamedIndividual, rd:IOExample ; rdfs:label "sum([30000, 25000, 20000]) - 1500 evaluates to 73500"@en ; chx:input "sum([30000, 25000, 20000]) - 1500" ; chx:output "73500" .
chx:X_Consolidation rd:hasIOExample chx:IO_Consolidation .
chx:X_PaymentBatching a owl:NamedIndividual, chx:PaymentBatching ; rdfs:label "one transaction, many recipients"@en ; skos:definition "Payment batching pays several recipients with one transaction that has many outputs, as a payroll does."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_PaymentBatching a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda pay: (sum(pay), 200000 - sum(pay) - 3000))([60000, 55000, 50000, 32000]) evaluates to (197000, 0)"@en ; chx:input "(lambda pay: (sum(pay), 200000 - sum(pay) - 3000))([60000, 55000, 50000, 32000])" ; chx:output "(197000, 0)" .
chx:X_PaymentBatching rd:hasIOExample chx:IO_PaymentBatching .
chx:X_Satoshi a owl:NamedIndividual, chx:Satoshi ; rdfs:label "one hundred-millionth of a bitcoin"@en ; skos:definition "The smallest unit: a bitcoin divides into 100,000,000 satoshis."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Satoshi a owl:NamedIndividual, rd:IOExample ; rdfs:label "10**8 // 1000 evaluates to 100000"@en ; chx:input "10**8 // 1000" ; chx:output "100000" .
chx:X_Satoshi rd:hasIOExample chx:IO_Satoshi .
chx:X_Uri a owl:NamedIndividual, chx:Uri ; rdfs:label "a scheme, a path and a query"@en ; skos:definition "A URI is a text string that names a resource by a scheme such as bitcoin:, a path and optional query parameters; Bitcoin payment requests use the form bitcoin:address?parameters."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Uri a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda u: (u.scheme, u.path, u.query))(__import__('urllib.parse').parse.urlsplit('bitcoin:bc1qk2g6u8p4qm2s2lh3gts5cpt2mrv5skcuu7u3e4?amount=0.01577764')) evaluates to ('bitcoin', 'bc1qk2g6u8p4qm2s2lh3gts5cpt2mrv5skcuu7u3e4', 'amount=0.01577764')"@en ; chx:input "(lambda u: (u.scheme, u.path, u.query))(__import__('urllib.parse').parse.urlsplit('bitcoin:bc1qk2g6u8p4qm2s2lh3gts5cpt2mrv5skcuu7u3e4?amount=0.01577764'))" ; chx:output "('bitcoin', 'bc1qk2g6u8p4qm2s2lh3gts5cpt2mrv5skcuu7u3e4', 'amount=0.01577764')" .
chx:X_Uri rd:hasIOExample chx:IO_Uri .
chx:X_QrCode a owl:NamedIndividual, chx:QrCode ; rdfs:label "a square of black and white dots"@en ; skos:definition "A QR code is a two-dimensional barcode that holds a short text, such as an address or a payment request, which a phone camera reads."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_QrCode a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a: (a == a.upper(), a.isalnum(), len(a)))('BC1QK2G6U8P4QM2S2LH3GTS5CPT2MRV5SKCUU7U3E4') evaluates to (True, True, 42)"@en ; chx:input "(lambda a: (a == a.upper(), a.isalnum(), len(a)))('BC1QK2G6U8P4QM2S2LH3GTS5CPT2MRV5SKCUU7U3E4')" ; chx:output "(True, True, 42)" .
chx:X_QrCode rd:hasIOExample chx:IO_QrCode .
chx:X_Bip a owl:NamedIndividual, chx:Bip ; rdfs:label "BIP 21 proposes the bitcoin: URI scheme"@en ; skos:definition "A BIP is a design document that proposes or describes a feature of Bitcoin; standards, informational and process proposals are kept as numbered text files in a public repository."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Bip a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda hdr: dict(l.strip().split(': ', 1) for l in hdr.splitlines() if ': ' in l)['Status'])('  BIP: 21\\n  Title: URI Scheme\\n  Status: Closed') evaluates to 'Closed'"@en ; chx:input "(lambda hdr: dict(l.strip().split(': ', 1) for l in hdr.splitlines() if ': ' in l)['Status'])('  BIP: 21\\n  Title: URI Scheme\\n  Status: Closed')" ; chx:output "'Closed'" .
chx:X_Bip rd:hasIOExample chx:IO_Bip .
chx:X_Bip21Uri a owl:NamedIndividual, chx:Bip21Uri ; rdfs:label "the invoice encoded in the store's QR code"@en ; skos:definition "A BIP21 URI carrying the address, amount, label and message, which the wallet reads so the payer never types an address."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Bip21Uri a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('urllib.parse').parse.parse_qs(__import__('urllib.parse').parse.urlsplit('bitcoin:bc1qk2g6u8p4qm2s2lh3gts5cpt2mrv5skcuu7u3e4?amount=0.01577764&label=Bob%27s%20Store').query)['label'][0] evaluates to \"Bob's Store\""@en ; chx:input "__import__('urllib.parse').parse.parse_qs(__import__('urllib.parse').parse.urlsplit('bitcoin:bc1qk2g6u8p4qm2s2lh3gts5cpt2mrv5skcuu7u3e4?amount=0.01577764&label=Bob%27s%20Store').query)['label'][0]" ; chx:output "\"Bob's Store\"" .
chx:X_Bip21Uri rd:hasIOExample chx:IO_Bip21Uri .
chx:X_TransactionConstruction a owl:NamedIndividual, chx:TransactionConstruction ; rdfs:label "from a destination, an amount and a fee to a signed transaction"@en ; skos:definition "A wallet builds a transaction by choosing inputs, creating an output for the receiver and a change output, leaving the fee implied, and signing - even offline."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_TransactionConstruction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda utxo, pay, fee: [utxo - pay - fee, pay])(100000, 75000, 5000) evaluates to [20000, 75000]"@en ; chx:input "(lambda utxo, pay, fee: [utxo - pay - fee, pay])(100000, 75000, 5000)" ; chx:output "[20000, 75000]" .
chx:X_TransactionConstruction rd:hasIOExample chx:IO_TransactionConstruction .
chx:X_BitsAndBytes a owl:NamedIndividual, chx:BitsAndBytes ; rdfs:label "32 bytes are 256 bits"@en ; skos:definition "A bit is one binary digit; eight bits make a byte. Sizes in Bitcoin are quoted in both, and 32 bytes are 256 bits."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_BitsAndBytes a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(bytes.fromhex('4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b')) * 8 evaluates to 256"@en ; chx:input "len(bytes.fromhex('4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b')) * 8" ; chx:output "256" .
chx:X_BitsAndBytes rd:hasIOExample chx:IO_BitsAndBytes .
chx:X_HexadecimalNotation a owl:NamedIndividual, chx:HexadecimalNotation ; rdfs:label "the digits 0-9 and a-f"@en ; skos:definition "Hexadecimal writes a number in base 16 with the digits 0 to 9 and a to f; each digit stands for four bits, so one byte is exactly two hexadecimal digits."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_HexadecimalNotation a owl:NamedIndividual, rd:IOExample ; rdfs:label "(int('ff', 16), int('1d00ffff', 16), len(hex(255)[2:])) evaluates to (255, 486604799, 2)"@en ; chx:input "(int('ff', 16), int('1d00ffff', 16), len(hex(255)[2:]))" ; chx:output "(255, 486604799, 2)" .
chx:X_HexadecimalNotation rd:hasIOExample chx:IO_HexadecimalNotation .
chx:X_Entropy a owl:NamedIndividual, chx:Entropy ; rdfs:label "how unpredictable a secret is"@en ; skos:definition "Entropy measures how unpredictable a value is, counted in bits; a key chosen from 2**256 equally likely values has 256 bits of it, and a key chosen badly has far less."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Entropy a owl:NamedIndividual, rd:IOExample ; rdfs:label "(2 ** 256).bit_length() - 1 evaluates to 256"@en ; chx:input "(2 ** 256).bit_length() - 1" ; chx:output "256" .
chx:X_Entropy rd:hasIOExample chx:IO_Entropy .
chx:X_Nonce a owl:NamedIndividual, chx:Nonce ; rdfs:label "a number used once to vary a result"@en ; skos:definition "A nonce is a value, often a counter, that is changed to make a cryptographic function produce a different output; signing uses a secret one and mining a public one in the block header."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Nonce a owl:NamedIndividual, rd:IOExample ; rdfs:label "next(n for n in range(1000) if __import__('hashlib').sha256(('Hello, world! %d\\n' % n).encode()).hexdigest().startswith('0')) evaluates to 32"@en ; chx:input "next(n for n in range(1000) if __import__('hashlib').sha256(('Hello, world! %d\\n' % n).encode()).hexdigest().startswith('0'))" ; chx:output "32" .
chx:X_Nonce rd:hasIOExample chx:IO_Nonce .
chx:X_Encryption a owl:NamedIndividual, chx:Encryption ; rdfs:label "making data unreadable without a key"@en ; skos:definition "Encryption transforms data so that only a holder of the right key can read it again; Bitcoin's public-key cryptography is used for signatures, not for encrypting transactions."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Encryption a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda k, m: (bytes(c ^ k for c in m).hex(), bytes(c ^ k for c in bytes(c ^ k for c in m)).decode()))(0x5a, b'pay Bob') evaluates to ('2a3b237a183538', 'pay Bob')"@en ; chx:input "(lambda k, m: (bytes(c ^ k for c in m).hex(), bytes(c ^ k for c in bytes(c ^ k for c in m)).decode()))(0x5a, b'pay Bob')" ; chx:output "('2a3b237a183538', 'pay Bob')" .
chx:X_Encryption rd:hasIOExample chx:IO_Encryption .
chx:X_Serialization a owl:NamedIndividual, chx:Serialization ; rdfs:label "the 194 bytes of Alice's payment"@en ; skos:definition "Serialization is the writing of a structure as a flat sequence of bytes in a fixed order, which is the form in which a transaction is sent, hashed and stored."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Serialization a owl:NamedIndividual, rd:IOExample ; rdfs:label "int.from_bytes(bytes.fromhex('204e000000000000'), 'little') evaluates to 20000"@en ; chx:input "int.from_bytes(bytes.fromhex('204e000000000000'), 'little')" ; chx:output "20000" .
chx:X_Serialization rd:hasIOExample chx:IO_Serialization .
chx:X_ByteOrder a owl:NamedIndividual, chx:ByteOrder ; rdfs:label "the identifier read both ways"@en ; skos:definition "Byte order is the direction in which the bytes of a value are written; Bitcoin displays hashes in one direction and stores them in the other, so the same value looks like two."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_ByteOrder a owl:NamedIndividual, rd:IOExample ; rdfs:label "bytes.fromhex('4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb')[::-1].hex()[:16] evaluates to 'eb3ae38f27191aa5'"@en ; chx:input "bytes.fromhex('4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb')[::-1].hex()[:16]" ; chx:output "'eb3ae38f27191aa5'" .
chx:X_ByteOrder rd:hasIOExample chx:IO_ByteOrder .
chx:X_Outpoint a owl:NamedIndividual, chx:Outpoint ; rdfs:label "txid 4ac54180... index 1"@en ; skos:definition "An outpoint is the pair of a transaction identifier and an output index that names exactly one output; an input consists of an outpoint and the data that satisfies it."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Outpoint a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda txid, vout: '%s:%d' % (txid[:8] + '...', vout))('4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb', 1) evaluates to '4ac54180...:1'"@en ; chx:input "(lambda txid, vout: '%s:%d' % (txid[:8] + '...', vout))('4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb', 1)" ; chx:output "'4ac54180...:1'" .
chx:X_Outpoint rd:hasIOExample chx:IO_Outpoint .
chx:X_Address a owl:NamedIndividual, chx:Address ; rdfs:label "bc1qk2g6u8p4qm2s2lh3gts5cpt2mrv5skcuu7u3e4"@en ; skos:definition "A Bitcoin address is a short string, carrying a checksum, that encodes the condition under which a payment may later be spent; it is what a payer is given and what a wallet turns into an output script."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Address a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a: (a[:3], len(a), a.islower()))('bc1qk2g6u8p4qm2s2lh3gts5cpt2mrv5skcuu7u3e4') evaluates to ('bc1', 42, True)"@en ; chx:input "(lambda a: (a[:3], len(a), a.islower()))('bc1qk2g6u8p4qm2s2lh3gts5cpt2mrv5skcuu7u3e4')" ; chx:output "('bc1', 42, True)" .
chx:X_Address rd:hasIOExample chx:IO_Address .
chx:X_ExchangeRate a owl:NamedIndividual, chx:ExchangeRate ; rdfs:label "a dollar price shown in bitcoin"@en ; skos:definition "An exchange rate is the price of one currency in another; Bob's shop lists prices in dollars and converts them to bitcoin at checkout, so the bitcoin amount of an invoice is only valid for a moment."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_ExchangeRate a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(25.0 / 1584.0, 8) evaluates to 0.01578283"@en ; chx:input "round(25.0 / 1584.0, 8)" ; chx:output "0.01578283" .
chx:X_ExchangeRate rd:hasIOExample chx:IO_ExchangeRate .
chx:X_Wallet a owl:NamedIndividual, chx:Wallet ; rdfs:label "the application that holds Alice's keys"@en ; skos:definition "A wallet is the software that keeps a user's keys, tracks the outputs they can spend, builds and signs transactions, and shows balances; it holds keys, not coins."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Wallet a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda utxos, pay, fee: sum(utxos) - pay - fee)([100000], 75000, 5000) evaluates to 20000"@en ; chx:input "(lambda utxos, pay, fee: sum(utxos) - pay - fee)([100000], 75000, 5000)" ; chx:output "20000" .
chx:X_Wallet rd:hasIOExample chx:IO_Wallet .
chx:X_Witness a owl:NamedIndividual, chx:Witness ; rdfs:label "69 of Alice's 194 bytes"@en ; skos:definition "The witness is the data that proves an input may be spent, kept in its own structure outside the part that the transaction identifier is computed from; this separation is called segregated witness."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Witness a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda total, stripped: (total - stripped, stripped * 3 + total))(194, 125) evaluates to (69, 569)"@en ; chx:input "(lambda total, stripped: (total - stripped, stripped * 3 + total))(194, 125)" ; chx:output "(69, 569)" .
chx:X_Witness rd:hasIOExample chx:IO_Witness .
chx:X_FullNode a owl:NamedIndividual, chx:FullNode ; rdfs:label "a program that verifies every rule"@en ; skos:definition "A full node is a program that holds the logic and the data to verify every transaction and block against every rule, so that it needs to trust nobody."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_FullNode a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda checks: all(checks.values()) and len(checks))({'syntax': True, 'inputs_nonempty': True, 'amounts_in_range': True, 'outputs_unspent': True, 'scripts_valid': True}) evaluates to 5"@en ; chx:input "(lambda checks: all(checks.values()) and len(checks))({'syntax': True, 'inputs_nonempty': True, 'amounts_in_range': True, 'outputs_unspent': True, 'scripts_valid': True})" ; chx:output "5" .
chx:X_FullNode rd:hasIOExample chx:IO_FullNode .
chx:X_LightweightClient a owl:NamedIndividual, chx:LightweightClient ; rdfs:label "a wallet on a telephone"@en ; skos:definition "A lightweight client downloads only block headers and asks peers for the parts of the chain that concern it, so it verifies a payment only partly; this is simplified payment verification."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_LightweightClient a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda headers, full: round(full / headers))(80, 800000) evaluates to 10000"@en ; chx:input "(lambda headers, full: round(full / headers))(80, 800000)" ; chx:output "10000" .
chx:X_LightweightClient rd:hasIOExample chx:IO_LightweightClient .
chx:X_Peer a owl:NamedIndividual, chx:Peer ; rdfs:label "another node my node talks to"@en ; skos:definition "A peer is another node that a node keeps a connection to in order to exchange transactions and blocks; peers are equals, with no server among them."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Peer a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda peers: (len(peers), sorted(peers)[0]))({'peer-a', 'peer-b', 'peer-c'}) evaluates to (3, 'peer-a')"@en ; chx:input "(lambda peers: (len(peers), sorted(peers)[0]))({'peer-a', 'peer-b', 'peer-c'})" ; chx:output "(3, 'peer-a')" .
chx:X_Peer rd:hasIOExample chx:IO_Peer .
chx:X_PeerToPeerNetwork a owl:NamedIndividual, chx:PeerToPeerNetwork ; rdfs:label "a mesh with no server"@en ; skos:definition "A peer-to-peer network is one in which every participant is of the same kind and both provides and consumes services, with no server and no hierarchy; Bitcoin is built this way on purpose."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_PeerToPeerNetwork a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda n: n * (n - 1) // 2)(5) evaluates to 10"@en ; chx:input "(lambda n: n * (n - 1) // 2)(5)" ; chx:output "10" .
chx:X_PeerToPeerNetwork rd:hasIOExample chx:IO_PeerToPeerNetwork .
chx:X_Transmission a owl:NamedIndividual, chx:Transmission ; rdfs:label "the first hop out of the wallet"@en ; skos:definition "Transmission is the sending of a finished transaction from the wallet to any program that will put it on the network; the route does not matter because the transaction carries everything needed to process it."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Transmission a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda routes: sorted(routes))({'wired', 'wifi', 'mobile', 'block explorer'}) evaluates to ['block explorer', 'mobile', 'wifi', 'wired']"@en ; chx:input "(lambda routes: sorted(routes))({'wired', 'wifi', 'mobile', 'block explorer'})" ; chx:output "['block explorer', 'mobile', 'wifi', 'wired']" .
chx:X_Transmission rd:hasIOExample chx:IO_Transmission .
chx:X_Gossiping a owl:NamedIndividual, chx:Gossiping ; rdfs:label "each node tells all its peers"@en ; skos:definition "Gossiping is the rule that any node receiving a valid transaction it has not seen before forwards it to all the peers it is connected to, so that data spreads without any coordinator."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Gossiping a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda peers, rounds: peers ** rounds)(8, 3) evaluates to 512"@en ; chx:input "(lambda peers, rounds: peers ** rounds)(8, 3)" ; chx:output "512" .
chx:X_Gossiping rd:hasIOExample chx:IO_Gossiping .
chx:X_TransactionPropagation a owl:NamedIndividual, chx:TransactionPropagation ; rdfs:label "Alice's payment reaching the network"@en ; skos:definition "Transaction propagation is the spread of a signed transaction across the network by gossip, each node verifying before relaying, until it reaches the miners."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_TransactionPropagation a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda sec, nodes: round(nodes / sec))(5, 10000) evaluates to 2000"@en ; chx:input "(lambda sec, nodes: round(nodes / sec))(5, 10000)" ; chx:output "2000" .
chx:X_TransactionPropagation rd:hasIOExample chx:IO_TransactionPropagation .
chx:X_Mempool a owl:NamedIndividual, chx:Mempool ; rdfs:label "where an unconfirmed payment waits"@en ; skos:definition "The memory pool is the list of verified but unconfirmed transactions that a node keeps in memory; miners build candidate blocks from it, and it differs from node to node."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Mempool a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda pool, mined: [t for t in pool if t not in mined])(['txA', 'txB', 'txC'], {'txB'}) evaluates to ['txA', 'txC']"@en ; chx:input "(lambda pool, mined: [t for t in pool if t not in mined])(['txA', 'txB', 'txC'], {'txB'})" ; chx:output "['txA', 'txC']" .
chx:X_Mempool rd:hasIOExample chx:IO_Mempool .
chx:X_RecipientVerification a owl:NamedIndividual, chx:RecipientVerification ; rdfs:label "Bob's wallet recognising the payment"@en ; skos:definition "The receiver's wallet recognises an incoming payment because an output is redeemable by its keys, and checks what it can: well-formedness always, and valid unspent inputs only with a full node."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_RecipientVerification a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda outs, mine: [i for i, (amt, owner) in enumerate(outs) if owner == mine])([(20000, 'alice'), (75000, 'bob')], 'bob') evaluates to [1]"@en ; chx:input "(lambda outs, mine: [i for i, (amt, owner) in enumerate(outs) if owner == mine])([(20000, 'alice'), (75000, 'bob')], 'bob')" ; chx:output "[1]" .
chx:X_RecipientVerification rd:hasIOExample chx:IO_RecipientVerification .
chx:X_BlockExplorer a owl:NamedIndividual, chx:BlockExplorer ; rdfs:label "a web page showing Alice's transaction"@en ; skos:definition "A block explorer is a web application that works as a search engine for the blockchain, taking an address, a transaction identifier, a block number or a block hash and showing what it finds - and learning what you searched for."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_BlockExplorer a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda q: 'txid' if len(q) == 64 else 'address' if q.startswith('bc1') else 'height')('466200308696215bbc949d5141a49a4138ecdfdfaa2a8029c1f9bcecd1f96177') evaluates to 'txid'"@en ; chx:input "(lambda q: 'txid' if len(q) == 64 else 'address' if q.startswith('bc1') else 'height')('466200308696215bbc949d5141a49a4138ecdfdfaa2a8029c1f9bcecd1f96177')" ; chx:output "'txid'" .
chx:X_BlockExplorer rd:hasIOExample chx:IO_BlockExplorer .
chx:X_Miner a owl:NamedIndividual, chx:Miner ; rdfs:label "a node that searches for a valid block"@en ; skos:definition "A miner is a node that assembles candidate blocks and searches for a proof of work; it is paid by the new bitcoins of the block and the fees of the transactions it includes."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Miner a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda subsidy, fees: subsidy + fees)(625000000, 183000) evaluates to 625183000"@en ; chx:input "(lambda subsidy, fees: subsidy + fees)(625000000, 183000)" ; chx:output "625183000" .
chx:X_Miner rd:hasIOExample chx:IO_Miner .
chx:X_CandidateBlock a owl:NamedIndividual, chx:CandidateBlock ; rdfs:label "a block without a solution yet"@en ; skos:definition "A candidate block is a block that a miner has assembled from its memory pool and committed to the previous block, but which is not yet valid because it has no proof of work."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_CandidateBlock a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda pool, limit: (len(pool[:limit]), sum(pool[:limit])))([120, 150, 200, 90, 400], 3) evaluates to (3, 470)"@en ; chx:input "(lambda pool, limit: (len(pool[:limit]), sum(pool[:limit])))([120, 150, 200, 90, 400], 3)" ; chx:output "(3, 470)" .
chx:X_CandidateBlock rd:hasIOExample chx:IO_CandidateBlock .
chx:X_ProofOfWork a owl:NamedIndividual, chx:ProofOfWork ; rdfs:label "a header hash below the target"@en ; skos:definition "Proof of work is data that is expensive to produce and cheap to check: a block header whose hash is below the target proves that an enormous number of attempts was made."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_ProofOfWork a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda h: next(n for n in range(200000) if h(('1' + str(n) + 'Alice pays Bob 75000').encode()).hexdigest().startswith('0000')))(__import__('hashlib').sha256) evaluates to 6630"@en ; chx:input "(lambda h: next(n for n in range(200000) if h(('1' + str(n) + 'Alice pays Bob 75000').encode()).hexdigest().startswith('0000')))(__import__('hashlib').sha256)" ; chx:output "6630" .
chx:X_ProofOfWork rd:hasIOExample chx:IO_ProofOfWork .
chx:X_Block a owl:NamedIndividual, chx:Block ; rdfs:label "a header plus a list of transactions"@en ; skos:definition "A block is a container that aggregates transactions, made of an eighty-byte header and a list of transactions that may run to about four million bytes."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Block a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda header, body: (header, body // header))(80, 4000000) evaluates to (80, 50000)"@en ; chx:input "(lambda header, body: (header, body // header))(80, 4000000)" ; chx:output "(80, 50000)" .
chx:X_Block rd:hasIOExample chx:IO_Block .
chx:X_BlockHeader a owl:NamedIndividual, chx:BlockHeader ; rdfs:label "eighty bytes of metadata"@en ; skos:definition "The block header is the eighty bytes that a miner hashes: a version, the previous block's hash, the merkle root, a timestamp, the target and the nonce."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_BlockHeader a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d, s: d(s.pack('<I', 1) + bytes(32) + bytes.fromhex('4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b')[::-1] + s.pack('<III', 1231006505, 0x1d00ffff, 2083236893))[::-1].hex())(lambda b: __import__('hashlib').sha256(__import__('hashlib').sha256(b).digest()).digest(), __import__('struct')) evaluates to '000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f'"@en ; chx:input "(lambda d, s: d(s.pack('<I', 1) + bytes(32) + bytes.fromhex('4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b')[::-1] + s.pack('<III', 1231006505, 0x1d00ffff, 2083236893))[::-1].hex())(lambda b: __import__('hashlib').sha256(__import__('hashlib').sha256(b).digest()).digest(), __import__('struct'))" ; chx:output "'000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f'" .
chx:X_BlockHeader rd:hasIOExample chx:IO_BlockHeader .
chx:X_MerkleTree a owl:NamedIndividual, chx:MerkleTree ; rdfs:label "four transactions summarised in one hash"@en ; skos:definition "A merkle tree hashes data in pairs, and then the results in pairs, until a single hash remains, the merkle root; the block header holds the root, so eighty bytes commit to every transaction."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_MerkleTree a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (lambda L: d(d(L[0] + L[1]) + d(L[2] + L[3])).hex()[:16])([d(x) for x in (b'A', b'B', b'C', b'D')]))(lambda b: __import__('hashlib').sha256(__import__('hashlib').sha256(b).digest()).digest()) evaluates to '59e82c45a3662f55'"@en ; chx:input "(lambda d: (lambda L: d(d(L[0] + L[1]) + d(L[2] + L[3])).hex()[:16])([d(x) for x in (b'A', b'B', b'C', b'D')]))(lambda b: __import__('hashlib').sha256(__import__('hashlib').sha256(b).digest()).digest())" ; chx:output "'59e82c45a3662f55'" .
chx:X_MerkleTree rd:hasIOExample chx:IO_MerkleTree .
chx:X_Difficulty a owl:NamedIndividual, chx:Difficulty ; rdfs:label "the compact target 1d00ffff"@en ; skos:definition "The target is the threshold a block hash must fall below; difficulty is the inverse measure of it, adjusted every 2,016 blocks so that blocks keep arriving about every ten minutes."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Difficulty a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda bits: (bits >> 24, bits & 0xffffff, (bits & 0xffffff) * 2 ** (8 * ((bits >> 24) - 3)) == 0xffff * 2 ** 208))(0x1d00ffff) evaluates to (29, 65535, True)"@en ; chx:input "(lambda bits: (bits >> 24, bits & 0xffffff, (bits & 0xffffff) * 2 ** (8 * ((bits >> 24) - 3)) == 0xffff * 2 ** 208))(0x1d00ffff)" ; chx:output "(29, 65535, True)" .
chx:X_Difficulty rd:hasIOExample chx:IO_Difficulty .
chx:X_HashRate a owl:NamedIndividual, chx:HashRate ; rdfs:label "hashes per second across the network"@en ; skos:definition "The hash rate is the number of hash computations performed per second; dividing the attempts expected per block by six hundred seconds gives the rate the whole network is running at."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_HashRate a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda attempts, seconds: attempts // seconds)(168 * 10 ** 9 * 10 ** 12, 600) evaluates to 280000000000000000000"@en ; chx:input "(lambda attempts, seconds: attempts // seconds)(168 * 10 ** 9 * 10 ** 12, 600)" ; chx:output "280000000000000000000" .
chx:X_HashRate rd:hasIOExample chx:IO_HashRate .
chx:X_ConsensusRules a owl:NamedIndividual, chx:ConsensusRules ; rdfs:label "the checks every block must pass"@en ; skos:definition "The consensus rules are the validation rules that full nodes apply to blocks and transactions; a block that breaks one is rejected by everyone and its miner loses the reward."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_ConsensusRules a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda rules: (sum(rules.values()), all(rules.values())))({'pow_below_target': True, 'first_tx_is_coinbase': True, 'weight_within_limits': True, 'timestamp_in_range': True, 'all_txs_valid': True}) evaluates to (5, True)"@en ; chx:input "(lambda rules: (sum(rules.values()), all(rules.values())))({'pow_below_target': True, 'first_tx_is_coinbase': True, 'weight_within_limits': True, 'timestamp_in_range': True, 'all_txs_valid': True})" ; chx:output "(5, True)" .
chx:X_ConsensusRules rd:hasIOExample chx:IO_ConsensusRules .
chx:X_CoinbaseTransaction a owl:NamedIndividual, chx:CoinbaseTransaction ; rdfs:label "the first transaction of every block"@en ; skos:definition "The coinbase transaction is the first transaction in a block; it spends no earlier output and pays the miner the new bitcoins of the block plus the fees of the other transactions."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_CoinbaseTransaction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda inputs_spent, subsidy, fees: (inputs_spent, subsidy + fees))(0, 625000000, 183000) evaluates to (0, 625183000)"@en ; chx:input "(lambda inputs_spent, subsidy, fees: (inputs_spent, subsidy + fees))(0, 625000000, 183000)" ; chx:output "(0, 625183000)" .
chx:X_CoinbaseTransaction rd:hasIOExample chx:IO_CoinbaseTransaction .
chx:X_BlockReward a owl:NamedIndividual, chx:BlockReward ; rdfs:label "6.25 bitcoins in 2023, 3.125 after 2024"@en ; skos:definition "The reward is the subsidy of new bitcoins plus the fees; the subsidy starts at 50 bitcoins and halves every 210,000 blocks, so the total ever issued is just under 21 million."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_BlockReward a owl:NamedIndividual, rd:IOExample ; rdfs:label "(50 * 10 ** 8) >> 3 evaluates to 625000000"@en ; chx:input "(50 * 10 ** 8) >> 3" ; chx:output "625000000" .
chx:X_BlockReward rd:hasIOExample chx:IO_BlockReward .
chx:X_MiningPool a owl:NamedIndividual, chx:MiningPool ; rdfs:label "many small miners sharing one reward"@en ; skos:definition "A mining pool combines the hash rate of many miners, measures each one's contribution with an easier target, and shares the reward in proportion to the shares earned."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_MiningPool a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda shares, reward: {m: reward * s // sum(shares.values()) for m, s in shares.items()})({'a': 50, 'b': 30, 'c': 20}, 625000000) evaluates to {'a': 312500000, 'b': 187500000, 'c': 125000000}"@en ; chx:input "(lambda shares, reward: {m: reward * s // sum(shares.values()) for m, s in shares.items()})({'a': 50, 'b': 30, 'c': 20}, 625000000)" ; chx:output "{'a': 312500000, 'b': 187500000, 'c': 125000000}" .
chx:X_MiningPool rd:hasIOExample chx:IO_MiningPool .
chx:X_SudokuAnalogy a owl:NamedIndividual, chx:SudokuAnalogy ; rdfs:label "mining as a giant competitive sudoku"@en ; skos:definition "An analogy from the course notes: mining is like a huge sudoku that is hard to solve, quick to check, adjustable in size, and restarted whenever somebody finds a solution."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_SudokuAnalogy a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda cells, bitcoin_attempts: (cells, bitcoin_attempts > cells))(81, 168 * 10 ** 9 * 10 ** 12) evaluates to (81, True)"@en ; chx:input "(lambda cells, bitcoin_attempts: (cells, bitcoin_attempts > cells))(81, 168 * 10 ** 9 * 10 ** 12)" ; chx:output "(81, True)" .
chx:X_SudokuAnalogy rd:hasIOExample chx:IO_SudokuAnalogy .
chx:X_RuleChange a owl:NamedIndividual, chx:RuleChange ; rdfs:label "segregated witness, deployed as a soft fork"@en ; skos:definition "A soft fork is a change that only narrows what is valid, so unupgraded nodes stay in consensus; a hard fork widens what is valid and is not compatible with older nodes."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_RuleChange a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda old_valid, new_valid: ('soft fork' if new_valid <= old_valid else 'hard fork'))({'a', 'b', 'c'}, {'a', 'b'}) evaluates to 'soft fork'"@en ; chx:input "(lambda old_valid, new_valid: ('soft fork' if new_valid <= old_valid else 'hard fork'))({'a', 'b', 'c'}, {'a', 'b'})" ; chx:output "'soft fork'" .
chx:X_RuleChange rd:hasIOExample chx:IO_RuleChange .
chx:X_Confirmation a owl:NamedIndividual, chx:Confirmation ; rdfs:label "one block on top is one confirmation"@en ; skos:definition "A transaction has one confirmation when it is in a block, and one more for each block built on top; reversing it means redoing all of them and one more."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Confirmation a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda depth: depth + 1)(2) evaluates to 3"@en ; chx:input "(lambda depth: depth + 1)(2)" ; chx:output "3" .
chx:X_Confirmation rd:hasIOExample chx:IO_Confirmation .
chx:X_Probability a owl:NamedIndividual, chx:Probability ; rdfs:label "about two chances in ten thousand after six blocks"@en ; skos:definition "The chance that an attacker with a minority of the hash rate catches up from behind falls very fast with each confirmation, which is what makes confirmations worth counting."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Probability a owl:NamedIndividual, rd:IOExample ; rdfs:label "round((0.1 / 0.9) ** 6, 9) evaluates to 1.882e-06"@en ; chx:input "round((0.1 / 0.9) ** 6, 9)" ; chx:output "1.882e-06" .
chx:X_Probability rd:hasIOExample chx:IO_Probability .
chx:X_BestBlockchain a owl:NamedIndividual, chx:BestBlockchain ; rdfs:label "the chain with the most total work"@en ; skos:definition "When several valid chains exist, every node independently chooses the one with the most cumulative proof of work; that chain is the record."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_BestBlockchain a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda chains: max(chains, key=lambda c: sum(chains[c])))({'A': [100, 100, 100], 'B': [100, 100, 120]}) evaluates to 'B'"@en ; chx:input "(lambda chains: max(chains, key=lambda c: sum(chains[c])))({'A': [100, 100, 100], 'B': [100, 100, 120]})" ; chx:output "'B'" .
chx:X_BestBlockchain rd:hasIOExample chx:IO_BestBlockchain .
chx:X_BlockHeight a owl:NamedIndividual, chx:BlockHeight ; rdfs:label "the genesis block is height 0"@en ; skos:definition "The height of a block is its distance from the first block; heights are how blocks are counted, but a height does not always name a single block."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_BlockHeight a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda genesis, added: genesis + added)(0, 800000) evaluates to 800000"@en ; chx:input "(lambda genesis, added: genesis + added)(0, 800000)" ; chx:output "800000" .
chx:X_BlockHeight rd:hasIOExample chx:IO_BlockHeight .
chx:X_AlternativeBlock a owl:NamedIndividual, chx:AlternativeBlock ; rdfs:label "two blocks claiming the same height"@en ; skos:definition "An accidental fork occurs when two valid blocks appear at the same height; it is normally resolved by the next block, and a deliberate alternative block is what a reversal would require."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_AlternativeBlock a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a, b: ('fork' if a == b else 'extends', max(a, b) + 1))(5, 5) evaluates to ('fork', 6)"@en ; chx:input "(lambda a, b: ('fork' if a == b else 'extends', max(a, b) + 1))(5, 5)" ; chx:output "('fork', 6)" .
chx:X_AlternativeBlock rd:hasIOExample chx:IO_AlternativeBlock .
chx:X_DoubleSpend a owl:NamedIndividual, chx:DoubleSpend ; rdfs:label "spending the same output twice"@en ; skos:definition "A double spend is the attempt to spend one output in two transactions; nodes reject the second, and the blockchain's order is what makes the rejection unambiguous."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_DoubleSpend a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spent, tx: 'reject' if tx['input'] in spent else 'accept')({'4ac54180:1'}, {'input': '4ac54180:1'}) evaluates to 'reject'"@en ; chx:input "(lambda spent, tx: 'reject' if tx['input'] in spent else 'accept')({'4ac54180:1'}, {'input': '4ac54180:1'})" ; chx:output "'reject'" .
chx:X_DoubleSpend rd:hasIOExample chx:IO_DoubleSpend .
chx:X_GenesisBlock a owl:NamedIndividual, chx:GenesisBlock ; rdfs:label "block number 0, mined in January 2009"@en ; skos:definition "The genesis block is the first block, height 0, with no parent; it is built into the software, so every node starts from the same trusted root."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_GenesisBlock a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('datetime').datetime.fromtimestamp(1231006505, __import__('datetime').timezone.utc).date().isoformat() evaluates to '2009-01-03'"@en ; chx:input "__import__('datetime').datetime.fromtimestamp(1231006505, __import__('datetime').timezone.utc).date().isoformat()" ; chx:output "'2009-01-03'" .
chx:X_GenesisBlock rd:hasIOExample chx:IO_GenesisBlock .
chx:X_UnconfirmedTransaction a owl:NamedIndividual, chx:UnconfirmedTransaction ; rdfs:label "a payment seen by everyone and recorded by nobody"@en ; skos:definition "An unconfirmed transaction has propagated and been verified but is in no block; blocks arrive about every ten minutes on average, which is not a timetable."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_UnconfirmedTransaction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda avg, blocks: avg * blocks)(10, 6) evaluates to 60"@en ; chx:input "(lambda avg, blocks: avg * blocks)(10, 6)" ; chx:output "60" .
chx:X_UnconfirmedTransaction rd:hasIOExample chx:IO_UnconfirmedTransaction .
chx:X_SmallPaymentAcceptance a owl:NamedIndividual, chx:SmallPaymentAcceptance ; rdfs:label "selling a coffee without waiting"@en ; skos:definition "A merchant may accept a small payment with no confirmation because the loss if it is reversed is smaller than the cost of making the customer wait; the threshold is a business decision."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_SmallPaymentAcceptance a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda value, threshold: 'accept now' if value < threshold else 'wait for confirmations')(5, 25) evaluates to 'accept now'"@en ; chx:input "(lambda value, threshold: 'accept now' if value < threshold else 'wait for confirmations')(5, 25)" ; chx:output "'accept now'" .
chx:X_SmallPaymentAcceptance rd:hasIOExample chx:IO_SmallPaymentAcceptance .
chx:X_SpendingOnward a owl:NamedIndividual, chx:SpendingOnward ; rdfs:label "Bob paying Gopesh from Alice's payment"@en ; skos:definition "Once recorded, an output can be spent by its owner in a new transaction, which extends the chain; Bob's payment of 67,000 satoshis out of Alice's 75,000 leaves a fee of 8,000."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_SpendingOnward a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda received, paid: (received - paid, received - paid == 8000))(75000, 67000) evaluates to (8000, True)"@en ; chx:input "(lambda received, paid: (received - paid, received - paid == 8000))(75000, 67000)" ; chx:output "(8000, True)" .
chx:X_SpendingOnward rd:hasIOExample chx:IO_SpendingOnward .
chx:X_PaymentVerification a owl:NamedIndividual, chx:PaymentVerification ; rdfs:label "checking inclusion with a short path of hashes"@en ; skos:definition "A lightweight client confirms that a transaction is in a block and that blocks were mined after it, using a merkle path of about log2(N) hashes instead of the whole block."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_PaymentVerification a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda n: __import__('math').ceil(__import__('math').log2(n)) * 32)(16000) evaluates to 448"@en ; chx:input "(lambda n: __import__('math').ceil(__import__('math').log2(n)) * 32)(16000)" ; chx:output "448" .
chx:X_PaymentVerification rd:hasIOExample chx:IO_PaymentVerification .
chx:X_Ontology a owl:NamedIndividual, chx:Ontology ; rdfs:label "the concept list of this chapter"@en ; skos:definition "An ontology is an explicit, machine-readable description of the concepts of a domain, their hierarchy and their relations, against which questions can be asked and answers checked."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Ontology a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda classes, parents: (len(classes), sum(1 for c in classes if parents.get(c) is None)))(['Transaction', 'Input', 'Output', 'Network'], {'Transaction': None, 'Input': 'Transaction', 'Output': 'Transaction', 'Network': None}) evaluates to (4, 2)"@en ; chx:input "(lambda classes, parents: (len(classes), sum(1 for c in classes if parents.get(c) is None)))(['Transaction', 'Input', 'Output', 'Network'], {'Transaction': None, 'Input': 'Transaction', 'Output': 'Transaction', 'Network': None})" ; chx:output "(4, 2)" .
chx:X_Ontology rd:hasIOExample chx:IO_Ontology .
chx:X_Triple a owl:NamedIndividual, chx:Triple ; rdfs:label "Alice's transaction used Joe's output"@en ; skos:definition "A triple is a statement of the form subject, predicate, object; a set of triples forms a graph whose nodes are the things and whose edges are the statements."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_Triple a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda triples: (len(triples), len({s for s, p, o in triples} | {o for s, p, o in triples})))([('Tx2', 'used', 'Tx1:0'), ('Tx2:1', 'wasGeneratedBy', 'Tx2'), ('Tx2', 'wasAttributedTo', 'Alice')]) evaluates to (3, 4)"@en ; chx:input "(lambda triples: (len(triples), len({s for s, p, o in triples} | {o for s, p, o in triples})))([('Tx2', 'used', 'Tx1:0'), ('Tx2:1', 'wasGeneratedBy', 'Tx2'), ('Tx2', 'wasAttributedTo', 'Alice')])" ; chx:output "(3, 4)" .
chx:X_Triple rd:hasIOExample chx:IO_Triple .
chx:X_ProvenanceGraph a owl:NamedIndividual, chx:ProvenanceGraph ; rdfs:label "the chain from Joe to Gopesh as a graph"@en ; skos:definition "The chapter's transaction chain is a provenance graph: outputs are entities derived from earlier entities, transactions are the activities that derive them, and key holders are the agents responsible."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_ProvenanceGraph a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda chain: [(b, 'wasDerivedFrom', a) for a, b in zip(chain, chain[1:])])(['Tx1:0', 'Tx2:1', 'Tx3:0']) evaluates to [('Tx2:1', 'wasDerivedFrom', 'Tx1:0'), ('Tx3:0', 'wasDerivedFrom', 'Tx2:1')]"@en ; chx:input "(lambda chain: [(b, 'wasDerivedFrom', a) for a, b in zip(chain, chain[1:])])(['Tx1:0', 'Tx2:1', 'Tx3:0'])" ; chx:output "[('Tx2:1', 'wasDerivedFrom', 'Tx1:0'), ('Tx3:0', 'wasDerivedFrom', 'Tx2:1')]" .
chx:X_ProvenanceGraph rd:hasIOExample chx:IO_ProvenanceGraph .
chx:X_HashDemo a owl:NamedIndividual, chx:HashDemo ; rdfs:label "a digest that changes as you type"@en ; skos:definition "The first page of the demonstration shows a data box and its SHA-256 digest, recomputed at every keystroke, so the unpredictability and the fixed length of a hash can be seen."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_HashDemo a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hashlib').sha256(b'Alice pays Bob 75000').hexdigest()[:16] evaluates to '320a22eeeb9c0391'"@en ; chx:input "__import__('hashlib').sha256(b'Alice pays Bob 75000').hexdigest()[:16]" ; chx:output "'320a22eeeb9c0391'" .
chx:X_HashDemo rd:hasIOExample chx:IO_HashDemo .
chx:X_BlockDemo a owl:NamedIndividual, chx:BlockDemo ; rdfs:label "a nonce searched until four zeros appear"@en ; skos:definition "The second page adds a block number, a nonce and a Mine button, so that the asymmetry of proof of work can be felt: a search of thousands of attempts, then an instant check."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_BlockDemo a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda h: next(n for n in range(500000) if h(('1' + str(n) + 'Alice pays Bob 75000').encode()).hexdigest().startswith('0000')))(__import__('hashlib').sha256) evaluates to 6630"@en ; chx:input "(lambda h: next(n for n in range(500000) if h(('1' + str(n) + 'Alice pays Bob 75000').encode()).hexdigest().startswith('0000')))(__import__('hashlib').sha256)" ; chx:output "6630" .
chx:X_BlockDemo rd:hasIOExample chx:IO_BlockDemo .
chx:X_BlockchainDemo a owl:NamedIndividual, chx:BlockchainDemo ; rdfs:label "changing block 2 reddens blocks 2 to 5"@en ; skos:definition "The third page links five blocks by a previous-hash field, so that editing an early block invalidates it and every block after it until each is mined again."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_BlockchainDemo a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda chain, edited: [i for i in range(len(chain)) if i >= edited])(['b1', 'b2', 'b3', 'b4', 'b5'], 1) evaluates to [1, 2, 3, 4]"@en ; chx:input "(lambda chain, edited: [i for i in range(len(chain)) if i >= edited])(['b1', 'b2', 'b3', 'b4', 'b5'], 1)" ; chx:output "[1, 2, 3, 4]" .
chx:X_BlockchainDemo rd:hasIOExample chx:IO_BlockchainDemo .
chx:X_DistributedDemo a owl:NamedIndividual, chx:DistributedDemo ; rdfs:label "three peers with their own chains"@en ; skos:definition "The fourth page gives three peers, A, B and C, each a full copy of the five-block chain, so a reader can tamper with one peer and see that the others disagree with it."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_DistributedDemo a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda peers: (len(peers), len(set(peers.values())) == 1))({'A': 'h5', 'B': 'h5', 'C': 'h5x'}) evaluates to (3, False)"@en ; chx:input "(lambda peers: (len(peers), len(set(peers.values())) == 1))({'A': 'h5', 'B': 'h5', 'C': 'h5x'})" ; chx:output "(3, False)" .
chx:X_DistributedDemo rd:hasIOExample chx:IO_DistributedDemo .
chx:X_CoinbaseDemo a owl:NamedIndividual, chx:CoinbaseDemo ; rdfs:label "a block reward and transactions in each block"@en ; skos:definition "The last page adds a coinbase line and transaction rows to every block of every peer, so that a chain of hashes becomes a ledger whose balances can be read off."@en ; dcterms:source <http://example.org/sen0401/ch02/research> .
chx:IO_CoinbaseDemo a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda coinbase, txs: coinbase - sum(amount for _, _, amount in txs))(100, [('A', 'B', 30), ('A', 'C', 20)]) evaluates to 50"@en ; chx:input "(lambda coinbase, txs: coinbase - sum(amount for _, _, amount in txs))(100, [('A', 'B', 30), ('A', 'C', 20)])" ; chx:output "50" .
chx:X_CoinbaseDemo rd:hasIOExample chx:IO_CoinbaseDemo .
