chx:Err_HexadecimalNotation a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "bytes.fromhex('abc') raises ValueError: fromhex() arg must contain an even number of hexadecimal digits"@en .
chx:X_HexadecimalNotation rd:hasErrorCondition chx:Err_HexadecimalNotation .
chx:Err_HashFunction a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('hashlib').sha256('abc') raises TypeError: Strings must be encoded before hashing"@en .
chx:X_HashFunction rd:hasErrorCondition chx:Err_HashFunction .
chx:Err_Serialization a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(2 ** 64).to_bytes(8, 'little') raises OverflowError: int too big to convert"@en .
chx:X_Serialization rd:hasErrorCondition chx:Err_Serialization .
chx:Err_Satoshi a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('decimal').Decimal('0.5') + 0.5 raises TypeError: unsupported operand type(s) for +: 'decimal.Decimal' and 'float'"@en .
chx:X_Satoshi rd:hasErrorCondition chx:Err_Satoshi .
chx:Err_Output a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "[20000, 75000][2] raises IndexError: list index out of range"@en .
chx:X_Output rd:hasErrorCondition chx:Err_Output .
chx:Err_BitsAndBytes a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(256).to_bytes(1, 'little') raises OverflowError: int too big to convert"@en .
chx:X_BitsAndBytes rd:hasErrorCondition chx:Err_BitsAndBytes .
chx:Err_Outpoint a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "{'4ac54180:1': 100000}['4ac54180:0'] raises KeyError: '4ac54180:0'"@en .
chx:X_Outpoint rd:hasErrorCondition chx:Err_Outpoint .
chx:Err_Difficulty a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "1 / 0 raises ZeroDivisionError: division by zero"@en .
chx:X_Difficulty rd:hasErrorCondition chx:Err_Difficulty .

chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 2 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch02/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 2 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2, chx:CQ3, chx:CQ4, chx:CQ5, chx:CQ6, chx:CQ7, chx:CQ8 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which parts does a Bitcoin transaction consist of, what does each part contribute, and what are the values of each part in the real transaction that chapter 2 follows?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which mathematical tools does a transaction rely on - hashing, key pairs, the elliptic curve, signatures, checksums - and what exactly does each of them guarantee and not guarantee?"@en .
chx:CQ3 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How does a payment begin: what does the invoice of the chapter contain, which document defines its format, and what is the status of that document today?"@en .
chx:CQ4 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How does a signed transaction reach the miners, who takes part in that journey, and how much of a payment can each kind of participant verify for itself?"@en .
chx:CQ5 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How is a transaction recorded: how is a block built, what makes it valid, how is the miner paid, and how are the numbers of the reward, the target and the hash rate obtained?"@en .
chx:CQ6 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What exactly does a confirmation buy, how fast does the probability of reversal fall, and when may a merchant accept a payment that has none?"@en .
chx:CQ7 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How can the chapter's transaction chain be expressed as a provenance graph in the vocabulary of the W3C PROV Ontology, and what does that model leave out?"@en .
chx:CQ8 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which terms do the explanations of this chapter rely on, and is each of them a concept of this chapter or of chapter 1?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 2 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 2 through the Stage 1 research record; the explanations were rewritten for version 1.2.0 from the documents listed at the head of this module, each read in the session of 2026-10-04, with every quotation re-read from the saved copy of its source and every number, hash, address, encoding and size recomputed by a claim that the chapter builder executes; the supporting concepts (bits and bytes, hexadecimal notation, entropy, the nonce, encryption, serialization, byte order, the outpoint, the witness, the address, the exchange rate, the wallet, the participants and the stages of propagation, and the whole mining and security vocabulary of the blockchain branch) were added because an audit of the terms used in the explanations found them used without a concept of their own in this chapter or in chapter 1."@en ;
    dcterms:source <http://example.org/sen0401/ch02/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (375 checks listed in sen0401_ch02_corpus_v1_3_0.py), executed under CPython 3.14.4."@en ;
    dcterms:source "The execution run of this ontology's build, 08-tooling/sen0401_chapter_build_v1_0_1.py, over the claims in 08-tooling/sen0401_ch02_corpus_v1_3_0.py" .

