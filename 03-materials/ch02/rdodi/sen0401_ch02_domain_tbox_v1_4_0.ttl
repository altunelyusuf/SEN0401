chx:hasOwner a owl:ObjectProperty ; rdfs:label "owned by"@en ; rdfs:subPropertyOf rd:hasOwningConcept ;
    rdfs:comment "A concept owned by the concept it belongs to, as the chapter's examples use it between typed things; domain and range are the union of every type the A-Box shows on the two sides (BP-D57 step 3)."@en ;
    rdfs:domain [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> owl:Class ; owl:unionOf ( chx:Address chx:BlockHeader chx:BlockHeight chx:BlockReward chx:ByteOrder chx:Checksum chx:CoinbaseTransaction chx:Difficulty chx:EllipticCurve chx:Entropy chx:FeeRate chx:Gossiping chx:HashRate chx:Mempool chx:MerkleTree chx:Nonce chx:Outpoint chx:Probability chx:ProvenanceGraph chx:QrCode chx:Satoshi chx:Script chx:Serialization chx:Transmission chx:Triple chx:Uri chx:Witness ) ] ;
    rdfs:range [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> owl:Class ; owl:unionOf ( chx:Address chx:Bip21Uri chx:Block chx:BlockHeader chx:CoinbaseTransaction chx:Confirmation chx:DigitalSignature chx:FullNode chx:Input chx:KeyPair chx:Ontology chx:Output chx:ProofOfWork chx:TransactionFee chx:TransactionIdentifier chx:TransactionPropagation chx:TransactionSize ) ] ;
    rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .

#################################################################
# Connectedness repair (discipline v2.19.0, BP-D56 and BP-D57), 2026-10-19.
# The datatype properties the A-Box uses and nothing declared, then the relations
# between the chapter's subject branches that the chapter's own sources state.
#################################################################
chx:input a owl:DatatypeProperty ; rdfs:label "input expression"@en ; rdfs:comment "The expression an input/output example evaluates."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:output a owl:DatatypeProperty ; rdfs:label "output value"@en ; rdfs:comment "The value that evaluating the example expression gives."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:aggregatesTransactions a owl:ObjectProperty ; rdfs:label "aggregates"@en ;
    rdfs:comment "A block aggregates transactions. Basis: the chapter says of Block: 'A block is a container that aggregates transactions'."@en ;
    rdfs:domain chx:Block ; rdfs:range chx:Transaction ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:includesFees a owl:ObjectProperty ; rdfs:label "includes the fees"@en ;
    rdfs:comment "The block reward is the subsidy plus the transaction fees. Basis: the chapter says of Block reward: 'The reward is the subsidy of new bitcoins plus the fees'."@en ;
    rdfs:domain chx:BlockReward ; rdfs:range chx:TransactionFee ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:isConfirmedBy a owl:ObjectProperty ; rdfs:label "is confirmed by"@en ;
    rdfs:comment "A transaction gains a confirmation when it is in a block and one more for each block built on it. Basis: the chapter says of Confirmation: 'A transaction has one confirmation when it is in a block, and one more for each block built on top'."@en ;
    rdfs:domain chx:Transaction ; rdfs:range chx:Confirmation ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:spendsOutputTwice a owl:ObjectProperty ; rdfs:label "tries to spend twice"@en ;
    rdfs:comment "A double spend is the attempt to spend one output in two transactions. Basis: the chapter says of Double spend: 'A double spend is the attempt to spend one output in two transactions'."@en ;
    rdfs:domain chx:DoubleSpend ; rdfs:range chx:Output ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:holdsMerkleRoot a owl:ObjectProperty ; rdfs:label "holds the root of"@en ;
    rdfs:comment "The block header holds the merkle root. Basis: the chapter says of Merkle tree: 'the block header holds the root'."@en ;
    rdfs:domain chx:BlockHeader ; rdfs:range chx:MerkleTree ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:verifiesBy a owl:ObjectProperty ; rdfs:label "verifies by"@en ;
    rdfs:comment "A lightweight client verifies a payment by simplified payment verification. Basis: the chapter says of Lightweight client: 'so it verifies a payment only partly; this is simplified payment verification'."@en ;
    rdfs:domain chx:LightweightClient ; rdfs:range chx:PaymentVerification ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:buildsFromMempool a owl:ObjectProperty ; rdfs:label "is built from"@en ;
    rdfs:comment "Miners build candidate blocks from the memory pool. Basis: the chapter says of Memory pool: 'miners build candidate blocks from it'."@en ;
    rdfs:domain chx:CandidateBlock ; rdfs:range chx:Mempool ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:holdsUnconfirmed a owl:ObjectProperty ; rdfs:label "holds"@en ;
    rdfs:comment "The memory pool holds the verified but unconfirmed transactions. Basis: the chapter says of Memory pool: 'The memory pool is the list of verified but unconfirmed transactions that a node keeps in memory'."@en ;
    rdfs:domain chx:Mempool ; rdfs:range chx:UnconfirmedTransaction ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:propagatesTransaction a owl:ObjectProperty ; rdfs:label "spreads"@en ;
    rdfs:comment "Propagation is the spread of a signed transaction across the network. Basis: the chapter says of Transaction propagation: 'Transaction propagation is the spread of a signed transaction across the network by gossip'."@en ;
    rdfs:domain chx:TransactionPropagation ; rdfs:range chx:Transaction ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:keepsUtxoSet a owl:ObjectProperty ; rdfs:label "keeps the set of"@en ;
    rdfs:comment "Full nodes keep the set of all unspent outputs. Basis: the chapter says of Unspent transaction output: 'full nodes keep the set of all of them'."@en ;
    rdfs:domain chx:FullNode ; rdfs:range chx:UnspentOutput ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:showsHash a owl:ObjectProperty ; rdfs:label "shows"@en ;
    rdfs:comment "The first demonstration page shows a hash recomputed at every keystroke. Basis: the chapter says of Hash page: 'shows a data box and its SHA-256 digest, recomputed at every keystroke'."@en ;
    rdfs:domain chx:HashDemo ; rdfs:range chx:HashFunction ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:showsProofOfWork a owl:ObjectProperty ; rdfs:label "shows"@en ;
    rdfs:comment "The second demonstration page lets the reader feel the asymmetry of proof of work. Basis: the chapter says of Block page: 'so that the asymmetry of proof of work can be felt'."@en ;
    rdfs:domain chx:BlockDemo ; rdfs:range chx:ProofOfWork ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:showsBlockLinking a owl:ObjectProperty ; rdfs:label "shows"@en ;
    rdfs:comment "The third demonstration page links blocks by a previous-hash field. Basis: the chapter says of Blockchain page: 'links five blocks by a previous-hash field'."@en ;
    rdfs:domain chx:BlockchainDemo ; rdfs:range chx:Blockchain ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:showsPeers a owl:ObjectProperty ; rdfs:label "shows"@en ;
    rdfs:comment "The fourth demonstration page gives three peers each a full copy of the chain. Basis: the chapter says of Distributed page: 'gives three peers, A, B and C, each a full copy of the five-block chain'."@en ;
    rdfs:domain chx:DistributedDemo ; rdfs:range chx:PeerToPeerNetwork ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:showsCoinbase a owl:ObjectProperty ; rdfs:label "shows"@en ;
    rdfs:comment "The last demonstration page adds a coinbase line to every block. Basis: the chapter says of Coinbase page: 'adds a coinbase line and transaction rows to every block of every peer'."@en ;
    rdfs:domain chx:CoinbaseDemo ; rdfs:range chx:CoinbaseTransaction ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
chx:describesTransactionChain a owl:ObjectProperty ; rdfs:label "describes"@en ;
    rdfs:comment "The chapter's transaction chain is a provenance graph. Basis: the chapter says of Provenance graph: 'The chapter's transaction chain is a provenance graph'."@en ;
    rdfs:domain chx:ProvenanceGraph ; rdfs:range chx:TransactionChain ; rdfs:isDefinedBy <http://example.org/sen0401/ch02/tbox> .
