    skos:definition "The page puts the chapter explorer at the left, the main area in the centre and a detail card at the right that stays closed until the reader asks for a detail."@en .

pg:Main a ipo:MainContent,
        owl:NamedIndividual ;
    rdfs:label "Main area"@en ;
    dcterms:source <http://example.org/sen0401/ch02/document> ;
    skos:definition "The main area shows the chapter content of the selected menu item, with the widgets of its sections inline."@en .

pg:Q1_O1 a ld:AnswerOption ;
    rdfs:label "A rounding error"@en .

pg:Q1_O2 a ld:AnswerOption ;
    rdfs:label "Change returned to the payer"@en .

pg:Q2_O1 a ld:AnswerOption ;
    rdfs:label "20 bitcoins"@en .

pg:Q2_O2 a ld:AnswerOption ;
    rdfs:label "5 bitcoins"@en .

pg:Q3_O1 a ld:AnswerOption ;
    rdfs:label "As soon as the wallet signs it"@en .

pg:Q3_O2 a ld:AnswerOption ;
    rdfs:label "When a block explorer shows it"@en .

pg:Q4_O1 a ld:AnswerOption ;
    rdfs:label "0.2"@en .

pg:Q4_O2 a ld:AnswerOption ;
    rdfs:label "0.05"@en .

pg:Q5_O1 a ld:AnswerOption ;
    rdfs:label "An agent"@en .

pg:Q5_O2 a ld:AnswerOption ;
    rdfs:label "A web page"@en .

pg:SectionTree a ipo:TreeNavigation,
        owl:NamedIndividual ;
    rdfs:label "Section tree"@en ;
    dcterms:source <http://example.org/sen0401/ch02/document> ;
    skos:definition "The section tree lists the sections of the chapter by their three levels, and choosing one opens that single section."@en .

pg:Sidebar a ipo:Sidebar,
        owl:NamedIndividual ;
    rdfs:label "Chapter explorer"@en ;
    dcterms:source <http://example.org/sen0401/ch02/document> ;
    skos:definition "The explorer at the left shows the chapter's sections as a tree and keeps pace with the tabs of the main area."@en .

pg:SourceDocument a ipo:SourceDocument,
        owl:NamedIndividual ;
    rdfs:label "Chapter 2 Stage 3 document"@en ;
    ipo:hasLearningObjective pg:CO1,
        pg:CO2,
        pg:CO3,
        pg:CO4 ;
    dcterms:source <http://example.org/sen0401/ch02/document> ;
    skos:definition "The Stage 3 document of chapter 2 is the text this page renders, section for section."@en .

pg:TopMenu a ipo:PrimaryNavigation,
        owl:NamedIndividual ;
    rdfs:label "Main menu"@en ;
    dcterms:source <http://example.org/sen0401/ch02/document> ;
    skos:definition "The main menu is permanently visible at the top and lets the reader reach every top-level area without scrolling or opening anything first."@en .

pg:Q1_O0 a ld:AnswerOption ;
    rdfs:label "The transaction fee, collected by the miner"@en .

pg:Q2_O0 a ld:AnswerOption ;
    rdfs:label "15 bitcoins"@en .

pg:Q3_O0 a ld:AnswerOption ;
    rdfs:label "When a miner includes it in a block that full nodes validate"@en .

pg:Q4_O0 a ld:AnswerOption ;
    rdfs:label "0.0002"@en .

pg:Q5_O0 a ld:AnswerOption ;
    rdfs:label "An activity that derives new outputs from earlier ones"@en .

pg:S_Address a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bitcoin address"@en ;
    sen0401:anchor "#Address" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Address> ;
    skos:definition "A Bitcoin address is a short string, carrying a checksum, that encodes the condition under which a payment may later be spent; it is what a payer is given and what a wallet turns into an output script."@en .

pg:S_AlternativeBlock a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Fork and alternative block"@en ;
    sen0401:anchor "#AlternativeBlock" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_AlternativeBlock> ;
    skos:definition "An accidental fork occurs when two valid blocks appear at the same height; it is normally resolved by the next block, and a deliberate alternative block is what a reversal would require."@en .

pg:S_BestBlockchain a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Best blockchain"@en ;
    sen0401:anchor "#BestBlockchain" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_BestBlockchain> ;
    skos:definition "When several valid chains exist, every node independently chooses the one with the most cumulative proof of work; that chain is the record."@en .

pg:S_Bip a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bitcoin improvement proposal"@en ;
    sen0401:anchor "#Bip" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Bip> ;
    skos:definition "A BIP is a design document that proposes or describes a feature of Bitcoin; standards, informational and process proposals are kept as numbered text files in a public repository."@en .

pg:S_Bip21Uri a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "BIP21 URI"@en ;
    sen0401:anchor "#Bip21Uri" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Bip21Uri> ;
    skos:definition "A BIP21 URI carrying the address, amount, label and message, which the wallet reads so the payer never types an address."@en .

pg:S_BitsAndBytes a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Bit and byte"@en ;
    sen0401:anchor "#BitsAndBytes" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_BitsAndBytes> ;
    skos:definition "A bit is one binary digit; eight bits make a byte. Sizes in Bitcoin are quoted in both, and 32 bytes are 256 bits."@en .

pg:S_Block a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block"@en ;
    sen0401:anchor "#Block" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Block> ;
    skos:definition "A block is a container that aggregates transactions, made of an eighty-byte header and a list of transactions that may run to about four million bytes."@en .

pg:S_BlockDemo a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block page"@en ;
    sen0401:anchor "#BlockDemo" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_BlockDemo> ;
    skos:definition "The second page adds a block number, a nonce and a Mine button, so that the asymmetry of proof of work can be felt: a search of thousands of attempts, then an instant check."@en .

pg:S_BlockExplorer a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block explorer"@en ;
    sen0401:anchor "#BlockExplorer" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_BlockExplorer> ;
    skos:definition "A block explorer is a web application that works as a search engine for the blockchain, taking an address, a transaction identifier, a block number or a block hash and showing what it finds - and learning what you searched for."@en .

pg:S_BlockHeader a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block header"@en ;
    sen0401:anchor "#BlockHeader" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_BlockHeader> ;
    skos:definition "The block header is the eighty bytes that a miner hashes: a version, the previous block's hash, the merkle root, a timestamp, the target and the nonce."@en .

pg:S_BlockHeight a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block height"@en ;
    sen0401:anchor "#BlockHeight" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_BlockHeight> ;
    skos:definition "The height of a block is its distance from the first block; heights are how blocks are counted, but a height does not always name a single block."@en .

pg:S_BlockReward a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block reward"@en ;
    sen0401:anchor "#BlockReward" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_BlockReward> ;
    skos:definition "The reward is the subsidy of new bitcoins plus the fees; the subsidy starts at 50 bitcoins and halves every 210,000 blocks, so the total ever issued is just under 21 million."@en .

pg:S_Blockchain a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Blockchain"@en ;
    sen0401:anchor "#Blockchain" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Blockchain> ;
    skos:definition "The blockchain is the record in which Bitcoin's transactions are finally written down."@en .

pg:S_BlockchainDemo a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Blockchain page"@en ;
    sen0401:anchor "#BlockchainDemo" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_BlockchainDemo> ;
    skos:definition "The third page links five blocks by a previous-hash field, so that editing an early block invalidates it and every block after it until each is mined again."@en .

pg:S_ByteOrder a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Byte order"@en ;
    sen0401:anchor "#ByteOrder" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_ByteOrder> ;
    skos:definition "Byte order is the direction in which the bytes of a value are written; Bitcoin displays hashes in one direction and stores them in the other, so the same value looks like two."@en .

pg:S_CandidateBlock a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Candidate block"@en ;
    sen0401:anchor "#CandidateBlock" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_CandidateBlock> ;
    skos:definition "A candidate block is a block that a miner has assembled from its memory pool and committed to the previous block, but which is not yet valid because it has no proof of work."@en .

pg:S_Checksum a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Checksum"@en ;
    sen0401:anchor "#Checksum" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Checksum> ;
    skos:definition "A checksum is a short value derived from data and appended to it so that a transcription or typing error can be detected; Bitcoin addresses carry one."@en .

pg:S_CoinSelection a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Coin selection"@en ;
    sen0401:anchor "#CoinSelection" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_CoinSelection> ;
    skos:definition "Wallets choose which inputs to spend, balancing many small inputs against few large ones, much as people handle cash."@en .

pg:S_CoinbaseDemo a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Coinbase page"@en ;
    sen0401:anchor "#CoinbaseDemo" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_CoinbaseDemo> ;
    skos:definition "The last page adds a coinbase line and transaction rows to every block of every peer, so that a chain of hashes becomes a ledger whose balances can be read off."@en .

pg:S_CoinbaseTransaction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Coinbase transaction"@en ;
    sen0401:anchor "#CoinbaseTransaction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_CoinbaseTransaction> ;
    skos:definition "The coinbase transaction is the first transaction in a block; it spends no earlier output and pays the miner the new bitcoins of the block plus the fees of the other transactions."@en .

pg:S_Confirmation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Confirmation"@en ;
    sen0401:anchor "#Confirmation" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Confirmation> ;
    skos:definition "A transaction has one confirmation when it is in a block, and one more for each block built on top; reversing it means redoing all of them and one more."@en .

pg:S_ConsensusRules a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Consensus rules"@en ;
    sen0401:anchor "#ConsensusRules" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_ConsensusRules> ;
    skos:definition "The consensus rules are the validation rules that full nodes apply to blocks and transactions; a block that breaks one is rejected by everyone and its miner loses the reward."@en .

pg:S_Consolidation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Consolidation"@en ;
    sen0401:anchor "#Consolidation" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Consolidation> ;
    skos:definition "Many inputs spent into a single output, like exchanging a pile of coins for one note."@en .

pg:S_Construction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Construction"@en ;
    sen0401:anchor "#Construction" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Construction> ;
    skos:definition "Construction is the work of turning a decision to pay into a valid transaction."@en .

pg:S_Cryptography a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Cryptographic foundations"@en ;
    sen0401:anchor "#Cryptography" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Cryptography> ;
    skos:definition "A transaction asks every computer on the network to believe something without trusting anyone: that the person spending certain bitcoins is entitled to spend them."@en .

pg:S_Difficulty a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Difficulty and target"@en ;
    sen0401:anchor "#Difficulty" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Difficulty> ;
    skos:definition "The target is the threshold a block hash must fall below; difficulty is the inverse measure of it, adjusted every 2,016 blocks so that blocks keep arriving about every ten minutes."@en .

pg:S_DigitalSignature a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Digital signature"@en ;
    sen0401:anchor "#DigitalSignature" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_DigitalSignature> ;
    skos:definition "A digital signature is a value computed from a message and a private key that anyone can check against the public key, proving authorization, preventing denial and detecting changes."@en .

pg:S_DistributedDemo a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Distributed page"@en ;
    sen0401:anchor "#DistributedDemo" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_DistributedDemo> ;
    skos:definition "The fourth page gives three peers, A, B and C, each a full copy of the five-block chain, so a reader can tamper with one peer and see that the others disagree with it."@en .

pg:S_DoubleEntryLedger a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Double-entry ledger"@en ;
    sen0401:anchor "#DoubleEntryLedger" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_DoubleEntryLedger> ;
    skos:definition "A ledger records every movement of value as an entry; the chapter pictures a transaction as a double-entry line whose two sides, inputs and outputs, differ only by the fee."@en .

pg:S_DoubleSpend a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Double spend"@en ;
    sen0401:anchor "#DoubleSpend" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_DoubleSpend> ;
    skos:definition "A double spend is the attempt to spend one output in two transactions; nodes reject the second, and the blockchain's order is what makes the rejection unambiguous."@en .

pg:S_EllipticCurve a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Elliptic curve"@en ;
    sen0401:anchor "#EllipticCurve" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_EllipticCurve> ;
    skos:definition "Bitcoin's keys are points on the curve secp256k1, y squared = x cubed + 7 over a finite field of prime order p; multiplying a point by a number is easy and the reverse is infeasible."@en .

pg:S_Encryption a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Encryption"@en ;
    sen0401:anchor "#Encryption" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Encryption> ;
    skos:definition "Encryption transforms data so that only a holder of the right key can read it again; Bitcoin's public-key cryptography is used for signatures, not for encrypting transactions."@en .

pg:S_Entropy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Entropy"@en ;
    sen0401:anchor "#Entropy" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Entropy> ;
    skos:definition "Entropy measures how unpredictable a value is, counted in bits; a key chosen from 2**256 equally likely values has 256 bits of it, and a key chosen badly has far less."@en .

pg:S_ExchangeRate a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Exchange rate"@en ;
    sen0401:anchor "#ExchangeRate" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_ExchangeRate> ;
    skos:definition "An exchange rate is the price of one currency in another; Bob's shop lists prices in dollars and converts them to bitcoin at checkout, so the bitcoin amount of an invoice is only valid for a moment."@en .

pg:S_FeeRate a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Fee rate"@en ;
    sen0401:anchor "#FeeRate" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_FeeRate> ;
    skos:definition "A miner compares transactions by their fee for the space they use, the fee rate, usually quoted in satoshis per virtual byte."@en .

pg:S_Form a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Form"@en ;
    sen0401:anchor "#Form" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Form> ;
    skos:definition "Transactions come in a few typical shapes, which this group calls forms."@en .

pg:S_FullNode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Full node"@en ;
    sen0401:anchor "#FullNode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_FullNode> ;
    skos:definition "A full node is a program that holds the logic and the data to verify every transaction and block against every rule, so that it needs to trust nobody."@en .

pg:S_GenesisBlock a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Genesis block"@en ;
    sen0401:anchor "#GenesisBlock" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_GenesisBlock> ;
    skos:definition "The genesis block is the first block, height 0, with no parent; it is built into the software, so every node starts from the same trusted root."@en .

pg:S_Gossiping a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Gossiping"@en ;
    sen0401:anchor "#Gossiping" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Gossiping> ;
    skos:definition "Gossiping is the rule that any node receiving a valid transaction it has not seen before forwards it to all the peers it is connected to, so that data spreads without any coordinator."@en .

pg:S_HashDemo a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hash page"@en ;
    sen0401:anchor "#HashDemo" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_HashDemo> ;
    skos:definition "The first page of the demonstration shows a data box and its SHA-256 digest, recomputed at every keystroke, so the unpredictability and the fixed length of a hash can be seen."@en .

pg:S_HashFunction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hash function"@en ;
    sen0401:anchor "#HashFunction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_HashFunction> ;
    skos:definition "A hash function turns data of any length into a fixed-length value that is easy to compute, always the same for the same input, and impractical to steer toward a chosen result."@en .

pg:S_HashRate a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hash rate"@en ;
    sen0401:anchor "#HashRate" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_HashRate> ;
    skos:definition "The hash rate is the number of hash computations performed per second; dividing the attempts expected per block by six hundred seconds gives the rate the whole network is running at."@en .

pg:S_HexadecimalNotation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hexadecimal notation"@en ;
    sen0401:anchor "#HexadecimalNotation" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_HexadecimalNotation> ;
    skos:definition "Hexadecimal writes a number in base 16 with the digits 0 to 9 and a to f; each digit stands for four bits, so one byte is exactly two hexadecimal digits."@en .

pg:S_Input a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Input"@en ;
    sen0401:anchor "#Input" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Input> ;
    skos:definition "An input spends funds by referring to an earlier transaction's output and proving ownership with a digital signature."@en .

pg:S_InteractiveDemo a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Interactive demonstration"@en ;
    sen0401:anchor "#InteractiveDemo" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch02#S_InteractiveDemo> ;
    skos:definition "An interactive demonstration, in the sense of this group, is a web page that implements a small part of the chapter's mechanics and lets a reader change the inputs and watch the outputs."@en .

pg:S_KeyPair a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Key pair"@en ;
    sen0401:anchor "#KeyPair" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_KeyPair> ;
    skos:definition "A key pair is a private key, a secret 256-bit number, together with the public key calculated from it; the public key can be shared, the private key must not be."@en .

pg:S_LightweightClient a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Lightweight client"@en ;
    sen0401:anchor "#LightweightClient" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_LightweightClient> ;
    skos:definition "A lightweight client downloads only block headers and asks peers for the parts of the chain that concern it, so it verifies a payment only partly; this is simplified payment verification."@en .

pg:S_Linkage a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Linkage"@en ;
    sen0401:anchor "#Linkage" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Linkage> ;
    skos:definition "A single transaction is only the beginning of the story, because bitcoins are never created in a vacuum: each is spent from something that existed before and gives rise to something that will exist afterwards."@en .

pg:S_MakingChange a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Making change"@en ;
    sen0401:anchor "#MakingChange" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_MakingChange> ;
    skos:definition "An output larger than the payment returns the rest as change to a new address of the payer, because an input cannot be partly spent."@en .

pg:S_Mempool a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Memory pool"@en ;
    sen0401:anchor "#Mempool" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Mempool> ;
    skos:definition "The memory pool is the list of verified but unconfirmed transactions that a node keeps in memory; miners build candidate blocks from it, and it differs from node to node."@en .

pg:S_MerkleTree a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Merkle tree"@en ;
    sen0401:anchor "#MerkleTree" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_MerkleTree> ;
    skos:definition "A merkle tree hashes data in pairs, and then the results in pairs, until a single hash remains, the merkle root; the block header holds the root, so eighty bytes commit to every transaction."@en .

pg:S_Miner a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Miner"@en ;
    sen0401:anchor "#Miner" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Miner> ;
    skos:definition "A miner is a node that assembles candidate blocks and searches for a proof of work; it is paid by the new bitcoins of the block and the fees of the transactions it includes."@en .

pg:S_Mining a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Mining"@en ;
    sen0401:anchor "#Mining" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Mining> ;
    skos:definition "Mining is the process that turns a pool of unconfirmed transactions into the next block of the blockchain."@en .

pg:S_MiningPool a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Mining pool"@en ;
    sen0401:anchor "#MiningPool" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_MiningPool> ;
    skos:definition "A mining pool combines the hash rate of many miners, measures each one's contribution with an easier target, and shares the reward in proportion to the shares earned."@en .

pg:S_Network a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Network"@en ;
    sen0401:anchor "#Network" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Network> ;
    skos:definition "The Bitcoin network is the set of computers that run the Bitcoin protocol and exchange transactions and blocks with one another."@en .

pg:S_Nonce a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Nonce"@en ;
    sen0401:anchor "#Nonce" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Nonce> ;
    skos:definition "A nonce is a value, often a counter, that is changed to make a cryptographic function produce a different output; signing uses a secret one and mining a public one in the block header."@en .

pg:S_Ontology a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Ontology"@en ;
    sen0401:anchor "#Ontology" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Ontology> ;
    skos:definition "An ontology is an explicit, machine-readable description of the concepts of a domain, their hierarchy and their relations, against which questions can be asked and answers checked."@en .

pg:S_Outpoint a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Outpoint"@en ;
    sen0401:anchor "#Outpoint" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Outpoint> ;
    skos:definition "An outpoint is the pair of a transaction identifier and an output index that names exactly one output; an input consists of an outpoint and the data that satisfies it."@en .

pg:S_Output a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Output"@en ;
    sen0401:anchor "#Output" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Output> ;
    skos:definition "An output receives funds; the outputs add up to slightly less than the inputs."@en .

pg:S_Participants a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Who takes part"@en ;
    sen0401:anchor "#Participants" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Participants> ;
    skos:definition "This group names the kinds of program that make up the network and says what each of them can and cannot check."@en .

pg:S_PaymentBatching a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Payment batching"@en ;
    sen0401:anchor "#PaymentBatching" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_PaymentBatching> ;
    skos:definition "Payment batching pays several recipients with one transaction that has many outputs, as a payroll does."@en .

pg:S_PaymentRequest a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Payment request"@en ;
    sen0401:anchor "#PaymentRequest" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch02#S_PaymentRequest> ;
    skos:definition "A payment request is the message through which a seller tells a buyer what to pay, to whom and why."@en .

pg:S_PaymentVerification a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Simplified payment verification"@en ;
    sen0401:anchor "#PaymentVerification" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_PaymentVerification> ;
    skos:definition "A lightweight client confirms that a transaction is in a block and that blocks were mined after it, using a merkle path of about log2(N) hashes instead of the whole block."@en .

pg:S_Peer a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Peer and connection"@en ;
    sen0401:anchor "#Peer" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Peer> ;
    skos:definition "A peer is another node that a node keeps a connection to in order to exchange transactions and blocks; peers are equals, with no server among them."@en .

pg:S_PeerToPeerNetwork a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Peer-to-peer network"@en ;
    sen0401:anchor "#PeerToPeerNetwork" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_PeerToPeerNetwork> ;
    skos:definition "A peer-to-peer network is one in which every participant is of the same kind and both provides and consumes services, with no server and no hierarchy; Bitcoin is built this way on purpose."@en .

pg:S_Practice a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Practice"@en ;
    sen0401:anchor "#Practice" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Practice> ;
    skos:definition "The last branch of this chapter is about trying things out."@en .

pg:S_Probability a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Probability of reversal"@en ;
    sen0401:anchor "#Probability" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Probability> ;
    skos:definition "The chance that an attacker with a minority of the hash rate catches up from behind falls very fast with each confirmation, which is what makes confirmations worth counting."@en .

pg:S_ProofOfWork a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Proof of work"@en ;
    sen0401:anchor "#ProofOfWork" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_ProofOfWork> ;
    skos:definition "Proof of work is data that is expensive to produce and cheap to check: a block header whose hash is below the target proves that an enormous number of attempts was made."@en .

pg:S_Propagation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Propagation"@en ;
    sen0401:anchor "#Propagation" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Propagation> ;
    skos:definition "Propagation is the spreading of a transaction or a block from the computer that first has it to the rest of the network."@en .

pg:S_ProvenanceGraph a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Provenance graph"@en ;
    sen0401:anchor "#ProvenanceGraph" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_ProvenanceGraph> ;
    skos:definition "The chapter's transaction chain is a provenance graph: outputs are entities derived from earlier entities, transactions are the activities that derive them, and key holders are the agents responsible."@en .

pg:S_ProvenanceModel a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Provenance model"@en ;
    sen0401:anchor "#ProvenanceModel" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch02#S_ProvenanceModel> ;
    skos:definition "A provenance model is a description of where things came from: which things existed, which processes made or changed them, and who was responsible."@en .

pg:S_PublicKeyCryptography a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Public-key cryptography"@en ;
    sen0401:anchor "#PublicKeyCryptography" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_PublicKeyCryptography> ;
    skos:definition "Public-key cryptography uses a pair of related keys and a mathematical function that is easy to compute in one direction and infeasible to reverse, which makes unforgeable digital signatures possible."@en .

pg:S_QrCode a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "QR code"@en ;
    sen0401:anchor "#QrCode" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_QrCode> ;
    skos:definition "A QR code is a two-dimensional barcode that holds a short text, such as an address or a payment request, which a phone camera reads."@en .

pg:S_RecipientVerification a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The recipient's own check"@en ;
    sen0401:anchor "#RecipientVerification" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_RecipientVerification> ;
    skos:definition "The receiver's wallet recognises an incoming payment because an output is redeemable by its keys, and checks what it can: well-formedness always, and valid unspent inputs only with a full node."@en .

pg:S_RuleChange a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Soft fork and hard fork"@en ;
    sen0401:anchor "#RuleChange" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_RuleChange> ;
    skos:definition "A soft fork is a change that only narrows what is valid, so unupgraded nodes stay in consensus; a hard fork widens what is valid and is not compatible with older nodes."@en .

pg:S_Satoshi a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Satoshi"@en ;
    sen0401:anchor "#Satoshi" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Satoshi> ;
    skos:definition "The smallest unit: a bitcoin divides into 100,000,000 satoshis."@en .

pg:S_Script a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Script"@en ;
    sen0401:anchor "#Script" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Script> ;
    skos:definition "A script is a short program in Bitcoin's stack-based language; an output carries the conditions for spending it, and the spender supplies data that makes the program end with TRUE."@en .

pg:S_Security a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Security"@en ;
    sen0401:anchor "#Security" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Security> ;
    skos:definition "Security, in this chapter, means the confidence that a payment already recorded will stay recorded."@en .

pg:S_Semantics a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Semantics"@en ;
    sen0401:anchor "#Semantics" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Semantics> ;
    skos:definition "This branch reads the chapter with the eyes of the course rather than of the book."@en .

pg:S_Serialization a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Serialization"@en ;
    sen0401:anchor "#Serialization" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Serialization> ;
    skos:definition "Serialization is the writing of a structure as a flat sequence of bytes in a fixed order, which is the form in which a transaction is sent, hashed and stored."@en .

pg:S_SimplePayment a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Simple payment"@en ;
    sen0401:anchor "#SimplePayment" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_SimplePayment> ;
    skos:definition "The most common form: one input, and two outputs - the payment and the change."@en .

pg:S_SmallPaymentAcceptance a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Accepting a small payment unconfirmed"@en ;
    sen0401:anchor "#SmallPaymentAcceptance" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_SmallPaymentAcceptance> ;
    skos:definition "A merchant may accept a small payment with no confirmation because the loss if it is reversed is smaller than the cost of making the customer wait; the threshold is a business decision."@en .

pg:S_Spending a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Spending the transaction"@en ;
    sen0401:anchor "#Spending" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Spending> ;
    skos:definition "This last group of the branch follows what happens after Alice's payment has been recorded: Bob spends it."@en .

pg:S_SpendingOnward a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Spending onward"@en ;
    sen0401:anchor "#SpendingOnward" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_SpendingOnward> ;
    skos:definition "Once recorded, an output can be spent by its owner in a new transaction, which extends the chain; Bob's payment of 67,000 satoshis out of Alice's 75,000 leaves a fee of 8,000."@en .

pg:S_SudokuAnalogy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Sudoku analogy"@en ;
    sen0401:anchor "#SudokuAnalogy" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_SudokuAnalogy> ;
    skos:definition "An analogy from the course notes: mining is like a huge sudoku that is hard to solve, quick to check, adjustable in size, and restarted whenever somebody finds a solution."@en .

pg:S_Transaction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction"@en ;
    sen0401:anchor "#Transaction" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Transaction> ;
    skos:definition "A transaction is the unit of action in Bitcoin: a message telling the network that the owner of certain bitcoins has authorized the transfer of that value to another owner."@en .

pg:S_TransactionChain a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction chain"@en ;
    sen0401:anchor "#TransactionChain" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_TransactionChain> ;
    skos:definition "Each transaction's inputs spend earlier outputs, so transactions form chains back through history."@en .

pg:S_TransactionConstruction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction construction"@en ;
    sen0401:anchor "#TransactionConstruction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_TransactionConstruction> ;
    skos:definition "A wallet builds a transaction by choosing inputs, creating an output for the receiver and a change output, leaving the fee implied, and signing - even offline."@en .

pg:S_TransactionFee a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction fee"@en ;
    sen0401:anchor "#TransactionFee" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_TransactionFee> ;
    skos:definition "The fee is implied: the difference between the inputs and the outputs, collected by the miner who includes the transaction."@en .

pg:S_TransactionIdentifier a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction identifier"@en ;
    sen0401:anchor "#TransactionIdentifier" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_TransactionIdentifier> ;
    skos:definition "The transaction identifier, or txid, is a 32-byte value derived from the transaction's data; an input points to an earlier output by txid and position."@en .

pg:S_TransactionPart a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction part"@en ;
    sen0401:anchor "#TransactionPart" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch02#S_TransactionPart> ;
    skos:definition "A transaction part is one of the pieces a transaction is assembled from."@en .

pg:S_TransactionPropagation a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction propagation"@en ;
    sen0401:anchor "#TransactionPropagation" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_TransactionPropagation> ;
    skos:definition "Transaction propagation is the spread of a signed transaction across the network by gossip, each node verifying before relaying, until it reaches the miners."@en .

pg:S_TransactionSize a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction size"@en ;
    sen0401:anchor "#TransactionSize" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_TransactionSize> ;
    skos:definition "A block has limited room; transactions are measured in weight units, four of which make one virtual byte (vbyte), and a miner compares them by fee per unit."@en .

pg:S_Transmission a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transmitting the transaction"@en ;
    sen0401:anchor "#Transmission" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Transmission> ;
    skos:definition "Transmission is the sending of a finished transaction from the wallet to any program that will put it on the network; the route does not matter because the transaction carries everything needed to process it."@en .

pg:S_Triple a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Triple and graph"@en ;
    sen0401:anchor "#Triple" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Triple> ;
    skos:definition "A triple is a statement of the form subject, predicate, object; a set of triples forms a graph whose nodes are the things and whose edges are the statements."@en .

pg:S_UnconfirmedTransaction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Unconfirmed transaction"@en ;
    sen0401:anchor "#UnconfirmedTransaction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_UnconfirmedTransaction> ;
    skos:definition "An unconfirmed transaction has propagated and been verified but is in no block; blocks arrive about every ten minutes on average, which is not a timetable."@en .

pg:S_Unit a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Unit"@en ;
    sen0401:anchor "#Unit" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Unit> ;
    skos:definition "A unit is a standard quantity in which value is counted, and a currency usually has several of them: one for everyday prices, smaller ones for small change, and sometimes a very small one in which the accounts are actually kept."@en .

pg:S_UnspentOutput a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Unspent transaction output"@en ;
    sen0401:anchor "#UnspentOutput" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_UnspentOutput> ;
    skos:definition "An unspent transaction output (UTXO) is an output that no later transaction has consumed; full nodes keep the set of all of them."@en .

pg:S_Uri a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Uniform resource identifier"@en ;
    sen0401:anchor "#Uri" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Uri> ;
    skos:definition "A URI is a text string that names a resource by a scheme such as bitcoin:, a path and optional query parameters; Bitcoin payment requests use the form bitcoin:address?parameters."@en .

pg:S_Wallet a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Wallet"@en ;
    sen0401:anchor "#Wallet" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Wallet> ;
    skos:definition "A wallet is the software that keeps a user's keys, tracks the outputs they can spend, builds and signs transactions, and shows balances; it holds keys, not coins."@en .

pg:S_Witness a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Witness"@en ;
    sen0401:anchor "#Witness" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch02#S_Witness> ;
    skos:definition "The witness is the data that proves an input may be spent, kept in its own structure outside the part that the transaction identifier is computed from; this separation is called segregated witness."@en .

pg:CO2 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Explain how a transaction travels from wallet to network to block"@en ;
    ld:bloomLevel ld:Understand ;
    dcterms:source <http://example.org/sen0401/ch02/document> ;
    skos:definition "After this chapter the learner can explain how a transaction travels from wallet to network to block."@en .

pg:CO3 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Compute, as the whitepaper does, how confirmations reduce the chance of reversal"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch02/document> ;
    skos:definition "After this chapter the learner can compute, as the whitepaper does, how confirmations reduce the chance of reversal."@en .

pg:CO4 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Describe a transaction chain as a provenance graph in W3C PROV terms"@en ;
    ld:bloomLevel ld:Understand ;
    dcterms:source <http://example.org/sen0401/ch02/document> ;
    skos:definition "After this chapter the learner can describe a transaction chain as a provenance graph in W3C PROV terms."@en .

pg:CO1 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Trace a payment's inputs, outputs, change and implied fee"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch02/document> ;
    skos:definition "After this chapter the learner can trace a payment's inputs, outputs, change and implied fee."@en .

