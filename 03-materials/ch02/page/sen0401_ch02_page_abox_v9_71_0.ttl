    skos:definition "This page teaches chapter 2 of the course book as an interactive surface with 101 sections in a three-level outline, 103 widgets that the browser test exercised, and a quiz of 5 questions."@en .

pg:Q1 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Inputs total 0.15 bitcoin and outputs total 0.1499 bitcoin. What is the difference?"@en ;
    ld:assessesObjective pg:CO1 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "Bitcoin amounts are exact integers of satoshis; nothing is rounded away.",
        "Change is itself an output, so it is already counted in the 0.1499." ;
    ld:hasCorrectOption pg:Q1_O0 ;
    ld:hasOption pg:Q1_O0,
        pg:Q1_O1,
        pg:Q1_O2 .

pg:Q2 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Alice pays 5 bitcoins using a 20-bitcoin input. Ignoring the fee, what is the change?"@en ;
    ld:assessesObjective pg:CO1 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "5 is the payment to the store, not the change.",
        "The whole input is spent; 20 would mean the store got nothing." ;
    ld:hasCorrectOption pg:Q2_O0 ;
    ld:hasOption pg:Q2_O0,
        pg:Q2_O1,
        pg:Q2_O2 .

pg:Q3 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "When does a transaction become part of the blockchain?"@en ;
    ld:assessesObjective pg:CO2 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "Explorers display what they see, including unconfirmed transactions.",
        "Signing makes it valid to relay; it is not yet in any block." ;
    ld:hasCorrectOption pg:Q3_O0 ;
    ld:hasOption pg:Q3_O0,
        pg:Q3_O1,
        pg:Q3_O2 .

pg:Q4 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "By the whitepaper, an attacker with 10% of the hash power catches up from six blocks behind with probability about:"@en ;
    ld:assessesObjective pg:CO3 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "0.05 is roughly the probability at two confirmations.",
        "0.2 is the probability at one confirmation, not six." ;
    ld:hasCorrectOption pg:Q4_O0 ;
    ld:hasOption pg:Q4_O0,
        pg:Q4_O1,
        pg:Q4_O2 .

pg:Q5 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "In PROV-O terms, what is a Bitcoin transaction in a chain of spends?"@en ;
    ld:assessesObjective pg:CO4 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "Nothing about a transaction chain is a document on the web.",
        "The agent is the key holder who signs; the transaction is what happens." ;
    ld:hasCorrectOption pg:Q5_O0 ;
    ld:hasOption pg:Q5_O0,
        pg:Q5_O1,
        pg:Q5_O2 .

