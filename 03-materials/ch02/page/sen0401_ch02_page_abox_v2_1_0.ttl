pg:Page a ipo:Page, ipo:InteractiveLearningSurface ; rdfs:label "Chapter 2 interactive page"@en ;
    dcterms:source <http://example.org/sen0401/ch02/document> ; ipo:hasSourceDocument pg:SourceDocument ;
    ipo:satisfiesHeuristic ipo:RecognitionRatherThanRecall, ipo:ConsistencyAndStandards, ipo:AestheticAndMinimalistDesign,
        ipo:ShneidermanRule_OfferInformativeFeedback, ipo:ShneidermanRule_PermitEasyReversalOfActions, ipo:HelpAndDocumentation ;
    ipo:hasLayoutPattern pg:Layout ; ipo:hasSemanticRegion pg:Header, pg:Sidebar, pg:Main ;
    ipo:includesNavigationPattern pg:GroupedTopBar, pg:SectionTree ;
    ipo:coversLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 ;
    sen0401:navigationRule "BP-D34: 36 sections falls in 26-50, so a grouped permanent top bar with a sub-section sidebar; the named single flowing anchor-page variation of procedure v1.6.0 section 5.3." ;
    sen0401:pythonUsed "Python 3.14.4" .
pg:Layout a ipo:SplitLayout ; rdfs:label "Sidebar and main content"@en .
pg:Header a ipo:Header ; rdfs:label "Sticky header with grouped section bar"@en .
pg:Sidebar a ipo:Sidebar ; rdfs:label "Section tree"@en .
pg:Main a ipo:MainContent ; rdfs:label "Chapter content with inline widgets"@en .
pg:GroupedTopBar a ipo:PrimaryNavigation ; rdfs:label "Grouped permanent top bar"@en .
pg:SectionTree a ipo:TreeNavigation ; rdfs:label "Sub-section sidebar tree"@en .
pg:SourceDocument a ipo:SourceDocument ; rdfs:label "Chapter 2 Stage 3 document"@en ; dcterms:source <http://example.org/sen0401/ch02/document> ;
    ipo:hasLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 .

pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Trace a payment's inputs, outputs, change and implied fee"@en ; ld:bloomLevel ld:Apply  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Explain how a transaction travels from wallet to network to block"@en ; ld:bloomLevel ld:Understand  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Compute, as the whitepaper does, how confirmations reduce the chance of reversal"@en ; ld:bloomLevel ld:Apply  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Describe a transaction chain as a provenance graph in W3C PROV terms"@en ; ld:bloomLevel ld:Understand  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Inputs total 0.15 bitcoin and outputs total 0.1499 bitcoin. What is the difference?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "Bitcoin amounts are exact integers of satoshis; nothing is rounded away." ; ld:distractorRationale "Change is itself an output, so it is already counted in the 0.1499." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "The transaction fee, collected by the miner" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "A rounding error" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "Change returned to the payer" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Alice pays 5 bitcoins using a 20-bitcoin input. Ignoring the fee, what is the change?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "The whole input is spent; 20 would mean the store got nothing." ; ld:distractorRationale "5 is the payment to the store, not the change." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "15 bitcoins" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "20 bitcoins" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "5 bitcoins" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "When does a transaction become part of the blockchain?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "Signing makes it valid to relay; it is not yet in any block." ; ld:distractorRationale "Explorers display what they see, including unconfirmed transactions." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "When a miner includes it in a block that full nodes validate" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "As soon as the wallet signs it" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "When a block explorer shows it" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "By the whitepaper, an attacker with 10% of the hash power catches up from six blocks behind with probability about:"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "0.2 is the probability at one confirmation, not six." ; ld:distractorRationale "0.05 is roughly the probability at two confirmations." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "0.0002" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "0.2" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "0.05" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "In PROV-O terms, what is a Bitcoin transaction in a chain of spends?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "The agent is the key holder who signs; the transaction is what happens." ; ld:distractorRationale "Nothing about a transaction chain is a document on the web." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "An activity that derives new outputs from earlier ones" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "An agent" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "A web page" .
