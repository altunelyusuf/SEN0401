    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:created "2026-10-15"^^xsd:date ; dcterms:modified "2026-10-19"^^xsd:date ;
    dcterms:identifier "sen0401_ch14_tbox_v1_1_0" ;
    owl:priorVersion <http://example.org/sen0401/ch14/tbox/1.0.0> ; prov:wasRevisionOf <http://example.org/sen0401/ch14/tbox/1.0.0> ;
    skos:changeNote "Version 1.1.0 repairs connectedness (discipline version 2.18.0 BP-D56 and version 2.19.0 BP-D57): the subject branches of the chapter are now linked to one another by the relations the chapter's own definitions state, chx:hasOwner has the domain and range its use shows where the file declares it, and chx:input and chx:output are declared. No class was added, removed or renamed, so MINOR."@en ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/ch14-rdodi-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

chx:PlatformGuarantees a owl:Class ; rdfs:label "Platform guarantees"@en ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:ChainGuarantees a owl:Class ; rdfs:label "Chain guarantees"@en ; rdfs:subClassOf chx:PlatformGuarantees ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:DoubleSpendRejected a owl:Class ; rdfs:label "A double spend is rejected"@en ; rdfs:subClassOf chx:ChainGuarantees ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:OutputsCannotExceedInputs a owl:Class ; rdfs:label "Outputs cannot exceed inputs"@en ; rdfs:subClassOf chx:ChainGuarantees ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
