chx:BreachJusticeTransaction a owl:Class ; rdfs:label "The justice transaction"@en ; rdfs:subClassOf chx:ChannelOnChain ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:MainnetGraphSize a owl:Class ; rdfs:label "The size of the public graph"@en ; rdfs:subClassOf chx:ChannelOnChain ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:SinceThePrint a owl:Class ; rdfs:label "Since the print"@en ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:ErrataAndDrift a owl:Class ; rdfs:label "Errata and drift"@en ; rdfs:subClassOf chx:SinceThePrint ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:ChapterAnchorErratum a owl:Class ; rdfs:label "The chapter anchor erratum"@en ; rdfs:subClassOf chx:ErrataAndDrift ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:LightningNoLongerProposed a owl:Class ; rdfs:label "Lightning is no longer proposed"@en ; rdfs:subClassOf chx:ErrataAndDrift ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:WhitepaperDate a owl:Class ; rdfs:label "The date of the whitepaper"@en ; rdfs:subClassOf chx:ErrataAndDrift ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:CsvDelayThousandVersus2016 a owl:Class ; rdfs:label "A delay of 1,000 versus 2016"@en ; rdfs:subClassOf chx:ErrataAndDrift ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:BookFeeVersusNetworkFee a owl:Class ; rdfs:label "The book fee versus the network fee"@en ; rdfs:subClassOf chx:ErrataAndDrift ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:NewMachinery a owl:Class ; rdfs:label "New machinery"@en ; rdfs:subClassOf chx:SinceThePrint ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:TrucAndAnchors a owl:Class ; rdfs:label "TRUC and anchors"@en ; rdfs:subClassOf chx:NewMachinery ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:FullRbfIsStandard a owl:Class ; rdfs:label "Full RBF is standard"@en ; rdfs:subClassOf chx:NewMachinery ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:ProposalsStillDrafts a owl:Class ; rdfs:label "The proposals are still drafts"@en ; rdfs:subClassOf chx:NewMachinery ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:OtherImplementations a owl:Class ; rdfs:label "Other implementations"@en ; rdfs:subClassOf chx:NewMachinery ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:LndDefaults a owl:Class ; rdfs:label "The lnd defaults"@en ; rdfs:subClassOf chx:NewMachinery ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:Limits a owl:Class ; rdfs:label "Limits of the experiments"@en ; rdfs:subClassOf chx:SinceThePrint ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:WhatWasNotExecuted a owl:Class ; rdfs:label "What was not executed"@en ; rdfs:subClassOf chx:Limits ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:PlatformGuarantees owl:disjointWith chx:ColoredCoins .
chx:PlatformGuarantees owl:disjointWith chx:PaymentChannels .
chx:PlatformGuarantees owl:disjointWith chx:LightningNetwork .
chx:PlatformGuarantees owl:disjointWith chx:SinceThePrint .
chx:ColoredCoins owl:disjointWith chx:PaymentChannels .
chx:ColoredCoins owl:disjointWith chx:LightningNetwork .
chx:ColoredCoins owl:disjointWith chx:SinceThePrint .
chx:PaymentChannels owl:disjointWith chx:LightningNetwork .
chx:PaymentChannels owl:disjointWith chx:SinceThePrint .
chx:LightningNetwork owl:disjointWith chx:SinceThePrint .

#################################################################
# Connectedness repair (discipline v2.19.0, BP-D56 and BP-D57), 2026-10-19.
# The datatype properties the A-Box uses and nothing declared, then the relations
# between the chapter's subject branches that the chapter's own sources state.
#################################################################
chx:input a owl:DatatypeProperty ; rdfs:label "input expression"@en ; rdfs:comment "The expression an input/output example evaluates."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:output a owl:DatatypeProperty ; rdfs:label "output value"@en ; rdfs:comment "The value that evaluating the example expression gives."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:paysOnSecretOf a owl:ObjectProperty ; rdfs:label "pays on the secret whose hash is carried by"@en ;
    rdfs:comment "The HTLC hash branch pays whoever shows the secret, and the invoice carries the payment hash of that secret. Basis: the chapter says of The HTLC secret branch: 'The hash branch of the HTLC pays whoever shows the secret'; the chapter says of The structure of an invoice: 'the secret released later hashed to the payment hash'."@en ;
    rdfs:domain chx:HtlcSecretBranch ; rdfs:range chx:InvoiceStructure ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:refundsAfterTimelockOf a owl:ObjectProperty ; rdfs:label "refunds after a time set by"@en ;
    rdfs:comment "The time branch refunds the payer after the lock height, and every hop must have more time than the next. Basis: the chapter says of The HTLC timeout branch: 'The time branch refunds the payer only after the lock height'; the chapter says of The timelock staircase: 'Every hop must have more time than the next'."@en ;
    rdfs:domain chx:HtlcTimeoutBranch ; rdfs:range chx:TimelockStaircase ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:isHandBuiltFormOf a owl:ObjectProperty ; rdfs:label "is the hand-built form of"@en ;
    rdfs:comment "Both are the 2-of-2 multisignature funding output. Basis: the chapter says of Funding needs both keys: 'The funding output is a 2-of-2 multisignature script'; the chapter says of The funding output is a multisignature: 'a 2-of-2 multisignature script'."@en ;
    rdfs:domain chx:FundingNeedsBothKeys ; rdfs:range chx:FundingOutputIsMultisig ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:usesRevocationKeyOf a owl:ObjectProperty ; rdfs:label "needs the revocation key derived in"@en ;
    rdfs:comment "The penalty path needs the revocation private key, and the BOLT 3 derivation of that key needs two secrets. Basis: the chapter says of Revocation needs both halves: 'The penalty path needs the revocation private key'; the chapter says of The revocation key vector: 'needs both the revocation base secret and the per-commitment secret'."@en ;
    rdfs:domain chx:RevocationNeedsBothHalves ; rdfs:range chx:RevocationKeyVector ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:explainsPenaltyOf a owl:ObjectProperty ; rdfs:label "explains the penalty taken in"@en ;
    rdfs:comment "The honest party takes all the coins when the cheater is caught, which the justice transaction does with the penalty output. Basis: the chapter says of The penalty takes everything: 'if he is caught the honest party takes all 10'; the chapter says of The justice transaction: 'answered with a justice transaction that spent its penalty output'."@en ;
    rdfs:domain chx:PenaltyTakesEverything ; rdfs:range chx:BreachJusticeTransaction ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:comparesFeeOf a owl:ObjectProperty ; rdfs:label "compares the fee of"@en ;
    rdfs:comment "The book's fee of 0.001 per hop is the fee of the staircase of amounts. Basis: the chapter says of The book fee versus the network fee: 'The book's fee of 0.001 per hop'; the chapter says of The fee arithmetic: 'with a fee of 0.001 from each of three intermediaries'."@en ;
    rdfs:domain chx:BookFeeVersusNetworkFee ; rdfs:range chx:FeeArithmetic ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:comparesDelayOf a owl:ObjectProperty ; rdfs:label "compares the delay of"@en ;
    rdfs:comment "The book's revocable delay of 1,000 blocks is the delay of the hand-built asymmetric commitment. Basis: the chapter says of A delay of 1,000 versus 2016: 'The book's revocable delay is 1,000 blocks'; the chapter says of The asymmetric commitment: 'a branch with 1000 and OP_CHECKSEQUENCEVERIFY'."@en ;
    rdfs:domain chx:CsvDelayThousandVersus2016 ; rdfs:range chx:AsymmetricCommitment ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:setsDeltaOf a owl:ObjectProperty ; rdfs:label "sets the timelock delta of"@en ;
    rdfs:comment "The lnd default timelock delta of 80 blocks is the step of the real route. Basis: the chapter says of The lnd defaults: 'a timelock delta of 80'; the chapter says of The timelock staircase: 'the delta of 80 blocks that is their default'."@en ;
    rdfs:domain chx:LndDefaults ; rdfs:range chx:TimelockStaircase ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:advertisesAnchorsOf a owl:ObjectProperty ; rdfs:label "advertises the anchors of"@en ;
    rdfs:comment "lnd advertises anchor commitments and its commitment transaction has two anchors. Basis: the chapter says of The lnd defaults: 'anchor commitments with zero-fee HTLC transactions'; the chapter says of The shape of a commitment transaction: 'two are anchors of 330 satoshis'."@en ;
    rdfs:domain chx:LndDefaults ; rdfs:range chx:CommitmentTransactionShape ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:replacesDoubleSpendOf a owl:ObjectProperty ; rdfs:label "is shown by the replacement in"@en ;
    rdfs:comment "Full RBF accepted the higher-fee replacement of the double spend. Basis: the chapter says of Full RBF is standard: 'the higher-fee replacement of the double spend was accepted'; the chapter says of A double spend is rejected: 'one with a higher fee replaced the first in the node's memory pool'."@en ;
    rdfs:domain chx:FullRbfIsStandard ; rdfs:range chx:DoubleSpendRejected ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:countsNetworkOf a owl:ObjectProperty ; rdfs:label "counts the network the book calls proposed in"@en ;
    rdfs:comment "The statistics page counts channels and nodes of the network the book calls proposed. Basis: the chapter says of Lightning is no longer proposed: 'The chapter calls the Lightning Network a proposed network'; the chapter says of The size of the public graph: 'The public network that the book calls proposed'."@en ;
    rdfs:domain chx:LightningNoLongerProposed ; rdfs:range chx:MainnetGraphSize ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:leavesUnrunPublicNetwork a owl:ObjectProperty ; rdfs:label "records as not run"@en ;
    rdfs:comment "The record lists the public network as not executed. Basis: the chapter says of What was not executed: 'the public network'; the chapter says of The size of the public graph: 'The public network that the book calls proposed'."@en ;
    rdfs:domain chx:WhatWasNotExecuted ; rdfs:range chx:MainnetGraphSize ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:leavesUnrunExpiry a owl:ObjectProperty ; rdfs:label "records as not run"@en ;
    rdfs:comment "The record lists an HTLC expiring on the chain as not executed. Basis: the chapter says of What was not executed: 'an HTLC expiring on the chain'; the chapter says of The HTLC timeout branch: 'The time branch refunds the payer only after the lock height'."@en ;
    rdfs:domain chx:WhatWasNotExecuted ; rdfs:range chx:HtlcTimeoutBranch ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:closesOnlyOnceLike a owl:ObjectProperty ; rdfs:label "closes once like"@en ;
    rdfs:comment "A single-use seal closes once, as an output cannot be spent twice. Basis: the chapter says of An output is a single-use seal: 'an unspent output is exactly that'; the chapter says of A double spend is rejected: 'No output can be spent twice in one valid chain'."@en ;
    rdfs:domain chx:UtxoIsASingleUseSeal ; rdfs:range chx:DoubleSpendRejected ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:commitsInTransactionLike a owl:ObjectProperty ; rdfs:label "commits to data in a transaction like"@en ;
    rdfs:comment "The contract is committed in a key tweak and a proof of existence is a commitment in a transaction. Basis: the chapter says of The contract stays off the chain: 'the 69-byte contract was committed in the key tweak'; the chapter says of Proof of existence: 'A proof of existence needs only a commitment in a transaction'."@en ;
    rdfs:domain chx:ContractStaysOffChain ; rdfs:range chx:ProofOfExistence ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:letsPartyKeepLadder a owl:ObjectProperty ; rdfs:label "lets a channel party keep the commitments of"@en ;
    rdfs:comment "A valid transaction does not expire, which lets a channel party keep a signed transaction for weeks. Basis: the chapter says of A transaction does not expire: 'lets a channel party keep a signed transaction for weeks'; the chapter says of The refund timelock ladder: '30 days at 144 blocks a day are the book's 4,320 blocks'."@en ;
    rdfs:domain chx:NonExpiration ; rdfs:range chx:RefundTimelockLadder ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
