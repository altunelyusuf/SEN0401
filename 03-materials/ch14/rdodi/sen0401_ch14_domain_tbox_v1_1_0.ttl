chx:ComposedApplications a owl:Class ; rdfs:label "Composed applications"@en ; rdfs:subClassOf chx:PlatformGuarantees ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:ProofOfExistence a owl:Class ; rdfs:label "Proof of existence"@en ; rdfs:subClassOf chx:ComposedApplications ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:LighthouseCrowdfund a owl:Class ; rdfs:label "Lighthouse crowdfunding"@en ; rdfs:subClassOf chx:ComposedApplications ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:ColoredCoins a owl:Class ; rdfs:label "Colored coins"@en ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:SealsAndContracts a owl:Class ; rdfs:label "Seals and contracts"@en ; rdfs:subClassOf chx:ColoredCoins ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
