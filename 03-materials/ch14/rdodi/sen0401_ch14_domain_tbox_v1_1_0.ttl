<http://example.org/sen0401/ch14/tbox> a owl:Ontology ;
    rdfs:label "SEN0401 chapter 14 domain ontology - TBox"@en ; owl:versionInfo "1.1.0" ; owl:versionIRI <http://example.org/sen0401/ch14/tbox/1.1.0> ;
