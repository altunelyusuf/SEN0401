chx:HoldInvoiceInFlight a owl:Class ; rdfs:label "A hold invoice in flight"@en ; rdfs:subClassOf chx:RoutedPayment ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:InvoiceStructure a owl:Class ; rdfs:label "The structure of an invoice"@en ; rdfs:subClassOf chx:RoutedPayment ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:TransportAndOnion a owl:Class ; rdfs:label "Transport and onion"@en ; rdfs:subClassOf chx:LightningNetwork ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:NoiseHandshakeVector a owl:Class ; rdfs:label "The Noise handshake vector"@en ; rdfs:subClassOf chx:TransportAndOnion ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:TransportMessageVector a owl:Class ; rdfs:label "The transport message vector"@en ; rdfs:subClassOf chx:TransportAndOnion ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:OnionPacketVector a owl:Class ; rdfs:label "The onion packet vector"@en ; rdfs:subClassOf chx:TransportAndOnion ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:OnionFixedSize a owl:Class ; rdfs:label "The fixed size of the onion"@en ; rdfs:subClassOf chx:TransportAndOnion ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:OnionIntegrityByHmac a owl:Class ; rdfs:label "Onion integrity by HMAC"@en ; rdfs:subClassOf chx:TransportAndOnion ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:InvoiceVector a owl:Class ; rdfs:label "The invoice vector"@en ; rdfs:subClassOf chx:TransportAndOnion ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:ChannelOnChain a owl:Class ; rdfs:label "The channel on the chain"@en ; rdfs:subClassOf chx:LightningNetwork ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:FundingOutputIsMultisig a owl:Class ; rdfs:label "The funding output is a multisignature"@en ; rdfs:subClassOf chx:ChannelOnChain ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:CommitmentTransactionShape a owl:Class ; rdfs:label "The shape of a commitment transaction"@en ; rdfs:subClassOf chx:ChannelOnChain ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
chx:RevocationKeyVector a owl:Class ; rdfs:label "The revocation key vector"@en ; rdfs:subClassOf chx:ChannelOnChain ; rdfs:isDefinedBy <http://example.org/sen0401/ch14/tbox> .
