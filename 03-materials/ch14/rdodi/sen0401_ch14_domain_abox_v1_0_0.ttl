chx:X_DoubleSpendRejected a owl:NamedIndividual, chx:DoubleSpendRejected ; rdfs:label "a second spend that loses to the first"@en ; skos:definition "No output can be spent twice in one valid chain: on the test chain a second payment of the same output with a lower fee was refused as an insufficient replacement, one with a higher fee replaced the first in the node's memory pool, and once a block had confirmed the winner the loser was refused as spending a missing or spent input."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_DoubleSpendRejected a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); d = R['c1']['double_spend']; (d['first_accepted'], d['second_lower_fee'].split(',')[0], d['second_higher_fee'], d['first_still_in_mempool'], d['first_after_block'].split(' ')[-1], L.has('book_ch14_applications.adoc', 'The most fundamental guarantee of Bitcoin')) evaluates to (True, 'error code: -26 error message: insufficient fee', 'replaced the first', False, 'bad-txns-inputs-missingorspent', True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); d = R['c1']['double_spend']; (d['first_accepted'], d['second_lower_fee'].split(',')[0], d['second_higher_fee'], d['first_still_in_mempool'], d['first_after_block'].split(' ')[-1], L.has('book_ch14_applications.adoc', 'The most fundamental guarantee of Bitcoin'))" ; chx:output "(True, 'error code: -26 error message: insufficient fee', 'replaced the first', False, 'bad-txns-inputs-missingorspent', True)" .
chx:X_DoubleSpendRejected rd:hasIOExample chx:IO_DoubleSpendRejected .
chx:X_OutputsCannotExceedInputs a owl:NamedIndividual, chx:OutputsCannotExceedInputs ; rdfs:label "a payment that creates 1 coin from nothing"@en ; skos:definition "The accounting building block says that the outputs of a transaction cannot exceed its inputs: a transaction whose outputs were larger than the value it spent was refused by the node with the reason bad-txns-in-belowout, the same reason that stopped a pledge which lacked the second pledger's input."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_OutputsCannotExceedInputs a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); (R['c1']['outputs_exceed_inputs'], R['c1']['lighthouse']['only_a']['reason'], L.has('book_ch14_applications.adoc', 'The outputs cannot exceed the inputs')) evaluates to ('bad-txns-in-belowout', 'bad-txns-in-belowout', True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); (R['c1']['outputs_exceed_inputs'], R['c1']['lighthouse']['only_a']['reason'], L.has('book_ch14_applications.adoc', 'The outputs cannot exceed the inputs'))" ; chx:output "('bad-txns-in-belowout', 'bad-txns-in-belowout', True)" .
chx:X_OutputsCannotExceedInputs rd:hasIOExample chx:IO_OutputsCannotExceedInputs .
chx:X_NonExpiration a owl:NamedIndividual, chx:NonExpiration ; rdfs:label "a signed transaction kept for 150 blocks"@en ; skos:definition "A valid transaction does not expire: a payment signed at height 301 and kept back was still accepted by the node at height 451, 150 blocks later, because nothing in it or in the rules had changed, which is the property that lets a channel party keep a signed transaction for weeks."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_NonExpiration a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); n = R['c1']['non_expiration']; (n['allowed'], n['signed_at_height'], n['tested_at_height'], n['tested_at_height'] - n['signed_at_height'], L.has('book_ch14_applications.adoc', 'A valid transaction does not expire')) evaluates to (True, 301, 451, 150, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); n = R['c1']['non_expiration']; (n['allowed'], n['signed_at_height'], n['tested_at_height'], n['tested_at_height'] - n['signed_at_height'], L.has('book_ch14_applications.adoc', 'A valid transaction does not expire'))" ; chx:output "(True, 301, 451, 150, True)" .
chx:X_NonExpiration rd:hasIOExample chx:IO_NonExpiration .
chx:X_EighteenBuildingBlocks a owl:NamedIndividual, chx:EighteenBuildingBlocks ; rdfs:label "the list of guarantees from no double spend to predictable issuance"@en ; skos:definition "The chapter opens with a list of guarantees that the base system gives to anything built on it, from no double spend and immutability to predictable issuance; counted in the saved text of the chapter there are 18 of them, and the chapter itself says the list is not complete."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_EighteenBuildingBlocks a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); t = L.text('book_ch14_applications.adoc'); a = t.index('=== Building Blocks (Primitives)'); b = t.index('=== Applications from Building Blocks'); (t[a:b].count(':: '), t[a:b].count('Timelock/aging::'), L.has('book_ch14_applications.adoc', 'The list of building blocks is not complete')) evaluates to (18, 1, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); t = L.text('book_ch14_applications.adoc'); a = t.index('=== Building Blocks (Primitives)'); b = t.index('=== Applications from Building Blocks'); (t[a:b].count(':: '), t[a:b].count('Timelock/aging::'), L.has('book_ch14_applications.adoc', 'The list of building blocks is not complete'))" ; chx:output "(18, 1, True)" .
chx:X_EighteenBuildingBlocks rd:hasIOExample chx:IO_EighteenBuildingBlocks .
chx:X_ProofOfExistence a owl:NamedIndividual, chx:ProofOfExistence ; rdfs:label "a document hash written in an OP_RETURN output"@en ; skos:definition "A proof of existence needs only a commitment in a transaction: the 32-byte SHA-256 of a document was written as an OP_RETURN output of value zero, the node confirmed it in a block, and the output script read back as OP_RETURN followed by exactly that hash, so the document existed no later than that block."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_ProofOfExistence a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); p = R['c1']['proof_of_existence']; (p['contains_hash'], p['nulldata_asm'] == 'OP_RETURN ' + p['sha256'], len(p['sha256']) // 2, p['value'], p['block_height'] > 300, L.has('book_ch14_applications.adoc', 'Immutability + Timestamp + Durability')) evaluates to (True, True, 32, 0.0, True, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); p = R['c1']['proof_of_existence']; (p['contains_hash'], p['nulldata_asm'] == 'OP_RETURN ' + p['sha256'], len(p['sha256']) // 2, p['value'], p['block_height'] > 300, L.has('book_ch14_applications.adoc', 'Immutability + Timestamp + Durability'))" ; chx:output "(True, True, 32, 0.0, True, True)" .
chx:X_ProofOfExistence rd:hasIOExample chx:IO_ProofOfExistence .
chx:X_LighthouseCrowdfund a owl:NamedIndividual, chx:LighthouseCrowdfund ; rdfs:label "two pledges that become one payment only together"@en ; skos:definition "A crowdfunding transaction in the style of Lighthouse combines integrity and atomicity: each pledger signs only his own input and the one fixed output with ANYONECANPAY, so with one pledge the node refuses the transaction for lack of value, with both it accepts it, and a change of the output breaks the signatures."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_LighthouseCrowdfund a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); l = R['c1']['lighthouse']; (l['pledge_a_sat'] + l['pledge_b_sat'] - l['fee_sat'] == l['goal_sat'], l['only_a']['reason'], l['both']['allowed'], l['output_changed']['reason'].split(' (')[0], l['a_signed_all_then_b_added']['allowed'], L.has('book_ch14_applications.adoc', 'others can contribute to the fundraiser')) evaluates to (True, 'bad-txns-in-belowout', True, 'mempool-script-verify-flag-failed', False, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); l = R['c1']['lighthouse']; (l['pledge_a_sat'] + l['pledge_b_sat'] - l['fee_sat'] == l['goal_sat'], l['only_a']['reason'], l['both']['allowed'], l['output_changed']['reason'].split(' (')[0], l['a_signed_all_then_b_added']['allowed'], L.has('book_ch14_applications.adoc', 'others can contribute to the fundraiser'))" ; chx:output "(True, 'bad-txns-in-belowout', True, 'mempool-script-verify-flag-failed', False, True)" .
chx:X_LighthouseCrowdfund rd:hasIOExample chx:IO_LighthouseCrowdfund .
chx:X_UtxoIsASingleUseSeal a owl:NamedIndividual, chx:UtxoIsASingleUseSeal ; rdfs:label "an output that can be spent once and so can close once"@en ; skos:definition "A single-use seal is something that can be closed to one message only once, and an unspent output is exactly that: in a chain of three seals each earlier output was spent by the next transaction, and the three seal outpoints were three different ones."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_UtxoIsASingleUseSeal a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c2']['client_side_validation']; (c['spent_by_next'], len(c['tx_ids']), len({h['outpoint'] for h in c['history']}), L.has('book_ch14_applications.adoc', 'A UTXO can only be spent once within a valid blockchain')) evaluates to ([True, True], 2, 3, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c2']['client_side_validation']; (c['spent_by_next'], len(c['tx_ids']), len({h['outpoint'] for h in c['history']}), L.has('book_ch14_applications.adoc', 'A UTXO can only be spent once within a valid blockchain'))" ; chx:output "([True, True], 2, 3, True)" .
chx:X_UtxoIsASingleUseSeal rd:hasIOExample chx:IO_UtxoIsASingleUseSeal .
chx:X_PayToContractTweak a owl:NamedIndividual, chx:PayToContractTweak ; rdfs:label "a public key tweaked by the hash of a contract"@en ; skos:definition "Pay to contract adds to a public key a tweak computed from the contract, so that the output commits to the contract without showing it: recomputed here the tweaked key equalled the plain key plus the tweak times the generator point, the output was spent with the tweaked key and refused with the plain key, and the reveal fitted only the true contract."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_PayToContractTweak a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); import sen0401_ch14_crypto_v1_0_0 as C; p = R['c2']['p2c']; (C.ser(C.padd(C.parse(bytes.fromhex(p['plain_pubkey'])), C.pmul(int(p['tweak_hex'], 16)))).hex() == p['tweaked_pubkey'], p['same_as_plain_p2wpkh'], p['reveal_check'], p['reveal_wrong_contract'], p['spend_with_plain_key']['allowed'], p['spend_with_plain_key']['reason'].split(' (')[1].rstrip(')'), p['spend_with_tweaked_key']['allowed']) evaluates to (True, False, True, False, False, 'Script failed an OP_EQUALVERIFY operation', True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); import sen0401_ch14_crypto_v1_0_0 as C; p = R['c2']['p2c']; (C.ser(C.padd(C.parse(bytes.fromhex(p['plain_pubkey'])), C.pmul(int(p['tweak_hex'], 16)))).hex() == p['tweaked_pubkey'], p['same_as_plain_p2wpkh'], p['reveal_check'], p['reveal_wrong_contract'], p['spend_with_plain_key']['allowed'], p['spend_with_plain_key']['reason'].split(' (')[1].rstrip(')'), p['spend_with_tweaked_key']['allowed'])" ; chx:output "(True, False, True, False, False, 'Script failed an OP_EQUALVERIFY operation', True)" .
chx:X_PayToContractTweak rd:hasIOExample chx:IO_PayToContractTweak .
chx:X_ContractStaysOffChain a owl:NamedIndividual, chx:ContractStaysOffChain ; rdfs:label "a 69-byte contract that no node ever sees"@en ; skos:definition "The contract terms are not published: the 69-byte contract was committed in the key tweak, and everything the chain showed was ordinary pay-to-witness-key-hash outputs, with no token amount visible in it."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_ContractStaysOffChain a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c2']['client_side_validation']; p = R['c2']['p2c']; (p['contract_len'], c['tokens_visible_in_chain'], sorted(set(c['on_chain_script_types'])), L.has('book_ch14_applications.adoc', 'Nothing is publicly revealed about the contract')) evaluates to (69, False, ['witness_v0_keyhash'], True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c2']['client_side_validation']; p = R['c2']['p2c']; (p['contract_len'], c['tokens_visible_in_chain'], sorted(set(c['on_chain_script_types'])), L.has('book_ch14_applications.adoc', 'Nothing is publicly revealed about the contract'))" ; chx:output "(69, False, ['witness_v0_keyhash'], True)" .
chx:X_ContractStaysOffChain rd:hasIOExample chx:IO_ContractStaysOffChain .
chx:X_ClientSideValidationWalk a owl:NamedIndividual, chx:ClientSideValidationWalk ; rdfs:label "a receiver who checks the history he is handed"@en ; skos:definition "Client-side validation is done by the receiver: handed the history of three steps, an issue and two transfers, the checker recomputed every commitment against the output script on the chain and found all three equal, and a forged contract text did not match."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_ClientSideValidationWalk a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c2']['client_side_validation']; (c['commitments_match'], c['forged_contract_matches'], len(c['history']), [h['contract'].split(':')[0] for h in c['history']], L.has('book_ch14_applications.adoc', 'Dan only needs to receive and validate the parts of history')) evaluates to ([True, True, True], False, 3, ['issue', 'transfer', 'transfer'], True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c2']['client_side_validation']; (c['commitments_match'], c['forged_contract_matches'], len(c['history']), [h['contract'].split(':')[0] for h in c['history']], L.has('book_ch14_applications.adoc', 'Dan only needs to receive and validate the parts of history'))" ; chx:output "([True, True, True], False, 3, ['issue', 'transfer', 'transfer'], True)" .
chx:X_ClientSideValidationWalk rd:hasIOExample chx:IO_ClientSideValidationWalk .
chx:X_ColoredCoinsHistory a owl:NamedIndividual, chx:ColoredCoinsHistory ; rdfs:label "from the 2012 overview to the 2017 seals"@en ; skos:definition "Colored coins are older than the schemes the chapter names: Meni Rosenfeld's overview is dated 4 December 2012, Peter Todd's description of scalable asset transfer with single-use seals is dated 5 December 2017, and five years separate them."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_ColoredCoinsHistory a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); (L.has('rosenfeld_colored_coins_2012.pdf', 'December 4, 2012'), L.has('todd_single_use_seals_2017.html', 'Dec 5, 2017'), L.has('bitcoinwiki_colored_coins.html', 'loosely describes a class of methods'), 2017 - 2012, L.has('book_ch14_applications.adoc', 'Enhanced Padded-Order-Based Coloring')) evaluates to (True, True, True, 5, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); (L.has('rosenfeld_colored_coins_2012.pdf', 'December 4, 2012'), L.has('todd_single_use_seals_2017.html', 'Dec 5, 2017'), L.has('bitcoinwiki_colored_coins.html', 'loosely describes a class of methods'), 2017 - 2012, L.has('book_ch14_applications.adoc', 'Enhanced Padded-Order-Based Coloring'))" ; chx:output "(True, True, True, 5, True)" .
chx:X_ColoredCoinsHistory rd:hasIOExample chx:IO_ColoredCoinsHistory .
chx:X_RgbAndTaprootAssets a owl:NamedIndividual, chx:RgbAndTaprootAssets ; rdfs:label "two protocols built on seals, tweaks and validation"@en ; skos:definition "RGB and Taproot Assets are the two protocols the chapter names; the saved pages of both still describe them, the Optech topic on client-side validation lists both, and the book's own note that Taproot Assets is not part of the Bitcoin protocol is in the saved text."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_RgbAndTaprootAssets a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); (L.has('rgb_tech.html', 'Post-blockchain smart contracts'), L.has('lightning_engineering_taproot_assets.html', 'Taproot Assets Protocol'), L.has('optech_topic_client_side_validation.html', 'RGB', 'Taproot Assets'), L.has('book_ch14_applications.adoc', '_Taproot_ is part of the Bitcoin protocol'), L.has('book_ch14_applications.adoc', 'Translated forwarding allows building on the economies of scale')) evaluates to (True, True, True, True, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); (L.has('rgb_tech.html', 'Post-blockchain smart contracts'), L.has('lightning_engineering_taproot_assets.html', 'Taproot Assets Protocol'), L.has('optech_topic_client_side_validation.html', 'RGB', 'Taproot Assets'), L.has('book_ch14_applications.adoc', '_Taproot_ is part of the Bitcoin protocol'), L.has('book_ch14_applications.adoc', 'Translated forwarding allows building on the economies of scale'))" ; chx:output "(True, True, True, True, True)" .
chx:X_RgbAndTaprootAssets rd:hasIOExample chx:IO_RgbAndTaprootAssets .
chx:X_EmmaFabianArithmetic a owl:NamedIndividual, chx:EmmaFabianArithmetic ; rdfs:label "36 millibits for an hour of video at 0.01 per second"@en ; skos:definition "The streaming example is plain arithmetic in satoshis: 0.01 millibit is 1,000 satoshis per second, an hour costs 3,600,000, 600 seconds cost 600,000 and leave 3,000,000, and the hand-built channel of the test chain used the same capacity of 3,600,000 satoshis and paid six seconds."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_EmmaFabianArithmetic a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); rate = 1000; cap = 36 * 100000; (rate * 3600, rate * 3600 == cap, rate * 600, cap - rate * 600, R['c3']['capacity_sat'] == cap, R['c3']['settlement_outputs_sat'][0] // rate) evaluates to (3600000, True, 600000, 3000000, True, 6)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); rate = 1000; cap = 36 * 100000; (rate * 3600, rate * 3600 == cap, rate * 600, cap - rate * 600, R['c3']['capacity_sat'] == cap, R['c3']['settlement_outputs_sat'][0] // rate)" ; chx:output "(3600000, True, 600000, 3000000, True, 6)" .
chx:X_EmmaFabianArithmetic rd:hasIOExample chx:IO_EmmaFabianArithmetic .
chx:X_FundingNeedsBothKeys a owl:NamedIndividual, chx:FundingNeedsBothKeys ; rdfs:label "a 2-of-2 output that one key cannot spend"@en ; skos:definition "The funding output is a 2-of-2 multisignature script of 71 bytes: spent with Emma's signature alone the node refused it, and with both signatures it accepted it, so neither party can move the shared funds alone."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_FundingNeedsBothKeys a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c3']; (c['emma_alone']['reason'].split(' (')[0], c['both_sign']['allowed'], c['witness_script_hex'][:2], c['witness_script_hex'][-4:], c['witness_script_len'], c['funding_vsize']) evaluates to ('mempool-script-verify-flag-failed', True, '52', '52ae', 71, 165)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c3']; (c['emma_alone']['reason'].split(' (')[0], c['both_sign']['allowed'], c['witness_script_hex'][:2], c['witness_script_hex'][-4:], c['witness_script_len'], c['funding_vsize'])" ; chx:output "('mempool-script-verify-flag-failed', True, '52', '52ae', 71, 165)" .
chx:X_FundingNeedsBothKeys rd:hasIOExample chx:IO_FundingNeedsBothKeys .
chx:X_RefundTimelockLadder a owl:NamedIndividual, chx:RefundTimelockLadder ; rdfs:label "six commitments, each with a lock time one block shorter"@en ; skos:definition "With absolute lock times the later commitment can be broadcast first: the six commitments had lock times from 488 down to 483, all were refused as non-final at the start, at height 483 only the sixth was accepted, and once it was mined the earlier ones were refused because their input was gone; 30 days at 144 blocks a day are the book's 4,320 blocks."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_RefundTimelockLadder a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c3']; (c['locktimes'], c['at_start'].count('non-final'), c['tip_l_minus_6']['c6']['reason'], c['tip_l_minus_5']['c6']['allowed'], c['after_c6_mined']['c1_to_c5'], c['after_all_timelocks']['c1'], 30 * 144) evaluates to ([488, 487, 486, 485, 484, 483], 6, 'non-final', True, ['non-final', 'non-final', 'non-final', 'non-final', 'missing-inputs'], 'missing-inputs', 4320)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c3']; (c['locktimes'], c['at_start'].count('non-final'), c['tip_l_minus_6']['c6']['reason'], c['tip_l_minus_5']['c6']['allowed'], c['after_c6_mined']['c1_to_c5'], c['after_all_timelocks']['c1'], 30 * 144)" ; chx:output "([488, 487, 486, 485, 484, 483], 6, 'non-final', True, ['non-final', 'non-final', 'non-final', 'non-final', 'missing-inputs'], 'missing-inputs', 4320)" .
chx:X_RefundTimelockLadder rd:hasIOExample chx:IO_RefundTimelockLadder .
chx:X_AsymmetricCommitment a owl:NamedIndividual, chx:AsymmetricCommitment ; rdfs:label "a delayed output that pays after 1,000 blocks"@en ; skos:definition "In the asymmetric commitment the holder's own output is delayed: the script has a revocation branch and a branch with 1000 and OP_CHECKSEQUENCEVERIFY, a spend with 999 confirmations was refused as non-BIP68-final and with 1000 it was accepted, and a spend without the sequence number was refused."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_AsymmetricCommitment a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c4']; a = c['to_local_script_asm'].split(' '); (a[0], a[3], a[4], a[-1], c['delay_at_999_confirmations']['reason'], c['delay_at_1000_confirmations']['allowed'], c['delay_no_sequence']['reason'].split(' (')[1].rstrip(')'), c['commitment_vsize']) evaluates to ('OP_IF', '1000', 'OP_CHECKSEQUENCEVERIFY', 'OP_CHECKSIG', 'non-BIP68-final', True, 'Locktime requirement not satisfied', 181)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c4']; a = c['to_local_script_asm'].split(' '); (a[0], a[3], a[4], a[-1], c['delay_at_999_confirmations']['reason'], c['delay_at_1000_confirmations']['allowed'], c['delay_no_sequence']['reason'].split(' (')[1].rstrip(')'), c['commitment_vsize'])" ; chx:output "('OP_IF', '1000', 'OP_CHECKSEQUENCEVERIFY', 'OP_CHECKSIG', 'non-BIP68-final', True, 'Locktime requirement not satisfied', 181)" .
chx:X_AsymmetricCommitment rd:hasIOExample chx:IO_AsymmetricCommitment .
chx:X_RevocationNeedsBothHalves a owl:NamedIndividual, chx:RevocationNeedsBothHalves ; rdfs:label "a penalty key of which each party knows half"@en ; skos:definition "The penalty path needs the revocation private key, which is the sum of two halves: with one half the node refused the spend, with both halves it accepted it and the spend was confirmed, and its witness had three items of 72, 1 and 77 bytes in the recorded run."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_RevocationNeedsBothHalves a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c4']; (c['revoke_with_one_half']['reason'].split(' (')[0], c['revoke_with_both_halves']['allowed'], c['revoke_confirmed'], c['revoke_witness_items'], L.has('book_ch14_applications.adoc', 'each party knows only half the revocation secret key')) evaluates to ('mempool-script-verify-flag-failed', True, True, [72, 1, 77], True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c4']; (c['revoke_with_one_half']['reason'].split(' (')[0], c['revoke_with_both_halves']['allowed'], c['revoke_confirmed'], c['revoke_witness_items'], L.has('book_ch14_applications.adoc', 'each party knows only half the revocation secret key'))" ; chx:output "('mempool-script-verify-flag-failed', True, True, [72, 1, 77], True)" .
chx:X_RevocationNeedsBothHalves rd:hasIOExample chx:IO_RevocationNeedsBothHalves .
chx:X_PenaltyTakesEverything a owl:NamedIndividual, chx:PenaltyTakesEverything ; rdfs:label "5 and 5 become 7 and 3, and cheating is punished by 10"@en ; skos:definition "The book's numbers show why cheating does not pay: of 10 coins the cheater would gain 2 by going back from 7 and 3 to 5 and 5, but if he is caught the honest party takes all 10, 3 more than he was owed, and the penalty spend itself was confirmed on the test chain."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_PenaltyTakesEverything a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); h1, i1, h2, i2 = 5, 5, 7, 3; (h1 + i1, i1 - i2, (h1 + i1) - h2, R['c4']['revoke_confirmed'], L.has('book_ch14_applications.adoc', 'If Hitesh cheats, Irene gets BOTH outputs')) evaluates to (10, 2, 3, True, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); h1, i1, h2, i2 = 5, 5, 7, 3; (h1 + i1, i1 - i2, (h1 + i1) - h2, R['c4']['revoke_confirmed'], L.has('book_ch14_applications.adoc', 'If Hitesh cheats, Irene gets BOTH outputs'))" ; chx:output "(10, 2, 3, True, True)" .
chx:X_PenaltyTakesEverything rd:hasIOExample chx:IO_PenaltyTakesEverything .
chx:X_StateIndexBits a owl:NamedIndividual, chx:StateIndexBits ; rdfs:label "a 48-bit state index and its first secret"@en ; skos:definition "A state number of 48 bits allows 2 to the power 48, 281,474,976,710,656 states, about 2.8 times 10 to the 14, and the per-commitment secret of the highest index is derived from the seed by the shachain steps, which gave the BOLT 3 value for a seed of all ff bytes."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_StateIndexBits a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); v = L.shachain_vector('ff' * 32, 2 ** 48 - 1); (2 ** 48, round(2 ** 48 / 1e14, 1), v[:16], L.has('bolt03_transactions.md', 'output: 0x' + v), L.has('book_ch14_applications.adoc', 'more than 281 trillion')) evaluates to (281474976710656, 2.8, '7cc854b54e3e0dcd', True, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); v = L.shachain_vector('ff' * 32, 2 ** 48 - 1); (2 ** 48, round(2 ** 48 / 1e14, 1), v[:16], L.has('bolt03_transactions.md', 'output: 0x' + v), L.has('book_ch14_applications.adoc', 'more than 281 trillion'))" ; chx:output "(281474976710656, 2.8, '7cc854b54e3e0dcd', True, True)" .
chx:X_StateIndexBits rd:hasIOExample chx:IO_StateIndexBits .
chx:X_HtlcSecretBranch a owl:NamedIndividual, chx:HtlcSecretBranch ; rdfs:label "a payment that is released by a 32-byte secret"@en ; skos:definition "The hash branch of the HTLC pays whoever shows the secret and the receiver's signature: the right secret with the receiver's key was accepted, a wrong secret was refused, the right secret with the payer's key was refused, and the secret has 32 bytes."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_HtlcSecretBranch a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); h = R['c5']; (h['claim_with_secret']['allowed'], h['claim_with_wrong_secret']['reason'].split(' (')[1].rstrip(')'), h['claim_with_secret_but_payer_key']['allowed'], h['anyone_with_secret']['allowed'], h['secret_len']) evaluates to (True, 'Script failed an OP_EQUALVERIFY operation', False, True, 32)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); h = R['c5']; (h['claim_with_secret']['allowed'], h['claim_with_wrong_secret']['reason'].split(' (')[1].rstrip(')'), h['claim_with_secret_but_payer_key']['allowed'], h['anyone_with_secret']['allowed'], h['secret_len'])" ; chx:output "(True, 'Script failed an OP_EQUALVERIFY operation', False, True, 32)" .
chx:X_HtlcSecretBranch rd:hasIOExample chx:IO_HtlcSecretBranch .
chx:X_HtlcTimeoutBranch a owl:NamedIndividual, chx:HtlcTimeoutBranch ; rdfs:label "a refund that waits for block 1514"@en ; skos:definition "The time branch refunds the payer only after the lock height: the refund was refused as non-final one block before the lock and accepted at it, 19 blocks after the funding, and a refund transaction with a lower lock time than the script's was refused by the script."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_HtlcTimeoutBranch a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); h = R['c5']; (h['refund_before_timeout']['reason'], h['refund_at_tip_lock_minus_1']['reason'], h['refund_at_tip_lock']['allowed'], h['lock_height'] - h['height_at_funding'], h['claim_after_timeout']['allowed'], h['refund_with_low_locktime_final']['reason'].split(' (')[1].rstrip(')')) evaluates to ('non-final', 'non-final', True, 19, True, 'Locktime requirement not satisfied')"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); h = R['c5']; (h['refund_before_timeout']['reason'], h['refund_at_tip_lock_minus_1']['reason'], h['refund_at_tip_lock']['allowed'], h['lock_height'] - h['height_at_funding'], h['claim_after_timeout']['allowed'], h['refund_with_low_locktime_final']['reason'].split(' (')[1].rstrip(')'))" ; chx:output "('non-final', 'non-final', True, 19, True, 'Locktime requirement not satisfied')" .
chx:X_HtlcTimeoutBranch rd:hasIOExample chx:IO_HtlcTimeoutBranch .
chx:X_HashIsRipemdOfSha a owl:NamedIndividual, chx:HashIsRipemdOfSha ; rdfs:label "20 bytes in the script and 32 in the invoice"@en ; skos:definition "The book writes HASH160 of H in the script but the payment hash is the 32-byte SHA-256 of the secret: the script holds the 20-byte RIPEMD-160 of that hash, as BOLT 3 writes it, and the hand-built contract used it."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_HashIsRipemdOfSha a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); h = R['c5']; (h['hash160_is_ripemd160_of_sha256'], len(h['hash160_hex']) // 2, len(h['sha256_payment_hash']) // 2, L.has('bolt03_transactions.md', 'RIPEMD160(SHA256(revocationpubkey))'), L.has('book_ch14_applications.adoc', 'HASH160 <H> EQUALVERIFY'), h['wsh_len_book']) evaluates to (True, 20, 32, True, True, 101)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); h = R['c5']; (h['hash160_is_ripemd160_of_sha256'], len(h['hash160_hex']) // 2, len(h['sha256_payment_hash']) // 2, L.has('bolt03_transactions.md', 'RIPEMD160(SHA256(revocationpubkey))'), L.has('book_ch14_applications.adoc', 'HASH160 <H> EQUALVERIFY'), h['wsh_len_book'])" ; chx:output "(True, 20, 32, True, True, 101)" .
chx:X_HashIsRipemdOfSha rd:hasIOExample chx:IO_HashIsRipemdOfSha .
chx:X_FeeArithmetic a owl:NamedIndividual, chx:FeeArithmetic ; rdfs:label "1 coin and 0.003 of fees through three intermediaries"@en ; skos:definition "The routed payment of the book is a staircase of amounts: with a fee of 0.001 from each of three intermediaries the sender must offer 1.003, and on the test network of five lnd nodes with that fee the payment of 1 bitcoin cost 300,000 satoshis in fees with the hop amounts the book gives."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_FeeArithmetic a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); h = R['l2']['htlcs'][0]; a = [int(x['amt_to_forward_msat']) // 1000 for x in h['hops']]; s = L.route_fees(100_000_000, [100_000] * 3)[0]; (s, a, s[1:] + [100_000_000] == a[:3], int(h['total_fees_msat']) // 1000, L.route_fees(1000, [1, 1, 1])[0], R['l1']['graph_ready']) evaluates to ([100300000, 100200000, 100100000], [100200000, 100100000, 100000000, 100000000], True, 300000, [1003, 1002, 1001], True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); h = R['l2']['htlcs'][0]; a = [int(x['amt_to_forward_msat']) // 1000 for x in h['hops']]; s = L.route_fees(100_000_000, [100_000] * 3)[0]; (s, a, s[1:] + [100_000_000] == a[:3], int(h['total_fees_msat']) // 1000, L.route_fees(1000, [1, 1, 1])[0], R['l1']['graph_ready'])" ; chx:output "([100300000, 100200000, 100100000], [100200000, 100100000, 100000000, 100000000], True, 300000, [1003, 1002, 1001], True)" .
chx:X_FeeArithmetic rd:hasIOExample chx:IO_FeeArithmetic .
chx:X_TimelockStaircase a owl:NamedIndividual, chx:TimelockStaircase ; rdfs:label "timeouts of 10, 9, 8 and 7 blocks against a delta of 80"@en ; skos:definition "Every hop must have more time than the next: the book's timeouts of 10, 9, 8 and 7 blocks follow from a delta of one block, while the lnd nodes used the delta of 80 blocks that is their default, so the expiries on the real route stepped down by 80."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_TimelockStaircase a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); h = R['l2']['htlcs'][0]; e = [x['expiry'] for x in h['hops']]; (L.timelocks(7, [1, 1, 1]) + [7], [p - q for p, q in zip(e, e[1:])], h['total_time_lock'] - e[0], R['l2']['invoice']['cltv_expiry'], L.has('lnd_sample_lnd.conf.txt', 'bitcoin.timelockdelta=80')) evaluates to ([10, 9, 8, 7], [80, 80, 0], 80, '80', True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); h = R['l2']['htlcs'][0]; e = [x['expiry'] for x in h['hops']]; (L.timelocks(7, [1, 1, 1]) + [7], [p - q for p, q in zip(e, e[1:])], h['total_time_lock'] - e[0], R['l2']['invoice']['cltv_expiry'], L.has('lnd_sample_lnd.conf.txt', 'bitcoin.timelockdelta=80'))" ; chx:output "([10, 9, 8, 7], [80, 80, 0], 80, '80', True)" .
chx:X_TimelockStaircase rd:hasIOExample chx:IO_TimelockStaircase .
chx:X_BalancesAfterPayment a owl:NamedIndividual, chx:BalancesAfterPayment ; rdfs:label "only the endpoints and the fees change"@en ; skos:definition "After the payment the intermediaries are not at a loss: the balance of each intermediary rose by its fee, Alice paid 1.003 and Eric received 1 bitcoin, exactly the end state of the book's example."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_BalancesAfterPayment a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); b, a = R['l2']['channels_before'], R['l2']['channels_after']; d = {n: sum(c['local'] for c in a[n]) - sum(c['local'] for c in b[n]) for n in b}; (d, [(c['local'], c['remote']) for c in a['alice']], sum(d.values())) evaluates to ({'alice': -100300000, 'bob': 100000, 'carol': 100000, 'diana': 100000, 'eric': 100000000}, [(99696530, 300300000)], 0)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); b, a = R['l2']['channels_before'], R['l2']['channels_after']; d = {n: sum(c['local'] for c in a[n]) - sum(c['local'] for c in b[n]) for n in b}; (d, [(c['local'], c['remote']) for c in a['alice']], sum(d.values()))" ; chx:output "({'alice': -100300000, 'bob': 100000, 'carol': 100000, 'diana': 100000, 'eric': 100000000}, [(99696530, 300300000)], 0)" .
chx:X_BalancesAfterPayment rd:hasIOExample chx:IO_BalancesAfterPayment .
chx:X_HoldInvoiceInFlight a owl:NamedIndividual, chx:HoldInvoiceInFlight ; rdfs:label "an HTLC held on every hop until the secret is released"@en ; skos:definition "A hold invoice keeps the payment in flight: while the receiver withheld the secret every channel along the route carried a pending HTLC, releasing the secret settled it back along the route, and cancelling the invoice returned all balances unchanged."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_HoldInvoiceInFlight a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); h = R['l3']; n = ['alice', 'bob', 'carol', 'diana', 'eric']; (all(len(h['inflight'][k]) >= 1 for k in n), sorted({p['amount'] for k in n for c in h['inflight'][k] for p in c['pending']}), h['after_settle'] == {k: h['cancel']['balances_before'][k] for k in n}, h['cancel']['balances_before'] == h['cancel']['balances_after'], [h['cancel']['pending_during'][k] for k in n], hashlib.sha256(bytes.fromhex(hashlib.sha256(b'the secret R of the Lightning example').hexdigest())).hexdigest() == h['hash'], h['settled_status']) evaluates to (True, [10000000, 10100000, 10200000, 10300000], True, True, [1, 2, 2, 2, 1], True, 'SUCCEEDED')"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); h = R['l3']; n = ['alice', 'bob', 'carol', 'diana', 'eric']; (all(len(h['inflight'][k]) >= 1 for k in n), sorted({p['amount'] for k in n for c in h['inflight'][k] for p in c['pending']}), h['after_settle'] == {k: h['cancel']['balances_before'][k] for k in n}, h['cancel']['balances_before'] == h['cancel']['balances_after'], [h['cancel']['pending_during'][k] for k in n], hashlib.sha256(bytes.fromhex(hashlib.sha256(b'the secret R of the Lightning example').hexdigest())).hexdigest() == h['hash'], h['settled_status'])" ; chx:output "(True, [10000000, 10100000, 10200000, 10300000], True, True, [1, 2, 2, 2, 1], True, 'SUCCEEDED')" .
chx:X_HoldInvoiceInFlight rd:hasIOExample chx:IO_HoldInvoiceInFlight .
chx:X_InvoiceStructure a owl:NamedIndividual, chx:InvoiceStructure ; rdfs:label "a bech32 string with the hash H of the secret R"@en ; skos:definition "The invoice is the payment request of the book: a bech32 string of the BOLT 11 format whose human-readable part names the network and the amount, and whose fields hold the payment hash, the payment secret and the expiry; the secret released later hashed to the payment hash."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_InvoiceStructure a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); i = R['l2']['invoice']; p = L.C.bolt11(i['payment_request']); (p['hrp'], p['msat'], L.C.field_bytes(p['fields']['p'][0]).hex() == i['payment_hash'], L.C.field_int(p['fields']['x'][0]) == int(i['expiry']), L.C.field_bytes(p['fields']['s'][0]).hex() == i['payment_addr'], hashlib.sha256(bytes.fromhex(R['l2']['preimage'])).hexdigest() == i['payment_hash'], L.C.field_int(p['fields']['c'][0])) evaluates to ('lnbcrt1', 100000000000, True, True, True, True, 80)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); i = R['l2']['invoice']; p = L.C.bolt11(i['payment_request']); (p['hrp'], p['msat'], L.C.field_bytes(p['fields']['p'][0]).hex() == i['payment_hash'], L.C.field_int(p['fields']['x'][0]) == int(i['expiry']), L.C.field_bytes(p['fields']['s'][0]).hex() == i['payment_addr'], hashlib.sha256(bytes.fromhex(R['l2']['preimage'])).hexdigest() == i['payment_hash'], L.C.field_int(p['fields']['c'][0]))" ; chx:output "('lnbcrt1', 100000000000, True, True, True, True, 80)" .
chx:X_InvoiceStructure rd:hasIOExample chx:IO_InvoiceStructure .
chx:X_NoiseHandshakeVector a owl:NamedIndividual, chx:NoiseHandshakeVector ; rdfs:label "three acts and two keys from fixed test keys"@en ; skos:definition "The transport of BOLT 8 is a Noise handshake of three acts: from the published test keys a Python initiator produced the 50-byte first act and the 66-byte third act of the vector and the sending key 969ab31b."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_NoiseHandshakeVector a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); b = L.bolt8(); (b['act1'] == b['want_act1'], b['act3'] == b['want_act3'], b['sk'] == b['want_sk'], (len(b['act1']) - 2) // 2, (len(b['act3']) - 2) // 2, L.has('wikipedia_noise_protocol.html', 'Framework for cryptographic protocols')) evaluates to (True, True, True, 50, 66, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); b = L.bolt8(); (b['act1'] == b['want_act1'], b['act3'] == b['want_act3'], b['sk'] == b['want_sk'], (len(b['act1']) - 2) // 2, (len(b['act3']) - 2) // 2, L.has('wikipedia_noise_protocol.html', 'Framework for cryptographic protocols'))" ; chx:output "(True, True, True, 50, 66, True)" .
chx:X_NoiseHandshakeVector rd:hasIOExample chx:IO_NoiseHandshakeVector .
chx:X_TransportMessageVector a owl:NamedIndividual, chx:TransportMessageVector ; rdfs:label "the word hello in 39 bytes"@en ; skos:definition "After the handshake each message is an encrypted length and an encrypted body: the 5 bytes hello became 39 bytes, 2 plus 16 plus 5 plus 16, and equalled the ciphertext of the vector."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_TransportMessageVector a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c, n = L.bolt8_hello(); (c == '0xcf2b30ddf0cf3f80e7c35a6e6730b59fe802473180f396d88a8fb0db8cbcf25d2f214cf9ea1d95', n, n == 2 + 16 + 5 + 16, L.has('bolt08_transport.md', 'hello')) evaluates to (True, 39, True, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c, n = L.bolt8_hello(); (c == '0xcf2b30ddf0cf3f80e7c35a6e6730b59fe802473180f396d88a8fb0db8cbcf25d2f214cf9ea1d95', n, n == 2 + 16 + 5 + 16, L.has('bolt08_transport.md', 'hello'))" ; chx:output "(True, 39, True, True)" .
chx:X_TransportMessageVector rd:hasIOExample chx:IO_TransportMessageVector .
chx:X_OnionPacketVector a owl:NamedIndividual, chx:OnionPacketVector ; rdfs:label "a 1366-byte packet for five hops"@en ; skos:definition "The Sphinx onion of BOLT 4 was rebuilt from the session key, the five hop keys and the payloads of the published vector and equalled the vector's packet byte for byte; its length is 1366 bytes."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_OnionPacketVector a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); mine, want, hops = L.onion(); (mine == want, len(mine) // 2, hops, L.has('bolt04_onion_routing.md', 'a 1300-byte `hop_payloads`')) evaluates to (True, 1366, 5, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); mine, want, hops = L.onion(); (mine == want, len(mine) // 2, hops, L.has('bolt04_onion_routing.md', 'a 1300-byte `hop_payloads`'))" ; chx:output "(True, 1366, 5, True)" .
chx:X_OnionPacketVector rd:hasIOExample chx:IO_OnionPacketVector .
chx:X_OnionFixedSize a owl:NamedIndividual, chx:OnionFixedSize ; rdfs:label "the same size for one hop and for five"@en ; skos:definition "The packet does not shorten along the path: built with one, two or five hops it is always 1366 bytes, one version byte, a 33-byte key, 1300 bytes of payloads and a 32-byte HMAC, so a node cannot read its place in the path from the size."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_OnionFixedSize a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); [L.onion_size(n) for n in (1, 2, 5)] + [1 + 33 + 1300 + 32] evaluates to [1366, 1366, 1366, 1366]"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); [L.onion_size(n) for n in (1, 2, 5)] + [1 + 33 + 1300 + 32]" ; chx:output "[1366, 1366, 1366, 1366]" .
chx:X_OnionFixedSize rd:hasIOExample chx:IO_OnionFixedSize .
chx:X_OnionIntegrityByHmac a owl:NamedIndividual, chx:OnionIntegrityByHmac ; rdfs:label "one flipped bit and the packet is refused"@en ; skos:definition "The first hop checks the HMAC over the routing bytes and the associated data with a key from its shared secret: the vector packet passed, and the same packet with one bit flipped at the start or at the end of the 1300 bytes failed."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_OnionIntegrityByHmac a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); o = L.onion()[0]; (L.onion_hmac_ok(o), L.onion_hmac_ok(o, 0), L.onion_hmac_ok(o, 1299 * 8 + 7), L.has('book_ch14_applications.adoc', 'Intermediate nodes can verify and decrypt their portion of route information')) evaluates to (True, False, False, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); o = L.onion()[0]; (L.onion_hmac_ok(o), L.onion_hmac_ok(o, 0), L.onion_hmac_ok(o, 1299 * 8 + 7), L.has('book_ch14_applications.adoc', 'Intermediate nodes can verify and decrypt their portion of route information'))" ; chx:output "(True, False, False, True)" .
chx:X_OnionIntegrityByHmac rd:hasIOExample chx:IO_OnionIntegrityByHmac .
chx:X_InvoiceVector a owl:NamedIndividual, chx:InvoiceVector ; rdfs:label "0.0025 BTC for a cup of coffee in 60 seconds"@en ; skos:definition "The BOLT 11 example for a cup of coffee was parsed by the Python decoder: the prefix lnbc2500u means 2500 micro-bitcoin, which is 250,000,000 millisatoshi or 250,000 satoshis, with a 32-byte payment hash, an expiry of 60 seconds and a 65-byte signature."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_InvoiceVector a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); i = L.invoice(); (i['hrp'], i['msat'], i['msat'] // 1000, L.iso(i['timestamp']), len(L.C.field_bytes(i['fields']['p'][0])), L.C.field_int(i['fields']['x'][0]), len(i['sig'])) evaluates to ('lnbc2500u', 250000000, 250000, '2017-06-01 10:57:38', 32, 60, 65)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); i = L.invoice(); (i['hrp'], i['msat'], i['msat'] // 1000, L.iso(i['timestamp']), len(L.C.field_bytes(i['fields']['p'][0])), L.C.field_int(i['fields']['x'][0]), len(i['sig']))" ; chx:output "('lnbc2500u', 250000000, 250000, '2017-06-01 10:57:38', 32, 60, 65)" .
chx:X_InvoiceVector rd:hasIOExample chx:IO_InvoiceVector .
chx:X_FundingOutputIsMultisig a owl:NamedIndividual, chx:FundingOutputIsMultisig ; rdfs:label "a witness script hash for two sorted keys"@en ; skos:definition "The lnd funding output is a pay-to-witness-script-hash of a 2-of-2 multisignature script, and BOLT 3 sorts the two keys, which the key order in the script on the test chain showed."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_FundingOutputIsMultisig a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); f = R['l4']['funding']; s = R['l4']['close']['witness_script_asm'].split(' '); (f['type'], f['value'], s[0], s[3], s[4], s[1] < s[2], len(s[1]) // 2, R['l1']['funding_output'][0][1]['type']) evaluates to ('witness_v0_scripthash', 4.0, '2', '2', 'OP_CHECKMULTISIG', True, 33, 'witness_v0_scripthash')"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); f = R['l4']['funding']; s = R['l4']['close']['witness_script_asm'].split(' '); (f['type'], f['value'], s[0], s[3], s[4], s[1] < s[2], len(s[1]) // 2, R['l1']['funding_output'][0][1]['type'])" ; chx:output "('witness_v0_scripthash', 4.0, '2', '2', 'OP_CHECKMULTISIG', True, 33, 'witness_v0_scripthash')" .
chx:X_FundingOutputIsMultisig rd:hasIOExample chx:IO_FundingOutputIsMultisig .
chx:X_CommitmentTransactionShape a owl:NamedIndividual, chx:CommitmentTransactionShape ; rdfs:label "a force-closed commitment with two anchors"@en ; skos:definition "A commitment transaction of lnd is an ordinary transaction with the BOLT 3 marks: an obscured commitment number in the lock time and the sequence, four outputs of which two are anchors of 330 satoshis, and the funding script as the witness script."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_CommitmentTransactionShape a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['l5']['revoked_commitment']; (hex(c['locktime'] >> 24), hex(c['sequence'] >> 24), (((c['sequence'] & 0xffffff) << 24) | (c['locktime'] & 0xffffff)) < 2 ** 48, len(c['outputs']), [round(o['value'] * 1e8) for o in c['outputs'] if o['value'] < 1e-4], c['witness_items'], c['vsize'], c['version']) evaluates to ('0x20', '0x80', True, 4, [330, 330], [0, 71, 72, 71], 279, 2)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['l5']['revoked_commitment']; (hex(c['locktime'] >> 24), hex(c['sequence'] >> 24), (((c['sequence'] & 0xffffff) << 24) | (c['locktime'] & 0xffffff)) < 2 ** 48, len(c['outputs']), [round(o['value'] * 1e8) for o in c['outputs'] if o['value'] < 1e-4], c['witness_items'], c['vsize'], c['version'])" ; chx:output "('0x20', '0x80', True, 4, [330, 330], [0, 71, 72, 71], 279, 2)" .
chx:X_CommitmentTransactionShape rd:hasIOExample chx:IO_CommitmentTransactionShape .
chx:X_RevocationKeyVector a owl:NamedIndividual, chx:RevocationKeyVector ; rdfs:label "the penalty key from two secrets"@en ; skos:definition "The BOLT 3 derivation of the revocation key needs both the revocation base secret and the per-commitment secret: from the published secrets the Python code gave the local key, the revocation public key and the revocation private key of the appendix."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_RevocationKeyVector a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); L.bolt3_keys() evaluates to (True, True, True, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); L.bolt3_keys()" ; chx:output "(True, True, True, True)" .
chx:X_RevocationKeyVector rd:hasIOExample chx:IO_RevocationKeyVector .
chx:X_CooperativeCloseIsOneTx a owl:NamedIndividual, chx:CooperativeCloseIsOneTx ; rdfs:label "a close without a timelock"@en ; skos:definition "A cooperative close puts one transaction on the chain without lock time or delay: the channel lived on two on-chain transactions, the funding and this closing one, whose outputs paid the final balances."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_CooperativeCloseIsOneTx a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['l4']['close']; (c['locktime'], c['sequence'] == 0xffffffff, [o['type'] for o in c['outputs']], round(sum(o['value'] for o in c['outputs']) * 1e8), R['l4']['onchain_transactions_in_lifetime'], c['witness_items'][0], c['vsize']) evaluates to (0, True, ['witness_v1_taproot', 'witness_v1_taproot'], 399995175, 2, 0, 193)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['l4']['close']; (c['locktime'], c['sequence'] == 0xffffffff, [o['type'] for o in c['outputs']], round(sum(o['value'] for o in c['outputs']) * 1e8), R['l4']['onchain_transactions_in_lifetime'], c['witness_items'][0], c['vsize'])" ; chx:output "(0, True, ['witness_v1_taproot', 'witness_v1_taproot'], 399995175, 2, 0, 193)" .
chx:X_CooperativeCloseIsOneTx rd:hasIOExample chx:IO_CooperativeCloseIsOneTx .
chx:X_BreachJusticeTransaction a owl:NamedIndividual, chx:BreachJusticeTransaction ; rdfs:label "the old state broadcast and the whole channel taken"@en ; skos:definition "When Irene's node, restored to an old state, broadcast the revoked commitment, Hitesh's node answered with a justice transaction that spent its penalty output, as the chapter's penalty rule says."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_BreachJusticeTransaction a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); l = R['l5']; j = l['justice']; (l['state2']['hitesh'], l['state2']['irene'], l['hitesh_closed'][0]['close_type'], len(j['inputs']), [i['witness_items'] for i in j['inputs']], round(j['outputs'][0]['value'] * 1e8), l['hitesh_wallet_after_sat'] - l['hitesh_wallet_before_sat'] - 1_000_000_000) evaluates to (700000000, 299996530, 'BREACH_CLOSE', 2, [[72, 37], [72, 1, 77]], 999990380, -9620)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); l = R['l5']; j = l['justice']; (l['state2']['hitesh'], l['state2']['irene'], l['hitesh_closed'][0]['close_type'], len(j['inputs']), [i['witness_items'] for i in j['inputs']], round(j['outputs'][0]['value'] * 1e8), l['hitesh_wallet_after_sat'] - l['hitesh_wallet_before_sat'] - 1_000_000_000)" ; chx:output "(700000000, 299996530, 'BREACH_CLOSE', 2, [[72, 37], [72, 1, 77]], 999990380, -9620)" .
chx:X_BreachJusticeTransaction rd:hasIOExample chx:IO_BreachJusticeTransaction .
chx:X_MainnetGraphSize a owl:NamedIndividual, chx:MainnetGraphSize ; rdfs:label "32,518 channels and 16,225 nodes on a day in August 2026"@en ; skos:definition "The public network that the book calls proposed has, on the statistics page, 32,518 channels, 16,225 nodes and a capacity of 375,370,668,018 satoshis on 30 August 2026, which is about 3,753.7 bitcoin."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_MainnetGraphSize a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); s = L.jload('mempool_lightning_statistics.json')['latest']; (s['channel_count'], s['node_count'], s['total_capacity'], round(s['total_capacity'] / 1e8, 1), round(2 * s['channel_count'] / s['node_count'], 1), s['added'][:10], L.raw('mempool_tip_height.txt')) evaluates to (32518, 16225, 375370668018, 3753.7, 4.0, '2026-08-30', '971604')"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); s = L.jload('mempool_lightning_statistics.json')['latest']; (s['channel_count'], s['node_count'], s['total_capacity'], round(s['total_capacity'] / 1e8, 1), round(2 * s['channel_count'] / s['node_count'], 1), s['added'][:10], L.raw('mempool_tip_height.txt'))" ; chx:output "(32518, 16225, 375370668018, 3753.7, 4.0, '2026-08-30', '971604')" .
chx:X_MainnetGraphSize rd:hasIOExample chx:IO_MainnetGraphSize .
chx:X_ChapterAnchorErratum a owl:NamedIndividual, chx:ChapterAnchorErratum ; rdfs:label "an anchor named ch12 in chapter 14"@en ; skos:definition "The source file of chapter 14 begins with the anchor [[ch12]] while the file of chapter 12 begins with [[mining]], and the book's errata appendix, which is about the whitepaper, does not mention it."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_ChapterAnchorErratum a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); t = L.text('book_ch14_applications.adoc'); u = L.text('book_ch12_mining.adoc'); (t[:8], u[:10], t.count('[[ch12]]'), 'ch12' in L.text('book_appb_errata.adoc'), 'Whitepaper' in L.text('book_appb_errata.adoc')) evaluates to ('[[ch12]]', '[[mining]]', 1, False, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); t = L.text('book_ch14_applications.adoc'); u = L.text('book_ch12_mining.adoc'); (t[:8], u[:10], t.count('[[ch12]]'), 'ch12' in L.text('book_appb_errata.adoc'), 'Whitepaper' in L.text('book_appb_errata.adoc'))" ; chx:output "('[[ch12]]', '[[mining]]', 1, False, True)" .
chx:X_ChapterAnchorErratum rd:hasIOExample chx:IO_ChapterAnchorErratum .
chx:X_LightningNoLongerProposed a owl:NamedIndividual, chx:LightningNoLongerProposed ; rdfs:label "a proposed network that carries billions of satoshis"@en ; skos:definition "The chapter calls the Lightning Network a proposed network; the same saved page of the statistics service counts its channels and nodes, and Wikipedia says that Lightning Labs launched it in 2018."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_LightningNoLongerProposed a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); s = L.jload('mempool_lightning_statistics.json')['latest']; (L.has('book_ch14_applications.adoc', 'is a proposed routed network'), L.has('wikipedia_lightning_network.html', 'Lightning Labs launched the Lightning Network in 2018'), s['channel_count'], s['node_count'], s['added'][:10]) evaluates to (True, True, 32518, 16225, '2026-08-30')"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); s = L.jload('mempool_lightning_statistics.json')['latest']; (L.has('book_ch14_applications.adoc', 'is a proposed routed network'), L.has('wikipedia_lightning_network.html', 'Lightning Labs launched the Lightning Network in 2018'), s['channel_count'], s['node_count'], s['added'][:10])" ; chx:output "(True, True, 32518, 16225, '2026-08-30')" .
chx:X_LightningNoLongerProposed rd:hasIOExample chx:IO_LightningNoLongerProposed .
chx:X_WhitepaperDate a owl:NamedIndividual, chx:WhitepaperDate ; rdfs:label "February 2015 in the book, January 2016 in the draft"@en ; skos:definition "The book dates the first description to February 2015; the saved Wikipedia text agrees and cites a copy archived on 28 February 2015, while the draft of the paper kept at lightning.network is version 0.5.9.2 of 14 January 2016, 320 days later."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_WhitepaperDate a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); (L.has('wikipedia_lightning_network.html', 'white paper in February 2015'), L.has('wikipedia_lightning_network.html', 'Archived from the original on 2015-02-28'), L.has('poon_dryja_lightning_paper.pdf', 'January 14, 2016', 'Version 0.5.9.2'), (datetime.date(2016, 1, 14) - datetime.date(2015, 2, 28)).days, L.has('book_ch14_applications.adoc', 'in February 2015')) evaluates to (True, True, True, 320, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); (L.has('wikipedia_lightning_network.html', 'white paper in February 2015'), L.has('wikipedia_lightning_network.html', 'Archived from the original on 2015-02-28'), L.has('poon_dryja_lightning_paper.pdf', 'January 14, 2016', 'Version 0.5.9.2'), (datetime.date(2016, 1, 14) - datetime.date(2015, 2, 28)).days, L.has('book_ch14_applications.adoc', 'in February 2015'))" ; chx:output "(True, True, True, 320, True)" .
chx:X_WhitepaperDate rd:hasIOExample chx:IO_WhitepaperDate .
chx:X_CsvDelayThousandVersus2016 a owl:NamedIndividual, chx:CsvDelayThousandVersus2016 ; rdfs:label "1,000 blocks in the book, 2016 on the lnd channels"@en ; skos:definition "The book's revocable delay is 1,000 blocks, which the hand-built channel enforced to the block, while the channels of lnd on the test network reported a delay of 2016 blocks, two weeks, and a reserve of one percent of the capacity."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_CsvDelayThousandVersus2016 a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['l2']['channels_after']['alice'][0]; (R['c4']['delay_blocks'], R['l5']['state1']['csv_delay'], c['csv_delay'], c['reserve_local'] * 100 == c['capacity'], round(c['csv_delay'] * 10 / 1440, 1), L.has('book_ch14_applications.adoc', 'timelock of 1,000 blocks')) evaluates to (1000, 2016, 2016, True, 14.0, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['l2']['channels_after']['alice'][0]; (R['c4']['delay_blocks'], R['l5']['state1']['csv_delay'], c['csv_delay'], c['reserve_local'] * 100 == c['capacity'], round(c['csv_delay'] * 10 / 1440, 1), L.has('book_ch14_applications.adoc', 'timelock of 1,000 blocks'))" ; chx:output "(1000, 2016, 2016, True, 14.0, True)" .
chx:X_CsvDelayThousandVersus2016 rd:hasIOExample chx:IO_CsvDelayThousandVersus2016 .
chx:X_BookFeeVersusNetworkFee a owl:NamedIndividual, chx:BookFeeVersusNetworkFee ; rdfs:label "0.3 percent in the book, 0.03 percent at the median today"@en ; skos:definition "The book's fee of 0.001 per hop is 0.3 percent of the payment over three hops, while the statistics page of the public network gives a median base fee of 500 millisatoshi and a median rate of 100 parts per million, which for the same payment of 1 bitcoin over three hops comes to about 30,001 satoshis, 0.03 percent."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_BookFeeVersusNetworkFee a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); s = L.jload('mempool_lightning_statistics.json')['latest']; hop = lambda amt: s['med_base_fee_mtokens'] / 1000 + amt * s['med_fee_rate'] / 1_000_000; (s['med_base_fee_mtokens'], s['med_fee_rate'], 3 * hop(100_000_000), round(3 * hop(100_000_000) / 100_000_000 * 100, 3), 300_000 / 100_000_000 * 100) evaluates to (500, 100, 30001.5, 0.03, 0.3)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); s = L.jload('mempool_lightning_statistics.json')['latest']; hop = lambda amt: s['med_base_fee_mtokens'] / 1000 + amt * s['med_fee_rate'] / 1_000_000; (s['med_base_fee_mtokens'], s['med_fee_rate'], 3 * hop(100_000_000), round(3 * hop(100_000_000) / 100_000_000 * 100, 3), 300_000 / 100_000_000 * 100)" ; chx:output "(500, 100, 30001.5, 0.03, 0.3)" .
chx:X_BookFeeVersusNetworkFee rd:hasIOExample chx:IO_BookFeeVersusNetworkFee .
chx:X_TrucAndAnchors a owl:NamedIndividual, chx:TrucAndAnchors ; rdfs:label "a zero-fee parent paid for by its child"@en ; skos:definition "Since Bitcoin Core 28.0 a version-3 parent with a zero-value pay-to-anchor output can be sent with its child as a package: alone the parent was refused for its minimum relay fee, together the package was accepted with an effective rate of about 10.9 satoshis per virtual byte."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_TrucAndAnchors a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c6']; r = c['package']['ok']['tx-results']; (c['parent_alone']['reject-reason'], c['package_msg'], c['anchor_witness_len'], c['both_confirmed'], round(max(v['fees']['effective-feerate'] for v in r.values()) * 1e5, 1), c['parent_vsize'], c['child_vsize'], L.has('core_relnotes_28.0.md', 'Pay To Anchor (P2A) is a new standard witness output type')) evaluates to ('min relay fee not met', 'success', 0, True, 10.9, 123, 151, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); c = R['c6']; r = c['package']['ok']['tx-results']; (c['parent_alone']['reject-reason'], c['package_msg'], c['anchor_witness_len'], c['both_confirmed'], round(max(v['fees']['effective-feerate'] for v in r.values()) * 1e5, 1), c['parent_vsize'], c['child_vsize'], L.has('core_relnotes_28.0.md', 'Pay To Anchor (P2A) is a new standard witness output type'))" ; chx:output "('min relay fee not met', 'success', 0, True, 10.9, 123, 151, True)" .
chx:X_TrucAndAnchors rd:hasIOExample chx:IO_TrucAndAnchors .
chx:X_FullRbfIsStandard a owl:NamedIndividual, chx:FullRbfIsStandard ; rdfs:label "replacement without a signal"@en ; skos:definition "Release 28.0 changed the default of the mempoolfullrbf option from 0 to 1, and the option is no longer in the help of 31.1; on the test chain the higher-fee replacement of the double spend was accepted."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_FullRbfIsStandard a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); (R['c1']['double_spend']['second_higher_fee'], L.has('core_relnotes_28.0.md', 'The default value of the `-mempoolfullrbf` configuration option has been changed from 0 to 1'), L.has('bitcoind_help_31.1.txt', '-mempoolfullrbf'), L.has('bip-0125.mediawiki', 'opt-in full Replace-by-Fee')) evaluates to ('replaced the first', True, False, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); (R['c1']['double_spend']['second_higher_fee'], L.has('core_relnotes_28.0.md', 'The default value of the `-mempoolfullrbf` configuration option has been changed from 0 to 1'), L.has('bitcoind_help_31.1.txt', '-mempoolfullrbf'), L.has('bip-0125.mediawiki', 'opt-in full Replace-by-Fee'))" ; chx:output "('replaced the first', True, False, True)" .
chx:X_FullRbfIsStandard rd:hasIOExample chx:IO_FullRbfIsStandard .
chx:X_ProposalsStillDrafts a owl:NamedIndividual, chx:ProposalsStillDrafts ; rdfs:label "eltoo, PTLCs and templates are drafts or proposals"@en ; skos:definition "The covenant and signature proposals that Lightning designers wait for, BIP 118 and BIP 119, and the topology and anchor rules of BIPs 431 and 433 are still marked as drafts in the saved BIP files, and Optech calls eltoo a proposed mechanism."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_ProposalsStillDrafts a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); (L.has('bip-0118.mediawiki', 'Status: Draft'), L.has('bip-0119.mediawiki', 'Status: Draft'), L.has('bip-0431.mediawiki', 'Status: Draft'), L.has('bip-0433.mediawiki', 'Status: Draft'), L.has('optech_topic_eltoo.html', 'proposed enforcement mechanism'), L.has('optech_topic_ptlc.html', 'Point Time Locked Contracts')) evaluates to (True, True, True, True, True, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); (L.has('bip-0118.mediawiki', 'Status: Draft'), L.has('bip-0119.mediawiki', 'Status: Draft'), L.has('bip-0431.mediawiki', 'Status: Draft'), L.has('bip-0433.mediawiki', 'Status: Draft'), L.has('optech_topic_eltoo.html', 'proposed enforcement mechanism'), L.has('optech_topic_ptlc.html', 'Point Time Locked Contracts'))" ; chx:output "(True, True, True, True, True, True)" .
chx:X_ProposalsStillDrafts rd:hasIOExample chx:IO_ProposalsStillDrafts .
chx:X_OtherImplementations a owl:NamedIndividual, chx:OtherImplementations ; rdfs:label "four teams in the sources, five in the book"@en ; skos:definition "The book says that at least five teams implement the Lightning Network; the saved READMEs show Core Lightning, Eclair and the Lightning Development Kit besides lnd, the only one that was run, in version 0.21.3-beta."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_OtherImplementations a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); (R['l1']['version'].split(' ')[0], L.has('cln_readme.md', 'Core Lightning (previously c-lightning)'), L.has('eclair_readme.md', 'Scala implementation'), L.has('ldk_readme.md', 'runtime-agnostic'), L.has('book_ch14_applications.adoc', 'at least five different open source teams')) evaluates to ('0.21.3-beta', True, True, True, True)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); (R['l1']['version'].split(' ')[0], L.has('cln_readme.md', 'Core Lightning (previously c-lightning)'), L.has('eclair_readme.md', 'Scala implementation'), L.has('ldk_readme.md', 'runtime-agnostic'), L.has('book_ch14_applications.adoc', 'at least five different open source teams'))" ; chx:output "('0.21.3-beta', True, True, True, True)" .
chx:X_OtherImplementations rd:hasIOExample chx:IO_OtherImplementations .
chx:X_LndDefaults a owl:NamedIndividual, chx:LndDefaults ; rdfs:label "17 features and a base fee of 1,000 millisatoshi"@en ; skos:definition "The lnd of the test network advertises features that the chapter does not know, among them anchor commitments with zero-fee HTLC transactions, and its sample configuration sets a base fee of 1000 millisatoshi, a timelock delta of 80 and a minimum channel size of 20,000 satoshis."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_LndDefaults a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); f = R['l1']['features']; (len(f), 'anchors-zero-fee-htlc-tx' in f, 'gossip-queries' in f, L.has('lnd_sample_lnd.conf.txt', 'bitcoin.basefee=1000', 'bitcoin.timelockdelta=80', 'minchansize=20000'), R['l1']['version'].split(' ')[0]) evaluates to (17, True, True, True, '0.21.3-beta')"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); f = R['l1']['features']; (len(f), 'anchors-zero-fee-htlc-tx' in f, 'gossip-queries' in f, L.has('lnd_sample_lnd.conf.txt', 'bitcoin.basefee=1000', 'bitcoin.timelockdelta=80', 'minchansize=20000'), R['l1']['version'].split(' ')[0])" ; chx:output "(17, True, True, True, '0.21.3-beta')" .
chx:X_LndDefaults rd:hasIOExample chx:IO_LndDefaults .
chx:X_WhatWasNotExecuted a owl:NamedIndividual, chx:WhatWasNotExecuted ; rdfs:label "ten things the sandbox could not run"@en ; skos:definition "Ten parts of the chapter's subject were not executed, each with its reason, among them the public network, the other implementations, a watchtower, an HTLC expiring on the chain and the signature of the lnd release."@en ; dcterms:source <http://example.org/sen0401/ch14/research> .
chx:IO_WhatWasNotExecuted a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); n = R['not_executed']; (len(n), n[0]['item'], all(len(i['reason']) > 40 for i in n), len({i['item'] for i in n})) evaluates to (10, 'lightning_on_mainnet', True, 10)"@en ; chx:input "import sys, math, hashlib, datetime; sys.path.insert(0, '08-tooling'); import sen0401_ch14_lib_v1_0_0 as L; R = L.run(); n = R['not_executed']; (len(n), n[0]['item'], all(len(i['reason']) > 40 for i in n), len({i['item'] for i in n}))" ; chx:output "(10, 'lightning_on_mainnet', True, 10)" .
chx:X_WhatWasNotExecuted rd:hasIOExample chx:IO_WhatWasNotExecuted .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 14 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch14/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 14 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which claims of the chapter can be checked by computation, and what does the computation give?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What in the chapter has changed since the book went to print, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 14 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from Mastering Bitcoin 3rd edition's chapter 14 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0401/ch14/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.6, installed with uv on 2026-10-15."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_0_0.py" .

