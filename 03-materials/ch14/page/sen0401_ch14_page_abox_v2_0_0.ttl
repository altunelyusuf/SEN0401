    wp:hasDesignTest "Exercised in headless Chromium by 08-tooling/sen0401_page_test_v9.35.0.py on page 9.57.0: printed \"(10, 'lightning_on_mainnet', True, 10)\"; edited to 2 + 2 printed '4'; card shows \"(10, 'lightning_on_mainnet', True, 10)\"" ;
