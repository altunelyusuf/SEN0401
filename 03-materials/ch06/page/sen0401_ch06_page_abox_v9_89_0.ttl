pg:Q1 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "What is a Bitcoin transaction, in the chapter's definition?"@en ;
    ld:assessesObjective pg:CO2 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "A transaction names outputs and new conditions, never a balance.",
        "Bitcoins are not sent to Bob; full nodes are convinced to change their records, and Bob's software reads the shared record." ;
    ld:hasCorrectOption pg:Q1_O1 ;
    ld:hasOption pg:Q1_O0,
        pg:Q1_O1,
        pg:Q1_O2 .

pg:Q2 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Alice's transaction is 388 hexadecimal characters. How many bytes is that, and how many weight units?"@en ;
    ld:assessesObjective pg:CO1 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "Two hexadecimal characters make one byte, so 388 characters are 194 bytes.",
        "Weight counts the 125 legacy bytes four times and the 69 segwit bytes once: 500 plus 69 is 569." ;
    ld:hasCorrectOption pg:Q2_O1 ;
    ld:hasOption pg:Q2_O0,
        pg:Q2_O1,
        pg:Q2_O2 .

pg:Q3 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "The byte after the version of a transaction is 0x00. What does a modern parser conclude?"@en ;
    ld:assessesObjective pg:CO1 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "A legacy parser would read zero inputs, which no transaction can have; that impossibility is what makes the byte a signal.",
        "The version is always exactly four bytes." ;
    ld:hasCorrectOption pg:Q3_O1 ;
    ld:hasOption pg:Q3_O0,
        pg:Q3_O1,
        pg:Q3_O2 .

pg:Q4 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "An input's sequence is 30 in a version 2 transaction, and the output it spends was confirmed at height 774,958. What is the earliest block that can confirm the spend?"@en ;
    ld:assessesObjective pg:CO3 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "A sequence below 2 to the 31 in a version 2 transaction is a relative timelock, not an ordinary input.",
        "The lock is 30 blocks: 774,958 plus 30 is 774,988, with 29 blocks strictly between." ;
    ld:hasCorrectOption pg:Q4_O1 ;
    ld:hasOption pg:Q4_O0,
        pg:Q4_O1,
        pg:Q4_O2 .

pg:Q5 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Which sequence value does NOT signal BIP125 replaceability?"@en ;
    ld:assessesObjective pg:CO3 ;
    ld:cognitiveLevel ld:Remember ;
    ld:distractorRationale "0xfffffffd is the highest value that signals: at least two below the maximum.",
        "Zero is far below the threshold and signals." ;
    ld:hasCorrectOption pg:Q5_O1 ;
    ld:hasOption pg:Q5_O0,
        pg:Q5_O1,
        pg:Q5_O2 .

pg:Q6 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "A third party replaces OP_2 with OP_PUSH1 0x02 in the input script of Alice's legacy transaction. What changes?"@en ;
    ld:assessesObjective pg:CO4 ;
    ld:cognitiveLevel ld:Analyze ;
    ld:distractorRationale "A legacy signature cannot cover the input script that contains it, so it stays valid.",
        "The script result is the same, but the txid is a hash of the bytes, and the bytes differ." ;
    ld:hasCorrectOption pg:Q6_O1 ;
    ld:hasOption pg:Q6_O0,
        pg:Q6_O1,
        pg:Q6_O2 .

pg:Q7 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "Why could segregated witness be deployed as a soft fork?"@en ;
    ld:assessesObjective pg:CO4 ;
    ld:cognitiveLevel ld:Understand ;
    ld:distractorRationale "New rules only reject more than old rules did, which is the definition of a soft fork.",
        "The witness is excluded from the legacy serialization and from the txid." ;
    ld:hasCorrectOption pg:Q7_O0 ;
    ld:hasOption pg:Q7_O0,
        pg:Q7_O1,
        pg:Q7_O2 .

pg:Q8 a ld:AssessmentItem,
        owl:NamedIndividual ;
    rdfs:label "The chapter says Alice's transaction is in block 774,958. What did two explorers report?"@en ;
    ld:assessesObjective pg:CO5 ;
    ld:cognitiveLevel ld:Apply ;
    ld:distractorRationale "774,957 is the lock time of the previous transaction, not a block it is in.",
        "mempool.space and blockstream.info both place 46620030... in block 775,072." ;
    ld:hasCorrectOption pg:Q8_O1 ;
    ld:hasOption pg:Q8_O0,
        pg:Q8_O1,
        pg:Q8_O2 .

