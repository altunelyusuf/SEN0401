        owl:NamedIndividual ;
    rdfs:label "Detail card"@en ;
    dcterms:source <http://example.org/sen0401/ch06/document> ;
    skos:definition "The detail card at the right opens only when the reader explicitly asks for the details of a concept."@en .

pg:Header a ipo:Header,
        owl:NamedIndividual ;
    rdfs:label "Header with the main menu"@en ;
    dcterms:source <http://example.org/sen0401/ch06/document> ;
    skos:definition "The header at the top holds the main menu, whose items are intro, learn, maps, lab, agents, practice, reference, about."@en .

pg:Layout a ipo:LayoutPattern,
        owl:NamedIndividual ;
    rdfs:label "Explorer, main area and detail card"@en ;
    dcterms:source <http://example.org/sen0401/ch06/document> ;
    skos:definition "The page puts the chapter explorer at the left, the main area in the centre and a detail card at the right that stays closed until the reader asks for a detail."@en .

pg:Main a ipo:MainContent,
        owl:NamedIndividual ;
    rdfs:label "Main area"@en ;
    dcterms:source <http://example.org/sen0401/ch06/document> ;
    skos:definition "The main area shows the chapter content of the selected menu item, with the widgets of its sections inline."@en .

pg:Q1_O0 a ld:AnswerOption ;
    rdfs:label "A message from Alice to Bob that carries the bitcoins"@en .

pg:Q1_O2 a ld:AnswerOption ;
    rdfs:label "A record of Alice's balance signed by her wallet"@en .

pg:Q2_O0 a ld:AnswerOption ;
    rdfs:label "388 bytes and 1,552 weight"@en .

pg:Q2_O2 a ld:AnswerOption ;
    rdfs:label "194 bytes and 776 weight"@en .

pg:Q3_O0 a ld:AnswerOption ;
    rdfs:label "The transaction has no inputs and is invalid"@en .

pg:Q3_O2 a ld:AnswerOption ;
    rdfs:label "The version field is five bytes long"@en .

pg:Q4_O0 a ld:AnswerOption ;
    rdfs:label "774,959"@en .

pg:Q4_O2 a ld:AnswerOption ;
    rdfs:label "775,018"@en .

pg:Q5_O0 a ld:AnswerOption ;
    rdfs:label "0xfffffffd"@en .

pg:Q5_O2 a ld:AnswerOption ;
    rdfs:label "0x00000000"@en .

pg:Q6_O0 a ld:AnswerOption ;
    rdfs:label "Nothing: both encodings put the same number on the stack"@en .

pg:Q6_O2 a ld:AnswerOption ;
    rdfs:label "The signature becomes invalid and the transaction is rejected"@en .

pg:Q7_O1 a ld:AnswerOption ;
    rdfs:label "Because every node upgraded on the same day"@en .

pg:Q7_O2 a ld:AnswerOption ;
    rdfs:label "Because the witness structure is included in the legacy serialization"@en .

pg:Q8_O0 a ld:AnswerOption ;
    rdfs:label "The same block, 774,958"@en .

pg:Q8_O2 a ld:AnswerOption ;
    rdfs:label "Block 774,957, the lock time of the previous transaction"@en .

pg:SectionTree a ipo:TreeNavigation,
        owl:NamedIndividual ;
    rdfs:label "Section tree"@en ;
    dcterms:source <http://example.org/sen0401/ch06/document> ;
    skos:definition "The section tree lists the sections of the chapter by their three levels, and choosing one opens that single section."@en .

pg:Sidebar a ipo:Sidebar,
        owl:NamedIndividual ;
    rdfs:label "Chapter explorer"@en ;
    dcterms:source <http://example.org/sen0401/ch06/document> ;
    skos:definition "The explorer at the left shows the chapter's sections as a tree and keeps pace with the tabs of the main area."@en .

pg:SourceDocument a ipo:SourceDocument,
        owl:NamedIndividual ;
    rdfs:label "Chapter 6 Stage 3 document"@en ;
    ipo:hasLearningObjective pg:CO1,
        pg:CO2,
        pg:CO3,
        pg:CO4,
        pg:CO5 ;
    dcterms:source <http://example.org/sen0401/ch06/document> ;
    skos:definition "The Stage 3 document of chapter 6 is the text this page renders, section for section."@en .

pg:TopMenu a ipo:PrimaryNavigation,
        owl:NamedIndividual ;
    rdfs:label "Main menu"@en ;
    dcterms:source <http://example.org/sen0401/ch06/document> ;
    skos:definition "The main menu is permanently visible at the top and lets the reader reach every top-level area without scrolling or opening anything first."@en .

pg:Q1_O1 a ld:AnswerOption ;
    rdfs:label "The data Alice uses to convince full nodes to update their database of coin ownership"@en .

pg:Q2_O1 a ld:AnswerOption ;
    rdfs:label "194 bytes and 569 weight"@en .

pg:Q3_O1 a ld:AnswerOption ;
    rdfs:label "The transaction is in the extended format: a marker, then a flag, then the real input count"@en .

pg:Q4_O1 a ld:AnswerOption ;
    rdfs:label "774,988"@en .

pg:Q5_O1 a ld:AnswerOption ;
    rdfs:label "0xfffffffe"@en .

pg:Q6_O1 a ld:AnswerOption ;
    rdfs:label "The transaction identifier, so a transaction Bob built on the original output can become invalid"@en .

pg:Q7_O0 a ld:AnswerOption ;
    rdfs:label "Because old nodes see a segwit output as anyone-can-spend and accept an empty input script, while new nodes require a valid witness"@en .

pg:Q8_O1 a ld:AnswerOption ;
    rdfs:label "Block 775,072; 774,958 is the block of the transaction her input spends"@en .

pg:S_AmountField a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Amount"@en ;
    sen0401:anchor "#AmountField" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_AmountField> ;
    skos:definition "The amount is the first field of an output: an 8-byte signed little-endian integer of satoshis, called value in Bitcoin Core; Alice's first output carries 20,000."@en .

pg:S_AmountRange a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The consensus range of an amount"@en ;
    sen0401:anchor "#AmountRange" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_AmountRange> ;
    skos:definition "Consensus allows an output amount from zero to 21 million bitcoins, 2.1 quadrillion satoshis; Bitcoin Core names the maximum MAX_MONEY and refuses negative, oversized and overflowing totals."@en .

pg:S_AnyoneCanSpend a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Anyone-can-spend scripts"@en ;
    sen0401:anchor "#AnyoneCanSpend" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_AnyoneCanSpend> ;
    skos:definition "An anyone-can-spend script is one anyone can satisfy, such as the empty output script spent by an input script of OP_TRUE; upgrades take such a script and add constraints to it."@en .

pg:S_Bip125Signal a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The BIP125 signal"@en ;
    sen0401:anchor "#Bip125Signal" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Bip125Signal> ;
    skos:definition "By BIP125 an unconfirmed transaction with any input whose sequence is below 0xfffffffe, at least two below the maximum, signals that it may be replaced by a conflicting transaction paying a higher fee rate."@en .

pg:S_Bip68Timelock a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "BIP68 relative timelock"@en ;
    sen0401:anchor "#Bip68Timelock" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Bip68Timelock> ;
    skos:definition "Under BIP68 a version 2 input with sequence below 2 to the 31 may only be confirmed once the output it spends has aged by the sequence's value: a lock of 30 blocks allows confirmation with at least 29 blocks between the two."@en .

pg:S_BlockReward a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block reward"@en ;
    sen0401:anchor "#BlockReward" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_BlockReward> ;
    skos:definition "The block reward is the total a miner can claim for a block, the fees of its transactions plus the subsidy; the coinbase's outputs may sum to no more than it."@en .

pg:S_BlockSubsidy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Block subsidy"@en ;
    sen0401:anchor "#BlockSubsidy" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_BlockSubsidy> ;
    skos:definition "The block subsidy is the newly created bitcoin a coinbase may claim: 50 BTC at first, halved every 210,000 blocks and rounded down to the satoshi, so that the total issued is just under 21 million."@en .

pg:S_BlockWeightLimit a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The block weight limit"@en ;
    sen0401:anchor "#BlockWeightLimit" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_BlockWeightLimit> ;
    skos:definition "Blocks are limited to 4,000,000 weight, Bitcoin Core's MAX_BLOCK_WEIGHT; the header and the transaction count take a small fixed share and the rest is for transactions."@en .

pg:S_ByteMap a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Byte map"@en ;
    sen0401:anchor "#ByteMap" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_ByteMap> ;
    skos:definition "A byte map draws a serialized transaction with each field at its byte position and length, so that the hexadecimal can be read as named parts."@en .

pg:S_ByteOrder a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Internal and display byte order"@en ;
    sen0401:anchor "#ByteOrder" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_ByteOrder> ;
    skos:definition "This group explains the book's sidebar on the two byte orders of a hash."@en .

pg:S_CircularDependency a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Circular dependency"@en ;
    sen0401:anchor "#CircularDependency" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_CircularDependency> ;
    skos:definition "A circular dependency arises when Alice and Bob want to sign a refund before the deposit it spends, but in the legacy format the deposit's txid depends on its signatures, so the refund cannot be built until both have signed the deposit."@en .

pg:S_Coinbase a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Coinbase transaction"@en ;
    sen0401:anchor "#Coinbase" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Coinbase> ;
    skos:definition "The coinbase transaction is the first transaction of a block, created by its miner to claim the block's fees and, until the subsidy runs out, newly created bitcoins; older documents call it a generation transaction."@en .

pg:S_CoinbaseField a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The coinbase field"@en ;
    sen0401:anchor "#CoinbaseField" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_CoinbaseField> ;
    skos:definition "The coinbase field is the coinbase transaction's input-script field, 2 to 100 bytes long, not executed, and since BIP34 beginning with a push of the block height; it gives the transaction its name."@en .

pg:S_CoinbaseTransaction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Coinbase transactions"@en ;
    sen0401:anchor "#CoinbaseTransaction" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_CoinbaseTransaction> ;
    skos:definition "The coinbase transaction is the first transaction in each block."@en .

pg:S_CompactSize a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "CompactSize unsigned integer"@en ;
    sen0401:anchor "#CompactSize" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_CompactSize> ;
    skos:definition "A compactSize unsigned integer is one byte for values up to 252 and otherwise a prefix byte 0xfd, 0xfe or 0xff followed by the value as a 2-, 4- or 8-byte little-endian integer."@en .

pg:S_ConflictingTransactions a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Conflicting transactions"@en ;
    sen0401:anchor "#ConflictingTransactions" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_ConflictingTransactions> ;
    skos:definition "Two transactions that each try to spend the same previous output are conflicting transactions; only one of them can be included in a valid blockchain."@en .

pg:S_ConsensusRule a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Consensus rule"@en ;
    sen0401:anchor "#ConsensusRule" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_ConsensusRule> ;
    skos:definition "A consensus rule is a rule every full node enforces identically to decide which blocks and transactions are valid; this chapter's examples are the input and output bounds, the amount range, BIP68, the lock time, the subsidy and the maturity rule."@en .

pg:S_ContractProtocol a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Contract protocols"@en ;
    sen0401:anchor "#ContractProtocol" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_ContractProtocol> ;
    skos:definition "A contract protocol is a series of transactions between parties, often signed out of order so that each party is protected before committing; the payment channel is one, and such protocols exposed the problems with witnesses in the input script."@en .

pg:S_DataCarrierOutput a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Data-carrier output"@en ;
    sen0401:anchor "#DataCarrierOutput" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_DataCarrierOutput> ;
    skos:definition "A data-carrier output is one whose script begins with OP_RETURN; it can never be spent, so nodes need not keep it, and Bitcoin Core's dust policy allows it a value of zero."@en .

pg:S_Digest a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Digest"@en ;
    sen0401:anchor "#Digest" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Digest> ;
    skos:definition "A digest is the output of a hash function; Bitcoin uses digests as identifiers of blocks and transactions, in commitments, and in proof of work."@en .

pg:S_DisableFlag a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The disable flag"@en ;
    sen0401:anchor "#DisableFlag" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_DisableFlag> ;
    skos:definition "The disable flag is bit 31 of the sequence; an input with it set has no relative timelock even in a version 2 transaction, so a transaction may mix locked and unlocked inputs."@en .

pg:S_DisplayByteOrder a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Display byte order"@en ;
    sen0401:anchor "#DisplayByteOrder" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_DisplayByteOrder> ;
    skos:definition "Display byte order is the reversed form in which identifiers are shown to users and accepted by explorers and bitcoin-cli; the book also calls it big-endian."@en .

pg:S_DoubleSha256 a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Double SHA-256"@en ;
    sen0401:anchor "#DoubleSha256" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_DoubleSha256> ;
    skos:definition "Bitcoin's identifiers are double SHA-256: the hash function applied to its own output, so a txid is SHA-256 of SHA-256 of the legacy serialization, shown reversed."@en .

pg:S_DoubleSpendRule a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The rule against double spending"@en ;
    sen0401:anchor "#DoubleSpendRule" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_DoubleSpendRule> ;
    skos:definition "One of Bitcoin's consensus rules forbids any output from being spent more than once within a valid blockchain: Alice cannot use the same previous output to pay both Bob and Carol."@en .

pg:S_DustLimit a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Dust limit"@en ;
    sen0401:anchor "#DustLimit" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_DustLimit> ;
    skos:definition "Bitcoin Core's dust threshold is the size of an output plus the smallest input that could spend it, times the dust relay rate of 3,000 satoshis per kilo-vbyte: 546 satoshis for a legacy P2PKH output, 294 for a P2WPKH output."@en .

pg:S_DustPolicy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Uneconomical outputs and dust"@en ;
    sen0401:anchor "#DustPolicy" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_DustPolicy> ;
    skos:definition "This group explains the outputs that are not worth spending and the relay policy against creating them."@en .

pg:S_ExtendedFormat a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Extended serialization format"@en ;
    sen0401:anchor "#ExtendedFormat" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_ExtendedFormat> ;
    skos:definition "The extended serialization format of BIP144 adds a marker byte, a flag byte and a witness structure to the legacy layout, for transactions that spend segwit outputs."@en .

pg:S_FlagByte a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Flag byte"@en ;
    sen0401:anchor "#FlagByte" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_FlagByte> ;
    skos:definition "The flag is the byte after the marker; it is 0x01 in the current protocol, other values are reserved for upgrades, and BIP144 reads it as a bit vector for adding non-committed data later."@en .

pg:S_Foundations a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Foundations"@en ;
    sen0401:anchor "#Foundations" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Foundations> ;
    skos:definition "This group explains the terms the chapter uses on every page without a section of its own."@en .

pg:S_HardFork a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hard fork"@en ;
    sen0401:anchor "#HardFork" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_HardFork> ;
    skos:definition "A hard fork is a change to the consensus rules that is not compatible with older full nodes; the obvious way to implement segwit needed one, which is why an alternative was sought."@en .

pg:S_HashFunction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Hash function"@en ;
    sen0401:anchor "#HashFunction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_HashFunction> ;
    skos:definition "A hash function maps input of any length to a fixed-length digest, one-way and unpredictable, so that a digest can identify data and commit to it; Bitcoin's is SHA-256, with a 32-byte output."@en .

pg:S_HeightLock a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Lock time as a block height"@en ;
    sen0401:anchor "#HeightLock" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_HeightLock> ;
    skos:definition "A lock time below 500,000,000 is a block height: the transaction can only be included in a block whose height is equal to the lock time or higher, so 123,456 allows block 123,456 and any later one."@en .

pg:S_InputCount a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Input count"@en ;
    sen0401:anchor "#InputCount" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_InputCount> ;
    skos:definition "The input count is the compactSize integer that opens the inputs field; it must be at least one, and transaction size limits keep it to a few thousand in practice."@en .

pg:S_InputList a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The input list"@en ;
    sen0401:anchor "#InputList" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_InputList> ;
    skos:definition "The input list is the inputs field as a whole: a count followed by that many inputs."@en .

pg:S_InputScript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Input script"@en ;
    sen0401:anchor "#InputScript" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_InputScript> ;
    skos:definition "The input script is the legacy field in which a spending transaction places its signatures and other authorising data; a segwit input leaves it empty."@en .

pg:S_InputScriptField a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The input script"@en ;
    sen0401:anchor "#InputScriptField" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_InputScriptField> ;
    skos:definition "The input script is the second field of every input, after the outpoint and before the sequence, and it is length-prefixed."@en .

pg:S_Inputs a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Inputs"@en ;
    sen0401:anchor "#Inputs" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Inputs> ;
    skos:definition "This branch reads the inputs field of a transaction, the 42 bytes of Alice's transaction that say where the bitcoins she spends come from."@en .

pg:S_InternalByteOrder a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Internal byte order"@en ;
    sen0401:anchor "#InternalByteOrder" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_InternalByteOrder> ;
    skos:definition "Internal byte order is the order in which a digest's bytes appear within transactions and blocks and are fed to hash functions; the book also calls it little-endian."@en .

pg:S_LegacyFormat a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Legacy serialization"@en ;
    sen0401:anchor "#LegacyFormat" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_LegacyFormat> ;
    skos:definition "Legacy serialization is the original transaction format, without the marker, flag and witness structure; it is still used for every transaction that spends no witness program."@en .

pg:S_LegacyInputWitness a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "A legacy input's witness"@en ;
    sen0401:anchor "#LegacyInputWitness" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_LegacyInputWitness> ;
    skos:definition "A legacy input in a segwit transaction has a witness stack consisting entirely of a count of zero, 0x00, so the structure stays one stack per input."@en .

pg:S_LengthPrefix a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Script length prefix"@en ;
    sen0401:anchor "#LengthPrefix" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_LengthPrefix> ;
    skos:definition "The length prefix is the compactSize integer before an input script that says how many bytes of script follow; it is 0x6b for the book's 107-byte example and 0x00 for Alice's empty script."@en .

pg:S_LockTime a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Lock time"@en ;
    sen0401:anchor "#LockTime" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_LockTime> ;
    skos:definition "The lock time is the four-byte field that ends every transaction."@en .

pg:S_LockTimeAndCoinbase a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Lock time and the coinbase"@en ;
    sen0401:anchor "#LockTimeAndCoinbase" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch06#S_LockTimeAndCoinbase> ;
    skos:definition "This branch covers the last field of every transaction and the first transaction of every block."@en .

pg:S_LockTimeField a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The lock time field"@en ;
    sen0401:anchor "#LockTimeField" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_LockTimeField> ;
    skos:definition "The lock time is the last 4 bytes of a transaction; zero makes it eligible for any block, and since block 31,000 a non-zero value is a consensus rule restricting which blocks may include it."@en .

pg:S_MalleabilityProblems a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The malleability problems"@en ;
    sen0401:anchor "#MalleabilityProblems" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_MalleabilityProblems> ;
    skos:definition "This group states the three problems that the book found with placing witnesses in the input script: the circular dependency, in which a refund cannot be signed before the deposit whose identifier it needs; third-party transaction malleability, in which anyone can re-encode a push in an input script and change a transaction's identifier; and second-party malleability, in which a counterparty can produce an alternative signature and change it (Antonopoulos and Harding, 2023)."@en .

pg:S_MarkerAndFlag a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The marker and the flag"@en ;
    sen0401:anchor "#MarkerAndFlag" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_MarkerAndFlag> ;
    skos:definition "The marker and the flag are the two bytes that follow the version in the extended serialization format."@en .

pg:S_MarkerByte a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Marker byte"@en ;
    sen0401:anchor "#MarkerByte" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_MarkerByte> ;
    skos:definition "The marker is the byte 0x00 after the version of an extended-format transaction; a legacy parser would read it as a count of zero inputs, which no transaction can have, so it signals the extended format."@en .

pg:S_MaturityRule a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Maturity rule"@en ;
    sen0401:anchor "#MaturityRule" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_MaturityRule> ;
    skos:definition "The maturity rule says a transaction spending a coinbase output cannot be included in any block until the coinbase has 100 confirmations; outputs with fewer are called immature."@en .

pg:S_MedianTimePast a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Median time past"@en ;
    sen0401:anchor "#MedianTimePast" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_MedianTimePast> ;
    skos:definition "The median time past (MTP) of a block is the median of the timestamps of the last eleven blocks; time locks are compared with it, and it is normally an hour or two behind the clock."@en .

pg:S_NullOutpoint a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The null outpoint"@en ;
    sen0401:anchor "#NullOutpoint" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_NullOutpoint> ;
    skos:definition "A coinbase transaction's single input must have an outpoint with a null txid of all zeros and the maximal output index 0xffffffff, so that it cannot reference a previous output."@en .

pg:S_OptInRbf a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Opt-in replace-by-fee"@en ;
    sen0401:anchor "#OptInRbf" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_OptInRbf> ;
    skos:definition "Opt-in replace-by-fee is the relay policy under which a conflicting transaction paying a higher fee rate replaces an unconfirmed one that signalled replaceability; the replacement must also pay for its own relay."@en .

pg:S_Outpoint a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Outpoint"@en ;
    sen0401:anchor "#Outpoint" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Outpoint> ;
    skos:definition "An outpoint is the 32-byte txid of a previous transaction followed by the 4-byte index of one of its outputs; every input has exactly one, and a node uses it to find the output being spent."@en .

pg:S_OutpointField a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The outpoint"@en ;
    sen0401:anchor "#OutpointField" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_OutpointField> ;
    skos:definition "The outpoint is the field with which an input points at the previous output it spends."@en .

pg:S_OutputCount a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Output count"@en ;
    sen0401:anchor "#OutputCount" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_OutputCount> ;
    skos:definition "The output count is the compactSize integer that opens the outputs field; it must be greater than zero, and Alice's transaction has two outputs."@en .

pg:S_OutputIndex a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Output index"@en ;
    sen0401:anchor "#OutputIndex" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_OutputIndex> ;
    skos:definition "The output index is the 4-byte unsigned integer after the txid in an outpoint; it chooses one output of the previous transaction, counting from zero."@en .

pg:S_OutputList a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The output list"@en ;
    sen0401:anchor "#OutputList" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_OutputList> ;
    skos:definition "The output list is the outputs field as a whole: a compactSize count greater than zero, then that many outputs, each an 8-byte amount and a length-prefixed script."@en .

pg:S_OutputScript a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Output script"@en ;
    sen0401:anchor "#OutputScript" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_OutputScript> ;
    skos:definition "The output script holds the conditions for spending an output; Alice's first is a 34-byte segwit version 1 script for Bob, her second a 22-byte segwit version 0 script for her change."@en .

pg:S_OutputScriptField a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The output script"@en ;
    sen0401:anchor "#OutputScriptField" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_OutputScriptField> ;
    skos:definition "The output script is the last field of an output: the book says the amount is followed by a compactSize integer indicating the length of the output script, the script that contains the conditions that will need to be fulfilled in order to spend the bitcoins, and that according to consensus the minimum size of an output script is zero (Antonopoulos and Harding, 2023)."@en .

pg:S_Outputs a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Outputs"@en ;
    sen0401:anchor "#Outputs" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Outputs> ;
    skos:definition "This branch reads the outputs field, the 75 bytes of Alice's transaction that assign her bitcoins to new conditions."@en .

pg:S_OwnershipRecord a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The ownership record of a full node"@en ;
    sen0401:anchor "#OwnershipRecord" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_OwnershipRecord> ;
    skos:definition "Every full node keeps its own copy of the database that says which bitcoins are controlled by whom, and a transaction is accepted when the node agrees to update that copy."@en .

pg:S_PaymentChannel a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Payment channel"@en ;
    sen0401:anchor "#PaymentChannel" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_PaymentChannel> ;
    skos:definition "A payment channel is a protocol in which two parties sign many versions of one transaction off the chain, each with a higher sequence, and broadcast only the final one; the book's card game is the original form."@en .

pg:S_PresignedTransaction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Presigned transactions"@en ;
    sen0401:anchor "#PresignedTransaction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_PresignedTransaction> ;
    skos:definition "A presigned transaction is signed but not broadcast, perhaps for years; a later rule that applies to its version could make it permanently invalid, so new constraints are reserved for new version numbers."@en .

pg:S_PreviousTxid a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The previous transaction's identifier"@en ;
    sen0401:anchor "#PreviousTxid" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_PreviousTxid> ;
    skos:definition "The txid in an outpoint is the 32-byte double-SHA-256 identifier of the transaction that created the output being spent, stored in internal byte order."@en .

pg:S_PsbtFormat a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Partially signed bitcoin transaction"@en ;
    sen0401:anchor "#PsbtFormat" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_PsbtFormat> ;
    skos:definition "The partially signed bitcoin transaction (PSBT) format of BIPs 174 and 370 lets an untrusted program build a transaction template that trusted programs holding the keys verify and complete."@en .

pg:S_PushEncoding a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Alternative push encodings"@en ;
    sen0401:anchor "#PushEncoding" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_PushEncoding> ;
    skos:definition "The number 2 can be pushed as OP_2, as a one-byte push, as a two-byte push or with OP_PUSHDATA1; each is a different byte string, so each gives a legacy transaction a different txid while the script result is the same."@en .

pg:S_RelativeTimelock a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Sequence as a relative timelock"@en ;
    sen0401:anchor "#RelativeTimelock" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_RelativeTimelock> ;
    skos:definition "The relative timelock is the third meaning of the sequence field and the only one enforced by consensus."@en .

pg:S_RelayPolicy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Relay policy"@en ;
    sen0401:anchor "#RelayPolicy" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_RelayPolicy> ;
    skos:definition "Relay policy is the set of rules a full node applies to unconfirmed transactions it relays and keeps in its memory pool; it is chosen by the node, can change, and includes dust, standardness, version 3 and replacement rules."@en .

pg:S_ReplaceByFee a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Opt-in replace-by-fee"@en ;
    sen0401:anchor "#ReplaceByFee" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_ReplaceByFee> ;
    skos:definition "Replace-by-fee is the second meaning of the sequence field."@en .

pg:S_ReplacementAttack a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The replacement bandwidth attack"@en ;
    sen0401:anchor "#ReplacementAttack" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_ReplacementAttack> ;
    skos:definition "Unlimited free replacement let an attacker with 1,000 replacements a minute at 200 bytes each cost 50,000 relaying nodes about 10 GB of bandwidth a minute for 20 KB of their own, so the scheme was disabled."@en .

pg:S_Satoshi a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Satoshi"@en ;
    sen0401:anchor "#Satoshi" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Satoshi> ;
    skos:definition "A satoshi is the smallest unit of bitcoin an on-chain transaction can represent; there are 100 million satoshis in a bitcoin, so 20,000 satoshis are 0.0002 bitcoin."@en .

pg:S_ScriptSizeLimit a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Script size limits"@en ;
    sen0401:anchor "#ScriptSizeLimit" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_ScriptSizeLimit> ;
    skos:definition "Consensus sets the minimum size of an output script at zero and no explicit maximum when it is created, but a later transaction can only spend an output whose script is 10,000 bytes or smaller."@en .

pg:S_SecondPartyMalleability a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Second-party transaction malleability"@en ;
    sen0401:anchor "#SecondPartyMalleability" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_SecondPartyMalleability> ;
    skos:definition "Unwanted second-party transaction malleability is a counterparty's ability to produce an alternative signature, because a signer chooses a random number each time, and so a conflicting transaction with a different txid that invalidates a presigned refund."@en .

pg:S_SegregatedWitness a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Segregated witness"@en ;
    sen0401:anchor "#SegregatedWitness" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_SegregatedWitness> ;
    skos:definition "Segregated witness, segwit, is the idea of separating the rest of the data in a transaction from its witness for the purpose of generating a txid."@en .

pg:S_Segwit a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Segregated witness"@en ;
    sen0401:anchor "#Segwit" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Segwit> ;
    skos:definition "Segregated witness is the separation of a transaction's witness from the data its txid is computed over; an empty input script keeps witnesses from affecting the txid and so removes circular dependencies and both unwanted malleabilities."@en .

pg:S_SequenceField a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The sequence field"@en ;
    sen0401:anchor "#SequenceField" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch06#S_SequenceField> ;
    skos:definition "This branch reads the last four bytes of an input, which the book calls its sequence number, and follows the three meanings the field has carried."@en .

pg:S_SequenceNumber a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Sequence number"@en ;
    sen0401:anchor "#SequenceNumber" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_SequenceNumber> ;
    skos:definition "The sequence is the 4-byte field that ends every input; its maximal value 0xffffffff, called final, opts out of replacement, of the BIP125 signal and of any relative timelock."@en .

pg:S_SequenceReplacement a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Original sequence-based replacement"@en ;
    sen0401:anchor "#SequenceReplacement" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_SequenceReplacement> ;
    skos:definition "The original sequence-based replacement is the first meaning of the field: the book says the sequence field was originally intended to allow creation of multiple versions of the same transaction, with later versions replacing earlier versions as candidates for confirmation, the sequence number tracking the version of the transaction (Antonopoulos and Harding, 2023)."@en .

pg:S_SerializationFormats a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Serialization formats"@en ;
    sen0401:anchor "#SerializationFormats" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_SerializationFormats> ;
    skos:definition "Serialization is the writing of a data structure as a sequence of bytes so that it can be stored, hashed or sent."@en .

pg:S_SerializedTransaction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Serialized transaction"@en ;
    sen0401:anchor "#SerializedTransaction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_SerializedTransaction> ;
    skos:definition "A serialized transaction is the transaction written as the sequence of bytes that Bitcoin Core hashes, relays and stores; the book prints Alice's as 388 hexadecimal characters."@en .

pg:S_SetupTransaction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Setup and refund transactions"@en ;
    sen0401:anchor "#SetupTransaction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_SetupTransaction> ;
    skos:definition "The setup transaction deposits Alice's and Bob's money into a multisignature output that needs both signatures; the refund transaction, with sequence 0, pays each their deposit back and is kept unbroadcast."@en .

pg:S_SignatureWitness a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Public key and signature as witness"@en ;
    sen0401:anchor "#SignatureWitness" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_SignatureWitness> ;
    skos:definition "In a digital signature scheme the public key is a public identifier of secret data and the signature a solution to an equation only the holder of that data can produce; a script of a public key and OP_CHECKSIG makes the signature the witness."@en .

pg:S_SoftFork a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Soft fork"@en ;
    sen0401:anchor "#SoftFork" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_SoftFork> ;
    skos:definition "A soft fork is a backward-compatible change to the consensus rules: full nodes with the change must not accept any block that nodes without it would consider invalid, so new nodes can reject blocks old nodes accept but not the reverse."@en .

pg:S_StandardOutput a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Standard transaction outputs"@en ;
    sen0401:anchor "#StandardOutput" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_StandardOutput> ;
    skos:definition "Standard transaction outputs are the few output script templates that Bitcoin Core's policy for relaying and mining transactions allows, kept to support upgrades and to encourage putting conditions in redeem, witness and leaf scripts."@en .

pg:S_ThirdPartyMalleability a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Third-party transaction malleability"@en ;
    sen0401:anchor "#ThirdPartyMalleability" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_ThirdPartyMalleability> ;
    skos:definition "Unwanted third-party transaction malleability is a stranger's ability to change a transaction's txid without invalidating it, for example by re-encoding a push in the input script, so that a conflicting copy confirms and any transaction spending the original's outputs becomes invalid."@en .

pg:S_TimeLock a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Lock time as an epoch time"@en ;
    sen0401:anchor "#TimeLock" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_TimeLock> ;
    skos:definition "A lock time of 500,000,000 or more is an epoch time, seconds since 1970-01-01T00:00 UTC; the transaction can only be included in a block whose median time past is greater than the lock time."@en .

pg:S_TimelockMask a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The 16-bit mask"@en ;
    sen0401:anchor "#TimelockMask" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_TimelockMask> ;
    skos:definition "Only the 16 least significant bits of the sequence carry the relative timelock, so the mask 0x0000ffff extracts a value of at most 65,535, which in blocks or in 512-second units is a bit more than a year."@en .

pg:S_Transaction a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction"@en ;
    sen0401:anchor "#Transaction" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Transaction> ;
    skos:definition "A transaction is the data Alice uses to convince every full node to update its database so that some bitcoins she controls are recorded as controlled by Bob."@en .

pg:S_TransactionAnatomy a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "What a transaction is"@en ;
    sen0401:anchor "#TransactionAnatomy" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch06#S_TransactionAnatomy> ;
    skos:definition "This first branch asks what a Bitcoin transaction is before any of its bytes are read."@en .

pg:S_TransactionIdea a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The idea of a transaction"@en ;
    sen0401:anchor "#TransactionIdea" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_TransactionIdea> ;
    skos:definition "This group collects the three ideas a reader needs before the bytes make sense: the transaction itself, the ownership record that it asks full nodes to change, and the parts that every transaction is built from."@en .

pg:S_TransactionParts a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The parts of a transaction"@en ;
    sen0401:anchor "#TransactionParts" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_TransactionParts> ;
    skos:definition "A serialized transaction has a version, an inputs field, an outputs field, a lock time and, when it spends segwit outputs, a marker, a flag and a witness structure."@en .

pg:S_Txid a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Transaction identifier"@en ;
    sen0401:anchor "#Txid" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Txid> ;
    skos:definition "The txid is the double SHA-256 of a transaction's legacy serialization, displayed in reversed byte order; for a segwit transaction it therefore excludes the witness."@en .

pg:S_TypeFlag a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The type flag"@en ;
    sen0401:anchor "#TypeFlag" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_TypeFlag> ;
    skos:definition "The type flag is bit 22 of the sequence, value 1 shifted left 22; set, the lock counts units of 512 seconds, clear, it counts blocks."@en .

pg:S_UneconomicalOutput a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Uneconomical output"@en ;
    sen0401:anchor "#UneconomicalOutput" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_UneconomicalOutput> ;
    skos:definition "An uneconomical output is one whose value is less than the extra fee that spending it would add to a transaction; a zero-value output is always uneconomical, and others become so when fee rates rise."@en .

pg:S_UtxoDatabase a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The UTXO database"@en ;
    sen0401:anchor "#UtxoDatabase" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_UtxoDatabase> ;
    skos:definition "Bitcoin Core keeps a database of every unspent transaction output with essential metadata; each new block removes the outputs its transactions spend and adds the outputs they create."@en .

pg:S_VarintVarieties a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Other variable-length integers"@en ;
    sen0401:anchor "#VarintVarieties" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_VarintVarieties> ;
    skos:definition "Bitcoin programs use several variable-length integers: compactSize in transactions and the P2P protocol, Bitcoin Core's VarInts in its UTXO database, and the unrelated Compact encoding of a block header's nBits field."@en .

pg:S_Vbyte a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Vbytes"@en ;
    sen0401:anchor "#Vbyte" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Vbyte> ;
    skos:definition "A vbyte is a quarter of a weight unit, rounded up, so that a legacy transaction's vbytes equal its bytes; Alice's transaction is 143 vbytes."@en .

pg:S_VersionField a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The version field"@en ;
    sen0401:anchor "#VersionField" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_VersionField> ;
    skos:definition "The version field is the four-byte little-endian integer at the start of every transaction."@en .

pg:S_VersionMarkerFlag a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Version, marker and flag"@en ;
    sen0401:anchor "#VersionMarkerFlag" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch06#S_VersionMarkerFlag> ;
    skos:definition "This branch reads the first six bytes of Alice's transaction: the four-byte version and, because her transaction carries a witness, the marker and the flag that announce the extended format."@en .

pg:S_VersionOne a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Version 1"@en ;
    sen0401:anchor "#VersionOne" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_VersionOne> ;
    skos:definition "Version 1 is the original transaction version, written 01000000 in little-endian order; every transaction must follow its rules, and Alice's transaction uses it."@en .

pg:S_VersionThree a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The version 3 proposal"@en ;
    sen0401:anchor "#VersionThree" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_VersionThree> ;
    skos:definition "The version 3 proposal, BIP431, changes only the relay policy of full nodes: a version 3 transaction accepts topological restrictions in exchange for protection against pinning attacks; Bitcoin Core treats it as standard since release 28.0."@en .

pg:S_VersionTwo a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Version 2 and BIP68"@en ;
    sen0401:anchor "#VersionTwo" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_VersionTwo> ;
    skos:definition "Version 2 transactions were introduced by the BIP68 soft fork; only in a transaction of version 2 or higher is a sequence value below 2 to the 31 a relative timelock, and BIP112's opcode fails below version 2."@en .

pg:S_WantedMalleability a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Wanted malleability"@en ;
    sen0401:anchor "#WantedMalleability" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_WantedMalleability> ;
    skos:definition "Some malleability is wanted: with a signature hash the sender can allow others to change parts of a transaction, as when Bob adds an input to help pay Alice's fee; the book says unwanted when it means the other kind."@en .

pg:S_Weight a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Weight"@en ;
    sen0401:anchor "#Weight" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Weight> ;
    skos:definition "Weight is BIP141's measure of a transaction: the legacy serialization's size times 3 plus the full serialization's size, which is 569 for Alice's transaction, the figure Bitcoin Core reports."@en .

pg:S_WeightAndFoundations a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Weight and foundations"@en ;
    sen0401:anchor "#WeightAndFoundations" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch06#S_WeightAndFoundations> ;
    skos:definition "This last branch has two jobs."@en .

pg:S_WeightFactor a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Weight factors"@en ;
    sen0401:anchor "#WeightFactor" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_WeightFactor> ;
    skos:definition "Each field's weight is its serialized size times a factor: 4 for the version, inputs, outputs and lock time, 1 for the marker, the flag and the witness structure; summed over Alice's transaction the factors give 569."@en .

pg:S_WeightUnits a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Weight and vbytes"@en ;
    sen0401:anchor "#WeightUnits" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_WeightUnits> ;
    skos:definition "Weight is the modern unit in which the size of a transaction or a block is measured, and vbytes are weight divided by four."@en .

pg:S_Witness a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Witness"@en ;
    sen0401:anchor "#Witness" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Witness> ;
    skos:definition "A witness is data that solves the math problem protecting an output, which full nodes check instead of trusting; for the script 2 OP_ADD 4 OP_EQUAL the witness is the value 2."@en .

pg:S_WitnessIdea a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "The idea of a witness"@en ;
    sen0401:anchor "#WitnessIdea" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_WitnessIdea> ;
    skos:definition "This group explains what a witness is before any byte of it is read."@en .

pg:S_WitnessItem a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Witness item"@en ;
    sen0401:anchor "#WitnessItem" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_WitnessItem> ;
    skos:definition "A witness item is one element of a witness stack, prefixed by a compactSize integer giving its size; Alice's single item is a 65-byte signature."@en .

pg:S_WitnessProgram a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Witness program"@en ;
    sen0401:anchor "#WitnessProgram" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_WitnessProgram> ;
    skos:definition "A witness program is the data in a segwit output script: a script of a number from 0 to 16 followed by 2 to 40 bytes is the segwit template, the number its version and the data the witness program; old nodes may spend it with an empty input script, new nodes require one."@en .

pg:S_WitnessSerialization a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Witness structure serialization"@en ;
    sen0401:anchor "#WitnessSerialization" ;
    sen0401:outlineLevel 2 ;
    dcterms:source <http://example.org/sen0401/ch06#S_WitnessSerialization> ;
    skos:definition "This group reads the bytes of the witness structure."@en .

pg:S_WitnessStack a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Witness stack"@en ;
    sen0401:anchor "#WitnessStack" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_WitnessStack> ;
    skos:definition "A witness stack is the part of the witness structure belonging to one input: a compactSize count of items followed by the items; there is one stack per input, so the structure has no count of its own."@en .

pg:S_WitnessStructure a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Witness structure"@en ;
    sen0401:anchor "#WitnessStructure" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_WitnessStructure> ;
    skos:definition "The witness structure is the field added by segwit to hold the data that an input script may no longer carry; it sits after the outputs and before the lock time and is not part of the txid."@en .

pg:S_Witnesses a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Witnesses"@en ;
    sen0401:anchor "#Witnesses" ;
    sen0401:outlineLevel 1 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Witnesses> ;
    skos:definition "This branch explains the witness structure, the 67 bytes near the end of Alice's transaction that prove she was allowed to spend."@en .

pg:S_Wtxid a ipo:ChapterSection,
        owl:NamedIndividual ;
    rdfs:label "Witness transaction identifier"@en ;
    sen0401:anchor "#Wtxid" ;
    sen0401:outlineLevel 3 ;
    dcterms:source <http://example.org/sen0401/ch06#S_Wtxid> ;
    skos:definition "The wtxid is the double SHA-256 of the whole extended serialization, witness included; it changes when the witness changes, and blocks commit to it separately from the txid."@en .

pg:CO2 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Explain what a transaction asks full nodes to do, what a node obtains from the outpoint of each input, and why the rule against double spending makes two spenders of one output conflicting transactions"@en ;
    ld:bloomLevel ld:Understand ;
    dcterms:source <http://example.org/sen0401/ch06/document> ;
    skos:definition "After this chapter the learner can explain what a transaction asks full nodes to do, what a node obtains from the outpoint of each input, and why the rule against double spending makes two spenders of one output conflicting transactions."@en .

pg:CO5 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Check the chapter's figures and statements against BIP68, BIP125, BIP141, Bitcoin Core's sources and an independent explorer, and say where each differs and what the difference changes"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch06/document> ;
    skos:definition "After this chapter the learner can check the chapter's figures and statements against BIP68, BIP125, BIP141, Bitcoin Core's sources and an independent explorer, and say where each differs and what the difference changes."@en .

pg:CO1 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Read a serialized transaction byte by byte - version, marker and flag, inputs, outputs, witness structure, lock time - and recompute its identifier, size and weight from the bytes"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch06/document> ;
    skos:definition "After this chapter the learner can read a serialized transaction byte by byte - version, marker and flag, inputs, outputs, witness structure, lock time - and recompute its identifier, size and weight from the bytes."@en .

pg:CO3 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Decode the sequence and lock-time fields under their current rules - BIP68 relative timelocks, the BIP125 signal, height and time locks against the median time past - and say when a transaction may be confirmed"@en ;
    ld:bloomLevel ld:Apply ;
    dcterms:source <http://example.org/sen0401/ch06/document> ;
    skos:definition "After this chapter the learner can decode the sequence and lock-time fields under their current rules - BIP68 relative timelocks, the BIP125 signal, height and time locks against the median time past - and say when a transaction may be confirmed."@en .

pg:CO4 a ipo:LearningObjective,
        owl:NamedIndividual ;
    rdfs:label "Analyse why witnesses in the input script made identifiers malleable and broke contract protocols, and how segregated witness removes the problem as a soft fork while changing the measure of size"@en ;
    ld:bloomLevel ld:Analyze ;
    dcterms:source <http://example.org/sen0401/ch06/document> ;
    skos:definition "After this chapter the learner can analyse why witnesses in the input script made identifiers malleable and broke contract protocols, and how segregated witness removes the problem as a soft fork while changing the measure of size."@en .

