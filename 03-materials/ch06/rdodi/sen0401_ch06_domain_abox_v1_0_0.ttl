@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

<http://example.org/sen0401/ch06/abox> a owl:Ontology ;
    rdfs:label "SEN0401 chapter 6 domain ontology - ABox"@en ; owl:versionInfo "1.0.0" ; owl:versionIRI <http://example.org/sen0401/ch06/abox/1.0.0> ; rdfs:comment "1.0.0 is the first ontology of chapter 6: 115 concepts in eight branches, each level 3 concept explained in four paragraphs of continuous prose and each level 1 or 2 group in three or four, with the terms the explanations rely on added as concepts of their own so that nothing is used unexplained; every quoted number, identifier, encoding and output is executed by the chapter builder, and every quotation is re-read from a saved copy of its source by an executed claim."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:created "2026-10-08"^^xsd:date ; dcterms:modified "2026-10-08"^^xsd:date ;
    dcterms:identifier "sen0401_ch06_abox_v1_0_0" ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/ch06-rdodi-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

chx:X_Transaction a owl:NamedIndividual, chx:Transaction ; rdfs:label "a request to thousands of databases"@en ; skos:definition "A transaction is the data Alice uses to convince every full node to update its database so that some bitcoins she controls are recorded as controlled by Bob."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_Transaction a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(bytes.fromhex('')) evaluates to 194"@en ; chx:input "len(bytes.fromhex(''))" ; chx:output "194" .
chx:X_Transaction rd:hasIOExample chx:IO_Transaction .
chx:X_OwnershipRecord a owl:NamedIndividual, chx:OwnershipRecord ; rdfs:label "every node keeps the same register"@en ; skos:definition "Every full node keeps its own copy of the database that says which bitcoins are controlled by whom, and a transaction is accepted when the node agrees to update that copy."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_OwnershipRecord a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda record: (record['Alice'], record.pop('Alice'), record.update({'Bob': 100000}), record)[-1])({'Alice': 100000}) evaluates to {'Bob': 100000}"@en ; chx:input "(lambda record: (record['Alice'], record.pop('Alice'), record.update({'Bob': 100000}), record)[-1])({'Alice': 100000})" ; chx:output "{'Bob': 100000}" .
chx:X_OwnershipRecord rd:hasIOExample chx:IO_OwnershipRecord .
chx:X_TransactionParts a owl:NamedIndividual, chx:TransactionParts ; rdfs:label "five top-level fields, plus two for segwit"@en ; skos:definition "A serialized transaction has a version, an inputs field, an outputs field, a lock time and, when it spends segwit outputs, a marker, a flag and a witness structure."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_TransactionParts a owl:NamedIndividual, rd:IOExample ; rdfs:label "['version', 'marker', 'flag', 'inputs', 'outputs', 'witness structure', 'lock time'] evaluates to ['version', 'marker', 'flag', 'inputs', 'outputs', 'witness structure', 'lock time']"@en ; chx:input "['version', 'marker', 'flag', 'inputs', 'outputs', 'witness structure', 'lock time']" ; chx:output "['version', 'marker', 'flag', 'inputs', 'outputs', 'witness structure', 'lock time']" .
chx:X_TransactionParts rd:hasIOExample chx:IO_TransactionParts .
chx:X_SerializedTransaction a owl:NamedIndividual, chx:SerializedTransaction ; rdfs:label "the 194 bytes Bitcoin Core returned"@en ; skos:definition "A serialized transaction is the transaction written as the sequence of bytes that Bitcoin Core hashes, relays and stores; the book prints Alice's as 388 hexadecimal characters."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_SerializedTransaction a owl:NamedIndividual, rd:IOExample ; rdfs:label "len('') // 2 evaluates to 194"@en ; chx:input "len('') // 2" ; chx:output "194" .
chx:X_SerializedTransaction rd:hasIOExample chx:IO_SerializedTransaction .
chx:X_ExtendedFormat a owl:NamedIndividual, chx:ExtendedFormat ; rdfs:label "marker 00, flag 01, witness at the end"@en ; skos:definition "The extended serialization format of BIP144 adds a marker byte, a flag byte and a witness structure to the legacy layout, for transactions that spend segwit outputs."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_ExtendedFormat a owl:NamedIndividual, rd:IOExample ; rdfs:label "(''[8:10], ''[10:12]) evaluates to ('00', '01')"@en ; chx:input "(''[8:10], ''[10:12])" ; chx:output "('00', '01')" .
chx:X_ExtendedFormat rd:hasIOExample chx:IO_ExtendedFormat .
chx:X_LegacyFormat a owl:NamedIndividual, chx:LegacyFormat ; rdfs:label "no marker, no flag, no witness"@en ; skos:definition "Legacy serialization is the original transaction format, without the marker, flag and witness structure; it is still used for every transaction that spends no witness program."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_LegacyFormat a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"tx = bytes.fromhex('')\\nlegacy = tx[:4] + tx[6:-71] + tx[-4:]   # drop marker, flag and the 67-byte witness structure\\nresult = (len(tx), len(legacy))\", g), g['result'])[1])({}) evaluates to (194, 125)"@en ; chx:input "(lambda g: (exec(\"tx = bytes.fromhex('')\\nlegacy = tx[:4] + tx[6:-71] + tx[-4:]   # drop marker, flag and the 67-byte witness structure\\nresult = (len(tx), len(legacy))\", g), g['result'])[1])({})" ; chx:output "(194, 125)" .
chx:X_LegacyFormat rd:hasIOExample chx:IO_LegacyFormat .
chx:X_PsbtFormat a owl:NamedIndividual, chx:PsbtFormat ; rdfs:label "a template passed between programs"@en ; skos:definition "The partially signed bitcoin transaction (PSBT) format of BIPs 174 and 370 lets an untrusted program build a transaction template that trusted programs holding the keys verify and complete."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_PsbtFormat a owl:NamedIndividual, rd:IOExample ; rdfs:label "bytes.fromhex('70736274ff').decode('latin-1')[:4] evaluates to 'psbt'"@en ; chx:input "bytes.fromhex('70736274ff').decode('latin-1')[:4]" ; chx:output "'psbt'" .
chx:X_PsbtFormat rd:hasIOExample chx:IO_PsbtFormat .
chx:X_ByteMap a owl:NamedIndividual, chx:ByteMap ; rdfs:label "every field at its offset"@en ; skos:definition "A byte map draws a serialized transaction with each field at its byte position and length, so that the hexadecimal can be read as named parts."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_ByteMap a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"tx = bytes.fromhex('')\\nresult = [('version', 0, 4), ('marker', 4, 1), ('flag', 5, 1), ('inputs', 6, 42), ('outputs', 48, 75), ('witness', 123, 67), ('lock time', 190, 4)]\\nassert sum(n for _, _, n in result) == len(tx)\", g), g['result'])[1])({}) evaluates to [('version', 0, 4), ('marker', 4, 1), ('flag', 5, 1), ('inputs', 6, 42), ('outputs', 48, 75), ('witness', 123, 67), ('lock time', 190, 4)]"@en ; chx:input "(lambda g: (exec(\"tx = bytes.fromhex('')\\nresult = [('version', 0, 4), ('marker', 4, 1), ('flag', 5, 1), ('inputs', 6, 42), ('outputs', 48, 75), ('witness', 123, 67), ('lock time', 190, 4)]\\nassert sum(n for _, _, n in result) == len(tx)\", g), g['result'])[1])({})" ; chx:output "[('version', 0, 4), ('marker', 4, 1), ('flag', 5, 1), ('inputs', 6, 42), ('outputs', 48, 75), ('witness', 123, 67), ('lock time', 190, 4)]" .
chx:X_ByteMap rd:hasIOExample chx:IO_ByteMap .
chx:X_VersionOne a owl:NamedIndividual, chx:VersionOne ; rdfs:label "01000000 in the first four bytes"@en ; skos:definition "Version 1 is the original transaction version, written 01000000 in little-endian order; every transaction must follow its rules, and Alice's transaction uses it."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_VersionOne a owl:NamedIndividual, rd:IOExample ; rdfs:label "int.from_bytes(bytes.fromhex('01000000'), 'little') evaluates to 1"@en ; chx:input "int.from_bytes(bytes.fromhex('01000000'), 'little')" ; chx:output "1" .
chx:X_VersionOne rd:hasIOExample chx:IO_VersionOne .
chx:X_VersionTwo a owl:NamedIndividual, chx:VersionTwo ; rdfs:label "the version that turns sequence into a timelock"@en ; skos:definition "Version 2 transactions were introduced by the BIP68 soft fork; only in a transaction of version 2 or higher is a sequence value below 2 to the 31 a relative timelock, and BIP112's opcode fails below version 2."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_VersionTwo a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda version, seq: 'relative timelock' if version >= 2 and seq < 2 ** 31 else 'no timelock')(2, 30) evaluates to 'relative timelock'"@en ; chx:input "(lambda version, seq: 'relative timelock' if version >= 2 and seq < 2 ** 31 else 'no timelock')(2, 30)" ; chx:output "'relative timelock'" .
chx:X_VersionTwo rd:hasIOExample chx:IO_VersionTwo .
chx:X_VersionThree a owl:NamedIndividual, chx:VersionThree ; rdfs:label "a policy, not a consensus change"@en ; skos:definition "The version 3 proposal, BIP431, changes only the relay policy of full nodes: a version 3 transaction accepts topological restrictions in exchange for protection against pinning attacks; Bitcoin Core treats it as standard since release 28.0."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_VersionThree a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda current, max_standard: (current, max_standard, max_standard - current))(2, 3) evaluates to (2, 3, 1)"@en ; chx:input "(lambda current, max_standard: (current, max_standard, max_standard - current))(2, 3)" ; chx:output "(2, 3, 1)" .
chx:X_VersionThree rd:hasIOExample chx:IO_VersionThree .
chx:X_PresignedTransaction a owl:NamedIndividual, chx:PresignedTransaction ; rdfs:label "signed now, broadcast years later"@en ; skos:definition "A presigned transaction is signed but not broadcast, perhaps for years; a later rule that applies to its version could make it permanently invalid, so new constraints are reserved for new version numbers."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_PresignedTransaction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda presigned_version, rule_applies_from: 'still valid' if presigned_version < rule_applies_from else 'at risk')(1, 2) evaluates to 'still valid'"@en ; chx:input "(lambda presigned_version, rule_applies_from: 'still valid' if presigned_version < rule_applies_from else 'at risk')(1, 2)" ; chx:output "'still valid'" .
chx:X_PresignedTransaction rd:hasIOExample chx:IO_PresignedTransaction .
chx:X_MarkerByte a owl:NamedIndividual, chx:MarkerByte ; rdfs:label "a zero where a count cannot be zero"@en ; skos:definition "The marker is the byte 0x00 after the version of an extended-format transaction; a legacy parser would read it as a count of zero inputs, which no transaction can have, so it signals the extended format."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_MarkerByte a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda b: 'extended format' if b[4] == 0 and b[5] != 0 else 'legacy format')(bytes.fromhex('')) evaluates to 'extended format'"@en ; chx:input "(lambda b: 'extended format' if b[4] == 0 and b[5] != 0 else 'legacy format')(bytes.fromhex(''))" ; chx:output "'extended format'" .
chx:X_MarkerByte rd:hasIOExample chx:IO_MarkerByte .
chx:X_FlagByte a owl:NamedIndividual, chx:FlagByte ; rdfs:label "one, with other values reserved"@en ; skos:definition "The flag is the byte after the marker; it is 0x01 in the current protocol, other values are reserved for upgrades, and BIP144 reads it as a bit vector for adding non-committed data later."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_FlagByte a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda flag: [bit for bit in range(8) if flag >> bit & 1])(0x01) evaluates to [0]"@en ; chx:input "(lambda flag: [bit for bit in range(8) if flag >> bit & 1])(0x01)" ; chx:output "[0]" .
chx:X_FlagByte rd:hasIOExample chx:IO_FlagByte .
chx:X_InputCount a owl:NamedIndividual, chx:InputCount ; rdfs:label "at least one, in practice a few thousand"@en ; skos:definition "The input count is the compactSize integer that opens the inputs field; it must be at least one, and transaction size limits keep it to a few thousand in practice."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_InputCount a owl:NamedIndividual, rd:IOExample ; rdfs:label "int.from_bytes(bytes.fromhex('')[6:7], 'little') evaluates to 1"@en ; chx:input "int.from_bytes(bytes.fromhex('')[6:7], 'little')" ; chx:output "1" .
chx:X_InputCount rd:hasIOExample chx:IO_InputCount .
chx:X_CompactSize a owl:NamedIndividual, chx:CompactSize ; rdfs:label "1, 3, 5 or 9 bytes, by value"@en ; skos:definition "A compactSize unsigned integer is one byte for values up to 252 and otherwise a prefix byte 0xfd, 0xfe or 0xff followed by the value as a 2-, 4- or 8-byte little-endian integer."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_CompactSize a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"def cs(n):\\n    if n <= 252: return bytes([n])\\n    if n <= 0xffff: return b'\\\\xfd' + n.to_bytes(2, 'little')\\n    if n <= 0xffffffff: return b'\\\\xfe' + n.to_bytes(4, 'little')\\n    return b'\\\\xff' + n.to_bytes(8, 'little')\\nresult = [cs(n).hex() for n in (1, 252, 253, 65535, 65536, 2 ** 32)]\", g), g['result'])[1])({}) evaluates to ['01', 'fc', 'fdfd00', 'fdffff', 'fe00000100', 'ff0000000001000000']"@en ; chx:input "(lambda g: (exec(\"def cs(n):\\n    if n <= 252: return bytes([n])\\n    if n <= 0xffff: return b'\\\\xfd' + n.to_bytes(2, 'little')\\n    if n <= 0xffffffff: return b'\\\\xfe' + n.to_bytes(4, 'little')\\n    return b'\\\\xff' + n.to_bytes(8, 'little')\\nresult = [cs(n).hex() for n in (1, 252, 253, 65535, 65536, 2 ** 32)]\", g), g['result'])[1])({})" ; chx:output "['01', 'fc', 'fdfd00', 'fdffff', 'fe00000100', 'ff0000000001000000']" .
chx:X_CompactSize rd:hasIOExample chx:IO_CompactSize .
chx:X_VarintVarieties a owl:NamedIndividual, chx:VarintVarieties ; rdfs:label "three encodings, one name that is safe"@en ; skos:definition "Bitcoin programs use several variable-length integers: compactSize in transactions and the P2P protocol, Bitcoin Core's VarInts in its UTXO database, and the unrelated Compact encoding of a block header's nBits field."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_VarintVarieties a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted({'compactSize': 'transactions and P2P', 'VarInts': 'UTXO database', 'Compact': 'nBits in a block header'}) evaluates to ['Compact', 'VarInts', 'compactSize']"@en ; chx:input "sorted({'compactSize': 'transactions and P2P', 'VarInts': 'UTXO database', 'Compact': 'nBits in a block header'})" ; chx:output "['Compact', 'VarInts', 'compactSize']" .
chx:X_VarintVarieties rd:hasIOExample chx:IO_VarintVarieties .
chx:X_Outpoint a owl:NamedIndividual, chx:Outpoint ; rdfs:label "36 bytes: a txid and an index"@en ; skos:definition "An outpoint is the 32-byte txid of a previous transaction followed by the 4-byte index of one of its outputs; every input has exactly one, and a node uses it to find the output being spent."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_Outpoint a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"tx = bytes.fromhex('')\\noutpoint = tx[7:43]\\nresult = (outpoint[:32][::-1].hex(), int.from_bytes(outpoint[32:], 'little'))\", g), g['result'])[1])({}) evaluates to ('4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb', 1)"@en ; chx:input "(lambda g: (exec(\"tx = bytes.fromhex('')\\noutpoint = tx[7:43]\\nresult = (outpoint[:32][::-1].hex(), int.from_bytes(outpoint[32:], 'little'))\", g), g['result'])[1])({})" ; chx:output "('4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb', 1)" .
chx:X_Outpoint rd:hasIOExample chx:IO_Outpoint .
chx:X_PreviousTxid a owl:NamedIndividual, chx:PreviousTxid ; rdfs:label "the first 32 bytes of an outpoint"@en ; skos:definition "The txid in an outpoint is the 32-byte double-SHA-256 identifier of the transaction that created the output being spent, stored in internal byte order."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_PreviousTxid a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"prev = bytes.fromhex('eb3ae38f27191aa5f3850dc9cad00492b88b72404f9da135698679268041c54a')\\nresult = (len(prev), prev[::-1].hex()[:16])\", g), g['result'])[1])({}) evaluates to (32, '4ac5418026798669')"@en ; chx:input "(lambda g: (exec(\"prev = bytes.fromhex('eb3ae38f27191aa5f3850dc9cad00492b88b72404f9da135698679268041c54a')\\nresult = (len(prev), prev[::-1].hex()[:16])\", g), g['result'])[1])({})" ; chx:output "(32, '4ac5418026798669')" .
chx:X_PreviousTxid rd:hasIOExample chx:IO_PreviousTxid .
chx:X_OutputIndex a owl:NamedIndividual, chx:OutputIndex ; rdfs:label "four bytes counting from zero"@en ; skos:definition "The output index is the 4-byte unsigned integer after the txid in an outpoint; it chooses one output of the previous transaction, counting from zero."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_OutputIndex a owl:NamedIndividual, rd:IOExample ; rdfs:label "int.from_bytes(bytes.fromhex('01000000'), 'little') evaluates to 1"@en ; chx:input "int.from_bytes(bytes.fromhex('01000000'), 'little')" ; chx:output "1" .
chx:X_OutputIndex rd:hasIOExample chx:IO_OutputIndex .
chx:X_DoubleSpendRule a owl:NamedIndividual, chx:DoubleSpendRule ; rdfs:label "an output is spent at most once"@en ; skos:definition "One of Bitcoin's consensus rules forbids any output from being spent more than once within a valid blockchain: Alice cannot use the same previous output to pay both Bob and Carol."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_DoubleSpendRule a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spent, outpoint: 'refused: already spent' if outpoint in spent else 'accepted')({'4ac54180:1'}, '4ac54180:1') evaluates to 'refused: already spent'"@en ; chx:input "(lambda spent, outpoint: 'refused: already spent' if outpoint in spent else 'accepted')({'4ac54180:1'}, '4ac54180:1')" ; chx:output "'refused: already spent'" .
chx:X_DoubleSpendRule rd:hasIOExample chx:IO_DoubleSpendRule .
chx:X_ConflictingTransactions a owl:NamedIndividual, chx:ConflictingTransactions ; rdfs:label "same outpoint, two spenders"@en ; skos:definition "Two transactions that each try to spend the same previous output are conflicting transactions; only one of them can be included in a valid blockchain."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_ConflictingTransactions a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a, b: 'conflict' if set(a) & set(b) else 'compatible')(['4ac54180:1'], ['4ac54180:1', 'f4184fc5:0']) evaluates to 'conflict'"@en ; chx:input "(lambda a, b: 'conflict' if set(a) & set(b) else 'compatible')(['4ac54180:1'], ['4ac54180:1', 'f4184fc5:0'])" ; chx:output "'conflict'" .
chx:X_ConflictingTransactions rd:hasIOExample chx:IO_ConflictingTransactions .
chx:X_UtxoDatabase a owl:NamedIndividual, chx:UtxoDatabase ; rdfs:label "remove what is spent, add what is created"@en ; skos:definition "Bitcoin Core keeps a database of every unspent transaction output with essential metadata; each new block removes the outputs its transactions spend and adds the outputs they create."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_UtxoDatabase a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"utxo = {'4ac54180:0': 18210494, '4ac54180:1': 100000}\\nutxo.pop('4ac54180:1')                     # Alice's input spends it\\nutxo['46620030:0'] = 20000                 # Bob's output\\nutxo['46620030:1'] = 75000                 # Alice's change\\nresult = sorted(utxo.items())\", g), g['result'])[1])({}) evaluates to [('46620030:0', 20000), ('46620030:1', 75000), ('4ac54180:0', 18210494)]"@en ; chx:input "(lambda g: (exec(\"utxo = {'4ac54180:0': 18210494, '4ac54180:1': 100000}\\nutxo.pop('4ac54180:1')                     # Alice's input spends it\\nutxo['46620030:0'] = 20000                 # Bob's output\\nutxo['46620030:1'] = 75000                 # Alice's change\\nresult = sorted(utxo.items())\", g), g['result'])[1])({})" ; chx:output "[('46620030:0', 20000), ('46620030:1', 75000), ('4ac54180:0', 18210494)]" .
chx:X_UtxoDatabase rd:hasIOExample chx:IO_UtxoDatabase .
chx:X_Digest a owl:NamedIndividual, chx:Digest ; rdfs:label "32 bytes that identify a transaction"@en ; skos:definition "A digest is the output of a hash function; Bitcoin uses digests as identifiers of blocks and transactions, in commitments, and in proof of work."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_Digest a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(__import__('hashlib').sha256(__import__('hashlib').sha256(b'a serialized transaction').digest()).digest()) evaluates to 32"@en ; chx:input "len(__import__('hashlib').sha256(__import__('hashlib').sha256(b'a serialized transaction').digest()).digest())" ; chx:output "32" .
chx:X_Digest rd:hasIOExample chx:IO_Digest .
chx:X_InternalByteOrder a owl:NamedIndividual, chx:InternalByteOrder ; rdfs:label "the order inside the bytes"@en ; skos:definition "Internal byte order is the order in which a digest's bytes appear within transactions and blocks and are fed to hash functions; the book also calls it little-endian."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_InternalByteOrder a owl:NamedIndividual, rd:IOExample ; rdfs:label "bytes.fromhex('4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb')[::-1].hex() evaluates to 'eb3ae38f27191aa5f3850dc9cad00492b88b72404f9da135698679268041c54a'"@en ; chx:input "bytes.fromhex('4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb')[::-1].hex()" ; chx:output "'eb3ae38f27191aa5f3850dc9cad00492b88b72404f9da135698679268041c54a'" .
chx:X_InternalByteOrder rd:hasIOExample chx:IO_InternalByteOrder .
chx:X_DisplayByteOrder a owl:NamedIndividual, chx:DisplayByteOrder ; rdfs:label "the order on the screen"@en ; skos:definition "Display byte order is the reversed form in which identifiers are shown to users and accepted by explorers and bitcoin-cli; the book also calls it big-endian."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_DisplayByteOrder a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"internal = 'eb3ae38f27191aa5f3850dc9cad00492b88b72404f9da135698679268041c54a'\\npairs = [internal[i:i + 2] for i in range(0, 64, 2)]   # fold -w2\\nresult = ''.join(reversed(pairs))                       # tac | tr -d newline\", g), g['result'])[1])({}) evaluates to '4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb'"@en ; chx:input "(lambda g: (exec(\"internal = 'eb3ae38f27191aa5f3850dc9cad00492b88b72404f9da135698679268041c54a'\\npairs = [internal[i:i + 2] for i in range(0, 64, 2)]   # fold -w2\\nresult = ''.join(reversed(pairs))                       # tac | tr -d newline\", g), g['result'])[1])({})" ; chx:output "'4ac541802679866935a19d4f40728bb89204d0cac90d85f3a51a19278fe33aeb'" .
chx:X_DisplayByteOrder rd:hasIOExample chx:IO_DisplayByteOrder .
chx:X_InputScript a owl:NamedIndividual, chx:InputScript ; rdfs:label "107 bytes for a legacy spend, 0 for segwit"@en ; skos:definition "The input script is the legacy field in which a spending transaction places its signatures and other authorising data; a segwit input leaves it empty."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_InputScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"legacy = bytes.fromhex('483045022100a6cc4e8cd0847951a71fad3bc9b14f24d44ba59d19094e0a8cfa2580bb664b020220366060ea8203d766722ed0a02d1599b99d3c95b97dab8e41d3e4d3fe33a5706201210369e03e2c91f0badec46c9c903d9e9edae67c167b9ef9b550356ee791c9a40896')\\nsig_len = legacy[0]                       # 0x48: a 72-byte signature follows\\npub_len = legacy[1 + sig_len]             # 0x21: a 33-byte public key follows\\nresult = (len(legacy), sig_len, pub_len, 1 + sig_len + 1 + pub_len)\", g), g['result'])[1])({}) evaluates to (107, 72, 33, 107)"@en ; chx:input "(lambda g: (exec(\"legacy = bytes.fromhex('483045022100a6cc4e8cd0847951a71fad3bc9b14f24d44ba59d19094e0a8cfa2580bb664b020220366060ea8203d766722ed0a02d1599b99d3c95b97dab8e41d3e4d3fe33a5706201210369e03e2c91f0badec46c9c903d9e9edae67c167b9ef9b550356ee791c9a40896')\\nsig_len = legacy[0]                       # 0x48: a 72-byte signature follows\\npub_len = legacy[1 + sig_len]             # 0x21: a 33-byte public key follows\\nresult = (len(legacy), sig_len, pub_len, 1 + sig_len + 1 + pub_len)\", g), g['result'])[1])({})" ; chx:output "(107, 72, 33, 107)" .
chx:X_InputScript rd:hasIOExample chx:IO_InputScript .
chx:X_LengthPrefix a owl:NamedIndividual, chx:LengthPrefix ; rdfs:label "0x6b says 107 bytes follow"@en ; skos:definition "The length prefix is the compactSize integer before an input script that says how many bytes of script follow; it is 0x6b for the book's 107-byte example and 0x00 for Alice's empty script."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_LengthPrefix a owl:NamedIndividual, rd:IOExample ; rdfs:label "(0x6b, int.from_bytes(bytes.fromhex('6b'), 'little') == 107, 0x00) evaluates to (107, True, 0)"@en ; chx:input "(0x6b, int.from_bytes(bytes.fromhex('6b'), 'little') == 107, 0x00)" ; chx:output "(107, True, 0)" .
chx:X_LengthPrefix rd:hasIOExample chx:IO_LengthPrefix .
chx:X_SequenceNumber a owl:NamedIndividual, chx:SequenceNumber ; rdfs:label "the last four bytes of an input"@en ; skos:definition "The sequence is the 4-byte field that ends every input; its maximal value 0xffffffff, called final, opts out of replacement, of the BIP125 signal and of any relative timelock."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_SequenceNumber a owl:NamedIndividual, rd:IOExample ; rdfs:label "int.from_bytes(bytes.fromhex('ffffffff'), 'little') evaluates to 4294967295"@en ; chx:input "int.from_bytes(bytes.fromhex('ffffffff'), 'little')" ; chx:output "4294967295" .
chx:X_SequenceNumber rd:hasIOExample chx:IO_SequenceNumber .
chx:X_SetupTransaction a owl:NamedIndividual, chx:SetupTransaction ; rdfs:label "a deposit that needs both signatures"@en ; skos:definition "The setup transaction deposits Alice's and Bob's money into a multisignature output that needs both signatures; the refund transaction, with sequence 0, pays each their deposit back and is kept unbroadcast."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_SetupTransaction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda deposits: (sum(deposits.values()), dict(deposits)))({'Alice': 50000, 'Bob': 50000}) evaluates to (100000, {'Alice': 50000, 'Bob': 50000})"@en ; chx:input "(lambda deposits: (sum(deposits.values()), dict(deposits)))({'Alice': 50000, 'Bob': 50000})" ; chx:output "(100000, {'Alice': 50000, 'Bob': 50000})" .
chx:X_SetupTransaction rd:hasIOExample chx:IO_SetupTransaction .
chx:X_PaymentChannel a owl:NamedIndividual, chx:PaymentChannel ; rdfs:label "many versions, one broadcast"@en ; skos:definition "A payment channel is a protocol in which two parties sign many versions of one transaction off the chain, each with a higher sequence, and broadcast only the final one; the book's card game is the original form."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_PaymentChannel a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"balance = {'Alice': 50000, 'Bob': 50000}\\nversions = [(0, dict(balance))]                           # the refund, sequence 0\\nfor seq, (winner, loser, amount) in enumerate([('Alice', 'Bob', 10000), ('Bob', 'Alice', 25000)], start=1):\\n    balance[winner] += amount; balance[loser] -= amount\\n    versions.append((seq, dict(balance)))\\nversions.append((0xffffffff, dict(balance)))              # the final version, broadcast\\nresult = (len(versions), versions[-1])\", g), g['result'])[1])({}) evaluates to (4, (4294967295, {'Alice': 35000, 'Bob': 65000}))"@en ; chx:input "(lambda g: (exec(\"balance = {'Alice': 50000, 'Bob': 50000}\\nversions = [(0, dict(balance))]                           # the refund, sequence 0\\nfor seq, (winner, loser, amount) in enumerate([('Alice', 'Bob', 10000), ('Bob', 'Alice', 25000)], start=1):\\n    balance[winner] += amount; balance[loser] -= amount\\n    versions.append((seq, dict(balance)))\\nversions.append((0xffffffff, dict(balance)))              # the final version, broadcast\\nresult = (len(versions), versions[-1])\", g), g['result'])[1])({})" ; chx:output "(4, (4294967295, {'Alice': 35000, 'Bob': 65000}))" .
chx:X_PaymentChannel rd:hasIOExample chx:IO_PaymentChannel .
chx:X_ReplacementAttack a owl:NamedIndividual, chx:ReplacementAttack ; rdfs:label "20 KB in, 10 GB out, every minute"@en ; skos:definition "Unlimited free replacement let an attacker with 1,000 replacements a minute at 200 bytes each cost 50,000 relaying nodes about 10 GB of bandwidth a minute for 20 KB of their own, so the scheme was disabled."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_ReplacementAttack a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda nodes, per_minute, size: (per_minute * size // 1000, nodes * per_minute * size // 10 ** 9))(50000, 1000, 200) evaluates to (200, 10)"@en ; chx:input "(lambda nodes, per_minute, size: (per_minute * size // 1000, nodes * per_minute * size // 10 ** 9))(50000, 1000, 200)" ; chx:output "(200, 10)" .
chx:X_ReplacementAttack rd:hasIOExample chx:IO_ReplacementAttack .
chx:X_OptInRbf a owl:NamedIndividual, chx:OptInRbf ; rdfs:label "a higher fee rate replaces a lower one"@en ; skos:definition "Opt-in replace-by-fee is the relay policy under which a conflicting transaction paying a higher fee rate replaces an unconfirmed one that signalled replaceability; the replacement must also pay for its own relay."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_OptInRbf a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda old_fee, old_size, new_fee, new_size: (round(old_fee / old_size, 1), round(new_fee / new_size, 1), new_fee > old_fee and new_fee / new_size > old_fee / old_size))(5000, 143, 8000, 143) evaluates to (35.0, 55.9, True)"@en ; chx:input "(lambda old_fee, old_size, new_fee, new_size: (round(old_fee / old_size, 1), round(new_fee / new_size, 1), new_fee > old_fee and new_fee / new_size > old_fee / old_size))(5000, 143, 8000, 143)" ; chx:output "(35.0, 55.9, True)" .
chx:X_OptInRbf rd:hasIOExample chx:IO_OptInRbf .
chx:X_Bip125Signal a owl:NamedIndividual, chx:Bip125Signal ; rdfs:label "below 0xfffffffe means replaceable"@en ; skos:definition "By BIP125 an unconfirmed transaction with any input whose sequence is below 0xfffffffe, at least two below the maximum, signals that it may be replaced by a conflicting transaction paying a higher fee rate."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_Bip125Signal a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(hex(s), s <= 0xfffffffd) for s in (0xffffffff, 0xfffffffe, 0xfffffffd, 0)] evaluates to [('0xffffffff', False), ('0xfffffffe', False), ('0xfffffffd', True), ('0x0', True)]"@en ; chx:input "[(hex(s), s <= 0xfffffffd) for s in (0xffffffff, 0xfffffffe, 0xfffffffd, 0)]" ; chx:output "[('0xffffffff', False), ('0xfffffffe', False), ('0xfffffffd', True), ('0x0', True)]" .
chx:X_Bip125Signal rd:hasIOExample chx:IO_Bip125Signal .
chx:X_Bip68Timelock a owl:NamedIndividual, chx:Bip68Timelock ; rdfs:label "30 blocks: confirm 29 blocks after the output"@en ; skos:definition "Under BIP68 a version 2 input with sequence below 2 to the 31 may only be confirmed once the output it spends has aged by the sequence's value: a lock of 30 blocks allows confirmation with at least 29 blocks between the two."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_Bip68Timelock a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spent_at, lock: (spent_at + lock, spent_at + lock - spent_at - 1))(774958, 30) evaluates to (774988, 29)"@en ; chx:input "(lambda spent_at, lock: (spent_at + lock, spent_at + lock - spent_at - 1))(774958, 30)" ; chx:output "(774988, 29)" .
chx:X_Bip68Timelock rd:hasIOExample chx:IO_Bip68Timelock .
chx:X_TypeFlag a owl:NamedIndividual, chx:TypeFlag ; rdfs:label "bit 22 chooses blocks or 512-second units"@en ; skos:definition "The type flag is bit 22 of the sequence, value 1 shifted left 22; set, the lock counts units of 512 seconds, clear, it counts blocks."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_TypeFlag a owl:NamedIndividual, rd:IOExample ; rdfs:label "(1 << 22, hex(1 << 22), (1 << 22 | 8) & 0xffff, ((1 << 22 | 8) & 0xffff) * 512) evaluates to (4194304, '0x400000', 8, 4096)"@en ; chx:input "(1 << 22, hex(1 << 22), (1 << 22 | 8) & 0xffff, ((1 << 22 | 8) & 0xffff) * 512)" ; chx:output "(4194304, '0x400000', 8, 4096)" .
chx:X_TypeFlag rd:hasIOExample chx:IO_TypeFlag .
chx:X_DisableFlag a owl:NamedIndividual, chx:DisableFlag ; rdfs:label "bit 31 switches the timelock off"@en ; skos:definition "The disable flag is bit 31 of the sequence; an input with it set has no relative timelock even in a version 2 transaction, so a transaction may mix locked and unlocked inputs."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_DisableFlag a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(hex(s), bool(s & 1 << 31)) for s in (0xffffffff, 0x80000000, 0x7fffffff, 30)] evaluates to [('0xffffffff', True), ('0x80000000', True), ('0x7fffffff', False), ('0x1e', False)]"@en ; chx:input "[(hex(s), bool(s & 1 << 31)) for s in (0xffffffff, 0x80000000, 0x7fffffff, 30)]" ; chx:output "[('0xffffffff', True), ('0x80000000', True), ('0x7fffffff', False), ('0x1e', False)]" .
chx:X_DisableFlag rd:hasIOExample chx:IO_DisableFlag .
chx:X_TimelockMask a owl:NamedIndividual, chx:TimelockMask ; rdfs:label "65,535 blocks or units, about a year"@en ; skos:definition "Only the 16 least significant bits of the sequence carry the relative timelock, so the mask 0x0000ffff extracts a value of at most 65,535, which in blocks or in 512-second units is a bit more than a year."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_TimelockMask a owl:NamedIndividual, rd:IOExample ; rdfs:label "(0xffff, 0xffff * 512 // 86400, 0xffff * 600 // 86400) evaluates to (65535, 388, 455)"@en ; chx:input "(0xffff, 0xffff * 512 // 86400, 0xffff * 600 // 86400)" ; chx:output "(65535, 388, 455)" .
chx:X_TimelockMask rd:hasIOExample chx:IO_TimelockMask .
chx:X_OutputCount a owl:NamedIndividual, chx:OutputCount ; rdfs:label "two outputs: a payment and change"@en ; skos:definition "The output count is the compactSize integer that opens the outputs field; it must be greater than zero, and Alice's transaction has two outputs."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_OutputCount a owl:NamedIndividual, rd:IOExample ; rdfs:label "int.from_bytes(bytes.fromhex('')[48:49], 'little') evaluates to 2"@en ; chx:input "int.from_bytes(bytes.fromhex('')[48:49], 'little')" ; chx:output "2" .
chx:X_OutputCount rd:hasIOExample chx:IO_OutputCount .
chx:X_AmountField a owl:NamedIndividual, chx:AmountField ; rdfs:label "8 bytes, little-endian, in satoshis"@en ; skos:definition "The amount is the first field of an output: an 8-byte signed little-endian integer of satoshis, called value in Bitcoin Core; Alice's first output carries 20,000."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_AmountField a owl:NamedIndividual, rd:IOExample ; rdfs:label "int.from_bytes(bytes.fromhex('204e000000000000'), 'little') evaluates to 20000"@en ; chx:input "int.from_bytes(bytes.fromhex('204e000000000000'), 'little')" ; chx:output "20000" .
chx:X_AmountField rd:hasIOExample chx:IO_AmountField .
chx:X_Satoshi a owl:NamedIndividual, chx:Satoshi ; rdfs:label "100 million to a bitcoin"@en ; skos:definition "A satoshi is the smallest unit of bitcoin an on-chain transaction can represent; there are 100 million satoshis in a bitcoin, so 20,000 satoshis are 0.0002 bitcoin."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_Satoshi a owl:NamedIndividual, rd:IOExample ; rdfs:label "(100_000_000, 20000 / 100_000_000, 75000 / 100_000_000) evaluates to (100000000, 0.0002, 0.00075)"@en ; chx:input "(100_000_000, 20000 / 100_000_000, 75000 / 100_000_000)" ; chx:output "(100000000, 0.0002, 0.00075)" .
chx:X_Satoshi rd:hasIOExample chx:IO_Satoshi .
chx:X_AmountRange a owl:NamedIndividual, chx:AmountRange ; rdfs:label "from 0 to 2.1 quadrillion"@en ; skos:definition "Consensus allows an output amount from zero to 21 million bitcoins, 2.1 quadrillion satoshis; Bitcoin Core names the maximum MAX_MONEY and refuses negative, oversized and overflowing totals."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_AmountRange a owl:NamedIndividual, rd:IOExample ; rdfs:label "(21_000_000 * 100_000_000, 21_000_000 * 100_000_000 == 2_100_000_000_000_000, 0 <= 20000 <= 21_000_000 * 100_000_000) evaluates to (2100000000000000, True, True)"@en ; chx:input "(21_000_000 * 100_000_000, 21_000_000 * 100_000_000 == 2_100_000_000_000_000, 0 <= 20000 <= 21_000_000 * 100_000_000)" ; chx:output "(2100000000000000, True, True)" .
chx:X_AmountRange rd:hasIOExample chx:IO_AmountRange .
chx:X_UneconomicalOutput a owl:NamedIndividual, chx:UneconomicalOutput ; rdfs:label "worth less than the fee to spend it"@en ; skos:definition "An uneconomical output is one whose value is less than the extra fee that spending it would add to a transaction; a zero-value output is always uneconomical, and others become so when fee rates rise."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_UneconomicalOutput a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda value, input_vbytes, rate: (input_vbytes * rate, value < input_vbytes * rate))(500, 68, 10) evaluates to (680, True)"@en ; chx:input "(lambda value, input_vbytes, rate: (input_vbytes * rate, value < input_vbytes * rate))(500, 68, 10)" ; chx:output "(680, True)" .
chx:X_UneconomicalOutput rd:hasIOExample chx:IO_UneconomicalOutput .
chx:X_DustLimit a owl:NamedIndividual, chx:DustLimit ; rdfs:label "546 satoshis, from 182 bytes at 3,000 sat/kvB"@en ; skos:definition "Bitcoin Core's dust threshold is the size of an output plus the smallest input that could spend it, times the dust relay rate of 3,000 satoshis per kilo-vbyte: 546 satoshis for a legacy P2PKH output, 294 for a P2WPKH output."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_DustLimit a owl:NamedIndividual, rd:IOExample ; rdfs:label "((34 + 148) * 3000 // 1000, (31 + 67) * 3000 // 1000) evaluates to (546, 294)"@en ; chx:input "((34 + 148) * 3000 // 1000, (31 + 67) * 3000 // 1000)" ; chx:output "(546, 294)" .
chx:X_DustLimit rd:hasIOExample chx:IO_DustLimit .
chx:X_DataCarrierOutput a owl:NamedIndividual, chx:DataCarrierOutput ; rdfs:label "OP_RETURN: unspendable, so not dust"@en ; skos:definition "A data-carrier output is one whose script begins with OP_RETURN; it can never be spent, so nodes need not keep it, and Bitcoin Core's dust policy allows it a value of zero."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_DataCarrierOutput a owl:NamedIndividual, rd:IOExample ; rdfs:label "(bytes.fromhex('6a')[0] == 0x6a, 'OP_RETURN', 0) evaluates to (True, 'OP_RETURN', 0)"@en ; chx:input "(bytes.fromhex('6a')[0] == 0x6a, 'OP_RETURN', 0)" ; chx:output "(True, 'OP_RETURN', 0)" .
chx:X_DataCarrierOutput rd:hasIOExample chx:IO_DataCarrierOutput .
chx:X_OutputScript a owl:NamedIndividual, chx:OutputScript ; rdfs:label "34 bytes to Bob, 22 bytes of change"@en ; skos:definition "The output script holds the conditions for spending an output; Alice's first is a 34-byte segwit version 1 script for Bob, her second a 22-byte segwit version 0 script for her change."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_OutputScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"tx = bytes.fromhex('')\\nlen0 = tx[57]; s0 = tx[58:58 + len0]            # after the count at 48 and the 8-byte amount\\nlen1 = tx[58 + len0 + 8]; s1 = tx[58 + len0 + 9:58 + len0 + 9 + len1]\\nresult = (len0, s0[:2].hex(), len1, s1[:2].hex())\", g), g['result'])[1])({}) evaluates to (34, '5120', 22, '0014')"@en ; chx:input "(lambda g: (exec(\"tx = bytes.fromhex('')\\nlen0 = tx[57]; s0 = tx[58:58 + len0]            # after the count at 48 and the 8-byte amount\\nlen1 = tx[58 + len0 + 8]; s1 = tx[58 + len0 + 9:58 + len0 + 9 + len1]\\nresult = (len0, s0[:2].hex(), len1, s1[:2].hex())\", g), g['result'])[1])({})" ; chx:output "(34, '5120', 22, '0014')" .
chx:X_OutputScript rd:hasIOExample chx:IO_OutputScript .
chx:X_ScriptSizeLimit a owl:NamedIndividual, chx:ScriptSizeLimit ; rdfs:label "zero at minimum, 10,000 bytes to spend"@en ; skos:definition "Consensus sets the minimum size of an output script at zero and no explicit maximum when it is created, but a later transaction can only spend an output whose script is 10,000 bytes or smaller."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_ScriptSizeLimit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(0, 10000, 10000 * 4 <= 4000000) evaluates to (0, 10000, True)"@en ; chx:input "(0, 10000, 10000 * 4 <= 4000000)" ; chx:output "(0, 10000, True)" .
chx:X_ScriptSizeLimit rd:hasIOExample chx:IO_ScriptSizeLimit .
chx:X_AnyoneCanSpend a owl:NamedIndividual, chx:AnyoneCanSpend ; rdfs:label "an empty script that OP_TRUE satisfies"@en ; skos:definition "An anyone-can-spend script is one anyone can satisfy, such as the empty output script spent by an input script of OP_TRUE; upgrades take such a script and add constraints to it."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_AnyoneCanSpend a owl:NamedIndividual, rd:IOExample ; rdfs:label "(len(b''), bytes.fromhex('51')[0] == 0x51, 'OP_TRUE') evaluates to (0, True, 'OP_TRUE')"@en ; chx:input "(len(b''), bytes.fromhex('51')[0] == 0x51, 'OP_TRUE')" ; chx:output "(0, True, 'OP_TRUE')" .
chx:X_AnyoneCanSpend rd:hasIOExample chx:IO_AnyoneCanSpend .
chx:X_StandardOutput a owl:NamedIndividual, chx:StandardOutput ; rdfs:label "a few templates relay policy allows"@en ; skos:definition "Standard transaction outputs are the few output script templates that Bitcoin Core's policy for relaying and mining transactions allows, kept to support upgrades and to encourage putting conditions in redeem, witness and leaf scripts."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_StandardOutput a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted(['P2PKH', 'P2SH', 'P2WPKH', 'P2WSH', 'P2TR', 'bare multisig', 'OP_RETURN']) evaluates to ['OP_RETURN', 'P2PKH', 'P2SH', 'P2TR', 'P2WPKH', 'P2WSH', 'bare multisig']"@en ; chx:input "sorted(['P2PKH', 'P2SH', 'P2WPKH', 'P2WSH', 'P2TR', 'bare multisig', 'OP_RETURN'])" ; chx:output "['OP_RETURN', 'P2PKH', 'P2SH', 'P2TR', 'P2WPKH', 'P2WSH', 'bare multisig']" .
chx:X_StandardOutput rd:hasIOExample chx:IO_StandardOutput .
chx:X_Witness a owl:NamedIndividual, chx:Witness ; rdfs:label "the value 2 solves 2 OP_ADD 4 OP_EQUAL"@en ; skos:definition "A witness is data that solves the math problem protecting an output, which full nodes check instead of trusting; for the script 2 OP_ADD 4 OP_EQUAL the witness is the value 2."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_Witness a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda witness: witness + 2 == 4)(2) evaluates to True"@en ; chx:input "(lambda witness: witness + 2 == 4)(2)" ; chx:output "True" .
chx:X_Witness rd:hasIOExample chx:IO_Witness .
chx:X_SignatureWitness a owl:NamedIndividual, chx:SignatureWitness ; rdfs:label "a problem only the key holder can solve"@en ; skos:definition "In a digital signature scheme the public key is a public identifier of secret data and the signature a solution to an equation only the holder of that data can produce; a script of a public key and OP_CHECKSIG makes the signature the witness."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_SignatureWitness a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda problem: (problem['identifier'], problem['solver'], problem['witness']))({'identifier': 'public key', 'solver': 'the holder of the private key', 'witness': 'signature'}) evaluates to ('public key', 'the holder of the private key', 'signature')"@en ; chx:input "(lambda problem: (problem['identifier'], problem['solver'], problem['witness']))({'identifier': 'public key', 'solver': 'the holder of the private key', 'witness': 'signature'})" ; chx:output "('public key', 'the holder of the private key', 'signature')" .
chx:X_SignatureWitness rd:hasIOExample chx:IO_SignatureWitness .
chx:X_ContractProtocol a owl:NamedIndividual, chx:ContractProtocol ; rdfs:label "transactions signed out of order"@en ; skos:definition "A contract protocol is a series of transactions between parties, often signed out of order so that each party is protected before committing; the payment channel is one, and such protocols exposed the problems with witnesses in the input script."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_ContractProtocol a owl:NamedIndividual, rd:IOExample ; rdfs:label "['setup transaction', 'refund transaction', 'rounds of the game', 'final transaction'] evaluates to ['setup transaction', 'refund transaction', 'rounds of the game', 'final transaction']"@en ; chx:input "['setup transaction', 'refund transaction', 'rounds of the game', 'final transaction']" ; chx:output "['setup transaction', 'refund transaction', 'rounds of the game', 'final transaction']" .
chx:X_ContractProtocol rd:hasIOExample chx:IO_ContractProtocol .
chx:X_CircularDependency a owl:NamedIndividual, chx:CircularDependency ; rdfs:label "the refund needs the deposit's txid first"@en ; skos:definition "A circular dependency arises when Alice and Bob want to sign a refund before the deposit it spends, but in the legacy format the deposit's txid depends on its signatures, so the refund cannot be built until both have signed the deposit."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_CircularDependency a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda needs: needs['refund'] in needs and needs[needs['refund']] == 'signatures of the deposit')({'refund': 'txid of the deposit', 'txid of the deposit': 'signatures of the deposit'}) evaluates to True"@en ; chx:input "(lambda needs: needs['refund'] in needs and needs[needs['refund']] == 'signatures of the deposit')({'refund': 'txid of the deposit', 'txid of the deposit': 'signatures of the deposit'})" ; chx:output "True" .
chx:X_CircularDependency rd:hasIOExample chx:IO_CircularDependency .
chx:X_ThirdPartyMalleability a owl:NamedIndividual, chx:ThirdPartyMalleability ; rdfs:label "a stranger changes the txid, not the payment"@en ; skos:definition "Unwanted third-party transaction malleability is a stranger's ability to change a transaction's txid without invalidating it, for example by re-encoding a push in the input script, so that a conflicting copy confirms and any transaction spending the original's outputs becomes invalid."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_ThirdPartyMalleability a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nh256 = lambda b: hashlib.sha256(hashlib.sha256(b).digest()).digest()\\nbody = bytes.fromhex('01000000') + bytes.fromhex('00' * 32 + '00000000')\\nvariants = {'OP_2': '52', 'OP_PUSH1 0x02': '0102', 'OP_PUSHDATA1 0x0102': '4c0102'}\\nids = {k: h256(body + bytes([len(v) // 2]) + bytes.fromhex(v) + bytes.fromhex('ffffffff'))[::-1].hex()[:8] for k, v in variants.items()}\\nresult = (len(set(ids.values())), ids)\", g), g['result'])[1])({}) evaluates to (3, {'OP_2': '394f3eb1', 'OP_PUSH1 0x02': '146b3825', 'OP_PUSHDATA1 0x0102': '009ae5eb'})"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nh256 = lambda b: hashlib.sha256(hashlib.sha256(b).digest()).digest()\\nbody = bytes.fromhex('01000000') + bytes.fromhex('00' * 32 + '00000000')\\nvariants = {'OP_2': '52', 'OP_PUSH1 0x02': '0102', 'OP_PUSHDATA1 0x0102': '4c0102'}\\nids = {k: h256(body + bytes([len(v) // 2]) + bytes.fromhex(v) + bytes.fromhex('ffffffff'))[::-1].hex()[:8] for k, v in variants.items()}\\nresult = (len(set(ids.values())), ids)\", g), g['result'])[1])({})" ; chx:output "(3, {'OP_2': '394f3eb1', 'OP_PUSH1 0x02': '146b3825', 'OP_PUSHDATA1 0x0102': '009ae5eb'})" .
chx:X_ThirdPartyMalleability rd:hasIOExample chx:IO_ThirdPartyMalleability .
chx:X_PushEncoding a owl:NamedIndividual, chx:PushEncoding ; rdfs:label "four byte strings for the number 2"@en ; skos:definition "The number 2 can be pushed as OP_2, as a one-byte push, as a two-byte push or with OP_PUSHDATA1; each is a different byte string, so each gives a legacy transaction a different txid while the script result is the same."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_PushEncoding a owl:NamedIndividual, rd:IOExample ; rdfs:label "{'OP_2': '52', 'OP_PUSH1 0x02': '0102', 'OP_PUSH2 0x0002': '020200', 'OP_PUSHDATA1 0x0102': '4c0102'} evaluates to {'OP_2': '52', 'OP_PUSH1 0x02': '0102', 'OP_PUSH2 0x0002': '020200', 'OP_PUSHDATA1 0x0102': '4c0102'}"@en ; chx:input "{'OP_2': '52', 'OP_PUSH1 0x02': '0102', 'OP_PUSH2 0x0002': '020200', 'OP_PUSHDATA1 0x0102': '4c0102'}" ; chx:output "{'OP_2': '52', 'OP_PUSH1 0x02': '0102', 'OP_PUSH2 0x0002': '020200', 'OP_PUSHDATA1 0x0102': '4c0102'}" .
chx:X_PushEncoding rd:hasIOExample chx:IO_PushEncoding .
chx:X_SecondPartyMalleability a owl:NamedIndividual, chx:SecondPartyMalleability ; rdfs:label "a counterparty re-signs and changes the txid"@en ; skos:definition "Unwanted second-party transaction malleability is a counterparty's ability to produce an alternative signature, because a signer chooses a random number each time, and so a conflicting transaction with a different txid that invalidates a presigned refund."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_SecondPartyMalleability a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda same_data, nonce_a, nonce_b: (same_data, nonce_a != nonce_b, 'different signature, different txid'))(True, 1234, 5678) evaluates to (True, True, 'different signature, different txid')"@en ; chx:input "(lambda same_data, nonce_a, nonce_b: (same_data, nonce_a != nonce_b, 'different signature, different txid'))(True, 1234, 5678)" ; chx:output "(True, True, 'different signature, different txid')" .
chx:X_SecondPartyMalleability rd:hasIOExample chx:IO_SecondPartyMalleability .
chx:X_WantedMalleability a owl:NamedIndividual, chx:WantedMalleability ; rdfs:label "mutation the sender allows"@en ; skos:definition "Some malleability is wanted: with a signature hash the sender can allow others to change parts of a transaction, as when Bob adds an input to help pay Alice's fee; the book says unwanted when it means the other kind."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_WantedMalleability a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda kinds: [k for k in kinds if kinds[k]])({'unwanted third-party': False, 'unwanted second-party': False, 'sender-permitted (sighash)': True}) evaluates to ['sender-permitted (sighash)']"@en ; chx:input "(lambda kinds: [k for k in kinds if kinds[k]])({'unwanted third-party': False, 'unwanted second-party': False, 'sender-permitted (sighash)': True})" ; chx:output "['sender-permitted (sighash)']" .
chx:X_WantedMalleability rd:hasIOExample chx:IO_WantedMalleability .
chx:X_Segwit a owl:NamedIndividual, chx:Segwit ; rdfs:label "the witness stays out of the txid"@en ; skos:definition "Segregated witness is the separation of a transaction's witness from the data its txid is computed over; an empty input script keeps witnesses from affecting the txid and so removes circular dependencies and both unwanted malleabilities."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_Segwit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"import hashlib\\nh256 = lambda b: hashlib.sha256(hashlib.sha256(b).digest()).digest()\\ntx = bytes.fromhex('')\\nlegacy = tx[:4] + tx[6:-71] + tx[-4:]        # no marker, flag or witness\\nresult = h256(legacy)[::-1].hex()\", g), g['result'])[1])({}) evaluates to '466200308696215bbc949d5141a49a4138ecdfdfaa2a8029c1f9bcecd1f96177'"@en ; chx:input "(lambda g: (exec(\"import hashlib\\nh256 = lambda b: hashlib.sha256(hashlib.sha256(b).digest()).digest()\\ntx = bytes.fromhex('')\\nlegacy = tx[:4] + tx[6:-71] + tx[-4:]        # no marker, flag or witness\\nresult = h256(legacy)[::-1].hex()\", g), g['result'])[1])({})" ; chx:output "'466200308696215bbc949d5141a49a4138ecdfdfaa2a8029c1f9bcecd1f96177'" .
chx:X_Segwit rd:hasIOExample chx:IO_Segwit .
chx:X_HardFork a owl:NamedIndividual, chx:HardFork ; rdfs:label "a change old nodes would reject"@en ; skos:definition "A hard fork is a change to the consensus rules that is not compatible with older full nodes; the obvious way to implement segwit needed one, which is why an alternative was sought."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_HardFork a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda old_accepts, new_accepts: 'hard fork' if new_accepts - old_accepts else 'soft fork')({'legacy blocks'}, {'legacy blocks', 'blocks old nodes reject'}) evaluates to 'hard fork'"@en ; chx:input "(lambda old_accepts, new_accepts: 'hard fork' if new_accepts - old_accepts else 'soft fork')({'legacy blocks'}, {'legacy blocks', 'blocks old nodes reject'})" ; chx:output "'hard fork'" .
chx:X_HardFork rd:hasIOExample chx:IO_HardFork .
chx:X_SoftFork a owl:NamedIndividual, chx:SoftFork ; rdfs:label "new nodes reject more, accept no more"@en ; skos:definition "A soft fork is a backward-compatible change to the consensus rules: full nodes with the change must not accept any block that nodes without it would consider invalid, so new nodes can reject blocks old nodes accept but not the reverse."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_SoftFork a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda old_accepts, new_accepts: 'soft fork' if new_accepts <= old_accepts else 'hard fork')({'any spend of a segwit output', 'other blocks'}, {'other blocks'}) evaluates to 'soft fork'"@en ; chx:input "(lambda old_accepts, new_accepts: 'soft fork' if new_accepts <= old_accepts else 'hard fork')({'any spend of a segwit output', 'other blocks'}, {'other blocks'})" ; chx:output "'soft fork'" .
chx:X_SoftFork rd:hasIOExample chx:IO_SoftFork .
chx:X_WitnessProgram a owl:NamedIndividual, chx:WitnessProgram ; rdfs:label "a version number and 2 to 40 bytes"@en ; skos:definition "A witness program is the data in a segwit output script: a script of a number from 0 to 16 followed by 2 to 40 bytes is the segwit template, the number its version and the data the witness program; old nodes may spend it with an empty input script, new nodes require one."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_WitnessProgram a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (s[0] - 0x50 if s[0] else 0, s[1], len(s) - 2))(bytes.fromhex('51203b41daba4c9ace578369740f15e5ec880c28279ee7f51b07dca69c7061e07068')) evaluates to (1, 32, 32)"@en ; chx:input "(lambda s: (s[0] - 0x50 if s[0] else 0, s[1], len(s) - 2))(bytes.fromhex('51203b41daba4c9ace578369740f15e5ec880c28279ee7f51b07dca69c7061e07068'))" ; chx:output "(1, 32, 32)" .
chx:X_WitnessProgram rd:hasIOExample chx:IO_WitnessProgram .
chx:X_WitnessStructure a owl:NamedIndividual, chx:WitnessStructure ; rdfs:label "the new field for what the input script held"@en ; skos:definition "The witness structure is the field added by segwit to hold the data that an input script may no longer carry; it sits after the outputs and before the lock time and is not part of the txid."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_WitnessStructure a owl:NamedIndividual, rd:IOExample ; rdfs:label "[('whitepaper', 'public key', 'signature'), ('legacy', 'output script', 'input script'), ('segwit', 'witness program', 'witness structure')] evaluates to [('whitepaper', 'public key', 'signature'), ('legacy', 'output script', 'input script'), ('segwit', 'witness program', 'witness structure')]"@en ; chx:input "[('whitepaper', 'public key', 'signature'), ('legacy', 'output script', 'input script'), ('segwit', 'witness program', 'witness structure')]" ; chx:output "[('whitepaper', 'public key', 'signature'), ('legacy', 'output script', 'input script'), ('segwit', 'witness program', 'witness structure')]" .
chx:X_WitnessStructure rd:hasIOExample chx:IO_WitnessStructure .
chx:X_WitnessStack a owl:NamedIndividual, chx:WitnessStack ; rdfs:label "one stack per input, counted by the inputs"@en ; skos:definition "A witness stack is the part of the witness structure belonging to one input: a compactSize count of items followed by the items; there is one stack per input, so the structure has no count of its own."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_WitnessStack a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"tx = bytes.fromhex('')\\nn_inputs = tx[6]\\nstack_count = tx[123]                      # the witness structure starts at offset 123\\nresult = (n_inputs, stack_count)\", g), g['result'])[1])({}) evaluates to (1, 1)"@en ; chx:input "(lambda g: (exec(\"tx = bytes.fromhex('')\\nn_inputs = tx[6]\\nstack_count = tx[123]                      # the witness structure starts at offset 123\\nresult = (n_inputs, stack_count)\", g), g['result'])[1])({})" ; chx:output "(1, 1)" .
chx:X_WitnessStack rd:hasIOExample chx:IO_WitnessStack .
chx:X_WitnessItem a owl:NamedIndividual, chx:WitnessItem ; rdfs:label "a 65-byte signature, length-prefixed"@en ; skos:definition "A witness item is one element of a witness stack, prefixed by a compactSize integer giving its size; Alice's single item is a 65-byte signature."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_WitnessItem a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"tx = bytes.fromhex('')\\nitem_len = tx[124]\\nitem = tx[125:125 + item_len]\\nresult = (item_len, item[:4].hex(), item[-1])\", g), g['result'])[1])({}) evaluates to (65, 'cf5efe2d', 1)"@en ; chx:input "(lambda g: (exec(\"tx = bytes.fromhex('')\\nitem_len = tx[124]\\nitem = tx[125:125 + item_len]\\nresult = (item_len, item[:4].hex(), item[-1])\", g), g['result'])[1])({})" ; chx:output "(65, 'cf5efe2d', 1)" .
chx:X_WitnessItem rd:hasIOExample chx:IO_WitnessItem .
chx:X_LegacyInputWitness a owl:NamedIndividual, chx:LegacyInputWitness ; rdfs:label "a stack of zero items"@en ; skos:definition "A legacy input in a segwit transaction has a witness stack consisting entirely of a count of zero, 0x00, so the structure stays one stack per input."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_LegacyInputWitness a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda stacks: [len(s) for s in stacks])([[], ['signature', 'public key']]) evaluates to [0, 2]"@en ; chx:input "(lambda stacks: [len(s) for s in stacks])([[], ['signature', 'public key']])" ; chx:output "[0, 2]" .
chx:X_LegacyInputWitness rd:hasIOExample chx:IO_LegacyInputWitness .
chx:X_LockTimeField a owl:NamedIndividual, chx:LockTimeField ; rdfs:label "zero: eligible for any block"@en ; skos:definition "The lock time is the last 4 bytes of a transaction; zero makes it eligible for any block, and since block 31,000 a non-zero value is a consensus rule restricting which blocks may include it."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_LockTimeField a owl:NamedIndividual, rd:IOExample ; rdfs:label "int.from_bytes(bytes.fromhex('00000000'), 'little') evaluates to 0"@en ; chx:input "int.from_bytes(bytes.fromhex('00000000'), 'little')" ; chx:output "0" .
chx:X_LockTimeField rd:hasIOExample chx:IO_LockTimeField .
chx:X_HeightLock a owl:NamedIndividual, chx:HeightLock ; rdfs:label "123,456 means block 123,456 or later"@en ; skos:definition "A lock time below 500,000,000 is a block height: the transaction can only be included in a block whose height is equal to the lock time or higher, so 123,456 allows block 123,456 and any later one."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_HeightLock a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda lt, h: lt < 500_000_000 and h >= lt)(123456, 123456) evaluates to True"@en ; chx:input "(lambda lt, h: lt < 500_000_000 and h >= lt)(123456, 123456)" ; chx:output "True" .
chx:X_HeightLock rd:hasIOExample chx:IO_HeightLock .
chx:X_TimeLock a owl:NamedIndividual, chx:TimeLock ; rdfs:label "500,000,000 or more is a timestamp"@en ; skos:definition "A lock time of 500,000,000 or more is an epoch time, seconds since 1970-01-01T00:00 UTC; the transaction can only be included in a block whose median time past is greater than the lock time."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_TimeLock a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda lt: 'epoch time' if lt >= 500_000_000 else 'block height')(1675559245) evaluates to 'epoch time'"@en ; chx:input "(lambda lt: 'epoch time' if lt >= 500_000_000 else 'block height')(1675559245)" ; chx:output "'epoch time'" .
chx:X_TimeLock rd:hasIOExample chx:IO_TimeLock .
chx:X_MedianTimePast a owl:NamedIndividual, chx:MedianTimePast ; rdfs:label "the middle of eleven block times"@en ; skos:definition "The median time past (MTP) of a block is the median of the timestamps of the last eleven blocks; time locks are compared with it, and it is normally an hour or two behind the clock."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_MedianTimePast a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted([1675558000, 1675558600, 1675557000, 1675559245, 1675558900, 1675556500, 1675559100, 1675558300, 1675557700, 1675558800, 1675559000])[5] evaluates to 1675558600"@en ; chx:input "sorted([1675558000, 1675558600, 1675557000, 1675559245, 1675558900, 1675556500, 1675559100, 1675558300, 1675557700, 1675558800, 1675559000])[5]" ; chx:output "1675558600" .
chx:X_MedianTimePast rd:hasIOExample chx:IO_MedianTimePast .
chx:X_Coinbase a owl:NamedIndividual, chx:Coinbase ; rdfs:label "first in the block, made by the miner"@en ; skos:definition "The coinbase transaction is the first transaction of a block, created by its miner to claim the block's fees and, until the subsidy runs out, newly created bitcoins; older documents call it a generation transaction."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_Coinbase a owl:NamedIndividual, rd:IOExample ; rdfs:label "['the first transaction in the block', 'created by the miner', 'claims the fees and the subsidy'] evaluates to ['the first transaction in the block', 'created by the miner', 'claims the fees and the subsidy']"@en ; chx:input "['the first transaction in the block', 'created by the miner', 'claims the fees and the subsidy']" ; chx:output "['the first transaction in the block', 'created by the miner', 'claims the fees and the subsidy']" .
chx:X_Coinbase rd:hasIOExample chx:IO_Coinbase .
chx:X_NullOutpoint a owl:NamedIndividual, chx:NullOutpoint ; rdfs:label "32 zero bytes and index 0xffffffff"@en ; skos:definition "A coinbase transaction's single input must have an outpoint with a null txid of all zeros and the maximal output index 0xffffffff, so that it cannot reference a previous output."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_NullOutpoint a owl:NamedIndividual, rd:IOExample ; rdfs:label "(bytes(32).hex() == '00' * 32, int.from_bytes(bytes.fromhex('ffffffff'), 'little') == 0xffffffff, 0xffffffff) evaluates to (True, True, 4294967295)"@en ; chx:input "(bytes(32).hex() == '00' * 32, int.from_bytes(bytes.fromhex('ffffffff'), 'little') == 0xffffffff, 0xffffffff)" ; chx:output "(True, True, 4294967295)" .
chx:X_NullOutpoint rd:hasIOExample chx:IO_NullOutpoint .
chx:X_CoinbaseField a owl:NamedIndividual, chx:CoinbaseField ; rdfs:label "2 to 100 bytes, beginning with the height"@en ; skos:definition "The coinbase field is the coinbase transaction's input-script field, 2 to 100 bytes long, not executed, and since BIP34 beginning with a push of the block height; it gives the transaction its name."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_CoinbaseField a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda field: (len(field), 2 <= len(field) <= 100, field[0], int.from_bytes(field[1:1 + field[0]], 'little')))(bytes.fromhex('03e0e60b') + b'/example miner/') evaluates to (19, True, 3, 780000)"@en ; chx:input "(lambda field: (len(field), 2 <= len(field) <= 100, field[0], int.from_bytes(field[1:1 + field[0]], 'little')))(bytes.fromhex('03e0e60b') + b'/example miner/')" ; chx:output "(19, True, 3, 780000)" .
chx:X_CoinbaseField rd:hasIOExample chx:IO_CoinbaseField .
chx:X_BlockSubsidy a owl:NamedIndividual, chx:BlockSubsidy ; rdfs:label "50 BTC, halved every 210,000 blocks"@en ; skos:definition "The block subsidy is the newly created bitcoin a coinbase may claim: 50 BTC at first, halved every 210,000 blocks and rounded down to the satoshi, so that the total issued is just under 21 million."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_BlockSubsidy a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('subsidy = lambda h: (50 * 100_000_000) >> (h // 210_000) if h // 210_000 < 64 else 0\\nresult = (subsidy(0) / 1e8, subsidy(840_000) / 1e8, subsidy(6_720_000), subsidy(6_929_999), subsidy(6_930_000))', g), g['result'])[1])({}) evaluates to (50.0, 3.125, 1, 1, 0)"@en ; chx:input "(lambda g: (exec('subsidy = lambda h: (50 * 100_000_000) >> (h // 210_000) if h // 210_000 < 64 else 0\\nresult = (subsidy(0) / 1e8, subsidy(840_000) / 1e8, subsidy(6_720_000), subsidy(6_929_999), subsidy(6_930_000))', g), g['result'])[1])({})" ; chx:output "(50.0, 3.125, 1, 1, 0)" .
chx:X_BlockSubsidy rd:hasIOExample chx:IO_BlockSubsidy .
chx:X_BlockReward a owl:NamedIndividual, chx:BlockReward ; rdfs:label "fees plus subsidy, as a ceiling"@en ; skos:definition "The block reward is the total a miner can claim for a block, the fees of its transactions plus the subsidy; the coinbase's outputs may sum to no more than it."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_BlockReward a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda fees, subsidy, claimed: (fees + subsidy, claimed <= fees + subsidy))(5000 + 12000 + 3000, 312_500_000, 312_520_000) evaluates to (312520000, True)"@en ; chx:input "(lambda fees, subsidy, claimed: (fees + subsidy, claimed <= fees + subsidy))(5000 + 12000 + 3000, 312_500_000, 312_520_000)" ; chx:output "(312520000, True)" .
chx:X_BlockReward rd:hasIOExample chx:IO_BlockReward .
chx:X_MaturityRule a owl:NamedIndividual, chx:MaturityRule ; rdfs:label "100 confirmations before spending"@en ; skos:definition "The maturity rule says a transaction spending a coinbase output cannot be included in any block until the coinbase has 100 confirmations; outputs with fewer are called immature."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_MaturityRule a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda coinbase_height, spend_height: (spend_height - coinbase_height, spend_height - coinbase_height >= 100))(170 - 161, 170) evaluates to (161, True)"@en ; chx:input "(lambda coinbase_height, spend_height: (spend_height - coinbase_height, spend_height - coinbase_height >= 100))(170 - 161, 170)" ; chx:output "(161, True)" .
chx:X_MaturityRule rd:hasIOExample chx:IO_MaturityRule .
chx:X_Weight a owl:NamedIndividual, chx:Weight ; rdfs:label "3 times the legacy size plus the full size"@en ; skos:definition "Weight is BIP141's measure of a transaction: the legacy serialization's size times 3 plus the full serialization's size, which is 569 for Alice's transaction, the figure Bitcoin Core reports."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_Weight a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"tx = bytes.fromhex('')\\nlegacy = tx[:4] + tx[6:-71] + tx[-4:]\\nresult = (len(legacy), len(tx), len(legacy) * 3 + len(tx))\", g), g['result'])[1])({}) evaluates to (125, 194, 569)"@en ; chx:input "(lambda g: (exec(\"tx = bytes.fromhex('')\\nlegacy = tx[:4] + tx[6:-71] + tx[-4:]\\nresult = (len(legacy), len(tx), len(legacy) * 3 + len(tx))\", g), g['result'])[1])({})" ; chx:output "(125, 194, 569)" .
chx:X_Weight rd:hasIOExample chx:IO_Weight .
chx:X_Vbyte a owl:NamedIndividual, chx:Vbyte ; rdfs:label "weight divided by four, rounded up"@en ; skos:definition "A vbyte is a quarter of a weight unit, rounded up, so that a legacy transaction's vbytes equal its bytes; Alice's transaction is 143 vbytes."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_Vbyte a owl:NamedIndividual, rd:IOExample ; rdfs:label "(-(-569 // 4), 569 / 4, 194 * 4 // 4) evaluates to (143, 142.25, 194)"@en ; chx:input "(-(-569 // 4), 569 / 4, 194 * 4 // 4)" ; chx:output "(143, 142.25, 194)" .
chx:X_Vbyte rd:hasIOExample chx:IO_Vbyte .
chx:X_BlockWeightLimit a owl:NamedIndividual, chx:BlockWeightLimit ; rdfs:label "4 million weight a block"@en ; skos:definition "Blocks are limited to 4,000,000 weight, Bitcoin Core's MAX_BLOCK_WEIGHT; the header and the transaction count take a small fixed share and the rest is for transactions."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_BlockWeightLimit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(4_000_000, 4_000_000 // 4, 4_000_000 // 569) evaluates to (4000000, 1000000, 7029)"@en ; chx:input "(4_000_000, 4_000_000 // 4, 4_000_000 // 569)" ; chx:output "(4000000, 1000000, 7029)" .
chx:X_BlockWeightLimit rd:hasIOExample chx:IO_BlockWeightLimit .
chx:X_WeightFactor a owl:NamedIndividual, chx:WeightFactor ; rdfs:label "4 for most fields, 1 for marker, flag and witness"@en ; skos:definition "Each field's weight is its serialized size times a factor: 4 for the version, inputs, outputs and lock time, 1 for the marker, the flag and the witness structure; summed over Alice's transaction the factors give 569."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_WeightFactor a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec(\"rows = [('Version', 4, 4), ('Marker & Flag', 2, 1), ('Inputs Count', 1, 4), ('Outpoint', 36, 4), ('Input script', 1, 4), ('Sequence', 4, 4), ('Outputs Count', 1, 4), ('Amount', 16, 4), ('Output script', 58, 4), ('Witness Count', 1, 1), ('Witness items', 66, 1), ('Lock time', 4, 4)]\\nresult = ([(n, b * f) for n, b, f in rows], sum(b * f for n, b, f in rows))\", g), g['result'])[1])({}) evaluates to ([('Version', 16), ('Marker & Flag', 2), ('Inputs Count', 4), ('Outpoint', 144), ('Input script', 4), ('Sequence', 16), ('Outputs Count', 4), ('Amount', 64), ('Output script', 232), ('Witness Count', 1), ('Witness items', 66), ('Lock time', 16)], 569)"@en ; chx:input "(lambda g: (exec(\"rows = [('Version', 4, 4), ('Marker & Flag', 2, 1), ('Inputs Count', 1, 4), ('Outpoint', 36, 4), ('Input script', 1, 4), ('Sequence', 4, 4), ('Outputs Count', 1, 4), ('Amount', 16, 4), ('Output script', 58, 4), ('Witness Count', 1, 1), ('Witness items', 66, 1), ('Lock time', 4, 4)]\\nresult = ([(n, b * f) for n, b, f in rows], sum(b * f for n, b, f in rows))\", g), g['result'])[1])({})" ; chx:output "([('Version', 16), ('Marker & Flag', 2), ('Inputs Count', 4), ('Outpoint', 144), ('Input script', 4), ('Sequence', 16), ('Outputs Count', 4), ('Amount', 64), ('Output script', 232), ('Witness Count', 1), ('Witness items', 66), ('Lock time', 16)], 569)" .
chx:X_WeightFactor rd:hasIOExample chx:IO_WeightFactor .
chx:X_HashFunction a owl:NamedIndividual, chx:HashFunction ; rdfs:label "any input, a fixed 32-byte digest"@en ; skos:definition "A hash function maps input of any length to a fixed-length digest, one-way and unpredictable, so that a digest can identify data and commit to it; Bitcoin's is SHA-256, with a 32-byte output."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_HashFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(len(__import__('hashlib').sha256(b'').digest()), len(__import__('hashlib').sha256(b'x' * 10000).digest())) evaluates to (32, 32)"@en ; chx:input "(len(__import__('hashlib').sha256(b'').digest()), len(__import__('hashlib').sha256(b'x' * 10000).digest()))" ; chx:output "(32, 32)" .
chx:X_HashFunction rd:hasIOExample chx:IO_HashFunction .
chx:X_DoubleSha256 a owl:NamedIndividual, chx:DoubleSha256 ; rdfs:label "SHA-256 of SHA-256"@en ; skos:definition "Bitcoin's identifiers are double SHA-256: the hash function applied to its own output, so a txid is SHA-256 of SHA-256 of the legacy serialization, shown reversed."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_DoubleSha256 a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hashlib').sha256(__import__('hashlib').sha256(b'hello').digest()).digest()[::-1].hex()[:16] evaluates to '503d8319a48348cd'"@en ; chx:input "__import__('hashlib').sha256(__import__('hashlib').sha256(b'hello').digest()).digest()[::-1].hex()[:16]" ; chx:output "'503d8319a48348cd'" .
chx:X_DoubleSha256 rd:hasIOExample chx:IO_DoubleSha256 .
chx:X_Txid a owl:NamedIndividual, chx:Txid ; rdfs:label "double SHA-256 of the legacy bytes, reversed"@en ; skos:definition "The txid is the double SHA-256 of a transaction's legacy serialization, displayed in reversed byte order; for a segwit transaction it therefore excludes the witness."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_Txid a owl:NamedIndividual, rd:IOExample ; rdfs:label "len('466200308696215bbc949d5141a49a4138ecdfdfaa2a8029c1f9bcecd1f96177') evaluates to 64"@en ; chx:input "len('466200308696215bbc949d5141a49a4138ecdfdfaa2a8029c1f9bcecd1f96177')" ; chx:output "64" .
chx:X_Txid rd:hasIOExample chx:IO_Txid .
chx:X_Wtxid a owl:NamedIndividual, chx:Wtxid ; rdfs:label "the hash of everything, witness included"@en ; skos:definition "The wtxid is the double SHA-256 of the whole extended serialization, witness included; it changes when the witness changes, and blocks commit to it separately from the txid."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_Wtxid a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a, b: a != b)('466200308696215bbc949d5141a49a4138ecdfdfaa2a8029c1f9bcecd1f96177', 'f7cdbc7cf8b910d35cc69962e791138624e4eae7901010a6da4c02e7d238cdac') evaluates to True"@en ; chx:input "(lambda a, b: a != b)('466200308696215bbc949d5141a49a4138ecdfdfaa2a8029c1f9bcecd1f96177', 'f7cdbc7cf8b910d35cc69962e791138624e4eae7901010a6da4c02e7d238cdac')" ; chx:output "True" .
chx:X_Wtxid rd:hasIOExample chx:IO_Wtxid .
chx:X_RelayPolicy a owl:NamedIndividual, chx:RelayPolicy ; rdfs:label "what a node chooses to relay and keep"@en ; skos:definition "Relay policy is the set of rules a full node applies to unconfirmed transactions it relays and keeps in its memory pool; it is chosen by the node, can change, and includes dust, standardness, version 3 and replacement rules."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_RelayPolicy a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted(['dust limit', 'standard outputs', 'version 3 restrictions', 'replace-by-fee', 'reserved features']) evaluates to ['dust limit', 'replace-by-fee', 'reserved features', 'standard outputs', 'version 3 restrictions']"@en ; chx:input "sorted(['dust limit', 'standard outputs', 'version 3 restrictions', 'replace-by-fee', 'reserved features'])" ; chx:output "['dust limit', 'replace-by-fee', 'reserved features', 'standard outputs', 'version 3 restrictions']" .
chx:X_RelayPolicy rd:hasIOExample chx:IO_RelayPolicy .
chx:X_ConsensusRule a owl:NamedIndividual, chx:ConsensusRule ; rdfs:label "what every node must enforce identically"@en ; skos:definition "A consensus rule is a rule every full node enforces identically to decide which blocks and transactions are valid; this chapter's examples are the input and output bounds, the amount range, BIP68, the lock time, the subsidy and the maturity rule."@en ; dcterms:source <http://example.org/sen0401/ch06/research> .
chx:IO_ConsensusRule a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted(['at least one input and one output', 'amount range', 'no double spend', 'BIP68 sequence locks', 'lock time since block 31,000', 'subsidy and reward', 'coinbase maturity', 'block weight']) evaluates to ['BIP68 sequence locks', 'amount range', 'at least one input and one output', 'block weight', 'coinbase maturity', 'lock time since block 31,000', 'no double spend', 'subsidy and reward']"@en ; chx:input "sorted(['at least one input and one output', 'amount range', 'no double spend', 'BIP68 sequence locks', 'lock time since block 31,000', 'subsidy and reward', 'coinbase maturity', 'block weight'])" ; chx:output "['BIP68 sequence locks', 'amount range', 'at least one input and one output', 'block weight', 'coinbase maturity', 'lock time since block 31,000', 'no double spend', 'subsidy and reward']" .
chx:X_ConsensusRule rd:hasIOExample chx:IO_ConsensusRule .
