chx:Err_CompactSize a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"def cs(n):\\n    assert 0 <= n <= 0xffffffffffffffff, 'compactSize holds 0 to 2 ** 64 - 1'\\n    return bytes([n]) if n <= 252 else b'\\\\xfd' + n.to_bytes(2, 'little')\\nresult = cs(2 ** 64).hex()\", g), g['result'])[1])({}) raises AssertionError: compactSize holds 0 to 2 ** 64 - 1"@en .
chx:X_CompactSize rd:hasErrorCondition chx:Err_CompactSize .
chx:Err_MarkerByte a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"tx = bytes.fromhex('')\\nassert tx[4] == 0 and tx[5] != 0, 'not the extended format: no marker and flag'\\nresult = tx[6]\", g), g['result'])[1])({}) raises AssertionError: not the extended format: no marker and flag"@en .
chx:X_MarkerByte rd:hasErrorCondition chx:Err_MarkerByte .
chx:Err_TimelockMask a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"blocks = 65536\\nassert blocks <= 0xffff, 'a relative timelock holds at most 65535 blocks'\\nresult = blocks & 0xffff\", g), g['result'])[1])({}) raises AssertionError: a relative timelock holds at most 65535 blocks"@en .
chx:X_TimelockMask rd:hasErrorCondition chx:Err_TimelockMask .
chx:Err_CoinbaseField a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"field = bytes.fromhex('03e0e60b') + b'/' + b'x' * 100\\nassert 2 <= len(field) <= 100, 'the coinbase field must be 2 to 100 bytes'\\nresult = len(field)\", g), g['result'])[1])({}) raises AssertionError: the coinbase field must be 2 to 100 bytes"@en .
chx:X_CoinbaseField rd:hasErrorCondition chx:Err_CoinbaseField .
chx:Err_AmountRange a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"value = 21_000_000 * 100_000_000 + 1\\nassert 0 <= value <= 21_000_000 * 100_000_000, 'the amount is outside the consensus range'\\nresult = value\", g), g['result'])[1])({}) raises AssertionError: the amount is outside the consensus range"@en .
chx:X_AmountRange rd:hasErrorCondition chx:Err_AmountRange .
chx:Err_WitnessProgram a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda g: (exec(\"script = bytes.fromhex('0014' + '00' * 20)\\nversion = script[0] if script[0] == 0 else script[0] - 0x50\\nassert version == 1, 'expected a segwit version 1 program'\\nresult = version\", g), g['result'])[1])({}) raises AssertionError: expected a segwit version 1 program"@en .
chx:X_WitnessProgram rd:hasErrorCondition chx:Err_WitnessProgram .
chx:Err_OutputIndex a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(0xffffffff + 1).to_bytes(4, 'little') raises OverflowError: int too big to convert"@en .
chx:X_OutputIndex rd:hasErrorCondition chx:Err_OutputIndex .
chx:Err_AmountField a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(2 ** 63).to_bytes(8, 'little', signed=True) raises OverflowError: int too big to convert"@en .
chx:X_AmountField rd:hasErrorCondition chx:Err_AmountField .
chx:Err_InputCount a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "int('', 16) raises ValueError: invalid literal for int() with base 16"@en .
chx:X_InputCount rd:hasErrorCondition chx:Err_InputCount .
chx:Err_PreviousTxid a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "bytes.fromhex('zz') raises ValueError: non-hexadecimal number found in fromhex() arg"@en .
chx:X_PreviousTxid rd:hasErrorCondition chx:Err_PreviousTxid .
chx:Err_DisplayByteOrder a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "{'4ac54180': 'display'}['eb3ae38f'] raises KeyError: 'eb3ae38f'"@en .
chx:X_DisplayByteOrder rd:hasErrorCondition chx:Err_DisplayByteOrder .
chx:Err_WitnessStack a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "bytes.fromhex('0141')[2 + 65] raises IndexError: index out of range"@en .
chx:X_WitnessStack rd:hasErrorCondition chx:Err_WitnessStack .

chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0401 chapter 6 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0401/ch06/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 6 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2, chx:CQ3, chx:CQ4, chx:CQ5, chx:CQ6, chx:CQ7 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What does a Bitcoin transaction ask full nodes to do, and which of its fields carries the pointer, the proof and the new assignment of value?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How is a transaction serialized in the extended and the legacy format, and can every byte of the chapter's example transaction be read back into a named field?"@en .
chx:CQ3 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "What do the version, the marker and the flag decide about the bytes that follow them, and why are new constraints tied to new version numbers?"@en .
chx:CQ4 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which three meanings has the sequence field carried, and how does BIP68's encoding of a relative timelock work bit by bit?"@en .
chx:CQ5 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Why did placing witnesses in the input script make the transaction identifier malleable, and how does segregated witness fix it without a hard fork?"@en .
chx:CQ6 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How are weight and vbytes computed, and does the chapter's figure of 569 for Alice's transaction reproduce from the bytes?"@en .
chx:CQ7 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Where do the chapter's statements differ from the standards, from Bitcoin Core's sources and from an independent explorer, and what does each difference change?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 6 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 6 through the Stage 1 research record: the chapter's own sections and named terms first, then the standards it cites (BIP30, BIP34, BIP62, BIP65, BIP68, BIP112, BIP113, BIP125, BIP141, BIP143, BIP144, BIP174, BIP370 and BIP431), Bitcoin Core's consensus, policy, primitives, script and validation sources at commit 05bc2f5 with its list of implemented proposals, and the raw bytes and explorer records of four transactions fetched from mempool.space on 2026-10-08; the supporting concepts (the ownership record, the byte map, the digest and its two byte orders, the satoshi, the hash function, double SHA-256, the txid and wtxid, relay policy and the consensus rule) were added because an audit of the explanations found them used without a concept of their own."@en ;
    dcterms:source <http://example.org/sen0401/ch06/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (330 checks listed in sen0401_ch06_corpus_v1_0_0.py), executed under CPython 3.14.6."@en ;
    dcterms:source "The execution run of this ontology's build, 08-tooling/sen0401_chapter_build_v1_0_1.py, over the claims in 08-tooling/sen0401_ch06_corpus_v1_0_0.py" .

