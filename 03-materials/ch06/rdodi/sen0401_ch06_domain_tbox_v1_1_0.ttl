chx:RelayPolicy a owl:Class ; rdfs:label "Relay policy"@en ; rdfs:subClassOf chx:Foundations ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:ConsensusRule a owl:Class ; rdfs:label "Consensus rule"@en ; rdfs:subClassOf chx:Foundations ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:TransactionAnatomy owl:disjointWith chx:VersionMarkerFlag .
chx:TransactionAnatomy owl:disjointWith chx:Inputs .
chx:TransactionAnatomy owl:disjointWith chx:SequenceField .
chx:TransactionAnatomy owl:disjointWith chx:Outputs .
chx:TransactionAnatomy owl:disjointWith chx:Witnesses .
chx:TransactionAnatomy owl:disjointWith chx:LockTimeAndCoinbase .
chx:TransactionAnatomy owl:disjointWith chx:WeightAndFoundations .
chx:VersionMarkerFlag owl:disjointWith chx:Inputs .
chx:VersionMarkerFlag owl:disjointWith chx:SequenceField .
chx:VersionMarkerFlag owl:disjointWith chx:Outputs .
chx:VersionMarkerFlag owl:disjointWith chx:Witnesses .
chx:VersionMarkerFlag owl:disjointWith chx:LockTimeAndCoinbase .
chx:VersionMarkerFlag owl:disjointWith chx:WeightAndFoundations .
chx:Inputs owl:disjointWith chx:SequenceField .
chx:Inputs owl:disjointWith chx:Outputs .
chx:Inputs owl:disjointWith chx:Witnesses .
chx:Inputs owl:disjointWith chx:LockTimeAndCoinbase .
chx:Inputs owl:disjointWith chx:WeightAndFoundations .
chx:SequenceField owl:disjointWith chx:Outputs .
chx:SequenceField owl:disjointWith chx:Witnesses .
chx:SequenceField owl:disjointWith chx:LockTimeAndCoinbase .
chx:SequenceField owl:disjointWith chx:WeightAndFoundations .
chx:Outputs owl:disjointWith chx:Witnesses .
chx:Outputs owl:disjointWith chx:LockTimeAndCoinbase .
chx:Outputs owl:disjointWith chx:WeightAndFoundations .
chx:Witnesses owl:disjointWith chx:LockTimeAndCoinbase .
chx:Witnesses owl:disjointWith chx:WeightAndFoundations .
chx:LockTimeAndCoinbase owl:disjointWith chx:WeightAndFoundations .
chx:hasOwner a owl:ObjectProperty ; rdfs:label "owned by"@en ; rdfs:subPropertyOf rd:hasOwningConcept ;
    rdfs:comment "A concept owned by the concept it belongs to, as the chapter's examples use it between typed things; domain and range are the union of every type the A-Box shows on the two sides (BP-D57 step 3)."@en ;
    rdfs:domain [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> owl:Class ; owl:unionOf ( chx:AmountRange chx:Bip125Signal chx:BlockSubsidy chx:CoinbaseField chx:DataCarrierOutput chx:Digest chx:DisableFlag chx:DisplayByteOrder chx:DoubleSha256 chx:DustLimit chx:FlagByte chx:HeightLock chx:InternalByteOrder chx:LegacyInputWitness chx:LengthPrefix chx:MarkerByte chx:MaturityRule chx:MedianTimePast chx:NullOutpoint chx:OutputIndex chx:PreviousTxid chx:PushEncoding chx:Satoshi chx:TimeLock chx:TimelockMask chx:Txid chx:TypeFlag chx:Vbyte chx:WeightFactor chx:WitnessItem chx:WitnessProgram chx:WitnessStack chx:WitnessStructure chx:Wtxid ) ] ;
    rdfs:range [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> owl:Class ; owl:unionOf ( chx:AmountField chx:Bip68Timelock chx:BlockReward chx:Coinbase chx:Digest chx:DoubleSha256 chx:DustLimit chx:ExtendedFormat chx:HashFunction chx:InputScript chx:LockTimeField chx:OptInRbf chx:Outpoint chx:Segwit chx:ThirdPartyMalleability chx:TimeLock chx:UneconomicalOutput chx:Weight chx:WitnessStack chx:WitnessStructure ) ] ;
    rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .

#################################################################
# Connectedness repair (discipline v2.19.0, BP-D56 and BP-D57), 2026-10-19.
# The datatype properties the A-Box uses and nothing declared, then the relations
# between the chapter's subject branches that the chapter's own sources state.
#################################################################
chx:input a owl:DatatypeProperty ; rdfs:label "input expression"@en ; rdfs:comment "The expression an input/output example evaluates."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:output a owl:DatatypeProperty ; rdfs:label "output value"@en ; rdfs:comment "The value that evaluating the example expression gives."@en ; rdfs:domain rd:IOExample ; rdfs:range xsd:string ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:separatesFromTxid a owl:ObjectProperty ; rdfs:label "separates the witness from"@en ;
    rdfs:comment "Segregated witness separates a transaction's witness from the data its txid is computed over. Basis: the chapter says of Segregated witness: 'Segregated witness is the separation of a transaction's witness from the data its txid is computed over'."@en ;
    rdfs:domain chx:Segwit ; rdfs:range chx:Txid ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:emptiesInputScript a owl:ObjectProperty ; rdfs:label "leaves empty"@en ;
    rdfs:comment "Segregated witness keeps witnesses from affecting the txid by leaving the input script empty. Basis: the chapter says of Segregated witness: 'an empty input script keeps witnesses from affecting the txid'."@en ;
    rdfs:domain chx:Segwit ; rdfs:range chx:InputScript ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:changesTxid a owl:ObjectProperty ; rdfs:label "changes the txid of"@en ;
    rdfs:comment "Third-party malleability is a stranger's ability to change a transaction's txid without invalidating it. Basis: the chapter says of Third-party transaction malleability: 'a stranger's ability to change a transaction's txid without invalidating it'."@en ;
    rdfs:domain chx:ThirdPartyMalleability ; rdfs:range chx:Txid ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:dependsOnTxid a owl:ObjectProperty ; rdfs:label "arises from the dependence of"@en ;
    rdfs:comment "In the legacy format the deposit's txid depends on its signatures. Basis: the chapter says of Circular dependency: 'in the legacy format the deposit's txid depends on its signatures'."@en ;
    rdfs:domain chx:CircularDependency ; rdfs:range chx:Txid ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:isDataInOutputScript a owl:ObjectProperty ; rdfs:label "is the data in"@en ;
    rdfs:comment "A witness program is the data in a segwit output script. Basis: the chapter says of Witness program: 'A witness program is the data in a segwit output script'."@en ;
    rdfs:domain chx:WitnessProgram ; rdfs:range chx:OutputScript ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:includesPaymentChannel a owl:ObjectProperty ; rdfs:label "includes"@en ;
    rdfs:comment "The payment channel is one of the contract protocols. Basis: the chapter says of Contract protocols: 'the payment channel is one'."@en ;
    rdfs:domain chx:ContractProtocol ; rdfs:range chx:PaymentChannel ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:computedOverLegacyFormat a owl:ObjectProperty ; rdfs:label "is computed over"@en ;
    rdfs:comment "The txid is the double SHA-256 of a transaction's legacy serialization. Basis: the chapter says of Transaction identifier: 'double SHA-256 of a transaction's legacy serialization'."@en ;
    rdfs:domain chx:Txid ; rdfs:range chx:LegacyFormat ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:computedOverExtendedFormat a owl:ObjectProperty ; rdfs:label "is computed over"@en ;
    rdfs:comment "The wtxid is the double SHA-256 of the whole extended serialization, witness included. Basis: the chapter says of Witness transaction identifier: 'double SHA-256 of the whole extended serialization, witness included'."@en ;
    rdfs:domain chx:Wtxid ; rdfs:range chx:ExtendedFormat ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:weighsLegacyFormat a owl:ObjectProperty ; rdfs:label "counts the size of"@en ;
    rdfs:comment "Weight counts the legacy serialization's size times 3 plus the full serialization's size. Basis: the chapter says of Weight: 'the legacy serialization's size times 3 plus the full serialization's size'."@en ;
    rdfs:domain chx:Weight ; rdfs:range chx:LegacyFormat ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:addsMarker a owl:ObjectProperty ; rdfs:label "adds"@en ;
    rdfs:comment "The extended serialization format adds a marker byte. Basis: the chapter says of Extended serialization format: 'adds a marker byte, a flag byte and a witness structure to the legacy layout'."@en ;
    rdfs:domain chx:ExtendedFormat ; rdfs:range chx:MarkerByte ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:addsFlag a owl:ObjectProperty ; rdfs:label "adds"@en ;
    rdfs:comment "The extended serialization format adds a flag byte. Basis: the chapter says of Extended serialization format: 'adds a marker byte, a flag byte and a witness structure to the legacy layout'."@en ;
    rdfs:domain chx:ExtendedFormat ; rdfs:range chx:FlagByte ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:addsWitnessStructure a owl:ObjectProperty ; rdfs:label "adds"@en ;
    rdfs:comment "The extended serialization format adds a witness structure. Basis: the chapter says of Extended serialization format: 'adds a marker byte, a flag byte and a witness structure to the legacy layout'."@en ;
    rdfs:domain chx:ExtendedFormat ; rdfs:range chx:WitnessStructure ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:hasVersionField a owl:ObjectProperty ; rdfs:label "has"@en ;
    rdfs:comment "A serialized transaction has a version. Basis: the chapter says of The parts of a transaction: 'A serialized transaction has a version, an inputs field, an outputs field, a lock time'."@en ;
    rdfs:domain chx:TransactionParts ; rdfs:range chx:VersionField ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:hasInputList a owl:ObjectProperty ; rdfs:label "has"@en ;
    rdfs:comment "A serialized transaction has an inputs field. Basis: the chapter says of The parts of a transaction: 'A serialized transaction has a version, an inputs field, an outputs field, a lock time'."@en ;
    rdfs:domain chx:TransactionParts ; rdfs:range chx:InputList ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:hasOutputList a owl:ObjectProperty ; rdfs:label "has"@en ;
    rdfs:comment "A serialized transaction has an outputs field. Basis: the chapter says of The parts of a transaction: 'A serialized transaction has a version, an inputs field, an outputs field, a lock time'."@en ;
    rdfs:domain chx:TransactionParts ; rdfs:range chx:OutputList ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:hasLockTime a owl:ObjectProperty ; rdfs:label "has"@en ;
    rdfs:comment "A serialized transaction has a lock time. Basis: the chapter says of The parts of a transaction: 'A serialized transaction has a version, an inputs field, an outputs field, a lock time'."@en ;
    rdfs:domain chx:TransactionParts ; rdfs:range chx:LockTimeField ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:hasWitnessStructure a owl:ObjectProperty ; rdfs:label "has, when it spends segwit outputs,"@en ;
    rdfs:comment "A serialized transaction has, when it spends segwit outputs, a witness structure. Basis: the chapter says of The parts of a transaction: 'when it spends segwit outputs, a marker, a flag and a witness structure'."@en ;
    rdfs:domain chx:TransactionParts ; rdfs:range chx:WitnessStructure ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:identifiesTransactionByTxid a owl:ObjectProperty ; rdfs:label "identifies the transaction by"@en ;
    rdfs:comment "The txid in an outpoint is the double-SHA-256 identifier of the transaction that created the output being spent. Basis: the chapter says of The previous transaction's identifier: 'double-SHA-256 identifier of the transaction that created the output being spent'."@en ;
    rdfs:domain chx:PreviousTxid ; rdfs:range chx:Txid ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:isOutputOfHash a owl:ObjectProperty ; rdfs:label "is the output of"@en ;
    rdfs:comment "A digest is the output of a hash function. Basis: the chapter says of Digest: 'A digest is the output of a hash function'."@en ;
    rdfs:domain chx:Digest ; rdfs:range chx:HashFunction ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:countedByCompactSizeInputs a owl:ObjectProperty ; rdfs:label "is a"@en ;
    rdfs:comment "The input count is a compactSize integer. Basis: the chapter says of Input count: 'The input count is the compactSize integer that opens the inputs field'."@en ;
    rdfs:domain chx:InputCount ; rdfs:range chx:CompactSize ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:countedByCompactSizeOutputs a owl:ObjectProperty ; rdfs:label "is a"@en ;
    rdfs:comment "The output count is a compactSize integer. Basis: the chapter says of Output count: 'The output count is the compactSize integer that opens the outputs field'."@en ;
    rdfs:domain chx:OutputCount ; rdfs:range chx:CompactSize ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:isNullOutpoint a owl:ObjectProperty ; rdfs:label "is a null form of"@en ;
    rdfs:comment "A coinbase transaction's single input has an outpoint with a null txid. Basis: the chapter says of The null outpoint: 'an outpoint with a null txid of all zeros'."@en ;
    rdfs:domain chx:NullOutpoint ; rdfs:range chx:Outpoint ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:isInputScriptField a owl:ObjectProperty ; rdfs:label "is the field of"@en ;
    rdfs:comment "The coinbase field is the coinbase transaction's input-script field. Basis: the chapter says of The coinbase field: 'the coinbase transaction's input-script field'."@en ;
    rdfs:domain chx:CoinbaseField ; rdfs:range chx:InputScript ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:followsRelayPolicy a owl:ObjectProperty ; rdfs:label "is allowed by"@en ;
    rdfs:comment "Standard outputs are the templates that Bitcoin Core's relay and mining policy allows. Basis: the chapter says of Standard transaction outputs: 'Bitcoin Core's policy for relaying and mining transactions'."@en ;
    rdfs:domain chx:StandardOutput ; rdfs:range chx:RelayPolicy ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:isRelayPolicy a owl:ObjectProperty ; rdfs:label "is a"@en ;
    rdfs:comment "Opt-in replace-by-fee is a relay policy. Basis: the chapter says of Opt-in replace-by-fee: 'Opt-in replace-by-fee is the relay policy'."@en ;
    rdfs:domain chx:OptInRbf ; rdfs:range chx:RelayPolicy ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:enablesRelativeTimelock a owl:ObjectProperty ; rdfs:label "enables"@en ;
    rdfs:comment "Only in a version 2 or higher transaction is a sequence value below 2 to the 31 a relative timelock. Basis: the chapter says of Version 2 and BIP68: 'only in a transaction of version 2 or higher is a sequence value below 2 to the 31 a relative timelock'."@en ;
    rdfs:domain chx:VersionTwo ; rdfs:range chx:Bip68Timelock ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:changesOnlyRelayPolicy a owl:ObjectProperty ; rdfs:label "changes only"@en ;
    rdfs:comment "The version 3 proposal changes only the relay policy of full nodes. Basis: the chapter says of The version 3 proposal: 'changes only the relay policy of full nodes'."@en ;
    rdfs:domain chx:VersionThree ; rdfs:range chx:RelayPolicy ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
chx:wouldReadAsInputCount a owl:ObjectProperty ; rdfs:label "would be read by a legacy parser as"@en ;
    rdfs:comment "A legacy parser would read the marker as a count of zero inputs. Basis: the chapter says of Marker byte: 'a legacy parser would read it as a count of zero inputs'."@en ;
    rdfs:domain chx:MarkerByte ; rdfs:range chx:InputCount ; rdfs:isDefinedBy <http://example.org/sen0401/ch06/tbox> .
