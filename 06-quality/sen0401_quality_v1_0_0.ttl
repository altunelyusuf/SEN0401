@prefix cme:     <http://example.org/cme#> .
@prefix sen0401: <http://example.org/sen0401#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Quality evidence part - ENQA ESG cited: the evidence that assessment is aligned to outcomes.
# Only alignments with a stated basis are asserted. None is asserted here: this repository's learning
# outcomes are a draft with no owner approval (00-course-profile/SOURCES_v1_0_0.md), and which outcomes
# a component assesses is the instructor's decision, which has not been made.

<http://example.org/sen0401/quality> a owl:Ontology ; rdfs:label "SEN0401: quality evidence"@en ;
    owl:versionInfo "1.0.0" ; dcterms:identifier "sen0401_quality_v1_0_0" .

sen0401:Gap_OutcomeAlignment a cme:AlignmentGap ;
    rdfs:label "Which outcomes each assessment component assesses is not yet declared"@en ;
    cme:gapFor sen0401:Midterm, sen0401:Project, sen0401:Final ;
    cme:gapNote "No component is aligned to a learning outcome yet. The outcomes are an unapproved draft; the instructor declares the alignment after approving them. Not inferred here." .
