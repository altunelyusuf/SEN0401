@prefix cme:     <http://example.org/cme#> .
@prefix sen0401: <http://example.org/sen0401#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Quality evidence part - ENQA ESG cited: the evidence that assessment is aligned to outcomes.
# Only alignments with a stated basis are asserted. The owner approved the ten outcomes on 2026-10-05
# (01-outcomes/sen0401_outcomes_v1_1_0.ttl). One alignment has a stated basis: the Project and LO-10.
# Which outcomes the Midterm and the Final assess is the instructor's decision and the course outline
# does not state it, so it is declared as a gap, not inferred.

<http://example.org/sen0401/quality> a owl:Ontology ; rdfs:label "SEN0401: quality evidence"@en ;
    owl:versionInfo "1.1.0" ; dcterms:identifier "sen0401_quality_v1_1_0" .

sen0401:Align_Project_LO10 a cme:Alignment ;
    cme:component sen0401:Project ; cme:assessesOutcome sen0401:LO10 ;
    cme:alignmentBasis "LO-10 is drawn from the same text as the project brief - the term theme in the course outline's Notice, which the brief carries verbatim - and the owner approved it on 2026-10-05 as the outcome the team project develops." .

sen0401:Gap_ExamAlignment a cme:AlignmentGap ;
    rdfs:label "Which outcomes the midterm and final assess is not yet declared"@en ;
    cme:gapFor sen0401:Midterm, sen0401:Final ;
    cme:gapNote "Outcomes LO-1 to LO-9 are assessed by no declared component yet; the course outline lists chapters 1 to 14 but not which the midterm or final covers. Declared by the instructor when the exams are authored; not inferred here." .
