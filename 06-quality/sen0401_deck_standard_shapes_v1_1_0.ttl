@prefix ds:   <http://example.org/sen0401/deckstd#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Deck standard, element D9 (background scheme): the owner's ruling recorded as SHACL, not as markdown.
# Owner's words of 2026-10-29, relayed by the coordinator: "the deck standard gives way: D9 is changed in a new versioned file
# to allow the single dark closing slide among light slides ... the ruling is recorded in SHACL not markdown, no retroactive enforcement".

<http://example.org/sen0401/deckstd> a owl:Ontology ;
    rdfs:label "SEN0401 deck standard shapes (D4, D7, D9)"@en ;
    owl:versionInfo "1.1.0" ;
    owl:priorVersion <http://example.org/sen0401/deckstd/1.0.0> ;
    rdfs:comment "Records the owner's ruling of 2026-10-29: every slide is light except that the last slide (the closing slide) may be dark; a dark slide anywhere else, or more than one dark slide, violates D9. No retroactive enforcement: it applies to deck versions made from now on. Version 1.1.0 adds two rulings of the owner: D4 (2026-11-24) no everyday analogy anywhere on a slide or in its notes, because analogies are misleading; D7 (2026-11-14) notes of 60 to 140 words."@en .

# ---- deck-facts vocabulary (every class and property is linked to another one) ----
ds:Deck a owl:Class ; rdfs:label "Deck"@en ;
    rdfs:comment "A lecture deck; it has slides (ds:hasSlide) and states how many it has (ds:slideCount)."@en .
ds:Slide a owl:Class ; rdfs:label "Slide"@en ;
    rdfs:comment "A slide of a deck; it has a position (ds:slidePosition) and one background scheme (ds:backgroundScheme)."@en .
ds:BackgroundScheme a owl:Class ; rdfs:label "Background scheme"@en ;
    rdfs:comment "Dark (relative luminance of the background colour below 0.5) or light; used by slides through ds:backgroundScheme."@en .

ds:hasSlide a owl:ObjectProperty ; rdfs:label "has slide"@en ; rdfs:domain ds:Deck ; rdfs:range ds:Slide ;
    owl:inverseOf ds:inDeck .
ds:inDeck a owl:ObjectProperty ; rdfs:label "in deck"@en ; rdfs:domain ds:Slide ; rdfs:range ds:Deck ;
    rdfs:comment "Lets a slide reach the deck whose slide count decides which slide is the last one."@en .
ds:backgroundScheme a owl:ObjectProperty ; rdfs:label "background scheme"@en ; rdfs:domain ds:Slide ; rdfs:range ds:BackgroundScheme .
ds:slidePosition a owl:DatatypeProperty ; rdfs:label "slide position"@en ; rdfs:domain ds:Slide ; rdfs:range xsd:integer ;
    rdfs:comment "1-based position; the last slide is the one whose position equals ds:slideCount of its deck."@en .
ds:slideCount a owl:DatatypeProperty ; rdfs:label "number of slides"@en ; rdfs:domain ds:Deck ; rdfs:range xsd:integer ;
    rdfs:comment "Number of slides of the deck; compared with ds:slidePosition to find the closing slide."@en .

ds:Dark a ds:BackgroundScheme ; rdfs:label "dark"@en .
ds:Light a ds:BackgroundScheme ; rdfs:label "light"@en .

# ---- D9 ----
ds:D9_DarkOnlyLastShape a sh:NodeShape ;
    sh:targetClass ds:Slide ;
    rdfs:label "D9: a dark slide is only the last slide"@en ;
    rdfs:comment "Owner's ruling 2026-10-29: every slide is light except that the LAST slide may be dark. A dark slide anywhere else violates."@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "D9 (owner's ruling of 2026-10-29: the deck standard gives way to allow the single dark closing slide among light slides): a dark slide is allowed only as the last slide; this dark slide is not the last one."@en ;
        sh:prefixes <http://example.org/sen0401/deckstd> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this ds:backgroundScheme ds:Dark ; ds:slidePosition ?value ; ds:inDeck ?d .
                ?d ds:slideCount ?n .
                FILTER (?value != ?n)
            }""" ] .

ds:D9_OneDarkSlideShape a sh:NodeShape ;
    sh:targetClass ds:Deck ;
    rdfs:label "D9: at most one dark slide"@en ;
    rdfs:comment "Owner's ruling 2026-10-29: the single dark closing slide; more than one dark slide violates."@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "D9 (owner's ruling of 2026-10-29: one dark closing slide among light slides): more than one dark slide in the deck."@en ;
        sh:prefixes <http://example.org/sen0401/deckstd> ;
        sh:select """
            SELECT $this ?value WHERE {
                { SELECT $this (COUNT(?s) AS ?value) WHERE { $this ds:hasSlide ?s . ?s ds:backgroundScheme ds:Dark } GROUP BY $this }
                FILTER (?value > 1)
            }""" ] .


# ---- version 1.1.0: text blocks and notes (D4, D7) ----
ds:TextBlock a owl:Class ; rdfs:label "Text block"@en ;
    rdfs:comment "A piece of text a student reads: a text box of a slide or the speaker notes of a slide; it belongs to one slide (ds:onSlide) and carries its words (ds:blockText)."@en .
ds:hasTextBlock a owl:ObjectProperty ; rdfs:label "has text block"@en ; rdfs:domain ds:Slide ; rdfs:range ds:TextBlock ;
    owl:inverseOf ds:onSlide .
ds:onSlide a owl:ObjectProperty ; rdfs:label "on slide"@en ; rdfs:domain ds:TextBlock ; rdfs:range ds:Slide .
ds:blockText a owl:DatatypeProperty ; rdfs:label "block text"@en ; rdfs:domain ds:TextBlock ; rdfs:range xsd:string .
ds:noteWordCount a owl:DatatypeProperty ; rdfs:label "number of words in the notes"@en ; rdfs:domain ds:Slide ; rdfs:range xsd:integer ;
    rdfs:comment "Words of the speaker notes of the slide, counted as len(text.split())."@en .

# D4 (owner's ruling 2026-11-24, replacing the earlier D4 that REQUIRED an analogy for every key concept): everyday analogies are misleading and are removed from the course materials.
ds:D4_NoAnalogyShape a sh:NodeShape ;
    sh:targetClass ds:TextBlock ;
    rdfs:label "D4: no everyday analogy"@en ;
    rdfs:comment "Owner's ruling 2026-11-24: no everyday analogy anywhere in the course materials. Text that compares a concept with an everyday thing (the phrases 'is like a', 'think of', 'imagine', 'everyday comparison', a sentence that starts with 'Like a', or a named stock analogy) violates. A literal 'looks like' does not."@en ;
    sh:property [
        sh:path ds:blockText ;
        sh:not [ sh:pattern "(\\b(it is like|(works|acts|behaves) like (a|an|the)|is like (a|an|the)|are like (a|an|the)|think of|imagine|just as|picture a|everyday (comparison|analogy|life)|analogy|wax seal|sealed envelope|cheque|(a|the|older|wax) seal|speed limit|road standard)\\b)|((^|[.!?]\\s+)like (a|an|the|two)\\s)" ; sh:flags "i" ] ;
        sh:message "D4 (owner's ruling of 2026-11-24: everyday analogies are misleading): this text compares a concept with an everyday thing; state the concept literally."@en ] .

# D7 (owner's ruling 2026-11-14): notes of 60 to 140 words in full sentences (replaces the earlier limit of at most 60).
ds:D7_NoteWordsShape a sh:NodeShape ;
    sh:targetClass ds:Slide ;
    rdfs:label "D7: notes of 60 to 140 words"@en ;
    rdfs:comment "Owner's ruling 2026-11-14: speaker notes carry 60 to 140 words."@en ;
    sh:property [ sh:path ds:noteWordCount ; sh:minInclusive 60 ; sh:maxInclusive 140 ;
        sh:message "D7 (owner's ruling of 2026-11-14): the notes of this slide have fewer than 60 or more than 140 words."@en ] .

<http://example.org/sen0401/deckstd> sh:declare [ sh:prefix "ds" ; sh:namespace "http://example.org/sen0401/deckstd#"^^xsd:anyURI ] .
