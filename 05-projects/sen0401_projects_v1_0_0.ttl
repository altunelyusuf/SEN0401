@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Projects part - the term project as the course outline states it (the Notice paragraph).
# Open Badges cited, not held (no credential is issued to an individual here).

<http://example.org/sen0401/projects> a owl:Ontology ; rdfs:label "SEN0401: projects"@en ;
    owl:versionInfo "1.0.0" ; dcterms:identifier "sen0401_projects_v1_0_0" .

sen0401:ProjectBrief a cme:ProjectBrief ; rdfs:label "Term project, 2026 Fall"@en ;
    cme:termTheme "Semantic technologies" ;
    cme:briefText "Notice: This term theme is semantic technologies, so you are expected to develop industrial or educational applications for real usages, not just hypothetical. So, you need to communicate with the real users, properly experiment domain engineering facilities and collect business requirements. Team projects with well-defined responsibilities are in favour. Within that theme, the subject is Block Chain. This can be applications using available Block Chain technologies or building toy Block Chain systems or libraries for business or education! Project can also be about gamification of Block Chain teaching or using Block Chains in gamifications as well." ;
    dcterms:source "The Notice paragraph of the course outline, 00-course-profile/Outline_SEN0401_Special_Topics_Blockchain_Fall2026_v1_0_0.docx." .
