    backlog:guardsExclusion ex:Excl_OldStructure ;
    backlog:contributesToMission ex:Mission ; backlog:hasGoalFacing backlog:Facing_Exclusion ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner ;
