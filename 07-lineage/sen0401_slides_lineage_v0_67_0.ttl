ex:Score_Research_Ch10 a backlog:PriorityScore ; backlog:scoredByMethod backlog:Method_WSJF ;
    backlog:hasScoreValue "15.33"^^xsd:decimal ; backlog:scoredAt "2026-10-15T03:53:13"^^xsd:dateTime ; backlog:isAveragedFromMembers false ;
