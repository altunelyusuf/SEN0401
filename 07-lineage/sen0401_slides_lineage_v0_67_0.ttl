ex:G_DecksTeachTheBook a backlog:Goal ;
    rdfs:label "Every deck teaches what the 3rd edition teaches"@en ;
    backlog:belongsToLineage ex:Lineage ; backlog:derivesFromScope ex:Scope ; backlog:goalCoversArea ex:Area_Deck ;
    backlog:contributesToMission ex:Mission ; backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner ;
    backlog:hasGoalRationale "Derived from the scope's deck area, and from the owner's request of 2026-09-24 for renewed decks, research and interactive pages together." ;
    backlog:producedByStage ex:Out_Goal .

ex:G_ResearchBehindEveryDeck a backlog:Goal ;
    rdfs:label "Every renewed deck rests on a recorded research run"@en ;
    backlog:belongsToLineage ex:Lineage ; backlog:derivesFromScope ex:Scope ; backlog:goalCoversArea ex:Area_Research ;
    backlog:contributesToMission ex:Mission ; backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner ;
    backlog:hasGoalRationale "Derived from the scope's research area, and from the owner's request of 2026-09-24 for renewed decks, research and interactive pages together." ;
    backlog:producedByStage ex:Out_Goal .

ex:G_PageForEveryDeck a backlog:Goal ;
