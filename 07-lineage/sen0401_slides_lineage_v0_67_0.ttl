    backlog:transitionedItem ex:ST_Research_Ch01 ; backlog:viaTransition backlog:T_Complete ;
    backlog:transitionedAt "2026-09-24T22:28:51"^^xsd:dateTime ; backlog:transitionedBy backlog:Owner ;
