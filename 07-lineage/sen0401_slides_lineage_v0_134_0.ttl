ex:ST_Page_Ch10 backlog:finishedAt "2026-10-15T14:11:54"^^xsd:dateTime ; backlog:lastAuditedAt "2026-10-15T14:11:54"^^xsd:dateTime ; backlog:hasExecutionModality backlog:Mode_Hybrid ;
