ex:Out3_Backlog a backlog:StageOutput ;
    rdfs:label "Closure of the Backlog stage of the third lineage"@en ;
    backlog:belongsToLineage ex:Lineage3 ;
    backlog:outputOfStage backlog:Stage_Backlog ;
