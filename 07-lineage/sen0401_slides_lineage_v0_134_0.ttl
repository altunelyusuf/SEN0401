    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner ;
    backlog:hasGoalRationale "Derived from the scope of the third lineage and from ruling G125: work done after its story was Done is a story of its own; the lineage whose Backlog stage is closed out-scopes the open work, closes, and a successor takes it in with its real dates." ;
    backlog:producedByStage ex:Out3_Goal .

ex:G3_FailuresStayVisible a backlog:Goal ;
