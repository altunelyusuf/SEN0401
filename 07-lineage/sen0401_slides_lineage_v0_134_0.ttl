    backlog:belongsToLineage ex:Lineage3 ; backlog:memberOfContainer ex:Iter_12 ; backlog:admittedByOutput ex:Out3_BacklogR3 ; backlog:responsible ex:Executor_ClaudeCodeSession ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ; backlog:hasTaskType backlog:TaskType_Build ; backlog:effectiveDefinitionOfDone ex:DoD ; backlog:hasState backlog:InProgress ; backlog:startedAt "2026-10-20T23:49:46"^^xsd:dateTime ;
    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "Ranked by its story's state; scoring both would double-count." ;
    backlog:hasAuditNote "Resolve the 15 dangling citations that Stage 3.F reports for the Stage 3 document of chapter 5 under the current validator (the one the Stage 4 gate runner uses): each citation must point to a source of the research data, missing sources being added with their record, in new versions of the research and document data; a citation or a claim is not removed only to pass. A committed file is not edited. No gate, test or threshold is changed. Satisfies the criterion ex:AC3G_3F_Ch05." .

