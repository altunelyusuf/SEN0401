    backlog:belongsToLineage ex:Lineage3 ;
    backlog:outputOfStage backlog:Stage_Goal ;
    backlog:consumesOutput ex:Out3_Scope ;
    backlog:hasStateDigest "8fade411e9a859e81cb6e04fafc1dfe392976cbac04b7054b63781af6ca367d9" ;
    backlog:closedAtCommit "8d7647a" .

