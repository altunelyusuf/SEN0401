    backlog:areaLocation "03-materials/, one per taught chapter" ;
    backlog:areaMeasure "14 chapters, each with the renewed lecture deck, restyled with PowerPoint's capabilities and rewritten to the edition it rests on" ;
    backlog:hasScopeLayer backlog:Layer_Product .

