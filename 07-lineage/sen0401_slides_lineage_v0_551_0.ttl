ex:TS_DeckStdCheck a backlog:ToolScript ; rdfs:label "deck standard check v1_0_0 (python-pptx 1.0.2; the elements D1 to D12 of the deck standard, one named result each)"@en ; backlog:scriptFileName "sen0401_deck_standard_check_v1_0_0.py" ; backlog:acceptsGraphPath false .
