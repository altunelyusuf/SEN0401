ex:Excl_OldStructure a backlog:ScopeExclusion ;
    rdfs:label "No deck follows the 2nd edition's chapter structure"@en ;
    backlog:excludesConcern "Decks organised by the 2nd edition's twelve chapters, including its Advanced Transactions and Scripting chapter as such." ;
    backlog:hasExclusionRationale "Owner ruling, 2026-09-24: the outline follows the 3rd edition's fourteen chapters; the course teaches the edition students can read for free." ;
    backlog:decidedBy backlog:Owner ; backlog:hasScopeLayer backlog:Layer_Product .

ex:Scope a backlog:ScopeStatement ;
    rdfs:label "Renew what is taught, deck by deck, on research"@en ;
    backlog:scopeForMission ex:Mission ; backlog:belongsToLineage ex:Lineage ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:scopeCompletionState backlog:Proposed ;
    backlog:hasScopeStatementText "IN: for each of the fourteen chapters of Mastering Bitcoin's 3rd edition, a deck, the RDODI research behind it, and an interactive page. OUT: decks following the 2nd edition's structure." ;
    backlog:coversArea ex:Area_Deck, ex:Area_Research, ex:Area_Page ;
    backlog:hasScopeExclusion ex:Excl_OldStructure ;
    backlog:producedByStage ex:Out_Scope ;
    backlog:requiresDeliverable ex:Del_Deck_Ch01, ex:Del_Research_Ch01, ex:Del_Page_Ch01, ex:Del_Deck_Ch02, ex:Del_Research_Ch02, ex:Del_Page_Ch02, ex:Del_Deck_Ch03, ex:Del_Research_Ch03, ex:Del_Page_Ch03, ex:Del_Deck_Ch04, ex:Del_Research_Ch04, ex:Del_Page_Ch04, ex:Del_Deck_Ch05, ex:Del_Research_Ch05, ex:Del_Page_Ch05, ex:Del_Deck_Ch06, ex:Del_Research_Ch06, ex:Del_Page_Ch06, ex:Del_Deck_Ch07, ex:Del_Research_Ch07, ex:Del_Page_Ch07, ex:Del_Deck_Ch08, ex:Del_Research_Ch08, ex:Del_Page_Ch08, ex:Del_Deck_Ch09, ex:Del_Research_Ch09, ex:Del_Page_Ch09, ex:Del_Deck_Ch10, ex:Del_Research_Ch10, ex:Del_Page_Ch10, ex:Del_Deck_Ch11, ex:Del_Research_Ch11, ex:Del_Page_Ch11, ex:Del_Deck_Ch12, ex:Del_Research_Ch12, ex:Del_Page_Ch12, ex:Del_Deck_Ch13, ex:Del_Research_Ch13, ex:Del_Page_Ch13, ex:Del_Deck_Ch14, ex:Del_Research_Ch14, ex:Del_Page_Ch14 .

ex:Blueprint a backlog:Blueprint ;
    rdfs:label "What the slide renewal is about"@en ;
    backlog:belongsToLineage ex:Lineage ; backlog:blueprintFor ex:Scope, ex:Backlog ;
    backlog:hasDomainEntity ex:DE_Deck, ex:DE_ResearchRun, ex:DE_InteractivePage .
ex:DE_Deck a backlog:DomainEntity ; rdfs:label "Deck - a chapter's lecture slides"@en ; backlog:belongsToLineage ex:Lineage .
ex:DE_ResearchRun a backlog:DomainEntity ; rdfs:label "Research run - an RDODI run on a chapter's subject"@en ; backlog:belongsToLineage ex:Lineage .
ex:DE_InteractivePage a backlog:DomainEntity ; rdfs:label "Interactive page - a chapter's companion page"@en ; backlog:belongsToLineage ex:Lineage .
ex:Gap_Deck_Creation a backlog:BlueprintGap ; rdfs:label "No coverage yet for the Deck at the creation stage"@en ; backlog:gapForEntity ex:DE_Deck ; backlog:gapForStage backlog:Stage_Creation ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_Deck_ActiveUse a backlog:BlueprintGap ; rdfs:label "No coverage yet for the Deck at the active use stage"@en ; backlog:gapForEntity ex:DE_Deck ; backlog:gapForStage backlog:Stage_ActiveUse ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_Deck_SuspensionException a backlog:BlueprintGap ; rdfs:label "No coverage yet for the Deck at the suspension or exception stage"@en ; backlog:gapForEntity ex:DE_Deck ; backlog:gapForStage backlog:Stage_SuspensionException ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_Deck_Termination a backlog:BlueprintGap ; rdfs:label "No coverage yet for the Deck at the termination stage"@en ; backlog:gapForEntity ex:DE_Deck ; backlog:gapForStage backlog:Stage_Termination ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_ResearchRun_Creation a backlog:BlueprintGap ; rdfs:label "No coverage yet for the ResearchRun at the creation stage"@en ; backlog:gapForEntity ex:DE_ResearchRun ; backlog:gapForStage backlog:Stage_Creation ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_ResearchRun_ActiveUse a backlog:BlueprintGap ; rdfs:label "No coverage yet for the ResearchRun at the active use stage"@en ; backlog:gapForEntity ex:DE_ResearchRun ; backlog:gapForStage backlog:Stage_ActiveUse ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_ResearchRun_SuspensionException a backlog:BlueprintGap ; rdfs:label "No coverage yet for the ResearchRun at the suspension or exception stage"@en ; backlog:gapForEntity ex:DE_ResearchRun ; backlog:gapForStage backlog:Stage_SuspensionException ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_ResearchRun_Termination a backlog:BlueprintGap ; rdfs:label "No coverage yet for the ResearchRun at the termination stage"@en ; backlog:gapForEntity ex:DE_ResearchRun ; backlog:gapForStage backlog:Stage_Termination ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_InteractivePage_Creation a backlog:BlueprintGap ; rdfs:label "No coverage yet for the InteractivePage at the creation stage"@en ; backlog:gapForEntity ex:DE_InteractivePage ; backlog:gapForStage backlog:Stage_Creation ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_InteractivePage_ActiveUse a backlog:BlueprintGap ; rdfs:label "No coverage yet for the InteractivePage at the active use stage"@en ; backlog:gapForEntity ex:DE_InteractivePage ; backlog:gapForStage backlog:Stage_ActiveUse ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_InteractivePage_SuspensionException a backlog:BlueprintGap ; rdfs:label "No coverage yet for the InteractivePage at the suspension or exception stage"@en ; backlog:gapForEntity ex:DE_InteractivePage ; backlog:gapForStage backlog:Stage_SuspensionException ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_InteractivePage_Termination a backlog:BlueprintGap ; rdfs:label "No coverage yet for the InteractivePage at the termination stage"@en ; backlog:gapForEntity ex:DE_InteractivePage ; backlog:gapForStage backlog:Stage_Termination ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .

ex:G_DecksTeachTheBook a backlog:Goal ;
    rdfs:label "Every deck teaches what the 3rd edition teaches"@en ;
    backlog:belongsToLineage ex:Lineage ; backlog:derivesFromScope ex:Scope ; backlog:goalCoversArea ex:Area_Deck ;
    backlog:contributesToMission ex:Mission ; backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner ;
    backlog:hasGoalRationale "Derived from the scope's deck area, and from the owner's request of 2026-09-24 for renewed decks, research and interactive pages together." ;
    backlog:producedByStage ex:Out_Goal .

ex:G_ResearchBehindEveryDeck a backlog:Goal ;
    rdfs:label "Every renewed deck rests on a recorded research run"@en ;
    backlog:belongsToLineage ex:Lineage ; backlog:derivesFromScope ex:Scope ; backlog:goalCoversArea ex:Area_Research ;
    backlog:contributesToMission ex:Mission ; backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner ;
    backlog:hasGoalRationale "Derived from the scope's research area, and from the owner's request of 2026-09-24 for renewed decks, research and interactive pages together." ;
    backlog:producedByStage ex:Out_Goal .

ex:G_PageForEveryDeck a backlog:Goal ;
