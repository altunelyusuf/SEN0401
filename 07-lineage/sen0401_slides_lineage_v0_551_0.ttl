    backlog:hasReach "3"^^xsd:decimal ; backlog:hasImpact "0.5"^^xsd:decimal ; backlog:hasConfidence "0.8"^^xsd:decimal ; backlog:hasEffort "1.0"^^xsd:decimal ; backlog:hasDepFactor "1"^^xsd:decimal ;
