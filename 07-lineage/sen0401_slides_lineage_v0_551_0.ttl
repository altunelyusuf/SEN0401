ex:Iter_20 a backlog:Iteration ; rdfs:label "Iteration 20: chapters 7 and 8 on the current standard"@en ; backlog:hasIdentifier "Iter_20" ; backlog:belongsToLineage ex:Lineage3 ;
    backlog:iterationStart "2026-10-23T17:14:50"^^xsd:dateTime ; backlog:iterationEnd "2026-10-24T09:00:00"^^xsd:dateTime ;
    backlog:hasDurationSource "Proposed by the builder session on 2026-10-23: the start is the instant of the planning ceremony ex:PC3_Iter_20; the proposed end is Saturday 2026-10-24 09:00 UTC; the owner decides the end. Justification (estimates, not measurements; measured analogues: the deck executor of chapter 6 needed 35 minutes, the page executor 62 minutes, a control run of one page test about 10 minutes, on an idle machine): the deck check v1_1_0 about 0.5 h and its verification 0.5 h; the two decks in parallel about 1.5 h each, verified about 0.5 h each; the two pages follow, about 1.5 h each with three serial page-test runs each, verified about 1 h each, serial. Critical path on an idle machine: 1.5 h + 0.5 h + 1.5 h + 1.0 h = about 4.5 h for chapter 7 and about 1 h later for chapter 8; the machine has 2 cores shared with other sessions and the browser tests queue, so the window allows about 18 hours. Chapter 8 can be declined without blocking chapter 7." ;
    backlog:hasSprintGoal "The decks and pages of chapters 7 and 8 meet the written standard on template 9.52.2, measured by the deck check (a new version that reads their research), the charset check and the page tests, verified by the evidence bridge; everything is a new file and nothing existing is edited. Frozen at the planning ceremony." ;
    backlog:hasMember ex:ST_Ch78_DeckCheck, ex:ST_Ch07_Deck, ex:ST_Ch07_Page, ex:ST_Ch08_Deck, ex:ST_Ch08_Page, ex:TK_Ch78_DeckCheck, ex:TK_Ch78_DeckCheck_Verify, ex:TK_Ch07_Deck_Build, ex:TK_Ch07_Deck_Verify, ex:TK_Ch07_Page_Build, ex:TK_Ch07_Page_Verify, ex:TK_Ch08_Deck_Build, ex:TK_Ch08_Deck_Verify, ex:TK_Ch08_Page_Build, ex:TK_Ch08_Page_Verify .
ex:PB3I_Iter_20 a backlog:PlanBaseline ; rdfs:label "Plan baseline of iteration 20 when it was planned"@en ; backlog:baselineFor ex:Iter_20 ; backlog:baselinedAt "2026-10-23T17:14:50"^^xsd:dateTime ; backlog:isCurrentBaseline true ; backlog:hasBaselineStart "2026-10-23T17:14:50"^^xsd:dateTime ; backlog:hasBaselineEnd "2026-10-24T09:00:00"^^xsd:dateTime .
ex:PC3_Iter_20 a backlog:SprintPlanningCeremony ; rdfs:label "Planning of iteration 20: chapters 7 and 8"@en ; backlog:ceremonyFor ex:Iter_20 ; backlog:heldAt "2026-10-23T17:14:50"^^xsd:dateTime ;
    backlog:includesPlanningEvent ex:Plan3I_ST_Ch78_DeckCheck, ex:Plan3I_ST_Ch07_Deck, ex:Plan3I_ST_Ch07_Page, ex:Plan3I_ST_Ch08_Deck, ex:Plan3I_ST_Ch08_Page ;
