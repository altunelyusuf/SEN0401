    rdfs:label "A deck or page that fails its check is admitted as failing, never as Done"@en ;
    backlog:belongsToLineage ex:Lineage3 ; backlog:derivesFromScope ex:Scope3 ; backlog:goalCoversArea ex:Area3_LinkPass ;
    backlog:contributesToMission ex:Mission ; backlog:hasGoalFacing backlog:Facing_Containment ; backlog:hasGoalOrigin backlog:GoalOrigin_New ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner ;
    backlog:hasGoalRationale "Derived from the scope of the third lineage and from ruling G125: work done after its story was Done is a story of its own; the lineage whose Backlog stage is closed out-scopes the open work, closes, and a successor takes it in with its real dates." ;
    backlog:producedByStage ex:Out3_Goal .

ex:G3_NothingRebuilt a backlog:Goal ;
    rdfs:label "No deck or page is rebuilt to fit its record"@en ;
    backlog:belongsToLineage ex:Lineage3 ; backlog:derivesFromScope ex:Scope3 ; backlog:goalCoversArea ex:Area3_LinkPass ;
    backlog:contributesToMission ex:Mission ; backlog:hasGoalFacing backlog:Facing_Exclusion ; backlog:hasGoalOrigin backlog:GoalOrigin_New ;
    backlog:guardsExclusion ex:Excl3_NoRebuild ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner ;
    backlog:hasGoalRationale "Derived from the scope of the third lineage and from ruling G125: work done after its story was Done is a story of its own; the lineage whose Backlog stage is closed out-scopes the open work, closes, and a successor takes it in with its real dates." ;
    backlog:producedByStage ex:Out3_Goal .

ex:G3_OpenWorkCarried a backlog:Goal ;
    rdfs:label "The open work of the second lineage is carried, with an executor, until it is finished or ruled on"@en ;
    backlog:belongsToLineage ex:Lineage3 ; backlog:derivesFromScope ex:Scope3 ; backlog:goalCoversArea ex:Area_Deck ;
    backlog:goalAnswersGap ex:Gap_OutScope_Lineage2 ;
    backlog:contributesToMission ex:Mission ; backlog:hasGoalFacing backlog:Facing_Mission ; backlog:hasGoalOrigin backlog:GoalOrigin_Carried ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner ;
    backlog:hasGoalRationale "Derived from the scope of the third lineage and from ruling G125: work done after its story was Done is a story of its own; the lineage whose Backlog stage is closed out-scopes the open work, closes, and a successor takes it in with its real dates." ;
    backlog:producedByStage ex:Out3_Goal .

ex:Spec3 a backlog:Specification ;
    rdfs:label "What an admitted link pass is"@en ; backlog:belongsToLineage ex:Lineage3 ; backlog:specifiesGoal ex:G3_LinkPassesProven ;
    backlog:hasSpecificationText "A link pass is admitted as finished when its story is Done with dates that equal the first and last git commit of the rebuilt files, an acceptance criterion, a test harness, a last-audit date, an execution modality and evidence that backlog_evidence_bridge verified against the course repository: a rerunnable chapter check that exits 0 for each chapter that passes, and the rebuilt files (and the link registers) cited by SHA-256. A chapter whose check fails is named in the story and is not claimed as passing." ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner ; backlog:producedByStage ex:Out3_Goal .
ex:Scen3_Verified a backlog:TestScenario ; rdfs:label "A rebuilt chapter's check passes and its files match their hashes"@en ; backlog:belongsToLineage ex:Lineage3 ;
