ex:Iter_21 a backlog:Iteration ; rdfs:label "Iteration 21: the retrofit of chapters 1 to 4 and 9 to 14 (planned, not started)"@en ; backlog:hasIdentifier "Iter_21" ; backlog:belongsToLineage ex:Lineage3 ;
    backlog:iterationStart "2026-10-24T09:00:00"^^xsd:dateTime ; backlog:iterationEnd "2026-10-26T09:00:00"^^xsd:dateTime ;
    backlog:hasDurationSource "Planned by the builder session on 2026-10-23 on the owner's decision of 16:06 Istanbul; not started. Estimates, not measurements: per chapter deck 1.5 h build + 0.5 h verification, page 1.5 h build + 1.0 h verification (4.5 h), ten chapters 45 h of work, about 10 h of serial browser time; with three executors in parallel about two days, from the end of Iteration 20 (Saturday 2026-10-24 09:00 UTC) to Monday 2026-10-26 09:00 UTC. The start and the end are the owner's to confirm when the iteration is planned; the planning ceremony is held then." ;
    backlog:hasSprintGoal "The decks and pages of chapters 1 to 4 and 9 to 14 meet the written standard in this order. PLANNED, not started: no ceremony is held, no executor is briefed." ;
    backlog:hasMember ex:ST_Ch01_Deck, ex:ST_Ch01_Page, ex:ST_Ch02_Deck, ex:ST_Ch02_Page, ex:ST_Ch03_Deck, ex:ST_Ch03_Page, ex:ST_Ch04_Deck, ex:ST_Ch04_Page, ex:ST_Ch09_Deck, ex:ST_Ch09_Page, ex:ST_Ch10_Deck, ex:ST_Ch10_Page, ex:ST_Ch11_Deck, ex:ST_Ch11_Page, ex:ST_Ch12_Deck, ex:ST_Ch12_Page, ex:ST_Ch13_Deck, ex:ST_Ch13_Page, ex:ST_Ch14_Deck, ex:ST_Ch14_Page, ex:TK_Ch01_Deck_Build, ex:TK_Ch01_Deck_Verify, ex:TK_Ch01_Page_Build, ex:TK_Ch01_Page_Verify, ex:TK_Ch02_Deck_Build, ex:TK_Ch02_Deck_Verify, ex:TK_Ch02_Page_Build, ex:TK_Ch02_Page_Verify, ex:TK_Ch03_Deck_Build, ex:TK_Ch03_Deck_Verify, ex:TK_Ch03_Page_Build, ex:TK_Ch03_Page_Verify, ex:TK_Ch04_Deck_Build, ex:TK_Ch04_Deck_Verify, ex:TK_Ch04_Page_Build, ex:TK_Ch04_Page_Verify, ex:TK_Ch09_Deck_Build, ex:TK_Ch09_Deck_Verify, ex:TK_Ch09_Page_Build, ex:TK_Ch09_Page_Verify, ex:TK_Ch10_Deck_Build, ex:TK_Ch10_Deck_Verify, ex:TK_Ch10_Page_Build, ex:TK_Ch10_Page_Verify, ex:TK_Ch11_Deck_Build, ex:TK_Ch11_Deck_Verify, ex:TK_Ch11_Page_Build, ex:TK_Ch11_Page_Verify, ex:TK_Ch12_Deck_Build, ex:TK_Ch12_Deck_Verify, ex:TK_Ch12_Page_Build, ex:TK_Ch12_Page_Verify, ex:TK_Ch13_Deck_Build, ex:TK_Ch13_Deck_Verify, ex:TK_Ch13_Page_Build, ex:TK_Ch13_Page_Verify, ex:TK_Ch14_Deck_Build, ex:TK_Ch14_Deck_Verify, ex:TK_Ch14_Page_Build, ex:TK_Ch14_Page_Verify, ex:ST_Section_Links_Ch11, ex:TK_SecLinks_Ch11_Verify_R .
