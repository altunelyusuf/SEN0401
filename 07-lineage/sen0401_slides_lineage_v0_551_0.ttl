    backlog:hasInvestmentCategory backlog:Cat_Compliance ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:effectiveDefinitionOfDone ex:DoD ; backlog:hasState backlog:Done ; backlog:startedAt "2026-10-24T18:32:39"^^xsd:dateTime ; backlog:finishedAt "2026-10-24T18:32:40"^^xsd:dateTime ; backlog:lastAuditedAt "2026-10-24T18:32:40"^^xsd:dateTime ; backlog:hasExecutionModality backlog:Mode_Hybrid ;
