<http://example.org/sen0401-slides-lineage#Closure_5> a backlog:ClosureReport ; backlog:belongsToLineage ex:Lineage4 ; backlog:closesForMission ex:Mission_Midterm ; backlog:reportGeneratedAt "2026-10-29T14:35:26"^^xsd:dateTime ;
