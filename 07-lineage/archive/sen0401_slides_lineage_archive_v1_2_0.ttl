ex:Lineage4 a backlog:Lineage ;
    rdfs:label "Fourth lineage for SEN0401: the midterm exam of chapters 1 to 8 (queued, not started)"@en ;
    backlog:lineageForMission ex:Mission_Midterm ; backlog:lineageOrdinal 4 ; backlog:lineageArchived true ; backlog:hasArchivalConfirmationStatus backlog:AC_PendingConfirmation ;
    backlog:hasLineageStatus backlog:LS_Abandoned .
ex:Lineage4 rdfs:comment "The rule set RS_DigestTable_v5 (obligation artifacts are not stage content; admitted items and urgent items do not move the Backlog digest) is adopted at the Mission step, while the lineage is still at LS_Opened and its Mission output is not yet closed (G89, G156, G157, G158); the opening profile does not carry it."@en .
ex:Lineage4 backlog:openedWithProfile backlog:Profile_Adaptive ;
    backlog:openedUnderRevision backlog:Pr_7 ;
    backlog:adoptionRecordedAtOpen true ;
    backlog:adoptsRuleSet
        backlog:RS_CancellationAssessed ,
        backlog:RS_CeremonyKinds ,
        backlog:RS_ChainBothWays ,
        backlog:RS_ChangeSupportsMission ,
        backlog:RS_ConcurrentLineages ,
