@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/sen0401-slides-lineage-archive> a owl:Ontology ;
    owl:versionIRI <http://example.org/sen0401-slides-lineage-archive/1.0.0> ;
