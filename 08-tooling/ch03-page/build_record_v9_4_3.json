 "python": "Python 3.14.4",
 "quiz": [
  {
   "q": "Why is data from your own full node authoritative?",
   "options": [
    "A powerful entity designated it as the reference",
    "Your node independently verified it against every rule",
    "It is downloaded from the Bitcoin Core project's servers"
   ],
   "answer": 1,
   "level": "Understand",
   "objective": "CO2",
   "rationales": [
    "The chapter says the opposite: not because a powerful entity designated it.",
    "Bitcoin Core does not serve data; nodes get it from peers and check it."
   ]
  },
  {
   "q": "A node is configured with prune=5000 and txindex=1. What does Bitcoin Core 31.1 do?",
   "options": [
    "It starts and indexes every transaction",
    "It starts and ignores prune",
    "It stops with 'Prune mode is incompatible with -txindex'"
   ],
   "answer": 2,
   "level": "Apply",
   "objective": "CO3",
   "rationales": [
    "An index of every transaction needs the old blocks that pruning deletes.",
    "Neither option is silently ignored; the release refuses the combination."
   ]
  },
  {
   "q": "Which sequence builds Bitcoin Core from source in 29.0 and later?",
   "options": [
    "cmake -B build, then cmake --build build",
    "./autogen.sh, ./configure, make",
    "make install, then ./configure"
   ],
   "answer": 0,
   "level": "Understand",
   "objective": "CO3",
   "rationales": [
    "That is the Autotools sequence the book prints; 29.0 replaced it.",
    "Install comes after building and configuring, and Autotools is no longer used."
   ]
  },
  {
   "q": "A serialized segwit transaction is 194 bytes and 125 bytes without its witness. What are its weight and virtual size?",
   "options": [
    "194 and 194",
    "500 and 125",
    "569 and 143"
   ],
   "answer": 2,
   "level": "Apply",
   "objective": "CO1",
   "rationales": [
    "Weight counts non-witness bytes four times and witness bytes once, not 194 for both.",
    "4 x 125 + 69 gives 569, and 500 leaves out the 69 witness-side bytes."
   ]
  },
  {
   "q": "Which identifier leaves the witness out of what it hashes?",
   "options": [
    "The wtxid, called 'hash' in the decoded result",
    "The txid",
    "Neither: both hash the same bytes"
   ],
   "answer": 1,
   "level": "Understand",
   "objective": "CO1",
