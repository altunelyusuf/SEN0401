 "python": "Python 3.14.4",
 "quiz": [
  {
   "q": "Inputs total 0.15 bitcoin and outputs total 0.1499 bitcoin. What is the difference?",
   "options": [
    "The transaction fee, collected by the miner",
    "A rounding error",
    "Change returned to the payer"
   ],
   "answer": 0,
   "level": "Apply",
   "objective": "CO1",
   "rationales": [
    "Bitcoin amounts are exact integers of satoshis; nothing is rounded away.",
    "Change is itself an output, so it is already counted in the 0.1499."
   ]
  },
  {
   "q": "Alice pays 5 bitcoins using a 20-bitcoin input. Ignoring the fee, what is the change?",
   "options": [
    "15 bitcoins",
    "20 bitcoins",
    "5 bitcoins"
   ],
   "answer": 0,
   "level": "Apply",
   "objective": "CO1",
   "rationales": [
    "The whole input is spent; 20 would mean the store got nothing.",
    "5 is the payment to the store, not the change."
   ]
  },
  {
   "q": "When does a transaction become part of the blockchain?",
   "options": [
    "When a miner includes it in a block that full nodes validate",
    "As soon as the wallet signs it",
    "When a block explorer shows it"
   ],
   "answer": 0,
   "level": "Understand",
   "objective": "CO2",
   "rationales": [
    "Signing makes it valid to relay; it is not yet in any block.",
    "Explorers display what they see, including unconfirmed transactions."
   ]
  },
  {
   "q": "By the whitepaper, an attacker with 10% of the hash power catches up from six blocks behind with probability about:",
   "options": [
    "0.0002",
    "0.2",
    "0.05"
   ],
   "answer": 0,
   "level": "Apply",
   "objective": "CO3",
   "rationales": [
    "0.2 is the probability at one confirmation, not six.",
    "0.05 is roughly the probability at two confirmations."
   ]
  },
  {
   "q": "In PROV-O terms, what is a Bitcoin transaction in a chain of spends?",
   "options": [
    "An activity that derives new outputs from earlier ones",
    "An agent",
    "A web page"
   ],
   "answer": 0,
   "level": "Understand",
   "objective": "CO4",
   "rationales": [
    "The agent is the key holder who signs; the transaction is what happens.",
    "Nothing about a transaction chain is a document on the web."
   ]
  }
 ]
