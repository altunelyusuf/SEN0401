    pr:itemKey "mt1:i16:words-to-entropy" ;
    pr:itemType pr:NumericAnswer ;
    pr:keyValue 192.0 ;
    pr:position 19 ;
    pr:source <http://example.org/sen0401/engine/paper#midterm_v1_src19> ;
    pr:stem "A recovery code has 18 words. Each word carries 11 bits, and the checksum is one bit for every 32 bits of entropy. How many bits of entropy does the code hold?" ;
    pr:tolerance 0.0 ;
    pr:unit "bits" .

<http://example.org/sen0401/engine/paper#midterm_v1_item1_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "No: the 21,000 satoshis that the outputs leave over are the miner's fee; no field records it, it is the difference between inputs and outputs, so the transaction can be valid." .

<http://example.org/sen0401/engine/paper#midterm_v1_item1_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Yes: the ledger must balance exactly, so the wallet must lower one output by 21,000 satoshis before any node will accept the transaction." .

<http://example.org/sen0401/engine/paper#midterm_v1_item1_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "No: the nodes return the 21,000 satoshis left over to the wallet as change, so nothing is lost and no fee is paid." .

<http://example.org/sen0401/engine/paper#midterm_v1_item1_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Yes: with four outputs the payment is a consolidation, and a consolidation must spend exactly the sum of its inputs." .

