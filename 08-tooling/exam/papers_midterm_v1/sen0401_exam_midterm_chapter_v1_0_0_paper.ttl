    pr:position 21 ;
    pr:source <http://example.org/sen0401/engine/paper#midterm_v1_src21> ;
    pr:stem "In block 74,638 two outputs held 9,223,372,036,854,277,039 satoshis each. The old software checked only the total of the outputs, stored in a signed 64-bit number: it was not above the inputs or the allowed maximum, so the check passed. Which rule, shipped within hours, would have refused that block, and why?" ;
    pr:synthesis true .

<http://example.org/sen0401/engine/paper#midterm_v1_item21_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Newly created coins must wait 100 blocks before they are spent: the 184 billion bitcoin could then not have moved." .

<http://example.org/sen0401/engine/paper#midterm_v1_item21_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The total of the outputs must not exceed the total of the inputs: the old software already checked that, and the wrapped total still passed it." .

<http://example.org/sen0401/engine/paper#midterm_v1_item21_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Each output amount must lie between 0 and 2.1 quadrillion satoshis: a range check on every output stops a huge amount before any sum can wrap around to a negative number." .

<http://example.org/sen0401/engine/paper#midterm_v1_item21_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The txid must hash only the legacy serialization: the witness could then not hide the amounts." .

<http://example.org/sen0401/engine/paper#midterm_v1_item22> a pr:CodeTraceItem,
        pr:Item ;
    en:copyChecked true ;
