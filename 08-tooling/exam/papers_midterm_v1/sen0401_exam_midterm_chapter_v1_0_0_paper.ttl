    pr:itemKey "mt1:i19:restore-passphrase-labels" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#midterm_v1_item18_optA>,
        <http://example.org/sen0401/engine/paper#midterm_v1_item18_optB>,
        <http://example.org/sen0401/engine/paper#midterm_v1_item18_optC>,
