    pr:text "['GET', '/index.html', 'HTTP', '1.1']" .

fx:P03_item1_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "The fee rate that the spender of the output must pay" .

fx:P03_item1_opt_B pr:isKey true ;
