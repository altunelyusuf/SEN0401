        fx:P03_item20_opt_C,
        fx:P03_item20_opt_D ;
    pr:position 20 ;
    pr:source fx:P03_src20 ;
    pr:stem "What does this program print when the command line is merged after the file?" .

fx:P03_item20_opt_A pr:isKey true ;
    pr:letter "A" ;
    pr:text "{'dbcache': '2048', 'txindex': '1'}" .

fx:P03_item20_opt_B pr:isKey false ;
