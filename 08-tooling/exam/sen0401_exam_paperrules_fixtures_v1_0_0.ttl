    pr:text "{'dbcache': '450', 'txindex': '1'}" .

fx:P03_item20_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "{'dbcache': '450', 'txindex': '1', 'dbcache2': '2048'}" .

fx:P03_item20_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "{'dbcache': '2048'}" .

fx:P03_item21 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 3 ;
    pr:chapter 6 ;
    pr:codeLines 2 ;
    pr:codeMaxColumns 25 ;
    pr:itemKey "P03-k21" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option fx:P03_item21_opt_A,
        fx:P03_item21_opt_B,
        fx:P03_item21_opt_C,
        fx:P03_item21_opt_D ;
    pr:position 21 ;
    pr:source fx:P03_src21 ;
    pr:stem "Spending a 68-vbyte input at 10 satoshis per vbyte costs how much, and is a 500-satoshi output worth spending?" .

fx:P03_item21_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "(680, False)" .

fx:P03_item21_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "(500, True)" .

fx:P03_item21_opt_C pr:isKey true ;
    pr:letter "C" ;
    pr:text "(680, True)" .

fx:P03_item21_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "(68, True)" .

fx:P03_item22 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 4 ;
    pr:chapter 5 ;
    pr:itemKey "P03-k22" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item22_opt_A,
        fx:P03_item22_opt_B,
        fx:P03_item22_opt_C,
        fx:P03_item22_opt_D ;
    pr:position 22 ;
    pr:source fx:P03_src22 ;
    pr:stem "Three of five SLIP39 shares are kept in different places and two are destroyed. What is the position?" .

fx:P03_item22_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "The seed is lost, because the two destroyed shares held part of it" .

fx:P03_item22_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "The seed is lost, because all five shares are needed" .

fx:P03_item22_opt_C pr:isKey true ;
    pr:letter "C" ;
    pr:text "The seed can still be recovered, because the threshold was three" .

fx:P03_item22_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "Only three fifths of the keys can be recovered" .

fx:P03_item23 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 3 ;
    pr:chapter 1 ;
    pr:codeLines 1 ;
    pr:codeMaxColumns 43 ;
    pr:itemKey "P03-k23" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option fx:P03_item23_opt_A,
        fx:P03_item23_opt_B,
        fx:P03_item23_opt_C,
        fx:P03_item23_opt_D ;
    pr:position 23 ;
    pr:source fx:P03_src23 ;
    pr:stem "What does this program print?" .

fx:P03_item23_opt_A pr:isKey true ;
    pr:letter "A" ;
    pr:text "(110000, 105000)" .

fx:P03_item23_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "(100000, 5000)" .

fx:P03_item23_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "(105000, 110000)" .

fx:P03_item23_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "(110000, 110000)" .

fx:P03_item24 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 1 ;
    pr:chapter 3 ;
    pr:itemKey "P03-k24" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item24_opt_A,
        fx:P03_item24_opt_B,
        fx:P03_item24_opt_C,
        fx:P03_item24_opt_D ;
    pr:position 24 ;
    pr:source fx:P03_src24 ;
    pr:stem "What does shifting an integer right by n places do?" .

fx:P03_item24_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "It subtracts n from the number" .

fx:P03_item24_opt_B pr:isKey true ;
    pr:letter "B" ;
    pr:text "It divides the number by 2 to the power n, and the bits that fall off are lost" .

fx:P03_item24_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "It reverses the order of the bytes of the number" .

fx:P03_item24_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "It multiplies the number by 2 to the power n" .

fx:P03_item25 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 4 ;
    pr:chapter 1 ;
    pr:itemKey "P03-k25" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item25_opt_A,
        fx:P03_item25_opt_B,
        fx:P03_item25_opt_C,
        fx:P03_item25_opt_D ;
    pr:position 25 ;
    pr:source fx:P03_src25 ;
    pr:stem "Which two functions of a central bank does mining take over, according to the chapter?" .

fx:P03_item25_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "Identity verification and fraud investigation" .

fx:P03_item25_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "Printing the banknotes of a country and setting the interest rate for its banks" .

fx:P03_item25_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "Lending to banks and holding foreign reserves" .

fx:P03_item25_opt_D pr:isKey true ;
    pr:letter "D" ;
    pr:text "Currency issuance and the clearing of transactions" .

fx:P03_item26 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 3 ;
    pr:chapter 2 ;
    pr:codeLines 1 ;
    pr:codeMaxColumns 30 ;
    pr:itemKey "P03-k26" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option fx:P03_item26_opt_A,
        fx:P03_item26_opt_B,
        fx:P03_item26_opt_C,
        fx:P03_item26_opt_D ;
    pr:position 26 ;
    pr:source fx:P03_src26 ;
    pr:stem "A twenty-five dollar item is converted at 1,584 dollars to the bitcoin. What does this program print?" .

fx:P03_item26_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "0.01577764" .

fx:P03_item26_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "63.36" .

fx:P03_item26_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "0.0157828" .

fx:P03_item26_opt_D pr:isKey true ;
    pr:letter "D" ;
    pr:text "0.01578283" .

fx:P03_item27 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 2 ;
    pr:chapter 5 ;
    pr:itemKey "P03-k27" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item27_opt_A,
        fx:P03_item27_opt_B,
        fx:P03_item27_opt_C,
        fx:P03_item27_opt_D ;
    pr:position 27 ;
    pr:source fx:P03_src27 ;
    pr:stem "How many valid seeds can one BIP39 code produce?" .

fx:P03_item27_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "Two, one with and one without a passphrase" .

fx:P03_item27_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "None until a wallet registers the code" .

fx:P03_item27_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "Exactly one, since the code together with the standard's constant salt determines the seed completely" .

fx:P03_item27_opt_D pr:isKey true ;
    pr:letter "D" ;
    pr:text "As many as there are possible passphrases, since every passphrase gives a valid seed" .

fx:P03_item28 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 2 ;
    pr:chapter 2 ;
    pr:itemKey "P03-k28" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item28_opt_A,
        fx:P03_item28_opt_B,
        fx:P03_item28_opt_C,
        fx:P03_item28_opt_D ;
    pr:position 28 ;
    pr:source fx:P03_src28 ;
    pr:stem "In what sense is a transaction form not a rule of the protocol?" .

fx:P03_item28_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "The forms were rules in the first version of Bitcoin and were later removed" .

fx:P03_item28_opt_B pr:isKey true ;
    pr:letter "B" ;
    pr:text "The protocol sees only inputs and outputs; the forms are names for typical shapes" .

fx:P03_item28_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "The forms are enforced by miners but not by full nodes" .

fx:P03_item28_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "The forms apply only to transactions with a change output" .

fx:P03_item29 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 4 ;
    pr:chapter 3 ;
    pr:itemKey "P03-k29" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item29_opt_A,
        fx:P03_item29_opt_B,
        fx:P03_item29_opt_C,
        fx:P03_item29_opt_D ;
    pr:position 29 ;
    pr:source fx:P03_src29 ;
    pr:stem "Why can a program that holds only the headers follow the chain and its work?" .

fx:P03_item29_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "The header holds the height of every block that the node stores" .

fx:P03_item29_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "The header contains the signatures of all the transactions in the block" .

fx:P03_item29_opt_C pr:isKey true ;
    pr:letter "C" ;
    pr:text "The header commits to the transactions through the Merkle root and to the work through the target" .

fx:P03_item29_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "The header includes the full list of transaction identifiers" .

fx:P03_item2_opt_A pr:isKey true ;
    pr:letter "A" ;
    pr:text "3" .

fx:P03_item2_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "2" .

fx:P03_item2_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "1" .

fx:P03_item2_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "6" .

fx:P03_item3 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "P03-k3" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item3_opt_A,
        fx:P03_item3_opt_B,
        fx:P03_item3_opt_C,
        fx:P03_item3_opt_D ;
    pr:position 3 ;
    pr:source fx:P03_src3 ;
    pr:stem "Why is counting nodes not the same as measuring the network's security?" .

fx:P03_item30 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 3 ;
    pr:chapter 5 ;
    pr:codeLines 1 ;
    pr:codeMaxColumns 16 ;
    pr:itemKey "P03-k30" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option fx:P03_item30_opt_A,
        fx:P03_item30_opt_B,
        fx:P03_item30_opt_C,
        fx:P03_item30_opt_D ;
    pr:position 30 ;
    pr:source fx:P03_src30 ;
    pr:stem "At about 32 bytes per key, how many bytes must be backed up for 1,000 independently generated keys?" .

fx:P03_item30_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "32" .

fx:P03_item30_opt_B pr:isKey true ;
    pr:letter "B" ;
    pr:text "32000" .

fx:P03_item30_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "1032" .

fx:P03_item30_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "320" .

fx:P03_item3_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because lightweight clients are counted twice in the usual figures" .

fx:P03_item3_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because every node counts for one vote on the next block" .

fx:P03_item3_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because the figures that are published count only the nodes that accept incoming connections, and those are counted once a day by the block explorers" .

fx:P03_item3_opt_D pr:isKey true ;
    pr:letter "D" ;
    pr:text "Because what matters is how many participants independently verify the rules, not how many are connected" .

fx:P03_item4 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "P03-k4" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item4_opt_A,
        fx:P03_item4_opt_B,
        fx:P03_item4_opt_C,
        fx:P03_item4_opt_D ;
    pr:position 4 ;
    pr:source fx:P03_src4 ;
    pr:stem "Why does the chapter's toolkit say that it must not be used with real funds?" .

fx:P03_item4_opt_A pr:isKey true ;
    pr:letter "A" ;
    pr:text "It is not constant-time and takes no care over where randomness comes from" .

fx:P03_item4_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "It has no licence that permits use outside teaching" .

fx:P03_item4_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "It gives addresses that differ from the ones Bitcoin Core gives for the same private key" .

fx:P03_item4_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "It cannot compute the public key of a 256-bit private key" .

fx:P03_item5 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 2 ;
    pr:chapter 1 ;
    pr:itemKey "P03-k5" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item5_opt_A,
        fx:P03_item5_opt_B,
        fx:P03_item5_opt_C,
        fx:P03_item5_opt_D ;
    pr:position 5 ;
    pr:source fx:P03_src5 ;
    pr:stem "Why does the chapter say that Bitcoin has no central server?" .

fx:P03_item5_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because the nodes use no network connections at all" .

fx:P03_item5_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because a single company owns every node" .

fx:P03_item5_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because the servers of the network are hidden behind the reference implementation" .

fx:P03_item5_opt_D pr:isKey true ;
    pr:letter "D" ;
    pr:text "Because every full node both provides and consumes the same services" .

fx:P03_item6 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 4 ;
    pr:chapter 3 ;
    pr:itemKey "P03-k6" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item6_opt_A,
        fx:P03_item6_opt_B,
        fx:P03_item6_opt_C,
        fx:P03_item6_opt_D ;
    pr:position 6 ;
    pr:source fx:P03_src6 ;
    pr:stem "Why does a reorganization not by itself undo a payment?" .

fx:P03_item6_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "Reorganizations only affect blocks older than six confirmations" .

fx:P03_item6_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "The payment is stored in the wallet and the chain cannot remove it" .

fx:P03_item6_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "A reorganization changes the timestamps but never the transactions" .

fx:P03_item6_opt_D pr:isKey true ;
    pr:letter "D" ;
    pr:text "The transaction usually returns to the pool and is confirmed again, unless a conflicting one won" .

fx:P03_item7 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 2 ;
    pr:chapter 4 ;
    pr:itemKey "P03-k7" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item7_opt_A,
        fx:P03_item7_opt_B,
        fx:P03_item7_opt_C,
        fx:P03_item7_opt_D ;
    pr:position 7 ;
    pr:source fx:P03_src7 ;
    pr:stem "Why does the chapter treat the way a number is written down as a matter of safety?" .

fx:P03_item7_opt_A pr:isKey true ;
    pr:letter "A" ;
    pr:text "A mistake in copying a commitment sends the coins to an output nobody can spend" .

fx:P03_item7_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "A badly chosen alphabet makes the private key easier to guess" .

fx:P03_item7_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "Only one representation is accepted by the consensus rules" .

fx:P03_item7_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "A longer representation takes up more space in a block and therefore raises the fee" .

fx:P03_item8 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 3 ;
    pr:chapter 6 ;
    pr:codeLines 2 ;
    pr:codeMaxColumns 29 ;
    pr:itemKey "P03-k8" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option fx:P03_item8_opt_A,
        fx:P03_item8_opt_B,
        fx:P03_item8_opt_C,
        fx:P03_item8_opt_D ;
    pr:position 8 ;
    pr:source fx:P03_src8 ;
    pr:stem "Two signatures of the same data with different random numbers. Are they different?" .

fx:P03_item8_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "False" .

fx:P03_item8_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "1234" .

fx:P03_item8_opt_C pr:isKey true ;
    pr:letter "C" ;
    pr:text "True" .

fx:P03_item8_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "None" .

fx:P03_item9 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 1 ;
    pr:chapter 1 ;
    pr:itemKey "P03-k9" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item9_opt_A,
        fx:P03_item9_opt_B,
        fx:P03_item9_opt_C,
        fx:P03_item9_opt_D ;
    pr:position 9 ;
    pr:source fx:P03_src9 ;
    pr:stem "What is a database?" .

fx:P03_item9_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "A protocol for moving organized data between two or more computers" .

fx:P03_item9_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "A program that displays data to a user" .

fx:P03_item9_opt_C pr:isKey true ;
    pr:letter "C" ;
    pr:text "A storage system for organized data, easier to search, structure and extend" .

fx:P03_item9_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "A fixed-length fingerprint of a data object" .

