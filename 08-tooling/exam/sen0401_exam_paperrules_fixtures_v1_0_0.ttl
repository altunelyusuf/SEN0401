fx:P03_item1 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 1 ;
    pr:chapter 2 ;
    pr:itemKey "P03-k1" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item1_opt_A,
        fx:P03_item1_opt_B,
        fx:P03_item1_opt_C,
        fx:P03_item1_opt_D ;
    pr:position 1 ;
    pr:source fx:P03_src1 ;
    pr:stem "What does an output script specify?" .

fx:P03_item10 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 4 ;
    pr:chapter 5 ;
    pr:itemKey "P03-k10" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item10_opt_A,
        fx:P03_item10_opt_B,
        fx:P03_item10_opt_C,
        fx:P03_item10_opt_D ;
    pr:position 10 ;
    pr:source fx:P03_src10 ;
    pr:stem "What will most hardware signing devices never do?" .

fx:P03_item10_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "Sign more than one transaction" .

fx:P03_item10_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "Derive hardened children" .

fx:P03_item10_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "Export public keys" .

fx:P03_item10_opt_D pr:isKey true ;
    pr:letter "D" ;
    pr:text "Export private keys" .

fx:P03_item11 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 2 ;
    pr:chapter 6 ;
    pr:itemKey "P03-k11" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item11_opt_A,
        fx:P03_item11_opt_B,
        fx:P03_item11_opt_C,
        fx:P03_item11_opt_D ;
    pr:position 11 ;
    pr:source fx:P03_src11 ;
    pr:stem "Why does changing one byte of a previous transaction break every outpoint that names it?" .

fx:P03_item11_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "Outpoints are stored by block height" .

fx:P03_item11_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "Outpoints expire when a transaction is edited" .

fx:P03_item11_opt_C pr:isKey true ;
    pr:letter "C" ;
    pr:text "The txid is a hash of the bytes, so it changes completely" .

fx:P03_item11_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "The index would no longer fit" .

fx:P03_item12 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 2 ;
    pr:chapter 6 ;
    pr:itemKey "P03-k12" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item12_opt_A,
        fx:P03_item12_opt_B,
        fx:P03_item12_opt_C,
        fx:P03_item12_opt_D ;
    pr:position 12 ;
    pr:source fx:P03_src12 ;
    pr:stem "What is an example of wanted malleability?" .

fx:P03_item12_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "A miner changing the lock time" .

fx:P03_item12_opt_B pr:isKey true ;
    pr:letter "B" ;
    pr:text "Alice using a signature hash to let Bob add an input and help pay the fee" .

fx:P03_item12_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "A stranger re-encoding a push" .

fx:P03_item12_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "Bob re-signing the deposit" .

fx:P03_item13 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "P03-k13" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item13_opt_A,
        fx:P03_item13_opt_B,
        fx:P03_item13_opt_C,
        fx:P03_item13_opt_D ;
    pr:position 13 ;
    pr:source fx:P03_src13 ;
    pr:stem "The book says the secp256k1 curve was established by NIST. What do the primary sources show?" .

fx:P03_item13_opt_A pr:isKey true ;
    pr:letter "A" ;
    pr:text "It is defined in SEC 2 by Certicom Research, which marks it as not on the NIST list" .

fx:P03_item13_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "It was established by NIST in 2010 together with secp256r1" .

fx:P03_item13_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "It was established by the Bitcoin developers and was later adopted unchanged by NIST" .

fx:P03_item13_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "It has no written standard, only an implementation in libsecp256k1" .

fx:P03_item14 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 3 ;
    pr:chapter 4 ;
    pr:codeLines 4 ;
    pr:codeMaxColumns 45 ;
    pr:itemKey "P03-k14" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option fx:P03_item14_opt_A,
        fx:P03_item14_opt_B,
        fx:P03_item14_opt_C,
        fx:P03_item14_opt_D ;
    pr:position 14 ;
    pr:source fx:P03_src14 ;
    pr:stem "What does this program print?" .

fx:P03_item14_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "128" .

fx:P03_item14_opt_B pr:isKey true ;
    pr:letter "B" ;
    pr:text "139" .

fx:P03_item14_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "1" .

fx:P03_item14_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "256" .

fx:P03_item15 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 3 ;
    pr:chapter 6 ;
    pr:codeLines 2 ;
    pr:codeMaxColumns 41 ;
    pr:itemKey "P03-k15" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option fx:P03_item15_opt_A,
        fx:P03_item15_opt_B,
        fx:P03_item15_opt_C,
        fx:P03_item15_opt_D ;
    pr:position 15 ;
    pr:source fx:P03_src15 ;
    pr:stem "Alice and Bob each deposit 50,000 satoshis. What does the multisignature output hold?" .

fx:P03_item15_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "50000" .

fx:P03_item15_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "150000" .

fx:P03_item15_opt_C pr:isKey true ;
    pr:letter "C" ;
    pr:text "100000" .

fx:P03_item15_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "0" .

fx:P03_item16 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 2 ;
    pr:chapter 3 ;
    pr:itemKey "P03-k16" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item16_opt_A,
        fx:P03_item16_opt_B,
        fx:P03_item16_opt_C,
        fx:P03_item16_opt_D ;
    pr:position 16 ;
    pr:source fx:P03_src16 ;
    pr:stem "Why does building without the graphical interface remove one prerequisite?" .

fx:P03_item16_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "Qt is part of the compiler and always comes with build-essential" .

fx:P03_item16_opt_B pr:isKey true ;
    pr:letter "B" ;
    pr:text "The graphical client is the part that needs Qt, and it is not built by default" .

fx:P03_item16_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "The interface depends on the wallet database, which is skipped when the wallet is switched off" .

fx:P03_item16_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "Qt is needed only for the tests, which the default build leaves out" .

fx:P03_item17 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 2 ;
    pr:chapter 5 ;
    pr:itemKey "P03-k17" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item17_opt_A,
        fx:P03_item17_opt_B,
        fx:P03_item17_opt_C,
        fx:P03_item17_opt_D ;
    pr:position 17 ;
    pr:source fx:P03_src17 ;
    pr:stem "Why is a recovery code alone not always enough to recover a wallet?" .

fx:P03_item17_opt_A pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because it does not contain the seed" .

fx:P03_item17_opt_B pr:isKey true ;
    pr:letter "B" ;
    pr:text "Because it does not say which paths of the tree the wallet used" .

fx:P03_item17_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because the checksum cannot be verified without the wallet" .

fx:P03_item17_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "Because the keys expire" .

fx:P03_item18 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 1 ;
    pr:chapter 4 ;
    pr:itemKey "P03-k18" ;
    pr:itemType pr:ChoiceFour ;
    pr:option fx:P03_item18_opt_A,
        fx:P03_item18_opt_B,
        fx:P03_item18_opt_C,
        fx:P03_item18_opt_D ;
    pr:position 18 ;
    pr:source fx:P03_src18 ;
    pr:stem "What do the two halves of the name bech32 stand for?" .

fx:P03_item18_opt_A pr:isKey true ;
    pr:letter "A" ;
    pr:text "BCH, the error detection algorithm, and the 32 characters of the alphabet" .

fx:P03_item18_opt_B pr:isKey false ;
    pr:letter "B" ;
    pr:text "Base encoding for cryptographic hashes and 32 bits of checksum" .

fx:P03_item18_opt_C pr:isKey false ;
    pr:letter "C" ;
    pr:text "Bitcoin enhanced checksum and the 32 bytes of a program" .

fx:P03_item18_opt_D pr:isKey false ;
    pr:letter "D" ;
    pr:text "The initials of the authors and the year 2032" .

fx:P03_item19 a pr:ChoiceItem,
        pr:Item ;
    pr:bloomLevel 3 ;
    pr:chapter 1 ;
    pr:codeLines 1 ;
    pr:codeMaxColumns 44 ;
    pr:itemKey "P03-k19" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option fx:P03_item19_opt_A,
