<http://example.org/sen0401/engine/paper#midterm_v3_item17_step0> a pr:Step ;
    pr:correctPosition 1 ;
    pr:text "The wallet takes whole coins from its unspent outputs (coins no later payment has used) until they cover the payment and the fee." .

<http://example.org/sen0401/engine/paper#midterm_v3_item17_step1> a pr:Step ;
    pr:correctPosition 2 ;
    pr:text "The wallet writes the payee output and the change output (the part that returns to the sender) and leaves the fee as the difference." .

<http://example.org/sen0401/engine/paper#midterm_v3_item17_step2> a pr:Step ;
    pr:correctPosition 3 ;
    pr:text "The wallet signs every input (proves that it may spend the coin the input names)." .

<http://example.org/sen0401/engine/paper#midterm_v3_item17_step3> a pr:Step ;
    pr:correctPosition 4 ;
    pr:text "A node (a computer that checks the rules) checks the transaction and relays it, that is, passes it on to its peers." .

<http://example.org/sen0401/engine/paper#midterm_v3_item17_step4> a pr:Step ;
    pr:correctPosition 5 ;
    pr:text "A miner finds a valid nonce (the number varied in the search for a block) and adds a block that holds the transaction." .

