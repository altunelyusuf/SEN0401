    pr:shuffleSeed 5724 .

<http://example.org/sen0401/engine/paper#midterm_v3_bank23_e0> a pr:BankEntry ;
    pr:label "45" ;
    pr:position 4 ;
    pr:text "commitment (a value that fixes a secret now and lets its owner reveal it later)" .

<http://example.org/sen0401/engine/paper#midterm_v3_bank23_e1> a pr:BankEntry ;
    pr:label "37" ;
    pr:position 3 ;
    pr:text "256-bit hash (the hash function Secure Hash Algorithm 256-bit (SHA256), whose result is 256 bits long)" .

<http://example.org/sen0401/engine/paper#midterm_v3_item16_resp1> a pr:Response ;
    pr:letter "B" ;
    pr:text "A signed amount needs a range check (zero up to the maximum) on each output, not only on the total." .

<http://example.org/sen0401/engine/paper#midterm_v3_item16_resp3> a pr:Response ;
    pr:letter "D" ;
    pr:text "Memory is not a backup: test a recovery code by restoring it." .

<http://example.org/sen0401/engine/paper#midterm_v3_item16_resp4> a pr:Response ;
    pr:letter "E" ;
    pr:text "A reference implementation (the program that defines the rules) needs a team and public review." .

<http://example.org/sen0401/engine/paper#midterm_v3_item16_resp5> a pr:Response ;
    pr:letter "F" ;
    pr:text "A stated cause is tested against data: malleability changes the transaction identifier (txid)." .

<http://example.org/sen0401/engine/paper#midterm_v3_item18_resp0> a pr:Response ;
    pr:letter "A" ;
