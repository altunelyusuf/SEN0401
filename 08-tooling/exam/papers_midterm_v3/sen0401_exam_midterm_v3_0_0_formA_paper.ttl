    en:optionSetKey "filinganuntestedfileisnotanemptyoneoldfilewhoeverholdsthekeysholdsthecoins|filingcustomerslosttheirownkeysoldfilebackupsexpiresoanoldfilecanbethrownaway|filingthenetworklettheexchangespendthesamecoinstwiceoldfileminersheldthecoinsbackforafee|filingwhoeverholdsthekeysholdsthecoinsandcustomersheldnoneoldfileanuntestedfileisnotanemptyone" ;
    en:origin en:Authored ;
