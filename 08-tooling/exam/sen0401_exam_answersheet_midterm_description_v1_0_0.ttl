fx:sheet a as:Sheet ;
    as:containsPersonalData false ;
    as:fiducialCount 4 ;
    as:fillColourUsed false ;
    as:fontPt 10 ;
    as:formCode "10100" ;
    as:formCodeValid true ;
    as:hasBlock fx:block0,
        fx:block1,
        fx:block2,
        fx:block3,
        fx:block4,
        fx:block5,
        fx:block6,
        fx:block7,
        fx:block8,
        fx:block9 ;
    as:hasRule fx:rule_DeclareBlank,
        fx:rule_DoubleIsNoAnswer,
        fx:rule_StrikeVoids ;
    as:hasUnit fx:unit_1,
        fx:unit_10,
        fx:unit_11,
        fx:unit_12,
        fx:unit_13,
        fx:unit_14,
        fx:unit_15,
        fx:unit_16,
        fx:unit_17,
        fx:unit_18,
        fx:unit_19,
        fx:unit_2,
        fx:unit_20,
        fx:unit_21,
        fx:unit_22,
        fx:unit_23,
        fx:unit_24,
        fx:unit_25a,
        fx:unit_25b,
        fx:unit_25c,
        fx:unit_25d,
        fx:unit_26a,
        fx:unit_26b,
        fx:unit_26c,
        fx:unit_27,
        fx:unit_28,
        fx:unit_29,
        fx:unit_3,
        fx:unit_30,
        fx:unit_31,
        fx:unit_32,
        fx:unit_33,
        fx:unit_4,
        fx:unit_5,
        fx:unit_6,
        fx:unit_7,
        fx:unit_8,
        fx:unit_9 ;
    as:pageCount 1 ;
    as:paperKind "Midterm" ;
    as:rasterImages 0 ;
    as:thresholdFaint 0.12 ;
    as:thresholdFilled 0.5 .

fx:rule_DeclareBlank a as:Rule ;
    as:ruleKind "DeclareBlank" ;
    as:text "every number left blank is declared in the block closure" .

fx:rule_DoubleIsNoAnswer a as:Rule ;
    as:ruleKind "DoubleIsNoAnswer" ;
    as:text "two filled bubbles in a row count as no answer" .

fx:rule_StrikeVoids a as:Rule ;
    as:ruleKind "StrikeVoids" ;
    as:text "an X through a bubble voids it" .

