@prefix as: <http://example.org/sen0401/answersheet#> .
@prefix fx: <http://example.org/sen0401/answersheet/instance#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fx:code1 a as:BankCode ;
    as:checkValid true ;
    as:digits "13" .

fx:code2 a as:BankCode ;
    as:checkValid true ;
    as:digits "21" .

