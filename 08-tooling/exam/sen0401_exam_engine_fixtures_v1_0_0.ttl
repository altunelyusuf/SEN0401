<http://example.org/sen0401/engine/paper#N25/makeup_v2_item7_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "10000 times the major number plus 100 times the minor number plus the build number" .

<http://example.org/sen0401/engine/paper#N25/makeup_v2_item7_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The three numbers written one after another without separators" .

