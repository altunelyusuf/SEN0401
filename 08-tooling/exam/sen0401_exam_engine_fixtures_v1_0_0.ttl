    pr:position 3 ;
    pr:source <http://example.org/sen0401/engine/paper#N28/makeup_v2_src3> ;
    pr:stem "In what sense is Bitcoin's privacy pseudonymous rather than anonymous?" .

<http://example.org/sen0401/engine/paper#N28/makeup_v2_item3_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Payments are visible only to the miner who includes them" .

<http://example.org/sen0401/engine/paper#N28/makeup_v2_item3_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The payments themselves are hidden, while the names of the two parties are public" .

<http://example.org/sen0401/engine/paper#N28/makeup_v2_item3_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Payments are encrypted and nobody can read them" .

<http://example.org/sen0401/engine/paper#N28/makeup_v2_item3_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Payments are public but attached to addresses, which are names without a person behind them" .

