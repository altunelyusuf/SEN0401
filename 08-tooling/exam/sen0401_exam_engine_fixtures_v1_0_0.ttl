    pr:code """stacks = [[], ['signature', 'public key']]
print([len(s) for s in stacks])""" ;
    pr:codeLines 2 ;
    pr:codeMaxColumns 42 ;
    pr:itemKey "bank:ch06:LegacyInputWitness:153" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option <http://example.org/sen0401/engine/paper#N09/makeup_v2_item16_optA>,
        <http://example.org/sen0401/engine/paper#N09/makeup_v2_item16_optB>,
