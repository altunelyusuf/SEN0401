<http://example.org/sen0401/engine/paper#P03/midterm_v2_item1> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:GenesisBlock:152" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P03/midterm_v2_item1_optA>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item1_optB>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item1_optC>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item1_optD> ;
    pr:position 1 ;
    pr:source <http://example.org/sen0401/engine/paper#P03/midterm_v2_src1> ;
    pr:stem "Why is the genesis block fixed in the software rather than verified like other blocks?" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item10> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 3 ;
    pr:chapter 5 ;
    pr:code """import math
print(math.comb(3, 2))""" ;
    pr:codeLines 2 ;
    pr:codeMaxColumns 22 ;
    pr:itemKey "bank:ch05:Multisignature:127" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option <http://example.org/sen0401/engine/paper#P03/midterm_v2_item10_optA>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item10_optB>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item10_optC>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item10_optD> ;
    pr:position 10 ;
    pr:source <http://example.org/sen0401/engine/paper#P03/midterm_v2_src10> ;
    pr:stem "In how many ways can two of three signers meet a two-of-three condition?" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item10_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "6" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item10_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "3" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item10_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "2" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item10_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "9" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item1_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because the proof of work of the first block was lost when the network restarted in 2011, so no node is able to check its header any more" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item1_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because its only transaction has no output" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item1_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because its hash was chosen by the miners of the first week" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item1_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Because it has nothing below it, so it cannot be trusted on the strength of work piled on top" .

