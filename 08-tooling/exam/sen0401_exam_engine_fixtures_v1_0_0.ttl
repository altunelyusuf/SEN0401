<http://example.org/sen0401/engine/paper#N27/makeup_v2_item18_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Replacement became opt-in, signalled through the sequence field" .

<http://example.org/sen0401/engine/paper#N27/makeup_v2_item18_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Only miners may replace" .

