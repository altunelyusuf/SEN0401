    pr:position 9 ;
    pr:source <http://example.org/sen0401/engine/paper#N36/makeup_v2_src9> ;
    pr:stem "A pruned node deletes old block files. Is it still a full node, and why?" .

<http://example.org/sen0401/engine/paper#N36/makeup_v2_item9_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "No, because the word full means that every block is stored forever" .

<http://example.org/sen0401/engine/paper#N36/makeup_v2_item9_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "No, a node that has discarded any block can no longer validate what it receives" .

<http://example.org/sen0401/engine/paper#N36/makeup_v2_item9_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Yes, it still verifies the whole chain and only keeps the most recent blocks" .

<http://example.org/sen0401/engine/paper#N36/makeup_v2_item9_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Yes, but only after a lightweight client confirms each block that was deleted" .

