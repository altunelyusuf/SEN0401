<http://example.org/sen0401/engine/paper#P03/midterm_v2_item4> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:TransactionSize:10" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P03/midterm_v2_item4_optA>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item4_optB>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item4_optC>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item4_optD> ;
    pr:position 4 ;
    pr:source <http://example.org/sen0401/engine/paper#P03/midterm_v2_src4> ;
    pr:stem "Why do the three size figures of a transaction answer different questions?" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item4_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The three are the same number written in three notations, so any one of them can be used" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item4_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The byte size includes the witness, the weight excludes it and the vbyte averages the two" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item4_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "The byte size is the serialized length, the weight is what the block limit counts, and the vbyte is the weight in a familiar unit" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item4_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The byte size is the figure that wallets display, the weight is the figure that block explorers index, and the virtual byte is reserved for the fee estimates that miners publish" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item5> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 2 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:Form:58" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P03/midterm_v2_item5_optA>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item5_optB>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item5_optC>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item5_optD> ;
    pr:position 5 ;
    pr:source <http://example.org/sen0401/engine/paper#P03/midterm_v2_src5> ;
    pr:stem "In what sense is a transaction form not a rule of the protocol?" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item5_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "The protocol sees only inputs and outputs; the forms are names for typical shapes" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item5_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The forms apply only to transactions with a change output" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item5_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The forms were rules in the first version of Bitcoin and were later removed" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item5_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The forms are enforced by miners but not by full nodes" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item6> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 3 ;
    pr:chapter 5 ;
    pr:code """d = 'wpkh([6d8c4b8f/84h/0h/0h]xpub.../0/*)'
print(d[:d.index('(')])""" ;
    pr:codeLines 2 ;
    pr:codeMaxColumns 43 ;
    pr:itemKey "bank:ch05:OutputScriptDescriptor:132" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option <http://example.org/sen0401/engine/paper#P03/midterm_v2_item6_optA>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item6_optB>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item6_optC>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item6_optD> ;
    pr:position 6 ;
    pr:source <http://example.org/sen0401/engine/paper#P03/midterm_v2_src6> ;
    pr:stem "What is the function name at the start of the descriptor wpkh([6d8c4b8f/84h/0h/0h]xpub.../0/*)?" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item6_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "wpkh" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item6_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "pkh" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item6_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "sh" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item6_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "tr" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item7> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 2 ;
    pr:chapter 5 ;
    pr:itemKey "bank:ch05:BackupTesting:181" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P03/midterm_v2_item7_optA>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item7_optB>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item7_optC>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item7_optD> ;
    pr:position 7 ;
    pr:source <http://example.org/sen0401/engine/paper#P03/midterm_v2_src7> ;
    pr:stem "What should the holder of a backup do regularly?" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item7_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Change their recovery code" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item7_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Move their funds to new addresses" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item7_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Test their backups" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item7_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Export their labels" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item8> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 4 ;
    pr:chapter 5 ;
    pr:itemKey "bank:ch05:PublicChildDerivation:86" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P03/midterm_v2_item8_optA>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item8_optB>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item8_optC>,
        <http://example.org/sen0401/engine/paper#P03/midterm_v2_item8_optD> ;
    pr:position 8 ;
    pr:source <http://example.org/sen0401/engine/paper#P03/midterm_v2_src8> ;
    pr:stem "Why is public derivation defined only for normal children?" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item8_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because hardened children are not on the curve" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item8_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Because a hardened child's hash needs the parent private key" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item8_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because hardened children have no chain code" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item8_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Because the index would overflow 32 bits" .

