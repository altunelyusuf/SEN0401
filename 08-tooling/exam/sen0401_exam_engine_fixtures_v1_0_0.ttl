    pr:position 2 ;
    pr:source <http://example.org/sen0401/engine/paper#N20/makeup_v2_src2> ;
    pr:stem "Why do most mobile wallets reduce their user's privacy?" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item2_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "They fetch information from remote servers, disclosing addresses and balances" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item2_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "They publish the user's name together with each payment" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item2_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "They sign transactions with a key shared by all users" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item2_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "They store a copy of the recovery code on the server of the phone's manufacturer" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item3> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 4 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:Privacy:89" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N20/makeup_v2_item3_optA>,
        <http://example.org/sen0401/engine/paper#N20/makeup_v2_item3_optB>,
        <http://example.org/sen0401/engine/paper#N20/makeup_v2_item3_optC>,
        <http://example.org/sen0401/engine/paper#N20/makeup_v2_item3_optD> ;
    pr:position 3 ;
    pr:source <http://example.org/sen0401/engine/paper#N20/makeup_v2_src3> ;
    pr:stem "In what sense is Bitcoin's privacy pseudonymous rather than anonymous?" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item3_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Payments are visible only to the miner who includes them" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item3_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The payments themselves are hidden, while the names of the two parties are public" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item3_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Payments are encrypted and nobody can read them" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item3_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Payments are public but attached to addresses, which are names without a person behind them" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item4> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 3 ;
    pr:chapter 2 ;
    pr:code "print(sum([75000, 20000, 5000]) == 100000)" ;
    pr:codeLines 1 ;
    pr:codeMaxColumns 42 ;
    pr:itemKey "bank:ch02:DoubleEntryLedger:3" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option <http://example.org/sen0401/engine/paper#N20/makeup_v2_item4_optA>,
        <http://example.org/sen0401/engine/paper#N20/makeup_v2_item4_optB>,
        <http://example.org/sen0401/engine/paper#N20/makeup_v2_item4_optC>,
        <http://example.org/sen0401/engine/paper#N20/makeup_v2_item4_optD> ;
    pr:position 4 ;
    pr:source <http://example.org/sen0401/engine/paper#N20/makeup_v2_src4> ;
    pr:stem "Alice's inputs total 100,000 satoshis and her outputs 75,000 and 20,000, with a fee of 5,000. What does this program print?" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item4_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "False" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item4_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "True" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item4_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "95000" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item4_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "100000" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item5> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 3 ;
    pr:chapter 2 ;
    pr:code "print((50 * 10 ** 8) >> 3)" ;
    pr:codeLines 1 ;
    pr:codeMaxColumns 26 ;
    pr:itemKey "bank:ch02:BlockReward:132" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option <http://example.org/sen0401/engine/paper#N20/makeup_v2_item5_optA>,
        <http://example.org/sen0401/engine/paper#N20/makeup_v2_item5_optB>,
        <http://example.org/sen0401/engine/paper#N20/makeup_v2_item5_optC>,
        <http://example.org/sen0401/engine/paper#N20/makeup_v2_item5_optD> ;
    pr:position 5 ;
    pr:source <http://example.org/sen0401/engine/paper#N20/makeup_v2_src5> ;
    pr:stem "Three halvings have occurred. What does this program print for the subsidy in satoshis?" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item5_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "5000000000" .

<http://example.org/sen0401/engine/paper#N20/makeup_v2_item5_optB> pr:isKey false ;
