    pr:position 4 ;
    pr:source <http://example.org/sen0401/engine/paper#P02/makeup_v2_src4> ;
    pr:stem "Why does it not matter how or where a transaction is transmitted?" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item4_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because every route passes through the same relay server" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item4_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because the first node to receive it rewrites it in a standard form" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item4_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because the fee pays for a guaranteed delivery path" .

