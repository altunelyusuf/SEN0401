        <http://example.org/sen0401/engine/paper#N06/makeup_v2_item4_optD> ;
    pr:position 4 ;
    pr:source <http://example.org/sen0401/engine/paper#N06/makeup_v2_src4> ;
    pr:stem "Alice's inputs total 100,000 satoshis and her outputs 75,000 and 20,000, with a fee of 5,000. What does this program print?" .

<http://example.org/sen0401/engine/paper#N06/makeup_v2_item4_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "False" .

<http://example.org/sen0401/engine/paper#N06/makeup_v2_item4_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "True" .

<http://example.org/sen0401/engine/paper#N06/makeup_v2_item4_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "95000" .

<http://example.org/sen0401/engine/paper#N06/makeup_v2_item4_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "100000" .

