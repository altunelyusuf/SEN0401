<http://example.org/sen0401/engine/paper#P02/midterm_v2_item21> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 7 ;
    pr:bloomLevel 3 ;
    pr:chapter 7 ;
    pr:code "print((3 + 34 * 5) - 23)" ;
    pr:codeLines 1 ;
    pr:codeMaxColumns 24 ;
    pr:itemKey "bank:ch07:P2shBenefits:59" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option <http://example.org/sen0401/engine/paper#P02/midterm_v2_item21_optA>,
        <http://example.org/sen0401/engine/paper#P02/midterm_v2_item21_optB>,
        <http://example.org/sen0401/engine/paper#P02/midterm_v2_item21_optC>,
        <http://example.org/sen0401/engine/paper#P02/midterm_v2_item21_optD> ;
    pr:position 21 ;
    pr:source <http://example.org/sen0401/engine/paper#P02/midterm_v2_src21> ;
    pr:stem "A bare 3-of-5 multisignature output with compressed keys takes 3 + 34 * 5 bytes. How many bytes does a P2SH output of 23 bytes save in the payer's output?" .

<http://example.org/sen0401/engine/paper#P02/midterm_v2_item21_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "126" .

<http://example.org/sen0401/engine/paper#P02/midterm_v2_item21_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "170" .

<http://example.org/sen0401/engine/paper#P02/midterm_v2_item21_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "23" .

<http://example.org/sen0401/engine/paper#P02/midterm_v2_item21_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "150" .

<http://example.org/sen0401/engine/paper#P02/midterm_v2_item2_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "They were centralized, so a single point could be attacked or shut down" .

<http://example.org/sen0401/engine/paper#P02/midterm_v2_item2_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "They could not be exchanged for national currencies" .

<http://example.org/sen0401/engine/paper#P02/midterm_v2_item2_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "They had no limit on how much of their money could be issued by the company behind them" .

<http://example.org/sen0401/engine/paper#P02/midterm_v2_item2_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "They used no cryptography at all" .

