<http://example.org/sen0401/engine/paper#N15/makeup_v2_item8> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
    pr:bloomLevel 4 ;
    pr:chapter 3 ;
    pr:itemKey "bank:ch03:RpcAuth:131" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N15/makeup_v2_item8_optA>,
        <http://example.org/sen0401/engine/paper#N15/makeup_v2_item8_optB>,
