<http://example.org/sen0401/engine/paper#P02/midterm_v2_item18_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "So that each party is protected by a refund before committing funds" .

<http://example.org/sen0401/engine/paper#P02/midterm_v2_item18_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "To reduce the fee" .

