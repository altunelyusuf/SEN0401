    pr:position 3 ;
    pr:source <http://example.org/sen0401/engine/paper#N31/makeup_v2_src3> ;
    pr:stem "In what sense is Bitcoin's privacy pseudonymous rather than anonymous?" .

<http://example.org/sen0401/engine/paper#N31/makeup_v2_item3_optA> pr:isKey false ;
