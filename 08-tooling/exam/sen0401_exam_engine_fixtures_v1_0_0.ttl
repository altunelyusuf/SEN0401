    pr:letter "D" ;
    pr:text "The count of commits in the repository at the time of the release" .

<http://example.org/sen0401/engine/paper#N25/makeup_v2_item8> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
    pr:bloomLevel 4 ;
    pr:chapter 3 ;
    pr:itemKey "bank:ch03:RpcAuth:131" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N25/makeup_v2_item8_optA>,
        <http://example.org/sen0401/engine/paper#N25/makeup_v2_item8_optB>,
        <http://example.org/sen0401/engine/paper#N25/makeup_v2_item8_optC>,
        <http://example.org/sen0401/engine/paper#N25/makeup_v2_item8_optD> ;
    pr:position 8 ;
    pr:source <http://example.org/sen0401/engine/paper#N25/makeup_v2_src8> ;
    pr:stem "Why does the hashed credential protect the file but not the connection?" .

<http://example.org/sen0401/engine/paper#N25/makeup_v2_item8_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The connection is encrypted by default, but the file can be read by everybody" .

<http://example.org/sen0401/engine/paper#N25/makeup_v2_item8_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "The file holds only a salted hash, but the client still sends the password in every request" .

<http://example.org/sen0401/engine/paper#N25/makeup_v2_item8_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The hash is checked by the client, so the server never sees the password" .

<http://example.org/sen0401/engine/paper#N25/makeup_v2_item8_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The file is encrypted, but the hash is sent to the server in place of the password every time" .

<http://example.org/sen0401/engine/paper#N25/makeup_v2_item9> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
    pr:bloomLevel 4 ;
    pr:chapter 3 ;
    pr:itemKey "bank:ch03:FullNode:3" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N25/makeup_v2_item9_optA>,
