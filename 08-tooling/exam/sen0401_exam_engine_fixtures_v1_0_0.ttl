<http://example.org/sen0401/engine/paper#N12/makeup_v2_item6> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 1 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:Mining:110" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N12/makeup_v2_item6_optA>,
        <http://example.org/sen0401/engine/paper#N12/makeup_v2_item6_optB>,
        <http://example.org/sen0401/engine/paper#N12/makeup_v2_item6_optC>,
        <http://example.org/sen0401/engine/paper#N12/makeup_v2_item6_optD> ;
    pr:position 6 ;
    pr:source <http://example.org/sen0401/engine/paper#N12/makeup_v2_src6> ;
    pr:stem "Which two purposes does mining serve?" .

<http://example.org/sen0401/engine/paper#N12/makeup_v2_item6_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Storing the chain for lightweight clients, and signing transactions for wallets" .

<http://example.org/sen0401/engine/paper#N12/makeup_v2_item6_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Rewarding only blocks that follow the consensus rules, and creating new bitcoins on a fixed schedule" .

<http://example.org/sen0401/engine/paper#N12/makeup_v2_item6_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Encrypting the blockchain so that only paying users can read it, and setting the exchange rate at which the next block's coins will be issued" .

<http://example.org/sen0401/engine/paper#N12/makeup_v2_item6_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Choosing the next miner, and collecting taxes on large payments" .

<http://example.org/sen0401/engine/paper#N12/makeup_v2_item7> a pr:ChoiceItem,
