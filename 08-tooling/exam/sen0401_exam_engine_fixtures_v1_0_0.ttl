    pr:position 3 ;
    pr:source <http://example.org/sen0401/engine/paper#N17/midterm_v2_src3> ;
    pr:stem "What makes the Byzantine Generals' Problem hard?" .

<http://example.org/sen0401/engine/paper#N17/midterm_v2_item3_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "The participants have no leader and the network may be unreliable or compromised" .

<http://example.org/sen0401/engine/paper#N17/midterm_v2_item3_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The participants do not share a common language in which to describe the plan" .

<http://example.org/sen0401/engine/paper#N17/midterm_v2_item3_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The participants are too many to be counted" .

<http://example.org/sen0401/engine/paper#N17/midterm_v2_item3_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The messages are too large to be transmitted" .

<http://example.org/sen0401/engine/paper#N17/midterm_v2_item4> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:BlockExplorer:107" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N17/midterm_v2_item4_optA>,
        <http://example.org/sen0401/engine/paper#N17/midterm_v2_item4_optB>,
        <http://example.org/sen0401/engine/paper#N17/midterm_v2_item4_optC>,
        <http://example.org/sen0401/engine/paper#N17/midterm_v2_item4_optD> ;
    pr:position 4 ;
    pr:source <http://example.org/sen0401/engine/paper#N17/midterm_v2_src4> ;
    pr:stem "What may happen when you look up your own transactions in a block explorer?" .

<http://example.org/sen0401/engine/paper#N17/midterm_v2_item4_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The transaction may be relayed twice and counted as a double spend" .

<http://example.org/sen0401/engine/paper#N17/midterm_v2_item4_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The explorer may charge a fee taken from the transaction" .

<http://example.org/sen0401/engine/paper#N17/midterm_v2_item4_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "The operator may be able to guess how many bitcoins you have received, spent and currently own" .

<http://example.org/sen0401/engine/paper#N17/midterm_v2_item4_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Your wallet may be locked until the search has been confirmed by the explorer, because the operator has to check that you control the address" .

