        <http://example.org/sen0401/engine/paper#N20/midterm_v2_item12_optB>,
        <http://example.org/sen0401/engine/paper#N20/midterm_v2_item12_optC>,
        <http://example.org/sen0401/engine/paper#N20/midterm_v2_item12_optD> ;
    pr:position 12 ;
    pr:source <http://example.org/sen0401/engine/paper#N20/midterm_v2_src12> ;
    pr:stem "FIXTURE indirect stem" .

<http://example.org/sen0401/engine/paper#N20/midterm_v2_item12_optA> pr:isKey false ;
