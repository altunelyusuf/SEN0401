    pr:letter "C" ;
    pr:text "Legacy addresses will stop being valid after the next soft fork" .

<http://example.org/sen0401/engine/paper#N15/midterm_v2_item10_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Legacy addresses cannot be used with deterministic wallets" .

<http://example.org/sen0401/engine/paper#N15/midterm_v2_item11> a pr:ChoiceItem,
