    pr:position 2 ;
    pr:source <http://example.org/sen0401/engine/paper#P03/midterm_v2_src2> ;
    pr:stem "Why is a wallet's balance not simply a number stored somewhere?" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item2_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because balances are kept only by the block explorers and never by a wallet, so a wallet has to ask an explorer before it can show a figure" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item2_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because the balance is recomputed by the miners at every block" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item2_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because a balance exists only after six confirmations have passed" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item2_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Because the balance is the sum of the separate unspent outputs the wallet's keys can spend" .

<http://example.org/sen0401/engine/paper#P03/midterm_v2_item3> a pr:Item,
        pr:OrderingItem ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 3 ;
    pr:chapter 2 ;
