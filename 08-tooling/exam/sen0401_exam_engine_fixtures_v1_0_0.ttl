<http://example.org/sen0401/engine/paper#N35/makeup_v2_item18> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 6 ;
    pr:bloomLevel 2 ;
    pr:chapter 6 ;
    pr:itemKey "bank:ch06:ReplaceByFee:77" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N35/makeup_v2_item18_optA>,
        <http://example.org/sen0401/engine/paper#N35/makeup_v2_item18_optB>,
