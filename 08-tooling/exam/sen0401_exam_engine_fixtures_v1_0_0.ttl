    pr:option <http://example.org/sen0401/engine/paper#N31/makeup_v2_item10_optA>,
        <http://example.org/sen0401/engine/paper#N31/makeup_v2_item10_optB>,
        <http://example.org/sen0401/engine/paper#N31/makeup_v2_item10_optC>,
        <http://example.org/sen0401/engine/paper#N31/makeup_v2_item10_optD> ;
    pr:position 10 ;
    pr:source <http://example.org/sen0401/engine/paper#N31/makeup_v2_src10> ;
    pr:stem "The book warns against paper wallets but recommends writing a recovery code on paper. Where is the difference?" .

<http://example.org/sen0401/engine/paper#N31/makeup_v2_item10_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "A recovery code can be used only on the device that made it" .

<http://example.org/sen0401/engine/paper#N31/makeup_v2_item10_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "A recovery code is encrypted and a paper wallet is not" .

<http://example.org/sen0401/engine/paper#N31/makeup_v2_item10_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "A recovery code is shorter than a printed private key, so it is much harder to copy down wrongly, and it can be read aloud" .

<http://example.org/sen0401/engine/paper#N31/makeup_v2_item10_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "A recovery code regenerates a wallet from a trusted device; a paper wallet is one key from an unchecked program" .

