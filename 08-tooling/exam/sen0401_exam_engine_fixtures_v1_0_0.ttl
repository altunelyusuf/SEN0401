    pr:position 8 ;
    pr:source <http://example.org/sen0401/engine/paper#P04/makeup_v2_src8> ;
    pr:stem "Why does the chapter call buying from a friend the least complicated method?" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item8_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "It is the only method with no exchange rate" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item8_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "No company, identity check or account is needed between the two people" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item8_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "It is the only method that needs no wallet" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item8_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The friend is able to reverse the payment afterwards if something goes wrong" .

