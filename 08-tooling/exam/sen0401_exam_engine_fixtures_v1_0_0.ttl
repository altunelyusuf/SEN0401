<http://example.org/sen0401/engine/paper#P06/makeup_v2_item1> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 2 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:MobileWallet:18" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P06/makeup_v2_item1_optA>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item1_optB>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item1_optC>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item1_optD> ;
    pr:position 1 ;
    pr:source <http://example.org/sen0401/engine/paper#P06/makeup_v2_src1> ;
    pr:stem "Why do most mobile wallets reduce their user's privacy?" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item10> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:Segwit:106" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P06/makeup_v2_item10_optA>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item10_optB>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item10_optC>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item10_optD> ;
    pr:position 10 ;
    pr:source <http://example.org/sen0401/engine/paper#P06/makeup_v2_src10> ;
    pr:stem "Why does a valid bech32 address not guarantee that any wallet can pay it?" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item10_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "The paying wallet must also recognise the format, and old wallets do not" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item10_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The address has to be registered with a node before use" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item10_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The address expires when the witness version changes" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item10_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The address is only ever valid on the single network whose name its prefix carries" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item11> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 1 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:PublicKey:12" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P06/makeup_v2_item11_optA>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item11_optB>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item11_optC>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item11_optD> ;
    pr:position 11 ;
    pr:source <http://example.org/sen0401/engine/paper#P06/makeup_v2_src11> ;
    pr:stem "How is a public key obtained from a private key?" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item11_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "By encoding the private key in base58check with the version byte 0x80" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item11_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "By hashing the private key with SHA256 and then with RIPEMD-160" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item11_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "By multiplying the generator point of the curve by the private key" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item11_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "By adding the private key to the order of the curve" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item12> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:DigitalSignature:7" ;
    pr:itemType pr:ChoiceFour ;
