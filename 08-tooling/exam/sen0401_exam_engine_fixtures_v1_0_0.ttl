    pr:position 3 ;
    pr:source <http://example.org/sen0401/engine/paper#N14/midterm_v2_src3> ;
    pr:stem "What makes the Byzantine Generals' Problem hard?" .

<http://example.org/sen0401/engine/paper#N14/midterm_v2_item3_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "The participants have no leader and the network may be unreliable or compromised" .

<http://example.org/sen0401/engine/paper#N14/midterm_v2_item3_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The messages are too large to be transmitted" .

<http://example.org/sen0401/engine/paper#N14/midterm_v2_item3_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The participants do not share a common language in which to describe the plan" .

<http://example.org/sen0401/engine/paper#N14/midterm_v2_item3_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The participants are too many to be counted" .

