        <http://example.org/sen0401/engine/paper#N08/midterm_v2_item10_optD> ;
    pr:position 10 ;
    pr:source <http://example.org/sen0401/engine/paper#N08/midterm_v2_src10> ;
    pr:stem "Why does the book recommend newer address types although it sees no immediate threat to P2SH?" .

<http://example.org/sen0401/engine/paper#N08/midterm_v2_item10_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "A legacy address reveals the public key that stands behind it as soon as the address is created" .

<http://example.org/sen0401/engine/paper#N08/midterm_v2_item10_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Cost, convenience and a theoretical collision risk, which a longer commitment removes" .

<http://example.org/sen0401/engine/paper#N08/midterm_v2_item10_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Legacy addresses will stop being valid after the next soft fork" .

<http://example.org/sen0401/engine/paper#N08/midterm_v2_item10_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Legacy addresses cannot be used with deterministic wallets" .

