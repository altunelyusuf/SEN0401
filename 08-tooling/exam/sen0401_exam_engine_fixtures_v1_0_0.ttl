<http://example.org/sen0401/engine/paper#N23/midterm_v2_item10> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:Legacy:84" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N23/midterm_v2_item10_optA>,
        <http://example.org/sen0401/engine/paper#N23/midterm_v2_item10_optB>,
        <http://example.org/sen0401/engine/paper#N23/midterm_v2_item10_optC>,
