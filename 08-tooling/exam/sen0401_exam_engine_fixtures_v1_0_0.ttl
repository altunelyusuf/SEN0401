        <http://example.org/sen0401/engine/paper#N06/makeup_v2_item2_optC>,
        <http://example.org/sen0401/engine/paper#N06/makeup_v2_item2_optD> ;
    pr:position 2 ;
    pr:source <http://example.org/sen0401/engine/paper#N06/makeup_v2_src2> ;
    pr:stem "Why do most mobile wallets reduce their user's privacy?" .

<http://example.org/sen0401/engine/paper#N06/makeup_v2_item2_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "They fetch information from remote servers, disclosing addresses and balances" .

<http://example.org/sen0401/engine/paper#N06/makeup_v2_item2_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "They publish the user's name together with each payment" .

<http://example.org/sen0401/engine/paper#N06/makeup_v2_item2_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "They sign transactions with a key shared by all users" .

<http://example.org/sen0401/engine/paper#N06/makeup_v2_item2_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "They store a copy of the recovery code on the server of the phone's manufacturer" .

<http://example.org/sen0401/engine/paper#N06/makeup_v2_item3> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 4 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:Privacy:89" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N06/makeup_v2_item3_optA>,
        <http://example.org/sen0401/engine/paper#N06/makeup_v2_item3_optB>,
        <http://example.org/sen0401/engine/paper#N06/makeup_v2_item3_optC>,
        <http://example.org/sen0401/engine/paper#N06/makeup_v2_item3_optD> ;
    pr:position 3 ;
    pr:source <http://example.org/sen0401/engine/paper#N06/makeup_v2_src3> ;
    pr:stem "In what sense is Bitcoin's privacy pseudonymous rather than anonymous?" .

<http://example.org/sen0401/engine/paper#N06/makeup_v2_item3_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Payments are visible only to the miner who includes them" .

<http://example.org/sen0401/engine/paper#N06/makeup_v2_item3_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The payments themselves are hidden, while the names of the two parties are public" .

<http://example.org/sen0401/engine/paper#N06/makeup_v2_item3_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Payments are encrypted and nobody can read them" .

<http://example.org/sen0401/engine/paper#N06/makeup_v2_item3_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Payments are public but attached to addresses, which are names without a person behind them" .

<http://example.org/sen0401/engine/paper#N06/makeup_v2_item4> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 3 ;
    pr:chapter 2 ;
    pr:code "print(sum([75000, 20000, 5000]) == 100000)" ;
    pr:codeLines 1 ;
    pr:codeMaxColumns 42 ;
    pr:itemKey "bank:ch02:DoubleEntryLedger:3" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option <http://example.org/sen0401/engine/paper#N06/makeup_v2_item4_optA>,
        <http://example.org/sen0401/engine/paper#N06/makeup_v2_item4_optB>,
