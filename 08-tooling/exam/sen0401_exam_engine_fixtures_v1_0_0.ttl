    pr:position 12 ;
    pr:source <http://example.org/sen0401/engine/paper#N35/makeup_v2_src12> ;
    pr:stem "Why was the number 1 chosen as the separator instead of a colon?" .

<http://example.org/sen0401/engine/paper#N35/makeup_v2_item12_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "A colon is not allowed in a URI" .

<http://example.org/sen0401/engine/paper#N35/makeup_v2_item12_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "A colon would make the address one character longer" .

<http://example.org/sen0401/engine/paper#N35/makeup_v2_item12_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "A double click selects a whole word up to a colon but not past it" .

<http://example.org/sen0401/engine/paper#N35/makeup_v2_item12_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The number 1 is the first character of the bech32 alphabet" .

