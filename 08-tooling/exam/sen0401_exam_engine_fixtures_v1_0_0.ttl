    pr:letter "B" ;
    pr:text "Replacement requires a hard fork" .

<http://example.org/sen0401/engine/paper#N12/makeup_v2_item18_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Replacement became opt-in, signalled through the sequence field" .

<http://example.org/sen0401/engine/paper#N12/makeup_v2_item18_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Only miners may replace" .

<http://example.org/sen0401/engine/paper#N12/makeup_v2_item1_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Identity verification and fraud investigation" .

<http://example.org/sen0401/engine/paper#N12/makeup_v2_item1_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Currency issuance and the clearing of transactions" .

<http://example.org/sen0401/engine/paper#N12/makeup_v2_item1_optC> pr:isKey false ;
    pr:letter "C" ;
