    pr:position 1 ;
    pr:source <http://example.org/sen0401/engine/paper#P02/makeup_v2_src1> ;
    pr:stem "What limits the chapter puts on the word borderless?" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item10> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:Secp256k1:27" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P02/makeup_v2_item10_optA>,
        <http://example.org/sen0401/engine/paper#P02/makeup_v2_item10_optB>,
        <http://example.org/sen0401/engine/paper#P02/makeup_v2_item10_optC>,
        <http://example.org/sen0401/engine/paper#P02/makeup_v2_item10_optD> ;
    pr:position 10 ;
    pr:source <http://example.org/sen0401/engine/paper#P02/makeup_v2_src10> ;
    pr:stem "The book says the secp256k1 curve was established by NIST. What do the primary sources show?" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item10_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "It has no written standard, only an implementation in libsecp256k1" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item10_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "It was established by the Bitcoin developers and was later adopted unchanged by NIST" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item10_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "It is defined in SEC 2 by Certicom Research, which marks it as not on the NIST list" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item10_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "It was established by NIST in 2010 together with secp256r1" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item11> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 2 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:Address:73" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P02/makeup_v2_item11_optA>,
        <http://example.org/sen0401/engine/paper#P02/makeup_v2_item11_optB>,
        <http://example.org/sen0401/engine/paper#P02/makeup_v2_item11_optC>,
        <http://example.org/sen0401/engine/paper#P02/makeup_v2_item11_optD> ;
    pr:position 11 ;
    pr:source <http://example.org/sen0401/engine/paper#P02/makeup_v2_src11> ;
    pr:stem "What is an address, in the terms this chapter uses?" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item11_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "A number that the network assigns to each user once" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item11_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The public key of the receiver of the payment, written out in hexadecimal digits" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item11_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "An account at a wallet provider that holds a balance" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item11_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "A short string from which a payer's wallet can build the right output script" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item12> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:Address:74" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P02/makeup_v2_item12_optA>,
        <http://example.org/sen0401/engine/paper#P02/makeup_v2_item12_optB>,
        <http://example.org/sen0401/engine/paper#P02/makeup_v2_item12_optC>,
        <http://example.org/sen0401/engine/paper#P02/makeup_v2_item12_optD> ;
    pr:position 12 ;
    pr:source <http://example.org/sen0401/engine/paper#P02/makeup_v2_src12> ;
    pr:stem "Why is a valid address no promise that the coins sent to it can be spent?" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item12_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Addresses expire after a fixed number of blocks" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item12_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "A wallet accepts a well-formed address even if its owner has lost the key" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item12_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The nodes verify the identity of the owner before they accept a payment to the address" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item12_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "An address can be used only once before it becomes invalid" .

