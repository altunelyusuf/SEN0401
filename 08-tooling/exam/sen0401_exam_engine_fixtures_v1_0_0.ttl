    pr:position 7 ;
    pr:source <http://example.org/sen0401/engine/paper#P06/makeup_v2_src7> ;
    pr:stem "A pruned node deletes old block files. Is it still a full node, and why?" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item7_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "No, a node that has discarded any block can no longer validate what it receives" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item7_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "No, because the word full means that every block is stored forever" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item7_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Yes, but only after a lightweight client confirms each block that was deleted" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item7_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Yes, it still verifies the whole chain and only keeps the most recent blocks" .

