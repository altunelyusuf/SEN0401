    pr:position 7 ;
    pr:source <http://example.org/sen0401/engine/paper#P02/makeup_v2_src7> ;
    pr:stem "Does a salt have to be secret?" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item7_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Yes, because anyone who knows it can compute the password" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item7_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "No, because it is the same for all users and so cannot protect anyone" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item7_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "No, it is stored in the open, but it must be random and different for each credential" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item7_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Yes, which is why it is kept in memory and never in the file" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item8> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
