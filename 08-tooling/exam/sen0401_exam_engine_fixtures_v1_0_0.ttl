        <http://example.org/sen0401/engine/paper#N24/makeup_v2_item18_optD> ;
    pr:position 18 ;
    pr:source <http://example.org/sen0401/engine/paper#N24/makeup_v2_src18> ;
    pr:stem "What compromise let replacement return to Bitcoin Core?" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item18_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Replacement was limited to coinbase transactions" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item18_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Replacement requires a hard fork" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item18_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Replacement became opt-in, signalled through the sequence field" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item18_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Only miners may replace" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item1_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Identity verification and fraud investigation" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item1_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Currency issuance and the clearing of transactions" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item1_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Printing the banknotes of a country and setting the interest rate for its banks" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item1_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Lending to banks and holding foreign reserves" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item2> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 2 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:MobileWallet:18" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N24/makeup_v2_item2_optA>,
        <http://example.org/sen0401/engine/paper#N24/makeup_v2_item2_optB>,
        <http://example.org/sen0401/engine/paper#N24/makeup_v2_item2_optC>,
        <http://example.org/sen0401/engine/paper#N24/makeup_v2_item2_optD> ;
    pr:position 2 ;
    pr:source <http://example.org/sen0401/engine/paper#N24/makeup_v2_src2> ;
    pr:stem "Why do most mobile wallets reduce their user's privacy?" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item2_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "They fetch information from remote servers, disclosing addresses and balances" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item2_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "They publish the user's name together with each payment" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item2_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "They sign transactions with a key shared by all users" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item2_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "They store a copy of the recovery code on the server of the phone's manufacturer" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item3> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 4 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:Privacy:89" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N24/makeup_v2_item3_optA>,
        <http://example.org/sen0401/engine/paper#N24/makeup_v2_item3_optB>,
        <http://example.org/sen0401/engine/paper#N24/makeup_v2_item3_optC>,
        <http://example.org/sen0401/engine/paper#N24/makeup_v2_item3_optD> ;
    pr:position 3 ;
    pr:source <http://example.org/sen0401/engine/paper#N24/makeup_v2_src3> ;
    pr:stem "In what sense is Bitcoin's privacy pseudonymous rather than anonymous?" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item3_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Payments are visible only to the miner who includes them" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item3_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The payments themselves are hidden, while the names of the two parties are public" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item3_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Payments are encrypted and nobody can read them" .

<http://example.org/sen0401/engine/paper#N24/makeup_v2_item3_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Payments are public but attached to addresses, which are names without a person behind them" .

