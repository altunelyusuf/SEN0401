    pr:letter "C" ;
    pr:text "A public key is long and error-prone to dictate or copy" .

<http://example.org/sen0401/engine/paper#N17/midterm_v2_item11_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Nodes reject outputs that contain a public key in any form" .

