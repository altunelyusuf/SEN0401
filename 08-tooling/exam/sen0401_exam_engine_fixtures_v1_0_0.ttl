<http://example.org/sen0401/engine/paper#N10/makeup_v2_item15_resp0> a pr:Response ;
    pr:letter "A" ;
    pr:text "Because the choice of inputs, the change and the fee are decisions of the software, not of the user" .

<http://example.org/sen0401/engine/paper#N10/makeup_v2_item15_resp1> a pr:Response ;
    pr:letter "B" ;
    pr:text "Making its public key and address and signing to spend what was paid there" .

