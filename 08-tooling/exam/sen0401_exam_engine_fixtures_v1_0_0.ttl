<http://example.org/sen0401/engine/paper#N05/makeup_v2_item6> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 1 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:Mining:110" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N05/makeup_v2_item6_optA>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item6_optB>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item6_optC>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item6_optD> ;
    pr:position 6 ;
    pr:source <http://example.org/sen0401/engine/paper#N05/makeup_v2_src6> ;
    pr:stem "Which two purposes does mining serve?" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item6_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Storing the chain for lightweight clients, and signing transactions for wallets" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item6_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Rewarding only blocks that follow the consensus rules, and creating new bitcoins on a fixed schedule" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item6_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Encrypting the blockchain so that only paying users can read it, and setting the exchange rate at which the next block's coins will be issued" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item6_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Choosing the next miner, and collecting taxes on large payments" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item7> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
    pr:bloomLevel 1 ;
    pr:chapter 3 ;
    pr:itemKey "bank:ch03:NetworkInfo:97" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N05/makeup_v2_item7_optA>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item7_optB>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item7_optC>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item7_optD> ;
    pr:position 7 ;
    pr:source <http://example.org/sen0401/engine/paper#N05/makeup_v2_src7> ;
    pr:stem "How is the client version 310100 of release 31.1.0 formed?" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item7_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "10000 times the major number plus 100 times the minor number plus the build number" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item7_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The three numbers written one after another without separators" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item7_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The number of blocks in the chain when the release was tagged" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item7_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The count of commits in the repository at the time of the release" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item8> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
    pr:bloomLevel 4 ;
    pr:chapter 3 ;
    pr:itemKey "bank:ch03:RpcAuth:131" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N05/makeup_v2_item8_optA>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item8_optB>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item8_optC>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item8_optD> ;
    pr:position 8 ;
    pr:source <http://example.org/sen0401/engine/paper#N05/makeup_v2_src8> ;
    pr:stem "Why does the hashed credential protect the file but not the connection?" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item8_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The connection is encrypted by default, but the file can be read by everybody" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item8_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "The file holds only a salted hash, but the client still sends the password in every request" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item8_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The hash is checked by the client, so the server never sees the password" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item8_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The file is encrypted, but the hash is sent to the server in place of the password every time" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item9> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
    pr:bloomLevel 4 ;
    pr:chapter 3 ;
    pr:itemKey "bank:ch03:FullNode:3" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N05/makeup_v2_item9_optA>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item9_optB>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item9_optC>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item9_optD> ;
    pr:position 9 ;
    pr:source <http://example.org/sen0401/engine/paper#N05/makeup_v2_src9> ;
    pr:stem "A pruned node deletes old block files. Is it still a full node, and why?" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item9_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "No, because the word full means that every block is stored forever" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item9_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "No, a node that has discarded any block can no longer validate what it receives" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item9_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Yes, it still verifies the whole chain and only keeps the most recent blocks" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item9_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Yes, but only after a lightweight client confirms each block that was deleted" .

