    pr:letter "D" ;
    pr:text "They store a copy of the recovery code on the server of the phone's manufacturer" .

<http://example.org/sen0401/engine/paper#N03/makeup_v2_item3> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
