    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N11/makeup_v2_item7_optA>,
        <http://example.org/sen0401/engine/paper#N11/makeup_v2_item7_optB>,
        <http://example.org/sen0401/engine/paper#N11/makeup_v2_item7_optC>,
