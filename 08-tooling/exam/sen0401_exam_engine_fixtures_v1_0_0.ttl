    pr:position 1 ;
    pr:source <http://example.org/sen0401/engine/paper#N27/makeup_v2_src1> ;
    pr:stem "Which two functions of a central bank does mining take over, according to the chapter?" .

<http://example.org/sen0401/engine/paper#N27/makeup_v2_item10> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:PaperWallet:158" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N27/makeup_v2_item10_optA>,
        <http://example.org/sen0401/engine/paper#N27/makeup_v2_item10_optB>,
        <http://example.org/sen0401/engine/paper#N27/makeup_v2_item10_optC>,
        <http://example.org/sen0401/engine/paper#N27/makeup_v2_item10_optD> ;
    pr:position 10 ;
    pr:source <http://example.org/sen0401/engine/paper#N27/makeup_v2_src10> ;
    pr:stem "The book warns against paper wallets but recommends writing a recovery code on paper. Where is the difference?" .

<http://example.org/sen0401/engine/paper#N27/makeup_v2_item10_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "A recovery code can be used only on the device that made it" .

<http://example.org/sen0401/engine/paper#N27/makeup_v2_item10_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "A recovery code is encrypted and a paper wallet is not" .

<http://example.org/sen0401/engine/paper#N27/makeup_v2_item10_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "A recovery code is shorter than a printed private key, so it is much harder to copy down wrongly, and it can be read aloud" .

<http://example.org/sen0401/engine/paper#N27/makeup_v2_item10_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "A recovery code regenerates a wallet from a trusted device; a paper wallet is one key from an unchecked program" .

<http://example.org/sen0401/engine/paper#N27/makeup_v2_item11> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:WitnessVersion:117" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N27/makeup_v2_item11_optA>,
        <http://example.org/sen0401/engine/paper#N27/makeup_v2_item11_optB>,
        <http://example.org/sen0401/engine/paper#N27/makeup_v2_item11_optC>,
        <http://example.org/sen0401/engine/paper#N27/makeup_v2_item11_optD> ;
    pr:position 11 ;
    pr:source <http://example.org/sen0401/engine/paper#N27/makeup_v2_src11> ;
    pr:stem "Which mistake does the book warn about when turning an address into an output script?" .

<http://example.org/sen0401/engine/paper#N27/makeup_v2_item11_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "Writing version 1 as the byte 0x01 instead of the opcode byte 0x51" .

<http://example.org/sen0401/engine/paper#N27/makeup_v2_item11_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Writing the version after the program instead of before it" .

<http://example.org/sen0401/engine/paper#N27/makeup_v2_item11_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Leaving out the length byte before the program" .

<http://example.org/sen0401/engine/paper#N27/makeup_v2_item11_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Writing the version in decimal instead of hexadecimal" .

