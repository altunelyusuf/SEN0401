<http://example.org/sen0401/engine/paper#P05/makeup_v2_item1> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 4 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:BitcoinAddress:26" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item1_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item1_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item1_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item1_optD> ;
    pr:position 1 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src1> ;
    pr:stem "Why can an address be shared without risking the funds behind it?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item10> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
    pr:bloomLevel 4 ;
    pr:chapter 3 ;
    pr:itemKey "bank:ch03:MedianTimePast:195" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item10_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item10_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item10_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item10_optD> ;
    pr:position 10 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src10> ;
    pr:stem "Why did BIP 113 make the median time the time that time locks use?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item10_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Miners may no longer set timestamps, so only the median is left" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item10_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "A median is always later than the clock, so time locks open sooner" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item10_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "The median of eleven blocks is hard for one miner to move, so the incentive to lie disappears" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item10_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "A trusted time server computes the median and signs it" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item11> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
    pr:bloomLevel 4 ;
    pr:chapter 3 ;
    pr:itemKey "bank:ch03:RpcAuth:131" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item11_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item11_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item11_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item11_optD> ;
    pr:position 11 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src11> ;
    pr:stem "Why does the hashed credential protect the file but not the connection?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item11_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The connection is encrypted by default, but the file can be read by everybody" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item11_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "The file holds only a salted hash, but the client still sends the password in every request" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item11_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The file is encrypted, but the hash is sent to the server in place of the password every time" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item11_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The hash is checked by the client, so the server never sees the password" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item12> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:Modern:143" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item12_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item12_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item12_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item12_optD> ;
    pr:position 12 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src12> ;
    pr:stem "What changed when wallets moved from independent keys to a single seed?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item12_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Keys became shorter, so addresses became shorter too" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item12_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Keys no longer need to be random, because the seed is" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item12_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "One backup covers every key, but exporting one key endangers the others" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item12_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Backups became quite unnecessary, because the seed itself is kept on the blockchain" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item13> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:Legacy:84" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item13_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item13_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item13_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item13_optD> ;
    pr:position 13 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src13> ;
    pr:stem "Why does the book recommend newer address types although it sees no immediate threat to P2SH?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item13_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Legacy addresses will stop being valid after the next soft fork" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item13_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "A legacy address reveals the public key that stands behind it as soon as the address is created" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item13_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Cost, convenience and a theoretical collision risk, which a longer commitment removes" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item13_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Legacy addresses cannot be used with deterministic wallets" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item14> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:KeyControlProof:170" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item14_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item14_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item14_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item14_optD> ;
    pr:position 14 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src14> ;
    pr:stem "What does proof of control not establish?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item14_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "That the prover holds the private key" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item14_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "That the message was not altered" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item14_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "That the signature really matches the public key that was given" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item14_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Who the prover is, or that the key is the one the verifier meant" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item15> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 4 ;
    pr:chapter 5 ;
    pr:itemKey "bank:ch05:RecoveryPassphrase:31" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item15_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item15_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item15_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item15_optD> ;
    pr:position 15 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src15> ;
    pr:stem "A user mistypes their passphrase during a restoration. What does the wallet show?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item15_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "An error, because the checksum covers the passphrase" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item15_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "A valid but empty wallet, with no warning that anything is wrong" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item15_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The right balance, since the passphrase is only a second factor" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item15_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "A warning that the passphrase may be wrong" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item16> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 4 ;
    pr:chapter 5 ;
    pr:itemKey "bank:ch05:ExtendedPrivateKey:93" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item16_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item16_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item16_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item16_optD> ;
    pr:position 16 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src16> ;
    pr:stem "An xprv has depth 1 and a parent fingerprint that is not zero. What does that tell a reader?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item16_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "It is a master key with a random fingerprint" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item16_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "It is a level-1 child, not a master key" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item16_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "It carries no chain code" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item16_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "It belongs to a testnet wallet" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item17> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 4 ;
    pr:chapter 5 ;
    pr:itemKey "bank:ch05:ShaAlgorithm:175" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item17_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item17_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item17_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item17_optD> ;
    pr:position 17 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src17> ;
    pr:stem "Why is a BIP32 chain code 32 bytes and a BIP39 seed 64?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item17_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because a chain code is half a private key" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item17_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Because HMAC-SHA512 produces 64 bytes, which BIP32 splits in half and BIP39 keeps whole" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item17_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because base58check can encode no more" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item17_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Because the standards chose round decimal numbers that are easy for a reader to remember" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item18> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 6 ;
    pr:bloomLevel 2 ;
    pr:chapter 6 ;
    pr:itemKey "bank:ch06:TransactionIdea:1" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item18_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item18_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item18_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item18_optD> ;
    pr:position 18 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src18> ;
    pr:stem "What are the three ideas a reader needs before the bytes of a transaction make sense?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item18_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The price, the exchange and the wallet" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item18_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The private key, the seed and the recovery code" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item18_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The miner, the block and the difficulty" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item18_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "The transaction as a request, the ownership record it changes, and the parts every transaction has" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item19> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 6 ;
    pr:bloomLevel 2 ;
    pr:chapter 6 ;
    pr:itemKey "bank:ch06:HardFork:139" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item19_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item19_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item19_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item19_optD> ;
    pr:position 19 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src19> ;
    pr:stem "What makes a change a hard fork?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item19_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "It adds a new opcode" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item19_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Older full nodes would reject blocks that newer nodes accept" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item19_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "It is proposed in a BIP" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item19_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "It changes the subsidy" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item1_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "Because spending requires the private key, and only the owner can start a spend" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item1_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because the network refuses payments from strangers" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item1_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because the address is encrypted by the wallet before it is shared with anyone" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item1_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Because the address expires after one payment" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item2> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 4 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:IdentityVerification:109" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item2_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item2_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item2_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item2_optD> ;
    pr:position 2 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src2> ;
    pr:stem "Why do companies that sell bitcoin for card payments demand identity checks?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item20> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 6 ;
    pr:bloomLevel 3 ;
    pr:chapter 6 ;
    pr:code "print(0x6b)" ;
    pr:codeLines 1 ;
    pr:codeMaxColumns 11 ;
    pr:itemKey "bank:ch06:LengthPrefix:66" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item20_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item20_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item20_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item20_optD> ;
    pr:position 20 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src20> ;
    pr:stem "What script length does the prefix byte 0x6b announce?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item20_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "11" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item20_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "6" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item20_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "171" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item20_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "107" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item2_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because the protocol itself requires a verified identity for every address that is used" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item2_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because the exchange rate depends on the buyer's country" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item2_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Because the card payment can be reversed after the irreversible bitcoin has been sent" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item2_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Because the miners refuse transactions from unknown senders" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item3> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 4 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:ByzantineGeneralsProblem:63" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item3_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item3_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item3_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item3_optD> ;
    pr:position 3 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src3> ;
    pr:stem "What makes the Byzantine Generals' Problem hard?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item3_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The participants do not share a common language in which to describe the plan" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item3_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The participants are too many to be counted" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item3_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The messages are too large to be transmitted" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item3_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "The participants have no leader and the network may be unreliable or compromised" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item4> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 4 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:Checksum:122" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item4_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item4_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item4_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item4_optD> ;
    pr:position 4 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src4> ;
    pr:stem "What can a checksum do and what can it not do?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item4_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "It detects accidental changes but does not stop an attacker who recomputes it" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item4_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "It hides the contents of the data from anyone who happens to read it" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item4_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "It proves who wrote the data" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item4_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "It corrects any single error in the data" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item5> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:TransactionConstruction:82" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item5_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item5_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item5_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item5_optD> ;
    pr:position 5 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src5> ;
    pr:stem "What can go wrong when a wallet builds a transaction while offline?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item5_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "Its inputs may already have been spent, because it does not know the current state of the network" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item5_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "It must leave the fee out, because fee rates are unknown offline" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item5_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "It cannot compute the change, because the exchange rate is unavailable" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item5_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "It cannot sign the transaction at all, because the signature has to commit to the height of the newest block and that height is only known online" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item6> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:Consolidation:61" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item6_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item6_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item6_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item6_optD> ;
    pr:position 6 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src6> ;
    pr:stem "What does a consolidation cost its owner, beyond the fee?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item6_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "Privacy, because spending many inputs together suggests that one owner controls them all" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item6_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The change output, which a consolidation cannot have" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item6_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The ability to spend the single output for the next hundred blocks, because the rules treat a consolidation like a coinbase output until it matures" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item6_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The right to use the same addresses again" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item7> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:UnspentOutput:14" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item7_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item7_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item7_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item7_optD> ;
    pr:position 7 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src7> ;
    pr:stem "Why is a wallet's balance not simply a number stored somewhere?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item7_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because balances are kept only by the block explorers and never by a wallet, so a wallet has to ask an explorer before it can show a figure" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item7_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because a balance exists only after six confirmations have passed" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item7_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because the balance is recomputed by the miners at every block" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item7_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Because the balance is the sum of the separate unspent outputs the wallet's keys can spend" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item8> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:SpendingOnward:159" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item8_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item8_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item8_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item8_optD> ;
    pr:position 8 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src8> ;
    pr:stem "Why does spending onward need more than the public record?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item8_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because the earlier transaction must be signed again by its payer" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item8_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because the output has to be registered again with a full node before it can be used, which is the step that makes it spendable by its new owner" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item8_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Because only the holder of the key that satisfies the output's script can spend it" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item8_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Because the amount must be converted into satoshis by the explorer" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item9> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
    pr:bloomLevel 4 ;
    pr:chapter 3 ;
    pr:itemKey "bank:ch03:DescriptorWallet:102" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/makeup_v2_item9_optA>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item9_optB>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item9_optC>,
        <http://example.org/sen0401/engine/paper#P05/makeup_v2_item9_optD> ;
    pr:position 9 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/makeup_v2_src9> ;
    pr:stem "Why does the demo wallet have a key pool of 4000 for receiving?" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item9_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "Four kinds of script each cover the range 0 to 999, which makes 1000 keys for each kind" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item9_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "It holds 4000 transactions that wait for their confirmation" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item9_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "It holds 4000 blocks that are to be scanned for payments" .

<http://example.org/sen0401/engine/paper#P05/makeup_v2_item9_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "It reserves 4000 bytes for the encrypted passphrase" .

