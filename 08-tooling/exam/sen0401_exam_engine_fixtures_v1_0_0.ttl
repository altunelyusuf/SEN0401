    pr:letter "C" ;
    pr:text "They sign transactions with a key shared by all users" .

<http://example.org/sen0401/engine/paper#N18/makeup_v2_item2_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "They store a copy of the recovery code on the server of the phone's manufacturer" .

<http://example.org/sen0401/engine/paper#N18/makeup_v2_item3> a pr:ChoiceItem,
