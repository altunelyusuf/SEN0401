<http://example.org/sen0401/engine/paper#N27/makeup_v2_item1_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Lending to banks and holding foreign reserves" .

<http://example.org/sen0401/engine/paper#N27/makeup_v2_item2> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 2 ;
    pr:chapter 1 ;
