<http://example.org/sen0401/engine/paper#P02/makeup_v2_item15> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 4 ;
    pr:chapter 5 ;
    pr:itemKey "bank:ch05:AddressIndex:112" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P02/makeup_v2_item15_optA>,
        <http://example.org/sen0401/engine/paper#P02/makeup_v2_item15_optB>,
        <http://example.org/sen0401/engine/paper#P02/makeup_v2_item15_optC>,
        <http://example.org/sen0401/engine/paper#P02/makeup_v2_item15_optD> ;
    pr:position 15 ;
    pr:source <http://example.org/sen0401/engine/paper#P02/makeup_v2_src15> ;
    pr:stem "Why can a restored wallet not tell how far the address index had advanced?" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item15_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because the index of each address is recorded only on the blockchain and not in the wallet" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item15_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Because nothing in an address shows its position, so the wallet must scan and guess" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item15_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because the index is hardened" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item15_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Because indices are random rather than sequential" .

