    pr:letter "C" ;
    pr:text "Sight of the receiving addresses only, since the change addresses hang from another branch" .

<http://example.org/sen0401/engine/paper#N30/makeup_v2_item14_optD> pr:isKey true ;
    pr:letter "D" ;
