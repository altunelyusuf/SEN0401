    pr:stem "What compromise let replacement return to Bitcoin Core?" .

<http://example.org/sen0401/engine/paper#N36/makeup_v2_item18_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Replacement was limited to coinbase transactions" .

<http://example.org/sen0401/engine/paper#N36/makeup_v2_item18_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Replacement requires a hard fork" .

<http://example.org/sen0401/engine/paper#N36/makeup_v2_item18_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Replacement became opt-in, signalled through the sequence field" .

<http://example.org/sen0401/engine/paper#N36/makeup_v2_item18_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Only miners may replace" .

<http://example.org/sen0401/engine/paper#N36/makeup_v2_item1_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Identity verification and fraud investigation" .

<http://example.org/sen0401/engine/paper#N36/makeup_v2_item1_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Currency issuance and the clearing of transactions" .

<http://example.org/sen0401/engine/paper#N36/makeup_v2_item1_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Printing the banknotes of a country and setting the interest rate for its banks" .

<http://example.org/sen0401/engine/paper#N36/makeup_v2_item1_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Lending to banks and holding foreign reserves" .

<http://example.org/sen0401/engine/paper#N36/makeup_v2_item2> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 2 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:MobileWallet:18" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N36/makeup_v2_item2_optA>,
        <http://example.org/sen0401/engine/paper#N36/makeup_v2_item2_optB>,
