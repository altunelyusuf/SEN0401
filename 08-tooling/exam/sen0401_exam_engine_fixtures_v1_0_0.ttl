    pr:position 14 ;
    pr:source <http://example.org/sen0401/engine/paper#N29/makeup_v2_src14> ;
    pr:stem "A merchant gives an auditor the account's extended public key. What has the auditor gained?" .

<http://example.org/sen0401/engine/paper#N29/makeup_v2_item14_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The power to spend from the account" .

<http://example.org/sen0401/engine/paper#N29/makeup_v2_item14_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Nothing, since the key is public" .

<http://example.org/sen0401/engine/paper#N29/makeup_v2_item14_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Sight of the receiving addresses only, since the change addresses hang from another branch" .

<http://example.org/sen0401/engine/paper#N29/makeup_v2_item14_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Sight of every payment of that account, in and out, and no power to spend" .

