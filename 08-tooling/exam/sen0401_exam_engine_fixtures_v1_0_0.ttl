    pr:text "True" .

<http://example.org/sen0401/engine/paper#N34/makeup_v2_item4_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "95000" .

<http://example.org/sen0401/engine/paper#N34/makeup_v2_item4_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "100000" .

