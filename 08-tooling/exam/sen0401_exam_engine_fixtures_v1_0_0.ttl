    pr:position 18 ;
    pr:source <http://example.org/sen0401/engine/paper#N21/makeup_v2_src18> ;
    pr:stem "What compromise let replacement return to Bitcoin Core?" .

<http://example.org/sen0401/engine/paper#N21/makeup_v2_item18_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Replacement was limited to coinbase transactions" .

