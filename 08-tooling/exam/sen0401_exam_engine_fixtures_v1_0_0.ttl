    pr:itemKey "bank:ch01:Phishing:157" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item1_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item1_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item1_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item1_optD> ;
    pr:position 1 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src1> ;
    pr:stem "When is a request for a recovery code a sign of phishing?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item10> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
    pr:bloomLevel 4 ;
    pr:chapter 3 ;
    pr:itemKey "bank:ch03:BlockHeader:177" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item10_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item10_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item10_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item10_optD> ;
    pr:position 10 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src10> ;
    pr:stem "Why can a program that holds only the headers follow the chain and its work?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item10_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "The header commits to the transactions through the Merkle root and to the work through the target" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item10_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The header contains the signatures of all the transactions in the block" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item10_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The header holds the height of every block that the node stores" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item10_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The header includes the full list of transaction identifiers" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item11> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
    pr:bloomLevel 4 ;
    pr:chapter 3 ;
    pr:itemKey "bank:ch03:UtxoSet:25" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item11_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item11_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item11_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item11_optD> ;
    pr:position 11 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src11> ;
    pr:stem "Why is the set of unspent outputs not a list of balances?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item11_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "It is stored inside each block header, so a separate list of balances would duplicate it" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item11_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "It holds only the outputs of the wallet in the node, and a wallet has a single balance" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item11_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "It is rebuilt for each block, so no amount stays stored between two blocks" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item11_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "It holds outputs, and what a wallet owns is the sum of the outputs it can spend" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item12> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:OutputScript:77" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item12_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item12_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item12_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item12_optD> ;
    pr:position 12 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src12> ;
    pr:stem "Why does the book warn against assembling a P2SH output script by hand?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item12_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "Anything but the exact template makes the coins unspendable or spendable by anyone" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item12_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The script must be signed by the receiver before it can be used" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item12_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "A hand-written script cannot be encoded as an address" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item12_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "A script written by hand is rejected by the relay policy of every node on the network" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item13> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:Bech32Address:114" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item13_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item13_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item13_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item13_optD> ;
    pr:position 13 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src13> ;
    pr:stem "Which four characters does the bech32 alphabet leave out, and why?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item13_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "One, b, i and o, because they resemble other characters" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item13_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The digits 1, 2, 3 and 4, which are reserved for the version" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item13_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Zero, O, l and I, as base58 does" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item13_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The vowels a, e, i and o, so that no address spells a word" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item14> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:Address:74" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item14_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item14_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item14_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item14_optD> ;
    pr:position 14 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src14> ;
    pr:stem "Why is a valid address no promise that the coins sent to it can be spent?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item14_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The nodes verify the identity of the owner before they accept a payment to the address" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item14_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "An address can be used only once before it becomes invalid" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item14_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "A wallet accepts a well-formed address even if its owner has lost the key" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item14_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Addresses expire after a fixed number of blocks" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item15> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 4 ;
    pr:chapter 5 ;
    pr:itemKey "bank:ch05:RootSeed:61" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item15_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item15_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item15_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item15_optD> ;
    pr:position 15 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src15> ;
    pr:stem "A wallet asks for a seed in hexadecimal and the user types their twelve words. Why does that fail?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item15_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The wallet needs the entropy, which the words do not encode" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item15_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "The words are not the seed; the seed is the stretched output and the mapping is one-way" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item15_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The words are the seed, but in the wrong base" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item15_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The seed must be 256 bits and the words give 512" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item16> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 4 ;
    pr:chapter 5 ;
    pr:itemKey "bank:ch05:XpubDeployment:160" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item16_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item16_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item16_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item16_optD> ;
    pr:position 16 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src16> ;
    pr:stem "A shop's server is taken over. What can the attacker steal, and what not?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item16_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Nothing, because the key is public" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item16_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Future payments only, not those already received" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item16_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Everything the account ever received" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item16_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The account's private keys" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item17> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 4 ;
    pr:chapter 5 ;
    pr:itemKey "bank:ch05:Bip39Code:19" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item17_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item17_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item17_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item17_optD> ;
    pr:position 17 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src17> ;
    pr:stem "Which shortcoming does BIP39 itself list that a version number would have removed?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item17_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The word list changes with every release" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item17_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The checksum covers the passphrase and so cannot be checked" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item17_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Software cannot tell which derivation a code belongs to, so it may show an empty wallet" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item17_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The code is too long to write down" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item18> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 6 ;
    pr:bloomLevel 2 ;
    pr:chapter 6 ;
    pr:itemKey "bank:ch06:VersionMarkerFlag:19" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item18_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item18_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item18_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item18_optD> ;
    pr:position 18 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src18> ;
    pr:stem "Why do six bytes deserve a branch of their own?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item18_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "They carry the fee" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item18_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "They are the only bytes a miner reads" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item18_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "They identify the sender" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item18_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "They decide which rules apply to everything that follows and which layout the bytes are in" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item19> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 6 ;
    pr:bloomLevel 2 ;
    pr:chapter 6 ;
    pr:itemKey "bank:ch06:UtxoDatabase:53" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item19_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item19_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item19_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item19_optD> ;
    pr:position 19 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src19> ;
    pr:stem "What does Bitcoin Core do to its UTXO database when a new block arrives?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item19_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Adds the block header only" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item19_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Stores the block's transactions as text" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item19_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Deletes everything and rebuilds from the genesis block" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item19_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Removes the outputs the block's transactions spend and adds the outputs they create" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item1_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Only in the case where the request for it arrives by electronic mail" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item1_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "At any time other than the first set-up and a genuine recovery" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item1_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Only when the user has no bitcoin yet" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item1_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Only when the wallet is custodial" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item2> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 4 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:Timestamp:133" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item2_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item2_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item2_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item2_optD> ;
    pr:position 2 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src2> ;
    pr:stem "What does a block's timestamp prove, and what does it not prove?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item20> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 6 ;
    pr:bloomLevel 2 ;
    pr:chapter 6 ;
    pr:itemKey "bank:ch06:DisplayByteOrder:60" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item20_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item20_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item20_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item20_optD> ;
    pr:position 20 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src20> ;
    pr:stem "What is the practical lesson about byte order for developers?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item20_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Explorers use internal order" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item20_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Users must type identifiers backwards" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item20_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Block hashes are not reversed" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item20_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Developers must remember to reverse the bytes of identifiers they show to users" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item2_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "That the fee was paid before the block was found" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item2_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "That the data was marked at that time, not that the event happened then" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item2_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "That the block was accepted by the network" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item2_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "That the miner was honest about the transactions that the block contains" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item3> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 4 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:Irreversibility:99" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item3_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item3_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item3_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item3_optD> ;
    pr:position 3 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src3> ;
    pr:stem "Why does irreversibility make it hard to buy bitcoin with a credit card?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item3_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "The seller cannot undo the bitcoin payment if the card payment is reversed afterwards" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item3_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The seller must pay the fee of both payments" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item3_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The bitcoin transaction takes considerably longer to arrive than the card payment" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item3_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Credit card networks refuse to carry bitcoin payments" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item4> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 4 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:WalletMetadata:83" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item4_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item4_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item4_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item4_optD> ;
    pr:position 4 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src4> ;
    pr:stem "What does the chapter say a recovery code will not restore?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item4_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The transactions recorded in the chain that the wallet had already received" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item4_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The private keys of the wallet" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item4_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "The labels and other data the user entered, such as the name of each payee" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item4_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The addresses the wallet had generated" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item5> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:Output:6" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item5_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item5_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item5_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item5_optD> ;
    pr:position 5 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src5> ;
    pr:stem "Why can outputs of very small value become a problem?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item5_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "They are deleted by the network after a fixed number of blocks" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item5_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "They can be uneconomical to spend and still burden every node that must track them" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item5_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "They cannot be spent at all, because the protocol forbids amounts below one satoshi" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item5_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "They are counted twice in the fee, so spending them costs double" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item6> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:Outpoint:24" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item6_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item6_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item6_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item6_optD> ;
    pr:position 6 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src6> ;
    pr:stem "Why does an outpoint not say who may spend the output it names?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item6_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because the owner's address is stored in the input script instead" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item6_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because ownership is recorded separately in each node's database of balances" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item6_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Because the spending condition lives in the script of the output, not in the reference to it" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item6_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Because the outpoint is hashed, so the owner cannot be read from it" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item7> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:TransactionSize:10" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item7_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item7_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item7_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item7_optD> ;
    pr:position 7 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src7> ;
    pr:stem "Why do the three size figures of a transaction answer different questions?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item7_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The byte size is the figure that wallets display, the weight is the figure that block explorers index, and the virtual byte is reserved for the fee estimates that miners publish" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item7_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The three are the same number written in three notations, so any one of them can be used" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item7_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The byte size includes the witness, the weight excludes it and the vbyte averages the two" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item7_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "The byte size is the serialized length, the weight is what the block limit counts, and the vbyte is the weight in a familiar unit" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item8> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:Participants:87" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item8_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item8_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item8_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item8_optD> ;
    pr:position 8 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src8> ;
    pr:stem "Why is counting nodes not the same as measuring the network's security?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item8_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "Because what matters is how many participants independently verify the rules, not how many are connected" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item8_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because the figures that are published count only the nodes that accept incoming connections, and those are counted once a day by the block explorers" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item8_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because lightweight clients are counted twice in the usual figures" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item8_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Because every node counts for one vote on the next block" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item9> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
    pr:bloomLevel 4 ;
    pr:chapter 3 ;
    pr:itemKey "bank:ch03:TransactionWeight:161" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P05/midterm_v2_item9_optA>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item9_optB>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item9_optC>,
        <http://example.org/sen0401/engine/paper#P05/midterm_v2_item9_optD> ;
    pr:position 9 ;
    pr:source <http://example.org/sen0401/engine/paper#P05/midterm_v2_src9> ;
    pr:stem "Why is the witness 35.6 percent of the bytes of Alice's transaction but only 12.1 percent of its weight?" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item9_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Witness bytes are compressed before they are counted" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item9_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Weight is measured in virtual bytes, which round the witness away completely" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item9_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Witness bytes count one unit each, while the other bytes count four" .

<http://example.org/sen0401/engine/paper#P05/midterm_v2_item9_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The weight leaves out the witness of transactions with one input" .

