    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N05/makeup_v2_item3_optA>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item3_optB>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item3_optC>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item3_optD> ;
    pr:position 3 ;
    pr:source <http://example.org/sen0401/engine/paper#N05/makeup_v2_src3> ;
    pr:stem "In what sense is Bitcoin's privacy pseudonymous rather than anonymous?" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item3_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Payments are visible only to the miner who includes them" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item3_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The payments themselves are hidden, while the names of the two parties are public" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item3_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Payments are encrypted and nobody can read them" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item3_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Payments are public but attached to addresses, which are names without a person behind them" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item4> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 3 ;
    pr:chapter 2 ;
    pr:code "print(sum([75000, 20000, 5000]) == 100000)" ;
    pr:codeLines 1 ;
    pr:codeMaxColumns 42 ;
    pr:itemKey "bank:ch02:DoubleEntryLedger:3" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option <http://example.org/sen0401/engine/paper#N05/makeup_v2_item4_optA>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item4_optB>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item4_optC>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item4_optD> ;
    pr:position 4 ;
    pr:source <http://example.org/sen0401/engine/paper#N05/makeup_v2_src4> ;
    pr:stem "Alice's inputs total 100,000 satoshis and her outputs 75,000 and 20,000, with a fee of 5,000. What does this program print?" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item4_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "False" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item4_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "True" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item4_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "95000" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item4_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "100000" .

