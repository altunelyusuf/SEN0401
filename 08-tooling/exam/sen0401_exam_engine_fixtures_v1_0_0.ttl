<http://example.org/sen0401/engine/paper#N28/makeup_v2_item1> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 4 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:CentralBankReplacement:8" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N28/makeup_v2_item1_optA>,
        <http://example.org/sen0401/engine/paper#N28/makeup_v2_item1_optB>,
