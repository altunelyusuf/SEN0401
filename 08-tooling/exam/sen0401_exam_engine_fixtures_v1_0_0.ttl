    pr:position 7 ;
    pr:source <http://example.org/sen0401/engine/paper#P04/makeup_v2_src7> ;
    pr:stem "What is the Internet, in the words of the glossaries the chapter relies on?" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item7_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "A protocol for exchanging web pages" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item7_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "A single very large computer that routes all of the world's traffic" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item7_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "A company that sells access to web pages" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item7_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "A worldwide network of networks that share one protocol suite" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item8> a pr:ChoiceItem,
        pr:Item ;
