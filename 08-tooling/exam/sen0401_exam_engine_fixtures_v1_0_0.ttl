<http://example.org/sen0401/engine/paper#P03/makeup_v2_item2> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:EllipticCurve:35" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P03/makeup_v2_item2_optA>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item2_optB>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item2_optC>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item2_optD> ;
    pr:position 2 ;
    pr:source <http://example.org/sen0401/engine/paper#P03/makeup_v2_src2> ;
    pr:stem "Why is the smooth curve drawn in textbooks misleading for Bitcoin?" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item2_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because Bitcoin uses a different equation from the one in the pictures" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item2_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Because the arithmetic is done modulo a large prime, so the curve is a cloud of points in a huge grid" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item2_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because the curve is only an analogy and no multiplication is actually performed" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item2_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Because the picture shows the public key rather than the private one" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item3> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 1 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:MakingChange:54" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P03/makeup_v2_item3_optA>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item3_optB>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item3_optC>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item3_optD> ;
    pr:position 3 ;
    pr:source <http://example.org/sen0401/engine/paper#P03/makeup_v2_src3> ;
    pr:stem "Why does a transaction need a change output at all?" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item3_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "Because a transaction input, like a currency note, cannot be partly spent" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item3_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because the miner refuses a transaction with a single output" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item3_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because the protocol requires every transaction to have two outputs" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item3_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Because the fee must be paid from a separate output" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item4> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 2 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:Security:139" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P03/makeup_v2_item4_optA>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item4_optB>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item4_optC>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item4_optD> ;
    pr:position 4 ;
    pr:source <http://example.org/sen0401/engine/paper#P03/makeup_v2_src4> ;
    pr:stem "How is the security of a confirmed payment best described?" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item4_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "As a promise enforced by the miners who signed the block" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item4_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "As a certainty once the transaction has one confirmation" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item4_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "As a guarantee that holds for payments below a fixed amount" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item4_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "As confidence that grows with each block, not as an absolute guarantee" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item5> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:CoinbaseDemo:181" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P03/makeup_v2_item5_optA>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item5_optB>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item5_optC>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item5_optD> ;
    pr:position 5 ;
    pr:source <http://example.org/sen0401/engine/paper#P03/makeup_v2_src5> ;
    pr:stem "Which experiment on the coinbase page shows what Bitcoin adds that the page lacks?" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item5_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Adding a fourth peer, which the page does not support" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item5_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Mining two blocks in a row, which the page allows" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item5_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Changing the coinbase amount, which the page recomputes" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item5_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Spending the same amount twice, which the page allows and Bitcoin rejects" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item6> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 4 ;
    pr:chapter 5 ;
    pr:itemKey "bank:ch05:Salt:59" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P03/makeup_v2_item6_optA>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item6_optB>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item6_optC>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item6_optD> ;
    pr:position 6 ;
    pr:source <http://example.org/sen0401/engine/paper#P03/makeup_v2_src6> ;
    pr:stem "A classical salt is random and stored beside the derived key. How does BIP39's salt differ?" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item6_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "It is derived from the words, so it differs per code" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item6_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "It is a fixed constant, so every passphrase-free wallet uses the same salt" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item6_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "It is secret, so it adds entropy to the seed" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item6_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "It is eight random bytes chosen by the wallet" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item7> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 2 ;
    pr:chapter 5 ;
    pr:itemKey "bank:ch05:StandardPath84:124" ;
