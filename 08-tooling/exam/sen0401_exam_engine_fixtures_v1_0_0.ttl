<http://example.org/sen0401/engine/paper#N08/makeup_v2_item14> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 4 ;
    pr:chapter 5 ;
    pr:itemKey "bank:ch05:ExtendedPublicKey:95" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N08/makeup_v2_item14_optA>,
        <http://example.org/sen0401/engine/paper#N08/makeup_v2_item14_optB>,
