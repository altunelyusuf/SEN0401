    pr:position 14 ;
    pr:source <http://example.org/sen0401/engine/paper#N04/makeup_v2_src14> ;
    pr:stem "A merchant gives an auditor the account's extended public key. What has the auditor gained?" .

<http://example.org/sen0401/engine/paper#N04/makeup_v2_item14_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The power to spend from the account" .

