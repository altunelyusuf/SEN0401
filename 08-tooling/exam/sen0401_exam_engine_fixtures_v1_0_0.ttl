    pr:position 2 ;
    pr:source <http://example.org/sen0401/engine/paper#N03/makeup_v2_src2> ;
    pr:stem "Why do most mobile wallets reduce their user's privacy?" .

<http://example.org/sen0401/engine/paper#N03/makeup_v2_item2_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "They fetch information from remote servers, disclosing addresses and balances" .

<http://example.org/sen0401/engine/paper#N03/makeup_v2_item2_optB> pr:isKey false ;
