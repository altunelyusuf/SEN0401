    pr:position 2 ;
    pr:source <http://example.org/sen0401/engine/paper#N28/makeup_v2_src2> ;
    pr:stem "Why do most mobile wallets reduce their user's privacy?" .

<http://example.org/sen0401/engine/paper#N28/makeup_v2_item2_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "They fetch information from remote servers, disclosing addresses and balances" .

<http://example.org/sen0401/engine/paper#N28/makeup_v2_item2_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "They publish the user's name together with each payment" .

<http://example.org/sen0401/engine/paper#N28/makeup_v2_item2_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "They sign transactions with a key shared by all users" .

<http://example.org/sen0401/engine/paper#N28/makeup_v2_item2_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "They store a copy of the recovery code on the server of the phone's manufacturer" .

<http://example.org/sen0401/engine/paper#N28/makeup_v2_item3> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 4 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:Privacy:89" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N28/makeup_v2_item3_optA>,
        <http://example.org/sen0401/engine/paper#N28/makeup_v2_item3_optB>,
