    pr:position 12 ;
    pr:source <http://example.org/sen0401/engine/paper#N11/makeup_v2_src12> ;
    pr:stem "Why was the number 1 chosen as the separator instead of a colon?" .

<http://example.org/sen0401/engine/paper#N11/makeup_v2_item12_optA> pr:isKey false ;
