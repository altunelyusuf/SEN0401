<http://example.org/sen0401/engine/paper#P03/makeup_v2_item7_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Pay-to-public-key-hash" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item8> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 5 ;
    pr:bloomLevel 2 ;
    pr:chapter 5 ;
    pr:itemKey "bank:ch05:HmacSha512:69" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P03/makeup_v2_item8_optA>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item8_optB>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item8_optC>,
        <http://example.org/sen0401/engine/paper#P03/makeup_v2_item8_optD> ;
    pr:position 8 ;
    pr:source <http://example.org/sen0401/engine/paper#P03/makeup_v2_src8> ;
    pr:stem "Which argument of the derivation's keyed hash is the chain code?" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item8_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Neither; the chain code is hashed separately" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item8_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The message, while the private key is the key" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item8_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "The key, while the key material is part of the message" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item8_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Both, since it is used twice" .

