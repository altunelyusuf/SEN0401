    pr:position 8 ;
    pr:source <http://example.org/sen0401/engine/paper#P02/makeup_v2_src8> ;
    pr:stem "Why was a single front-door command introduced in release 30.0?" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item8_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "It is required to run a node, since bitcoind was removed from the release archive for good" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item8_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "It lets the user choose between Autotools and CMake at start-up" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item8_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "It replaces the node by a lighter program that skips verification" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item8_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "It hides the planned split into processes, so users need not learn new binary names" .

