    pr:letter "A" ;
    pr:text "Native pay-to-witness-public-key-hash" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item7_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Single-key pay-to-taproot" .

<http://example.org/sen0401/engine/paper#P03/makeup_v2_item7_optC> pr:isKey false ;
