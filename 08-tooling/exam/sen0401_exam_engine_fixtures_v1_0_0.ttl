<http://example.org/sen0401/engine/paper#P04/makeup_v2_item1> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 3 ;
    pr:chapter 1 ;
    pr:code """tx = {'to': 'Alice', 'amount_sat': 100000}
print(tx['amount_sat'] / 10**8)""" ;
    pr:codeLines 2 ;
    pr:codeMaxColumns 42 ;
    pr:itemKey "bank:ch01:Transaction:92" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option <http://example.org/sen0401/engine/paper#P04/makeup_v2_item1_optA>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item1_optB>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item1_optC>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item1_optD> ;
    pr:position 1 ;
    pr:source <http://example.org/sen0401/engine/paper#P04/makeup_v2_src1> ;
    pr:stem "What does this program print?" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item10> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 1 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:MakingChange:54" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P04/makeup_v2_item10_optA>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item10_optB>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item10_optC>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item10_optD> ;
    pr:position 10 ;
    pr:source <http://example.org/sen0401/engine/paper#P04/makeup_v2_src10> ;
    pr:stem "Why does a transaction need a change output at all?" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item10_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "Because a transaction input, like a currency note, cannot be partly spent" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item10_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because the protocol requires every transaction to have two outputs" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item10_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because the fee must be paid from a separate output" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item10_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Because the miner refuses a transaction with a single output" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item11> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 3 ;
    pr:chapter 2 ;
    pr:code "print((lambda n: n * (n - 1) // 2)(5))" ;
    pr:codeLines 1 ;
    pr:codeMaxColumns 38 ;
    pr:itemKey "bank:ch02:PeerToPeerNetwork:95" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option <http://example.org/sen0401/engine/paper#P04/makeup_v2_item11_optA>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item11_optB>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item11_optC>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item11_optD> ;
    pr:position 11 ;
    pr:source <http://example.org/sen0401/engine/paper#P04/makeup_v2_src11> ;
    pr:stem "What does this program print for the number of links among five fully connected peers?" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item11_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "25" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item11_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "20" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item11_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "10" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item11_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "5" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item12> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
    pr:bloomLevel 4 ;
    pr:chapter 3 ;
    pr:itemKey "bank:ch03:Platform:275" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P04/makeup_v2_item12_optA>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item12_optB>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item12_optC>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item12_optD> ;
    pr:position 12 ;
    pr:source <http://example.org/sen0401/engine/paper#P04/makeup_v2_src12> ;
    pr:stem "Why does the checksum list of a release have file names such as x86_64-linux-gnu?" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item12_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The names tell which miners built the archive" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item12_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The names list the networks that the archive may connect to" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item12_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "A program built for one platform does not run on another, and the names let a user find the right file" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item12_optD> pr:isKey false ;
    pr:letter "D" ;
