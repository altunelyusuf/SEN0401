    pr:position 6 ;
    pr:source <http://example.org/sen0401/engine/paper#P02/makeup_v2_src6> ;
    pr:stem "What can the blockchain page not show about Bitcoin's security?" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item6_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "That a changed block can be made valid again by mining it" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item6_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "That an attacker would have to outpace the whole network while it keeps extending the honest chain" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item6_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "That an attacker needs a majority of the hash rate before any change to an early block can be made to stick in the chain that other peers hold" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item6_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "That each block commits to the hash of the block before it" .

<http://example.org/sen0401/engine/paper#P02/makeup_v2_item7> a pr:ChoiceItem,
        pr:Item ;
