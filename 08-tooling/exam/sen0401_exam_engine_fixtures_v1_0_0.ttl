    pr:position 4 ;
    pr:source <http://example.org/sen0401/engine/paper#N30/midterm_v2_src4> ;
    pr:stem "What may happen when you look up your own transactions in a block explorer?" .

<http://example.org/sen0401/engine/paper#N30/midterm_v2_item4_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The transaction may be relayed twice and counted as a double spend" .

<http://example.org/sen0401/engine/paper#N30/midterm_v2_item4_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "The explorer may charge a fee taken from the transaction" .

<http://example.org/sen0401/engine/paper#N30/midterm_v2_item4_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "The operator may be able to guess how many bitcoins you have received, spent and currently own" .

