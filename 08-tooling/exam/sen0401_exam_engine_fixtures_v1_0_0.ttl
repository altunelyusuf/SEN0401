<http://example.org/sen0401/engine/paper#P04/midterm_v2_item15> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:Legacy:84" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P04/midterm_v2_item15_optA>,
        <http://example.org/sen0401/engine/paper#P04/midterm_v2_item15_optB>,
        <http://example.org/sen0401/engine/paper#P04/midterm_v2_item15_optC>,
        <http://example.org/sen0401/engine/paper#P04/midterm_v2_item15_optD> ;
    pr:position 15 ;
    pr:source <http://example.org/sen0401/engine/paper#P04/midterm_v2_src15> ;
    pr:stem "Why does the book recommend newer address types although it sees no immediate threat to P2SH?" .

<http://example.org/sen0401/engine/paper#P04/midterm_v2_item15_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "A legacy address reveals the public key that stands behind it as soon as the address is created" .

<http://example.org/sen0401/engine/paper#P04/midterm_v2_item15_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Legacy addresses will stop being valid after the next soft fork" .

<http://example.org/sen0401/engine/paper#P04/midterm_v2_item15_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "Cost, convenience and a theoretical collision risk, which a longer commitment removes" .

<http://example.org/sen0401/engine/paper#P04/midterm_v2_item15_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Legacy addresses cannot be used with deterministic wallets" .

<http://example.org/sen0401/engine/paper#P04/midterm_v2_item16> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:PublicKey:13" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P04/midterm_v2_item16_optA>,
        <http://example.org/sen0401/engine/paper#P04/midterm_v2_item16_optB>,
        <http://example.org/sen0401/engine/paper#P04/midterm_v2_item16_optC>,
        <http://example.org/sen0401/engine/paper#P04/midterm_v2_item16_optD> ;
    pr:position 16 ;
    pr:source <http://example.org/sen0401/engine/paper#P04/midterm_v2_src16> ;
    pr:stem "Why is an address, and not a public key, the thing a receiver usually hands over?" .

<http://example.org/sen0401/engine/paper#P04/midterm_v2_item16_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "A public key is long and error-prone to dictate or copy" .

<http://example.org/sen0401/engine/paper#P04/midterm_v2_item16_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Public keys change with every block, so they cannot be written down" .

<http://example.org/sen0401/engine/paper#P04/midterm_v2_item16_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Nodes reject outputs that contain a public key in any form" .

<http://example.org/sen0401/engine/paper#P04/midterm_v2_item16_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "A public key would let the payer spend the receiver's earlier coins" .

