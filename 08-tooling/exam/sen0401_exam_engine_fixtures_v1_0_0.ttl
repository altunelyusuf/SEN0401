    pr:position 11 ;
    pr:source <http://example.org/sen0401/engine/paper#N16/midterm_v2_src11> ;
    pr:stem "Why is an address, and not a public key, the thing a receiver usually hands over?" .

<http://example.org/sen0401/engine/paper#N16/midterm_v2_item11_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "A public key would let the payer spend the receiver's earlier coins" .

<http://example.org/sen0401/engine/paper#N16/midterm_v2_item11_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Public keys change with every block, so they cannot be written down" .

<http://example.org/sen0401/engine/paper#N16/midterm_v2_item11_optC> pr:isKey true ;
    pr:letter "C" ;
    pr:text "A public key is long and error-prone to dictate or copy" .

<http://example.org/sen0401/engine/paper#N16/midterm_v2_item11_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Nodes reject outputs that contain a public key in any form" .

