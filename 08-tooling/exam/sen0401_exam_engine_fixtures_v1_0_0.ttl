    pr:position 4 ;
    pr:source <http://example.org/sen0401/engine/paper#P06/makeup_v2_src4> ;
    pr:stem "Why is an interactive demonstration page worth including in the material?" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item4_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because a student cannot otherwise compute a hash" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item4_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because the pages run the real Bitcoin consensus rules" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item4_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because the pages are the only place the book's figures appear" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item4_optD> pr:isKey true ;
    pr:letter "D" ;
    pr:text "Because the central claims about hashing and chaining can be seen rather than believed" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item5> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:EllipticCurve:35" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P06/makeup_v2_item5_optA>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item5_optB>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item5_optC>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item5_optD> ;
    pr:position 5 ;
    pr:source <http://example.org/sen0401/engine/paper#P06/makeup_v2_src5> ;
    pr:stem "Why is the smooth curve drawn in textbooks misleading for Bitcoin?" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item5_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "Because the arithmetic is done modulo a large prime, so the curve is a cloud of points in a huge grid" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item5_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Because the picture shows the public key rather than the private one" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item5_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because the curve is only an analogy and no multiplication is actually performed" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item5_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Because Bitcoin uses a different equation from the one in the pictures" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item6> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 2 ;
    pr:bloomLevel 4 ;
    pr:chapter 2 ;
    pr:itemKey "bank:ch02:UnconfirmedTransaction:154" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P06/makeup_v2_item6_optA>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item6_optB>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item6_optC>,
        <http://example.org/sen0401/engine/paper#P06/makeup_v2_item6_optD> ;
    pr:position 6 ;
    pr:source <http://example.org/sen0401/engine/paper#P06/makeup_v2_src6> ;
    pr:stem "Why is ten minutes an average rather than a waiting time?" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item6_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "Because every node rounds the arrival time of a block to the nearest ten minutes before storing it, so the recorded interval is never the real one" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item6_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Because nothing makes a particular block arrive on time; the interval is random with a known mean" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item6_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Because the first confirmation always takes five minutes" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item6_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Because the difficulty fixes the interval exactly at ten minutes" .

<http://example.org/sen0401/engine/paper#P06/makeup_v2_item7> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
