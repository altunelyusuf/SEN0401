        <http://example.org/sen0401/engine/paper#N18/makeup_v2_item11_optC>,
        <http://example.org/sen0401/engine/paper#N18/makeup_v2_item11_optD> ;
    pr:position 11 ;
    pr:source <http://example.org/sen0401/engine/paper#N18/makeup_v2_src11> ;
    pr:stem "Which mistake does the book warn about when turning an address into an output script?" .

<http://example.org/sen0401/engine/paper#N18/makeup_v2_item11_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "Writing version 1 as the byte 0x01 instead of the opcode byte 0x51" .

<http://example.org/sen0401/engine/paper#N18/makeup_v2_item11_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Writing the version after the program instead of before it" .

<http://example.org/sen0401/engine/paper#N18/makeup_v2_item11_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Leaving out the length byte before the program" .

<http://example.org/sen0401/engine/paper#N18/makeup_v2_item11_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Writing the version in decimal instead of hexadecimal" .

