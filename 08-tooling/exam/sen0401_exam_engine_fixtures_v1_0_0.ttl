<http://example.org/sen0401/engine/paper#N17/makeup_v2_item2> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 1 ;
    pr:bloomLevel 2 ;
    pr:chapter 1 ;
    pr:itemKey "bank:ch01:MobileWallet:18" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N17/makeup_v2_item2_optA>,
        <http://example.org/sen0401/engine/paper#N17/makeup_v2_item2_optB>,
