        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 2 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:HumanReadablePart:121" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N11/makeup_v2_item12_optA>,
