    pr:itemKey "bank:ch02:BlockExplorer:107" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P04/midterm_v2_item10_optA>,
        <http://example.org/sen0401/engine/paper#P04/midterm_v2_item10_optB>,
        <http://example.org/sen0401/engine/paper#P04/midterm_v2_item10_optC>,
