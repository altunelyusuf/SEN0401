    pr:code "print((50 * 10 ** 8) >> 3)" ;
    pr:codeLines 1 ;
    pr:codeMaxColumns 26 ;
    pr:itemKey "bank:ch02:BlockReward:132" ;
    pr:itemType pr:ChoiceFourCode ;
    pr:option <http://example.org/sen0401/engine/paper#N05/makeup_v2_item5_optA>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item5_optB>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item5_optC>,
        <http://example.org/sen0401/engine/paper#N05/makeup_v2_item5_optD> ;
    pr:position 5 ;
    pr:source <http://example.org/sen0401/engine/paper#N05/makeup_v2_src5> ;
    pr:stem "Three halvings have occurred. What does this program print for the subsidy in satoshis?" .

<http://example.org/sen0401/engine/paper#N05/makeup_v2_item5_optA> pr:isKey false ;
