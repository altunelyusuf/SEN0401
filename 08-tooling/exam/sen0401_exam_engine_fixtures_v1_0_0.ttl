    pr:stem "Why was the number 1 chosen as the separator instead of a colon?" .

<http://example.org/sen0401/engine/paper#N33/makeup_v2_item12_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "A colon is not allowed in a URI" .

<http://example.org/sen0401/engine/paper#N33/makeup_v2_item12_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "A colon would make the address one character longer" .

