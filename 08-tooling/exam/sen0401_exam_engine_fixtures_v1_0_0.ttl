    pr:itemKey "bank:ch01:CentralBankReplacement:8" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#N13/makeup_v2_item1_optA>,
        <http://example.org/sen0401/engine/paper#N13/makeup_v2_item1_optB>,
