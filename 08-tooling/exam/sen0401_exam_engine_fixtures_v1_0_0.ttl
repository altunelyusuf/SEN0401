    pr:letter "A" ;
    pr:text "A legacy address reveals the public key that stands behind it as soon as the address is created" .

<http://example.org/sen0401/engine/paper#N22/midterm_v2_item10_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Cost, convenience and a theoretical collision risk, which a longer commitment removes" .

<http://example.org/sen0401/engine/paper#N22/midterm_v2_item10_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "Legacy addresses will stop being valid after the next soft fork" .

<http://example.org/sen0401/engine/paper#N22/midterm_v2_item10_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "Legacy addresses cannot be used with deterministic wallets" .

<http://example.org/sen0401/engine/paper#N22/midterm_v2_item11> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 4 ;
    pr:bloomLevel 4 ;
    pr:chapter 4 ;
    pr:itemKey "bank:ch04:PublicKey:13" ;
