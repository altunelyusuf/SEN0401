<http://example.org/sen0401/engine/paper#P04/makeup_v2_item13> a pr:ChoiceItem,
        pr:Item ;
    en:kind en:Direct ;
    en:primaryChapter 3 ;
    pr:bloomLevel 2 ;
    pr:chapter 3 ;
    pr:itemKey "bank:ch03:Checksum:218" ;
    pr:itemType pr:ChoiceFour ;
    pr:option <http://example.org/sen0401/engine/paper#P04/makeup_v2_item13_optA>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item13_optB>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item13_optC>,
        <http://example.org/sen0401/engine/paper#P04/makeup_v2_item13_optD> ;
    pr:position 13 ;
    pr:source <http://example.org/sen0401/engine/paper#P04/makeup_v2_src13> ;
    pr:stem "Why does a checksum make the comparison of two large files cheap?" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item13_optA> pr:isKey false ;
    pr:letter "A" ;
    pr:text "The checksum compresses the file into 64 characters that can be unpacked" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item13_optB> pr:isKey true ;
    pr:letter "B" ;
    pr:text "Their digests of 64 characters can be compared instead of the files" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item13_optC> pr:isKey false ;
    pr:letter "C" ;
    pr:text "The checksum is signed, so no comparison is needed" .

<http://example.org/sen0401/engine/paper#P04/makeup_v2_item13_optD> pr:isKey false ;
    pr:letter "D" ;
    pr:text "The checksum lets the receiver rebuild a lost part of the file" .

