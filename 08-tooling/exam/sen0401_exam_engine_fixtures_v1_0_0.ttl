<http://example.org/sen0401/engine/paper#N01/midterm_v2_item11_optA> pr:isKey true ;
    pr:letter "A" ;
    pr:text "A public key would let the payer spend the receiver's earlier coins" .

<http://example.org/sen0401/engine/paper#N01/midterm_v2_item11_optB> pr:isKey false ;
    pr:letter "B" ;
    pr:text "Public keys change with every block, so they cannot be written down" .

