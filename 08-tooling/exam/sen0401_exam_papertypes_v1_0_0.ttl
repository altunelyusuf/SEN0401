@prefix pr:   <http://example.org/sen0401/paperrules#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Registry of item types and page-reduction methods for the SEN0401 printed paper, version 1.0.0.
# Basis codes: CONV = a convention the owner stated (2026-10-29); FACT = measured or arithmetic; PRACTICE = accepted item-writing or print practice (the owner may overrule);
#              ASSUME = a working estimate that the owner is asked to confirm. A status that rests on PRACTICE or ASSUME is listed in the owner's questions.

<http://example.org/sen0401/paperrules/types> a owl:Ontology ; rdfs:label "SEN0401 printed paper: item types and page methods"@en ; owl:versionInfo "1.0.0" .

pr:Suited a pr:TypeStatus ; rdfs:label "Suited to a printed paper"@en .
pr:Conditional a pr:TypeStatus ; rdfs:label "Allowed only when the paper names it as enabled"@en .
pr:NotSuited a pr:TypeStatus ; rdfs:label "Not suited to a printed paper"@en .

# ---- suited types: pr:highestBloom is the highest Bloom level (1 Remember .. 6 Create) the type can honestly reach; pr:secondsPerItem is the time model
pr:ChoiceFour a pr:ItemType ; rdfs:label "Four-option single-answer choice"@en ; pr:status pr:Suited ; pr:basis "CONV" ; pr:highestBloom 4 ; pr:secondsPerItem 60 ;
  pr:reason "The chapter banks hold only this type (1,453 items measured 2026-10-29); one in four is the guess rate, against one in two for true/false."@en .
pr:ChoiceFourCode a pr:ItemType ; rdfs:label "Four-option choice with a short code listing"@en ; pr:status pr:Suited ; pr:basis "FACT" ; pr:highestBloom 4 ; pr:secondsPerItem 100 ;
  pr:reason "Measured: 482 of the 1,453 bank items carry code (chapters 1 to 8); the listing must print unwrapped, which limits its width and length (see the code rule)."@en .
pr:Matching a pr:ItemType ; rdfs:label "Matching: premises to a longer list of answers"@en ; pr:status pr:Suited ; pr:basis "FACT" ; pr:highestBloom 3 ; pr:secondsPerItem 240 ;
  pr:reason "Measured layout model: five premises and seven answers take about two thirds of the height of five choice items; suits cross-chapter linking."@en .
pr:Ordering a pr:ItemType ; rdfs:label "Ordering: number the steps of a process"@en ; pr:status pr:Suited ; pr:basis "PRACTICE" ; pr:highestBloom 3 ; pr:secondsPerItem 120 ;
  pr:reason "Suits processes the course teaches in a fixed sequence; a number written in a box prints cleanly and has one key."@en .
pr:FillBlank a pr:ItemType ; rdfs:label "Fill-in from a shared numbered bank"@en ; pr:status pr:Suited ; pr:basis "CONV" ; pr:highestBloom 2 ; pr:secondsPerItem 45 ;
  pr:reason "Named in the owner's exam conventions (option banks randomised); one bank serves several blanks, which saves lines."@en .
pr:NumericAnswer a pr:ItemType ; rdfs:label "Single number with a unit in a box"@en ; pr:status pr:Suited ; pr:basis "FACT" ; pr:highestBloom 3 ; pr:secondsPerItem 120 ;
  pr:reason "One exact key, no wording to mark; suits the course's arithmetic (fees, halving, supply)."@en .
pr:CodeTrace a pr:ItemType ; rdfs:label "Trace: write the printed result of a short listing"@en ; pr:status pr:Suited ; pr:basis "PRACTICE" ; pr:highestBloom 4 ; pr:secondsPerItem 120 ;
  pr:reason "Reaches Analyze without options; the key is one line of output, marked by exact match."@en .
# ---- conditional types
pr:ShortAnswer a pr:ItemType ; rdfs:label "Short written answer, one or two sentences, marked by a rubric"@en ; pr:status pr:Conditional ; pr:basis "ASSUME" ; pr:highestBloom 5 ; pr:secondsPerItem 240 ;
  pr:reason "The only type that reaches Evaluate; marking is less exact, so it needs a rubric of at most three points. The owner decides whether and how many."@en .
pr:DiagramLabel a pr:ItemType ; rdfs:label "Label a line-art diagram from a bank"@en ; pr:status pr:Conditional ; pr:basis "ASSUME" ; pr:highestBloom 2 ; pr:secondsPerItem 90 ;
  pr:reason "Needs a line drawing taken from the course material and costs a quarter page or more; the owner decides."@en .
pr:WriteCode a pr:ItemType ; rdfs:label "Write a few lines of code on paper"@en ; pr:status pr:Conditional ; pr:basis "ASSUME" ; pr:highestBloom 5 ; pr:secondsPerItem 300 ;
  pr:reason "Not exact to mark and slow in 60 minutes; the owner decides whether the course teaches it as a paper skill."@en .
# ---- not suited types
pr:TrueFalse a pr:ItemType ; rdfs:label "True or false"@en ; pr:status pr:NotSuited ; pr:basis "FACT" ; pr:highestBloom 2 ; pr:secondsPerItem 30 ;
  pr:reason "Guess rate one in two (arithmetic)."@en .
pr:MultiSelect a pr:ItemType ; rdfs:label "Select all that apply"@en ; pr:status pr:NotSuited ; pr:basis "PRACTICE" ; pr:highestBloom 4 ; pr:secondsPerItem 90 ;
  pr:reason "Partial credit disputes and a high rate of slips when circling several letters."@en .
pr:Essay a pr:ItemType ; rdfs:label "Long essay"@en ; pr:status pr:NotSuited ; pr:basis "PRACTICE" ; pr:highestBloom 6 ; pr:secondsPerItem 900 ;
  pr:reason "Cannot be marked reliably or finished in a 60-minute sitting with other items."@en .
pr:DragDrop a pr:ItemType ; rdfs:label "Drag and drop"@en ; pr:status pr:NotSuited ; pr:basis "FACT" ; pr:highestBloom 3 ; pr:secondsPerItem 60 ; pr:reason "Needs a screen; the exams are on paper."@en .
pr:Hotspot a pr:ItemType ; rdfs:label "Click on the picture"@en ; pr:status pr:NotSuited ; pr:basis "FACT" ; pr:highestBloom 2 ; pr:secondsPerItem 60 ; pr:reason "Needs a screen."@en .
pr:Simulation a pr:ItemType ; rdfs:label "Interactive simulation"@en ; pr:status pr:NotSuited ; pr:basis "FACT" ; pr:highestBloom 4 ; pr:secondsPerItem 300 ; pr:reason "Needs a screen."@en .
pr:RunCode a pr:ItemType ; rdfs:label "Run the code and report"@en ; pr:status pr:NotSuited ; pr:basis "FACT" ; pr:highestBloom 3 ; pr:secondsPerItem 180 ; pr:reason "Needs a machine; use the trace type instead."@en .
pr:MediaPlayback a pr:ItemType ; rdfs:label "Audio or video item"@en ; pr:status pr:NotSuited ; pr:basis "FACT" ; pr:highestBloom 2 ; pr:secondsPerItem 120 ; pr:reason "Cannot be printed."@en .
pr:ColourCoded a pr:ItemType ; rdfs:label "Item that depends on colour"@en ; pr:status pr:NotSuited ; pr:basis "CONV" ; pr:highestBloom 2 ; pr:secondsPerItem 60 ; pr:reason "The paper is print-safe, white and line-based."@en .

# ---- page-reduction methods; pr:measuredPages is the sample measurement printed by the measure script (the check re-runs it and compares)
pr:M1 a pr:PageMethod ; rdfs:label "Margins from 25 to 15 mm"@en ; pr:basis "FACT" ; pr:measuredFractionalPages "7.02"^^xsd:decimal ; pr:aloneStepOrder 1 .
pr:M2 a pr:PageMethod ; rdfs:label "Text from 12 to 10 point (code 9 point)"@en ; pr:basis "FACT" ; pr:measuredFractionalPages "5.42"^^xsd:decimal ; pr:aloneStepOrder 2 .
pr:M3 a pr:PageMethod ; rdfs:label "Two columns on A4"@en ; pr:basis "FACT" ; pr:measuredFractionalPages "3.73"^^xsd:decimal ; pr:aloneStepOrder 3 .
pr:M4 a pr:PageMethod ; rdfs:label "Short options set in a two-by-two block"@en ; pr:basis "FACT" ; pr:measuredFractionalPages "3.54"^^xsd:decimal ; pr:aloneStepOrder 4 .
pr:M5 a pr:PageMethod ; rdfs:label "Circle the letter on the item; no separate answer sheet"@en ; pr:basis "FACT" ; pr:measuredFractionalPages "3.02"^^xsd:decimal ; pr:aloneStepOrder 5 .
pr:M6 a pr:PageMethod ; rdfs:label "Print on both sides (sheets, not pages)"@en ; pr:basis "FACT" ; pr:aloneStepOrder 6 .
pr:M7 a pr:PageMethod ; rdfs:label "Matching block instead of separate choice items"@en ; pr:basis "FACT" ; pr:aloneStepOrder 7 .
pr:M8 a pr:PageMethod ; rdfs:label "One shared bank for several fill-in blanks"@en ; pr:basis "FACT" ; pr:aloneStepOrder 8 .

# ---- classes: each type names the item class that a node of that type must also carry (rule R04c)
pr:ChoiceItem rdfs:subClassOf pr:Item . pr:MatchingItem rdfs:subClassOf pr:Item . pr:OrderingItem rdfs:subClassOf pr:Item .
pr:FillBlankItem rdfs:subClassOf pr:Item . pr:NumericItem rdfs:subClassOf pr:Item . pr:CodeTraceItem rdfs:subClassOf pr:Item .
pr:ShortAnswerItem rdfs:subClassOf pr:Item .
pr:ChoiceFour pr:itemClass pr:ChoiceItem . pr:ChoiceFourCode pr:itemClass pr:ChoiceItem . pr:Matching pr:itemClass pr:MatchingItem .
pr:Ordering pr:itemClass pr:OrderingItem . pr:FillBlank pr:itemClass pr:FillBlankItem . pr:NumericAnswer pr:itemClass pr:NumericItem .
pr:CodeTrace pr:itemClass pr:CodeTraceItem . pr:ShortAnswer pr:itemClass pr:ShortAnswerItem .
