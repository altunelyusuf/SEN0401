        }""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape backlog:DeliverableIntentionShape ;
            sh:value <http://example.org/sen0401-slides-lineage#Del3_DeckGaps> ],
