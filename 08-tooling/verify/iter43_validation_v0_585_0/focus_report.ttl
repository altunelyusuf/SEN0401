_:N212574e2301f4e38b7dd9903c34ae3c7 sh:declare [ sh:namespace "http://example.org/backlog#"^^xsd:anyURI ;
            sh:prefix "backlog" ] .

_:N2d655eda86034941afc8cbcea26678b3 sh:namespace "http://example.org/backlog#"^^xsd:anyURI ;
    sh:prefix "backlog" .

_:N6e57a74e7a1c47f0ad14ef8a65035880 sh:namespace "http://example.org/backlog#"^^xsd:anyURI ;
    sh:prefix "backlog" .

_:N84b36f1d568f49efb850bb3b52866bd9 sh:declare _:N2d655eda86034941afc8cbcea26678b3 .

_:N8c0b9c19dc66409c801be3130f62374b sh:declare _:N6e57a74e7a1c47f0ad14ef8a65035880 .

_:n131478c42d67415cb022045e55a3f71fb101 a sh:SPARQLConstraint ;
    sh:message "Advisory: every acceptance criterion on this user-facing story reads as an enumeration of files, fields, tables or endpoints. That describes the change, not the behaviour: could someone who never sees the diff tell from this text whether the item works — what a user does, what they then see, and what happens when it goes wrong?" ;
    sh:prefixes _:N212574e2301f4e38b7dd9903c34ae3c7 ;
    sh:select """SELECT $this WHERE {
            $this backlog:hasAcceptanceCriterion ?any .
            FILTER NOT EXISTS {
                $this backlog:hasAcceptanceCriterion ?ac .
                ?ac backlog:hasGherkinText ?t .
                FILTER (!REGEX(?t, "(\\\\.ttl|\\\\.py|\\\\.js|\\\\.ts|\\\\.sql|\\\\bfile|\\\\bfield|\\\\bcolumn|\\\\btable|\\\\bschema|\\\\bendpoint|\\\\bmodule)", "i"))
            }
        }""" .

_:n131478c42d67415cb022045e55a3f71fb750 a sh:SPARQLConstraint ;
    sh:message "Advisory: this story was groomed for a design concern, but none of the tasks planned from it performs the kind of work that concern implies. The analysis happened and nothing downstream reflects it — which is the state in which grooming becomes a ceremony rather than a step. Either a task of that type is missing, or the concern did not really apply and the grooming record overstates what was needed." ;
    sh:prefixes _:N8c0b9c19dc66409c801be3130f62374b ;
    sh:select """SELECT $this WHERE {
            $this backlog:hasApplicableConcern ?c .
            ?c backlog:coversTaskType ?tt .
            FILTER EXISTS { ?pe backlog:plansItem $this ; backlog:producesTask ?any }
            FILTER NOT EXISTS {
                ?pe2 backlog:plansItem $this ; backlog:producesTask ?task .
                ?task backlog:hasTaskType ?tt2 .
                ?c backlog:coversTaskType ?tt2 .
            }
        }""" .

_:n131478c42d67415cb022045e55a3f71fb762 a sh:SPARQLConstraint ;
    sh:message "Advisory: this item is Ready but its declared dependencies are not all Done, so it is not actually startable." ;
    sh:prefixes _:N84b36f1d568f49efb850bb3b52866bd9 ;
    sh:select """SELECT $this WHERE {
            $this backlog:hasState backlog:Ready ; backlog:dependsOn ?d .
            ?d backlog:hasState ?ds .
            FILTER (?ds != backlog:Done)
        }""" .

