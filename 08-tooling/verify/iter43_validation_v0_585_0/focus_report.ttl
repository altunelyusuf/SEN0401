            sh:resultMessage "Advisory: no goal contributes to this mission, so nothing in the register works toward it and no observation can ever bear on it. A mission with no goals beneath it is a statement of intent the development is not acting on — which may be honest, and is worth seeing." ;
            sh:resultSeverity sh:Warning ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Advisory: no goal contributes to this mission, so nothing in the register works toward it and no observation can ever bear on it. A mission with no goals beneath it is a statement of intent the development is not acting on — which may be honest, and is worth seeing." ;
                    sh:prefixes [ sh:declare [ sh:namespace "http://example.org/backlog#"^^xsd:anyURI ;
                                    sh:prefix "backlog" ] ] ;
                    sh:select """SELECT $this WHERE {
