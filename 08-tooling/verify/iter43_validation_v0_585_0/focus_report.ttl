        [ a sh:ValidationResult ;
            sh:focusNode <http://example.org/sen0401-slides-lineage#Obj3_DeckGaps> ;
            sh:resultMessage "Advisory: every item that can move this objective's metric also pursues it, and no other work does. The objective and the work are the same set, so the measurement cannot fail while the work is done — it counts the backlog and calls the result an outcome. An objective written before the work usually measures something the work AFFECTS rather than something the work IS." ;
            sh:resultSeverity sh:Warning ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Advisory: every item that can move this objective's metric also pursues it, and no other work does. The objective and the work are the same set, so the measurement cannot fail while the work is done — it counts the backlog and calls the result an outcome. An objective written before the work usually measures something the work AFFECTS rather than something the work IS." ;
                    sh:prefixes [ sh:declare [ sh:namespace "http://example.org/backlog#"^^xsd:anyURI ;
                                    sh:prefix "backlog" ] ] ;
                    sh:select """SELECT $this WHERE {
            $this backlog:metricMovableBy ?w .
            FILTER NOT EXISTS { $this backlog:metricMovableBy ?w2 .
                                FILTER NOT EXISTS { ?w2 backlog:pursuesObjective $this } }
            FILTER NOT EXISTS { ?other backlog:pursuesObjective $this .
                                FILTER NOT EXISTS { $this backlog:metricMovableBy ?other } }
        }""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape backlog:IntentEchoShape ;
            sh:value <http://example.org/sen0401-slides-lineage#Obj3_DeckGaps> ],
        [ a sh:ValidationResult ;
            sh:focusNode <http://example.org/sen0401-slides-lineage#G3_DeckGaps> ;
            sh:resultMessage "Advisory: this goal belongs to a lineage opened by succession and states no origin (hasGoalOrigin): whether it carries the predecessor's out-scoped work, repairs a post-closure finding, or covers something new. Without it the backlog and roadmap cannot be traced to why the successor exists." ;
            sh:resultSeverity sh:Warning ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Advisory: this goal belongs to a lineage opened by succession and states no origin (hasGoalOrigin): whether it carries the predecessor's out-scoped work, repairs a post-closure finding, or covers something new. Without it the backlog and roadmap cannot be traced to why the successor exists." ;
                    sh:prefixes [ sh:declare [ sh:namespace "http://example.org/backlog#"^^xsd:anyURI ;
