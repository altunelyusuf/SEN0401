  "merkle": "def merkle_root(txids):\n    level = [bytes.fromhex(t)[::-1] for t in txids]\n    while len(level) > 1:\n        if len(level) % 2: level.append(level[-1])\n        level = [dsha(level[i] + level[i + 1]) for i in range(0, len(level), 2)]\n    return level[0][::-1].hex()"
