  "ec": "def ec_add(a, b):\n    if a is None: return b\n    if b is None: return a\n    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None\n    m = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P\n    x = (m * m - a[0] - b[0]) % P\n    return (x, (m * (a[0] - x) - a[1]) % P)\ndef ec_mul(k, pt=G):\n    out = None\n    while k:\n        if k & 1: out = ec_add(out, pt)\n        pt = ec_add(pt, pt); k >>= 1\n    return out"
