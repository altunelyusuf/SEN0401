#################################################################
#  SEN0401 Special Topics in Software Engineering: Block Chain -
#  learning outcomes.
#
#  Aligned to 1EdTech CASE v1.0 (CME standards adoption
#  cme:Adopt_CASE: aligned), using CASE's own terms from its
#  published JSON-LD context
#  (purl.imsglobal.org/spec/case/v1p0/context/imscasev1p0_context_v1p0.jsonld,
#  fetched 2026-10-04, sha256
#  ed4e4ce92aac01ff84c610733583649b42be1d25688b0da18dda1aec34ffa3e9),
#  not re-minted: the set is a CASE document and each outcome a CASE
#  item. The terms dtCFDocument, dtCFItemType, dtCFItem, title,
#  humanCodingScheme, CFItemType and fullStatement were each
#  confirmed present in that context before use. Cognitive levels
#  are the Bloom levels RDODI's learning-design vocabulary already
#  defines (ld:Remember to ld:Create, rank 1 to 6), read from
#  rdodi-ecosystem/07-pedagogy-professional-stage/01-vocabularies/learning_design_tbox_v1_0_0.ttl.
#
#  PROVENANCE.
#
#  These outcomes were drafted on 2026-10-04 by the CME session from the evidence each
#  outcome cites in its own dcterms:source: this repository's
#  README.md, the five chapter corpora in 08-tooling
#  (sen0401_ch01..ch05_corpus_v*.py) and the chapter RDODI packages
#  they build, the "Bitcoin in numbers" package, the owner's 2025
#  materials in 03-materials/owner-legacy-2025 (their twelve decks
#  and their inventory), and the mission of the deck lineage in
#  07-lineage, which records the owner's ruling that the course is
#  taught from the third edition chapter by chapter.
#
#  APPROVAL (version 1.1.0). The owner approved all ten outcomes
#  as drafted, with their cognitive levels, on 2026-10-05 ("I think
#  learning outcomes are fine. Proceed."), the answer to the CME
#  session's request to confirm, revise or reject each outcome and
#  to rule on LO-6, LO-7 and LO-8. Nothing was revised. The approval
#  time recorded is the CME session's real clock when the owner's
#  answer was acted on, 2026-10-05T14:32:54 UTC. Version 1.0.0, the unapproved
#  draft, remains in this repository's git history. The evidence behind
#  LO-6, LO-7 and LO-8 is unchanged: the owner's 2025 decks and the
#  lineage mission, with no 2026 chapter package yet.
#
#  THE CATALOGUE WAS CHECKED, NOT ASSUMED. Istanbul Kultur
#  University's ECTS catalogue page for SEN0401 (ders_id 7084) was
#  read on 2026-10-04 and DOES carry five learning outcomes - but
#  they belong to an earlier special topic that entry still
#  describes, software architecture and design patterns: "Defining
#  software architecture concepts", "Determining the relevant
#  software architecture for a project", "Defining the software
#  architecture description language", "Defining the software
#  architecture analysis methods", "Implementing software design
#  patterns in a project". Not one of them describes the blockchain
#  course being taught this term, so none is carried here and none
#  is restated as this course's own. The finding is recorded because
#  the opposite of SEN0414's was found: there the catalogue was
#  empty, here it is full of the wrong course.
#################################################################

<http://example.org/sen0401/outcomes> a owl:Ontology ;
    rdfs:label "SEN0401 Special Topics in Software Engineering - Block Chain: learning outcomes"@en ;
    owl:versionInfo "1.1.0" ;
    owl:versionIRI <http://example.org/sen0401/outcomes/1.1.0> ;
    dcterms:identifier "sen0401_outcomes_v1_1_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:created "2026-10-04"^^xsd:date ;
    dcterms:modified "2026-10-05"^^xsd:date ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/cme-course-parts-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

sen0401:Outcomes a case:dtCFDocument ;
    case:title "SEN0401 Special Topics in Software Engineering: Block Chain - learning outcomes" ;
    dcterms:creator "Drafted by the CME session of 2026-10-04 from the evidence each outcome cites; approved by the owner on 2026-10-05" ;
    cme:approvedBy "owner" ;
    cme:approvedAt "2026-10-05T14:32:54"^^xsd:dateTime ;
    cme:forCourse cme:CR_SEN0401 ;
    rdfs:comment "Approved by the owner on 2026-10-05, all ten outcomes as drafted, including LO-6, LO-7 and LO-8, whose evidence is the owner's 2025 decks and the lineage mission rather than a 2026 chapter package. Version 1.0.0, the unapproved draft, remains in this repository's git history."@en ; case:CFItemType sen0401:LearningOutcome ;
    case:fullStatement "Explain what Bitcoin is, as money and as a system: its history, its units and supply schedule, the parts it is built from - keys, addresses, transactions, blocks, nodes, mining - and the problems it was designed to solve." ;
    cme:bloomLevel ld:Understand ; cme:inDocument sen0401:Outcomes ;
    dcterms:source "08-tooling/sen0401_ch01_corpus_v1_2_0.py, the chapter 1 corpus of the 3rd edition's Introduction, and the package it builds in 03-materials/ch01/rdodi (research, TBox, ABox, document at 1.2.0): money, network, wallet, usage, foundations and nature, with the supply cap, the halving, Hashcash and the Byzantine Generals' Problem among the concepts it adds. Also 03-materials/ch01/SEN0401_Ch01_Introduction_3e_v1_1_1.pptx and the owner's 2025 deck 03-materials/owner-legacy-2025/slides-2025/Chapter_1_Introduction_v1_0_0.pptx." .

sen0401:LO2 a case:dtCFItem ; case:humanCodingScheme "LO-2" ; case:CFItemType sen0401:LearningOutcome ;
    case:fullStatement "Trace one payment from a wallet to a confirmed block - construction, signing, propagation, the mempool, the fee, mining, the block and its confirmations - and say what each step guarantees and what it does not." ;
    cme:bloomLevel ld:Analyze ; cme:inDocument sen0401:Outcomes ;
    dcterms:source "08-tooling/sen0401_ch02_corpus_v1_2_0.py, the chapter 2 corpus, whose document is titled 'How Bitcoin works: one real transaction from Alice's wallet to the blockchain, every figure recomputed', and its package in 03-materials/ch02/rdodi at 1.2.0. Also 03-materials/ch02/SEN0401_Ch02_HowBitcoinWorks_3e_v1_1_1.pptx and the owner's 2025 deck Chapter_2_HowBitcoinWorks_v1_0_0.pptx." .

sen0401:LO3 a case:dtCFItem ; case:humanCodingScheme "LO-3" ; case:CFItemType sen0401:LearningOutcome ;
    case:fullStatement "Build, configure and run Bitcoin Core as a full node, verify the release before trusting it, and query the node over its JSON-RPC interface to inspect blocks, transactions and the state of the chain." ;
    cme:bloomLevel ld:Apply ; cme:inDocument sen0401:Outcomes ;
    dcterms:source "08-tooling/sen0401_ch03_corpus_v1_1_0.py, the chapter 3 corpus of 'Bitcoin Core: The Reference Implementation', checked against a real run of release 31.1 whose evidence is kept in 08-tooling/ch03-evidence, and its package in 03-materials/ch03/rdodi at 1.1.0. Also 03-materials/ch03/SEN0401_Ch03_BitcoinCore_3e_v1_0_0.pptx and the owner's 2025 deck Chapter_3_BitcoinCore_TheReferenceImplementation_v1_0_0.pptx." .

sen0401:LO4 a case:dtCFItem ; case:humanCodingScheme "LO-4" ; case:CFItemType sen0401:LearningOutcome ;
    case:fullStatement "Derive private keys, public keys and addresses from the standards that define them - elliptic-curve arithmetic over a finite field, SHA-256 and RIPEMD-160, Base58Check, Bech32 and Bech32m - and check each result against a reference implementation or a published test vector." ;
    cme:bloomLevel ld:Apply ; cme:inDocument sen0401:Outcomes ;
    dcterms:source "08-tooling/sen0401_ch04_corpus_v1_1_0.py, the chapter 4 corpus of 'Keys and Addresses', recomputed from SEC 2 version 2.0, FIPS 180-4 and BIPs 16, 38, 141, 142, 173, 340 and 350, cross-checked against Bitcoin Core 31.1 and the sipa/bech32 reference implementation, and its package in 03-materials/ch04/rdodi at 1.1.0. Also 03-materials/ch04/SEN0401_Ch04_KeysAndAddresses_3e_v1_0_0.pptx and the owner's 2025 deck Chapter_4_KeysAddresses_v1_0_0.pptx." .

sen0401:LO5 a case:dtCFItem ; case:humanCodingScheme "LO-5" ; case:CFItemType sen0401:LearningOutcome ;
    case:fullStatement "Compare wallet and recovery designs - deterministic derivation, recovery codes, key stretching and salts, secret sharing, output descriptors, multisignature - and judge what each costs and protects when a key or a backup is lost or stolen." ;
    cme:bloomLevel ld:Evaluate ; cme:inDocument sen0401:Outcomes ;
    dcterms:source "08-tooling/sen0401_ch05_corpus_v1_0_0.py, the chapter 5 corpus of 'Wallet Recovery', built from BIPs 32, 39, 43, 44, 49, 84, 86, 93, 329, 379, 380 and 389, SLIP-0039 and SLIP-0044, the Electrum seed version system, lnd's aezeed, Muun's and BTCPay Server's recovery tools and Lopp's list of known physical attacks, and its package in 03-materials/ch05/rdodi at 1.0.0. Also the owner's 2025 deck Chapter_5_Wallets_v1_0_0.pptx and the wallet reports and ontologies in 03-materials/owner-legacy-2025/llm-content-2025/Chapter_5_Wallets. No 2026 deck exists for this chapter yet." .

sen0401:LO6 a case:dtCFItem ; case:humanCodingScheme "LO-6" ; case:CFItemType sen0401:LearningOutcome ;
    case:fullStatement "Read and construct Bitcoin transactions - inputs and outputs, output and input scripts, authorization and authentication, signatures, and fees - and explain how a node decides whether a transaction is valid." ;
    cme:bloomLevel ld:Apply ; cme:inDocument sen0401:Outcomes ;
    dcterms:source "The owner's 2025 decks Chapter_6_Transactions_v1_0_0.pptx and Chapter_7_AdvancedTransactionsAndScripting_v1_0_0.pptx, and the transaction reports, ontology prompts and pages in 03-materials/owner-legacy-2025/llm-content-2025/Chapter_6_Transactions; and the third edition's chapters 6 to 9 (Transactions; Authorization and Authentication; Digital Signatures; Transaction Fees), which the mission of 07-lineage/sen0401_slides_lineage_v0_21_0.ttl commits the course to teach chapter by chapter. DRAFTED FROM THE LEGACY MATERIAL AND THE MISSION ONLY: no 2026 chapter package or corpus exists for these chapters yet, so this outcome rests on weaker evidence than LO-1 to LO-5 and needs the owner's ruling." .

sen0401:LO7 a case:dtCFItem ; case:humanCodingScheme "LO-7" ; case:CFItemType sen0401:LearningOutcome ;
    case:fullStatement "Explain how the peer-to-peer network, the chain of blocks and proof-of-work consensus together keep one ledger consistent without a central authority, and analyse which attack each of those mechanisms defends against." ;
    cme:bloomLevel ld:Analyze ; cme:inDocument sen0401:Outcomes ;
    dcterms:source "The owner's 2025 decks Chapter_8_TheBitcoinNetwork_v1_0_0.pptx, Chapter_9_TheBlockchain_v1_0_0.pptx and Chapter_10_MiningAndConsensus_v1_0_0.pptx, with the network and blockchain research reports and ontologies in 03-materials/owner-legacy-2025/llm-content-2025/Chapter_8_The_Bitcoin_Network and Chapter9The_Blockchain; and the third edition's chapters 10 to 12 (The Bitcoin Network; The Blockchain; Mining and Consensus), which the lineage mission commits the course to teach. DRAFTED FROM THE LEGACY MATERIAL AND THE MISSION ONLY: no 2026 chapter package exists for these chapters yet." .

sen0401:LO8 a case:dtCFItem ; case:humanCodingScheme "LO-8" ; case:CFItemType sen0401:LearningOutcome ;
    case:fullStatement "Judge the security of a real Bitcoin deployment - where keys live, who can sign, what an attacker gains - and assess the applications and second-layer systems built on top of the chain against what the base layer actually guarantees." ;
    cme:bloomLevel ld:Evaluate ; cme:inDocument sen0401:Outcomes ;
    dcterms:source "The owner's 2025 decks Chapter_11_BitcoinSecurity_v1_0_0.pptx and Chapter_12_BlockchainApplications_v1_0_0.pptx; and the third edition's chapters 13 (Bitcoin Security) and 14 (Second-Layer Applications), which the lineage mission commits the course to teach. DRAFTED FROM THE LEGACY MATERIAL AND THE MISSION ONLY: no 2026 chapter package exists for these chapters yet." .

sen0401:LO9 a case:dtCFItem ; case:humanCodingScheme "LO-9" ; case:CFItemType sen0401:LearningOutcome ;
    case:fullStatement "Read Bitcoin's public figures - price, circulating supply, hash rate and difficulty - from live public data, and reason about what such a figure does and does not show about the system." ;
    cme:bloomLevel ld:Analyze ; cme:inDocument sen0401:Outcomes ;
    dcterms:source "The 'Bitcoin in numbers' package in 03-materials/numbers (research, TBox, ABox and document at 1.0.0, and the page at 9.4.2), whose document is 'Bitcoin in numbers: price, supply and mining power since 2009' and whose grounding is a Blockchain.com snapshot together with the third edition." .

sen0401:LO10 a case:dtCFItem ; case:humanCodingScheme "LO-10" ; case:CFItemType sen0401:LearningOutcome ;
    case:fullStatement "Develop, in a team, an application inside the term's theme that meets a real user's need - communicating with that user, running the domain engineering and collecting the business requirements before the proposal, and carrying the work through to delivery." ;
    cme:bloomLevel ld:Create ; cme:inDocument sen0401:Outcomes ;
    dcterms:source "README.md of this repository: 'Term theme: semantic technologies - applications for real users, built on domain engineering and collected requirements; team projects favoured.' The one outcome not drawn from the textbook or the chapter material. Nothing in this repository states a project weight or a project brief, so what assesses this outcome is undeclared; see the gap recorded in 00-course-profile/sen0401_course_v1_0_0.ttl." .
