@prefix cme:     <http://example.org/cme#> .
@prefix sen0401: <http://example.org/sen0401#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Assessment part - governed by QTI (profile for export). Holds the grading scheme as the course
# outline states it (00-course-profile/Outline_SEN0401_Special_Topics_Blockchain_Fall2026_v1_0_0.docx,
# Grading table). No exam items are held yet; when they are, they are authored here and exportable as QTI.

<http://example.org/sen0401/assessment> a owl:Ontology ; rdfs:label "SEN0401: assessment"@en ;
    owl:versionInfo "1.0.0" ; dcterms:identifier "sen0401_assessment_v1_0_0" .

sen0401:Midterm a cme:AssessmentComponent ; rdfs:label "Midterm"@en ; cme:weightPercent "30"^^xsd:decimal .
sen0401:Project a cme:AssessmentComponent ; rdfs:label "Project"@en ; cme:weightPercent "30"^^xsd:decimal ; cme:describedIn sen0401:ProjectBrief .
sen0401:Final a cme:AssessmentComponent ; rdfs:label "Final"@en ; cme:weightPercent "40"^^xsd:decimal .
sen0401:Bonus a cme:AssessmentComponent ; rdfs:label "Bonus"@en ; cme:weightPercent "10"^^xsd:decimal ;
    cme:componentNote "On top of the 100: the outline totals 110 with 10 bonus points." .
