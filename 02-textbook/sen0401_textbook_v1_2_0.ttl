@prefix schema:  <https://schema.org/> .
@prefix cme:     <http://example.org/cme#> .
@prefix sen0401: <http://example.org/sen0401#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .

#################################################################
#  Textbook part - governed by IEEE LOM 1484.12.1-2020 (CME
#  adoption cme:Adopt_LOM: aligned). Written in Dublin Core and
#  Schema.org terms under LOM's categories - general, lifecycle,
#  rights, educational - because an RDF binding of LOM has not been
#  verified at its steward's page; that is recorded, not hidden, and
#  is the same decision SEN0414's textbook part records.
#
#  A PINNED REFERENCE, not the ontology itself. The textbook is
#  modelled in its own package, mastering-bitcoin-3e, which now has
#  its own private repository, altunelyusuf/mastering-bitcoin, one
#  folder per edition; this part points at it exactly, by repository,
#  folder and commit, and says why it is pinned rather than copied.
#################################################################

<http://example.org/sen0401/textbook> a owl:Ontology ;
    rdfs:label "SEN0401: the course textbook"@en ;
    owl:versionInfo "1.2.0" ;
    owl:versionIRI <http://example.org/sen0401/textbook/1.2.0> ;
    prov:wasRevisionOf <http://example.org/sen0401/textbook/1.1.0> ;
    dcterms:identifier "sen0401_textbook_v1_2_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0. The book this part describes is the authors' own work and carries its own licence, recorded below."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:created "2026-10-04"^^xsd:date ;
    dcterms:modified "2026-10-05"^^xsd:date ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/cme-course-parts-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

#################################################################
#  The book
#################################################################

sen0401:Textbook a schema:Book ;
    rdfs:label "Mastering Bitcoin: Programming the Open Blockchain, 3rd edition"@en ;
    dcterms:title "Mastering Bitcoin: Programming the Open Blockchain, 3rd Edition" ;
    dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ;
    dcterms:publisher "O'Reilly" ;
    dcterms:issued "2023-12" ;
    schema:url "https://github.com/bitcoinbook/bitcoinbook" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:rights "Free to read under the Creative Commons Attribution-ShareAlike 4.0 International licence from the authors' own repository, as this repository's README states and as the textbook ontology package records from the repository's README at the commit it pinned. No ISBN and no page count are asserted: neither is stated in this repository, in the textbook ontology package, or in the authors' repository as read here, and neither is invented." ;
    cme:upstreamRepository "bitcoinbook/bitcoinbook" ;
    cme:upstreamTag "third_edition_print1" ;
    cme:upstreamTagCommit "6d1c26e1640ae32b28389d5ae4caf1214c2be7db" ;
    cme:modelledBy sen0401:TextbookOntology ;
    cme:editionNote "The third edition has 14 chapters, three appendices and a preface: Introduction; How Bitcoin Works; Bitcoin Core: The Reference Implementation; Keys and Addresses; Wallet Recovery; Transactions; Authorization and Authentication; Digital Signatures; Transaction Fees; The Bitcoin Network; The Blockchain; Mining and Consensus; Bitcoin Security; Second-Layer Applications. The third edition changed the second edition's chapter structure the course had been taught from - Digital Signatures and Transaction Fees are new chapters, and the old scripting chapter became Authorization and Authentication - which is why the decks are being renewed chapter by chapter rather than relabelled." ;
    dcterms:source "README.md of this repository for the title, authors, publisher, date, licence and the tag; the chapter list read from the chapter ontologies of the textbook ontology package (01-ontologies/mastering_bitcoin_3e_ch01..ch14, appA..appC, preface); the edition's structural change from the mission of 07-lineage/sen0401_slides_lineage_v0_21_0.ttl. The tag's commit was resolved independently on 2026-10-04 by 'git ls-remote --tags https://github.com/bitcoinbook/bitcoinbook', which gives third_edition_print1 at 6d1c26e1640ae32b28389d5ae4caf1214c2be7db - the same commit the textbook ontology package's README names." .

#################################################################
#  The pinned textbook ontology
#################################################################

sen0401:TextbookOntology a cme:PinnedReference ;
    rdfs:label "Ontology of the third edition, chapter by chapter, section by section"@en ;
    cme:pinnedRepository "altunelyusuf/mastering-bitcoin" ;
    cme:inFolder "3e" ;
    cme:pinnedCommit "349e3db00e92c8265306e712c176b7ca716d8385" ;
    cme:pinnedVersion "0.9.2" ;
    cme:pinnedSourceCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ;
    cme:coverageNote "At version 0.9.0 the package models the whole printed book - all 14 chapters, the three appendices and the preface - and the authors' repository beside it: 315 sections, 449 concepts each introduced by the book's own sentence, 170 code listings carried verbatim, 79 figures linked to their image files, 65 BIPs, the glossary's 78 entries, and 895 carried passages in all, every one passing the package's attribution gate and its fidelity check against the pinned source. All 233 files of the authors' repository are registered with path, digest, size and role. Those counts are unchanged at 0.9.1 and at 0.9.2: 0.9.1 repaired undecoded character references in eleven literals, and 0.9.2 adds the package's own release gate and nothing else the register can see. The release gate's own run for 0.9.2, recorded in the package's publish record as its gate result, measured: all 18 parts of the book at 100% coverage, 1285 inventory rows satisfied of 1285; 895 carried passages through the attribution gate; all 895 beginning where the register records them, re-read from the authors' repository at the pinned source commit; and 233 of 233 repository files re-checked at that commit with no drift." ;
    cme:pinUpdateNote "1.2.0 moves the pin out of the Ontologies monorepo. The package was taken out of that monorepo and given its own private repository, altunelyusuf/mastering-bitcoin, which holds one folder per edition of the book - the third edition is 3e/ - so that a later edition arrives beside this one rather than over it. The pinned commit is now a commit of that repository and the folder is 3e, not mastering-bitcoin-3e; nothing about the book or its source changed, so cme:pinnedSourceCommit and everything under sen0401:Textbook are untouched. The version moves from 0.9.1 to 0.9.2, the release the package made in its new home: its first publish ceremony there, which regenerated its publish record to name this repository and this folder, and which also added the package's own release gate so that the four gates are run by the publisher rather than by hand. The pinned file for a chapter is still not named by this course: the configuration builder reads the newest part for each chapter out of the pinned tree, so a later release of the package needs no edit here."@en ;
    cme:whyNotHere "The owner has ruled, on 2026-10-05: the package does not come into this course repository, and it does not stay in the Ontologies monorepo either - it has its own private repository, altunelyusuf/mastering-bitcoin, and this course pins it there. Two reasons, and the earlier wording of this claim - that the question was open until the owner ruled - is now out of date and is replaced rather than kept. First, a copy drifts: the package is released, gated and versioned by its own session, and a copy taken into a course repository would stop being the thing those gates were run against. Second, this repository is readable by students and the package is not published to them; the book itself is freely readable under CC BY-SA 4.0 from the authors' own repository, which is where a student is sent. SEN0414 is registered with its own textbook ontology pinned the same way." ;
    cme:pinNote "NO TAG EXISTS IN THE NEW REPOSITORY EITHER, and the reason is now known rather than merely observed. Re-checked on 2026-10-05 against altunelyusuf/mastering-bitcoin: 'git ls-remote --tags origin' returns nothing at all - the repository carries zero tags. The package's publisher does create a release tag, mastering-bitcoin-3e-v0.9.2, and did create it locally, but the push of that tag was refused by the network path this work ran through while the push of the release commit itself succeeded; the publisher reported that refusal rather than hiding it, and the tag is still to be pushed. So this part pins the commit only, and says so rather than naming a tag that does not exist yet. The commit is the release commit of 0.9.2 - the publish ceremony's own commit, and the newest commit touching the folder, from 'git -C <mastering-bitcoin> log -1 --format=%H -- 3e' on 2026-10-05. For the record, the previous pin was commit fa954d7e8297a6d44219f4f49c403db941398f21 of altunelyusuf/Ontologies, folder mastering-bitcoin-3e, from which this repository's history was split." ;
    dcterms:source "README.md, VERSION.txt and PUBLISH_RECORD.ttl of 3e/ in altunelyusuf/mastering-bitcoin (version 0.9.2, publish ceremony of 2026-10-05T07:08:16Z: 45 of 45 manifest files verified with no unlisted file present, 29 of 29 Turtle files parsed, package gate PASS, package location '3e'), its 01-ontologies folder, and the git commands named above, all read on 2026-10-05. The source commit 275c4eb8eab8800c6adc39f8def8e8f8fa356a57 is the commit of the authors' repository that the package itself pins and attributes every carried passage to, read from the chapter ontologies; the package's README states its chapter files are byte-identical to the third_edition_print1 tag." .
