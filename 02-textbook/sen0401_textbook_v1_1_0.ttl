@prefix schema:  <https://schema.org/> .
@prefix cme:     <http://example.org/cme#> .
@prefix sen0401: <http://example.org/sen0401#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .

#################################################################
#  Textbook part - governed by IEEE LOM 1484.12.1-2020 (CME
#  adoption cme:Adopt_LOM: aligned). Written in Dublin Core and
#  Schema.org terms under LOM's categories - general, lifecycle,
#  rights, educational - because an RDF binding of LOM has not been
#  verified at its steward's page; that is recorded, not hidden, and
#  is the same decision SEN0414's textbook part records.
#
#  A PINNED REFERENCE, not the ontology itself. The textbook is
#  modelled in its own package, mastering-bitcoin-3e, which lives in
#  the private Ontologies monorepo; this part points at it exactly,
#  by folder and commit, and says why it is not here.
#################################################################

<http://example.org/sen0401/textbook> a owl:Ontology ;
    rdfs:label "SEN0401: the course textbook"@en ;
    owl:versionInfo "1.1.0" ;
    owl:versionIRI <http://example.org/sen0401/textbook/1.1.0> ;
    prov:wasRevisionOf <http://example.org/sen0401/textbook/1.0.0> ;
    dcterms:identifier "sen0401_textbook_v1_1_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0. The book this part describes is the authors' own work and carries its own licence, recorded below."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:created "2026-10-04"^^xsd:date ;
    dcterms:modified "2026-10-05"^^xsd:date ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/cme-course-parts-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

#################################################################
#  The book
#################################################################

sen0401:Textbook a schema:Book ;
    rdfs:label "Mastering Bitcoin: Programming the Open Blockchain, 3rd edition"@en ;
    dcterms:title "Mastering Bitcoin: Programming the Open Blockchain, 3rd Edition" ;
    dcterms:creator "Andreas M. Antonopoulos", "David A. Harding" ;
    dcterms:publisher "O'Reilly" ;
    dcterms:issued "2023-12" ;
    schema:url "https://github.com/bitcoinbook/bitcoinbook" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:rights "Free to read under the Creative Commons Attribution-ShareAlike 4.0 International licence from the authors' own repository, as this repository's README states and as the textbook ontology package records from the repository's README at the commit it pinned. No ISBN and no page count are asserted: neither is stated in this repository, in the textbook ontology package, or in the authors' repository as read here, and neither is invented." ;
    cme:upstreamRepository "bitcoinbook/bitcoinbook" ;
    cme:upstreamTag "third_edition_print1" ;
    cme:upstreamTagCommit "6d1c26e1640ae32b28389d5ae4caf1214c2be7db" ;
    cme:modelledBy sen0401:TextbookOntology ;
    cme:editionNote "The third edition has 14 chapters, three appendices and a preface: Introduction; How Bitcoin Works; Bitcoin Core: The Reference Implementation; Keys and Addresses; Wallet Recovery; Transactions; Authorization and Authentication; Digital Signatures; Transaction Fees; The Bitcoin Network; The Blockchain; Mining and Consensus; Bitcoin Security; Second-Layer Applications. The third edition changed the second edition's chapter structure the course had been taught from - Digital Signatures and Transaction Fees are new chapters, and the old scripting chapter became Authorization and Authentication - which is why the decks are being renewed chapter by chapter rather than relabelled." ;
    dcterms:source "README.md of this repository for the title, authors, publisher, date, licence and the tag; the chapter list read from the chapter ontologies of the textbook ontology package (01-ontologies/mastering_bitcoin_3e_ch01..ch14, appA..appC, preface); the edition's structural change from the mission of 07-lineage/sen0401_slides_lineage_v0_21_0.ttl. The tag's commit was resolved independently on 2026-10-04 by 'git ls-remote --tags https://github.com/bitcoinbook/bitcoinbook', which gives third_edition_print1 at 6d1c26e1640ae32b28389d5ae4caf1214c2be7db - the same commit the textbook ontology package's README names." .

#################################################################
#  The pinned textbook ontology
#################################################################

sen0401:TextbookOntology a cme:PinnedReference ;
    rdfs:label "Ontology of the third edition, chapter by chapter, section by section"@en ;
    cme:pinnedRepository "altunelyusuf/Ontologies" ;
    cme:inFolder "mastering-bitcoin-3e" ;
    cme:pinnedCommit "fa954d7e8297a6d44219f4f49c403db941398f21" ;
    cme:pinnedVersion "0.9.1" ;
    cme:pinnedSourceCommit "275c4eb8eab8800c6adc39f8def8e8f8fa356a57" ;
    cme:coverageNote "At version 0.9.0 the package models the whole printed book - all 14 chapters, the three appendices and the preface - and the authors' repository beside it: 315 sections, 449 concepts each introduced by the book's own sentence, 170 code listings carried verbatim, 79 figures linked to their image files, 65 BIPs, the glossary's 78 entries, and 895 carried passages in all, every one passing the package's attribution gate and its fidelity check against the pinned source. All 233 files of the authors' repository are registered with path, digest, size and role." ;
    cme:pinUpdateNote "1.1.0 moves the pin from 0.9.0 to 0.9.1, the package's patch release of 2026-10-05: an AsciiDoc index entity had reached eleven labels, definitions and passage texts in seven parts ('Byzantine Generals&#x27; Problem', 'Moore&#x27;s Law', 'Gambler&#x27;s Ruin problem' and four others), and three concept identifiers had been slugged from the undecoded label. The harvester now decodes character references; chapters 1, 8, 9, 12 and 14, appendix A and the supplements were reissued, and the other twelve parts were rebuilt and compared triple by triple to prove nothing else moved. The pinned file for a chapter is no longer named by this course: course_page_config_build_v2_4_0.py reads the newest part for each chapter out of the pinned tree, so a later release needs no edit here."@en ;
    cme:whyNotHere "The package lives in the private Ontologies monorepo, which also holds the governance this repository is published under. Moving it into a student-readable course repository is the owner's decision, not this session's, and SEN0414 is registered with its own textbook ontology pinned the same way; until the owner rules, this part points at the package exactly rather than copying it, because a copy drifts." ;
    cme:pinNote "NO TAG EXISTS FOR THIS FOLDER. The Ontologies monorepo carries 668 tags, none of them matching 'mastering', 'bitcoin' or 'mbb' - checked on 2026-10-04 with 'git tag --list'. SEN0414's textbook part could pin a tag as well as a commit; this one pins the commit only, and says so rather than naming a tag that does not exist. The commit is the latest that touched the folder, from 'git -C <Ontologies> log -1 --format=%H -- mastering-bitcoin-3e' on 2026-10-04; it is the monorepo commit tagged rdodi-ecosystem v1.142.0 of 2026-09-28." ;
    dcterms:source "README.md, VERSION.txt and PUBLISH_RECORD.ttl of mastering-bitcoin-3e (version 0.9.1, publish ceremony of 2026-10-05; the 0.9.0 ceremony of 2026-09-26T22:48:32Z, 44 of 44 manifest files verified, 29 of 29 Turtle files parsed), its 01-ontologies folder, and the two git commands named above, all read on 2026-10-04. The source commit 275c4eb8eab8800c6adc39f8def8e8f8fa356a57 is the commit of the authors' repository that the package itself pins and attributes every carried passage to, read from the chapter ontologies; the package's README states its chapter files are byte-identical to the third_edition_print1 tag." .
