@prefix schema:  <https://schema.org/> .
@prefix cme:     <http://example.org/cme#> .
@prefix sen0401: <http://example.org/sen0401#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .

#################################################################
#  Course profile part - governed by Schema.org Course
#  (CME standards adoption cme:Adopt_SchemaCourse: aligned).
#
#  Every value here is taken from a source named, fact by fact, in
#  00-course-profile/SOURCES_v1_0_0.md; nothing is inferred. The two
#  sources are this repository's own README.md and Istanbul Kultur
#  University's ECTS catalogue page for SEN0401, read 2026-10-04.
#
#  The profile class is deliberately NOT asserted. CME's course
#  profile version 1 requires seven parts; this repository holds
#  four (course profile, outcomes, textbook, materials) and holds no
#  assessment, projects or quality-evidence part. Typing this
#  repository cme:CourseRepository_ProfileV1 would make a
#  conformance claim that CME's own shape
#  cme:ProfileV1RequiredPartsShape refuses, so the claim is not
#  made: the repository is recorded as a course repository, the
#  parts it really carries are listed, and the three it lacks are
#  named below as the gap registration must close. Only classes in
#  this course's own namespace are introduced here; no term is
#  minted in CME's namespace.
#################################################################

<http://example.org/sen0401/course> a owl:Ontology ;
    rdfs:label "SEN0401 Special Topics in Software Engineering - Block Chain: course profile"@en ;
    owl:versionInfo "1.1.0" ;
    owl:versionIRI <http://example.org/sen0401/course/1.0.0> ;
    dcterms:identifier "sen0401_course_v1_1_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:created "2026-10-04"^^xsd:date ;
    dcterms:modified "2026-10-04"^^xsd:date ;
    prov:wasGeneratedBy <http://example.org/sen0401/activity/cme-course-parts-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

<http://example.org/sen0401/activity/cme-course-parts-run> a prov:Activity ;
    rdfs:label "Authoring run that built SEN0401's course-level CME parts"@en ;
    rdfs:comment "The session of 2026-10-04 that wrote this repository's course profile, learning outcomes, textbook link and material register from the sources recorded in 00-course-profile/SOURCES_v1_0_0.md. The learning outcomes it drafted carry no approval; see 01-outcomes."@en ;
    prov:wasAssociatedWith <http://example.org/rdodi/agent/YusufAltunel> .

#################################################################
#  Classes this course introduces in its own namespace, because CME
#  has none for them and a course never mints CME vocabulary.
#################################################################

sen0401:TermTheme a owl:Class ;
    rdfs:label "term theme"@en ;
    rdfs:comment "The theme a term's project work must fall inside, as the course's own outline or README states it."@en .

sen0401:PartGap a owl:Class ;
    rdfs:label "missing required part"@en ;
    rdfs:comment "A part the claimed course profile requires that this repository does not hold, named so that its absence is a recorded decision rather than an oversight, and so that a submission is not made while it is open."@en .

#################################################################
#  The course
#################################################################

sen0401:Course a schema:Course ;
    rdfs:label "SEN0401 Special Topics in Software Engineering: Block Chain"@en ;
    schema:courseCode "SEN0401" ;
    schema:name "Special Topics in Software Engineering: Block Chain" ;
    schema:alternateName "Special Topics in Software Engineering" ;
    schema:provider "Istanbul Kultur University, Faculty of Engineering and Architecture, Department of Computer Engineering" ;
    schema:instructor "Yusuf Altunel" ;
    schema:email "y.altunel@iku.edu.tr" ;
    schema:inLanguage "en" ;
    schema:hasCourseInstance sen0401:Fall2026 ;
    cme:localCreditNotation "2/0/2" ;
    cme:creditNote "As the catalogue prints it: course type DE, LE/RC/LA 2/0/2, language of instruction English, ECTS 6 - read from Istanbul Kultur University's ECTS page for SEN0401 on 2026-10-04. The ECTS figure is recorded as read and nothing rests on it: CME's adoption of the ECTS Users' Guide 2015 is cme:Pending because the steward's page refused this environment, and under that adoption the credit field carries the figure the owner states. The owner has stated no credit figure for SEN0401 anywhere in this repository, so none is asserted as the owner's." ;
    rdfs:comment "The README titles the course 'Special Topics in Software Engineering: Block Chain'; the catalogue carries the shell name 'Special Topics in Software Engineering', kept here as the alternate name. The catalogue gives the instructor as 'Dr. Yusuf Altunel' and the README as 'Yusuf Altunel'; the shorter form is used, as in SEN0414's profile."@en ;
    dcterms:source "README.md of this repository, and https://akademikpaket.iku.edu.tr/EN/ects_bolum.php?m=1&p=11&f=4&r=0&ders_id=7084&ects=ders_detay (read 2026-10-04, sha256 bbc734f528d1c2ab9fa93ca68078894dac9a40b90fc3c2944cda3e09fe47e845)." .

sen0401:Fall2026 a schema:CourseInstance ;
    rdfs:label "SEN0401, 2026-2027 Fall"@en ;
    schema:name "2026-2027 Fall" ;
    schema:courseSchedule "Friday 09:00-12:45" ;
    schema:location "LAB 2B-12/14" ;
    cme:termTheme "Semantic technologies" ;
    rdfs:comment "The catalogue page records a different delivery for SEN0401 - 'Theory: Saturday 09:00-11:00 3B0305. Lab: Saturday 11:00-13:00, 13:00-15:00 2B-04/06' - belonging to the earlier special topic that entry still describes. This term's delivery is the one the README states; the divergence is recorded, not reconciled, because only the owner can correct the catalogue."@en ;
    dcterms:source "README.md of this repository for the day, hours, room and theme; the term name from CME's lifecycle act cme:Act_SEN0401_Fall2026, which declares this repository active for '2026-2027 Fall'." .

#################################################################
#  The term theme, as the README states it
#################################################################

sen0401:TermTheme_Fall2026 a sen0401:TermTheme ;
    rdfs:label "Term theme, 2026-2027 Fall: semantic technologies"@en ;
    cme:termTheme "Semantic technologies" ;
    rdfs:comment "Semantic technologies - applications for real users, built on domain engineering and collected requirements; team projects favoured over individual ones."@en ;
    dcterms:source "README.md of this repository, the 'Term theme' line: 'semantic technologies - applications for real users, built on domain engineering and collected requirements; team projects favoured.' The same theme is carried as the mission origin of the deck lineage, 07-lineage/sen0401_slides_lineage_v0_21_0.ttl, which attributes it to the owner's rulings of 2026-09-24 and 2026-09-25." .

#################################################################
#  What this term teaches, and how its catalogue entry diverges
#################################################################

sen0401:Course rdfs:comment "SEN0401 is a special-topics shell course, so its topic changes by term. This term the topic is blockchain, taught from Mastering Bitcoin, 3rd edition, chapter by chapter: the README names the textbook, and the deck lineage's mission records the owner's ruling of 2026-09-24 that the outline was updated to the third edition and its fourteen chapters. The catalogue entry for SEN0401, read on 2026-10-04, still describes an earlier topic - software architectures, with a design pattern each week in the laboratory - with its own course goals, principal sources (Taylor, Medvidovic and Dashofy 2009; Freeman et al. 2004; Gamma et al. 1994), a fourteen-week plan, an assessment scheme of midterm 40, laboratory 20 and final 40, and five learning outcomes about software architecture. None of that is carried into this repository, because none of it describes what is being taught. It is recorded so that the difference between the catalogue and the course is visible rather than silently resolved, and so that the owner can decide whether to have the catalogue entry updated."@en .

#################################################################
#  The course repository, the parts it really carries, and the gap
#################################################################

cme:CR_SEN0401 a cme:CourseRepository, cme:CourseRepository_ProfileV1 ;
    rdfs:label "SEN0401 Special Topics in Software Engineering: Block Chain"@en ;
    cme:repositoryName "altunelyusuf/SEN0401" ;
    cme:courseCode "SEN0401" ;
    cme:declaredVisibility "public" ;
    cme:carriesPart cme:Part_CourseProfile, cme:Part_Outcomes, cme:Part_Textbook, cme:Part_Materials,
                    cme:Part_Assessment, cme:Part_Projects, cme:Part_Quality ;
    rdfs:comment "All seven parts course profile version 1 requires are carried, each in the folder CME's adoption graph assigns it. Assessment and projects are taken from the course outline submitted by the owner on 2026-10-05; quality evidence declares that no alignment is yet made. The learning outcomes remain an unapproved draft."@en ;
    dcterms:source "README.md of this repository; cme_lifecycle_v1_0_0.ttl and cme_registry_v1_0_0.ttl of the CME package, for the repository name, its declared state and its declared access." .

sen0401:Gap_ProfileV1Parts a sen0401:PartGap ;
    rdfs:label "No part course profile version 1 requires is missing; the 2026-10-04 gap is closed"@en ;
    cme:gapNote "Closed on 2026-10-05: 04-assessment, 05-projects and 06-quality (sen0401_quality_v1_0_0.ttl) now exist. The earlier record, sen0401_course_v1_0_0.ttl, is kept unedited." ;
    dcterms:source "The folder listing of this repository on 2026-10-05." .
